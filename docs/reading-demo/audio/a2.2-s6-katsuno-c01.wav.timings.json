      "text": "なまえはオートラです。",
      "start_ms": 191019,
      "end_ms": 193396,
      "duration_ms": 2377,
      "clauses": [
        {
          "index": 0,
          "text": "なまえはオートラです。",
          "start_ms": 191019,
          "end_ms": 193396,
          "duration_ms": 2377
        }
      ]
    },
    {
      "index": 44,
      "text": "オートラもしろではたらいていました。",
      "start_ms": 193896,
      "end_ms": 197086,
      "duration_ms": 3190,
      "clauses": [
        {
          "index": 0,
          "text": "オートラもしろではたらいていました。",
          "start_ms": 193896,
          "end_ms": 197086,
          "duration_ms": 3190
        }
      ]
    },
    {
      "index": 45,
      "text": "としをとっていました。",
      "start_ms": 197586,
      "end_ms": 199859,
      "duration_ms": 2273,
      "clauses": [
        {
          "index": 0,
          "text": "としをとっていました。",
          "start_ms": 197586,
          "end_ms": 199859,
          "duration_ms": 2273
        }
      ]
    },
    {
      "index": 46,
      "text": "おかねがすきでした。",
      "start_ms": 200359,
      "end_ms": 202562,
      "duration_ms": 2203,
      "clauses": [
        {
          "index": 0,
          "text": "おかねがすきでした。",
          "start_ms": 200359,
          "end_ms": 202562,
          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 47,
      "text": "わるいこともするひとでした。",
      "start_ms": 203062,
      "end_ms": 205776,
      "duration_ms": 2714,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこともするひとでした。",
          "start_ms": 203062,
          "end_ms": 205776,
          "duration_ms": 2714
        }
      ]
    },
    {
      "index": 48,
      "text": "とのさまのこともおんなのひとたちのこともよく、しっていました。",
      "start_ms": 206276,
      "end_ms": 212615,
      "duration_ms": 6339,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまのこともおんなのひとたちのこともよく、",
          "start_ms": 206276,
          "end_ms": 210499,
          "duration_ms": 4223
        },
        {
          "index": 1,
          "text": "しっていました。",
          "start_ms": 210749,
          "end_ms": 212615,
          "duration_ms": 1866
        }
      ]
    },
    {
      "index": 49,
      "text": "だからシチロウエモンはオートラにあいました。",
      "start_ms": 213115,
      "end_ms": 217141,
      "duration_ms": 4026,
      "clauses": [
        {
          "index": 0,
          "text": "だからシチロウエモンはオートラにあいました。",
          "start_ms": 213115,
          "end_ms": 217141,
          "duration_ms": 4026
        }
      ]
    },
    {
      "index": 50,
      "text": "「シチロウエモンさん。",
      "start_ms": 217641,
      "end_ms": 219763,
      "duration_ms": 2122,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモンさん。",
          "start_ms": 217641,
          "end_ms": 219763,
          "duration_ms": 2122
        }
      ]
    },
    {
      "index": 51,
      "text": "かおがあかいですね。",
      "start_ms": 220263,
      "end_ms": 222419,
      "duration_ms": 2156,
      "clauses": [
        {
          "index": 0,
          "text": "かおがあかいですね。",
          "start_ms": 220263,
          "end_ms": 222419,
          "duration_ms": 2156
        }
      ]
    },
    {
      "index": 52,
      "text": "どうしましたか」。",
      "start_ms": 222919,
      "end_ms": 224866,
      "duration_ms": 1947,
      "clauses": [
        {
          "index": 0,
          "text": "どうしましたか」。",
          "start_ms": 222919,
          "end_ms": 224866,
          "duration_ms": 1947
        }
      ]
    },
    {
      "index": 53,
      "text": "「ハチヤのことをきいていますか。",
      "start_ms": 225366,
      "end_ms": 228300,
      "duration_ms": 2934,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤのことをきいていますか。",
          "start_ms": 225366,
          "end_ms": 228300,
          "duration_ms": 2934
        }
      ]
    },
    {
      "index": 54,
      "text": "とてもおこりました」。",
      "start_ms": 228800,
      "end_ms": 230910,
      "duration_ms": 2110,
      "clauses": [
        {
          "index": 0,
          "text": "とてもおこりました」。",
          "start_ms": 228800,
          "end_ms": 230910,
          "duration_ms": 2110
        }
      ]
    },
    {
      "index": 55,
      "text": "オートラはわらいました。",
      "start_ms": 231410,
      "end_ms": 233706,
      "duration_ms": 2296,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはわらいました。",
          "start_ms": 231410,
          "end_ms": 233706,
          "duration_ms": 2296
        }
      ]
    },
    {
      "index": 56,
      "text": "「よく、しっています。",
      "start_ms": 234206,
      "end_ms": 237178,
      "duration_ms": 2972,
      "clauses": [
        {
          "index": 0,
          "text": "「よく、",
          "start_ms": 234206,
          "end_ms": 235213,
          "duration_ms": 1007
        },
        {
          "index": 1,
          "text": "しっています。",
          "start_ms": 235463,
          "end_ms": 237178,
          "duration_ms": 1715
        }
      ]
    },
    {
      "index": 57,
      "text": "でははなします。",
      "start_ms": 237678,
      "end_ms": 239660,
      "duration_ms": 1982,
      "clauses": [
        {
          "index": 0,
          "text": "でははなします。",
          "start_ms": 237678,
          "end_ms": 239660,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 58,
      "text": "でもおかねがいります」。",
      "start_ms": 240160,
      "end_ms": 242467,
      "duration_ms": 2307,
      "clauses": [
        {
          "index": 0,
          "text": "でもおかねがいります」。",
          "start_ms": 240160,
          "end_ms": 242467,
          "duration_ms": 2307
        }
      ]
    },
    {
      "index": 59,
      "text": "「ではおかねはあげます」。",
      "start_ms": 242967,
      "end_ms": 245390,
      "duration_ms": 2423,
      "clauses": [
        {
          "index": 0,
          "text": "「ではおかねはあげます」。",
          "start_ms": 242967,
          "end_ms": 245390,
          "duration_ms": 2423
        }
      ]
    },
    {
      "index": 60,
      "text": "シチロウエモンはおかねをだしました。",
      "start_ms": 245890,
      "end_ms": 249393,
      "duration_ms": 3503,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはおかねをだしました。",
          "start_ms": 245890,
          "end_ms": 249393,
          "duration_ms": 3503
        }
      ]
    },
    {
      "index": 61,
      "text": "オートラはいいました。",
      "start_ms": 249893,
      "end_ms": 252003,
      "duration_ms": 2110,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 249893,
          "end_ms": 252003,
          "duration_ms": 2110
        }
      ]
    },
    {
      "index": 62,
      "text": "「とのさまはハチヤをみぎのものにします。",
      "start_ms": 252503,
      "end_ms": 256482,
      "duration_ms": 3979,
      "clauses": [
        {
          "index": 0,
          "text": "「とのさまはハチヤをみぎのものにします。",
          "start_ms": 252503,
          "end_ms": 256482,
          "duration_ms": 3979
        }
      ]
    },
    {
      "index": 63,
      "text": "それからカツノをハチヤにあげるそうです」。",
      "start_ms": 256982,
      "end_ms": 260625,
      "duration_ms": 3643,
      "clauses": [
        {
          "index": 0,
          "text": "それからカツノをハチヤにあげるそうです」。",
          "start_ms": 256982,
          "end_ms": 260625,
          "duration_ms": 3643
        }
      ]
    },
    {
      "index": 64,
      "text": "「そうですか。",
      "start_ms": 261125,
      "end_ms": 262805,
      "duration_ms": 1680,
      "clauses": [
        {
          "index": 0,
          "text": "「そうですか。",
          "start_ms": 261125,
          "end_ms": 262805,
          "duration_ms": 1680
        }
      ]
    },
    {
      "index": 65,
      "text": "そうなんですか」。",
      "start_ms": 263305,
      "end_ms": 265206,
      "duration_ms": 1901,
      "clauses": [
        {
          "index": 0,
          "text": "そうなんですか」。",
          "start_ms": 263305,
          "end_ms": 265206,
          "duration_ms": 1901
        }
      ]
    },
    {
      "index": 66,
      "text": "「そうです。",
      "start_ms": 265706,
      "end_ms": 267270,
      "duration_ms": 1564,
      "clauses": [
        {
          "index": 0,
          "text": "「そうです。",
          "start_ms": 265706,
          "end_ms": 267270,
          "duration_ms": 1564
        }
      ]
    },
    {
      "index": 67,
      "text": "おんなのひとたちがみな、そういいます」。",
      "start_ms": 267770,
      "end_ms": 272008,
      "duration_ms": 4238,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのひとたちがみな、",
          "start_ms": 267770,
          "end_ms": 270147,
          "duration_ms": 2377
        },
        {
          "index": 1,
          "text": "そういいます」。",
          "start_ms": 270397,
          "end_ms": 272008,
          "duration_ms": 1611
        }
      ]
    },
    {
      "index": 68,
      "text": "シチロウエモンはたちました。",
      "start_ms": 272508,
      "end_ms": 275280,
      "duration_ms": 2772,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはたちました。",
          "start_ms": 272508,
          "end_ms": 275280,
          "duration_ms": 2772
        }
      ]
    },
    {
      "index": 69,
      "text": "「ハチヤはころさなければ、なりません。",
      "start_ms": 275780,
      "end_ms": 280157,
      "duration_ms": 4377,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤはころさなければ、",
          "start_ms": 275780,
          "end_ms": 278296,
          "duration_ms": 2516
        },
        {
          "index": 1,
          "text": "なりません。",
          "start_ms": 278546,
          "end_ms": 280157,
          "duration_ms": 1611
        }
      ]
    },
    {
      "index": 70,
      "text": "そうして、はじめて、いいゆめをみます」。",
      "start_ms": 280657,
      "end_ms": 286198,
      "duration_ms": 5541,
      "clauses": [
        {
          "index": 0,
          "text": "そうして、",
          "start_ms": 280657,
          "end_ms": 282163,
          "duration_ms": 1506
        },
        {
          "index": 1,
          "text": "はじめて、",
          "start_ms": 282413,
          "end_ms": 283954,
          "duration_ms": 1541
        },
        {
          "index": 2,
          "text": "いいゆめをみます」。",
          "start_ms": 284204,
          "end_ms": 286198,
          "duration_ms": 1994
        }
      ]
    },
    {
      "index": 71,
      "text": "オートラはいいました。",
      "start_ms": 286698,
      "end_ms": 288843,
      "duration_ms": 2145,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 286698,
          "end_ms": 288843,
          "duration_ms": 2145
        }
      ]
    },
    {
      "index": 72,
      "text": "「わたしがじょうずにします。",
      "start_ms": 289343,
      "end_ms": 291836,
      "duration_ms": 2493,
      "clauses": [
        {
          "index": 0,
          "text": "「わたしがじょうずにします。",
          "start_ms": 289343,
          "end_ms": 291836,
          "duration_ms": 2493
        }
      ]
    },
    {
      "index": 73,
      "text": "しんぱいしないでください」。",
      "start_ms": 292336,
      "end_ms": 294876,
      "duration_ms": 2540,
      "clauses": [
        {
          "index": 0,
          "text": "しんぱいしないでください」。",
          "start_ms": 292336,
          "end_ms": 294876,
          "duration_ms": 2540
        }
      ]
    },
    {
      "index": 74,
      "text": "「ではそうします。",
      "start_ms": 295376,
      "end_ms": 297405,
      "duration_ms": 2029,
      "clauses": [
        {
          "index": 0,
          "text": "「ではそうします。",
          "start_ms": 295376,
          "end_ms": 297405,
          "duration_ms": 2029
        }
      ]
    },
    {
      "index": 75,
      "text": "じょうずにしてください」。",
      "start_ms": 297905,
      "end_ms": 300201,
      "duration_ms": 2296,
      "clauses": [
        {
          "index": 0,
          "text": "じょうずにしてください」。",
          "start_ms": 297905,
          "end_ms": 300201,
          "duration_ms": 2296
        }
      ]
    },
    {
      "index": 76,
      "text": "へやはもう、なにもありませんでした。",
      "start_ms": 300701,
      "end_ms": 305020,
      "duration_ms": 4319,
      "clauses": [
        {
          "index": 0,
          "text": "へやはもう、",
          "start_ms": 300701,
          "end_ms": 302300,
          "duration_ms": 1599
        },
        {
          "index": 1,
          "text": "なにもありませんでした。",
          "start_ms": 302550,
          "end_ms": 305020,
          "duration_ms": 2470
        }
      ]
    },
    {
      "index": 77,
      "text": "ふたりはなにもいいませんでした。",
      "start_ms": 305520,
      "end_ms": 308628,
      "duration_ms": 3108,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなにもいいませんでした。",
          "start_ms": 305520,
          "end_ms": 308628,
          "duration_ms": 3108
        }
      ]
    }
  ]
}