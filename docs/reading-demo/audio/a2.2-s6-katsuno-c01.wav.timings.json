      "start_ms": 187947,
      "end_ms": 190280,
      "duration_ms": 2333,
      "clauses": [
        {
          "index": 0,
          "text": "なまえはオートラです。",
          "start_ms": 187947,
          "end_ms": 190280,
          "duration_ms": 2333
        }
      ]
    },
    {
      "index": 44,
      "text": "オートラもしろではたらいていました。",
      "start_ms": 190780,
      "end_ms": 193914,
      "duration_ms": 3134,
      "clauses": [
        {
          "index": 0,
          "text": "オートラもしろではたらいていました。",
          "start_ms": 190780,
          "end_ms": 193914,
          "duration_ms": 3134
        }
      ]
    },
    {
      "index": 45,
      "text": "としをとっていました。",
      "start_ms": 194414,
      "end_ms": 196643,
      "duration_ms": 2229,
      "clauses": [
        {
          "index": 0,
          "text": "としをとっていました。",
          "start_ms": 194414,
          "end_ms": 196643,
          "duration_ms": 2229
        }
      ]
    },
    {
      "index": 46,
      "text": "おかねがすきでした。",
      "start_ms": 197143,
      "end_ms": 199290,
      "duration_ms": 2147,
      "clauses": [
        {
          "index": 0,
          "text": "おかねがすきでした。",
          "start_ms": 197143,
          "end_ms": 199290,
          "duration_ms": 2147
        }
      ]
    },
    {
      "index": 47,
      "text": "わるいこともするひとでした。",
      "start_ms": 199790,
      "end_ms": 202471,
      "duration_ms": 2681,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこともするひとでした。",
          "start_ms": 199790,
          "end_ms": 202471,
          "duration_ms": 2681
        }
      ]
    },
    {
      "index": 48,
      "text": "とのさまのこともおんなのひとたちのこともよく、しっていました。",
      "start_ms": 202971,
      "end_ms": 209176,
      "duration_ms": 6205,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまのこともおんなのひとたちのこともよく、",
          "start_ms": 202971,
          "end_ms": 207092,
          "duration_ms": 4121
        },
        {
          "index": 1,
          "text": "しっていました。",
          "start_ms": 207342,
          "end_ms": 209176,
          "duration_ms": 1834
        }
      ]
    },
    {
      "index": 49,
      "text": "だからシチロウエモンはオートラにあいました。",
      "start_ms": 209676,
      "end_ms": 213609,
      "duration_ms": 3933,
      "clauses": [
        {
          "index": 0,
          "text": "だからシチロウエモンはオートラにあいました。",
          "start_ms": 209676,
          "end_ms": 213609,
          "duration_ms": 3933
        }
      ]
    },
    {
      "index": 50,
      "text": "「シチロウエモンさん。",
      "start_ms": 214109,
      "end_ms": 216242,
      "duration_ms": 2133,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモンさん。",
          "start_ms": 214109,
          "end_ms": 216242,
          "duration_ms": 2133
        }
      ]
    },
    {
      "index": 51,
      "text": "かおがあかいですね。",
      "start_ms": 216742,
      "end_ms": 218820,
      "duration_ms": 2078,
      "clauses": [
        {
          "index": 0,
          "text": "かおがあかいですね。",
          "start_ms": 216742,
          "end_ms": 218820,
          "duration_ms": 2078
        }
      ]
    },
    {
      "index": 52,
      "text": "どうしましたか」。",
      "start_ms": 219320,
      "end_ms": 221200,
      "duration_ms": 1880,
      "clauses": [
        {
          "index": 0,
          "text": "どうしましたか」。",
          "start_ms": 219320,
          "end_ms": 221200,
          "duration_ms": 1880
        }
      ]
    },
    {
      "index": 53,
      "text": "「ハチヤのことをきいていますか。",
      "start_ms": 221700,
      "end_ms": 224509,
      "duration_ms": 2809,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤのことをきいていますか。",
          "start_ms": 221700,
          "end_ms": 224509,
          "duration_ms": 2809
        }
      ]
    },
    {
      "index": 54,
      "text": "とてもおこりました」。",
      "start_ms": 225009,
      "end_ms": 227133,
      "duration_ms": 2124,
      "clauses": [
        {
          "index": 0,
          "text": "とてもおこりました」。",
          "start_ms": 225009,
          "end_ms": 227133,
          "duration_ms": 2124
        }
      ]
    },
    {
      "index": 55,
      "text": "オートラはわらいました。",
      "start_ms": 227633,
      "end_ms": 229873,
      "duration_ms": 2240,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはわらいました。",
          "start_ms": 227633,
          "end_ms": 229873,
          "duration_ms": 2240
        }
      ]
    },
    {
      "index": 56,
      "text": "「よく、しっています。",
      "start_ms": 230373,
      "end_ms": 233223,
      "duration_ms": 2850,
      "clauses": [
        {
          "index": 0,
          "text": "「よく、",
          "start_ms": 230373,
          "end_ms": 231325,
          "duration_ms": 952
        },
        {
          "index": 1,
          "text": "しっています。",
          "start_ms": 231575,
          "end_ms": 233223,
          "duration_ms": 1648
        }
      ]
    },
    {
      "index": 57,
      "text": "でははなします。",
      "start_ms": 233723,
      "end_ms": 235603,
      "duration_ms": 1880,
      "clauses": [
        {
          "index": 0,
          "text": "でははなします。",
          "start_ms": 233723,
          "end_ms": 235603,
          "duration_ms": 1880
        }
      ]
    },
    {
      "index": 58,
      "text": "でもおかねがいります」。",
      "start_ms": 236103,
      "end_ms": 238378,
      "duration_ms": 2275,
      "clauses": [
        {
          "index": 0,
          "text": "でもおかねがいります」。",
          "start_ms": 236103,
          "end_ms": 238378,
          "duration_ms": 2275
        }
      ]
    },
    {
      "index": 59,
      "text": "「ではおかねはあげます」。",
      "start_ms": 238878,
      "end_ms": 241153,
      "duration_ms": 2275,
      "clauses": [
        {
          "index": 0,
          "text": "「ではおかねはあげます」。",
          "start_ms": 238878,
          "end_ms": 241153,
          "duration_ms": 2275
        }
      ]
    },
    {
      "index": 60,
      "text": "シチロウエモンはおかねをだしました。",
      "start_ms": 241653,
      "end_ms": 245168,
      "duration_ms": 3515,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはおかねをだしました。",
          "start_ms": 241653,
          "end_ms": 245168,
          "duration_ms": 3515
        }
      ]
    },
    {
      "index": 61,
      "text": "オートラはいいました。",
      "start_ms": 245668,
      "end_ms": 247734,
      "duration_ms": 2066,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 245668,
          "end_ms": 247734,
          "duration_ms": 2066
        }
      ]
    },
    {
      "index": 62,
      "text": "「とのさまはハチヤをみぎのものにします。",
      "start_ms": 248234,
      "end_ms": 252204,
      "duration_ms": 3970,
      "clauses": [
        {
          "index": 0,
          "text": "「とのさまはハチヤをみぎのものにします。",
          "start_ms": 248234,
          "end_ms": 252204,
          "duration_ms": 3970
        }
      ]
    },
    {
      "index": 63,
      "text": "それからカツノをハチヤにあげるそうです」。",
      "start_ms": 252704,
      "end_ms": 256279,
      "duration_ms": 3575,
      "clauses": [
        {
          "index": 0,
          "text": "それからカツノをハチヤにあげるそうです」。",
          "start_ms": 252704,
          "end_ms": 256279,
          "duration_ms": 3575
        }
      ]
    },
    {
      "index": 64,
      "text": "「そうですか。",
      "start_ms": 256779,
      "end_ms": 258381,
      "duration_ms": 1602,
      "clauses": [
        {
          "index": 0,
          "text": "「そうですか。",
          "start_ms": 256779,
          "end_ms": 258381,
          "duration_ms": 1602
        }
      ]
    },
    {
      "index": 65,
      "text": "そうなんですか」。",
      "start_ms": 258881,
      "end_ms": 260761,
      "duration_ms": 1880,
      "clauses": [
        {
          "index": 0,
          "text": "そうなんですか」。",
          "start_ms": 258881,
          "end_ms": 260761,
          "duration_ms": 1880
        }
      ]
    },
    {
      "index": 66,
      "text": "「そうです。",
      "start_ms": 261261,
      "end_ms": 262758,
      "duration_ms": 1497,
      "clauses": [
        {
          "index": 0,
          "text": "「そうです。",
          "start_ms": 261261,
          "end_ms": 262758,
          "duration_ms": 1497
        }
      ]
    },
    {
      "index": 67,
      "text": "おんなのひとたちがみな、そういいます」。",
      "start_ms": 263258,
      "end_ms": 267338,
      "duration_ms": 4080,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのひとたちがみな、",
          "start_ms": 263258,
          "end_ms": 265579,
          "duration_ms": 2321
        },
        {
          "index": 1,
          "text": "そういいます」。",
          "start_ms": 265829,
          "end_ms": 267338,
          "duration_ms": 1509
        }
      ]
    },
    {
      "index": 68,
      "text": "シチロウエモンはたちました。",
      "start_ms": 267838,
      "end_ms": 270621,
      "duration_ms": 2783,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはたちました。",
          "start_ms": 267838,
          "end_ms": 270621,
          "duration_ms": 2783
        }
      ]
    },
    {
      "index": 69,
      "text": "「ハチヤはころさなければ、なりません。",
      "start_ms": 271121,
      "end_ms": 275410,
      "duration_ms": 4289,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤはころさなければ、",
          "start_ms": 271121,
          "end_ms": 273640,
          "duration_ms": 2519
        },
        {
          "index": 1,
          "text": "なりません。",
          "start_ms": 273890,
          "end_ms": 275410,
          "duration_ms": 1520
        }
      ]
    },
    {
      "index": 70,
      "text": "そうして、はじめて、いいゆめをみます」。",
      "start_ms": 275910,
      "end_ms": 281250,
      "duration_ms": 5340,
      "clauses": [
        {
          "index": 0,
          "text": "そうして、",
          "start_ms": 275910,
          "end_ms": 277326,
          "duration_ms": 1416
        },
        {
          "index": 1,
          "text": "はじめて、",
          "start_ms": 277576,
          "end_ms": 279085,
          "duration_ms": 1509
        },
        {
          "index": 2,
          "text": "いいゆめをみます」。",
          "start_ms": 279335,
          "end_ms": 281250,
          "duration_ms": 1915
        }
      ]
    },
    {
      "index": 71,
      "text": "オートラはいいました。",
      "start_ms": 281750,
      "end_ms": 283816,
      "duration_ms": 2066,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 281750,
          "end_ms": 283816,
          "duration_ms": 2066
        }
      ]
    },
    {
      "index": 72,
      "text": "「わたしがじょうずにします。",
      "start_ms": 284316,
      "end_ms": 286707,
      "duration_ms": 2391,
      "clauses": [
        {
          "index": 0,
          "text": "「わたしがじょうずにします。",
          "start_ms": 284316,
          "end_ms": 286707,
          "duration_ms": 2391
        }
      ]
    },
    {
      "index": 73,
      "text": "しんぱいしないでください」。",
      "start_ms": 287207,
      "end_ms": 289668,
      "duration_ms": 2461,
      "clauses": [
        {
          "index": 0,
          "text": "しんぱいしないでください」。",
          "start_ms": 287207,
          "end_ms": 289668,
          "duration_ms": 2461
        }
      ]
    },
    {
      "index": 74,
      "text": "「ではそうします。",
      "start_ms": 290168,
      "end_ms": 292095,
      "duration_ms": 1927,
      "clauses": [
        {
          "index": 0,
          "text": "「ではそうします。",
          "start_ms": 290168,
          "end_ms": 292095,
          "duration_ms": 1927
        }
      ]
    },
    {
      "index": 75,
      "text": "じょうずにしてください」。",
      "start_ms": 292595,
      "end_ms": 294893,
      "duration_ms": 2298,
      "clauses": [
        {
          "index": 0,
          "text": "じょうずにしてください」。",
          "start_ms": 292595,
          "end_ms": 294893,
          "duration_ms": 2298
        }
      ]
    },
    {
      "index": 76,
      "text": "へやはもう、なにもありませんでした。",
      "start_ms": 295393,
      "end_ms": 299648,
      "duration_ms": 4255,
      "clauses": [
        {
          "index": 0,
          "text": "へやはもう、",
          "start_ms": 295393,
          "end_ms": 296960,
          "duration_ms": 1567
        },
        {
          "index": 1,
          "text": "なにもありませんでした。",
          "start_ms": 297210,
          "end_ms": 299648,
          "duration_ms": 2438
        }
      ]
    },
    {
      "index": 77,
      "text": "ふたりはなにもいいませんでした。",
      "start_ms": 300148,
      "end_ms": 303224,
      "duration_ms": 3076,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなにもいいませんでした。",
          "start_ms": 300148,
          "end_ms": 303224,
          "duration_ms": 3076
        }
      ]
    }
  ]
}