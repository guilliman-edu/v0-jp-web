      "index": 43,
      "text": "なまえはオートラです。",
      "start_ms": 191225,
      "end_ms": 193683,
      "duration_ms": 2458,
      "clauses": [
        {
          "index": 0,
          "text": "なまえはオートラです。",
          "start_ms": 191225,
          "end_ms": 193683,
          "duration_ms": 2458
        }
      ]
    },
    {
      "index": 44,
      "text": "オートラもしろではたらいていました。",
      "start_ms": 194183,
      "end_ms": 197350,
      "duration_ms": 3167,
      "clauses": [
        {
          "index": 0,
          "text": "オートラもしろではたらいていました。",
          "start_ms": 194183,
          "end_ms": 197350,
          "duration_ms": 3167
        }
      ]
    },
    {
      "index": 45,
      "text": "としをとっていました。",
      "start_ms": 197850,
      "end_ms": 200146,
      "duration_ms": 2296,
      "clauses": [
        {
          "index": 0,
          "text": "としをとっていました。",
          "start_ms": 197850,
          "end_ms": 200146,
          "duration_ms": 2296
        }
      ]
    },
    {
      "index": 46,
      "text": "おかねがすきでした。",
      "start_ms": 200646,
      "end_ms": 202814,
      "duration_ms": 2168,
      "clauses": [
        {
          "index": 0,
          "text": "おかねがすきでした。",
          "start_ms": 200646,
          "end_ms": 202814,
          "duration_ms": 2168
        }
      ]
    },
    {
      "index": 47,
      "text": "わるいこともするひとでした。",
      "start_ms": 203314,
      "end_ms": 206086,
      "duration_ms": 2772,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこともするひとでした。",
          "start_ms": 203314,
          "end_ms": 206086,
          "duration_ms": 2772
        }
      ]
    },
    {
      "index": 48,
      "text": "とのさまのこともおんなのひとたちのこともよく、しっていました。",
      "start_ms": 206586,
      "end_ms": 212949,
      "duration_ms": 6363,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまのこともおんなのひとたちのこともよく、",
          "start_ms": 206586,
          "end_ms": 210821,
          "duration_ms": 4235
        },
        {
          "index": 1,
          "text": "しっていました。",
          "start_ms": 211071,
          "end_ms": 212949,
          "duration_ms": 1878
        }
      ]
    },
    {
      "index": 49,
      "text": "だからシチロウエモンはオートラにあいました。",
      "start_ms": 213449,
      "end_ms": 217498,
      "duration_ms": 4049,
      "clauses": [
        {
          "index": 0,
          "text": "だからシチロウエモンはオートラにあいました。",
          "start_ms": 213449,
          "end_ms": 217498,
          "duration_ms": 4049
        }
      ]
    },
    {
      "index": 50,
      "text": "「シチロウエモンさん。",
      "start_ms": 217998,
      "end_ms": 219980,
      "duration_ms": 1982,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモンさん。",
          "start_ms": 217998,
          "end_ms": 219980,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 51,
      "text": "かおがあかいですね。",
      "start_ms": 220480,
      "end_ms": 222625,
      "duration_ms": 2145,
      "clauses": [
        {
          "index": 0,
          "text": "かおがあかいですね。",
          "start_ms": 220480,
          "end_ms": 222625,
          "duration_ms": 2145
        }
      ]
    },
    {
      "index": 52,
      "text": "どうしましたか」。",
      "start_ms": 223125,
      "end_ms": 225072,
      "duration_ms": 1947,
      "clauses": [
        {
          "index": 0,
          "text": "どうしましたか」。",
          "start_ms": 223125,
          "end_ms": 225072,
          "duration_ms": 1947
        }
      ]
    },
    {
      "index": 53,
      "text": "「ハチヤのことをきいていますか。",
      "start_ms": 225572,
      "end_ms": 228472,
      "duration_ms": 2900,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤのことをきいていますか。",
          "start_ms": 225572,
          "end_ms": 228472,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 54,
      "text": "とてもおこりました」。",
      "start_ms": 228972,
      "end_ms": 231163,
      "duration_ms": 2191,
      "clauses": [
        {
          "index": 0,
          "text": "とてもおこりました」。",
          "start_ms": 228972,
          "end_ms": 231163,
          "duration_ms": 2191
        }
      ]
    },
    {
      "index": 55,
      "text": "オートラはわらいました。",
      "start_ms": 231663,
      "end_ms": 233912,
      "duration_ms": 2249,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはわらいました。",
          "start_ms": 231663,
          "end_ms": 233912,
          "duration_ms": 2249
        }
      ]
    },
    {
      "index": 56,
      "text": "「よく、しっています。",
      "start_ms": 234412,
      "end_ms": 237407,
      "duration_ms": 2995,
      "clauses": [
        {
          "index": 0,
          "text": "「よく、",
          "start_ms": 234412,
          "end_ms": 235442,
          "duration_ms": 1030
        },
        {
          "index": 1,
          "text": "しっています。",
          "start_ms": 235692,
          "end_ms": 237407,
          "duration_ms": 1715
        }
      ]
    },
    {
      "index": 57,
      "text": "でははなします。",
      "start_ms": 237907,
      "end_ms": 239901,
      "duration_ms": 1994,
      "clauses": [
        {
          "index": 0,
          "text": "でははなします。",
          "start_ms": 237907,
          "end_ms": 239901,
          "duration_ms": 1994
        }
      ]
    },
    {
      "index": 58,
      "text": "でもおかねがいります」。",
      "start_ms": 240401,
      "end_ms": 242720,
      "duration_ms": 2319,
      "clauses": [
        {
          "index": 0,
          "text": "でもおかねがいります」。",
          "start_ms": 240401,
          "end_ms": 242720,
          "duration_ms": 2319
        }
      ]
    },
    {
      "index": 59,
      "text": "「ではおかねはあげます」。",
      "start_ms": 243220,
      "end_ms": 245620,
      "duration_ms": 2400,
      "clauses": [
        {
          "index": 0,
          "text": "「ではおかねはあげます」。",
          "start_ms": 243220,
          "end_ms": 245620,
          "duration_ms": 2400
        }
      ]
    },
    {
      "index": 60,
      "text": "シチロウエモンはおかねをだしました。",
      "start_ms": 246120,
      "end_ms": 249542,
      "duration_ms": 3422,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはおかねをだしました。",
          "start_ms": 246120,
          "end_ms": 249542,
          "duration_ms": 3422
        }
      ]
    },
    {
      "index": 61,
      "text": "オートラはいいました。",
      "start_ms": 250042,
      "end_ms": 252198,
      "duration_ms": 2156,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 250042,
          "end_ms": 252198,
          "duration_ms": 2156
        }
      ]
    },
    {
      "index": 62,
      "text": "「とのさまはハチヤをみぎのものにします。",
      "start_ms": 252698,
      "end_ms": 256712,
      "duration_ms": 4014,
      "clauses": [
        {
          "index": 0,
          "text": "「とのさまはハチヤをみぎのものにします。",
          "start_ms": 252698,
          "end_ms": 256712,
          "duration_ms": 4014
        }
      ]
    },
    {
      "index": 63,
      "text": "それからカツノをハチヤにあげるそうです」。",
      "start_ms": 257212,
      "end_ms": 260750,
      "duration_ms": 3538,
      "clauses": [
        {
          "index": 0,
          "text": "それからカツノをハチヤにあげるそうです」。",
          "start_ms": 257212,
          "end_ms": 260750,
          "duration_ms": 3538
        }
      ]
    },
    {
      "index": 64,
      "text": "「そうですか。",
      "start_ms": 261250,
      "end_ms": 262942,
      "duration_ms": 1692,
      "clauses": [
        {
          "index": 0,
          "text": "「そうですか。",
          "start_ms": 261250,
          "end_ms": 262942,
          "duration_ms": 1692
        }
      ]
    },
    {
      "index": 65,
      "text": "そうなんですか」。",
      "start_ms": 263442,
      "end_ms": 265366,
      "duration_ms": 1924,
      "clauses": [
        {
          "index": 0,
          "text": "そうなんですか」。",
          "start_ms": 263442,
          "end_ms": 265366,
          "duration_ms": 1924
        }
      ]
    },
    {
      "index": 66,
      "text": "「そうです。",
      "start_ms": 265866,
      "end_ms": 267396,
      "duration_ms": 1530,
      "clauses": [
        {
          "index": 0,
          "text": "「そうです。",
          "start_ms": 265866,
          "end_ms": 267396,
          "duration_ms": 1530
        }
      ]
    },
    {
      "index": 67,
      "text": "おんなのひとたちがみな、そういいます」。",
      "start_ms": 267896,
      "end_ms": 272169,
      "duration_ms": 4273,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのひとたちがみな、",
          "start_ms": 267896,
          "end_ms": 270308,
          "duration_ms": 2412
        },
        {
          "index": 1,
          "text": "そういいます」。",
          "start_ms": 270558,
          "end_ms": 272169,
          "duration_ms": 1611
        }
      ]
    },
    {
      "index": 68,
      "text": "シチロウエモンはたちました。",
      "start_ms": 272669,
      "end_ms": 275464,
      "duration_ms": 2795,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはたちました。",
          "start_ms": 272669,
          "end_ms": 275464,
          "duration_ms": 2795
        }
      ]
    },
    {
      "index": 69,
      "text": "「ハチヤはころさなければ、なりません。",
      "start_ms": 275964,
      "end_ms": 280445,
      "duration_ms": 4481,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤはころさなければ、",
          "start_ms": 275964,
          "end_ms": 278573,
          "duration_ms": 2609
        },
        {
          "index": 1,
          "text": "なりません。",
          "start_ms": 278823,
          "end_ms": 280445,
          "duration_ms": 1622
        }
      ]
    },
    {
      "index": 70,
      "text": "そうして、はじめて、いいゆめをみます」。",
      "start_ms": 280945,
      "end_ms": 286486,
      "duration_ms": 5541,
      "clauses": [
        {
          "index": 0,
          "text": "そうして、",
          "start_ms": 280945,
          "end_ms": 282451,
          "duration_ms": 1506
        },
        {
          "index": 1,
          "text": "はじめて、",
          "start_ms": 282701,
          "end_ms": 284254,
          "duration_ms": 1553
        },
        {
          "index": 2,
          "text": "いいゆめをみます」。",
          "start_ms": 284504,
          "end_ms": 286486,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 71,
      "text": "オートラはいいました。",
      "start_ms": 286986,
      "end_ms": 289154,
      "duration_ms": 2168,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 286986,
          "end_ms": 289154,
          "duration_ms": 2168
        }
      ]
    },
    {
      "index": 72,
      "text": "「わたしがじょうずにします。",
      "start_ms": 289654,
      "end_ms": 292136,
      "duration_ms": 2482,
      "clauses": [
        {
          "index": 0,
          "text": "「わたしがじょうずにします。",
          "start_ms": 289654,
          "end_ms": 292136,
          "duration_ms": 2482
        }
      ]
    },
    {
      "index": 73,
      "text": "しんぱいしないでください」。",
      "start_ms": 292636,
      "end_ms": 295176,
      "duration_ms": 2540,
      "clauses": [
        {
          "index": 0,
          "text": "しんぱいしないでください」。",
          "start_ms": 292636,
          "end_ms": 295176,
          "duration_ms": 2540
        }
      ]
    },
    {
      "index": 74,
      "text": "「ではそうします。",
      "start_ms": 295676,
      "end_ms": 297682,
      "duration_ms": 2006,
      "clauses": [
        {
          "index": 0,
          "text": "「ではそうします。",
          "start_ms": 295676,
          "end_ms": 297682,
          "duration_ms": 2006
        }
      ]
    },
    {
      "index": 75,
      "text": "じょうずにしてください」。",
      "start_ms": 298182,
      "end_ms": 300513,
      "duration_ms": 2331,
      "clauses": [
        {
          "index": 0,
          "text": "じょうずにしてください」。",
          "start_ms": 298182,
          "end_ms": 300513,
          "duration_ms": 2331
        }
      ]
    },
    {
      "index": 76,
      "text": "へやはもう、なにもありませんでした。",
      "start_ms": 301013,
      "end_ms": 305379,
      "duration_ms": 4366,
      "clauses": [
        {
          "index": 0,
          "text": "へやはもう、",
          "start_ms": 301013,
          "end_ms": 302659,
          "duration_ms": 1646
        },
        {
          "index": 1,
          "text": "なにもありませんでした。",
          "start_ms": 302909,
          "end_ms": 305379,
          "duration_ms": 2470
        }
      ]
    },
    {
      "index": 77,
      "text": "ふたりはなにもいいませんでした。",
      "start_ms": 305879,
      "end_ms": 308976,
      "duration_ms": 3097,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなにもいいませんでした。",
          "start_ms": 305879,
          "end_ms": 308976,
          "duration_ms": 3097
        }
      ]
    }
  ]
}