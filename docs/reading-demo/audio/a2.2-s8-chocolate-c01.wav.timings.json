    },
    {
      "index": 1,
      "text": "日本では、バレンタインデーに、女の人がすきな男の人にチョコレートをあげるしゅうかんがあります。",
      "start_ms": 2076,
      "end_ms": 11658,
      "duration_ms": 9582,
      "clauses": [
        {
          "index": 0,
          "text": "日本では、",
          "start_ms": 2076,
          "end_ms": 3722,
          "duration_ms": 1646
        },
        {
          "index": 1,
          "text": "バレンタインデーに、",
          "start_ms": 3972,
          "end_ms": 5873,
          "duration_ms": 1901
        },
        {
          "index": 2,
          "text": "女の人がすきな男の人にチョコレートをあげるしゅうかんがあります。",
          "start_ms": 6123,
          "end_ms": 11658,
          "duration_ms": 5535
        }
      ]
    },
    {
      "index": 2,
      "text": "これはがいこくにはあまりない、日本でゆうめいなしゅうかんです。",
      "start_ms": 12158,
      "end_ms": 18195,
      "duration_ms": 6037,
      "clauses": [
        {
          "index": 0,
          "text": "これはがいこくにはあまりない、",
          "start_ms": 12158,
          "end_ms": 14999,
          "duration_ms": 2841
        },
        {
          "index": 1,
          "text": "日本でゆうめいなしゅうかんです。",
          "start_ms": 15249,
          "end_ms": 18195,
          "duration_ms": 2946
        }
      ]
    },
    {
      "index": 3,
      "text": "こうべのもろぞふせいかというかいしゃが、このしゅうかんを始めたそうです。",
      "start_ms": 18695,
      "end_ms": 25545,
      "duration_ms": 6850,
      "clauses": [
        {
          "index": 0,
          "text": "こうべのもろぞふせいかというかいしゃが、",
          "start_ms": 18695,
          "end_ms": 22163,
          "duration_ms": 3468
        },
        {
          "index": 1,
          "text": "このしゅうかんを始めたそうです。",
          "start_ms": 22413,
          "end_ms": 25545,
          "duration_ms": 3132
        }
      ]
    },
    {
      "index": 4,
      "text": "かいしゃは、がいこくの人が読む英語のしんぶん『The Japan Advertiser』に、チョコレートのこうこくを出しました。",
      "start_ms": 26045,
      "end_ms": 34988,
      "duration_ms": 8943,
      "clauses": [
        {
          "index": 0,
          "text": "かいしゃは、",
          "start_ms": 26045,
          "end_ms": 27633,
          "duration_ms": 1588
        },
        {
          "index": 1,
          "text": "がいこくの人が読む英語のしんぶん『The Japan Advertiser』に、",
          "start_ms": 27883,
          "end_ms": 31676,
          "duration_ms": 3793
        },
        {
          "index": 2,
          "text": "チョコレートのこうこくを出しました。",
          "start_ms": 31926,
          "end_ms": 34988,
          "duration_ms": 3062
        }
      ]
    },
    {
      "index": 5,
      "text": "その後、ふじややもりながせいかなどのおかしのかいしゃも、なんかいも「バレンタインデーは女の人が男の人にチョコレートをあげる日です」と言いました。",
      "start_ms": 35488,
      "end_ms": 48983,
      "duration_ms": 13495,
      "clauses": [
        {
          "index": 0,
          "text": "その後、",
          "start_ms": 35488,
          "end_ms": 37076,
          "duration_ms": 1588
        },
        {
          "index": 1,
          "text": "ふじややもりながせいかなどのおかしのかいしゃも、",
          "start_ms": 37326,
          "end_ms": 41375,
          "duration_ms": 4049
        },
        {
          "index": 2,
          "text": "なんかいも「バレンタインデーは女の人が男の人にチョコレートをあげる日です」と言いました。",
          "start_ms": 41625,
          "end_ms": 48983,
          "duration_ms": 7358
        }
      ]
    },
    {
      "index": 6,
      "text": "こうして、むかしは日本になかったがいこくのぎょうじが、「チョコレートの日」になりました。",
      "start_ms": 49483,
      "end_ms": 58182,
      "duration_ms": 8699,
      "clauses": [
        {
          "index": 0,
          "text": "こうして、",
