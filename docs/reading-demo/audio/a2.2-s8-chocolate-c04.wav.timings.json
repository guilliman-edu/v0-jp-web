  "sentences": [
    {
      "index": 0,
      "text": "ぎりちょこと、その後の話",
      "start_ms": 0,
      "end_ms": 3213,
      "duration_ms": 3213,
      "clauses": [
        {
          "index": 0,
          "text": "ぎりちょこと、その後の話",
          "start_ms": 0,
          "end_ms": 3213,
          "duration_ms": 3213
        }
      ]
    },
    {
      "index": 1,
      "text": "バレンタインデーが日本でゆうめいになって、かいしゃではたらく女の人が、かいしゃの男の人にチョコレートをあげることも多くなりました。",
      "start_ms": 3713,
      "end_ms": 15814,
      "duration_ms": 12101,
      "clauses": [
        {
          "index": 0,
          "text": "バレンタインデーが日本でゆうめいになって、",
          "start_ms": 3713,
          "end_ms": 7193,
          "duration_ms": 3480
        },
        {
          "index": 1,
          "text": "かいしゃではたらく女の人が、",
          "start_ms": 7443,
          "end_ms": 10505,
          "duration_ms": 3062
        },
        {
          "index": 2,
          "text": "かいしゃの男の人にチョコレートをあげることも多くなりました。",
          "start_ms": 10755,
          "end_ms": 15814,
          "duration_ms": 5059
        }
      ]
    },
    {
      "index": 2,
      "text": "これを「ぎりちょこ」と言います。",
      "start_ms": 16314,
      "end_ms": 18900,
      "duration_ms": 2586,
      "clauses": [
        {
          "index": 0,
          "text": "これを「ぎりちょこ」と言います。",
          "start_ms": 16314,
          "end_ms": 18900,
          "duration_ms": 2586
        }
      ]
    },
    {
      "index": 3,
      "text": "ぎりちょこはせんきゅうひゃくはちじゅう年代に多くなりました。",
      "start_ms": 19400,
      "end_ms": 24691,
      "duration_ms": 5291,
      "clauses": [
        {
          "index": 0,
          "text": "ぎりちょこはせんきゅうひゃくはちじゅう年代に多くなりました。",
          "start_ms": 19400,
          "end_ms": 24691,
          "duration_ms": 5291
        }
      ]
    },
    {
      "index": 4,
      "text": "ホワイトデーも多くなったじだいです。",
      "start_ms": 25191,
      "end_ms": 28567,
      "duration_ms": 3376,
      "clauses": [
        {
          "index": 0,
          "text": "ホワイトデーも多くなったじだいです。",
          "start_ms": 25191,
          "end_ms": 28567,
          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 5,
      "text": "ぎりちょこは、がいこくにはない日本のぶんかです。",
      "start_ms": 29067,
      "end_ms": 34245,
      "duration_ms": 5178,
      "clauses": [
        {
          "index": 0,
          "text": "ぎりちょこは、",
          "start_ms": 29067,
          "end_ms": 30666,
          "duration_ms": 1599
        },
        {
          "index": 1,
          "text": "がいこくにはない日本のぶんかです。",
          "start_ms": 30916,
          "end_ms": 34245,
          "duration_ms": 3329
        }
      ]
    },
    {
      "index": 6,
      "text": "にせんじゅうさん年には、「これはぎりちょこだと見てわかるチョコ」というこうこくのことばで、おかしを売るかいしゃもありました。",
      "start_ms": 34745,
      "end_ms": 45801,
      "duration_ms": 11056,
      "clauses": [
        {
          "index": 0,
          "text": "にせんじゅうさん年には、",
          "start_ms": 34745,
          "end_ms": 37157,
          "duration_ms": 2412
        },
        {
          "index": 1,
          "text": "「これはぎりちょこだと見てわかるチョコ」というこうこくのことばで、",
          "start_ms": 37407,
          "end_ms": 42501,
          "duration_ms": 5094
        },
        {
          "index": 2,
          "text": "おかしを売るかいしゃもありました。",
          "start_ms": 42751,
          "end_ms": 45801,
          "duration_ms": 3050
        }
      ]
    },
    {
      "index": 7,
      "text": "しかし、女の人にも、おかえしをする男の人にも、おかねとじかんがかかります。",
      "start_ms": 46301,
      "end_ms": 56163,
      "duration_ms": 9862,
      "clauses": [
        {
          "index": 0,
          "text": "しかし、",
          "start_ms": 46301,
          "end_ms": 47772,
          "duration_ms": 1471
        },
        {
          "index": 1,
          "text": "女の人にも、",
          "start_ms": 48022,
          "end_ms": 50004,
          "duration_ms": 1982
        },
        {
          "index": 2,
          "text": "おかえしをする男の人にも、",
          "start_ms": 50254,
          "end_ms": 53188,
          "duration_ms": 2934
        },
        {
          "index": 3,
          "text": "おかねとじかんがかかります。",
          "start_ms": 53438,
          "end_ms": 56163,
          "duration_ms": 2725
        }
      ]
    },
    {
      "index": 8,
      "text": "だから、せんきゅうひゃくきゅうじゅう年代には、もう「ぎりちょこをやめたい」と言う人もいました。",
      "start_ms": 56663,
      "end_ms": 65456,
      "duration_ms": 8793,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 56663,
          "end_ms": 57833,
          "duration_ms": 1170
        },
        {
          "index": 1,
          "text": "せんきゅうひゃくきゅうじゅう年代には、",
          "start_ms": 58083,
          "end_ms": 61180,
          "duration_ms": 3097
        },
        {
          "index": 2,
          "text": "もう「ぎりちょこをやめたい」と言う人もいました。",
          "start_ms": 61430,
          "end_ms": 65456,
          "duration_ms": 4026
        }
      ]
    },
    {
      "index": 9,
      "text": "あるかいしゃは、ぎりちょこをやめました。",
      "start_ms": 65956,
      "end_ms": 70403,
      "duration_ms": 4447,
      "clauses": [
        {
          "index": 0,
          "text": "あるかいしゃは、",
          "start_ms": 65956,
          "end_ms": 67753,
          "duration_ms": 1797
        },
        {
          "index": 1,
          "text": "ぎりちょこをやめました。",
          "start_ms": 68003,
          "end_ms": 70403,
          "duration_ms": 2400
        }
      ]
    },
    {
      "index": 10,
      "text": "そして、かいしゃの人から、500円を出してもいい人から集めて、にしあふりかのおとこのこやおんなのこに送りました。",
      "start_ms": 70903,
      "end_ms": 82973,
      "duration_ms": 12070,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 70903,
          "end_ms": 72270,
          "duration_ms": 1367
        },
        {
          "index": 1,
          "text": "かいしゃの人から、",
          "start_ms": 72520,
          "end_ms": 74514,
          "duration_ms": 1994
        },
        {
          "index": 2,
          "text": "500円を出してもいい人から集めて、",
          "start_ms": 74764,
          "end_ms": 78279,
          "duration_ms": 3515
        },
        {
          "index": 3,
          "text": "にしあふりかのおとこのこやおんなのこに送りました。",
          "start_ms": 78529,
          "end_ms": 82973,
          "duration_ms": 4444
        }
      ]
    },
    {
      "index": 11,
      "text": "にせんきゅう年には、マッチ・ドットコム ジャパンというかいしゃが、かいしゃの中でぎりちょこをあげることをやめました。",
      "start_ms": 83473,
      "end_ms": 94158,
      "duration_ms": 10685,
      "clauses": [
        {
          "index": 0,
          "text": "にせんきゅう年には、",
          "start_ms": 83473,
          "end_ms": 85595,
          "duration_ms": 2122
        },
        {
          "index": 1,
          "text": "マッチ・ドットコム ジャパンというかいしゃが、",
          "start_ms": 85845,
          "end_ms": 89418,
          "duration_ms": 3573
        },
        {
          "index": 2,
          "text": "かいしゃの中でぎりちょこをあげることをやめました。",
          "start_ms": 89668,
          "end_ms": 94158,
          "duration_ms": 4490
        }
      ]
    },
    {
      "index": 12,
      "text": "そしてにせんじゅうはち年、チョコレートのかいしゃのゴディバが、しんぶんに「日本は、ぎりちょこをやめよう」というこうこくを出しました。",
      "start_ms": 94658,
      "end_ms": 107366,
      "duration_ms": 12708,
      "clauses": [
        {
          "index": 0,
          "text": "そしてにせんじゅうはち年、",
          "start_ms": 94658,
          "end_ms": 97488,
          "duration_ms": 2830
        },
        {
          "index": 1,
          "text": "チョコレートのかいしゃのゴディバが、",
          "start_ms": 97738,
          "end_ms": 100707,
          "duration_ms": 2969
        },
        {
          "index": 2,
          "text": "しんぶんに「日本は、",
          "start_ms": 100957,
          "end_ms": 103148,
          "duration_ms": 2191
        },
        {
          "index": 3,
          "text": "ぎりちょこをやめよう」というこうこくを出しました。",
          "start_ms": 103398,
          "end_ms": 107366,
          "duration_ms": 3968
        }
      ]
    },
    {
      "index": 13,
      "text": "多くの人がこのこうこくの話をしました。",
      "start_ms": 107866,
      "end_ms": 112600,
      "duration_ms": 4734,
      "clauses": [
        {
          "index": 0,
          "text": "多くの人がこのこうこくの話をしました。",
          "start_ms": 107866,
          "end_ms": 112600,
          "duration_ms": 4734
        }
      ]
    },
    {
      "index": 14,
      "text": "ゴディバジャパンのしゃちょうは、バレンタインデーはチョコレートをもらう人の日ではなく、あげる人の日だと言っています。",
      "start_ms": 113100,
      "end_ms": 123692,
      "duration_ms": 10592,
      "clauses": [
        {
          "index": 0,
          "text": "ゴディバジャパンのしゃちょうは、",
          "start_ms": 113100,
          "end_ms": 115721,
          "duration_ms": 2621
        },
        {
          "index": 1,
          "text": "バレンタインデーはチョコレートをもらう人の日ではなく、",
          "start_ms": 115971,
          "end_ms": 120519,
          "duration_ms": 4548
        },
        {
          "index": 2,
          "text": "あげる人の日だと言っています。",
          "start_ms": 120769,
          "end_ms": 123692,
          "duration_ms": 2923
        }
      ]
    },
    {
      "index": 15,
      "text": "そして、ぎりちょこをあげたくない人がいるなら、やめたほうがいいと説明しています。",
      "start_ms": 124192,
      "end_ms": 133077,
      "duration_ms": 8885,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 124192,
          "end_ms": 125582,
          "duration_ms": 1390
        },
        {
          "index": 1,
          "text": "ぎりちょこをあげたくない人がいるなら、",
          "start_ms": 125832,
          "end_ms": 129126,
          "duration_ms": 3294
        },
        {
          "index": 2,
          "text": "やめたほうがいいと説明しています。",
          "start_ms": 129376,
          "end_ms": 133077,
          "duration_ms": 3701
        }
      ]
    }
  ]
