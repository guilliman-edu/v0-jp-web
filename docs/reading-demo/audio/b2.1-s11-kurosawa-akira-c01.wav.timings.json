  "sentences": [
    {
      "index": 0,
      "text": "一、かいがから映画へ",
      "start_ms": 0,
      "end_ms": 2892,
      "duration_ms": 2892,
      "clauses": [
        {
          "index": 0,
          "text": "一、",
          "start_ms": 0,
          "end_ms": 723,
          "duration_ms": 723
        },
        {
          "index": 1,
          "text": "かいがから映画へ",
          "start_ms": 973,
          "end_ms": 2892,
          "duration_ms": 1919
        }
      ]
    },
    {
      "index": 1,
      "text": "くろさわあきらは1910年、とうきょうに生まれた。",
      "start_ms": 3392,
      "end_ms": 9000,
      "duration_ms": 5608,
      "clauses": [
        {
          "index": 0,
          "text": "くろさわあきらは1910年、",
          "start_ms": 3392,
          "end_ms": 6808,
          "duration_ms": 3416
        },
        {
          "index": 1,
          "text": "とうきょうに生まれた。",
          "start_ms": 7058,
          "end_ms": 9000,
          "duration_ms": 1942
        }
      ]
    },
    {
      "index": 2,
      "text": "八人のきょうだいがいた。",
      "start_ms": 9500,
      "end_ms": 11790,
      "duration_ms": 2290,
      "clauses": [
        {
          "index": 0,
          "text": "八人のきょうだいがいた。",
          "start_ms": 9500,
          "end_ms": 11790,
          "duration_ms": 2290
        }
      ]
    },
    {
      "index": 3,
      "text": "ちちは厳しかったが、映画に興味があり、よくきょうだいをえいがかんに連れて行った。",
      "start_ms": 12290,
      "end_ms": 20369,
      "duration_ms": 8079,
      "clauses": [
        {
          "index": 0,
          "text": "ちちは厳しかったが、",
          "start_ms": 12290,
          "end_ms": 14476,
          "duration_ms": 2186
        },
        {
          "index": 1,
          "text": "映画に興味があり、",
          "start_ms": 14726,
          "end_ms": 16761,
          "duration_ms": 2035
        },
        {
          "index": 2,
          "text": "よくきょうだいをえいがかんに連れて行った。",
          "start_ms": 17011,
          "end_ms": 20369,
          "duration_ms": 3358
        }
      ]
    },
    {
      "index": 4,
      "text": "黒澤は若いときから映画を見ながら育った。",
      "start_ms": 20869,
      "end_ms": 24785,
      "duration_ms": 3916,
      "clauses": [
        {
          "index": 0,
          "text": "黒澤は若いときから映画を見ながら育った。",
          "start_ms": 20869,
          "end_ms": 24785,
          "duration_ms": 3916
        }
      ]
    },
    {
      "index": 5,
      "text": "小学校の先生は、黒澤のかいがを「とてもいい」と言ってくれた。",
      "start_ms": 25285,
      "end_ms": 31590,
      "duration_ms": 6305,
      "clauses": [
        {
          "index": 0,
          "text": "小学校の先生は、",
          "start_ms": 25285,
          "end_ms": 27622,
          "duration_ms": 2337
        },
        {
          "index": 1,
          "text": "黒澤のかいがを「とてもいい」と言ってくれた。",
          "start_ms": 27872,
          "end_ms": 31590,
          "duration_ms": 3718
        }
      ]
    },
    {
      "index": 6,
      "text": "それから、黒澤はかいがを描くことにむちゅうになった。",
      "start_ms": 32090,
      "end_ms": 37792,
      "duration_ms": 5702,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 32090,
          "end_ms": 33533,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "黒澤はかいがを描くことにむちゅうになった。",
          "start_ms": 33783,
          "end_ms": 37792,
          "duration_ms": 4009
        }
      ]
    },
    {
      "index": 7,
      "text": "学校ではしょうせつをたくさん読み、じんせいについても勉強した。",
      "start_ms": 38292,
      "end_ms": 44260,
      "duration_ms": 5968,
      "clauses": [
        {
          "index": 0,
          "text": "学校ではしょうせつをたくさん読み、",
          "start_ms": 38292,
          "end_ms": 41290,
          "duration_ms": 2998
        },
        {
          "index": 1,
          "text": "じんせいについても勉強した。",
          "start_ms": 41540,
          "end_ms": 44260,
          "duration_ms": 2720
        }
      ]
    },
    {
      "index": 8,
      "text": "はじめはかいがの仕事をしたいと思っていた。",
      "start_ms": 44760,
      "end_ms": 48664,
      "duration_ms": 3904,
      "clauses": [
        {
          "index": 0,
          "text": "はじめはかいがの仕事をしたいと思っていた。",
          "start_ms": 44760,
          "end_ms": 48664,
          "duration_ms": 3904
        }
      ]
    },
    {
      "index": 9,
      "text": "しかし、1936年に映画のかいしゃに入り、映画を作る人のそばで作り方を習った。",
      "start_ms": 49164,
      "end_ms": 58764,
      "duration_ms": 9600,
      "clauses": [
        {
          "index": 0,
          "text": "しかし、",
          "start_ms": 49164,
          "end_ms": 50502,
          "duration_ms": 1338
        },
        {
          "index": 1,
          "text": "1936年に映画のかいしゃに入り、",
          "start_ms": 50752,
          "end_ms": 54807,
          "duration_ms": 4055
        },
        {
          "index": 2,
          "text": "映画を作る人のそばで作り方を習った。",
          "start_ms": 55057,
          "end_ms": 58764,
          "duration_ms": 3707
        }
      ]
    },
    {
      "index": 10,
      "text": "1943年、『姿三四郎』で初めて自分で映画を作った。",
      "start_ms": 59264,
      "end_ms": 66231,
      "duration_ms": 6967,
      "clauses": [
        {
          "index": 0,
          "text": "1943年、",
          "start_ms": 59264,
          "end_ms": 61856,
          "duration_ms": 2592
        },
        {
          "index": 1,
          "text": "『姿三四郎』で初めて自分で映画を作った。",
