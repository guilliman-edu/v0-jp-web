    },
    {
      "index": 1,
      "text": "すもうのはじまりは、とても古いはなしです。",
      "start_ms": 2436,
      "end_ms": 7394,
      "duration_ms": 4958,
      "clauses": [
        {
          "index": 0,
          "text": "すもうのはじまりは、",
          "start_ms": 2436,
          "end_ms": 4662,
          "duration_ms": 2226
        },
        {
          "index": 1,
          "text": "とても古いはなしです。",
          "start_ms": 4912,
          "end_ms": 7394,
          "duration_ms": 2482
        }
      ]
    },
    {
      "index": 2,
      "text": "昔の本に、二人のかみさまがすもうをしたはなしがあります。",
      "start_ms": 7894,
      "end_ms": 14001,
      "duration_ms": 6107,
      "clauses": [
        {
          "index": 0,
          "text": "昔の本に、",
          "start_ms": 7894,
          "end_ms": 9760,
          "duration_ms": 1866
        },
        {
          "index": 1,
          "text": "二人のかみさまがすもうをしたはなしがあります。",
          "start_ms": 10010,
          "end_ms": 14001,
          "duration_ms": 3991
        }
      ]
    },
    {
      "index": 3,
      "text": "そのころ、日本ではこめを作っていました。",
      "start_ms": 14501,
      "end_ms": 19586,
      "duration_ms": 5085,
      "clauses": [
        {
          "index": 0,
          "text": "そのころ、",
          "start_ms": 14501,
          "end_ms": 16100,
          "duration_ms": 1599
        },
        {
          "index": 1,
          "text": "日本ではこめを作っていました。",
          "start_ms": 16350,
          "end_ms": 19586,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 4,
      "text": "すもうは、のうかの大切なぎょうじでした。",
      "start_ms": 20086,
      "end_ms": 24637,
      "duration_ms": 4551,
      "clauses": [
        {
          "index": 0,
          "text": "すもうは、",
          "start_ms": 20086,
          "end_ms": 21383,
          "duration_ms": 1297
        },
        {
          "index": 1,
          "text": "のうかの大切なぎょうじでした。",
          "start_ms": 21633,
          "end_ms": 24637,
          "duration_ms": 3004
        }
      ]
    },
    {
      "index": 5,
      "text": "のうかの人は、すもうを見て、こめがたくさんできると思いました。",
      "start_ms": 25137,
      "end_ms": 32548,
      "duration_ms": 7411,
      "clauses": [
        {
          "index": 0,
          "text": "のうかの人は、",
          "start_ms": 25137,
          "end_ms": 27050,
          "duration_ms": 1913
        },
        {
          "index": 1,
          "text": "すもうを見て、",
          "start_ms": 27300,
          "end_ms": 29073,
          "duration_ms": 1773
        },
        {
          "index": 2,
          "text": "こめがたくさんできると思いました。",
          "start_ms": 29323,
          "end_ms": 32548,
          "duration_ms": 3225
        }
      ]
    },
    {
      "index": 6,
      "text": "かまくらやせんごくのじだいには、ぶしもすもうを習いました。",
      "start_ms": 33048,
      "end_ms": 39062,
      "duration_ms": 6014,
      "clauses": [
        {
          "index": 0,
          "text": "かまくらやせんごくのじだいには、",
          "start_ms": 33048,
          "end_ms": 36098,
          "duration_ms": 3050
        },
        {
          "index": 1,
          "text": "ぶしもすもうを習いました。",
          "start_ms": 36348,
          "end_ms": 39062,
          "duration_ms": 2714
        }
      ]
    },
    {
      "index": 7,
      "text": "ぶしはすもうをして、強くなりました。",
      "start_ms": 39562,
      "end_ms": 43939,
      "duration_ms": 4377,
      "clauses": [
        {
          "index": 0,
          "text": "ぶしはすもうをして、",
          "start_ms": 39562,
          "end_ms": 41707,
          "duration_ms": 2145
        },
        {
          "index": 1,
          "text": "強くなりました。",
          "start_ms": 41957,
          "end_ms": 43939,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 8,
      "text": "おだのぶながはすもうがとてもすきだったそうです。",
      "start_ms": 44439,
      "end_ms": 48697,
      "duration_ms": 4258,
      "clauses": [
        {
          "index": 0,
          "text": "おだのぶながはすもうがとてもすきだったそうです。",
          "start_ms": 44439,
          "end_ms": 48697,
          "duration_ms": 4258
        }
      ]
    },
    {
