          "end_ms": 54271,
          "duration_ms": 3190
        },
        {
          "index": 2,
          "text": "すもうを取らせました。",
          "start_ms": 54521,
          "end_ms": 56817,
          "duration_ms": 2296
        }
      ]
    },
    {
      "index": 10,
      "text": "えどじだいに、すもうはとても人気のあるぎょうじになりました。",
      "start_ms": 57317,
      "end_ms": 63482,
      "duration_ms": 6165,
      "clauses": [
        {
          "index": 0,
          "text": "えどじだいに、",
