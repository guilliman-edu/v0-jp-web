      "text": "のぶながは、いろいろなくにからりきしを集めて、すもうを取らせました。",
      "start_ms": 49197,
      "end_ms": 56817,
      "duration_ms": 7620,
      "clauses": [
        {
          "index": 0,
          "text": "のぶながは、",
          "start_ms": 49197,
          "end_ms": 50831,
          "duration_ms": 1634
        },
        {
