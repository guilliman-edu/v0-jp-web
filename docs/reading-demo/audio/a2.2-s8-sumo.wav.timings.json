          "duration_ms": 1715
        },
        {
          "index": 1,
          "text": "すもうはとても人気のあるぎょうじになりました。",
          "start_ms": 59282,
          "end_ms": 63482,
          "duration_ms": 4200
        }
      ]
    },
    {
      "index": 11,
      "text": "りきしはすもうでおかねをもらえましたし、すもうを見る人もたくさんいました。",
      "start_ms": 63982,
      "end_ms": 71239,
      "duration_ms": 7257,
      "clauses": [
        {
          "index": 0,
          "text": "りきしはすもうでおかねをもらえましたし、",
