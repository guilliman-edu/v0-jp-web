          "text": "てんぷるだいがくにほんこうのほりぐち先生は、",
          "start_ms": 91794,
          "end_ms": 96128,
          "duration_ms": 4334
        },
        {
          "index": 1,
          "text": "ホワイトデーもおかしのかいしゃが作ったぶんかだと言っています。",
          "start_ms": 96378,
