          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 1,
      "text": "チョコレートをもらった男の人は、おかえしに何がほしいですか。",
      "start_ms": 3545,
      "end_ms": 10733,
      "duration_ms": 7188,
      "clauses": [
        {
          "index": 0,
          "text": "チョコレートをもらった男の人は、",
