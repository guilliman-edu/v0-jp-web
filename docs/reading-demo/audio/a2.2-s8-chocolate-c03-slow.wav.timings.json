          "index": 1,
          "text": "おかえしに何がほしいですか。",
          "start_ms": 7200,
          "end_ms": 10733,
          "duration_ms": 3533
        }
      ]
    },
    {
      "index": 2,
      "text": "そこで、ふくおかしのおかしのみせ、いしむらまんせいどうが、せんきゅうひゃくななじゅうはち年に「マシュマロデー」を始めました。",
      "start_ms": 11233,
      "end_ms": 24255,
      "duration_ms": 13022,
      "clauses": [
        {
          "index": 0,
          "text": "そこで、",
          "start_ms": 11233,
          "end_ms": 12571,
          "duration_ms": 1338
        },
        {
          "index": 1,
          "text": "ふくおかしのおかしのみせ、",
          "start_ms": 12821,
          "end_ms": 15703,
          "duration_ms": 2882
        },
        {
          "index": 2,
          "text": "いしむらまんせいどうが、",
          "start_ms": 15953,
          "end_ms": 18487,
          "duration_ms": 2534
        },
        {
          "index": 3,
          "text": "せんきゅうひゃくななじゅうはち年に「マシュマロデー」を始めました。",
          "start_ms": 18737,
          "end_ms": 24255,
          "duration_ms": 5518
        }
      ]
    },
    {
      "index": 3,
      "text": "そして、「おかえしにマシュマロをあげましょう」と言いました。",
      "start_ms": 24755,
      "end_ms": 30677,
      "duration_ms": 5922,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 24755,
          "end_ms": 26291,
          "duration_ms": 1536
        },
        {
          "index": 1,
          "text": "「おかえしにマシュマロをあげましょう」と言いました。",
          "start_ms": 26541,
          "end_ms": 30677,
          "duration_ms": 4136
        }
      ]
    },
    {
      "index": 4,
      "text": "その後も、いちねんに一回、あたらしいこうこくやしゃしんを作りました。",
      "start_ms": 31177,
      "end_ms": 40057,
      "duration_ms": 8880,
      "clauses": [
        {
          "index": 0,
          "text": "その後も、",
          "start_ms": 31177,
          "end_ms": 33119,
          "duration_ms": 1942
        },
        {
          "index": 1,
          "text": "いちねんに一回、",
          "start_ms": 33369,
          "end_ms": 35636,
          "duration_ms": 2267
        },
        {
          "index": 2,
          "text": "あたらしいこうこくやしゃしんを作りました。",
          "start_ms": 35886,
          "end_ms": 40057,
          "duration_ms": 4171
        }
      ]
    },
    {
      "index": 5,
      "text": "「マシュマロデー」が「ホワイトデー」というなまえになったときも、みせは「ホワイトデーはマシュマロデー」と言って、「おかえしにマシュマロをあげましょう」と言いました。",
      "start_ms": 40557,
      "end_ms": 54256,
      "duration_ms": 13699,
      "clauses": [
        {
          "index": 0,
          "text": "「マシュマロデー」が「ホワイトデー」というなまえになったときも、",
          "start_ms": 40557,
          "end_ms": 45402,
          "duration_ms": 4845
        },
        {
          "index": 1,
          "text": "みせは「ホワイトデーはマシュマロデー」と言って、",
          "start_ms": 45652,
          "end_ms": 49858,
          "duration_ms": 4206
        },
        {
          "index": 2,
          "text": "「おかえしにマシュマロをあげましょう」と言いました。",
          "start_ms": 50108,
          "end_ms": 54256,
          "duration_ms": 4148
        }
      ]
    },
    {
      "index": 6,
      "text": "ながいれきしの中で作ったこうこくやしゃしんには、ふるいじだいのものもおおいです。",
      "start_ms": 54756,
      "end_ms": 62942,
      "duration_ms": 8186,
      "clauses": [
        {
          "index": 0,
          "text": "ながいれきしの中で作ったこうこくやしゃしんには、",
