        {
          "index": 0,
          "text": "「この人も当人じゃありません。",
          "start_ms": 193297,
          "end_ms": 196040,
          "duration_ms": 2743
        }
      ]
    },
    {
      "index": 40,
      "text": "もう他に娘はいないのですか？」",
      "start_ms": 196540,
      "end_ms": 199399,
      "duration_ms": 2859,
      "clauses": [
        {
          "index": 0,
          "text": "もう他に娘はいないのですか？」",
          "start_ms": 196540,
          "end_ms": 199399,
          "duration_ms": 2859
        }
      ]
    },
    {
      "index": 41,
      "text": "と言いました。",
      "start_ms": 199899,
      "end_ms": 201435,
      "duration_ms": 1536,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 199899,
          "end_ms": 201435,
          "duration_ms": 1536
        }
      ]
    },
    {
      "index": 42,
      "text": "「はい、いません。",
      "start_ms": 201935,
      "end_ms": 204443,
      "duration_ms": 2508,
      "clauses": [
        {
          "index": 0,
          "text": "「はい、",
          "start_ms": 201935,
          "end_ms": 202530,
          "duration_ms": 595
        },
        {
          "index": 1,
          "text": "いません。",
          "start_ms": 202780,
          "end_ms": 204443,
          "duration_ms": 1663
        }
      ]
    },
    {
      "index": 43,
      "text": "まだ亡くなった妻が残していった、少し風変わりな台所女中はいますが、はなよめとはとんでもございません。」",
      "start_ms": 204943,
      "end_ms": 215344,
      "duration_ms": 10401,
      "clauses": [
        {
          "index": 0,
          "text": "まだ亡くなった妻が残していった、",
          "start_ms": 204943,
          "end_ms": 207953,
          "duration_ms": 3010
        },
        {
          "index": 1,
          "text": "少し風変わりな台所女中はいますが、",
          "start_ms": 208203,
          "end_ms": 211968,
          "duration_ms": 3765
        },
        {
          "index": 2,
          "text": "はなよめとはとんでもございません。」",
          "start_ms": 212218,
          "end_ms": 215344,
          "duration_ms": 3126
        }
      ]
    },
    {
      "index": 44,
      "text": "父親はそう言いました。",
      "start_ms": 215844,
      "end_ms": 218413,
      "duration_ms": 2569,
      "clauses": [
        {
          "index": 0,
          "text": "父親はそう言いました。",
          "start_ms": 215844,
          "end_ms": 218413,
          "duration_ms": 2569
        }
      ]
    },
    {
      "index": 45,
      "text": "おうじは、その娘を連れてくるように言いました。",
      "start_ms": 218913,
      "end_ms": 223419,
      "duration_ms": 4506,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは、",
          "start_ms": 218913,
          "end_ms": 220031,
          "duration_ms": 1118
        },
        {
          "index": 1,
          "text": "その娘を連れてくるように言いました。",
          "start_ms": 220281,
          "end_ms": 223419,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 46,
      "text": "母親は「とんでもございません。",
      "start_ms": 223919,
      "end_ms": 226743,
      "duration_ms": 2824,
      "clauses": [
        {
          "index": 0,
          "text": "母親は「とんでもございません。",
          "start_ms": 223919,
          "end_ms": 226743,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 47,
      "text": "あまりにも汚くて、お目にかかりませんよ。」",
      "start_ms": 227243,
      "end_ms": 231783,
      "duration_ms": 4540,
      "clauses": [
        {
          "index": 0,
          "text": "あまりにも汚くて、",
          "start_ms": 227243,
          "end_ms": 229382,
          "duration_ms": 2139
        },
        {
          "index": 1,
          "text": "お目にかかりませんよ。」",
          "start_ms": 229632,
          "end_ms": 231783,
          "duration_ms": 2151
        }
      ]
    },
    {
      "index": 48,
      "text": "と答えました。",
      "start_ms": 232283,
      "end_ms": 233993,
      "duration_ms": 1710,
      "clauses": [
        {
          "index": 0,
          "text": "と答えました。",
          "start_ms": 232283,
          "end_ms": 233993,
          "duration_ms": 1710
        }
      ]
    },
    {
      "index": 49,
      "text": "でも、おうじあくまで言い張ったので、シンデレラを呼ばなければなりませんでした。",
      "start_ms": 234493,
      "end_ms": 241770,
      "duration_ms": 7277,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 234493,
          "end_ms": 235378,
          "duration_ms": 885
        },
        {
          "index": 1,
          "text": "おうじあくまで言い張ったので、",
          "start_ms": 235628,
          "end_ms": 238104,
          "duration_ms": 2476
        },
        {
          "index": 2,
          "text": "シンデレラを呼ばなければなりませんでした。",
          "start_ms": 238354,
          "end_ms": 241770,
          "duration_ms": 3416
        }
      ]
    },
    {
      "index": 50,
      "text": "娘はまず両手と顔を洗ってきれいにし、おうじの前に行ってお辞儀をしました。",
      "start_ms": 242270,
      "end_ms": 249457,
      "duration_ms": 7187,
      "clauses": [
        {
          "index": 0,
          "text": "娘はまず両手と顔を洗ってきれいにし、",
          "start_ms": 242270,
          "end_ms": 246162,
          "duration_ms": 3892
        },
        {
          "index": 1,
          "text": "おうじの前に行ってお辞儀をしました。",
          "start_ms": 246412,
          "end_ms": 249457,
          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 51,
      "text": "おうじは娘に金の靴を渡しました。",
      "start_ms": 249957,
      "end_ms": 253455,
      "duration_ms": 3498,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘に金の靴を渡しました。",
          "start_ms": 249957,
          "end_ms": 253455,
          "duration_ms": 3498
        }
      ]
    },
    {
      "index": 52,
      "text": "娘は足載せ台に座って、重い木の靴から足を出して、うわぐつを履きました。",
      "start_ms": 253955,
      "end_ms": 262451,
      "duration_ms": 8496,
      "clauses": [
        {
          "index": 0,
          "text": "娘は足載せ台に座って、",
          "start_ms": 253955,
          "end_ms": 256953,
          "duration_ms": 2998
        },
        {
          "index": 1,
          "text": "重い木の靴から足を出して、",
          "start_ms": 257203,
          "end_ms": 260027,
          "duration_ms": 2824
        },
        {
          "index": 2,
          "text": "うわぐつを履きました。",
          "start_ms": 260277,
          "end_ms": 262451,
          "duration_ms": 2174
        }
      ]
    },
    {
      "index": 53,
      "text": "ぴったり合いました。",
      "start_ms": 262951,
      "end_ms": 264846,
      "duration_ms": 1895,
      "clauses": [
        {
          "index": 0,
          "text": "ぴったり合いました。",
          "start_ms": 262951,
          "end_ms": 264846,
          "duration_ms": 1895
        }
      ]
    },
    {
      "index": 54,
      "text": "娘が立ち上がると、おうじはその顔を見て、自分が踊ったうつくしい娘だと分かりました。",
      "start_ms": 265346,
      "end_ms": 274318,
      "duration_ms": 8972,
      "clauses": [
        {
          "index": 0,
          "text": "娘が立ち上がると、",
          "start_ms": 265346,
          "end_ms": 267543,
          "duration_ms": 2197
        },
        {
          "index": 1,
          "text": "おうじはその顔を見て、",
          "start_ms": 267793,
          "end_ms": 270141,
          "duration_ms": 2348
        },
        {
          "index": 2,
          "text": "自分が踊ったうつくしい娘だと分かりました。",
          "start_ms": 270391,
          "end_ms": 274318,
          "duration_ms": 3927
        }
      ]
    },
    {
      "index": 55,
      "text": "「この人が本当のはなよめだ！」",
      "start_ms": 274818,
      "end_ms": 277584,
      "duration_ms": 2766,
      "clauses": [
        {
          "index": 0,
          "text": "「この人が本当のはなよめだ！」",
          "start_ms": 274818,
          "end_ms": 277584,
          "duration_ms": 2766
        }
      ]
    },
    {
      "index": 56,
      "text": "と叫びました。",
      "start_ms": 278084,
      "end_ms": 279875,
      "duration_ms": 1791,
      "clauses": [
        {
          "index": 0,
          "text": "と叫びました。",
          "start_ms": 278084,
          "end_ms": 279875,
          "duration_ms": 1791
        }
      ]
    },
    {
      "index": 57,
      "text": "ままははと二人の姉たちは恐ろしくなって、怒りで青ざめました。",
      "start_ms": 280375,
      "end_ms": 286726,
      "duration_ms": 6351,
      "clauses": [
        {
          "index": 0,
          "text": "ままははと二人の姉たちは恐ろしくなって、",
          "start_ms": 280375,
          "end_ms": 284244,
          "duration_ms": 3869
        },
        {
          "index": 1,
          "text": "怒りで青ざめました。",
          "start_ms": 284494,
          "end_ms": 286726,
          "duration_ms": 2232
        }
      ]
    },
    {
      "index": 58,
      "text": "おうじはシンデレラを馬に乗せて、一緒に去りました。",
      "start_ms": 287226,
      "end_ms": 292428,
      "duration_ms": 5202,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはシンデレラを馬に乗せて、",
          "start_ms": 287226,
          "end_ms": 290190,
          "duration_ms": 2964
        },
        {
          "index": 1,
          "text": "一緒に去りました。",
          "start_ms": 290440,
          "end_ms": 292428,
          "duration_ms": 1988
        }
      ]
    },
    {
      "index": 59,
      "text": "はしばみの木のそばを通ると、二羽の白いはとが叫びました。",
      "start_ms": 292928,
      "end_ms": 298861,
      "duration_ms": 5933,
      "clauses": [
        {
          "index": 0,
          "text": "はしばみの木のそばを通ると、",
          "start_ms": 292928,
          "end_ms": 295729,
          "duration_ms": 2801
        },
        {
          "index": 1,
          "text": "二羽の白いはとが叫びました。",
          "start_ms": 295979,
          "end_ms": 298861,
          "duration_ms": 2882
        }
      ]
    },
    {
      "index": 60,
      "text": "「振り向いて覗いてごらん。",
      "start_ms": 299361,
      "end_ms": 301616,
      "duration_ms": 2255,
      "clauses": [
        {
          "index": 0,
          "text": "「振り向いて覗いてごらん。",
          "start_ms": 299361,
          "end_ms": 301616,
          "duration_ms": 2255
        }
      ]
    },
    {
      "index": 61,
      "text": "振り向いて覗いてごらん。",
      "start_ms": 302116,
      "end_ms": 304406,
      "duration_ms": 2290,
      "clauses": [
        {
          "index": 0,
          "text": "振り向いて覗いてごらん。",
          "start_ms": 302116,
          "end_ms": 304406,
          "duration_ms": 2290
        }
      ]
    },
    {
      "index": 62,
      "text": "靴に血がついていないよ。",
      "start_ms": 304906,
      "end_ms": 307243,
      "duration_ms": 2337,
      "clauses": [
        {
          "index": 0,
          "text": "靴に血がついていないよ。",
          "start_ms": 304906,
          "end_ms": 307243,
          "duration_ms": 2337
        }
      ]
    },
    {
      "index": 63,
      "text": "靴は小さすぎない。",
      "start_ms": 307743,
      "end_ms": 309871,
      "duration_ms": 2128,
      "clauses": [
        {
          "index": 0,
          "text": "靴は小さすぎない。",
          "start_ms": 307743,
          "end_ms": 309871,
          "duration_ms": 2128
        }
      ]
    },
    {
      "index": 64,
      "text": "本当のはなよめがあなたと一緒だよ。」",
      "start_ms": 310371,
      "end_ms": 313776,
      "duration_ms": 3405,
      "clauses": [
        {
          "index": 0,
          "text": "本当のはなよめがあなたと一緒だよ。」",
          "start_ms": 310371,
          "end_ms": 313776,
          "duration_ms": 3405
        }
      ]
    },
    {
      "index": 65,
      "text": "二羽は降りってきて、シンデレラの肩に止まりました。",
      "start_ms": 314276,
      "end_ms": 319396,
      "duration_ms": 5120,
      "clauses": [
        {
          "index": 0,
          "text": "二羽は降りってきて、",
          "start_ms": 314276,
          "end_ms": 316380,
          "duration_ms": 2104
        },
        {
          "index": 1,
          "text": "シンデレラの肩に止まりました。",
          "start_ms": 316630,
          "end_ms": 319396,
          "duration_ms": 2766
        }
      ]
    },
    {
      "index": 66,
      "text": "一羽が右に、もう一羽が左に、そのまま座ったままになりました。",
      "start_ms": 319896,
      "end_ms": 327011,
      "duration_ms": 7115,
      "clauses": [
        {
          "index": 0,
          "text": "一羽が右に、",
          "start_ms": 319896,
          "end_ms": 321524,
          "duration_ms": 1628
        },
        {
          "index": 1,
          "text": "もう一羽が左に、",
          "start_ms": 321774,
          "end_ms": 323786,
          "duration_ms": 2012
        },
        {
          "index": 2,
          "text": "そのまま座ったままになりました。",
          "start_ms": 324036,
          "end_ms": 327011,
          "duration_ms": 2975
        }
      ]
    },
    {
      "index": 67,
      "text": "おうじのけっこんしきが行われることになりました。",
      "start_ms": 327511,
      "end_ms": 331508,
      "duration_ms": 3997,
      "clauses": [
        {
          "index": 0,
          "text": "おうじのけっこんしきが行われることになりました。",
          "start_ms": 327511,
          "end_ms": 331508,
          "duration_ms": 3997
        }
      ]
    },
    {
      "index": 68,
      "text": "二人の不実な姉たちがやってきて、シンデレラの機嫌をとり、幸せを分けてもらおうとしました。",
      "start_ms": 332008,
      "end_ms": 341178,
      "duration_ms": 9170,
      "clauses": [
        {
          "index": 0,
          "text": "二人の不実な姉たちがやってきて、",
          "start_ms": 332008,
          "end_ms": 335146,
          "duration_ms": 3138
        },
        {
          "index": 1,
          "text": "シンデレラの機嫌をとり、",
          "start_ms": 335396,
          "end_ms": 337802,
          "duration_ms": 2406
        },
        {
          "index": 2,
          "text": "幸せを分けてもらおうとしました。",
          "start_ms": 338052,
          "end_ms": 341178,
          "duration_ms": 3126
        }
      ]
    },
    {
      "index": 69,
      "text": "きょうかいに行ったとき、姉は右側に、妹は左側にいました。",
      "start_ms": 341678,
      "end_ms": 348723,
      "duration_ms": 7045,
      "clauses": [
        {
          "index": 0,
          "text": "きょうかいに行ったとき、",
          "start_ms": 341678,
          "end_ms": 343701,
          "duration_ms": 2023
        },
        {
          "index": 1,
          "text": "姉は右側に、",
          "start_ms": 343951,
          "end_ms": 345823,
          "duration_ms": 1872
        },
        {
          "index": 2,
          "text": "妹は左側にいました。",
          "start_ms": 346073,
          "end_ms": 348723,
          "duration_ms": 2650
        }
      ]
    },
    {
      "index": 70,
      "text": "はとたちがそれぞれから片目をつついて取り出しました。",
      "start_ms": 349223,
      "end_ms": 353638,
      "duration_ms": 4415,
      "clauses": [
        {
          "index": 0,
          "text": "はとたちがそれぞれから片目をつついて取り出しました。",
          "start_ms": 349223,
          "end_ms": 353638,
          "duration_ms": 4415
        }
      ]
    },
    {
      "index": 71,
      "text": "帰りには姉が左、妹が右になったので、はとたちはそれぞれからもう一つの目をつついて取り出しました。",
      "start_ms": 354138,
      "end_ms": 364666,
      "duration_ms": 10528,
      "clauses": [
        {
          "index": 0,
          "text": "帰りには姉が左、",
          "start_ms": 354138,
          "end_ms": 356672,
          "duration_ms": 2534
        },
        {
          "index": 1,
          "text": "妹が右になったので、",
          "start_ms": 356922,
          "end_ms": 359328,
          "duration_ms": 2406
        },
        {
          "index": 2,
          "text": "はとたちはそれぞれからもう一つの目をつついて取り出しました。",
          "start_ms": 359578,
          "end_ms": 364666,
          "duration_ms": 5088
        }
      ]
    },
    {
      "index": 72,
      "text": "こうして、いじわるとふせいじつな二人は、ばつを受けて、しょうがい目が見えないままでした。",
      "start_ms": 365166,
      "end_ms": 374437,
      "duration_ms": 9271,
      "clauses": [
        {
          "index": 0,
          "text": "こうして、",
          "start_ms": 365166,
          "end_ms": 366469,
          "duration_ms": 1303
        },
        {
          "index": 1,
          "text": "いじわるとふせいじつな二人は、",
          "start_ms": 366719,
          "end_ms": 369485,
          "duration_ms": 2766
        },
        {
          "index": 2,
          "text": "ばつを受けて、",
          "start_ms": 369735,
          "end_ms": 371363,
          "duration_ms": 1628
        },
        {
          "index": 3,
          "text": "しょうがい目が見えないままでした。",
          "start_ms": 371613,
          "end_ms": 374437,
          "duration_ms": 2824
        }
      ]
    }
  ]
}