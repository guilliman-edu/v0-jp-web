          "index": 0,
          "text": "「この人も当人じゃありません。",
          "start_ms": 193300,
          "end_ms": 195997,
          "duration_ms": 2697
        }
      ]
    },
    {
      "index": 40,
      "text": "もう他に娘はいないのですか？",
      "start_ms": 196497,
      "end_ms": 199310,
      "duration_ms": 2813,
      "clauses": [
        {
          "index": 0,
          "text": "もう他に娘はいないのですか？",
          "start_ms": 196497,
          "end_ms": 199310,
          "duration_ms": 2813
        }
      ]
    },
    {
      "index": 41,
      "text": "」と言いました。",
      "start_ms": 199810,
      "end_ms": 201322,
      "duration_ms": 1512,
      "clauses": [
        {
          "index": 0,
          "text": "」と言いました。",
          "start_ms": 199810,
          "end_ms": 201322,
          "duration_ms": 1512
        }
      ]
    },
    {
      "index": 42,
      "text": "「はい、いません。",
      "start_ms": 201822,
      "end_ms": 204307,
      "duration_ms": 2485,
      "clauses": [
        {
          "index": 0,
          "text": "「はい、",
          "start_ms": 201822,
          "end_ms": 202394,
          "duration_ms": 572
        },
        {
          "index": 1,
          "text": "いません。",
          "start_ms": 202644,
          "end_ms": 204307,
          "duration_ms": 1663
        }
      ]
    },
    {
      "index": 43,
      "text": "まだ亡くなった妻が残していった、少し風変わりな台所女中はいますが、はなよめとはとんでもございません。",
      "start_ms": 204807,
      "end_ms": 215185,
      "duration_ms": 10378,
      "clauses": [
        {
          "index": 0,
          "text": "まだ亡くなった妻が残していった、",
          "start_ms": 204807,
          "end_ms": 207805,
          "duration_ms": 2998
        },
        {
          "index": 1,
          "text": "少し風変わりな台所女中はいますが、",
          "start_ms": 208055,
          "end_ms": 211820,
          "duration_ms": 3765
        },
        {
          "index": 2,
          "text": "はなよめとはとんでもございません。",
          "start_ms": 212070,
          "end_ms": 215185,
          "duration_ms": 3115
        }
      ]
    },
    {
      "index": 44,
      "text": "」父親はそう言いました。",
      "start_ms": 215685,
      "end_ms": 218265,
      "duration_ms": 2580,
      "clauses": [
        {
          "index": 0,
          "text": "」父親はそう言いました。",
          "start_ms": 215685,
          "end_ms": 218265,
          "duration_ms": 2580
        }
      ]
    },
    {
      "index": 45,
      "text": "おうじは、その娘を連れてくるように言いました。",
      "start_ms": 218765,
      "end_ms": 223259,
      "duration_ms": 4494,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは、",
          "start_ms": 218765,
          "end_ms": 219848,
          "duration_ms": 1083
        },
        {
          "index": 1,
          "text": "その娘を連れてくるように言いました。",
          "start_ms": 220098,
          "end_ms": 223259,
          "duration_ms": 3161
        }
      ]
    },
    {
      "index": 46,
      "text": "母親は「とんでもございません。",
      "start_ms": 223759,
      "end_ms": 226537,
      "duration_ms": 2778,
      "clauses": [
        {
          "index": 0,
          "text": "母親は「とんでもございません。",
          "start_ms": 223759,
          "end_ms": 226537,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 47,
      "text": "あまりにも汚くて、お目にかかりませんよ。",
      "start_ms": 227037,
      "end_ms": 231414,
      "duration_ms": 4377,
      "clauses": [
        {
          "index": 0,
          "text": "あまりにも汚くて、",
          "start_ms": 227037,
          "end_ms": 229060,
          "duration_ms": 2023
        },
        {
          "index": 1,
          "text": "お目にかかりませんよ。",
          "start_ms": 229310,
          "end_ms": 231414,
          "duration_ms": 2104
        }
      ]
    },
    {
      "index": 48,
      "text": "」と答えました。",
      "start_ms": 231914,
      "end_ms": 233566,
      "duration_ms": 1652,
      "clauses": [
        {
          "index": 0,
          "text": "」と答えました。",
          "start_ms": 231914,
          "end_ms": 233566,
          "duration_ms": 1652
        }
      ]
    },
    {
      "index": 49,
      "text": "でも、おうじあくまで言い張ったので、シンデレラを呼ばなければなりませんでした。",
      "start_ms": 234066,
      "end_ms": 241251,
      "duration_ms": 7185,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 234066,
          "end_ms": 234963,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "おうじあくまで言い張ったので、",
          "start_ms": 235213,
          "end_ms": 237619,
          "duration_ms": 2406
        },
        {
          "index": 2,
          "text": "シンデレラを呼ばなければなりませんでした。",
          "start_ms": 237869,
          "end_ms": 241251,
          "duration_ms": 3382
        }
      ]
    },
    {
      "index": 50,
      "text": "娘はまず両手と顔を洗ってきれいにし、おうじの前に行ってお辞儀をしました。",
      "start_ms": 241751,
      "end_ms": 248903,
      "duration_ms": 7152,
      "clauses": [
        {
          "index": 0,
          "text": "娘はまず両手と顔を洗ってきれいにし、",
          "start_ms": 241751,
          "end_ms": 245713,
          "duration_ms": 3962
        },
        {
          "index": 1,
          "text": "おうじの前に行ってお辞儀をしました。",
          "start_ms": 245963,
          "end_ms": 248903,
          "duration_ms": 2940
        }
      ]
    },
    {
      "index": 51,
      "text": "おうじは娘に金の靴を渡しました。",
      "start_ms": 249403,
      "end_ms": 253017,
      "duration_ms": 3614,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘に金の靴を渡しました。",
          "start_ms": 249403,
          "end_ms": 253017,
          "duration_ms": 3614
        }
      ]
    },
    {
      "index": 52,
      "text": "娘は足載せ台に座って、重い木の靴から足を出して、うわぐつを履きました。",
      "start_ms": 253517,
      "end_ms": 262142,
      "duration_ms": 8625,
      "clauses": [
        {
          "index": 0,
          "text": "娘は足載せ台に座って、",
          "start_ms": 253517,
          "end_ms": 256550,
          "duration_ms": 3033
        },
        {
          "index": 1,
          "text": "重い木の靴から足を出して、",
          "start_ms": 256800,
          "end_ms": 259706,
          "duration_ms": 2906
        },
        {
          "index": 2,
          "text": "うわぐつを履きました。",
          "start_ms": 259956,
          "end_ms": 262142,
          "duration_ms": 2186
        }
      ]
    },
    {
      "index": 53,
      "text": "ぴったり合いました。",
      "start_ms": 262642,
      "end_ms": 264596,
      "duration_ms": 1954,
      "clauses": [
        {
          "index": 0,
          "text": "ぴったり合いました。",
          "start_ms": 262642,
          "end_ms": 264596,
          "duration_ms": 1954
        }
      ]
    },
    {
      "index": 54,
      "text": "娘が立ち上がると、おうじはその顔を見て、自分が踊ったうつくしい娘だと分かりました。",
      "start_ms": 265096,
      "end_ms": 274162,
      "duration_ms": 9066,
      "clauses": [
        {
          "index": 0,
          "text": "娘が立ち上がると、",
          "start_ms": 265096,
          "end_ms": 267270,
          "duration_ms": 2174
        },
        {
          "index": 1,
          "text": "おうじはその顔を見て、",
          "start_ms": 267520,
          "end_ms": 269950,
          "duration_ms": 2430
        },
        {
          "index": 2,
          "text": "自分が踊ったうつくしい娘だと分かりました。",
          "start_ms": 270200,
          "end_ms": 274162,
          "duration_ms": 3962
        }
      ]
    },
    {
      "index": 55,
      "text": "「この人が本当のはなよめだ！",
      "start_ms": 274662,
      "end_ms": 277428,
      "duration_ms": 2766,
      "clauses": [
        {
          "index": 0,
          "text": "「この人が本当のはなよめだ！",
          "start_ms": 274662,
          "end_ms": 277428,
          "duration_ms": 2766
        }
      ]
    },
    {
      "index": 56,
      "text": "」と叫びました。",
      "start_ms": 277928,
      "end_ms": 279754,
      "duration_ms": 1826,
      "clauses": [
        {
          "index": 0,
          "text": "」と叫びました。",
          "start_ms": 277928,
          "end_ms": 279754,
          "duration_ms": 1826
        }
      ]
    },
    {
      "index": 57,
      "text": "ままははと二人の姉たちは恐ろしくなって、怒りで青ざめました。",
      "start_ms": 280254,
      "end_ms": 286710,
      "duration_ms": 6456,
      "clauses": [
        {
          "index": 0,
          "text": "ままははと二人の姉たちは恐ろしくなって、",
          "start_ms": 280254,
          "end_ms": 284193,
          "duration_ms": 3939
        },
        {
          "index": 1,
          "text": "怒りで青ざめました。",
          "start_ms": 284443,
          "end_ms": 286710,
          "duration_ms": 2267
        }
      ]
    },
    {
      "index": 58,
      "text": "おうじはシンデレラを馬に乗せて、一緒に去りました。",
      "start_ms": 287210,
      "end_ms": 292470,
      "duration_ms": 5260,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはシンデレラを馬に乗せて、",
          "start_ms": 287210,
          "end_ms": 290232,
          "duration_ms": 3022
        },
        {
          "index": 1,
          "text": "一緒に去りました。",
          "start_ms": 290482,
          "end_ms": 292470,
          "duration_ms": 1988
        }
      ]
    },
    {
      "index": 59,
      "text": "はしばみの木のそばを通ると、二羽の白いはとが叫びました。",
      "start_ms": 292970,
      "end_ms": 298892,
      "duration_ms": 5922,
      "clauses": [
        {
          "index": 0,
          "text": "はしばみの木のそばを通ると、",
          "start_ms": 292970,
          "end_ms": 295783,
          "duration_ms": 2813
        },
        {
          "index": 1,
          "text": "二羽の白いはとが叫びました。",
          "start_ms": 296033,
          "end_ms": 298892,
          "duration_ms": 2859
        }
      ]
    },
    {
      "index": 60,
      "text": "「振り向いて覗いてごらん。",
      "start_ms": 299392,
      "end_ms": 301694,
      "duration_ms": 2302,
      "clauses": [
        {
          "index": 0,
          "text": "「振り向いて覗いてごらん。",
          "start_ms": 299392,
          "end_ms": 301694,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 61,
      "text": "振り向いて覗いてごらん。",
      "start_ms": 302194,
      "end_ms": 304461,
      "duration_ms": 2267,
      "clauses": [
        {
          "index": 0,
          "text": "振り向いて覗いてごらん。",
          "start_ms": 302194,
          "end_ms": 304461,
          "duration_ms": 2267
        }
      ]
    },
    {
      "index": 62,
      "text": "靴に血がついていないよ。",
      "start_ms": 304961,
      "end_ms": 307286,
      "duration_ms": 2325,
      "clauses": [
        {
          "index": 0,
          "text": "靴に血がついていないよ。",
          "start_ms": 304961,
          "end_ms": 307286,
          "duration_ms": 2325
        }
      ]
    },
    {
      "index": 63,
      "text": "靴は小さすぎない。",
      "start_ms": 307786,
      "end_ms": 309902,
      "duration_ms": 2116,
      "clauses": [
        {
          "index": 0,
          "text": "靴は小さすぎない。",
          "start_ms": 307786,
          "end_ms": 309902,
          "duration_ms": 2116
        }
      ]
    },
    {
      "index": 64,
      "text": "本当のはなよめがあなたと一緒だよ。",
      "start_ms": 310402,
      "end_ms": 313923,
      "duration_ms": 3521,
      "clauses": [
        {
          "index": 0,
          "text": "本当のはなよめがあなたと一緒だよ。",
          "start_ms": 310402,
          "end_ms": 313923,
          "duration_ms": 3521
        }
      ]
    },
    {
      "index": 65,
      "text": "」 二羽は降りってきて、シンデレラの肩に止まりました。",
      "start_ms": 314423,
      "end_ms": 319590,
      "duration_ms": 5167,
      "clauses": [
        {
          "index": 0,
          "text": "」 二羽は降りってきて、",
          "start_ms": 314423,
          "end_ms": 316527,
          "duration_ms": 2104
        },
        {
          "index": 1,
          "text": "シンデレラの肩に止まりました。",
          "start_ms": 316777,
          "end_ms": 319590,
          "duration_ms": 2813
        }
      ]
    },
    {
      "index": 66,
      "text": "一羽が右に、もう一羽が左に、そのまま座ったままになりました。",
      "start_ms": 320090,
      "end_ms": 327228,
      "duration_ms": 7138,
      "clauses": [
        {
          "index": 0,
          "text": "一羽が右に、",
          "start_ms": 320090,
          "end_ms": 321730,
          "duration_ms": 1640
        },
        {
          "index": 1,
          "text": "もう一羽が左に、",
          "start_ms": 321980,
          "end_ms": 323968,
          "duration_ms": 1988
        },
        {
          "index": 2,
          "text": "そのまま座ったままになりました。",
          "start_ms": 324218,
          "end_ms": 327228,
          "duration_ms": 3010
        }
      ]
    },
    {
      "index": 67,
      "text": "おうじのけっこんしきが行われることになりました。",
      "start_ms": 327728,
      "end_ms": 331702,
      "duration_ms": 3974,
      "clauses": [
        {
          "index": 0,
          "text": "おうじのけっこんしきが行われることになりました。",
          "start_ms": 327728,
          "end_ms": 331702,
          "duration_ms": 3974
        }
      ]
    },
    {
      "index": 68,
      "text": "二人の不実な姉たちがやってきて、シンデレラの機嫌をとり、幸せを分けてもらおうとしました。",
      "start_ms": 332202,
      "end_ms": 341303,
      "duration_ms": 9101,
      "clauses": [
        {
          "index": 0,
          "text": "二人の不実な姉たちがやってきて、",
          "start_ms": 332202,
          "end_ms": 335247,
          "duration_ms": 3045
        },
        {
          "index": 1,
          "text": "シンデレラの機嫌をとり、",
          "start_ms": 335497,
          "end_ms": 337880,
          "duration_ms": 2383
        },
        {
          "index": 2,
          "text": "幸せを分けてもらおうとしました。",
          "start_ms": 338130,
          "end_ms": 341303,
          "duration_ms": 3173
        }
      ]
    },
    {
      "index": 69,
      "text": "きょうかいに行ったとき、姉は右側に、妹は左側にいました。",
      "start_ms": 341803,
      "end_ms": 348837,
      "duration_ms": 7034,
      "clauses": [
        {
          "index": 0,
          "text": "きょうかいに行ったとき、",
          "start_ms": 341803,
          "end_ms": 343861,
          "duration_ms": 2058
        },
        {
          "index": 1,
          "text": "姉は右側に、",
          "start_ms": 344111,
          "end_ms": 345972,
          "duration_ms": 1861
        },
        {
          "index": 2,
          "text": "妹は左側にいました。",
          "start_ms": 346222,
          "end_ms": 348837,
          "duration_ms": 2615
        }
      ]
    },
    {
      "index": 70,
      "text": "はとたちがそれぞれから片目をつついて取り出しました。",
      "start_ms": 349337,
      "end_ms": 353729,
      "duration_ms": 4392,
      "clauses": [
        {
          "index": 0,
          "text": "はとたちがそれぞれから片目をつついて取り出しました。",
          "start_ms": 349337,
          "end_ms": 353729,
          "duration_ms": 4392
        }
      ]
    },
    {
      "index": 71,
      "text": "帰りには姉が左、妹が右になったので、はとたちはそれぞれからもう一つの目をつついて取り出しました。",
      "start_ms": 354229,
      "end_ms": 364734,
      "duration_ms": 10505,
      "clauses": [
        {
          "index": 0,
          "text": "帰りには姉が左、",
          "start_ms": 354229,
          "end_ms": 356775,
          "duration_ms": 2546
        },
        {
          "index": 1,
          "text": "妹が右になったので、",
          "start_ms": 357025,
          "end_ms": 359431,
          "duration_ms": 2406
        },
        {
          "index": 2,
          "text": "はとたちはそれぞれからもう一つの目をつついて取り出しました。",
          "start_ms": 359681,
          "end_ms": 364734,
          "duration_ms": 5053
        }
      ]
    },
    {
      "index": 72,
      "text": "こうして、いじわるとふせいじつな二人は、ばつを受けて、しょうがい目が見えないままでした。",
      "start_ms": 365234,
      "end_ms": 374437,
      "duration_ms": 9203,
      "clauses": [
        {
          "index": 0,
          "text": "こうして、",
          "start_ms": 365234,
          "end_ms": 366526,
          "duration_ms": 1292
        },
        {
          "index": 1,
          "text": "いじわるとふせいじつな二人は、",
          "start_ms": 366776,
          "end_ms": 369507,
          "duration_ms": 2731
        },
        {
          "index": 2,
          "text": "ばつを受けて、",
          "start_ms": 369757,
          "end_ms": 371409,
          "duration_ms": 1652
        },
        {
          "index": 3,
          "text": "しょうがい目が見えないままでした。",
          "start_ms": 371659,
          "end_ms": 374437,
          "duration_ms": 2778
        }
      ]
    }
  ]
}