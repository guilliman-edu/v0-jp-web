        {
          "index": 0,
          "text": "「この人も当人じゃありません。",
          "start_ms": 193264,
          "end_ms": 195937,
          "duration_ms": 2673
        }
      ]
    },
    {
      "index": 40,
      "text": "もう他に娘はいないのですか？」",
      "start_ms": 196437,
      "end_ms": 199285,
      "duration_ms": 2848,
      "clauses": [
        {
          "index": 0,
          "text": "もう他に娘はいないのですか？」",
          "start_ms": 196437,
          "end_ms": 199285,
          "duration_ms": 2848
        }
      ]
    },
    {
      "index": 41,
      "text": "と言いました。",
      "start_ms": 199785,
      "end_ms": 201332,
      "duration_ms": 1547,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 199785,
          "end_ms": 201332,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 42,
      "text": "「はい、いません。",
      "start_ms": 201832,
      "end_ms": 204318,
      "duration_ms": 2486,
      "clauses": [
        {
          "index": 0,
          "text": "「はい、",
          "start_ms": 201832,
          "end_ms": 202416,
          "duration_ms": 584
        },
        {
          "index": 1,
          "text": "いません。",
          "start_ms": 202666,
          "end_ms": 204318,
          "duration_ms": 1652
        }
      ]
    },
    {
      "index": 43,
      "text": "まだ亡くなった妻が残していった、少し風変わりな台所女中はいますが、はなよめとはとんでもございません。」",
      "start_ms": 204818,
      "end_ms": 215231,
      "duration_ms": 10413,
      "clauses": [
        {
          "index": 0,
          "text": "まだ亡くなった妻が残していった、",
          "start_ms": 204818,
          "end_ms": 207816,
          "duration_ms": 2998
        },
        {
          "index": 1,
          "text": "少し風変わりな台所女中はいますが、",
          "start_ms": 208066,
          "end_ms": 211866,
          "duration_ms": 3800
        },
        {
          "index": 2,
          "text": "はなよめとはとんでもございません。」",
          "start_ms": 212116,
          "end_ms": 215231,
          "duration_ms": 3115
        }
      ]
    },
    {
      "index": 44,
      "text": "父親はそう言いました。",
      "start_ms": 215731,
      "end_ms": 218300,
      "duration_ms": 2569,
      "clauses": [
        {
          "index": 0,
          "text": "父親はそう言いました。",
          "start_ms": 215731,
          "end_ms": 218300,
          "duration_ms": 2569
        }
      ]
    },
    {
      "index": 45,
      "text": "おうじは、その娘を連れてくるように言いました。",
      "start_ms": 218800,
      "end_ms": 223421,
      "duration_ms": 4621,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは、",
          "start_ms": 218800,
          "end_ms": 219964,
          "duration_ms": 1164
        },
        {
          "index": 1,
          "text": "その娘を連れてくるように言いました。",
          "start_ms": 220214,
          "end_ms": 223421,
          "duration_ms": 3207
        }
      ]
    },
    {
      "index": 46,
      "text": "母親は「とんでもございません。",
      "start_ms": 223921,
      "end_ms": 226722,
      "duration_ms": 2801,
      "clauses": [
        {
          "index": 0,
          "text": "母親は「とんでもございません。",
          "start_ms": 223921,
          "end_ms": 226722,
          "duration_ms": 2801
        }
      ]
    },
    {
      "index": 47,
      "text": "あまりにも汚くて、お目にかかりませんよ。」",
      "start_ms": 227222,
      "end_ms": 231704,
      "duration_ms": 4482,
      "clauses": [
        {
          "index": 0,
          "text": "あまりにも汚くて、",
          "start_ms": 227222,
          "end_ms": 229326,
          "duration_ms": 2104
        },
        {
          "index": 1,
          "text": "お目にかかりませんよ。」",
          "start_ms": 229576,
          "end_ms": 231704,
          "duration_ms": 2128
        }
      ]
    },
    {
      "index": 48,
      "text": "と答えました。",
      "start_ms": 232204,
      "end_ms": 233914,
      "duration_ms": 1710,
      "clauses": [
        {
          "index": 0,
          "text": "と答えました。",
          "start_ms": 232204,
          "end_ms": 233914,
          "duration_ms": 1710
        }
      ]
    },
    {
      "index": 49,
      "text": "でも、おうじあくまで言い張ったので、シンデレラを呼ばなければなりませんでした。",
      "start_ms": 234414,
      "end_ms": 241692,
      "duration_ms": 7278,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 234414,
          "end_ms": 235299,
          "duration_ms": 885
        },
        {
          "index": 1,
          "text": "おうじあくまで言い張ったので、",
          "start_ms": 235549,
          "end_ms": 238037,
          "duration_ms": 2488
        },
        {
          "index": 2,
          "text": "シンデレラを呼ばなければなりませんでした。",
          "start_ms": 238287,
          "end_ms": 241692,
          "duration_ms": 3405
        }
      ]
    },
    {
      "index": 50,
      "text": "娘はまず両手と顔を洗ってきれいにし、おうじの前に行ってお辞儀をしました。",
      "start_ms": 242192,
      "end_ms": 249460,
      "duration_ms": 7268,
      "clauses": [
        {
          "index": 0,
          "text": "娘はまず両手と顔を洗ってきれいにし、",
          "start_ms": 242192,
          "end_ms": 246177,
          "duration_ms": 3985
        },
        {
          "index": 1,
          "text": "おうじの前に行ってお辞儀をしました。",
          "start_ms": 246427,
          "end_ms": 249460,
          "duration_ms": 3033
        }
      ]
    },
    {
      "index": 51,
      "text": "おうじは娘に金の靴を渡しました。",
      "start_ms": 249960,
      "end_ms": 253504,
      "duration_ms": 3544,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘に金の靴を渡しました。",
          "start_ms": 249960,
          "end_ms": 253504,
          "duration_ms": 3544
        }
      ]
    },
    {
      "index": 52,
      "text": "娘は足載せ台に座って、重い木の靴から足を出して、うわぐつを履きました。",
      "start_ms": 254004,
      "end_ms": 262605,
      "duration_ms": 8601,
      "clauses": [
        {
          "index": 0,
          "text": "娘は足載せ台に座って、",
          "start_ms": 254004,
          "end_ms": 257060,
          "duration_ms": 3056
        },
        {
          "index": 1,
          "text": "重い木の靴から足を出して、",
          "start_ms": 257310,
          "end_ms": 260216,
          "duration_ms": 2906
        },
        {
          "index": 2,
          "text": "うわぐつを履きました。",
          "start_ms": 260466,
          "end_ms": 262605,
          "duration_ms": 2139
        }
      ]
    },
    {
      "index": 53,
      "text": "ぴったり合いました。",
      "start_ms": 263105,
      "end_ms": 265035,
      "duration_ms": 1930,
      "clauses": [
        {
          "index": 0,
          "text": "ぴったり合いました。",
          "start_ms": 263105,
          "end_ms": 265035,
          "duration_ms": 1930
        }
      ]
    },
    {
      "index": 54,
      "text": "娘が立ち上がると、おうじはその顔を見て、自分が踊ったうつくしい娘だと分かりました。",
      "start_ms": 265535,
      "end_ms": 274520,
      "duration_ms": 8985,
      "clauses": [
        {
          "index": 0,
          "text": "娘が立ち上がると、",
          "start_ms": 265535,
          "end_ms": 267686,
          "duration_ms": 2151
        },
        {
          "index": 1,
          "text": "おうじはその顔を見て、",
          "start_ms": 267936,
          "end_ms": 270296,
          "duration_ms": 2360
        },
        {
          "index": 2,
          "text": "自分が踊ったうつくしい娘だと分かりました。",
          "start_ms": 270546,
          "end_ms": 274520,
          "duration_ms": 3974
        }
      ]
    },
    {
      "index": 55,
      "text": "「この人が本当のはなよめだ！」",
      "start_ms": 275020,
      "end_ms": 277751,
      "duration_ms": 2731,
      "clauses": [
        {
          "index": 0,
          "text": "「この人が本当のはなよめだ！」",
          "start_ms": 275020,
          "end_ms": 277751,
          "duration_ms": 2731
        }
      ]
    },
    {
      "index": 56,
      "text": "と叫びました。",
      "start_ms": 278251,
      "end_ms": 280065,
      "duration_ms": 1814,
      "clauses": [
        {
          "index": 0,
          "text": "と叫びました。",
          "start_ms": 278251,
          "end_ms": 280065,
          "duration_ms": 1814
        }
      ]
    },
    {
      "index": 57,
      "text": "ままははと二人の姉たちは恐ろしくなって、怒りで青ざめました。",
      "start_ms": 280565,
      "end_ms": 286893,
      "duration_ms": 6328,
      "clauses": [
        {
          "index": 0,
          "text": "ままははと二人の姉たちは恐ろしくなって、",
          "start_ms": 280565,
          "end_ms": 284457,
          "duration_ms": 3892
        },
        {
          "index": 1,
          "text": "怒りで青ざめました。",
          "start_ms": 284707,
          "end_ms": 286893,
          "duration_ms": 2186
        }
      ]
    },
    {
      "index": 58,
      "text": "おうじはシンデレラを馬に乗せて、一緒に去りました。",
      "start_ms": 287393,
      "end_ms": 292607,
      "duration_ms": 5214,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはシンデレラを馬に乗せて、",
          "start_ms": 287393,
          "end_ms": 290357,
          "duration_ms": 2964
        },
        {
          "index": 1,
          "text": "一緒に去りました。",
          "start_ms": 290607,
          "end_ms": 292607,
          "duration_ms": 2000
        }
      ]
    },
    {
      "index": 59,
      "text": "はしばみの木のそばを通ると、二羽の白いはとが叫びました。",
      "start_ms": 293107,
      "end_ms": 299040,
      "duration_ms": 5933,
      "clauses": [
        {
          "index": 0,
          "text": "はしばみの木のそばを通ると、",
          "start_ms": 293107,
          "end_ms": 295896,
          "duration_ms": 2789
        },
        {
          "index": 1,
          "text": "二羽の白いはとが叫びました。",
          "start_ms": 296146,
          "end_ms": 299040,
          "duration_ms": 2894
        }
      ]
    },
    {
      "index": 60,
      "text": "「振り向いて覗いてごらん。",
      "start_ms": 299540,
      "end_ms": 301830,
      "duration_ms": 2290,
      "clauses": [
        {
          "index": 0,
          "text": "「振り向いて覗いてごらん。",
          "start_ms": 299540,
          "end_ms": 301830,
          "duration_ms": 2290
        }
      ]
    },
    {
      "index": 61,
      "text": "振り向いて覗いてごらん。",
      "start_ms": 302330,
      "end_ms": 304609,
      "duration_ms": 2279,
      "clauses": [
        {
          "index": 0,
          "text": "振り向いて覗いてごらん。",
          "start_ms": 302330,
          "end_ms": 304609,
          "duration_ms": 2279
        }
      ]
    },
    {
      "index": 62,
      "text": "靴に血がついていないよ。",
      "start_ms": 305109,
      "end_ms": 307457,
      "duration_ms": 2348,
      "clauses": [
        {
          "index": 0,
          "text": "靴に血がついていないよ。",
          "start_ms": 305109,
          "end_ms": 307457,
          "duration_ms": 2348
        }
      ]
    },
    {
      "index": 63,
      "text": "靴は小さすぎない。",
      "start_ms": 307957,
      "end_ms": 310061,
      "duration_ms": 2104,
      "clauses": [
        {
          "index": 0,
          "text": "靴は小さすぎない。",
          "start_ms": 307957,
          "end_ms": 310061,
          "duration_ms": 2104
        }
      ]
    },
    {
      "index": 64,
      "text": "本当のはなよめがあなたと一緒だよ。」",
      "start_ms": 310561,
      "end_ms": 314024,
      "duration_ms": 3463,
      "clauses": [
        {
          "index": 0,
          "text": "本当のはなよめがあなたと一緒だよ。」",
          "start_ms": 310561,
          "end_ms": 314024,
          "duration_ms": 3463
        }
      ]
    },
    {
      "index": 65,
      "text": "二羽は降りってきて、シンデレラの肩に止まりました。",
      "start_ms": 314524,
      "end_ms": 319667,
      "duration_ms": 5143,
      "clauses": [
        {
          "index": 0,
          "text": "二羽は降りってきて、",
          "start_ms": 314524,
          "end_ms": 316628,
          "duration_ms": 2104
        },
        {
          "index": 1,
          "text": "シンデレラの肩に止まりました。",
          "start_ms": 316878,
          "end_ms": 319667,
          "duration_ms": 2789
        }
      ]
    },
    {
      "index": 66,
      "text": "一羽が右に、もう一羽が左に、そのまま座ったままになりました。",
      "start_ms": 320167,
      "end_ms": 327213,
      "duration_ms": 7046,
      "clauses": [
        {
          "index": 0,
          "text": "一羽が右に、",
          "start_ms": 320167,
          "end_ms": 321749,
          "duration_ms": 1582
        },
        {
          "index": 1,
          "text": "もう一羽が左に、",
          "start_ms": 321999,
          "end_ms": 323999,
          "duration_ms": 2000
        },
        {
          "index": 2,
          "text": "そのまま座ったままになりました。",
          "start_ms": 324249,
          "end_ms": 327213,
          "duration_ms": 2964
        }
      ]
    },
    {
      "index": 67,
      "text": "おうじのけっこんしきが行われることになりました。",
      "start_ms": 327713,
      "end_ms": 331571,
      "duration_ms": 3858,
      "clauses": [
        {
          "index": 0,
          "text": "おうじのけっこんしきが行われることになりました。",
          "start_ms": 327713,
          "end_ms": 331571,
          "duration_ms": 3858
        }
      ]
    },
    {
      "index": 68,
      "text": "二人の不実な姉たちがやってきて、シンデレラの機嫌をとり、幸せを分けてもらおうとしました。",
      "start_ms": 332071,
      "end_ms": 340962,
      "duration_ms": 8891,
      "clauses": [
        {
          "index": 0,
          "text": "二人の不実な姉たちがやってきて、",
          "start_ms": 332071,
          "end_ms": 335069,
          "duration_ms": 2998
        },
        {
          "index": 1,
          "text": "シンデレラの機嫌をとり、",
          "start_ms": 335319,
          "end_ms": 337690,
          "duration_ms": 2371
        },
        {
          "index": 2,
          "text": "幸せを分けてもらおうとしました。",
          "start_ms": 337940,
          "end_ms": 340962,
          "duration_ms": 3022
        }
      ]
    },
    {
      "index": 69,
      "text": "きょうかいに行ったとき、姉は右側に、妹は左側にいました。",
      "start_ms": 341462,
      "end_ms": 348531,
      "duration_ms": 7069,
      "clauses": [
        {
          "index": 0,
          "text": "きょうかいに行ったとき、",
          "start_ms": 341462,
          "end_ms": 343474,
          "duration_ms": 2012
        },
        {
          "index": 1,
          "text": "姉は右側に、",
          "start_ms": 343724,
          "end_ms": 345631,
          "duration_ms": 1907
        },
        {
          "index": 2,
          "text": "妹は左側にいました。",
          "start_ms": 345881,
          "end_ms": 348531,
          "duration_ms": 2650
        }
      ]
    },
    {
      "index": 70,
      "text": "はとたちがそれぞれから片目をつついて取り出しました。",
      "start_ms": 349031,
      "end_ms": 353423,
      "duration_ms": 4392,
      "clauses": [
        {
          "index": 0,
          "text": "はとたちがそれぞれから片目をつついて取り出しました。",
          "start_ms": 349031,
          "end_ms": 353423,
          "duration_ms": 4392
        }
      ]
    },
    {
      "index": 71,
      "text": "帰りには姉が左、妹が右になったので、はとたちはそれぞれからもう一つの目をつついて取り出しました。",
      "start_ms": 353923,
      "end_ms": 364498,
      "duration_ms": 10575,
      "clauses": [
        {
          "index": 0,
          "text": "帰りには姉が左、",
          "start_ms": 353923,
          "end_ms": 356434,
          "duration_ms": 2511
        },
        {
          "index": 1,
          "text": "妹が右になったので、",
          "start_ms": 356684,
          "end_ms": 359137,
          "duration_ms": 2453
        },
        {
          "index": 2,
          "text": "はとたちはそれぞれからもう一つの目をつついて取り出しました。",
          "start_ms": 359387,
          "end_ms": 364498,
          "duration_ms": 5111
        }
      ]
    },
    {
      "index": 72,
      "text": "こうして、いじわるとふせいじつな二人は、ばつを受けて、しょうがい目が見えないままでした。",
      "start_ms": 364998,
      "end_ms": 374225,
      "duration_ms": 9227,
      "clauses": [
        {
          "index": 0,
          "text": "こうして、",
          "start_ms": 364998,
          "end_ms": 366290,
          "duration_ms": 1292
        },
        {
          "index": 1,
          "text": "いじわるとふせいじつな二人は、",
          "start_ms": 366540,
          "end_ms": 369260,
          "duration_ms": 2720
        },
        {
          "index": 2,
          "text": "ばつを受けて、",
          "start_ms": 369510,
          "end_ms": 371162,
          "duration_ms": 1652
        },
        {
          "index": 3,
          "text": "しょうがい目が見えないままでした。",
          "start_ms": 371412,
          "end_ms": 374225,
          "duration_ms": 2813
        }
      ]
    }
  ]
}