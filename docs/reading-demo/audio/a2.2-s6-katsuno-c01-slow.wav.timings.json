      "end_ms": 207683,
      "duration_ms": 2670,
      "clauses": [
        {
          "index": 0,
          "text": "なまえはオートラです。",
          "start_ms": 205013,
          "end_ms": 207683,
          "duration_ms": 2670
        }
      ]
    },
    {
      "index": 44,
      "text": "オートラもしろではたらいていました。",
      "start_ms": 208183,
      "end_ms": 211549,
      "duration_ms": 3366,
      "clauses": [
        {
          "index": 0,
          "text": "オートラもしろではたらいていました。",
          "start_ms": 208183,
          "end_ms": 211549,
          "duration_ms": 3366
        }
      ]
    },
    {
      "index": 45,
      "text": "としをとっていました。",
      "start_ms": 212049,
      "end_ms": 214487,
      "duration_ms": 2438,
      "clauses": [
        {
          "index": 0,
          "text": "としをとっていました。",
          "start_ms": 212049,
          "end_ms": 214487,
          "duration_ms": 2438
        }
      ]
    },
    {
      "index": 46,
      "text": "おかねがすきでした。",
      "start_ms": 214987,
      "end_ms": 217367,
      "duration_ms": 2380,
      "clauses": [
        {
          "index": 0,
          "text": "おかねがすきでした。",
          "start_ms": 214987,
          "end_ms": 217367,
          "duration_ms": 2380
        }
      ]
    },
    {
      "index": 47,
      "text": "わるいこともするひとでした。",
      "start_ms": 217867,
      "end_ms": 220792,
      "duration_ms": 2925,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこともするひとでした。",
          "start_ms": 217867,
          "end_ms": 220792,
          "duration_ms": 2925
        }
      ]
    },
    {
      "index": 48,
      "text": "とのさまのこともおんなのひとたちのこともよく、しっていました。",
      "start_ms": 221292,
      "end_ms": 228054,
      "duration_ms": 6762,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまのこともおんなのひとたちのこともよく、",
          "start_ms": 221292,
          "end_ms": 225819,
          "duration_ms": 4527
        },
        {
          "index": 1,
          "text": "しっていました。",
          "start_ms": 226069,
          "end_ms": 228054,
          "duration_ms": 1985
        }
      ]
    },
    {
      "index": 49,
      "text": "だからシチロウエモンはオートラにあいました。",
      "start_ms": 228554,
      "end_ms": 233099,
      "duration_ms": 4545,
      "clauses": [
        {
          "index": 0,
          "text": "だからシチロウエモンはオートラにあいました。",
          "start_ms": 228554,
          "end_ms": 233099,
          "duration_ms": 4545
        }
      ]
    },
    {
      "index": 50,
      "text": "「シチロウエモンさん。",
      "start_ms": 233599,
      "end_ms": 235892,
      "duration_ms": 2293,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモンさん。",
          "start_ms": 233599,
          "end_ms": 235892,
          "duration_ms": 2293
        }
      ]
    },
    {
      "index": 51,
      "text": "かおがあかいですね。",
      "start_ms": 236392,
      "end_ms": 238667,
      "duration_ms": 2275,
      "clauses": [
        {
          "index": 0,
          "text": "かおがあかいですね。",
          "start_ms": 236392,
          "end_ms": 238667,
          "duration_ms": 2275
        }
      ]
    },
    {
      "index": 52,
      "text": "どうしましたか」。",
      "start_ms": 239167,
      "end_ms": 241210,
      "duration_ms": 2043,
      "clauses": [
        {
          "index": 0,
          "text": "どうしましたか」。",
          "start_ms": 239167,
          "end_ms": 241210,
          "duration_ms": 2043
        }
      ]
    },
    {
      "index": 53,
      "text": "「ハチヤのことをきいていますか。",
      "start_ms": 241710,
      "end_ms": 244751,
      "duration_ms": 3041,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤのことをきいていますか。",
          "start_ms": 241710,
          "end_ms": 244751,
          "duration_ms": 3041
        }
      ]
    },
    {
      "index": 54,
      "text": "とてもおこりました」。",
      "start_ms": 245251,
      "end_ms": 247538,
      "duration_ms": 2287,
      "clauses": [
        {
          "index": 0,
          "text": "とてもおこりました」。",
          "start_ms": 245251,
          "end_ms": 247538,
          "duration_ms": 2287
        }
      ]
    },
    {
      "index": 55,
      "text": "オートラはわらいました。",
      "start_ms": 248038,
      "end_ms": 250487,
      "duration_ms": 2449,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはわらいました。",
          "start_ms": 248038,
          "end_ms": 250487,
          "duration_ms": 2449
        }
      ]
    },
    {
      "index": 56,
      "text": "「よく、しっています。",
      "start_ms": 250987,
      "end_ms": 254069,
      "duration_ms": 3082,
      "clauses": [
        {
          "index": 0,
          "text": "「よく、",
          "start_ms": 250987,
          "end_ms": 252043,
          "duration_ms": 1056
        },
        {
          "index": 1,
          "text": "しっています。",
          "start_ms": 252293,
          "end_ms": 254069,
          "duration_ms": 1776
        }
      ]
    },
    {
      "index": 57,
      "text": "でははなします。",
      "start_ms": 254569,
      "end_ms": 256705,
      "duration_ms": 2136,
      "clauses": [
        {
          "index": 0,
          "text": "でははなします。",
          "start_ms": 254569,
          "end_ms": 256705,
          "duration_ms": 2136
        }
      ]
    },
    {
      "index": 58,
      "text": "でもおかねがいります」。",
      "start_ms": 257205,
      "end_ms": 259689,
      "duration_ms": 2484,
      "clauses": [
        {
          "index": 0,
          "text": "でもおかねがいります」。",
          "start_ms": 257205,
          "end_ms": 259689,
          "duration_ms": 2484
        }
      ]
    },
    {
      "index": 59,
      "text": "「ではおかねはあげます」。",
      "start_ms": 260189,
      "end_ms": 262801,
      "duration_ms": 2612,
      "clauses": [
        {
          "index": 0,
          "text": "「ではおかねはあげます」。",
          "start_ms": 260189,
          "end_ms": 262801,
          "duration_ms": 2612
        }
      ]
    },
    {
      "index": 60,
      "text": "シチロウエモンはおかねをだしました。",
      "start_ms": 263301,
      "end_ms": 267115,
      "duration_ms": 3814,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはおかねをだしました。",
          "start_ms": 263301,
          "end_ms": 267115,
          "duration_ms": 3814
        }
      ]
    },
    {
      "index": 61,
      "text": "オートラはいいました。",
      "start_ms": 267615,
      "end_ms": 269902,
      "duration_ms": 2287,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 267615,
          "end_ms": 269902,
          "duration_ms": 2287
        }
      ]
    },
    {
      "index": 62,
      "text": "「とのさまはハチヤをみぎのものにします。",
      "start_ms": 270402,
      "end_ms": 274686,
      "duration_ms": 4284,
      "clauses": [
        {
          "index": 0,
          "text": "「とのさまはハチヤをみぎのものにします。",
          "start_ms": 270402,
          "end_ms": 274686,
          "duration_ms": 4284
        }
      ]
    },
    {
      "index": 63,
      "text": "それからカツノをハチヤにあげるそうです」。",
      "start_ms": 275186,
      "end_ms": 279028,
      "duration_ms": 3842,
      "clauses": [
        {
          "index": 0,
          "text": "それからカツノをハチヤにあげるそうです」。",
          "start_ms": 275186,
          "end_ms": 279028,
          "duration_ms": 3842
        }
      ]
    },
    {
      "index": 64,
      "text": "「そうですか。",
      "start_ms": 279528,
      "end_ms": 281373,
      "duration_ms": 1845,
      "clauses": [
        {
          "index": 0,
          "text": "「そうですか。",
          "start_ms": 279528,
          "end_ms": 281373,
          "duration_ms": 1845
        }
      ]
    },
    {
      "index": 65,
      "text": "そうなんですか」。",
      "start_ms": 281873,
      "end_ms": 283951,
      "duration_ms": 2078,
      "clauses": [
        {
          "index": 0,
          "text": "そうなんですか」。",
          "start_ms": 281873,
          "end_ms": 283951,
          "duration_ms": 2078
        }
      ]
    },
    {
      "index": 66,
      "text": "「そうです。",
      "start_ms": 284451,
      "end_ms": 286076,
      "duration_ms": 1625,
      "clauses": [
        {
          "index": 0,
          "text": "「そうです。",
          "start_ms": 284451,
          "end_ms": 286076,
          "duration_ms": 1625
        }
      ]
    },
    {
      "index": 67,
      "text": "おんなのひとたちがみな、そういいます」。",
      "start_ms": 286576,
      "end_ms": 290958,
      "duration_ms": 4382,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのひとたちがみな、",
          "start_ms": 286576,
          "end_ms": 289037,
          "duration_ms": 2461
        },
        {
          "index": 1,
          "text": "そういいます」。",
          "start_ms": 289287,
          "end_ms": 290958,
          "duration_ms": 1671
        }
      ]
    },
    {
      "index": 68,
      "text": "シチロウエモンはたちました。",
      "start_ms": 291458,
      "end_ms": 294494,
      "duration_ms": 3036,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはたちました。",
          "start_ms": 291458,
          "end_ms": 294494,
          "duration_ms": 3036
        }
      ]
    },
    {
      "index": 69,
      "text": "「ハチヤはころさなければ、なりません。",
      "start_ms": 294994,
      "end_ms": 299655,
      "duration_ms": 4661,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤはころさなければ、",
          "start_ms": 294994,
          "end_ms": 297745,
          "duration_ms": 2751
        },
        {
          "index": 1,
          "text": "なりません。",
          "start_ms": 297995,
          "end_ms": 299655,
          "duration_ms": 1660
        }
      ]
    },
    {
      "index": 70,
      "text": "そうして、はじめて、いいゆめをみます」。",
      "start_ms": 300155,
      "end_ms": 305971,
      "duration_ms": 5816,
      "clauses": [
        {
          "index": 0,
          "text": "そうして、",
          "start_ms": 300155,
          "end_ms": 301722,
          "duration_ms": 1567
        },
        {
          "index": 1,
          "text": "はじめて、",
          "start_ms": 301972,
          "end_ms": 303620,
          "duration_ms": 1648
        },
        {
          "index": 2,
          "text": "いいゆめをみます」。",
          "start_ms": 303870,
          "end_ms": 305971,
          "duration_ms": 2101
        }
      ]
    },
    {
      "index": 71,
      "text": "オートラはいいました。",
      "start_ms": 306471,
      "end_ms": 308758,
      "duration_ms": 2287,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 306471,
          "end_ms": 308758,
          "duration_ms": 2287
        }
      ]
    },
    {
      "index": 72,
      "text": "「わたしがじょうずにします。",
      "start_ms": 309258,
      "end_ms": 311963,
      "duration_ms": 2705,
      "clauses": [
        {
          "index": 0,
          "text": "「わたしがじょうずにします。",
          "start_ms": 309258,
          "end_ms": 311963,
          "duration_ms": 2705
        }
      ]
    },
    {
      "index": 73,
      "text": "しんぱいしないでください」。",
      "start_ms": 312463,
      "end_ms": 315144,
      "duration_ms": 2681,
      "clauses": [
        {
          "index": 0,
          "text": "しんぱいしないでください」。",
          "start_ms": 312463,
          "end_ms": 315144,
          "duration_ms": 2681
        }
      ]
    },
    {
      "index": 74,
      "text": "「ではそうします。",
      "start_ms": 315644,
      "end_ms": 317698,
      "duration_ms": 2054,
      "clauses": [
        {
          "index": 0,
          "text": "「ではそうします。",
          "start_ms": 315644,
          "end_ms": 317698,
          "duration_ms": 2054
        }
      ]
    },
    {
      "index": 75,
      "text": "じょうずにしてください」。",
      "start_ms": 318198,
      "end_ms": 320647,
      "duration_ms": 2449,
      "clauses": [
        {
          "index": 0,
          "text": "じょうずにしてください」。",
          "start_ms": 318198,
          "end_ms": 320647,
          "duration_ms": 2449
        }
      ]
    },
    {
      "index": 76,
      "text": "へやはもう、なにもありませんでした。",
      "start_ms": 321147,
      "end_ms": 325843,
      "duration_ms": 4696,
      "clauses": [
        {
          "index": 0,
          "text": "へやはもう、",
          "start_ms": 321147,
          "end_ms": 322888,
          "duration_ms": 1741
        },
        {
          "index": 1,
          "text": "なにもありませんでした。",
          "start_ms": 323138,
          "end_ms": 325843,
          "duration_ms": 2705
        }
      ]
    },
    {
      "index": 77,
      "text": "ふたりはなにもいいませんでした。",
      "start_ms": 326343,
      "end_ms": 329698,
      "duration_ms": 3355,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなにもいいませんでした。",
          "start_ms": 326343,
          "end_ms": 329698,
          "duration_ms": 3355
        }
      ]
    }
  ]
}