      "end_ms": 210616,
      "duration_ms": 2592,
      "clauses": [
        {
          "index": 0,
          "text": "なまえはオートラです。",
          "start_ms": 208024,
          "end_ms": 210616,
          "duration_ms": 2592
        }
      ]
    },
    {
      "index": 44,
      "text": "オートラもしろではたらいていました。",
      "start_ms": 211116,
      "end_ms": 214474,
      "duration_ms": 3358,
      "clauses": [
        {
          "index": 0,
          "text": "オートラもしろではたらいていました。",
          "start_ms": 211116,
          "end_ms": 214474,
          "duration_ms": 3358
        }
      ]
    },
    {
      "index": 45,
      "text": "としをとっていました。",
      "start_ms": 214974,
      "end_ms": 217497,
      "duration_ms": 2523,
      "clauses": [
        {
          "index": 0,
          "text": "としをとっていました。",
          "start_ms": 214974,
          "end_ms": 217497,
          "duration_ms": 2523
        }
      ]
    },
    {
      "index": 46,
      "text": "おかねがすきでした。",
      "start_ms": 217997,
      "end_ms": 220415,
      "duration_ms": 2418,
      "clauses": [
        {
          "index": 0,
          "text": "おかねがすきでした。",
          "start_ms": 217997,
          "end_ms": 220415,
          "duration_ms": 2418
        }
      ]
    },
    {
      "index": 47,
      "text": "わるいこともするひとでした。",
      "start_ms": 220915,
      "end_ms": 223879,
      "duration_ms": 2964,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこともするひとでした。",
          "start_ms": 220915,
          "end_ms": 223879,
          "duration_ms": 2964
        }
      ]
    },
    {
      "index": 48,
      "text": "とのさまのこともおんなのひとたちのこともよく、しっていました。",
      "start_ms": 224379,
      "end_ms": 231323,
      "duration_ms": 6944,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまのこともおんなのひとたちのこともよく、",
          "start_ms": 224379,
          "end_ms": 229015,
          "duration_ms": 4636
        },
        {
          "index": 1,
          "text": "しっていました。",
          "start_ms": 229265,
          "end_ms": 231323,
          "duration_ms": 2058
        }
      ]
    },
    {
      "index": 49,
      "text": "だからシチロウエモンはオートラにあいました。",
      "start_ms": 231823,
      "end_ms": 236354,
      "duration_ms": 4531,
      "clauses": [
        {
          "index": 0,
          "text": "だからシチロウエモンはオートラにあいました。",
          "start_ms": 231823,
          "end_ms": 236354,
          "duration_ms": 4531
        }
      ]
    },
    {
      "index": 50,
      "text": "「シチロウエモンさん。",
      "start_ms": 236854,
      "end_ms": 239028,
      "duration_ms": 2174,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモンさん。",
          "start_ms": 236854,
          "end_ms": 239028,
          "duration_ms": 2174
        }
      ]
    },
    {
      "index": 51,
      "text": "かおがあかいですね。",
      "start_ms": 239528,
      "end_ms": 241900,
      "duration_ms": 2372,
      "clauses": [
        {
          "index": 0,
          "text": "かおがあかいですね。",
          "start_ms": 239528,
          "end_ms": 241900,
          "duration_ms": 2372
        }
      ]
    },
    {
      "index": 52,
      "text": "どうしましたか」。",
      "start_ms": 242400,
      "end_ms": 244470,
      "duration_ms": 2070,
      "clauses": [
        {
          "index": 0,
          "text": "どうしましたか」。",
          "start_ms": 242400,
          "end_ms": 244470,
          "duration_ms": 2070
        }
      ]
    },
    {
      "index": 53,
      "text": "「ハチヤのことをきいていますか。",
      "start_ms": 244970,
      "end_ms": 248189,
      "duration_ms": 3219,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤのことをきいていますか。",
          "start_ms": 244970,
          "end_ms": 248189,
          "duration_ms": 3219
        }
      ]
    },
    {
      "index": 54,
      "text": "とてもおこりました」。",
      "start_ms": 248689,
      "end_ms": 251072,
      "duration_ms": 2383,
      "clauses": [
        {
          "index": 0,
          "text": "とてもおこりました」。",
          "start_ms": 248689,
          "end_ms": 251072,
          "duration_ms": 2383
        }
      ]
    },
    {
      "index": 55,
      "text": "オートラはわらいました。",
      "start_ms": 251572,
      "end_ms": 254060,
      "duration_ms": 2488,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはわらいました。",
          "start_ms": 251572,
          "end_ms": 254060,
          "duration_ms": 2488
        }
      ]
    },
    {
      "index": 56,
      "text": "「よく、しっています。",
      "start_ms": 254560,
      "end_ms": 257823,
      "duration_ms": 3263,
      "clauses": [
        {
          "index": 0,
          "text": "「よく、",
          "start_ms": 254560,
          "end_ms": 255666,
          "duration_ms": 1106
        },
        {
          "index": 1,
          "text": "しっています。",
          "start_ms": 255916,
          "end_ms": 257823,
          "duration_ms": 1907
        }
      ]
    },
    {
      "index": 57,
      "text": "でははなします。",
      "start_ms": 258323,
      "end_ms": 260509,
      "duration_ms": 2186,
      "clauses": [
        {
          "index": 0,
          "text": "でははなします。",
          "start_ms": 258323,
          "end_ms": 260509,
          "duration_ms": 2186
        }
      ]
    },
    {
      "index": 58,
      "text": "でもおかねがいります」。",
      "start_ms": 261009,
      "end_ms": 263590,
      "duration_ms": 2581,
      "clauses": [
        {
          "index": 0,
          "text": "でもおかねがいります」。",
          "start_ms": 261009,
          "end_ms": 263590,
          "duration_ms": 2581
        }
      ]
    },
    {
      "index": 59,
      "text": "「ではおかねはあげます」。",
      "start_ms": 264090,
      "end_ms": 266717,
      "duration_ms": 2627,
      "clauses": [
        {
          "index": 0,
          "text": "「ではおかねはあげます」。",
          "start_ms": 264090,
          "end_ms": 266717,
          "duration_ms": 2627
        }
      ]
    },
    {
      "index": 60,
      "text": "シチロウエモンはおかねをだしました。",
      "start_ms": 267217,
      "end_ms": 270970,
      "duration_ms": 3753,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはおかねをだしました。",
          "start_ms": 267217,
          "end_ms": 270970,
          "duration_ms": 3753
        }
      ]
    },
    {
      "index": 61,
      "text": "オートラはいいました。",
      "start_ms": 271470,
      "end_ms": 273795,
      "duration_ms": 2325,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 271470,
          "end_ms": 273795,
          "duration_ms": 2325
        }
      ]
    },
    {
      "index": 62,
      "text": "「とのさまはハチヤをみぎのものにします。",
      "start_ms": 274295,
      "end_ms": 278605,
      "duration_ms": 4310,
      "clauses": [
        {
          "index": 0,
          "text": "「とのさまはハチヤをみぎのものにします。",
          "start_ms": 274295,
          "end_ms": 278605,
          "duration_ms": 4310
        }
      ]
    },
    {
      "index": 63,
      "text": "それからカツノをハチヤにあげるそうです」。",
      "start_ms": 279105,
      "end_ms": 283067,
      "duration_ms": 3962,
      "clauses": [
        {
          "index": 0,
          "text": "それからカツノをハチヤにあげるそうです」。",
          "start_ms": 279105,
          "end_ms": 283067,
          "duration_ms": 3962
        }
      ]
    },
    {
      "index": 64,
      "text": "「そうですか。",
      "start_ms": 283567,
      "end_ms": 285439,
      "duration_ms": 1872,
      "clauses": [
        {
          "index": 0,
          "text": "「そうですか。",
          "start_ms": 283567,
          "end_ms": 285439,
          "duration_ms": 1872
        }
      ]
    },
    {
      "index": 65,
      "text": "そうなんですか」。",
      "start_ms": 285939,
      "end_ms": 288090,
      "duration_ms": 2151,
      "clauses": [
        {
          "index": 0,
          "text": "そうなんですか」。",
          "start_ms": 285939,
          "end_ms": 288090,
          "duration_ms": 2151
        }
      ]
    },
    {
      "index": 66,
      "text": "「そうです。",
      "start_ms": 288590,
      "end_ms": 290311,
      "duration_ms": 1721,
      "clauses": [
        {
          "index": 0,
          "text": "「そうです。",
          "start_ms": 288590,
          "end_ms": 290311,
          "duration_ms": 1721
        }
      ]
    },
    {
      "index": 67,
      "text": "おんなのひとたちがみな、そういいます」。",
      "start_ms": 290811,
      "end_ms": 295456,
      "duration_ms": 4645,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのひとたちがみな、",
          "start_ms": 290811,
          "end_ms": 293450,
          "duration_ms": 2639
        },
        {
          "index": 1,
          "text": "そういいます」。",
          "start_ms": 293700,
          "end_ms": 295456,
          "duration_ms": 1756
        }
      ]
    },
    {
      "index": 68,
      "text": "シチロウエモンはたちました。",
      "start_ms": 295956,
      "end_ms": 299024,
      "duration_ms": 3068,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはたちました。",
          "start_ms": 295956,
          "end_ms": 299024,
          "duration_ms": 3068
        }
      ]
    },
    {
      "index": 69,
      "text": "「ハチヤはころさなければ、なりません。",
      "start_ms": 299524,
      "end_ms": 304354,
      "duration_ms": 4830,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤはころさなければ、",
          "start_ms": 299524,
          "end_ms": 302406,
          "duration_ms": 2882
        },
        {
          "index": 1,
          "text": "なりません。",
          "start_ms": 302656,
          "end_ms": 304354,
          "duration_ms": 1698
        }
      ]
    },
    {
      "index": 70,
      "text": "そうして、はじめて、いいゆめをみます」。",
      "start_ms": 304854,
      "end_ms": 310901,
      "duration_ms": 6047,
      "clauses": [
        {
          "index": 0,
          "text": "そうして、",
          "start_ms": 304854,
          "end_ms": 306471,
          "duration_ms": 1617
        },
        {
          "index": 1,
          "text": "はじめて、",
          "start_ms": 306721,
          "end_ms": 308454,
          "duration_ms": 1733
        },
        {
          "index": 2,
          "text": "いいゆめをみます」。",
          "start_ms": 308704,
          "end_ms": 310901,
          "duration_ms": 2197
        }
      ]
    },
    {
      "index": 71,
      "text": "オートラはいいました。",
      "start_ms": 311401,
      "end_ms": 313691,
      "duration_ms": 2290,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 311401,
          "end_ms": 313691,
          "duration_ms": 2290
        }
      ]
    },
    {
      "index": 72,
      "text": "「わたしがじょうずにします。",
      "start_ms": 314191,
      "end_ms": 316992,
      "duration_ms": 2801,
      "clauses": [
        {
          "index": 0,
          "text": "「わたしがじょうずにします。",
          "start_ms": 314191,
          "end_ms": 316992,
          "duration_ms": 2801
        }
      ]
    },
    {
      "index": 73,
      "text": "しんぱいしないでください」。",
      "start_ms": 317492,
      "end_ms": 320258,
      "duration_ms": 2766,
      "clauses": [
        {
          "index": 0,
          "text": "しんぱいしないでください」。",
          "start_ms": 317492,
          "end_ms": 320258,
          "duration_ms": 2766
        }
      ]
    },
    {
      "index": 74,
      "text": "「ではそうします。",
      "start_ms": 320758,
      "end_ms": 322967,
      "duration_ms": 2209,
      "clauses": [
        {
          "index": 0,
          "text": "「ではそうします。",
          "start_ms": 320758,
          "end_ms": 322967,
          "duration_ms": 2209
        }
      ]
    },
    {
      "index": 75,
      "text": "じょうずにしてください」。",
      "start_ms": 323467,
      "end_ms": 325990,
      "duration_ms": 2523,
      "clauses": [
        {
          "index": 0,
          "text": "じょうずにしてください」。",
          "start_ms": 323467,
          "end_ms": 325990,
          "duration_ms": 2523
        }
      ]
    },
    {
      "index": 76,
      "text": "へやはもう、なにもありませんでした。",
      "start_ms": 326490,
      "end_ms": 331275,
      "duration_ms": 4785,
      "clauses": [
        {
          "index": 0,
          "text": "へやはもう、",
          "start_ms": 326490,
          "end_ms": 328293,
          "duration_ms": 1803
        },
        {
          "index": 1,
          "text": "なにもありませんでした。",
          "start_ms": 328543,
          "end_ms": 331275,
          "duration_ms": 2732
        }
      ]
    },
    {
      "index": 77,
      "text": "ふたりはなにもいいませんでした。",
      "start_ms": 331775,
      "end_ms": 335192,
      "duration_ms": 3417,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなにもいいませんでした。",
          "start_ms": 331775,
          "end_ms": 335192,
          "duration_ms": 3417
        }
      ]
    }
  ]
}