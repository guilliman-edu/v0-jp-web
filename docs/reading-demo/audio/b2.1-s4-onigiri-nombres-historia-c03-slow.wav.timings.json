          "start_ms": 0,
          "end_ms": 2911,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 1,
      "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
      "start_ms": 3411,
      "end_ms": 8795,
      "duration_ms": 5384,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
          "start_ms": 3411,
          "end_ms": 8795,
          "duration_ms": 5384
        }
      ]
    },
    {
      "index": 2,
      "text": "にほんではむかし、「にぎりいい」と言っていました。",
      "start_ms": 9295,
      "end_ms": 14160,
      "duration_ms": 4865,
      "clauses": [
        {
          "index": 0,
          "text": "にほんではむかし、",
          "start_ms": 9295,
          "end_ms": 11417,
          "duration_ms": 2122
        },
        {
          "index": 1,
          "text": "「にぎりいい」と言っていました。",
          "start_ms": 11667,
          "end_ms": 14160,
          "duration_ms": 2493
        }
      ]
    },
    {
      "index": 3,
      "text": "「にぎりいい」が使われているうちに、「にぎりめし」というなまえのことばに換えました。",
      "start_ms": 14660,
      "end_ms": 21638,
      "duration_ms": 6978,
      "clauses": [
        {
          "index": 0,
          "text": "「にぎりいい」が使われているうちに、",
          "start_ms": 14660,
          "end_ms": 17629,
          "duration_ms": 2969
        },
        {
          "index": 1,
          "text": "「にぎりめし」というなまえのことばに換えました。",
          "start_ms": 17879,
          "end_ms": 21638,
          "duration_ms": 3759
        }
      ]
    },
    {
      "index": 4,
      "text": "さらに、けいごの「お」を付けたなまえが「おにぎり」です。",
      "start_ms": 22138,
      "end_ms": 27072,
      "duration_ms": 4934,
      "clauses": [
        {
          "index": 0,
          "text": "さらに、",
          "start_ms": 22138,
          "end_ms": 23470,
          "duration_ms": 1332
        },
        {
          "index": 1,
          "text": "けいごの「お」を付けたなまえが「おにぎり」です。",
          "start_ms": 23720,
          "end_ms": 27072,
          "duration_ms": 3352
        }
      ]
    },
    {
      "index": 5,
      "text": "「おにぎり」をせつめいすることばは、「おむすび」もあります。",
      "start_ms": 27572,
      "end_ms": 33029,
      "duration_ms": 5457,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」をせつめいすることばは、",
          "start_ms": 27572,
          "end_ms": 30564,
          "duration_ms": 2992
        },
        {
          "index": 1,
          "text": "「おむすび」もあります。",
          "start_ms": 30814,
          "end_ms": 33029,
          "duration_ms": 2215
        }
      ]
    },
    {
      "index": 6,
      "text": "「むすび」というなまえをみんなが使い始めたのは、えどじだいです。",
      "start_ms": 33529,
      "end_ms": 40043,
      "duration_ms": 6514,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」というなまえをみんなが使い始めたのは、",
          "start_ms": 33529,
          "end_ms": 37857,
          "duration_ms": 4328
        },
        {
          "index": 1,
          "text": "えどじだいです。",
          "start_ms": 38107,
          "end_ms": 40043,
          "duration_ms": 1936
        }
      ]
    },
    {
      "index": 7,
      "text": "そこにもけいごの「お」を付けました。",
      "start_ms": 40543,
      "end_ms": 43524,
      "duration_ms": 2981,
      "clauses": [
        {
          "index": 0,
          "text": "そこにもけいごの「お」を付けました。",
          "start_ms": 40543,
          "end_ms": 43524,
          "duration_ms": 2981
        }
      ]
    },
    {
      "index": 8,
      "text": "むかしの本には、「むすび」を「にぎりいい」の別のなまえと書いて、「もとは女のことばです」とも書かれています。",
      "start_ms": 44024,
      "end_ms": 54186,
      "duration_ms": 10162,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 44024,
          "end_ms": 46064,
          "duration_ms": 2040
        },
        {
          "index": 1,
          "text": "「むすび」を「にぎりいい」の別のなまえと書いて、",
          "start_ms": 46314,
          "end_ms": 49910,
          "duration_ms": 3596
        },
        {
          "index": 2,
          "text": "「もとは女のことばです」とも書かれています。",
          "start_ms": 50160,
          "end_ms": 54186,
          "duration_ms": 4026
        }
      ]
    },
    {
      "index": 9,
      "text": "「むすび」は、なまえのいみをあらわすだけのことばではありません。",
      "start_ms": 54686,
      "end_ms": 60572,
      "duration_ms": 5886,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」は、",
          "start_ms": 54686,
          "end_ms": 56250,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "なまえのいみをあらわすだけのことばではありません。",
          "start_ms": 56500,
          "end_ms": 60572,
          "duration_ms": 4072
        }
      ]
    },
    {
      "index": 10,
      "text": "かみさまのなまえも、むかしの本に出ています。",
      "start_ms": 61072,
      "end_ms": 66122,
      "duration_ms": 5050,
      "clauses": [
        {
          "index": 0,
          "text": "かみさまのなまえも、",
          "start_ms": 61072,
          "end_ms": 63298,
          "duration_ms": 2226
        },
        {
          "index": 1,
          "text": "むかしの本に出ています。",
          "start_ms": 63548,
          "end_ms": 66122,
          "duration_ms": 2574
        }
      ]
    },
    {
      "index": 11,
      "text": "そこに、何かを作るいみとか、人と人がつながるいみとかが加わっているのです。",
      "start_ms": 66622,
      "end_ms": 75205,
      "duration_ms": 8583,
      "clauses": [
        {
          "index": 0,
          "text": "そこに、",
          "start_ms": 66622,
          "end_ms": 67896,
          "duration_ms": 1274
        },
        {
          "index": 1,
          "text": "何かを作るいみとか、",
          "start_ms": 68146,
          "end_ms": 70674,
          "duration_ms": 2528
        },
        {
          "index": 2,
          "text": "人と人がつながるいみとかが加わっているのです。",
          "start_ms": 70924,
          "end_ms": 75205,
          "duration_ms": 4281
        }
      ]
    },
    {
      "index": 12,
      "text": "つまり、「むすび」は、いみがさまざまに加わったことばということです。",
      "start_ms": 75705,
      "end_ms": 83336,
      "duration_ms": 7631,
      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 75705,
          "end_ms": 77049,
          "duration_ms": 1344
        },
        {
          "index": 1,
          "text": "「むすび」は、",
          "start_ms": 77299,
          "end_ms": 78863,
          "duration_ms": 1564
        },
        {
          "index": 2,
          "text": "いみがさまざまに加わったことばということです。",
          "start_ms": 79113,
          "end_ms": 83336,
          "duration_ms": 4223
        }
      ]
    },
    {
      "index": 13,
      "text": "もちろん、「むすび」というなまえがかみさまとつながっているとは言えません。",
      "start_ms": 83836,
      "end_ms": 91034,
      "duration_ms": 7198,
      "clauses": [
        {
          "index": 0,
          "text": "もちろん、",
          "start_ms": 83836,
          "end_ms": 85400,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "「むすび」というなまえがかみさまとつながっているとは言えません。",
          "start_ms": 85650,
          "end_ms": 91034,
          "duration_ms": 5384
        }
      ]
    },
    {
      "index": 14,
      "text": "でも、ことばのいみがさまざまに加わっていることにちゅうもくすると、この毎日のたべものがにほんに住む人にとって、大切ないみを持つのでしょう。",
      "start_ms": 91534,
      "end_ms": 105763,
      "duration_ms": 14229,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 91534,
          "end_ms": 92506,
          "duration_ms": 972
        },
        {
          "index": 1,
          "text": "ことばのいみがさまざまに加わっていることにちゅうもくすると、",
          "start_ms": 92756,
          "end_ms": 97815,
          "duration_ms": 5059
        },
        {
          "index": 2,
          "text": "この毎日のたべものがにほんに住む人にとって、",
          "start_ms": 98065,
          "end_ms": 102532,
          "duration_ms": 4467
        },
        {
          "index": 3,
          "text": "大切ないみを持つのでしょう。",
