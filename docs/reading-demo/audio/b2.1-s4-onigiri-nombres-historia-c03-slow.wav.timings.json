      "clauses": [
        {
          "index": 0,
          "text": "第三章　「おにぎり」の名前",
          "start_ms": 0,
          "end_ms": 2911,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 1,
      "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
      "start_ms": 3411,
      "end_ms": 8830,
      "duration_ms": 5419,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
          "start_ms": 3411,
          "end_ms": 8830,
          "duration_ms": 5419
        }
      ]
    },
    {
      "index": 2,
      "text": "にほんではむかし、「にぎりいい」と言っていました。",
      "start_ms": 9330,
      "end_ms": 14160,
      "duration_ms": 4830,
      "clauses": [
        {
          "index": 0,
          "text": "にほんではむかし、",
          "start_ms": 9330,
          "end_ms": 11417,
          "duration_ms": 2087
        },
        {
          "index": 1,
          "text": "「にぎりいい」と言っていました。",
          "start_ms": 11667,
          "end_ms": 14160,
          "duration_ms": 2493
        }
      ]
    },
    {
      "index": 3,
      "text": "「にぎりいい」が使われているうちに、「にぎりめし」というなまえのことばに換えました。",
      "start_ms": 14660,
      "end_ms": 21580,
      "duration_ms": 6920,
      "clauses": [
        {
          "index": 0,
          "text": "「にぎりいい」が使われているうちに、",
          "start_ms": 14660,
          "end_ms": 17606,
          "duration_ms": 2946
        },
        {
          "index": 1,
          "text": "「にぎりめし」というなまえのことばに換えました。",
          "start_ms": 17856,
          "end_ms": 21580,
          "duration_ms": 3724
        }
      ]
    },
    {
      "index": 4,
      "text": "さらに、けいごの「お」を付けたなまえが「おにぎり」です。",
      "start_ms": 22080,
      "end_ms": 26992,
      "duration_ms": 4912,
      "clauses": [
        {
          "index": 0,
          "text": "さらに、",
          "start_ms": 22080,
          "end_ms": 23366,
          "duration_ms": 1286
        },
        {
          "index": 1,
          "text": "けいごの「お」を付けたなまえが「おにぎり」です。",
          "start_ms": 23616,
          "end_ms": 26992,
          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 5,
      "text": "「おにぎり」をせつめいすることばは、「おむすび」もあります。",
      "start_ms": 27492,
      "end_ms": 32949,
      "duration_ms": 5457,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」をせつめいすることばは、",
          "start_ms": 27492,
          "end_ms": 30461,
          "duration_ms": 2969
        },
        {
          "index": 1,
          "text": "「おむすび」もあります。",
          "start_ms": 30711,
          "end_ms": 32949,
          "duration_ms": 2238
        }
      ]
    },
    {
      "index": 6,
      "text": "「むすび」というなまえをみんなが使い始めたのは、えどじだいです。",
      "start_ms": 33449,
      "end_ms": 39927,
      "duration_ms": 6478,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」というなまえをみんなが使い始めたのは、",
          "start_ms": 33449,
          "end_ms": 37730,
          "duration_ms": 4281
        },
        {
          "index": 1,
          "text": "えどじだいです。",
          "start_ms": 37980,
          "end_ms": 39927,
          "duration_ms": 1947
        }
      ]
    },
    {
      "index": 7,
      "text": "そこにもけいごの「お」を付けました。",
      "start_ms": 40427,
      "end_ms": 43443,
      "duration_ms": 3016,
      "clauses": [
        {
          "index": 0,
          "text": "そこにもけいごの「お」を付けました。",
          "start_ms": 40427,
          "end_ms": 43443,
          "duration_ms": 3016
        }
      ]
    },
    {
      "index": 8,
      "text": "むかしの本には、「むすび」を「にぎりいい」の別のなまえと書いて、「もとは女のことばです」とも書かれています。",
      "start_ms": 43943,
      "end_ms": 53978,
      "duration_ms": 10035,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 43943,
          "end_ms": 46007,
          "duration_ms": 2064
        },
        {
          "index": 1,
          "text": "「むすび」を「にぎりいい」の別のなまえと書いて、",
          "start_ms": 46257,
          "end_ms": 49807,
          "duration_ms": 3550
        },
        {
          "index": 2,
          "text": "「もとは女のことばです」とも書かれています。",
          "start_ms": 50057,
          "end_ms": 53978,
          "duration_ms": 3921
        }
      ]
    },
    {
      "index": 9,
      "text": "「むすび」は、なまえのいみをあらわすだけのことばではありません。",
      "start_ms": 54478,
      "end_ms": 60527,
      "duration_ms": 6049,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」は、",
          "start_ms": 54478,
          "end_ms": 56031,
          "duration_ms": 1553
        },
        {
          "index": 1,
          "text": "なまえのいみをあらわすだけのことばではありません。",
          "start_ms": 56281,
          "end_ms": 60527,
          "duration_ms": 4246
        }
      ]
    },
    {
      "index": 10,
      "text": "かみさまのなまえも、むかしの本に出ています。",
      "start_ms": 61027,
      "end_ms": 66113,
      "duration_ms": 5086,
      "clauses": [
        {
          "index": 0,
          "text": "かみさまのなまえも、",
          "start_ms": 61027,
          "end_ms": 63242,
          "duration_ms": 2215
        },
        {
          "index": 1,
          "text": "むかしの本に出ています。",
          "start_ms": 63492,
          "end_ms": 66113,
          "duration_ms": 2621
        }
      ]
    },
    {
      "index": 11,
      "text": "そこに、何かを作るいみとか、人と人がつながるいみとかが加わっているのです。",
      "start_ms": 66613,
      "end_ms": 75232,
      "duration_ms": 8619,
      "clauses": [
        {
          "index": 0,
          "text": "そこに、",
          "start_ms": 66613,
          "end_ms": 67934,
          "duration_ms": 1321
        },
        {
          "index": 1,
          "text": "何かを作るいみとか、",
          "start_ms": 68184,
          "end_ms": 70724,
          "duration_ms": 2540
        },
        {
          "index": 2,
          "text": "人と人がつながるいみとかが加わっているのです。",
          "start_ms": 70974,
          "end_ms": 75232,
          "duration_ms": 4258
        }
      ]
    },
    {
      "index": 12,
      "text": "つまり、「むすび」は、いみがさまざまに加わったことばということです。",
      "start_ms": 75732,
      "end_ms": 83340,
      "duration_ms": 7608,
      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 75732,
          "end_ms": 77053,
          "duration_ms": 1321
        },
        {
          "index": 1,
          "text": "「むすび」は、",
          "start_ms": 77303,
          "end_ms": 78879,
          "duration_ms": 1576
        },
        {
          "index": 2,
          "text": "いみがさまざまに加わったことばということです。",
          "start_ms": 79129,
          "end_ms": 83340,
          "duration_ms": 4211
        }
      ]
    },
    {
      "index": 13,
      "text": "もちろん、「むすび」というなまえがかみさまとつながっているとは言えません。",
      "start_ms": 83840,
      "end_ms": 90841,
      "duration_ms": 7001,
      "clauses": [
        {
          "index": 0,
          "text": "もちろん、",
          "start_ms": 83840,
          "end_ms": 85346,
          "duration_ms": 1506
        },
        {
          "index": 1,
          "text": "「むすび」というなまえがかみさまとつながっているとは言えません。",
          "start_ms": 85596,
          "end_ms": 90841,
          "duration_ms": 5245
        }
      ]
    },
    {
      "index": 14,
      "text": "でも、ことばのいみがさまざまに加わっていることにちゅうもくすると、この毎日のたべものがにほんに住む人にとって、大切ないみを持つのでしょう。",
      "start_ms": 91341,
      "end_ms": 105408,
      "duration_ms": 14067,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 91341,
          "end_ms": 92336,
          "duration_ms": 995
        },
        {
          "index": 1,
          "text": "ことばのいみがさまざまに加わっていることにちゅうもくすると、",
          "start_ms": 92586,
          "end_ms": 97657,
          "duration_ms": 5071
        },
        {
          "index": 2,
          "text": "この毎日のたべものがにほんに住む人にとって、",
          "start_ms": 97907,
          "end_ms": 102293,
          "duration_ms": 4386
        },
        {
          "index": 3,
          "text": "大切ないみを持つのでしょう。",
          "start_ms": 102543,
          "end_ms": 105408,
          "duration_ms": 2865
        }
      ]
    }
  ]
