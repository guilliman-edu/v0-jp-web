    },
    {
      "index": 1,
      "text": "むかし、山のむらに、のうかの人たちが住んでいました。",
      "start_ms": 2157,
      "end_ms": 7730,
      "duration_ms": 5573,
      "clauses": [
        {
          "index": 0,
          "text": "むかし、山のむらに、",
          "start_ms": 2157,
          "end_ms": 4325,
          "duration_ms": 2168
        },
        {
          "index": 1,
          "text": "のうかの人たちが住んでいました。",
          "start_ms": 4575,
          "end_ms": 7730,
          "duration_ms": 3155
        }
      ]
    },
    {
      "index": 2,
      "text": "のぶし（わるいぶしたち）がいつもむらに来て、たべものを取りました。",
      "start_ms": 8230,
      "end_ms": 14755,
      "duration_ms": 6525,
      "clauses": [
        {
          "index": 0,
          "text": "のぶし（わるいぶしたち）がいつもむらに来て、",
          "start_ms": 8230,
          "end_ms": 12186,
          "duration_ms": 3956
        },
        {
          "index": 1,
          "text": "たべものを取りました。",
          "start_ms": 12436,
          "end_ms": 14755,
          "duration_ms": 2319
        }
      ]
    },
    {
      "index": 3,
      "text": "むらびとたちは、強いぶしがほしいと思いました。",
      "start_ms": 15255,
      "end_ms": 20700,
      "duration_ms": 5445,
      "clauses": [
        {
          "index": 0,
          "text": "むらびとたちは、",
          "start_ms": 15255,
          "end_ms": 17214,
          "duration_ms": 1959
        },
        {
          "index": 1,
          "text": "強いぶしがほしいと思いました。",
          "start_ms": 17464,
          "end_ms": 20700,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 4,
      "text": "ですから、町へぶしを探しに行きました。",
      "start_ms": 21200,
      "end_ms": 26227,
      "duration_ms": 5027,
      "clauses": [
        {
          "index": 0,
          "text": "ですから、",
          "start_ms": 21200,
          "end_ms": 22660,
          "duration_ms": 1460
        },
        {
          "index": 1,
          "text": "町へぶしを探しに行きました。",
          "start_ms": 22910,
          "end_ms": 26227,
          "duration_ms": 3317
        }
      ]
    },
    {
      "index": 5,
      "text": "町で、かんべえというぶしに会いました。",
      "start_ms": 26727,
      "end_ms": 31197,
      "duration_ms": 4470,
      "clauses": [
        {
          "index": 0,
          "text": "町で、",
