          "end_ms": 48905,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 9,
      "text": "でも、四人のぶしが死にました。",
      "start_ms": 49405,
      "end_ms": 53271,
      "duration_ms": 3866,
      "clauses": [
