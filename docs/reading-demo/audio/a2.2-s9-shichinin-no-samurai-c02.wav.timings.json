          "text": "むらびとたちとみんなで戦いました。",
          "start_ms": 40850,
          "end_ms": 44330,
          "duration_ms": 3480
        }
      ]
    },
    {
      "index": 8,
      "text": "やっと、ぶしたちは勝ちました。",
      "start_ms": 44830,
      "end_ms": 48905,
      "duration_ms": 4075,
      "clauses": [
