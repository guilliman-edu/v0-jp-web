    },
    {
      "index": 1,
      "text": "むかし、山のむらに、のうかの人たちが住んでいました。",
      "start_ms": 2122,
      "end_ms": 7695,
      "duration_ms": 5573,
      "clauses": [
        {
          "index": 0,
          "text": "むかし、山のむらに、",
          "start_ms": 2122,
          "end_ms": 4313,
          "duration_ms": 2191
        },
        {
          "index": 1,
          "text": "のうかの人たちが住んでいました。",
          "start_ms": 4563,
          "end_ms": 7695,
          "duration_ms": 3132
        }
      ]
    },
    {
      "index": 2,
      "text": "のぶし（わるいぶしたち）がいつもむらに来て、たべものを取りました。",
      "start_ms": 8195,
      "end_ms": 14732,
      "duration_ms": 6537,
      "clauses": [
        {
          "index": 0,
          "text": "のぶし（わるいぶしたち）がいつもむらに来て、",
          "start_ms": 8195,
          "end_ms": 12186,
          "duration_ms": 3991
        },
        {
          "index": 1,
          "text": "たべものを取りました。",
          "start_ms": 12436,
          "end_ms": 14732,
          "duration_ms": 2296
        }
      ]
    },
    {
      "index": 3,
      "text": "むらびとたちは、強いぶしがほしいと思いました。",
      "start_ms": 15232,
      "end_ms": 20643,
      "duration_ms": 5411,
      "clauses": [
        {
          "index": 0,
          "text": "むらびとたちは、",
          "start_ms": 15232,
          "end_ms": 17238,
          "duration_ms": 2006
        },
        {
          "index": 1,
          "text": "強いぶしがほしいと思いました。",
          "start_ms": 17488,
          "end_ms": 20643,
          "duration_ms": 3155
        }
      ]
    },
    {
      "index": 4,
      "text": "ですから、町へぶしを探しに行きました。",
      "start_ms": 21143,
      "end_ms": 26135,
      "duration_ms": 4992,
      "clauses": [
        {
          "index": 0,
          "text": "ですから、",
          "start_ms": 21143,
          "end_ms": 22591,
          "duration_ms": 1448
        },
        {
          "index": 1,
          "text": "町へぶしを探しに行きました。",
          "start_ms": 22841,
          "end_ms": 26135,
          "duration_ms": 3294
        }
      ]
    },
    {
      "index": 5,
      "text": "町で、かんべえというぶしに会いました。",
      "start_ms": 26635,
      "end_ms": 31058,
      "duration_ms": 4423,
      "clauses": [
        {
          "index": 0,
          "text": "町で、",
          "start_ms": 26635,
          "end_ms": 27897,
          "duration_ms": 1262
        },
        {
          "index": 1,
          "text": "かんべえというぶしに会いました。",
          "start_ms": 28147,
          "end_ms": 31058,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 6,
      "text": "かんべえはほかのぶしを集めて、七人になりました。",
      "start_ms": 31558,
      "end_ms": 37433,
      "duration_ms": 5875,
      "clauses": [
        {
          "index": 0,
          "text": "かんべえはほかのぶしを集めて、",
          "start_ms": 31558,
          "end_ms": 34852,
          "duration_ms": 3294
        },
        {
          "index": 1,
          "text": "七人になりました。",
          "start_ms": 35102,
          "end_ms": 37433,
          "duration_ms": 2331
        }
      ]
    },
    {
      "index": 7,
      "text": "ぶしたちはむらに行って、むらびとたちとみんなで戦いました。",
      "start_ms": 37933,
      "end_ms": 44109,
      "duration_ms": 6176,
      "clauses": [
        {
          "index": 0,
          "text": "ぶしたちはむらに行って、",
          "start_ms": 37933,
          "end_ms": 40333,
          "duration_ms": 2400
        },
        {
          "index": 1,
          "text": "むらびとたちとみんなで戦いました。",
          "start_ms": 40583,
          "end_ms": 44109,
          "duration_ms": 3526
        }
      ]
    },
    {
      "index": 8,
      "text": "やっと、ぶしたちは勝ちました。",
      "start_ms": 44609,
      "end_ms": 48812,
      "duration_ms": 4203,
      "clauses": [
        {
          "index": 0,
          "text": "やっと、",
          "start_ms": 44609,
