          "end_ms": 27989,
          "duration_ms": 1262
        },
        {
          "index": 1,
          "text": "かんべえというぶしに会いました。",
          "start_ms": 28239,
          "end_ms": 31197,
          "duration_ms": 2958
        }
      ]
    },
    {
      "index": 6,
      "text": "かんべえはほかのぶしを集めて、七人になりました。",
      "start_ms": 31697,
      "end_ms": 37537,
      "duration_ms": 5840,
      "clauses": [
        {
          "index": 0,
          "text": "かんべえはほかのぶしを集めて、",
          "start_ms": 31697,
          "end_ms": 34968,
          "duration_ms": 3271
        },
        {
          "index": 1,
          "text": "七人になりました。",
          "start_ms": 35218,
          "end_ms": 37537,
          "duration_ms": 2319
        }
      ]
    },
    {
      "index": 7,
      "text": "ぶしたちはむらに行って、むらびとたちとみんなで戦いました。",
      "start_ms": 38037,
      "end_ms": 44330,
      "duration_ms": 6293,
      "clauses": [
        {
          "index": 0,
          "text": "ぶしたちはむらに行って、",
