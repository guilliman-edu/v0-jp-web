          "text": "ぶしたちは勝ちました。",
          "start_ms": 46214,
          "end_ms": 48812,
          "duration_ms": 2598
        }
      ]
    },
    {
      "index": 9,
      "text": "でも、四人のぶしが死にました。",
      "start_ms": 49312,
      "end_ms": 53179,
      "duration_ms": 3867,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
