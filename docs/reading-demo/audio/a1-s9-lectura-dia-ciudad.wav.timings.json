{
  "audio_file": "a1-s9-lectura-dia-ciudad.wav",
  "sample_rate": 44100,
  "pause_ms": 500,
  "total_duration_ms": 90829,
  "sentences": [
    {
      "index": 0,
      "text": "町のいちにち",
      "start_ms": 0,
      "end_ms": 2419,
      "duration_ms": 2419
    },
    {
      "index": 1,
      "text": "きょうはいい天気です。",
      "start_ms": 2919,
      "end_ms": 5489,
      "duration_ms": 2570
    },
    {
      "index": 2,
      "text": "鈴木さんはともだちと町に行きます。",
      "start_ms": 5989,
      "end_ms": 10045,
      "duration_ms": 4056
    },
    {
      "index": 3,
      "text": "けさ、七時に起きました。",
      "start_ms": 10545,
      "end_ms": 13637,
      "duration_ms": 3092
    },
    {
      "index": 4,
      "text": "朝ごはんを食べました。",
      "start_ms": 14137,
      "end_ms": 17020,
      "duration_ms": 2883
    },
    {
      "index": 5,
      "text": "鈴木さんは毎日七時に起きます。",
      "start_ms": 17520,
      "end_ms": 22040,
      "duration_ms": 4520
    },
    {
      "index": 6,
      "text": "ときどき一人で朝ごはんを食べます。",
      "start_ms": 22540,
      "end_ms": 26863,
      "duration_ms": 4323
    },
    {
      "index": 7,
      "text": "八時にうちを出ました。",
      "start_ms": 27363,
      "end_ms": 30246,
      "duration_ms": 2883
    },
    {
      "index": 8,
      "text": "駅でともだちに会いました。",
      "start_ms": 30746,
      "end_ms": 33757,
      "duration_ms": 3011
    },
    {
      "index": 9,
      "text": "いつも駅で会います。",
      "start_ms": 34257,
      "end_ms": 37001,
      "duration_ms": 2744
    },
    {
      "index": 10,
      "text": "とても楽しいです。",
      "start_ms": 37501,
      "end_ms": 39978,
      "duration_ms": 2477
    },
    {
      "index": 11,
      "text": "町で映画を見ました。",
      "start_ms": 40478,
      "end_ms": 43431,
      "duration_ms": 2953
    },
    {
      "index": 12,
      "text": "とてもおもしろかったです。",
      "start_ms": 43931,
      "end_ms": 46884,
      "duration_ms": 2953
    },
    {
      "index": 13,
      "text": "鈴木さんはよく映画を見ます。",
      "start_ms": 47384,
      "end_ms": 51080,
      "duration_ms": 3696
    },
    {
      "index": 14,
      "text": "あまりテレビを見ません。",
      "start_ms": 51580,
      "end_ms": 54649,
      "duration_ms": 3069
    },
    {
      "index": 15,
      "text": "お昼にレストランで食べました。",
      "start_ms": 55149,
      "end_ms": 58404,
      "duration_ms": 3255
    },
    {
      "index": 16,
      "text": "鈴木さんはあまりお肉を食べません。",
      "start_ms": 58904,
      "end_ms": 63018,
      "duration_ms": 4114
    },
    {
      "index": 17,
      "text": "魚を食べました。",
      "start_ms": 63518,
      "end_ms": 66030,
      "duration_ms": 2512
    },
    {
      "index": 18,
      "text": "午後、買い物をしました。",
      "start_ms": 66530,
      "end_ms": 69286,
      "duration_ms": 2756
    },
    {
      "index": 19,
      "text": "本とCDを買いました。",
      "start_ms": 69786,
      "end_ms": 72193,
      "duration_ms": 2407
    },
    {
      "index": 20,
      "text": "鈴木さんはぜんぜんコーヒーを飲みません。",
      "start_ms": 72693,
      "end_ms": 76981,
      "duration_ms": 4288
    },
    {
      "index": 21,
      "text": "いつもお茶を飲みます。",
      "start_ms": 77481,
      "end_ms": 80260,
      "duration_ms": 2779
    },
    {
      "index": 22,
      "text": "こんばん、七時にうちに帰ります。",
      "start_ms": 80760,
      "end_ms": 84468,
      "duration_ms": 3708
    },
    {
      "index": 23,
      "text": "あしたは試験があります。",
      "start_ms": 84968,
      "end_ms": 87782,
      "duration_ms": 2814
    },
    {
      "index": 24,
      "text": "うちで勉強します。",
      "start_ms": 88282,
      "end_ms": 90829,
      "duration_ms": 2547
    }
  ]
}