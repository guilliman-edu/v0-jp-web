      "clauses": [
        {
          "index": 0,
          "text": "「この人も当人じゃありません。",
          "start_ms": 209049,
          "end_ms": 212030,
          "duration_ms": 2981
        }
      ]
    },
    {
      "index": 40,
      "text": "もう他に娘はいないのですか？」",
      "start_ms": 212530,
      "end_ms": 215673,
      "duration_ms": 3143,
      "clauses": [
        {
          "index": 0,
          "text": "もう他に娘はいないのですか？」",
          "start_ms": 212530,
          "end_ms": 215673,
          "duration_ms": 3143
        }
      ]
    },
    {
      "index": 41,
      "text": "と言いました。",
      "start_ms": 216173,
      "end_ms": 217865,
      "duration_ms": 1692,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 216173,
          "end_ms": 217865,
          "duration_ms": 1692
        }
      ]
    },
    {
      "index": 42,
      "text": "「はい、いません。",
      "start_ms": 218365,
      "end_ms": 221059,
      "duration_ms": 2694,
      "clauses": [
        {
          "index": 0,
          "text": "「はい、",
          "start_ms": 218365,
          "end_ms": 218966,
          "duration_ms": 601
        },
        {
          "index": 1,
          "text": "いません。",
          "start_ms": 219216,
          "end_ms": 221059,
          "duration_ms": 1843
        }
      ]
    },
    {
      "index": 43,
      "text": "まだ亡くなった妻が残していった、少し風変わりな台所女中はいますが、はなよめとはとんでもございません。」",
      "start_ms": 221559,
      "end_ms": 232882,
      "duration_ms": 11323,
      "clauses": [
        {
          "index": 0,
          "text": "まだ亡くなった妻が残していった、",
          "start_ms": 221559,
          "end_ms": 224795,
          "duration_ms": 3236
        },
        {
          "index": 1,
          "text": "少し風変わりな台所女中はいますが、",
          "start_ms": 225045,
          "end_ms": 229222,
          "duration_ms": 4177
        },
        {
          "index": 2,
          "text": "はなよめとはとんでもございません。」",
          "start_ms": 229472,
          "end_ms": 232882,
          "duration_ms": 3410
        }
      ]
    },
    {
      "index": 44,
      "text": "父親はそう言いました。",
      "start_ms": 233382,
      "end_ms": 236154,
      "duration_ms": 2772,
      "clauses": [
        {
          "index": 0,
          "text": "父親はそう言いました。",
          "start_ms": 233382,
          "end_ms": 236154,
          "duration_ms": 2772
        }
      ]
    },
    {
      "index": 45,
      "text": "おうじは、その娘を連れてくるように言いました。",
      "start_ms": 236654,
      "end_ms": 241635,
      "duration_ms": 4981,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは、",
          "start_ms": 236654,
          "end_ms": 237951,
          "duration_ms": 1297
        },
        {
          "index": 1,
          "text": "その娘を連れてくるように言いました。",
          "start_ms": 238201,
          "end_ms": 241635,
          "duration_ms": 3434
        }
      ]
    },
    {
      "index": 46,
      "text": "母親は「とんでもございません。",
      "start_ms": 242135,
      "end_ms": 245127,
      "duration_ms": 2992,
      "clauses": [
        {
          "index": 0,
          "text": "母親は「とんでもございません。",
          "start_ms": 242135,
          "end_ms": 245127,
          "duration_ms": 2992
        }
      ]
    },
    {
      "index": 47,
      "text": "あまりにも汚くて、お目にかかりませんよ。」",
      "start_ms": 245627,
      "end_ms": 250491,
      "duration_ms": 4864,
      "clauses": [
        {
          "index": 0,
          "text": "あまりにも汚くて、",
          "start_ms": 245627,
          "end_ms": 247934,
          "duration_ms": 2307
        },
        {
          "index": 1,
          "text": "お目にかかりませんよ。」",
          "start_ms": 248184,
          "end_ms": 250491,
          "duration_ms": 2307
        }
      ]
    },
    {
      "index": 48,
      "text": "と答えました。",
      "start_ms": 250991,
      "end_ms": 252892,
      "duration_ms": 1901,
      "clauses": [
        {
          "index": 0,
          "text": "と答えました。",
          "start_ms": 250991,
          "end_ms": 252892,
          "duration_ms": 1901
        }
      ]
    },
    {
      "index": 49,
      "text": "でも、おうじあくまで言い張ったので、シンデレラを呼ばなければなりませんでした。",
      "start_ms": 253392,
      "end_ms": 261279,
      "duration_ms": 7887,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 253392,
          "end_ms": 254387,
          "duration_ms": 995
        },
        {
          "index": 1,
          "text": "おうじあくまで言い張ったので、",
          "start_ms": 254637,
          "end_ms": 257328,
          "duration_ms": 2691
        },
        {
          "index": 2,
          "text": "シンデレラを呼ばなければなりませんでした。",
          "start_ms": 257578,
          "end_ms": 261279,
          "duration_ms": 3701
        }
      ]
    },
    {
      "index": 50,
      "text": "娘はまず両手と顔を洗ってきれいにし、おうじの前に行ってお辞儀をしました。",
      "start_ms": 261779,
      "end_ms": 269627,
      "duration_ms": 7848,
      "clauses": [
        {
          "index": 0,
          "text": "娘はまず両手と顔を洗ってきれいにし、",
          "start_ms": 261779,
          "end_ms": 266083,
          "duration_ms": 4304
        },
        {
          "index": 1,
          "text": "おうじの前に行ってお辞儀をしました。",
          "start_ms": 266333,
          "end_ms": 269627,
          "duration_ms": 3294
        }
      ]
    },
    {
      "index": 51,
      "text": "おうじは娘に金の靴を渡しました。",
      "start_ms": 270127,
      "end_ms": 274060,
      "duration_ms": 3933,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘に金の靴を渡しました。",
          "start_ms": 270127,
          "end_ms": 274060,
          "duration_ms": 3933
        }
      ]
    },
    {
      "index": 52,
      "text": "娘は足載せ台に座って、重い木の靴から足を出して、うわぐつを履きました。",
      "start_ms": 274560,
      "end_ms": 283968,
      "duration_ms": 9408,
      "clauses": [
        {
          "index": 0,
          "text": "娘は足載せ台に座って、",
          "start_ms": 274560,
          "end_ms": 277889,
          "duration_ms": 3329
        },
        {
          "index": 1,
          "text": "重い木の靴から足を出して、",
          "start_ms": 278139,
          "end_ms": 281329,
          "duration_ms": 3190
        },
        {
          "index": 2,
          "text": "うわぐつを履きました。",
          "start_ms": 281579,
          "end_ms": 283968,
          "duration_ms": 2389
        }
      ]
    },
    {
      "index": 53,
      "text": "ぴったり合いました。",
      "start_ms": 284468,
      "end_ms": 286543,
      "duration_ms": 2075,
      "clauses": [
        {
          "index": 0,
          "text": "ぴったり合いました。",
          "start_ms": 284468,
          "end_ms": 286543,
          "duration_ms": 2075
        }
      ]
    },
    {
      "index": 54,
      "text": "娘が立ち上がると、おうじはその顔を見て、自分が踊ったうつくしい娘だと分かりました。",
      "start_ms": 287043,
      "end_ms": 296891,
      "duration_ms": 9848,
      "clauses": [
        {
          "index": 0,
          "text": "娘が立ち上がると、",
          "start_ms": 287043,
          "end_ms": 289408,
          "duration_ms": 2365
        },
        {
          "index": 1,
          "text": "おうじはその顔を見て、",
          "start_ms": 289658,
          "end_ms": 292302,
          "duration_ms": 2644
        },
        {
          "index": 2,
          "text": "自分が踊ったうつくしい娘だと分かりました。",
          "start_ms": 292552,
          "end_ms": 296891,
          "duration_ms": 4339
        }
      ]
    },
    {
      "index": 55,
      "text": "「この人が本当のはなよめだ！」",
      "start_ms": 297391,
      "end_ms": 300395,
      "duration_ms": 3004,
      "clauses": [
        {
          "index": 0,
          "text": "「この人が本当のはなよめだ！」",
          "start_ms": 297391,
          "end_ms": 300395,
          "duration_ms": 3004
        }
      ]
    },
    {
      "index": 56,
      "text": "と叫びました。",
      "start_ms": 300895,
      "end_ms": 302866,
      "duration_ms": 1971,
      "clauses": [
        {
          "index": 0,
          "text": "と叫びました。",
          "start_ms": 300895,
          "end_ms": 302866,
          "duration_ms": 1971
        }
      ]
    },
    {
      "index": 57,
      "text": "ままははと二人の姉たちは恐ろしくなって、怒りで青ざめました。",
      "start_ms": 303366,
      "end_ms": 310332,
      "duration_ms": 6966,
      "clauses": [
        {
          "index": 0,
          "text": "ままははと二人の姉たちは恐ろしくなって、",
          "start_ms": 303366,
          "end_ms": 307577,
          "duration_ms": 4211
        },
        {
          "index": 1,
          "text": "怒りで青ざめました。",
          "start_ms": 307827,
          "end_ms": 310332,
          "duration_ms": 2505
        }
      ]
    },
    {
      "index": 58,
      "text": "おうじはシンデレラを馬に乗せて、一緒に去りました。",
      "start_ms": 310832,
      "end_ms": 316544,
      "duration_ms": 5712,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはシンデレラを馬に乗せて、",
          "start_ms": 310832,
          "end_ms": 314138,
          "duration_ms": 3306
        },
        {
          "index": 1,
          "text": "一緒に去りました。",
          "start_ms": 314388,
          "end_ms": 316544,
          "duration_ms": 2156
        }
      ]
    },
    {
      "index": 59,
      "text": "はしばみの木のそばを通ると、二羽の白いはとが叫びました。",
      "start_ms": 317044,
      "end_ms": 323604,
      "duration_ms": 6560,
      "clauses": [
        {
          "index": 0,
          "text": "はしばみの木のそばを通ると、",
          "start_ms": 317044,
          "end_ms": 320199,
          "duration_ms": 3155
        },
        {
          "index": 1,
          "text": "二羽の白いはとが叫びました。",
          "start_ms": 320449,
          "end_ms": 323604,
          "duration_ms": 3155
        }
      ]
    },
    {
      "index": 60,
      "text": "「振り向いて覗いてごらん。",
      "start_ms": 324104,
      "end_ms": 326632,
      "duration_ms": 2528,
      "clauses": [
        {
          "index": 0,
          "text": "「振り向いて覗いてごらん。",
          "start_ms": 324104,
          "end_ms": 326632,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 61,
      "text": "振り向いて覗いてごらん。",
      "start_ms": 327132,
      "end_ms": 329637,
      "duration_ms": 2505,
      "clauses": [
        {
          "index": 0,
          "text": "振り向いて覗いてごらん。",
          "start_ms": 327132,
          "end_ms": 329637,
          "duration_ms": 2505
        }
      ]
    },
    {
      "index": 62,
      "text": "靴に血がついていないよ。",
      "start_ms": 330137,
      "end_ms": 332735,
      "duration_ms": 2598,
      "clauses": [
        {
          "index": 0,
          "text": "靴に血がついていないよ。",
          "start_ms": 330137,
          "end_ms": 332735,
          "duration_ms": 2598
        }
      ]
    },
    {
      "index": 63,
      "text": "靴は小さすぎない。",
      "start_ms": 333235,
      "end_ms": 335600,
      "duration_ms": 2365,
      "clauses": [
        {
          "index": 0,
          "text": "靴は小さすぎない。",
          "start_ms": 333235,
          "end_ms": 335600,
          "duration_ms": 2365
        }
      ]
    },
    {
      "index": 64,
      "text": "本当のはなよめがあなたと一緒だよ。」",
      "start_ms": 336100,
      "end_ms": 339870,
      "duration_ms": 3770,
      "clauses": [
        {
          "index": 0,
          "text": "本当のはなよめがあなたと一緒だよ。」",
          "start_ms": 336100,
          "end_ms": 339870,
          "duration_ms": 3770
        }
      ]
    },
    {
      "index": 65,
      "text": "二羽は降りってきて、シンデレラの肩に止まりました。",
      "start_ms": 340370,
      "end_ms": 345908,
      "duration_ms": 5538,
      "clauses": [
        {
          "index": 0,
          "text": "二羽は降りってきて、",
          "start_ms": 340370,
          "end_ms": 342654,
          "duration_ms": 2284
        },
        {
          "index": 1,
          "text": "シンデレラの肩に止まりました。",
          "start_ms": 342904,
          "end_ms": 345908,
          "duration_ms": 3004
        }
      ]
    },
    {
      "index": 66,
      "text": "一羽が右に、もう一羽が左に、そのまま座ったままになりました。",
      "start_ms": 346408,
      "end_ms": 354109,
      "duration_ms": 7701,
      "clauses": [
        {
          "index": 0,
          "text": "一羽が右に、",
          "start_ms": 346408,
          "end_ms": 348170,
          "duration_ms": 1762
        },
        {
          "index": 1,
          "text": "もう一羽が左に、",
          "start_ms": 348420,
          "end_ms": 350646,
          "duration_ms": 2226
        },
        {
          "index": 2,
          "text": "そのまま座ったままになりました。",
          "start_ms": 350896,
          "end_ms": 354109,
          "duration_ms": 3213
        }
      ]
    },
    {
      "index": 67,
      "text": "おうじのけっこんしきが行われることになりました。",
      "start_ms": 354609,
      "end_ms": 358948,
      "duration_ms": 4339,
      "clauses": [
        {
          "index": 0,
          "text": "おうじのけっこんしきが行われることになりました。",
          "start_ms": 354609,
          "end_ms": 358948,
          "duration_ms": 4339
        }
      ]
    },
    {
      "index": 68,
      "text": "二人の不実な姉たちがやってきて、シンデレラの機嫌をとり、幸せを分けてもらおうとしました。",
      "start_ms": 359448,
      "end_ms": 369274,
      "duration_ms": 9826,
      "clauses": [
        {
          "index": 0,
          "text": "二人の不実な姉たちがやってきて、",
          "start_ms": 359448,
          "end_ms": 362789,
          "duration_ms": 3341
        },
        {
          "index": 1,
          "text": "シンデレラの機嫌をとり、",
          "start_ms": 363039,
          "end_ms": 365602,
          "duration_ms": 2563
        },
        {
          "index": 2,
          "text": "幸せを分けてもらおうとしました。",
          "start_ms": 365852,
          "end_ms": 369274,
          "duration_ms": 3422
        }
      ]
    },
    {
      "index": 69,
      "text": "きょうかいに行ったとき、姉は右側に、妹は左側にいました。",
      "start_ms": 369774,
      "end_ms": 377417,
      "duration_ms": 7643,
      "clauses": [
        {
          "index": 0,
          "text": "きょうかいに行ったとき、",
          "start_ms": 369774,
          "end_ms": 372012,
          "duration_ms": 2238
        },
        {
          "index": 1,
          "text": "姉は右側に、",
          "start_ms": 372262,
          "end_ms": 374337,
          "duration_ms": 2075
        },
        {
          "index": 2,
          "text": "妹は左側にいました。",
          "start_ms": 374587,
          "end_ms": 377417,
          "duration_ms": 2830
        }
      ]
    },
    {
      "index": 70,
      "text": "はとたちがそれぞれから片目をつついて取り出しました。",
      "start_ms": 377917,
      "end_ms": 382802,
      "duration_ms": 4885,
      "clauses": [
        {
          "index": 0,
          "text": "はとたちがそれぞれから片目をつついて取り出しました。",
          "start_ms": 377917,
          "end_ms": 382802,
          "duration_ms": 4885
        }
      ]
    },
    {
      "index": 71,
      "text": "帰りには姉が左、妹が右になったので、はとたちはそれぞれからもう一つの目をつついて取り出しました。",
      "start_ms": 383302,
      "end_ms": 394683,
      "duration_ms": 11381,
      "clauses": [
        {
          "index": 0,
          "text": "帰りには姉が左、",
          "start_ms": 383302,
          "end_ms": 386039,
          "duration_ms": 2737
        },
        {
          "index": 1,
          "text": "妹が右になったので、",
          "start_ms": 386289,
          "end_ms": 388898,
          "duration_ms": 2609
        },
        {
          "index": 2,
          "text": "はとたちはそれぞれからもう一つの目をつついて取り出しました。",
          "start_ms": 389148,
          "end_ms": 394683,
          "duration_ms": 5535
        }
      ]
    },
    {
      "index": 72,
      "text": "こうして、いじわるとふせいじつな二人は、ばつを受けて、しょうがい目が見えないままでした。",
      "start_ms": 395183,
      "end_ms": 405278,
      "duration_ms": 10095,
      "clauses": [
        {
          "index": 0,
          "text": "こうして、",
          "start_ms": 395183,
          "end_ms": 396573,
          "duration_ms": 1390
        },
        {
          "index": 1,
          "text": "いじわるとふせいじつな二人は、",
          "start_ms": 396823,
          "end_ms": 399850,
          "duration_ms": 3027
        },
        {
          "index": 2,
          "text": "ばつを受けて、",
          "start_ms": 400100,
          "end_ms": 401920,
          "duration_ms": 1820
        },
        {
          "index": 3,
          "text": "しょうがい目が見えないままでした。",
          "start_ms": 402170,
          "end_ms": 405278,
          "duration_ms": 3108
        }
      ]
    }
  ]
}