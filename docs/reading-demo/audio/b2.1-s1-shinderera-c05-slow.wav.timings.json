        {
          "index": 0,
          "text": "「この人も当人じゃありません。",
          "start_ms": 209348,
          "end_ms": 212364,
          "duration_ms": 3016
        }
      ]
    },
    {
      "index": 40,
      "text": "もう他に娘はいないのですか？",
      "start_ms": 212864,
      "end_ms": 215996,
      "duration_ms": 3132,
      "clauses": [
        {
          "index": 0,
          "text": "もう他に娘はいないのですか？",
          "start_ms": 212864,
          "end_ms": 215996,
          "duration_ms": 3132
        }
      ]
    },
    {
      "index": 41,
      "text": "」と言いました。",
      "start_ms": 216496,
      "end_ms": 218188,
      "duration_ms": 1692,
      "clauses": [
        {
          "index": 0,
          "text": "」と言いました。",
          "start_ms": 216496,
          "end_ms": 218188,
          "duration_ms": 1692
        }
      ]
    },
    {
      "index": 42,
      "text": "「はい、いません。",
      "start_ms": 218688,
      "end_ms": 221429,
      "duration_ms": 2741,
      "clauses": [
        {
          "index": 0,
          "text": "「はい、",
          "start_ms": 218688,
          "end_ms": 219324,
          "duration_ms": 636
        },
        {
          "index": 1,
          "text": "いません。",
          "start_ms": 219574,
          "end_ms": 221429,
          "duration_ms": 1855
        }
      ]
    },
    {
      "index": 43,
      "text": "まだ亡くなった妻が残していった、少し風変わりな台所女中はいますが、はなよめとはとんでもございません。",
      "start_ms": 221929,
      "end_ms": 233346,
      "duration_ms": 11417,
      "clauses": [
        {
          "index": 0,
          "text": "まだ亡くなった妻が残していった、",
          "start_ms": 221929,
          "end_ms": 225270,
          "duration_ms": 3341
        },
        {
          "index": 1,
          "text": "少し風変わりな台所女中はいますが、",
          "start_ms": 225520,
          "end_ms": 229639,
          "duration_ms": 4119
        },
        {
          "index": 2,
          "text": "はなよめとはとんでもございません。",
          "start_ms": 229889,
          "end_ms": 233346,
          "duration_ms": 3457
        }
      ]
    },
    {
      "index": 44,
      "text": "」父親はそう言いました。",
      "start_ms": 233846,
      "end_ms": 236699,
      "duration_ms": 2853,
      "clauses": [
        {
          "index": 0,
          "text": "」父親はそう言いました。",
          "start_ms": 233846,
          "end_ms": 236699,
          "duration_ms": 2853
        }
      ]
    },
    {
      "index": 45,
      "text": "おうじは、その娘を連れてくるように言いました。",
      "start_ms": 237199,
      "end_ms": 242180,
      "duration_ms": 4981,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは、",
          "start_ms": 237199,
          "end_ms": 238508,
          "duration_ms": 1309
        },
        {
          "index": 1,
          "text": "その娘を連れてくるように言いました。",
          "start_ms": 238758,
          "end_ms": 242180,
          "duration_ms": 3422
        }
      ]
    },
    {
      "index": 46,
      "text": "母親は「とんでもございません。",
      "start_ms": 242680,
      "end_ms": 245754,
      "duration_ms": 3074,
      "clauses": [
        {
          "index": 0,
          "text": "母親は「とんでもございません。",
          "start_ms": 242680,
          "end_ms": 245754,
          "duration_ms": 3074
        }
      ]
    },
    {
      "index": 47,
      "text": "あまりにも汚くて、お目にかかりませんよ。",
      "start_ms": 246254,
      "end_ms": 251212,
      "duration_ms": 4958,
      "clauses": [
        {
          "index": 0,
          "text": "あまりにも汚くて、",
          "start_ms": 246254,
          "end_ms": 248631,
          "duration_ms": 2377
        },
        {
          "index": 1,
          "text": "お目にかかりませんよ。",
          "start_ms": 248881,
          "end_ms": 251212,
          "duration_ms": 2331
        }
      ]
    },
    {
      "index": 48,
      "text": "」と答えました。",
      "start_ms": 251712,
      "end_ms": 253543,
      "duration_ms": 1831,
      "clauses": [
        {
          "index": 0,
          "text": "」と答えました。",
          "start_ms": 251712,
          "end_ms": 253543,
          "duration_ms": 1831
        }
      ]
    },
    {
      "index": 49,
      "text": "でも、おうじあくまで言い張ったので、シンデレラを呼ばなければなりませんでした。",
      "start_ms": 254043,
      "end_ms": 261883,
      "duration_ms": 7840,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 254043,
          "end_ms": 255027,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "おうじあくまで言い張ったので、",
          "start_ms": 255277,
          "end_ms": 257979,
          "duration_ms": 2702
        },
        {
          "index": 2,
          "text": "シンデレラを呼ばなければなりませんでした。",
          "start_ms": 258229,
          "end_ms": 261883,
          "duration_ms": 3654
        }
      ]
    },
    {
      "index": 50,
      "text": "娘はまず両手と顔を洗ってきれいにし、おうじの前に行ってお辞儀をしました。",
      "start_ms": 262383,
      "end_ms": 270267,
      "duration_ms": 7884,
      "clauses": [
        {
          "index": 0,
          "text": "娘はまず両手と顔を洗ってきれいにし、",
          "start_ms": 262383,
          "end_ms": 266711,
          "duration_ms": 4328
        },
        {
          "index": 1,
          "text": "おうじの前に行ってお辞儀をしました。",
          "start_ms": 266961,
          "end_ms": 270267,
          "duration_ms": 3306
        }
      ]
    },
    {
      "index": 51,
      "text": "おうじは娘に金の靴を渡しました。",
      "start_ms": 270767,
      "end_ms": 274642,
      "duration_ms": 3875,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘に金の靴を渡しました。",
          "start_ms": 270767,
          "end_ms": 274642,
          "duration_ms": 3875
        }
      ]
    },
    {
      "index": 52,
      "text": "娘は足載せ台に座って、重い木の靴から足を出して、うわぐつを履きました。",
      "start_ms": 275142,
      "end_ms": 284445,
      "duration_ms": 9303,
      "clauses": [
        {
          "index": 0,
          "text": "娘は足載せ台に座って、",
          "start_ms": 275142,
          "end_ms": 278355,
          "duration_ms": 3213
        },
        {
          "index": 1,
          "text": "重い木の靴から足を出して、",
          "start_ms": 278605,
          "end_ms": 281830,
          "duration_ms": 3225
        },
        {
          "index": 2,
          "text": "うわぐつを履きました。",
          "start_ms": 282080,
          "end_ms": 284445,
          "duration_ms": 2365
        }
      ]
    },
    {
      "index": 53,
      "text": "ぴったり合いました。",
      "start_ms": 284945,
      "end_ms": 287043,
      "duration_ms": 2098,
      "clauses": [
        {
          "index": 0,
          "text": "ぴったり合いました。",
          "start_ms": 284945,
          "end_ms": 287043,
          "duration_ms": 2098
        }
      ]
    },
    {
      "index": 54,
      "text": "娘が立ち上がると、おうじはその顔を見て、自分が踊ったうつくしい娘だと分かりました。",
      "start_ms": 287543,
      "end_ms": 297299,
      "duration_ms": 9756,
      "clauses": [
        {
          "index": 0,
          "text": "娘が立ち上がると、",
          "start_ms": 287543,
          "end_ms": 289932,
          "duration_ms": 2389
        },
        {
          "index": 1,
          "text": "おうじはその顔を見て、",
          "start_ms": 290182,
          "end_ms": 292733,
          "duration_ms": 2551
        },
        {
          "index": 2,
          "text": "自分が踊ったうつくしい娘だと分かりました。",
          "start_ms": 292983,
          "end_ms": 297299,
          "duration_ms": 4316
        }
      ]
    },
    {
      "index": 55,
      "text": "「この人が本当のはなよめだ！",
      "start_ms": 297799,
      "end_ms": 300849,
      "duration_ms": 3050,
      "clauses": [
        {
          "index": 0,
          "text": "「この人が本当のはなよめだ！",
          "start_ms": 297799,
          "end_ms": 300849,
          "duration_ms": 3050
        }
      ]
    },
    {
      "index": 56,
      "text": "」と叫びました。",
      "start_ms": 301349,
      "end_ms": 303320,
      "duration_ms": 1971,
      "clauses": [
        {
          "index": 0,
          "text": "」と叫びました。",
          "start_ms": 301349,
          "end_ms": 303320,
          "duration_ms": 1971
        }
      ]
    },
    {
      "index": 57,
      "text": "ままははと二人の姉たちは恐ろしくなって、怒りで青ざめました。",
      "start_ms": 303820,
      "end_ms": 310763,
      "duration_ms": 6943,
      "clauses": [
        {
          "index": 0,
          "text": "ままははと二人の姉たちは恐ろしくなって、",
          "start_ms": 303820,
          "end_ms": 308020,
          "duration_ms": 4200
        },
        {
          "index": 1,
          "text": "怒りで青ざめました。",
          "start_ms": 308270,
          "end_ms": 310763,
          "duration_ms": 2493
        }
      ]
    },
    {
      "index": 58,
      "text": "おうじはシンデレラを馬に乗せて、一緒に去りました。",
      "start_ms": 311263,
      "end_ms": 316998,
      "duration_ms": 5735,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはシンデレラを馬に乗せて、",
          "start_ms": 311263,
          "end_ms": 314557,
          "duration_ms": 3294
        },
        {
          "index": 1,
          "text": "一緒に去りました。",
          "start_ms": 314807,
          "end_ms": 316998,
          "duration_ms": 2191
        }
      ]
    },
    {
      "index": 59,
      "text": "はしばみの木のそばを通ると、二羽の白いはとが叫びました。",
      "start_ms": 317498,
      "end_ms": 323988,
      "duration_ms": 6490,
      "clauses": [
        {
          "index": 0,
          "text": "はしばみの木のそばを通ると、",
          "start_ms": 317498,
          "end_ms": 320537,
          "duration_ms": 3039
        },
        {
          "index": 1,
          "text": "二羽の白いはとが叫びました。",
          "start_ms": 320787,
          "end_ms": 323988,
          "duration_ms": 3201
        }
      ]
    },
    {
      "index": 60,
      "text": "「振り向いて覗いてごらん。",
      "start_ms": 324488,
      "end_ms": 327039,
      "duration_ms": 2551,
      "clauses": [
        {
          "index": 0,
          "text": "「振り向いて覗いてごらん。",
          "start_ms": 324488,
          "end_ms": 327039,
          "duration_ms": 2551
        }
      ]
    },
    {
      "index": 61,
      "text": "振り向いて覗いてごらん。",
      "start_ms": 327539,
      "end_ms": 330067,
      "duration_ms": 2528,
      "clauses": [
        {
          "index": 0,
          "text": "振り向いて覗いてごらん。",
          "start_ms": 327539,
          "end_ms": 330067,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 62,
      "text": "靴に血がついていないよ。",
      "start_ms": 330567,
      "end_ms": 333130,
      "duration_ms": 2563,
      "clauses": [
        {
          "index": 0,
          "text": "靴に血がついていないよ。",
          "start_ms": 330567,
          "end_ms": 333130,
          "duration_ms": 2563
        }
      ]
    },
    {
      "index": 63,
      "text": "靴は小さすぎない。",
      "start_ms": 333630,
      "end_ms": 336065,
      "duration_ms": 2435,
      "clauses": [
        {
          "index": 0,
          "text": "靴は小さすぎない。",
          "start_ms": 333630,
          "end_ms": 336065,
          "duration_ms": 2435
        }
      ]
    },
    {
      "index": 64,
      "text": "本当のはなよめがあなたと一緒だよ。",
      "start_ms": 336565,
      "end_ms": 340417,
      "duration_ms": 3852,
      "clauses": [
        {
          "index": 0,
          "text": "本当のはなよめがあなたと一緒だよ。",
          "start_ms": 336565,
          "end_ms": 340417,
          "duration_ms": 3852
        }
      ]
    },
    {
      "index": 65,
      "text": "」 二羽は降りってきて、シンデレラの肩に止まりました。",
      "start_ms": 340917,
      "end_ms": 346629,
      "duration_ms": 5712,
      "clauses": [
        {
          "index": 0,
          "text": "」 二羽は降りってきて、",
          "start_ms": 340917,
          "end_ms": 343329,
          "duration_ms": 2412
        },
        {
          "index": 1,
          "text": "シンデレラの肩に止まりました。",
          "start_ms": 343579,
          "end_ms": 346629,
          "duration_ms": 3050
        }
      ]
    },
    {
      "index": 66,
      "text": "一羽が右に、もう一羽が左に、そのまま座ったままになりました。",
      "start_ms": 347129,
      "end_ms": 354911,
      "duration_ms": 7782,
      "clauses": [
        {
          "index": 0,
          "text": "一羽が右に、",
          "start_ms": 347129,
          "end_ms": 348949,
          "duration_ms": 1820
        },
        {
          "index": 1,
          "text": "もう一羽が左に、",
          "start_ms": 349199,
          "end_ms": 351425,
          "duration_ms": 2226
        },
        {
          "index": 2,
          "text": "そのまま座ったままになりました。",
          "start_ms": 351675,
          "end_ms": 354911,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 67,
      "text": "おうじのけっこんしきが行われることになりました。",
      "start_ms": 355411,
      "end_ms": 359739,
      "duration_ms": 4328,
      "clauses": [
        {
          "index": 0,
          "text": "おうじのけっこんしきが行われることになりました。",
          "start_ms": 355411,
          "end_ms": 359739,
          "duration_ms": 4328
        }
      ]
    },
    {
      "index": 68,
      "text": "二人の不実な姉たちがやってきて、シンデレラの機嫌をとり、幸せを分けてもらおうとしました。",
      "start_ms": 360239,
      "end_ms": 370100,
      "duration_ms": 9861,
      "clauses": [
        {
          "index": 0,
          "text": "二人の不実な姉たちがやってきて、",
          "start_ms": 360239,
          "end_ms": 363615,
          "duration_ms": 3376
        },
        {
          "index": 1,
          "text": "シンデレラの機嫌をとり、",
          "start_ms": 363865,
          "end_ms": 366474,
          "duration_ms": 2609
        },
        {
          "index": 2,
          "text": "幸せを分けてもらおうとしました。",
          "start_ms": 366724,
          "end_ms": 370100,
          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 69,
      "text": "きょうかいに行ったとき、姉は右側に、妹は左側にいました。",
      "start_ms": 370600,
      "end_ms": 378255,
      "duration_ms": 7655,
      "clauses": [
        {
          "index": 0,
          "text": "きょうかいに行ったとき、",
          "start_ms": 370600,
          "end_ms": 372815,
          "duration_ms": 2215
        },
        {
          "index": 1,
          "text": "姉は右側に、",
          "start_ms": 373065,
          "end_ms": 375094,
          "duration_ms": 2029
        },
        {
          "index": 2,
          "text": "妹は左側にいました。",
          "start_ms": 375344,
          "end_ms": 378255,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 70,
      "text": "はとたちがそれぞれから片目をつついて取り出しました。",
      "start_ms": 378755,
      "end_ms": 383547,
      "duration_ms": 4792,
      "clauses": [
        {
          "index": 0,
          "text": "はとたちがそれぞれから片目をつついて取り出しました。",
          "start_ms": 378755,
          "end_ms": 383547,
          "duration_ms": 4792
        }
      ]
    },
    {
      "index": 71,
      "text": "帰りには姉が左、妹が右になったので、はとたちはそれぞれからもう一つの目をつついて取り出しました。",
      "start_ms": 384047,
      "end_ms": 395336,
      "duration_ms": 11289,
      "clauses": [
        {
          "index": 0,
          "text": "帰りには姉が左、",
          "start_ms": 384047,
          "end_ms": 386796,
          "duration_ms": 2749
        },
        {
          "index": 1,
          "text": "妹が右になったので、",
          "start_ms": 387046,
          "end_ms": 389632,
          "duration_ms": 2586
        },
        {
          "index": 2,
          "text": "はとたちはそれぞれからもう一つの目をつついて取り出しました。",
          "start_ms": 389882,
          "end_ms": 395336,
          "duration_ms": 5454
        }
      ]
    },
    {
      "index": 72,
      "text": "こうして、いじわるとふせいじつな二人は、ばつを受けて、しょうがい目が見えないままでした。",
      "start_ms": 395836,
      "end_ms": 405804,
      "duration_ms": 9968,
      "clauses": [
        {
          "index": 0,
          "text": "こうして、",
          "start_ms": 395836,
          "end_ms": 397249,
          "duration_ms": 1413
        },
        {
          "index": 1,
          "text": "いじわるとふせいじつな二人は、",
          "start_ms": 397499,
          "end_ms": 400468,
          "duration_ms": 2969
        },
        {
          "index": 2,
          "text": "ばつを受けて、",
          "start_ms": 400718,
          "end_ms": 402538,
          "duration_ms": 1820
        },
        {
          "index": 3,
          "text": "しょうがい目が見えないままでした。",
          "start_ms": 402788,
          "end_ms": 405804,
          "duration_ms": 3016
        }
      ]
    }
  ]
}