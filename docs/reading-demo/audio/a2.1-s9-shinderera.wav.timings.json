{
  "audio_file": "a2.1-s9-shinderera.wav",
  "sample_rate": 44100,
  "pause_ms": 500,
  "total_duration_ms": 130954,
  "sentences": [
    {
      "index": 0,
      "text": "シンデレラの靴",
      "start_ms": 0,
      "end_ms": 2171,
      "duration_ms": 2171
    },
    {
      "index": 1,
      "text": "むかし、シンデレラという女の子がいました。",
      "start_ms": 2671,
      "end_ms": 6758,
      "duration_ms": 4087
    },
    {
      "index": 2,
      "text": "シンデレラの母が死んだとき、シンデレラは寂しかったです。",
      "start_ms": 7258,
      "end_ms": 12541,
      "duration_ms": 5283
    },
    {
      "index": 3,
      "text": "それから、父の家に継母と二人の女の子が来ました。",
      "start_ms": 13041,
      "end_ms": 18626,
      "duration_ms": 5585
    },
    {
      "index": 4,
      "text": "継母と二人の女の子はシンデレラに親切ではありませんでした。",
      "start_ms": 19126,
      "end_ms": 25384,
      "duration_ms": 6258
    },
    {
      "index": 5,
      "text": "シンデレラは毎日掃除したり、洗濯したりしました。",
      "start_ms": 25884,
      "end_ms": 31295,
      "duration_ms": 5411
    },
    {
      "index": 6,
      "text": "それから、服も作りました。",
      "start_ms": 31795,
      "end_ms": 34779,
      "duration_ms": 2984
    },
    {
      "index": 7,
      "text": "シンデレラはとても忙しかったです。",
      "start_ms": 35279,
      "end_ms": 38994,
      "duration_ms": 3715
    },
    {
      "index": 8,
      "text": "そして、寂しかったです。",
      "start_ms": 39494,
      "end_ms": 42524,
      "duration_ms": 3030
    },
    {
      "index": 9,
      "text": "ある日、王子の家で大きいパーティーがありました。",
      "start_ms": 43024,
      "end_ms": 47483,
      "duration_ms": 4459
    },
    {
      "index": 10,
      "text": "町の女の子はみんな、パーティーに行きました。",
      "start_ms": 47983,
      "end_ms": 52383,
      "duration_ms": 4400
    },
    {
      "index": 11,
      "text": "シンデレラも行きたいと思いました。",
      "start_ms": 52883,
      "end_ms": 56215,
      "duration_ms": 3332
    },
    {
      "index": 12,
      "text": "でも、継母は「服も靴もありませんから、行きません」と言っていました。",
      "start_ms": 56715,
      "end_ms": 62451,
      "duration_ms": 5736
    },
    {
      "index": 13,
      "text": "夜、白い鳥が来ました。",
      "start_ms": 62951,
      "end_ms": 65633,
      "duration_ms": 2682
    },
    {
      "index": 14,
      "text": "鳥はシンデレラに素敵な服と靴をくれました。",
      "start_ms": 66133,
      "end_ms": 70893,
      "duration_ms": 4760
    },
    {
      "index": 15,
      "text": "シンデレラは鳥から服と靴をもらって、パーティーへ行きました。",
      "start_ms": 71393,
      "end_ms": 76954,
      "duration_ms": 5561
    },
    {
      "index": 16,
      "text": "王子はシンデレラを見て、一番素敵だと思いました。",
      "start_ms": 77454,
      "end_ms": 82307,
      "duration_ms": 4853
    },
    {
      "index": 17,
      "text": "王子はシンデレラとだけ踊りました。",
      "start_ms": 82807,
      "end_ms": 86511,
      "duration_ms": 3704
    },
    {
      "index": 18,
      "text": "シンデレラは帰るとき、靴をなくしました。",
      "start_ms": 87011,
      "end_ms": 90901,
      "duration_ms": 3890
    },
    {
      "index": 19,
      "text": "次の日、王子は町の女の子に会いました。",
      "start_ms": 91401,
      "end_ms": 95918,
      "duration_ms": 4517
    },
    {
      "index": 20,
      "text": "そして、みんなに靴を履きました。",
      "start_ms": 96418,
      "end_ms": 100006,
      "duration_ms": 3588
    },
    {
      "index": 21,
      "text": "継母の女の子も靴を履きましたが、足が入りませんでした。",
      "start_ms": 100506,
      "end_ms": 106462,
      "duration_ms": 5956
    },
    {
      "index": 22,
      "text": "シンデレラが靴を履くと、足が入りました。",
      "start_ms": 106962,
      "end_ms": 110956,
      "duration_ms": 3994
    },
    {
      "index": 23,
      "text": "それはシンデレラの靴でした。",
      "start_ms": 111456,
      "end_ms": 114881,
      "duration_ms": 3425
    },
    {
      "index": 24,
      "text": "王子は「シンデレラ、私と結婚しませんか」と言いました。",
      "start_ms": 115381,
      "end_ms": 120432,
      "duration_ms": 5051
    },
    {
      "index": 25,
      "text": "シンデレラは楽しかったです。",
      "start_ms": 120932,
      "end_ms": 124148,
      "duration_ms": 3216
    },
    {
      "index": 26,
      "text": "二人は結婚しました。",
      "start_ms": 124648,
      "end_ms": 127400,
      "duration_ms": 2752
    },
    {
      "index": 27,
      "text": "そして、楽しく住みました。",
      "start_ms": 127900,
      "end_ms": 130954,
      "duration_ms": 3054
    }
  ]
}