          "start_ms": 47010,
          "end_ms": 49228,
          "duration_ms": 2218
        }
      ]
    },
    {
      "index": 9,
      "text": "ある日、王子の家で大きいパーティーがありました。",
      "start_ms": 49728,
      "end_ms": 55540,
      "duration_ms": 5812,
      "clauses": [
        {
          "index": 0,
          "text": "ある日、",
          "start_ms": 49728,
          "end_ms": 51377,
          "duration_ms": 1649
        },
        {
          "index": 1,
