          "start_ms": 0,
          "end_ms": 2195,
          "duration_ms": 2195
        }
      ]
    },
    {
      "index": 1,
      "text": "むかし、シンデレラという女の子がいました。",
      "start_ms": 2695,
      "end_ms": 8054,
      "duration_ms": 5359,
      "clauses": [
        {
          "index": 0,
          "text": "むかし、",
          "start_ms": 2695,
          "end_ms": 4170,
          "duration_ms": 1475
        },
        {
          "index": 1,
          "text": "シンデレラという女の子がいました。",
          "start_ms": 4420,
          "end_ms": 8054,
          "duration_ms": 3634
        }
      ]
    },
    {
      "index": 2,
      "text": "シンデレラの母が死んだとき、シンデレラは寂しかったです。",
      "start_ms": 8554,
      "end_ms": 15225,
      "duration_ms": 6671,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラの母が死んだとき、",
          "start_ms": 8554,
          "end_ms": 11654,
          "duration_ms": 3100
        },
        {
          "index": 1,
          "text": "シンデレラは寂しかったです。",
          "start_ms": 11904,
          "end_ms": 15225,
          "duration_ms": 3321
        }
      ]
    },
    {
      "index": 3,
      "text": "それから、父の家に継母と二人の女の子が来ました。",
      "start_ms": 15725,
      "end_ms": 22407,
      "duration_ms": 6682,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 15725,
          "end_ms": 17385,
          "duration_ms": 1660
        },
        {
          "index": 1,
          "text": "父の家に継母と二人の女の子が来ました。",
          "start_ms": 17635,
          "end_ms": 22407,
          "duration_ms": 4772
        }
      ]
    },
    {
      "index": 4,
      "text": "継母と二人の女の子はシンデレラに親切ではありませんでした。",
      "start_ms": 22907,
      "end_ms": 29014,
      "duration_ms": 6107,
      "clauses": [
        {
          "index": 0,
          "text": "継母と二人の女の子はシンデレラに親切ではありませんでした。",
          "start_ms": 22907,
          "end_ms": 29014,
          "duration_ms": 6107
        }
      ]
    },
    {
      "index": 5,
      "text": "シンデレラは毎日掃除したり、洗濯したりしました。",
      "start_ms": 29514,
      "end_ms": 35953,
      "duration_ms": 6439,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラは毎日掃除したり、",
          "start_ms": 29514,
          "end_ms": 33102,
          "duration_ms": 3588
        },
        {
          "index": 1,
          "text": "洗濯したりしました。",
          "start_ms": 33352,
          "end_ms": 35953,
          "duration_ms": 2601
        }
      ]
    },
    {
      "index": 6,
      "text": "それから、服も作りました。",
      "start_ms": 36453,
      "end_ms": 40616,
      "duration_ms": 4163,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 36453,
          "end_ms": 38102,
          "duration_ms": 1649
        },
        {
          "index": 1,
          "text": "服も作りました。",
          "start_ms": 38352,
          "end_ms": 40616,
          "duration_ms": 2264
        }
      ]
    },
    {
      "index": 7,
      "text": "シンデレラはとても忙しかったです。",
      "start_ms": 41116,
      "end_ms": 44843,
      "duration_ms": 3727,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラはとても忙しかったです。",
          "start_ms": 41116,
          "end_ms": 44843,
          "duration_ms": 3727
        }
      ]
    },
    {
      "index": 8,
      "text": "そして、寂しかったです。",
      "start_ms": 45343,
      "end_ms": 49228,
      "duration_ms": 3885,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 45343,
          "end_ms": 46760,
          "duration_ms": 1417
        },
        {
          "index": 1,
