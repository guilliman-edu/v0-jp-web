84614, "end_ms": 186968, "duration_ms": 2354}]}, {"index": 47, "text": "「うそをつきません。", "start_ms": 187468, "end_ms": 189485, "duration_ms": 2017, "clauses": [{"index": 0, "text": "「うそをつきません。", "start_ms": 187468, "end_ms": 189485, "duration_ms": 2017}]}, {"index": 48, "text": "けさ、たけちよは『あのすずめはかわいい』といっていました。", "start_ms": 189985, "end_ms": 195593, "duration_ms": 5608, "clauses": [{"index": 0, "text": "けさ、", "start_ms": 189985, "end_ms": 191004, "duration_ms": 1019}, {"index": 1, "text": "たけちよは『あのすずめはかわいい』といっていました。", "start_ms": 191254, "end_ms": 195593, "duration_ms": 4339}]}, {"index": 49, "text": "わたしはよるにのぼって、すずめをとりました。", "start_ms": 196093, "end_ms": 201341, "duration_ms": 5248, "clauses": [{"index": 0, "text": "わたしはよるにのぼって、", "start_ms": 196093, "end_ms": 198865, "duration_ms": 2772}, {"index": 1, "text": "すずめをとりました。", "start_ms": 199115, "end_ms": 201341, "duration_ms": 2226}]}, {"index": 50, "text": "でも、したにころびました。", "start_ms": 201841, "end_ms": 205127, "duration_ms": 3286, "clauses": [{"index": 0, "text": "でも、", "start_ms": 201841, "end_ms": 202825, "duration_ms": 984}, {"index": 1, "text": "したにころびました。", "start_ms": 203075, "end_ms": 205127, "duration_ms": 2052}]}, {"index": 51, "text": "もう、うそをつきません。", "start_ms": 205627, "end_ms": 208762, "duration_ms": 3135, "clauses": [{"index": 0, "text": "もう、", "start_ms": 205627, "end_ms": 206483, "duration_ms": 856}, {"index": 1, "text": "うそをつきません。", "start_ms": 206733, "end_ms": 208762, "duration_ms": 2029}]}, {"index": 52, "text": "わたしがわるいのです。", "start_ms": 209262, "end_ms": 211558, "duration_ms": 2296, "clauses": [{"index": 0, "text": "わたしがわるいのです。", "start_ms": 209262, "end_ms": 211558, "duration_ms": 2296}]}, {"index": 53, "text": "しょうぐんはなにをしてもいいです。", "start_ms": 212058, "end_ms": 215132, "duration_ms": 3074, "clauses": [{"index": 0, "text": "しょうぐんはなにをしてもいいです。", "start_ms": 212058, "end_ms": 215132, "duration_ms": 3074}]}, {"index": 54, "text": "」\n\nおくさんはいいました。", "start_ms": 215632, "end_ms": 217951, "duration_ms": 2319, "clauses": [{"index": 0, "text": "」\n\nおくさんはいいました。", "start_ms": 215632, "end_ms": 217951, "duration_ms": 2319}]}, {"index": 55, "text": "「ごめんなさい。", "start_ms": 218451, "end_ms": 220236, "duration_ms": 1785, "clauses": [{"index": 0, "text": "「ごめんなさい。", "start_ms": 218451, "end_ms": 220236, "duration_ms": 1785}]}, {"index": 56, "text": "でも、わるいのはたけちよです。", "start_ms": 220736, "end_ms": 224660, "duration_ms": 3924, "clauses": [{"index": 0, "text": "でも、", "start_ms": 220736, "end_ms": 221708, "duration_ms": 972}, {"index": 1, "text": "わるいのはたけちよです。", "start_ms": 221958, "end_ms": 224660, "duration_ms": 2702}]}, {"index": 57, "text": "たけちよがチョウシロウに、いったのです。", "start_ms": 225160, "end_ms": 229630, "duration_ms": 4470, "clauses": [{"index": 0, "text": "たけちよがチョウシロウに、", "start_ms": 225160, "end_ms": 227630, "duration_ms": 2470}, {"index": 1, "text": "いったのです。", "start_ms": 227880, "end_ms": 229630, "duration_ms": 1750}]}, {"index": 58, "text": "」おくさんにはふたりのおこさんがいました。", "start_ms": 230130, "end_ms": 233854, "duration_ms": 3724, "clauses": [{"index": 0, "text": "」おくさんにはふたりのおこさんがいました。", "start_ms": 230130, "end_ms": 233854, "duration_ms": 3724}]}, {"index": 59, "text": "たけちよはうえのおこさんでした。", "start_ms": 234354, "end_ms": 237695, "duration_ms": 3341, "clauses": [{"index": 0, "text": "たけちよはうえのおこさんでした。", "start_ms": 234354, "end_ms": 237695, "duration_ms": 3341}]}, {"index": 60, "text": "おくさんはしたのおこさんがすきでした。", "start_ms": 238195, "end_ms": 241768, "duration_ms": 3573, "clauses": [{"index": 0, "text": "おくさんはしたのおこさんがすきでした。", "start_ms": 238195, "end_ms": 241768, "duration_ms": 3573}]}, {"index": 61, "text": "いつも、たけちよのわるいところをしょうぐんにいいました。", "start_ms": 242268, "end_ms": 247539, "duration_ms": 5271, "clauses": [{"index": 0, "text": "いつも、", "start_ms": 242268, "end_ms": 243565, "duration_ms": 1297}, {"index": 1, "text": "たけちよのわるいところをしょうぐんにいいました。", "start_ms": 243815, "end_ms": 247539, "duration_ms": 3724}]}, {"index": 62, "text": "しょうぐんはいいました。", "start_ms": 248039, "end_ms": 250277, "duration_ms": 2238, "clauses": [{"index": 0, "text": "しょうぐんはいいました。", "start_ms": 248039, "end_ms": 250277, "duration_ms": 2238}]}, {"index": 63, "text": "「たけちよはわるいです。", "start_ms": 250777, "end_ms": 253154, "duration_ms": 2377, "clauses": [{"index": 0, "text": "「たけちよはわるいです。", "start_ms": 250777, "end_ms": 253154, "duration_ms": 2377}]}, {"index": 64, "text": "チョウシロウに、ひどいことをいったのです。", "start_ms": 253654, "end_ms": 258148, "duration_ms": 4494, "clauses": [{"index": 0, "text": "チョウシロウに、", "start_ms": 253654, "end_ms": 255416, "duration_ms": 1762}, {"index": 1, "text": "ひどいことをいったのです。", "start_ms": 255666, "end_ms": 258148, "duration_ms": 2482}]}, {"index": 65, "text": "チョウシロウ、それはうそですか。", "start_ms": 258648, "end_ms": 262549, "duration_ms": 3901, "clauses": [{"index": 0, "text": "チョウシロウ、", "start_ms": 258648, "end_ms": 260108, "duration_ms": 1460}, {"index": 1, "text": "それはうそですか。", "start_ms": 260358, "end_ms": 262549, "duration_ms": 2191}]}, {"index": 66, "text": "たけちよがいったのですか。", "start_ms": 263049, "end_ms": 265681, "duration_ms": 2632, "clauses": [{"index": 0, "text": "たけちよがいったのですか。", "start_ms": 263049, "end_ms": 265681, "duration_ms": 2632}]}, {"index": 67, "text": "」チョウシロウはおもいました。", "start_ms": 266181, "end_ms": 268813, "duration_ms": 2632, "clauses": [{"index": 0, "text": "」チョウシロウはおもいました。", "start_ms": 266181, "end_ms": 268813, "duration_ms": 2632}]}, {"index": 68, "text": "しょうぐんはたけちよのことを、もうよくおもっていません。", "start_ms": 269313, "end_ms": 274746, "duration_ms": 5433, "clauses": [{"index": 0, "text": "しょうぐんはたけちよのことを、", "start_ms": 269313, "end_ms": 272096, "duration_ms": 2783}, {"index": 1, "text": "もうよくおもっていません。", "start_ms": 272346, "end_ms": 274746, "duration_ms": 2400}]}, {"index": 69, "text": "わたしは、たけちよをおもって、うそをつくのです。", "start_ms": 275246, "end_ms": 281415, "duration_ms": 6169, "clauses": [{"index": 0, "text": "わたしは、", "start_ms": 275246, "end_ms": 276776, "duration_ms": 1530}, {"index": 1, "text": "たけちよをおもって、", "start_ms": 277026, "end_ms": 279101, "duration_ms": 2075}, {"index": 2, "text": "うそをつくのです。", "start_ms": 279351, "end_ms": 281415, "duration_ms": 2064}]}, {"index": 70, "text": "チョウシロウはいいました。", "start_ms": 281915, "end_ms": 284269, "duration_ms": 2354, "clauses": [{"index": 0, "text": "チョウシロウはいいました。", "start_ms": 281915, "end_ms": 284269, "duration_ms": 2354}]}, {"index": 71, "text": "「それはうそではありません。", "start_ms": 284769, "end_ms": 287355, "duration_ms": 2586, "clauses": [{"index": 0, "text": "「それはうそではありません。", "start_ms": 284769, "end_ms": 287355, "duration_ms": 2586}]}, {"index": 72, "text": "たけちよはなにもいいませんでした。", "start_ms": 287855, "end_ms": 291172, "duration_ms": 3317, "clauses": [{"index": 0, "text": "たけちよはなにもいいませんでした。", "start_ms": 287855, "end_ms": 291172, "duration_ms": 3317}]}, {"index": 73, "text": "わたしが、じぶんでとりました。", "start_ms": 291672, "end_ms": 295678, "duration_ms": 4006, "clauses": [{"index": 0, "text": "わたしが、", "start_ms": 291672, "end_ms": 293225, "duration_ms": 1553}, {"index": 1, "text": "じぶんでとりました。", "start_ms": 293475, "end_ms": 295678, "duration_ms": 2203}]}, {"index": 74, "text": "たけちよにあげるすずめと、わたしのすずめを、わたしがとりました。", "start_ms": 296178, "end_ms": 303542, "duration_ms": 7364, "clauses": [{"index": 0, "text": "たけちよにあげるすずめと、", "start_ms": 296178, "end_ms": 298822, "duration_ms": 2644}, {"index": 1, "text": "わたしのすずめを、", "start_ms": 299072, "end_ms": 301054, "duration_ms": 1982}, {"index": 2, "text": "わたしがとりました。", "start_ms": 301304, "end_ms": 303542, "duration_ms": 2238}]}, {"index": 75, "text": "」\n\nしょうぐんはすごくおこりました。", "start_ms": 304042, "end_ms": 307174, "duration_ms": 3132, "clauses": [{"index": 0, "text": "」\n\nしょうぐんはすごくおこりました。", "start_ms": 304042, "end_ms": 307174, "duration_ms": 3132}]}, {"index": 76, "text": "「あなたはよくうそをつきます。", "start_ms": 307674, "end_ms": 310585, "duration_ms": 2911, "clauses": [{"index": 0, "text": "「あなたはよくうそをつきます。", "start_ms": 307674, "end_ms": 310585, "duration_ms": 2911}]}, {"index": 77, "text": "あなたは、こまっています。", "start_ms": 311085, "end_ms": 314626, "duration_ms": 3541, "clauses": [{"index": 0, "text": "あなたは、", "start_ms": 311085, "end_ms": 312568, "duration_ms": 1483}, {"index": 1, "text": "こまっています。", "start_ms": 312818, "end_ms": 314626, "duration_ms": 1808}]}, {"index": 78, "text": "あのかばんをとってください。", "start_ms": 315126, "end_ms": 317758, "duration_ms": 2632, "clauses": [{"index": 0, "text": "あのかばんをとってください。", "start_ms": 315126, "end_ms": 317758, "duration_ms": 2632}]}, {"index": 79, "text": "」しょうぐんはいいました。", "start_ms": 318258, "end_ms": 320496, "duration_ms": 2238, "clauses": [{"index": 0, "text": "」しょうぐんはいいました。", "start_ms": 318258, "end_ms": 320496, "duration_ms": 2238}]}, {"index": 80, "text": "「チョウシロウ、うそをつきますか。", "start_ms": 320996, "end_ms": 324851, "duration_ms": 3855, "clauses": [{"index": 0, "text": "「チョウシロウ、", "start_ms": 320996, "end_ms": 322491, "duration_ms": 1495}, {"index": 1, "text": "うそをつきますか。", "start_ms": 322741, "end_ms": 324851, "duration_ms": 2110}]}, {"index": 81, "text": "このかばんにはいれます。", "start_ms": 325351, "end_ms": 327809, "duration_ms": 2458, "clauses": [{"index": 0, "text": "このかばんにはいれます。", "start_ms": 325351, "end_ms": 327809, "duration_ms": 2458}]}, {"index": 82, "text": "もう、おいえにかえりません。", "start_ms": 328309, "end_ms": 331572, "duration_ms": 3263, "clauses": [{"index": 0, "text": "もう、", "start_ms": 328309, "end_ms": 329119, "duration_ms": 810}, {"index": 1, "text": "おいえにかえりません。", "start_ms": 329369, "end_ms": 331572, "duration_ms": 2203}]}, {"index": 83, "text": "たべものもあげません。", "start_ms": 332072, "end_ms": 334321, "duration_ms": 2249, "clauses": [{"index": 0, "text": "たべものもあげません。", "start_ms": 332072, "end_ms": 334321, "duration_ms": 2249}]}, {"index": 84, "text": "」チョウシロウはいいました。", "start_ms": 334821, "end_ms": 337163, "duration_ms": 2342, "clauses": [{"index": 0, "text": "」チョウシロウはいいました。", "start_ms": 334821, "end_ms": 337163, "duration_ms": 2342}]}, {"index": 85, "text": "「わたしはうそをつきません。", "start_ms": 337663, "end_ms": 340435, "duration_ms": 2772, "clauses": [{"index": 0, "text": "「わたしはうそをつきません。", "start_ms": 337663, "end_ms": 340435, "duration_ms": 2772}]}, {"index": 86, "text": "わたしがとりました。", "start_ms": 340935, "end_ms": 343161, "duration_ms": 2226, "clauses": [{"index": 0, "text": "わたしがとりました。", "start_ms": 340935, "end_ms": 343161, "duration_ms": 2226}]}, {"index": 87, "text": "だれもあしくありません。", "start_ms": 343661, "end_ms": 346259, "duration_ms": 2598, "clauses": [{"index": 0, "text": "だれもあしくありません。", "start_ms": 343661, "end_ms": 346259, "duration_ms": 2598}]}, {"index": 88, "text": "わたしがわるいのです。", "start_ms": 346759, "end_ms": 349055, "duration_ms": 2296, "clauses": [{"index": 0, "text": "わたしがわるいのです。", "start_ms": 346759, "end_ms": 349055, "duration_ms": 2296}]}, {"index": 89, "text": "よるにころんだのも、わたしがわるいからです。", "start_ms": 349555, "end_ms": 354409, "duration_ms": 4854, "clauses": [{"index": 0, "text": "よるにころんだのも、", "start_ms": 349555, "end_ms": 351677, "duration_ms": 2122}, {"index": 1, "text": "わたしがわるいからです。", "start_ms": 351927, "end_ms": 354409, "duration_ms": 2482}]}, {"index": 90, "text": "」そして、チョウシロウはじぶんでかばんにはいりました。", "start_ms": 354909, "end_ms": 360378, "duration_ms": 5469, "clauses": [{"index": 0, "text": "」そして、", "start_ms": 354909, "end_ms": 356218, "duration_ms": 1309}, {"index": 1, "text": "チョウシロウはじぶんでかばんにはいりました。", "start_ms": 356468, "end_ms": 360378, "duration_ms": 3910}]}, {"index": 91, "text": "しょうぐんはぶかにいいました。", "start_ms": 360878, "end_ms": 363580, "duration_ms": 2702, "clauses": [{"index": 0, "text": "しょうぐんはぶかにいいました。", "start_ms": 360878, "end_ms": 363580, "duration_ms": 2702}]}, {"index": 92, "text": "「かばんをしめてください。", "start_ms": 364080, "end_ms": 366469, "duration_ms": 2389, "clauses": [{"index": 0, "text": "「かばんをしめてください。", "start_ms": 364080, "end_ms": 366469, "duration_ms": 2389}]}, {"index": 93, "text": "」ぶかはかばんをしめて、にわにおきました。", "start_ms": 366969, "end_ms": 371602, "duration_ms": 4633, "clauses": [{"index": 0, "text": "」ぶかはかばんをしめて、", "start_ms": 366969, "end_ms": 369300, "duration_ms": 2331}, {"index": 1, "text": "にわにおきました。", "start_ms": 369550, "end_ms": 371602, "duration_ms": 2052}]}, {"index": 94, "text": "みんなはへやにもどりました。", "start_ms": 372102, "end_ms": 374943, "duration_ms": 2841, "clauses": [{"index": 0, "text": "みんなはへやにもどりました。", "start_ms": 372102, "end_ms": 374943, "duration_ms": 2841}]}, {"index": 95, "text": "チョウシロウはかばんのなかで、すずめをもっていました。", "start_ms": 375443, "end_ms": 381132, "duration_ms": 5689, "clauses": [{"index": 0, "text": "チョウシロウはかばんのなかで、", "start_ms": 375443, "end_ms": 378447, "duration_ms": 3004}, {"index": 1, "text": "すずめをもっていました。", "start_ms": 378697, "end_ms": 381132, "duration_ms": 2435}]}, {"index": 96, "text": "刀と自由", "start_ms": 381132, "end_ms": 382987, "duration_ms": 1855, "clauses": [{"index": 0, "text": "刀と自由", "start_ms": 381132, "end_ms": 382987, "duration_ms": 1855}]}, {"index": 97, "text": "つぎのひ、あさになって、おくさんはにわにいきました。", "start_ms": 383487, "end_ms": 390038, "duration_ms": 6551, "clauses": [{"index": 0, "text": "つぎのひ、", "start_ms": 383487, "end_ms": 385028, "duration_ms": 1541}, {"index": 1, "text": "あさになって、", "start_ms": 385278, "end_ms": 387063, "duration_ms": 1785}, {"index": 2, "text": "おくさんはにわにいきました。", "start_ms": 387313, "end_ms": 390038, "duration_ms": 2725}]}, {"index": 98, "text": "おくさんはかばんをしたろしました。", "start_ms": 390538, "end_ms": 393821, "duration_ms": 3283, "clauses": [{"index": 0, "text": "おくさんはかばんをしたろしました。", "start_ms": 390538, "end_ms": 393821, "duration_ms": 3283}]}, {"index": 99, "text": "なかからチョウシロウがでました。", "start_ms": 394321, "end_ms": 397313, "duration_ms": 2992, "clauses": [{"index": 0, "text": "なかからチョウシロウがでました。", "start_ms": 394321, "end_ms": 397313, "duration_ms": 2992}]}, {"index": 100, "text": "まだ、すずめをもっていました。", "start_ms": 397813, "end_ms": 401691, "duration_ms": 3878, "clauses": [{"index": 0, "text": "まだ、", "start_ms": 397813, "end_ms": 399029, "duration_ms": 1216}, {"index": 1, "text": "すずめをもっていました。", "start_ms": 399279, "end_ms": 401691, "duration_ms": 2412}]}, {"index": 101, "text": "おくさんはいいました。", "start_ms": 402191, "end_ms": 404406, "duration_ms": 2215, "clauses": [{"index": 0, "text": "おくさんはいいました。", "start_ms": 402191, "end_ms": 404406, "duration_ms": 2215}]}, {"index": 102, "text": "「たけちよが、すずめをとってくださいといったのです。", "start_ms": 404906, "end_ms": 410328, "duration_ms": 5422, "clauses": [{"index": 0, "text": "「たけちよが、", "start_ms": 404906, "end_ms": 406656, "duration_ms": 1750}, {"index": 1, "text": "すずめをとってくださいといったのです。", "start_ms": 406906, "end_ms": 410328, "duration_ms": 3422}]}, {"index": 103, "text": "」チョウシロウはいいました。", "start_ms": 410828, "end_ms": 413228, "duration_ms": 2400, "clauses": [{"index": 0, "text": "」チョウシロウはいいました。", "start_ms": 410828, "end_ms": 413228, "duration_ms": 2400}]}, {"index": 104, "text": "「それはうそではありません。", "start_ms": 413728, "end_ms": 416210, "duration_ms": 2482, "clauses": [{"index": 0, "text": "「それはうそではありません。", "start_ms": 413728, "end_ms": 416210, "duration_ms": 2482}]}, {"index": 105, "text": "わたしがとりました。", "start_ms": 416710, "end_ms": 418948, "duration_ms": 2238, "clauses": [{"index": 0, "text": "わたしがとりました。", "start_ms": 416710, "end_ms": 418948, "duration_ms": 2238}]}, {"index": 106, "text": "たけちよはなにもしていません。", "start_ms": 419448, "end_ms": 422417, "duration_ms": 2969, "clauses": [{"index": 0, "text": "たけちよはなにもしていません。", "start_ms": 419448, "end_ms": 422417, "duration_ms": 2969}]}, {"index": 107, "text": "」おくさんはいいました。", "start_ms": 422917, "end_ms": 425224, "duration_ms": 2307, "clauses": [{"index": 0, "text": "」おくさんはいいました。", "start_ms": 422917, "end_ms": 425224, "duration_ms": 2307}]}, {"index": 108, "text": "「あなたは、すごくこまっています。", "start_ms": 425724, "end_ms": 429718, "duration_ms": 3994, "clauses": [{"index": 0, "text": "「あなたは、", "start_ms": 425724, "end_ms": 427195, "duration_ms": 1471}, {"index": 1, "text": "すごくこまっています。", "start_ms": 427445, "end_ms": 429718, "duration_ms": 2273}]}, {"index": 109, "text": "ここにいつもいてください。", "start_ms": 430218, "end_ms": 432874, "duration_ms": 2656, "clauses": [{"index": 0, "text": "ここにいつもいてください。", "start_ms": 430218, "end_ms": 432874, "duration_ms": 2656}]}, {"index": 110, "text": "たべものもあげません。", "start_ms": 433374, "end_ms": 435693, "duration_ms": 2319, "clauses": [{"index": 0, "text": "たべものもあげません。", "start_ms": 433374, "end_ms": 435693, "duration_ms": 2319}]}, {"index": 111, "text": "うそをつかないでください。", "start_ms": 436193, "end_ms": 438733, "duration_ms": 2540, "clauses": [{"index": 0, "text": "うそをつかないでください。", "start_ms": 436193, "end_ms": 438733, "duration_ms": 2540}]}, {"index": 112, "text": "そして、ごはんをあげます。", "start_ms": 439233, "end_ms": 442902, "duration_ms": 3669, "clauses": [{"index": 0, "text": "そして、", "start_ms": 439233, "end_ms": 440623, "duration_ms": 1390}, {"index": 1, "text": "ごはんをあげます。", "start_ms": 440873, "end_ms": 442902, "duration_ms": 2029}]}, {"index": 113, "text": "」チョウシロウはいいました。", "start_ms": 443402, "end_ms": 445756, "duration_ms": 2354, "clauses": [{"index": 0, "text": "」チョウシロウはいいました。", "start_ms": 443402, "end_ms": 445756, "duration_ms": 2354}]}, {"index": 114, "text": "「たべものをください。", "start_ms": 446256, "end_ms": 448401, "duration_ms": 2145, "clauses": [{"index": 0, "text": "「たべものをください。", "start_ms": 446256, "end_ms": 448401, "duration_ms": 2145}]}, {"index": 115, "text": "おなかがあいています。", "start_ms": 448901, "end_ms": 451185, "duration_ms": 2284, "clauses": [{"index": 0, "text": "おなかがあいています。", "start_ms": 448901, "end_ms": 451185, "duration_ms": 2284}]}, {"index": 116, "text": "たべてから、はなします。", "start_ms": 451685, "end_ms": 455295, "duration_ms": 3610, "clauses": [{"index": 0, "text": "たべてから、", "start_ms": 451685, "end_ms": 453365, "duration_ms": 1680}, {"index": 1, "text": "はなします。", "start_ms": 453615, "end_ms": 455295, "duration_ms": 1680}]}, {"index": 117, "text": "」おくさんはべんとうをあげました。", "start_ms": 455795, "end_ms": 458787, "duration_ms": 2992, "clauses": [{"index": 0, "text": "」おくさんはべんとうをあげました。", "start_ms": 455795, "end_ms": 458787, "duration_ms": 2992}]}, {"index": 118, "text": "チョウシロウはべんとうをたべました。", "start_ms": 459287, "end_ms": 462616, "duration_ms": 3329, "clauses": [{"index": 0, "text": "チョウシロウはべんとうをたべました。", "start_ms": 459287, "end_ms": 462616, "duration_ms": 3329}]}, {"index": 119, "text": "チョウシロウはおれいをいいました。", "start_ms": 463116, "end_ms": 466248, "duration_ms": 3132, "clauses": [{"index": 0, "text": "チョウシロウはおれいをいいました。", "start_ms": 463116, "end_ms": 466248, "duration_ms": 3132}]}, {"index": 120, "text": "「もう、はなします。", "start_ms": 466748, "end_ms": 469476, "duration_ms": 2728, "clauses": [{"index": 0, "text": "「もう、", "start_ms": 466748, "end_ms": 467569, "duration_ms": 821}, {"index": 1, "text": "はなします。", "start_ms": 467819, "end_ms": 469476, "duration_ms": 1657}]}, {"index": 121, "text": "」おくさんはいいました。", "start_ms": 469976, "end_ms": 472249, "duration_ms": 2273, "clauses": [{"index": 0, "text": "」おくさんはいいました。", "start_ms": 469976, "end_ms": 472249, "duration_ms": 2273}]}, {"index": 122, "text": "「はやく、うそをつかないでください。", "start_ms": 472749, "end_ms": 476662, "duration_ms": 3913, "clauses": [{"index": 0, "text": "「はやく、", "start_ms": 472749, "end_ms": 473919, "duration_ms": 1170}, {"index": 1, "text": "うそをつかないでください。", "start_ms": 474169, "end_ms": 476662, "duration_ms": 2493}]}, {"index": 123, "text": "」チョウシロウはいいました。", "start_ms": 477162, "end_ms": 479504, "duration_ms": 2342, "clauses": [{"index": 0, "text": "」チョウシロウはいいました。", "start_ms": 477162, "end_ms": 479504, "duration_ms": 2342}]}, {"index": 124, "text": "「ごめんなさい。", "start_ms": 480004, "end_ms": 481766, "duration_ms": 1762, "clauses": [{"index": 0, "text": "「ごめんなさい。", "start_ms": 480004, "end_ms": 481766, "duration_ms": 1762}]}, {"index": 125, "text": "わたしがとりました。", "start_ms": 482266, "end_ms": 484492, "duration_ms": 2226, "clauses": [{"index": 0, "text": "わたしがとりました。", "start_ms": 482266, "end_ms": 484492, "duration_ms": 2226}]}, {"index": 126, "text": "たけちよはなにもしていません。", "start_ms": 484992, "end_ms": 487903, "duration_ms": 2911, "clauses": [{"index": 0, "text": "たけちよはなにもしていません。", "start_ms": 484992, "end_ms": 487903, "duration_ms": 2911}]}, {"index": 127, "text": "それが、うそではありません。", "start_ms": 488403, "end_ms": 492235, "duration_ms": 3832, "clauses": [{"index": 0, "text": "それが、", "start_ms": 488403, "end_ms": 489805, "duration_ms": 1402}, {"index": 1, "text": "うそではありません。", "start_ms": 490055, "end_ms": 492235, "duration_ms": 2180}]}, {"index": 128, "text": "」\n\nおくさんはすごくおこりました。", "start_ms": 492735, "end_ms": 495716, "duration_ms": 2981, "clauses": [{"index": 0, "text": "」\n\nおくさんはすごくおこりました。", "start_ms": 492735, "end_ms": 495716, "duration_ms": 2981}]}, {"index": 129, "text": "しょうぐんのへやにいきました。", "start_ms": 496216, "end_ms": 498883, "duration_ms": 2667, "clauses": [{"index": 0, "text": "しょうぐんのへやにいきました。", "start_ms": 496216, "end_ms": 498883, "duration_ms": 2667}]}, {"index": 130, "text": "そして、しょうぐんにいいました。", "start_ms": 499383, "end_ms": 503215, "duration_ms": 3832, "clauses": [{"index": 0, "text": "そして、", "start_ms": 499383, "end_ms": 500750, "duration_ms": 1367}, {"index": 1, "text": "しょうぐんにいいました。", "start_ms": 501000, "end_ms": 503215, "duration_ms": 2215}]}, {"index": 131, "text": "「チョウシロウは、たけちよをおもってうそをついています。", "start_ms": 503715, "end_ms": 509439, "duration_ms": 5724, "clauses": [{"index": 0, "text": "「チョウシロウは、", "start_ms": 503715, "end_ms": 505442, "duration_ms": 1727}, {"index": 1, "text": "たけちよをおもってうそをついています。", "start_ms": 505692, "end_ms": 509439, "duration_ms": 3747}]}, {"index": 132, "text": "」しょうぐんはすごくおこりました。", "start_ms": 509939, "end_ms": 513071, "duration_ms": 3132, "clauses": [{"index": 0, "text": "」しょうぐんはすごくおこりました。", "start_ms": 509939, "end_ms": 513071, "duration_ms": 3132}]}, {"index": 133, "text": "かたなをもちました。", "start_ms": 513571, "end_ms": 515774, "duration_ms": 2203, "clauses": [{"index": 0, "text": "かたなをもちました。", "start_ms": 513571, "end_ms": 515774, "duration_ms": 2203}]}, {"index": 134, "text": "「わたしはチョウシロウを、もうわれいえからだします。", "start_ms": 516274, "end_ms": 521301, "duration_ms": 5027, "clauses": [{"index": 0, "text": "「わたしはチョウシロウを、", "start_ms": 516274, "end_ms": 518523, "duration_ms": 2249}, {"index": 1, "text": "もうわれいえからだします。", "start_ms": 518773, "end_ms": 521301, "duration_ms": 2528}]}, {"index": 135, "text": "」そして、ぶかにいきました。", "start_ms": 521801, "end_ms": 525388, "duration_ms": 3587, "clauses": [{"index": 0, "text": "」そして、", "start_ms": 521801, "end_ms": 523191, "duration_ms": 1390}, {"index": 1, "text": "ぶかにいきました。", "start_ms": 523441, "end_ms": 525388, "duration_ms": 1947}]}, {"index": 136, "text": "ぶかにいいました。", "start_ms": 525888, "end_ms": 527870, "duration_ms": 1982, "clauses": [{"index": 0, "text": "ぶかにいいました。", "start_ms": 525888, "end_ms": 527870, "duration_ms": 1982}]}, {"index": 137, "text": "「あなたは、にわへいってください。", "start_ms": 528370, "end_ms": 532376, "duration_ms": 4006, "clauses": [{"index": 0, "text": "「あなたは、", "start_ms": 528370, "end_ms": 529888, "duration_ms": 1518}, {"index": 1, "text": "にわへいってください。", "start_ms": 530138, "end_ms": 532376, "duration_ms": 2238}]}, {"index": 138, "text": "」\n\nぶかはにわにいきました。", "start_ms": 532876, "end_ms": 535346, "duration_ms": 2470, "clauses": [{"index": 0, "text": "」\n\nぶかはにわにいきました。", "start_ms": 532876, "end_ms": 535346, "duration_ms": 2470}]}, {"index": 139, "text": "チョウシロウをみました。", "start_ms": 535846, "end_ms": 538119, "duration_ms": 2273, "clauses": [{"index": 0, "text": "チョウシロウをみました。", "start_ms": 535846, "end_ms": 538119, "duration_ms": 2273}]}, {"index": 140, "text": "「チョウシロウ、しょうぐんはすごくおこっています。", "start_ms": 538619, "end_ms": 543460, "duration_ms": 4841, "clauses": [{"index": 0, "text": "「チョウシロウ、", "start_ms": 538619, "end_ms": 540067, "duration_ms": 1448}, {"index": 1, "text": "しょうぐんはすごくおこっています。", "start_ms": 540317, "end_ms": 543460, "duration_ms": 3143}]}, {"index": 141, "text": "あなたはもう、じゆうではありません。", "start_ms": 543960, "end_ms": 548267, "duration_ms": 4307, "clauses": [{"index": 0, "text": "あなたはもう、", "start_ms": 543960, "end_ms": 545791, "duration_ms": 1831}, {"index": 1, "text": "じゆうではありません。", "start_ms": 546041, "end_ms": 548267, "duration_ms": 2226}]}, {"index": 142, "text": "おとうさんにつたえしようか。", "start_ms": 548767, "end_ms": 551492, "duration_ms": 2725, "clauses": [{"index": 0, "text": "おとうさんにつたえしようか。", "start_ms": 548767, "end_ms": 551492, "duration_ms": 2725}]}, {"index": 143, "text": "わたしは、おとうさんのともだちです。", "start_ms": 551992, "end_ms": 556346, "duration_ms": 4354, "clauses": [{"index": 0, "text": "わたしは、", "start_ms": 551992, "end_ms": 553510, "duration_ms": 1518}, {"index": 1, "text": "おとうさんのともだちです。", "start_ms": 553760, "end_ms": 556346, "duration_ms": 2586}]}, {"index": 144, "text": "」チョウシロウはいいました。", "start_ms": 556846, "end_ms": 559188, "duration_ms": 2342, "clauses": [{"index": 0, "text": "」チョウシロウはいいました。", "start_ms": 556846, "end_ms": 559188, "duration_ms": 2342}]}, {"index": 145, "text": "「いりません。", "start_ms": 559688, "end_ms": 561368, "duration_ms": 1680, "clauses": [{"index": 0, "text": "「いりません。", "start_ms": 559688, "end_ms": 561368, "duration_ms": 1680}]}, {"index": 146, "text": "おとうさんに、もうなにもいいたいことはありません。", "start_ms": 561868, "end_ms": 566825, "duration_ms": 4957, "clauses": [{"index": 0, "text": "おとうさんに、", "start_ms": 561868, "end_ms": 563583, "duration_ms": 1715}, {"index": 1, "text": "もうなにもいいたいことはありません。", "start_ms": 563833, "end_ms": 566825, "duration_ms": 2992}]}, {"index": 147, "text": "さむらいはたいせつなともだちをおもって、どんなことになってもいいです。", "start_ms": 567325, "end_ms": 574140, "duration_ms": 6815, "clauses": [{"index": 0, "text": "さむらいはたいせつなともだちをおもって、", "start_ms": 567325, "end_ms": 571118, "duration_ms": 3793}, {"index": 1, "text": "どんなことになってもいいです。", "start_ms": 571368, "end_ms": 574140, "duration_ms": 2772}]}, {"index": 148, "text": "しょうぐんがわたしになにをしたいのか、よくわかります。", "start_ms": 574640, "end_ms": 580190, "duration_ms": 5550, "clauses": [{"index": 0, "text": "しょうぐんがわたしになにをしたいのか、", "start_ms": 574640, "end_ms": 577981, "duration_ms": 3341}, {"index": 1, "text": "よくわかります。", "start_ms": 578231, "end_ms": 580190, "duration_ms": 1959}]}, {"index": 149, "text": "わたしがこのいえをでるとき、みんながしります。", "start_ms": 580690, "end_ms": 585927, "duration_ms": 5237, "clauses": [{"index": 0, "text": "わたしがこのいえをでるとき、", "start_ms": 580690, "end_ms": 583671, "duration_ms": 2981}, {"index": 1, "text": "みんながしります。", "start_ms": 583921, "end_ms": 585927, "duration_ms": 2006}]}, {"index": 150, "text": "わたしがうそをつかなかったこと、そしてたけちよをおもってうそをついたことも、みんながしります。", "start_ms": 586427, "end_ms": 596299, "duration_ms": 9872, "clauses": [{"index": 0, "text": "わたしがうそをつかなかったこと、", "start_ms": 586427, "end_ms": 589547, "duration_ms": 3120}, {"index": 1, "text": "そしてたけちよをおもってうそをついたことも、", "start_ms": 589797, "end_ms": 594032, "duration_ms": 4235}, {"index": 2, "text": "みんながしります。", "start_ms": 594282, "end_ms": 596299, "duration_ms": 2017}]}, {"index": 151, "text": "おとうさんにつたえることは、ひとつです。", "start_ms": 596799, "end_ms": 601315, "duration_ms": 4516, "clauses": [{"index": 0, "text": "おとうさんにつたえることは、", "start_ms": 596799, "end_ms": 599385, "duration_ms": 2586}, {"index": 1, "text": "ひとつです。", "start_ms": 599635, "end_ms": 601315, "duration_ms": 1680}]}, {"index": 152, "text": "『わたしはたいせつなともだちをおもって、このいえをでました。", "start_ms": 601815, "end_ms": 607899, "duration_ms": 6084, "clauses": [{"index": 0, "text": "『わたしはたいせつなともだちをおもって、", "start_ms": 601815, "end_ms": 605504, "duration_ms": 3689}, {"index": 1, "text": "このいえをでました。", "start_ms": 605754, "end_ms": 607899, "duration_ms": 2145}]}, {"index": 153, "text": "』わたしがかなしいのは、おやのびょうきです。", "start_ms": 608399, "end_ms": 613148, "duration_ms": 4749, "clauses": [{"index": 0, "text": "』わたしがかなしいのは、", "start_ms": 608399, "end_ms": 610753, "duration_ms": 2354}, {"index": 1, "text": "おやのびょうきです。", "start_ms": 611003, "end_ms": 613148, "duration_ms": 2145}]}, {"index": 154, "text": "これをきいて、おやのびょうきがひどくなります。", "start_ms": 613648, "end_ms": 618617, "duration_ms": 4969, "clauses": [{"index": 0, "text": "これをきいて、", "start_ms": 613648, "end_ms": 615398, "duration_ms": 1750}, {"index": 1, "text": "おやのびょうきがひどくなります。", "start_ms": 615648, "end_ms": 618617, "duration_ms": 2969}]}, {"index": 155, "text": "」ぶかはすごくかなしくなりました。", "start_ms": 619117, "end_ms": 622237, "duration_ms": 3120, "clauses": [{"index": 0, "text": "」ぶかはすごくかなしくなりました。", "start_ms": 619117, "end_ms": 622237, "duration_ms": 3120}]}, {"index": 156, "text": "そして、チョウシロウをしょうぐんのまえへつれていきました。", "start_ms": 622737, "end_ms": 628240, "duration_ms": 5503, "clauses": [{"index": 0, "text": "そして、", "start_ms": 622737, "end_ms": 624092, "duration_ms": 1355}, {"index": 1, "text": "チョウシロウをしょうぐんのまえへつれていきました。", "start_ms": 624342, "end_ms": 628240, "duration_ms": 3898}]}, {"index": 157, "text": "チョウシロウはすわりました。", "start_ms": 628740, "end_ms": 631431, "duration_ms": 2691, "clauses": [{"index": 0, "text": "チョウシロウはすわりました。", "start_ms": 628740, "end_ms": 631431, "duration_ms": 2691}]}, {"index": 158, "text": "かみをなしました。", "start_ms": 631931, "end_ms": 633890, "duration_ms": 1959, "clauses": [{"index": 0, "text": "かみをなしました。", "start_ms": 631931, "end_ms": 633890, "duration_ms": 1959}]}, {"index": 159, "text": "こわくないかおをして、しょうぐんをまちました。", "start_ms": 634390, "end_ms": 639278, "duration_ms": 4888, "clauses": [{"index": 0, "text": "こわくないかおをして、", "start_ms": 634390, "end_ms": 636686, "duration_ms": 2296}, {"index": 1, "text": "しょうぐんをまちました。", "start_ms": 636936, "end_ms": 639278, "duration_ms": 2342}]}, {"index": 160, "text": "しょうぐんはそのかおをみて、かたなをおきました。", "start_ms": 639778, "end_ms": 644991, "duration_ms": 5213, "clauses": [{"index": 0, "text": "しょうぐんはそのかおをみて、", "start_ms": 639778, "end_ms": 642573, "duration_ms": 2795}, {"index": 1, "text": "かたなをおきました。", "start_ms": 642823, "end_ms": 644991, "duration_ms": 2168}]}, {"index": 161, "text": "しょうぐんはいいました。", "start_ms": 645491, "end_ms": 647775, "duration_ms": 2284, "clauses": [{"index": 0, "text": "しょうぐんはいいました。", "start_ms": 645491, "end_ms": 647775, "duration_ms": 2284}]}, {"index": 162, "text": "「チョウシロウ、もういいです。", "start_ms": 648275, "end_ms": 651724, "duration_ms": 3449, "clauses": [{"index": 0, "text": "「チョウシロウ、", "start_ms": 648275, "end_ms": 649805, "duration_ms": 1530}, {"index": 1, "text": "もういいです。", "start_ms": 650055, "end_ms": 651724, "duration_ms": 1669}]}, {"index": 163, "text": "あなたはすごくいいこです。", "start_ms": 652224, "end_ms": 654938, "duration_ms": 2714, "clauses": [{"index": 0, "text": "あなたはすごくいいこです。", "start_ms": 652224, "end_ms": 654938, "duration_ms": 2714}]}, {"index": 164, "text": "わたしはあなたのことを、よくしりました。", "start_ms": 655438, "end_ms": 660268, "duration_ms": 4830, "clauses": [{"index": 0, "text": "わたしはあなたのことを、", "start_ms": 655438, "end_ms": 658036, "duration_ms": 2598}, {"index": 1, "text": "よくしりました。", "start_ms": 658286, "end_ms": 660268, "duration_ms": 1982}]}, {"index": 165, "text": "たけちよがしょうぐんになるとき、あなたは、いつもたけちよのそばにいてください。", "start_ms": 660768, "end_ms": 669050, "duration_ms": 8282, "clauses": [{"index": 0, "text": "たけちよがしょうぐんになるとき、", "start_ms": 660768, "end_ms": 663656, "duration_ms": 2888}, {"index": 1, "text": "あなたは、", "start_ms": 663906, "end_ms": 665436, "duration_ms": 1530}, {"index": 2, "text": "いつもたけちよのそばにいてください。", "start_ms": 665686, "end_ms": 669050, "duration_ms": 3364}]}, {"index": 166, "text": "あなたはたいせつなともだちです。", "start_ms": 669550, "end_ms": 672763, "duration_ms": 3213, "clauses": [{"index": 0, "text": "あなたはたいせつなともだちです。", "start_ms": 669550, "end_ms": 672763, "duration_ms": 3213}]}, {"index": 167, "text": "あなたはもうじゆうです。", "start_ms": 673263, "end_ms": 675779, "duration_ms": 2516, "clauses": [{"index": 0, "text": "あなたはもうじゆうです。", "start_ms": 673263, "end_ms": 675779, "duration_ms": 2516}]}, {"index": 168, "text": "」\n\nそのときから、ふたりはなかがいいともだちになりました。", "start_ms": 676279, "end_ms": 681934, "duration_ms": 5655, "clauses": [{"index": 0, "text": "」\n\nそのときから、", "start_ms": 676279, "end_ms": 678134, "duration_ms": 1855}, {"index": 1, "text": "ふたりはなかがいいともだちになりました。", "start_ms": 678384, "end_ms": 681934, "duration_ms": 3550}]}, {"index": 169, "text": "しょうぐんも、チョウシロウをたいせつにしました。", "start_ms": 682434, "end_ms": 687160, "duration_ms": 4726, "clauses": [{"index": 0, "text": "しょうぐんも、", "start_ms": 682434, "end_ms": 683952, "duration_ms": 1518}, {"index": 1, "text": "チョウシロウをたいせつにしました。", "start_ms": 684202, "end_ms": 687160, "duration_ms": 2958}]}, {"index": 170, "text": "ながいじかんのあとで、チョウシロウはおおきくなって、ゆうめいなひとになりました。", "start_ms": 687660, "end_ms": 695674, "duration_ms": 8014, "clauses": [{"index": 0, "text": "ながいじかんのあとで、", "start_ms": 687660, "end_ms": 689921, "duration_ms": 2261}, {"index": 1, "text": "チョウシロウはおおきくなって、", "start_ms": 690171, "end_ms": 692908, "duration_ms": 2737}, {"index": 2, "text": "ゆうめいなひとになりました。", "start_ms": 693158, "end_ms": 695674, "duration_ms": 2516}]}, {"index": 171, "text": "みんなが、チョウシロウをおぼえています。", "start_ms": 696174, "end_ms": 700528, "duration_ms": 4354, "clauses": [{"index": 0, "text": "みんなが、", "start_ms": 696174, "end_ms": 697506, "duration_ms": 1332}, {"index": 1, "text": "チョウシロウをおぼえています。", "start_ms": 697756, "end_ms": 700528, "duration_ms": 2772}]}]}