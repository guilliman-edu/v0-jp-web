      "start_ms": 253496,
      "end_ms": 257862,
      "duration_ms": 4366,
      "clauses": [
        {
          "index": 0,
          "text": "むかしからいろいろ、",
          "start_ms": 253496,
          "end_ms": 255606,
          "duration_ms": 2110
        },
