      "end_ms": 208457,
      "duration_ms": 3437,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 205020,
          "end_ms": 205853,
          "duration_ms": 833
        },
        {
          "index": 1,
          "text": "かなしまないでください」。",
          "start_ms": 206103,
          "end_ms": 208457,
          "duration_ms": 2354
        }
      ]
    },
    {
      "index": 53,
      "text": "みっつめのてがみはおくさんへのてがみです。",
      "start_ms": 208957,
      "end_ms": 213087,
      "duration_ms": 4130,
      "clauses": [
        {
          "index": 0,
          "text": "みっつめのてがみはおくさんへのてがみです。",
          "start_ms": 208957,
          "end_ms": 213087,
          "duration_ms": 4130
        }
      ]
    },
    {
      "index": 54,
      "text": "「おくさん。",
      "start_ms": 213587,
      "end_ms": 214908,
      "duration_ms": 1321,
      "clauses": [
        {
          "index": 0,
          "text": "「おくさん。",
          "start_ms": 213587,
          "end_ms": 214908,
          "duration_ms": 1321
        }
      ]
    },
    {
      "index": 55,
      "text": "あなたはわたしの、いいともだちです。",
      "start_ms": 215408,
      "end_ms": 219820,
      "duration_ms": 4412,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはわたしの、",
          "start_ms": 215408,
          "end_ms": 217541,
          "duration_ms": 2133
        },
        {
          "index": 1,
          "text": "いいともだちです。",
          "start_ms": 217791,
          "end_ms": 219820,
          "duration_ms": 2029
        }
      ]
    },
    {
      "index": 56,
      "text": "あのよる、わたしのへやへきました。",
      "start_ms": 220320,
      "end_ms": 224581,
      "duration_ms": 4261,
      "clauses": [
        {
          "index": 0,
          "text": "あのよる、",
          "start_ms": 220320,
          "end_ms": 221803,
          "duration_ms": 1483
        },
        {
          "index": 1,
          "text": "わたしのへやへきました。",
          "start_ms": 222053,
          "end_ms": 224581,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 57,
      "text": "そして、「にげてください」といいました。",
      "start_ms": 225081,
      "end_ms": 229400,
      "duration_ms": 4319,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 225081,
          "end_ms": 226448,
          "duration_ms": 1367
        },
        {
          "index": 1,
          "text": "「にげてください」といいました。",
          "start_ms": 226698,
          "end_ms": 229400,
          "duration_ms": 2702
        }
      ]
    },
    {
      "index": 58,
      "text": "あなたがなければ、わたしはもう、しんでいました。",
      "start_ms": 229900,
      "end_ms": 236172,
      "duration_ms": 6272,
      "clauses": [
        {
          "index": 0,
          "text": "あなたがなければ、",
          "start_ms": 229900,
          "end_ms": 231975,
          "duration_ms": 2075
        },
        {
          "index": 1,
          "text": "わたしはもう、",
          "start_ms": 232225,
          "end_ms": 233998,
          "duration_ms": 1773
        },
        {
          "index": 2,
          "text": "しんでいました。",
          "start_ms": 234248,
          "end_ms": 236172,
          "duration_ms": 1924
        }
      ]
    },
    {
      "index": 59,
      "text": "でももう、こうして、しにます。",
      "start_ms": 236672,
      "end_ms": 241610,
      "duration_ms": 4938,
      "clauses": [
        {
          "index": 0,
          "text": "でももう、",
          "start_ms": 236672,
          "end_ms": 238074,
          "duration_ms": 1402
        },
        {
          "index": 1,
          "text": "こうして、",
