          "end_ms": 180452,
          "duration_ms": 856
        },
        {
          "index": 1,
          "text": "なにもしんぱい、",
          "start_ms": 180702,
          "end_ms": 182638,
          "duration_ms": 1936
        },
        {
          "index": 2,
          "text": "しないでください。",
          "start_ms": 182888,
          "end_ms": 184905,
          "duration_ms": 2017
        }
      ]
    },
    {
      "index": 47,
      "text": "どうぞ、げんきでいてください」。",
      "start_ms": 185405,
      "end_ms": 189086,
      "duration_ms": 3681,
      "clauses": [
        {
          "index": 0,
          "text": "どうぞ、",
          "start_ms": 185405,
          "end_ms": 186563,
          "duration_ms": 1158
        },
        {
          "index": 1,
          "text": "げんきでいてください」。",
          "start_ms": 186813,
          "end_ms": 189086,
          "duration_ms": 2273
        }
      ]
    },
    {
      "index": 48,
      "text": "につめのてがみはわかいさむらいへのてがみです。",
      "start_ms": 189586,
      "end_ms": 193890,
      "duration_ms": 4304,
      "clauses": [
        {
          "index": 0,
          "text": "につめのてがみはわかいさむらいへのてがみです。",
          "start_ms": 189586,
          "end_ms": 193890,
          "duration_ms": 4304
        }
      ]
    },
    {
      "index": 49,
      "text": "「あなたはわたしをたいせつにおもいました。",
      "start_ms": 194390,
      "end_ms": 198125,
      "duration_ms": 3735,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたはわたしをたいせつにおもいました。",
          "start_ms": 194390,
          "end_ms": 198125,
          "duration_ms": 3735
        }
      ]
    },
    {
      "index": 50,
      "text": "あなたといて、うれしかったです。",
      "start_ms": 198625,
      "end_ms": 202642,
      "duration_ms": 4017,
      "clauses": [
        {
          "index": 0,
          "text": "あなたといて、",
          "start_ms": 198625,
          "end_ms": 200375,
          "duration_ms": 1750
        },
        {
          "index": 1,
          "text": "うれしかったです。",
          "start_ms": 200625,
          "end_ms": 202642,
          "duration_ms": 2017
        }
      ]
    },
    {
      "index": 51,
      "text": "ありがとう。",
      "start_ms": 203142,
      "end_ms": 204753,
      "duration_ms": 1611,
      "clauses": [
        {
          "index": 0,
          "text": "ありがとう。",
          "start_ms": 203142,
          "end_ms": 204753,
          "duration_ms": 1611
        }
      ]
    },
    {
      "index": 52,
      "text": "もう、かなしまないでください」。",
      "start_ms": 205253,
      "end_ms": 208759,
      "duration_ms": 3506,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 205253,
          "end_ms": 206109,
          "duration_ms": 856
        },
        {
          "index": 1,
          "text": "かなしまないでください」。",
          "start_ms": 206359,
          "end_ms": 208759,
          "duration_ms": 2400
        }
      ]
    },
    {
      "index": 53,
      "text": "みっつめのてがみはおくさんへのてがみです。",
      "start_ms": 209259,
      "end_ms": 213366,
      "duration_ms": 4107,
      "clauses": [
        {
          "index": 0,
          "text": "みっつめのてがみはおくさんへのてがみです。",
          "start_ms": 209259,
          "end_ms": 213366,
          "duration_ms": 4107
        }
      ]
    },
    {
      "index": 54,
      "text": "「おくさん。",
      "start_ms": 213866,
      "end_ms": 215140,
      "duration_ms": 1274,
      "clauses": [
        {
          "index": 0,
          "text": "「おくさん。",
          "start_ms": 213866,
          "end_ms": 215140,
          "duration_ms": 1274
        }
      ]
    },
    {
      "index": 55,
      "text": "あなたはわたしの、いいともだちです。",
      "start_ms": 215640,
      "end_ms": 220029,
      "duration_ms": 4389,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはわたしの、",
