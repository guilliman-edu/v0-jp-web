      "end_ms": 252996,
      "duration_ms": 1553,
      "clauses": [
        {
          "index": 0,
          "text": "「とのさま。",
          "start_ms": 251443,
          "end_ms": 252996,
          "duration_ms": 1553
        }
      ]
    },
