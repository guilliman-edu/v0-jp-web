      "text": "でももう、おわりです。",
      "start_ms": 262168,
      "end_ms": 265477,
      "duration_ms": 3309,
      "clauses": [
        {
          "index": 0,
          "text": "でももう、",
          "start_ms": 262168,
          "end_ms": 263570,
          "duration_ms": 1402
        },
