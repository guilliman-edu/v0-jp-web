        {
          "index": 1,
          "text": "いいともだちです。",
          "start_ms": 217965,
          "end_ms": 220029,
          "duration_ms": 2064
        }
      ]
    },
    {
      "index": 56,
      "text": "あのよる、わたしのへやへきました。",
      "start_ms": 220529,
      "end_ms": 224848,
      "duration_ms": 4319,
      "clauses": [
        {
          "index": 0,
          "text": "あのよる、",
          "start_ms": 220529,
          "end_ms": 222093,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "わたしのへやへきました。",
          "start_ms": 222343,
          "end_ms": 224848,
          "duration_ms": 2505
        }
      ]
    },
    {
      "index": 57,
