      "text": "カツノはわるいおんなのひとですか。",
      "start_ms": 258362,
      "end_ms": 261668,
      "duration_ms": 3306,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはわるいおんなのひとですか。",
          "start_ms": 258362,
          "end_ms": 261668,
          "duration_ms": 3306
        }
      ]
    },
    {
