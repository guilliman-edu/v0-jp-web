          "duration_ms": 833
        },
        {
          "index": 1,
          "text": "なにもしんぱい、",
          "start_ms": 180388,
          "end_ms": 182335,
          "duration_ms": 1947
        },
        {
          "index": 2,
          "text": "しないでください。",
          "start_ms": 182585,
          "end_ms": 184625,
          "duration_ms": 2040
        }
      ]
    },
    {
      "index": 47,
      "text": "どうぞ、げんきでいてください」。",
      "start_ms": 185125,
      "end_ms": 188782,
      "duration_ms": 3657,
      "clauses": [
        {
          "index": 0,
          "text": "どうぞ、",
          "start_ms": 185125,
          "end_ms": 186306,
          "duration_ms": 1181
        },
        {
          "index": 1,
          "text": "げんきでいてください」。",
          "start_ms": 186556,
          "end_ms": 188782,
          "duration_ms": 2226
        }
      ]
    },
    {
      "index": 48,
      "text": "につめのてがみはわかいさむらいへのてがみです。",
      "start_ms": 189282,
      "end_ms": 193563,
      "duration_ms": 4281,
      "clauses": [
        {
          "index": 0,
          "text": "につめのてがみはわかいさむらいへのてがみです。",
          "start_ms": 189282,
          "end_ms": 193563,
          "duration_ms": 4281
        }
      ]
    },
    {
      "index": 49,
      "text": "「あなたはわたしをたいせつにおもいました。",
      "start_ms": 194063,
      "end_ms": 197810,
      "duration_ms": 3747,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたはわたしをたいせつにおもいました。",
          "start_ms": 194063,
          "end_ms": 197810,
          "duration_ms": 3747
        }
      ]
    },
    {
      "index": 50,
      "text": "あなたといて、うれしかったです。",
      "start_ms": 198310,
      "end_ms": 202374,
      "duration_ms": 4064,
      "clauses": [
        {
          "index": 0,
          "text": "あなたといて、",
          "start_ms": 198310,
          "end_ms": 200130,
          "duration_ms": 1820
        },
        {
          "index": 1,
          "text": "うれしかったです。",
          "start_ms": 200380,
          "end_ms": 202374,
          "duration_ms": 1994
        }
      ]
    },
    {
      "index": 51,
      "text": "ありがとう。",
      "start_ms": 202874,
      "end_ms": 204520,
      "duration_ms": 1646,
      "clauses": [
        {
          "index": 0,
          "text": "ありがとう。",
          "start_ms": 202874,
          "end_ms": 204520,
          "duration_ms": 1646
        }
      ]
    },
    {
      "index": 52,
      "text": "もう、かなしまないでください」。",
