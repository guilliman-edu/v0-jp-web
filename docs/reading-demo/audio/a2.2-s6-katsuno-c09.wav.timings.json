      "duration_ms": 3213,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはわるいおんなのひとですか。",
          "start_ms": 258467,
          "end_ms": 261680,
          "duration_ms": 3213
        }
      ]
    },
