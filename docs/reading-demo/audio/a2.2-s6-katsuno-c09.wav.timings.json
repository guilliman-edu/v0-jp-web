          "end_ms": 234231,
          "duration_ms": 1762
        },
        {
          "index": 2,
          "text": "しんでいました。",
          "start_ms": 234481,
          "end_ms": 236370,
          "duration_ms": 1889
        }
      ]
    },
    {
      "index": 59,
      "text": "でももう、こうして、しにます。",
      "start_ms": 236870,
      "end_ms": 241750,
      "duration_ms": 4880,
      "clauses": [
        {
          "index": 0,
