      "duration_ms": 4676,
      "clauses": [
        {
          "index": 0,
          "text": "よっつめのてがみはむかしのとのさまへのてがみです。",
          "start_ms": 246267,
          "end_ms": 250943,
          "duration_ms": 4676
        }
      ]
    },
