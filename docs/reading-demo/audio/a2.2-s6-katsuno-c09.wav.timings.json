      "start_ms": 182637,
      "end_ms": 186207,
      "duration_ms": 3570,
      "clauses": [
        {
          "index": 0,
          "text": "どうぞ、",
          "start_ms": 182637,
          "end_ms": 183763,
          "duration_ms": 1126
        },
        {
          "index": 1,
          "text": "げんきでいてください」。",
          "start_ms": 184013,
          "end_ms": 186207,
          "duration_ms": 2194
        }
      ]
    },
    {
      "index": 48,
      "text": "ふたつめのてがみはわかいさむらいへのてがみです。",
      "start_ms": 186707,
      "end_ms": 190991,
      "duration_ms": 4284,
      "clauses": [
        {
          "index": 0,
          "text": "ふたつめのてがみはわかいさむらいへのてがみです。",
          "start_ms": 186707,
          "end_ms": 190991,
          "duration_ms": 4284
        }
      ]
    },
    {
      "index": 49,
      "text": "「あなたはわたしをたいせつにおもいました。",
      "start_ms": 191491,
      "end_ms": 195252,
      "duration_ms": 3761,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたはわたしをたいせつにおもいました。",
