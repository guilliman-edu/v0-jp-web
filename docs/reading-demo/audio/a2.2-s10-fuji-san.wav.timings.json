          "start_ms": 25193,
          "end_ms": 28452,
          "duration_ms": 3259
        }
      ]
    },
    {
      "index": 6,
      "text": "だから、いまのきれいなかたちになりました。",
      "start_ms": 28952,
      "end_ms": 33433,
