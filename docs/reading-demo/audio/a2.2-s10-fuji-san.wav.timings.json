          "start_ms": 30383,
          "end_ms": 33433,
          "duration_ms": 3050
        }
      ]
    },
    {
      "index": 7,
      "text": "ふじさんのきれいなかたちは、せかいでゆうめいです。",
      "start_ms": 33933,
      "end_ms": 39273,
      "duration_ms": 5340,
      "clauses": [
        {
          "index": 0,
