  "total_duration_ms": 385995,
  "sentences": [
    {
      "index": 0,
      "text": "「おにぎり」のなまえとれきし ― にほんのおにぎりから世界へ",
      "start_ms": 0,
      "end_ms": 4067,
      "duration_ms": 4067,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」のなまえとれきし ― にほんのおにぎりから世界へ",
          "start_ms": 0,
          "end_ms": 4067,
          "duration_ms": 4067
        }
      ]
    },
    {
      "index": 1,
      "text": "にほんではにせんにじゅうご年、きおんが高くてこめが買えなくなり、こめの値段も高くなりました。",
      "start_ms": 4567,
      "end_ms": 13784,
      "duration_ms": 9217,
      "clauses": [
        {
          "index": 0,
          "text": "にほんではにせんにじゅうご年、",
          "start_ms": 4567,
          "end_ms": 7403,
          "duration_ms": 2836
        },
        {
          "index": 1,
          "text": "きおんが高くてこめが買えなくなり、",
          "start_ms": 7653,
          "end_ms": 10698,
          "duration_ms": 3045
        },
        {
          "index": 2,
          "text": "こめの値段も高くなりました。",
          "start_ms": 10948,
          "end_ms": 13784,
          "duration_ms": 2836
        }
      ]
    },
    {
      "index": 2,
      "text": "いつも買えると思ってきたのに買えなくなると、にほんでは長いあいだ、こめがせいかつの中でとても大切なものだと、みんなが気がつきました。",
      "start_ms": 14284,
      "end_ms": 27480,
      "duration_ms": 13196,
      "clauses": [
        {
          "index": 0,
          "text": "いつも買えると思ってきたのに買えなくなると、",
          "start_ms": 14284,
          "end_ms": 18014,
          "duration_ms": 3730
        },
        {
          "index": 1,
          "text": "にほんでは長いあいだ、",
          "start_ms": 18264,
          "end_ms": 20554,
          "duration_ms": 2290
        },
        {
          "index": 2,
          "text": "こめがせいかつの中でとても大切なものだと、",
          "start_ms": 20804,
          "end_ms": 24998,
          "duration_ms": 4194
        },
        {
          "index": 3,
          "text": "みんなが気がつきました。",
          "start_ms": 25248,
          "end_ms": 27480,
          "duration_ms": 2232
        }
      ]
    },
    {
      "index": 3,
      "text": "そこで、みんなが知っている毎日のたべもの「おにぎり」にちゅうもくする人が出ました。",
      "start_ms": 27980,
      "end_ms": 34633,
      "duration_ms": 6653,
      "clauses": [
        {
          "index": 0,
          "text": "そこで、",
          "start_ms": 27980,
          "end_ms": 29086,
          "duration_ms": 1106
        },
        {
          "index": 1,
          "text": "みんなが知っている毎日のたべもの「おにぎり」にちゅうもくする人が出ました。",
          "start_ms": 29336,
          "end_ms": 34633,
          "duration_ms": 5297
        }
      ]
    },
    {
      "index": 4,
      "text": "そのれきしを見てみましょう。",
      "start_ms": 35133,
      "end_ms": 37667,
      "duration_ms": 2534,
      "clauses": [
        {
          "index": 0,
          "text": "そのれきしを見てみましょう。",
          "start_ms": 35133,
          "end_ms": 37667,
          "duration_ms": 2534
        }
      ]
    },
    {
      "index": 5,
      "text": "おにぎりは、いつからあったのか、はっきりしていません。",
      "start_ms": 38167,
      "end_ms": 43982,
      "duration_ms": 5815,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 38167,
          "end_ms": 39633,
          "duration_ms": 1466
        },
        {
          "index": 1,
          "text": "いつからあったのか、",
          "start_ms": 39883,
          "end_ms": 41790,
          "duration_ms": 1907
        },
        {
          "index": 2,
          "text": "はっきりしていません。",
          "start_ms": 42040,
          "end_ms": 43982,
          "duration_ms": 1942
        }
      ]
    },
    {
      "index": 6,
      "text": "にほんでこめを作るようになってから、人は作ったこめを手でまとめていたと考えられています。",
      "start_ms": 44482,
      "end_ms": 52633,
      "duration_ms": 8151,
      "clauses": [
        {
          "index": 0,
          "text": "にほんでこめを作るようになってから、",
          "start_ms": 44482,
          "end_ms": 47504,
          "duration_ms": 3022
        },
        {
          "index": 1,
          "text": "人は作ったこめを手でまとめていたと考えられています。",
          "start_ms": 47754,
          "end_ms": 52633,
          "duration_ms": 4879
        }
      ]
    },
    {
      "index": 7,
      "text": "にほんのあるばしょでは、にせん年前のこめが出たこともあります。",
      "start_ms": 53133,
      "end_ms": 58799,
      "duration_ms": 5666,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのあるばしょでは、",
          "start_ms": 53133,
          "end_ms": 55272,
          "duration_ms": 2139
        },
        {
          "index": 1,
          "text": "にせん年前のこめが出たこともあります。",
          "start_ms": 55522,
          "end_ms": 58799,
          "duration_ms": 3277
        }
      ]
    },
    {
      "index": 8,
      "text": "手で作ったのではなく、ほかのしゅだんで作られたと考えられているものもあります。",
      "start_ms": 59299,
      "end_ms": 66370,
      "duration_ms": 7071,
      "clauses": [
        {
          "index": 0,
          "text": "手で作ったのではなく、",
          "start_ms": 59299,
          "end_ms": 61554,
          "duration_ms": 2255
        },
        {
          "index": 1,
          "text": "ほかのしゅだんで作られたと考えられているものもあります。",
          "start_ms": 61804,
          "end_ms": 66370,
          "duration_ms": 4566
        }
      ]
    },
    {
      "index": 9,
      "text": "そして、それを「むかしのおにぎりのしょうこ」と言っています。",
      "start_ms": 66870,
      "end_ms": 72154,
      "duration_ms": 5284,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 66870,
          "end_ms": 68104,
          "duration_ms": 1234
        },
        {
          "index": 1,
          "text": "それを「むかしのおにぎりのしょうこ」と言っています。",
          "start_ms": 68354,
          "end_ms": 72154,
          "duration_ms": 3800
        }
      ]
    },
    {
      "index": 10,
      "text": "このこめについては、人によって違う説明をしています。",
      "start_ms": 72654,
      "end_ms": 78274,
      "duration_ms": 5620,
      "clauses": [
        {
          "index": 0,
          "text": "このこめについては、",
          "start_ms": 72654,
          "end_ms": 74724,
          "duration_ms": 2070
        },
        {
          "index": 1,
          "text": "人によって違う説明をしています。",
          "start_ms": 74974,
          "end_ms": 78274,
          "duration_ms": 3300
        }
      ]
    },
    {
      "index": 11,
      "text": "大切なのは、こめを手でまとめて持ちやすくすることを、にほんではとてもむかしからやっていることです。",
      "start_ms": 78774,
      "end_ms": 88002,
      "duration_ms": 9228,
      "clauses": [
        {
          "index": 0,
          "text": "大切なのは、",
          "start_ms": 78774,
          "end_ms": 80495,
          "duration_ms": 1721
        },
        {
          "index": 1,
          "text": "こめを手でまとめて持ちやすくすることを、",
          "start_ms": 80745,
          "end_ms": 84045,
          "duration_ms": 3300
        },
        {
          "index": 2,
          "text": "にほんではとてもむかしからやっていることです。",
          "start_ms": 84295,
          "end_ms": 88002,
          "duration_ms": 3707
        }
      ]
    },
    {
      "index": 12,
      "text": "むかしの本には、にほんごで「にぎりいい」と書かれたことばが出ています。",
      "start_ms": 88502,
      "end_ms": 94447,
      "duration_ms": 5945,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 88502,
          "end_ms": 90374,
          "duration_ms": 1872
        },
        {
          "index": 1,
          "text": "にほんごで「にぎりいい」と書かれたことばが出ています。",
          "start_ms": 90624,
          "end_ms": 94447,
          "duration_ms": 3823
        }
      ]
    },
    {
      "index": 13,
      "text": "人はたべものを持って会い、こめをみんなで食べていました。",
      "start_ms": 94947,
      "end_ms": 100753,
      "duration_ms": 5806,
      "clauses": [
        {
          "index": 0,
          "text": "人はたべものを持って会い、",
          "start_ms": 94947,
          "end_ms": 97818,
          "duration_ms": 2871
        },
        {
          "index": 1,
          "text": "こめをみんなで食べていました。",
          "start_ms": 98068,
          "end_ms": 100753,
          "duration_ms": 2685
        }
      ]
    },
    {
      "index": 14,
      "text": "その使い方は、とてもみじかなものでした。",
      "start_ms": 101253,
      "end_ms": 105920,
      "duration_ms": 4667,
      "clauses": [
        {
          "index": 0,
          "text": "その使い方は、",
          "start_ms": 101253,
          "end_ms": 103148,
          "duration_ms": 1895
        },
        {
          "index": 1,
          "text": "とてもみじかなものでした。",
          "start_ms": 103398,
          "end_ms": 105920,
          "duration_ms": 2522
        }
      ]
    },
    {
      "index": 15,
      "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
      "start_ms": 106420,
      "end_ms": 111322,
      "duration_ms": 4902,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
          "start_ms": 106420,
          "end_ms": 111322,
          "duration_ms": 4902
        }
      ]
    },
    {
      "index": 16,
      "text": "にほんではむかし、「にぎりいい」と言っていました。",
      "start_ms": 111822,
      "end_ms": 116292,
      "duration_ms": 4470,
      "clauses": [
        {
          "index": 0,
          "text": "にほんではむかし、",
          "start_ms": 111822,
          "end_ms": 113729,
          "duration_ms": 1907
        },
        {
          "index": 1,
          "text": "「にぎりいい」と言っていました。",
          "start_ms": 113979,
          "end_ms": 116292,
          "duration_ms": 2313
        }
      ]
    },
    {
      "index": 17,
      "text": "「にぎりいい」が使われているうちに、「にぎりめし」というなまえに変わりました。",
      "start_ms": 116792,
      "end_ms": 122865,
      "duration_ms": 6073,
      "clauses": [
        {
          "index": 0,
          "text": "「にぎりいい」が使われているうちに、",
          "start_ms": 116792,
          "end_ms": 119489,
          "duration_ms": 2697
        },
        {
          "index": 1,
          "text": "「にぎりめし」というなまえに変わりました。",
          "start_ms": 119739,
          "end_ms": 122865,
          "duration_ms": 3126
        }
      ]
    },
    {
      "index": 18,
      "text": "さらに、けいごの「お」を付けたなまえが「おにぎり」です。",
      "start_ms": 123365,
      "end_ms": 127986,
      "duration_ms": 4621,
      "clauses": [
        {
          "index": 0,
          "text": "さらに、",
          "start_ms": 123365,
          "end_ms": 124552,
          "duration_ms": 1187
        },
        {
          "index": 1,
          "text": "けいごの「お」を付けたなまえが「おにぎり」です。",
          "start_ms": 124802,
          "end_ms": 127986,
          "duration_ms": 3184
        }
      ]
    },
    {
      "index": 19,
      "text": "「おにぎり」をせつめいすることばは、「おむすび」もあります。",
      "start_ms": 128486,
      "end_ms": 133432,
      "duration_ms": 4946,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」をせつめいすることばは、",
          "start_ms": 128486,
          "end_ms": 131194,
          "duration_ms": 2708
        },
        {
          "index": 1,
          "text": "「おむすび」もあります。",
          "start_ms": 131444,
          "end_ms": 133432,
          "duration_ms": 1988
        }
      ]
    },
    {
      "index": 20,
      "text": "「むすび」というなまえをみんなが使い始めたのは、えどじだいです。",
      "start_ms": 133932,
      "end_ms": 139831,
      "duration_ms": 5899,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」というなまえをみんなが使い始めたのは、",
          "start_ms": 133932,
          "end_ms": 137813,
          "duration_ms": 3881
        },
        {
          "index": 1,
          "text": "えどじだいです。",
          "start_ms": 138063,
          "end_ms": 139831,
          "duration_ms": 1768
        }
      ]
    },
    {
      "index": 21,
      "text": "そこにもけいごの「お」を付けました。",
      "start_ms": 140331,
      "end_ms": 143086,
      "duration_ms": 2755,
      "clauses": [
        {
          "index": 0,
          "text": "そこにもけいごの「お」を付けました。",
          "start_ms": 140331,
          "end_ms": 143086,
          "duration_ms": 2755
        }
      ]
    },
    {
      "index": 22,
      "text": "むかしの本には、「むすび」を「にぎりいい」の別のなまえと書いて、「もとは女のことばです」とも書かれています。",
      "start_ms": 143586,
      "end_ms": 152814,
      "duration_ms": 9228,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 143586,
          "end_ms": 145319,
          "duration_ms": 1733
        },
        {
          "index": 1,
          "text": "「むすび」を「にぎりいい」の別のなまえと書いて、",
          "start_ms": 145569,
          "end_ms": 148904,
          "duration_ms": 3335
        },
        {
          "index": 2,
          "text": "「もとは女のことばです」とも書かれています。",
          "start_ms": 149154,
          "end_ms": 152814,
          "duration_ms": 3660
        }
      ]
    },
    {
      "index": 23,
      "text": "「むすび」は、なまえのいみをあらわすだけのことばではありません。",
      "start_ms": 153314,
      "end_ms": 158864,
      "duration_ms": 5550,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」は、",
          "start_ms": 153314,
          "end_ms": 154733,
          "duration_ms": 1419
        },
        {
          "index": 1,
          "text": "なまえのいみをあらわすだけのことばではありません。",
          "start_ms": 154983,
          "end_ms": 158864,
          "duration_ms": 3881
        }
      ]
    },
    {
      "index": 24,
      "text": "むかしの本には、かみさまのなまえにも出ていて、そこに何かを作るいみや、人と人がつながるいみが加わっているのです。",
      "start_ms": 159364,
      "end_ms": 170924,
      "duration_ms": 11560,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 159364,
          "end_ms": 161225,
          "duration_ms": 1861
        },
        {
          "index": 1,
          "text": "かみさまのなまえにも出ていて、",
          "start_ms": 161475,
          "end_ms": 164160,
          "duration_ms": 2685
        },
        {
          "index": 2,
          "text": "そこに何かを作るいみや、",
          "start_ms": 164410,
          "end_ms": 166979,
          "duration_ms": 2569
        },
        {
          "index": 3,
          "text": "人と人がつながるいみが加わっているのです。",
          "start_ms": 167229,
          "end_ms": 170924,
          "duration_ms": 3695
        }
      ]
    },
    {
      "index": 25,
      "text": "つまり、「むすび」は、いみがさまざまに加わったことばということです。",
      "start_ms": 171424,
      "end_ms": 178482,
      "duration_ms": 7058,
      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 171424,
          "end_ms": 172693,
          "duration_ms": 1269
        },
        {
          "index": 1,
          "text": "「むすび」は、",
          "start_ms": 172943,
          "end_ms": 174374,
          "duration_ms": 1431
        },
        {
          "index": 2,
          "text": "いみがさまざまに加わったことばということです。",
          "start_ms": 174624,
          "end_ms": 178482,
          "duration_ms": 3858
        }
      ]
    },
    {
      "index": 26,
      "text": "だからといって、「むすび」というなまえがかみさまとつながっているとは言えません。",
      "start_ms": 178982,
      "end_ms": 185693,
      "duration_ms": 6711,
      "clauses": [
        {
          "index": 0,
          "text": "だからといって、",
          "start_ms": 178982,
          "end_ms": 180645,
          "duration_ms": 1663
        },
        {
          "index": 1,
          "text": "「むすび」というなまえがかみさまとつながっているとは言えません。",
          "start_ms": 180895,
          "end_ms": 185693,
          "duration_ms": 4798
        }
      ]
    },
    {
      "index": 27,
      "text": "でも、ことばのいみがさまざまに加わっていることにちゅうもくすると、この毎日のたべものがにほんに住む人にとって、大切ないみを持つのでしょう。",
      "start_ms": 186193,
      "end_ms": 199100,
      "duration_ms": 12907,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 186193,
          "end_ms": 187102,
          "duration_ms": 909
        },
        {
          "index": 1,
          "text": "ことばのいみがさまざまに加わっていることにちゅうもくすると、",
          "start_ms": 187352,
          "end_ms": 191976,
          "duration_ms": 4624
        },
        {
          "index": 2,
          "text": "この毎日のたべものがにほんに住む人にとって、",
          "start_ms": 192226,
          "end_ms": 196235,
          "duration_ms": 4009
        },
        {
          "index": 3,
          "text": "大切ないみを持つのでしょう。",
          "start_ms": 196485,
          "end_ms": 199100,
          "duration_ms": 2615
        }
      ]
    },
    {
      "index": 28,
      "text": "こめを作る仕事は、一人では終わりません。",
      "start_ms": 199600,
      "end_ms": 204268,
      "duration_ms": 4668,
      "clauses": [
        {
          "index": 0,
          "text": "こめを作る仕事は、",
          "start_ms": 199600,
          "end_ms": 201751,
          "duration_ms": 2151
        },
        {
          "index": 1,
          "text": "一人では終わりません。",
          "start_ms": 202001,
          "end_ms": 204268,
          "duration_ms": 2267
        }
      ]
    },
    {
      "index": 29,
      "text": "みんなでみずを集め、みんなで使います。",
      "start_ms": 204768,
      "end_ms": 208960,
      "duration_ms": 4192,
      "clauses": [
        {
          "index": 0,
          "text": "みんなでみずを集め、",
          "start_ms": 204768,
          "end_ms": 206791,
          "duration_ms": 2023
        },
        {
          "index": 1,
          "text": "みんなで使います。",
          "start_ms": 207041,
          "end_ms": 208960,
          "duration_ms": 1919
        }
      ]
    },
    {
      "index": 30,
      "text": "みずをまもるのも、こめをうえるのも、みんなの仕事です。",
      "start_ms": 209460,
      "end_ms": 215647,
      "duration_ms": 6187,
      "clauses": [
        {
          "index": 0,
          "text": "みずをまもるのも、",
          "start_ms": 209460,
          "end_ms": 211367,
          "duration_ms": 1907
        },
        {
          "index": 1,
          "text": "こめをうえるのも、",
          "start_ms": 211617,
          "end_ms": 213443,
          "duration_ms": 1826
        },
        {
          "index": 2,
          "text": "みんなの仕事です。",
          "start_ms": 213693,
          "end_ms": 215647,
          "duration_ms": 1954
        }
      ]
    },
    {
      "index": 31,
      "text": "そして、作ったこめをみんなで食べるのに、とてもいいたべものが「おにぎり」です。",
      "start_ms": 216147,
      "end_ms": 223692,
      "duration_ms": 7545,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 216147,
          "end_ms": 217381,
          "duration_ms": 1234
        },
        {
          "index": 1,
          "text": "作ったこめをみんなで食べるのに、",
          "start_ms": 217631,
          "end_ms": 220653,
          "duration_ms": 3022
        },
        {
          "index": 2,
          "text": "とてもいいたべものが「おにぎり」です。",
          "start_ms": 220903,
          "end_ms": 223692,
          "duration_ms": 2789
        }
      ]
    },
    {
      "index": 32,
      "text": "じしんのとき、にほんではよく「おにぎり」が出ます。",
      "start_ms": 224192,
      "end_ms": 229116,
      "duration_ms": 4924,
      "clauses": [
        {
          "index": 0,
          "text": "じしんのとき、",
          "start_ms": 224192,
          "end_ms": 225879,
          "duration_ms": 1687
        },
        {
          "index": 1,
          "text": "にほんではよく「おにぎり」が出ます。",
          "start_ms": 226129,
          "end_ms": 229116,
          "duration_ms": 2987
        }
      ]
    },
    {
      "index": 33,
      "text": "持ちやすく、作るのも楽で、食べるのに何も要りません。",
      "start_ms": 229616,
      "end_ms": 236139,
      "duration_ms": 6523,
      "clauses": [
        {
          "index": 0,
          "text": "持ちやすく、",
          "start_ms": 229616,
          "end_ms": 231163,
          "duration_ms": 1547
        },
        {
          "index": 1,
          "text": "作るのも楽で、",
          "start_ms": 231413,
          "end_ms": 233250,
          "duration_ms": 1837
        },
        {
          "index": 2,
          "text": "食べるのに何も要りません。",
          "start_ms": 233500,
          "end_ms": 236139,
          "duration_ms": 2639
        }
      ]
    },
    {
      "index": 34,
      "text": "みんなにおにぎりを与えました。",
      "start_ms": 236639,
      "end_ms": 239219,
      "duration_ms": 2580,
      "clauses": [
        {
          "index": 0,
          "text": "みんなにおにぎりを与えました。",
          "start_ms": 236639,
          "end_ms": 239219,
          "duration_ms": 2580
        }
      ]
    },
    {
      "index": 35,
      "text": "そのとき、人は人と人がつながることを知りました。",
      "start_ms": 239719,
      "end_ms": 245374,
      "duration_ms": 5655,
      "clauses": [
        {
          "index": 0,
          "text": "そのとき、",
          "start_ms": 239719,
          "end_ms": 241162,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "人は人と人がつながることを知りました。",
          "start_ms": 241412,
          "end_ms": 245374,
          "duration_ms": 3962
        }
      ]
    },
    {
      "index": 36,
      "text": "にせん年、にほんでは1月17日を「おむすびの日」にしました。",
      "start_ms": 245874,
      "end_ms": 252283,
      "duration_ms": 6409,
      "clauses": [
        {
          "index": 0,
          "text": "にせん年、",
          "start_ms": 245874,
          "end_ms": 247305,
          "duration_ms": 1431
        },
        {
          "index": 1,
          "text": "にほんでは1月17日を「おむすびの日」にしました。",
          "start_ms": 247555,
          "end_ms": 252283,
          "duration_ms": 4728
        }
      ]
    },
    {
      "index": 37,
      "text": "「おにぎり」ではなく「おむすび」というなまえを使ったのは、人と人がつながることを大切にしたからです。",
      "start_ms": 252783,
      "end_ms": 261027,
      "duration_ms": 8244,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ではなく「おむすび」というなまえを使ったのは、",
          "start_ms": 252783,
          "end_ms": 256722,
          "duration_ms": 3939
        },
        {
          "index": 1,
          "text": "人と人がつながることを大切にしたからです。",
          "start_ms": 256972,
          "end_ms": 261027,
          "duration_ms": 4055
        }
      ]
    },
    {
      "index": 38,
      "text": "にほんは、うみの近くにあって、やまが多いくにです。",
      "start_ms": 261527,
      "end_ms": 267550,
      "duration_ms": 6023,
      "clauses": [
        {
          "index": 0,
          "text": "にほんは、",
          "start_ms": 261527,
          "end_ms": 262888,
          "duration_ms": 1361
        },
        {
          "index": 1,
          "text": "うみの近くにあって、",
          "start_ms": 263138,
          "end_ms": 265161,
          "duration_ms": 2023
        },
        {
          "index": 2,
          "text": "やまが多いくにです。",
          "start_ms": 265411,
          "end_ms": 267550,
          "duration_ms": 2139
        }
      ]
    },
    {
      "index": 39,
      "text": "「おにぎり」を見ると、にほんのやまとうみのようすが分かります。",
      "start_ms": 268050,
      "end_ms": 273357,
      "duration_ms": 5307,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」を見ると、",
          "start_ms": 268050,
          "end_ms": 269853,
          "duration_ms": 1803
        },
        {
          "index": 1,
          "text": "にほんのやまとうみのようすが分かります。",
          "start_ms": 270103,
          "end_ms": 273357,
          "duration_ms": 3254
        }
      ]
    },
    {
      "index": 40,
      "text": "やまの近くに住む人はやさいを使い、うみの近くに住む人はさかなを使います。",
      "start_ms": 273857,
      "end_ms": 281427,
      "duration_ms": 7570,
      "clauses": [
        {
          "index": 0,
          "text": "やまの近くに住む人はやさいを使い、",
          "start_ms": 273857,
          "end_ms": 277459,
          "duration_ms": 3602
        },
        {
          "index": 1,
          "text": "うみの近くに住む人はさかなを使います。",
          "start_ms": 277709,
          "end_ms": 281427,
          "duration_ms": 3718
        }
      ]
    },
    {
      "index": 41,
      "text": "「おにぎり」の中には、やまとうみのたべものが入っています。",
      "start_ms": 281927,
      "end_ms": 287234,
      "duration_ms": 5307,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」の中には、",
          "start_ms": 281927,
          "end_ms": 283869,
          "duration_ms": 1942
        },
        {
          "index": 1,
          "text": "やまとうみのたべものが入っています。",
          "start_ms": 284119,
          "end_ms": 287234,
          "duration_ms": 3115
        }
      ]
    },
    {
      "index": 42,
      "text": "そのさまざまなおにぎりが、にほんのたべもののとくちょうを表しています。",
      "start_ms": 287734,
      "end_ms": 294121,
      "duration_ms": 6387,
      "clauses": [
        {
          "index": 0,
          "text": "そのさまざまなおにぎりが、",
          "start_ms": 287734,
          "end_ms": 290222,
          "duration_ms": 2488
        },
        {
          "index": 1,
          "text": "にほんのたべもののとくちょうを表しています。",
          "start_ms": 290472,
          "end_ms": 294121,
          "duration_ms": 3649
        }
      ]
    },
    {
      "index": 43,
      "text": "今は、ほかのくにのたべものも、むかしは知らなかったなかみも多くなっています。",
      "start_ms": 294621,
      "end_ms": 302073,
      "duration_ms": 7452,
      "clauses": [
        {
          "index": 0,
          "text": "今は、",
          "start_ms": 294621,
          "end_ms": 295518,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "ほかのくにのたべものも、",
          "start_ms": 295768,
          "end_ms": 298093,
          "duration_ms": 2325
        },
        {
          "index": 2,
          "text": "むかしは知らなかったなかみも多くなっています。",
          "start_ms": 298343,
          "end_ms": 302073,
          "duration_ms": 3730
        }
      ]
    },
    {
      "index": 44,
      "text": "にほんのおにぎりは、さんかくけいがとても多いです。",
      "start_ms": 302573,
      "end_ms": 307648,
      "duration_ms": 5075,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのおにぎりは、",
          "start_ms": 302573,
          "end_ms": 304492,
          "duration_ms": 1919
        },
        {
          "index": 1,
          "text": "さんかくけいがとても多いです。",
          "start_ms": 304742,
          "end_ms": 307648,
          "duration_ms": 2906
        }
      ]
    },
    {
      "index": 45,
      "text": "コンビニのおにぎりになってから、そのようすが決まりました。",
      "start_ms": 308148,
      "end_ms": 313385,
      "duration_ms": 5237,
      "clauses": [
        {
          "index": 0,
          "text": "コンビニのおにぎりになってから、",
          "start_ms": 308148,
          "end_ms": 310752,
          "duration_ms": 2604
        },
        {
          "index": 1,
          "text": "そのようすが決まりました。",
          "start_ms": 311002,
          "end_ms": 313385,
          "duration_ms": 2383
        }
      ]
    },
    {
      "index": 46,
      "text": "さんかくけいは、持つ場合、壊さずに持ちやすいからです。",
      "start_ms": 313885,
      "end_ms": 320245,
      "duration_ms": 6360,
      "clauses": [
        {
          "index": 0,
          "text": "さんかくけいは、",
          "start_ms": 313885,
          "end_ms": 315641,
          "duration_ms": 1756
        },
        {
          "index": 1,
          "text": "持つ場合、",
          "start_ms": 315891,
          "end_ms": 317310,
          "duration_ms": 1419
        },
        {
          "index": 2,
          "text": "壊さずに持ちやすいからです。",
          "start_ms": 317560,
          "end_ms": 320245,
          "duration_ms": 2685
        }
      ]
    },
    {
      "index": 47,
      "text": "多く作って、多く運ぶのにも便利です。",
      "start_ms": 320745,
      "end_ms": 325297,
      "duration_ms": 4552,
      "clauses": [
        {
          "index": 0,
          "text": "多く作って、",
          "start_ms": 320745,
          "end_ms": 322339,
          "duration_ms": 1594
        },
        {
          "index": 1,
          "text": "多く運ぶのにも便利です。",
          "start_ms": 322589,
          "end_ms": 325297,
          "duration_ms": 2708
        }
      ]
    },
    {
      "index": 48,
      "text": "むかしは、にほんでも、ばしょによってようすが違いました。",
      "start_ms": 325797,
      "end_ms": 332019,
      "duration_ms": 6222,
      "clauses": [
        {
          "index": 0,
          "text": "むかしは、",
          "start_ms": 325797,
          "end_ms": 327147,
          "duration_ms": 1350
        },
        {
          "index": 1,
          "text": "にほんでも、",
          "start_ms": 327397,
          "end_ms": 328875,
          "duration_ms": 1478
        },
        {
          "index": 2,
          "text": "ばしょによってようすが違いました。",
          "start_ms": 329125,
          "end_ms": 332019,
          "duration_ms": 2894
        }
      ]
    },
    {
      "index": 49,
      "text": "今は、いろいろななかみを入れて、食べやすくするためのようすもあります。",
      "start_ms": 332519,
      "end_ms": 339287,
      "duration_ms": 6768,
      "clauses": [
        {
          "index": 0,
          "text": "今は、",
          "start_ms": 332519,
          "end_ms": 333370,
          "duration_ms": 851
        },
        {
          "index": 1,
          "text": "いろいろななかみを入れて、",
          "start_ms": 333620,
          "end_ms": 335957,
          "duration_ms": 2337
        },
        {
          "index": 2,
          "text": "食べやすくするためのようすもあります。",
          "start_ms": 336207,
          "end_ms": 339287,
          "duration_ms": 3080
        }
      ]
    },
    {
      "index": 50,
      "text": "にほんのおにぎりは、世界でもちゅうもくされています。",
      "start_ms": 339787,
      "end_ms": 344815,
      "duration_ms": 5028,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのおにぎりは、",
          "start_ms": 339787,
          "end_ms": 341694,
          "duration_ms": 1907
        },
        {
          "index": 1,
          "text": "世界でもちゅうもくされています。",
          "start_ms": 341944,
          "end_ms": 344815,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 51,
      "text": "おにぎりだけのみせがとても多くなっています。",
      "start_ms": 345315,
      "end_ms": 349138,
      "duration_ms": 3823,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりだけのみせがとても多くなっています。",
          "start_ms": 345315,
          "end_ms": 349138,
          "duration_ms": 3823
        }
      ]
    },
    {
      "index": 52,
      "text": "世界の人も食べるようになり、おにぎりをひょうかする人も多くなっています。",
      "start_ms": 349638,
      "end_ms": 356186,
      "duration_ms": 6548,
      "clauses": [
        {
          "index": 0,
          "text": "世界の人も食べるようになり、",
          "start_ms": 349638,
          "end_ms": 352311,
          "duration_ms": 2673
        },
        {
          "index": 1,
          "text": "おにぎりをひょうかする人も多くなっています。",
          "start_ms": 352561,
          "end_ms": 356186,
          "duration_ms": 3625
        }
      ]
    },
    {
      "index": 53,
      "text": "にせんにじゅうよ年、えいごの大きなじしょに「onigiri」が出ました。",
      "start_ms": 356686,
      "end_ms": 361714,
      "duration_ms": 5028,
      "clauses": [
        {
          "index": 0,
          "text": "にせんにじゅうよ年、",
          "start_ms": 356686,
          "end_ms": 358535,
          "duration_ms": 1849
        },
        {
          "index": 1,
          "text": "えいごの大きなじしょに「onigiri」が出ました。",
          "start_ms": 358785,
          "end_ms": 361714,
          "duration_ms": 2929
        }
      ]
    },
    {
      "index": 54,
      "text": "にほんごのなまえで知られたしょうこです。",
      "start_ms": 362214,
      "end_ms": 365294,
      "duration_ms": 3080,
      "clauses": [
        {
          "index": 0,
          "text": "にほんごのなまえで知られたしょうこです。",
          "start_ms": 362214,
          "end_ms": 365294,
          "duration_ms": 3080
        }
      ]
    },
    {
      "index": 55,
      "text": "おにぎりは、いろいろなようすになり、世界にも広がっています。",
      "start_ms": 365794,
      "end_ms": 372353,
      "duration_ms": 6559,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 365794,
          "end_ms": 367272,
          "duration_ms": 1478
        },
        {
          "index": 1,
          "text": "いろいろなようすになり、",
          "start_ms": 367522,
          "end_ms": 369615,
          "duration_ms": 2093
        },
        {
          "index": 2,
          "text": "世界にも広がっています。",
          "start_ms": 369865,
          "end_ms": 372353,
          "duration_ms": 2488
        }
      ]
    },
    {
      "index": 56,
      "text": "でも、こめを手でまとめてみんなで食べるちゅうしんは、今もあります。",
      "start_ms": 372853,
      "end_ms": 379875,
      "duration_ms": 7022,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 372853,
          "end_ms": 373715,
          "duration_ms": 862
        },
        {
          "index": 1,
          "text": "こめを手でまとめてみんなで食べるちゅうしんは、",
          "start_ms": 373965,
          "end_ms": 377892,
          "duration_ms": 3927
        },
        {
          "index": 2,
          "text": "今もあります。",
          "start_ms": 378142,
          "end_ms": 379875,
          "duration_ms": 1733
        }
      ]
    },
    {
      "index": 57,
      "text": "これからも、にほんのおにぎりはみんなに食べられていくでしょう。",
      "start_ms": 380375,
      "end_ms": 385995,
      "duration_ms": 5620,
      "clauses": [
        {
          "index": 0,
          "text": "これからも、",
          "start_ms": 380375,
          "end_ms": 381876,
          "duration_ms": 1501
        },
        {
          "index": 1,
          "text": "にほんのおにぎりはみんなに食べられていくでしょう。",
          "start_ms": 382126,
          "end_ms": 385995,
          "duration_ms": 3869
        }
      ]
    }
  ]
}