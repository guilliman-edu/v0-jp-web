  "sentences": [
    {
      "index": 0,
      "text": "「おにぎり」のなまえとれきし ― にほんのおにぎりから世界へ",
      "start_ms": 0,
      "end_ms": 4159,
      "duration_ms": 4159,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」のなまえとれきし ― にほんのおにぎりから世界へ",
          "start_ms": 0,
          "end_ms": 4159,
          "duration_ms": 4159
        }
      ]
    },
    {
      "index": 1,
      "text": "にほんでは2025年、きおんが高くてこめが買えなくなり、お金も高くなりました。",
      "start_ms": 4659,
      "end_ms": 13492,
      "duration_ms": 8833,
      "clauses": [
        {
          "index": 0,
          "text": "にほんでは2025年、",
          "start_ms": 4659,
          "end_ms": 7495,
          "duration_ms": 2836
        },
        {
          "index": 1,
          "text": "きおんが高くてこめが買えなくなり、",
          "start_ms": 7745,
          "end_ms": 10871,
          "duration_ms": 3126
        },
        {
          "index": 2,
          "text": "お金も高くなりました。",
          "start_ms": 11121,
          "end_ms": 13492,
          "duration_ms": 2371
        }
      ]
    },
    {
      "index": 2,
      "text": "いつも買えると思ってきたのに買えなくなると、にほんでは長いあいだ、こめがせいかつの中でとても大切なものだと、みんなが気がつきました。",
      "start_ms": 13992,
      "end_ms": 27061,
      "duration_ms": 13069,
      "clauses": [
        {
          "index": 0,
          "text": "いつも買えると思ってきたのに買えなくなると、",
          "start_ms": 13992,
          "end_ms": 17687,
          "duration_ms": 3695
        },
        {
          "index": 1,
          "text": "にほんでは長いあいだ、",
          "start_ms": 17937,
          "end_ms": 20158,
          "duration_ms": 2221
        },
        {
          "index": 2,
          "text": "こめがせいかつの中でとても大切なものだと、",
          "start_ms": 20408,
          "end_ms": 24614,
          "duration_ms": 4206
        },
        {
          "index": 3,
          "text": "みんなが気がつきました。",
          "start_ms": 24864,
          "end_ms": 27061,
          "duration_ms": 2197
        }
      ]
    },
    {
      "index": 3,
      "text": "そこで、みんなが知っている毎日のたべもの「おにぎり」にちゅうもくする人が出ました。",
      "start_ms": 27561,
      "end_ms": 34203,
      "duration_ms": 6642,
      "clauses": [
        {
          "index": 0,
          "text": "そこで、",
          "start_ms": 27561,
          "end_ms": 28644,
          "duration_ms": 1083
        },
        {
          "index": 1,
          "text": "みんなが知っている毎日のたべもの「おにぎり」にちゅうもくする人が出ました。",
          "start_ms": 28894,
          "end_ms": 34203,
          "duration_ms": 5309
        }
      ]
    },
    {
      "index": 4,
      "text": "そのれきしを見てみましょう。",
      "start_ms": 34703,
      "end_ms": 37191,
      "duration_ms": 2488,
      "clauses": [
        {
          "index": 0,
          "text": "そのれきしを見てみましょう。",
          "start_ms": 34703,
          "end_ms": 37191,
          "duration_ms": 2488
        }
      ]
    },
    {
      "index": 5,
      "text": "おにぎりは、いつからあったのか、はっきりしていません。",
      "start_ms": 37691,
      "end_ms": 43634,
      "duration_ms": 5943,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 37691,
          "end_ms": 39134,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "いつからあったのか、",
          "start_ms": 39384,
          "end_ms": 41372,
          "duration_ms": 1988
        },
        {
          "index": 2,
          "text": "はっきりしていません。",
          "start_ms": 41622,
          "end_ms": 43634,
          "duration_ms": 2012
        }
      ]
    },
    {
      "index": 6,
      "text": "にほんでこめを作るようになってから、人は作ったこめを手でまとめていたと考えられています。",
      "start_ms": 44134,
      "end_ms": 52250,
      "duration_ms": 8116,
      "clauses": [
        {
          "index": 0,
          "text": "にほんでこめを作るようになってから、",
          "start_ms": 44134,
          "end_ms": 47086,
          "duration_ms": 2952
        },
        {
          "index": 1,
          "text": "人は作ったこめを手でまとめていたと考えられています。",
          "start_ms": 47336,
          "end_ms": 52250,
          "duration_ms": 4914
        }
      ]
    },
    {
      "index": 7,
      "text": "にほんのあるばしょでは、2000年前のこめが出たこともあります。",
      "start_ms": 52750,
      "end_ms": 58475,
      "duration_ms": 5725,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのあるばしょでは、",
          "start_ms": 52750,
          "end_ms": 54901,
          "duration_ms": 2151
        },
        {
          "index": 1,
          "text": "2000年前のこめが出たこともあります。",
          "start_ms": 55151,
          "end_ms": 58475,
          "duration_ms": 3324
        }
      ]
    },
    {
      "index": 8,
      "text": "手で作ったのではなく、ほかのしゅだんで作られたと考えられているものもあります。",
      "start_ms": 58975,
      "end_ms": 66047,
      "duration_ms": 7072,
      "clauses": [
        {
          "index": 0,
          "text": "手で作ったのではなく、",
          "start_ms": 58975,
          "end_ms": 61196,
          "duration_ms": 2221
        },
        {
          "index": 1,
          "text": "ほかのしゅだんで作られたと考えられているものもあります。",
          "start_ms": 61446,
          "end_ms": 66047,
          "duration_ms": 4601
        }
      ]
    },
    {
      "index": 9,
      "text": "そして、それを「むかしのおにぎりのしょうこ」と言っています。",
      "start_ms": 66547,
      "end_ms": 71784,
      "duration_ms": 5237,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 66547,
          "end_ms": 67781,
          "duration_ms": 1234
        },
        {
          "index": 1,
          "text": "それを「むかしのおにぎりのしょうこ」と言っています。",
          "start_ms": 68031,
          "end_ms": 71784,
          "duration_ms": 3753
        }
      ]
    },
    {
      "index": 10,
      "text": "このこめについては、人によって違う説明をしています。",
      "start_ms": 72284,
      "end_ms": 77904,
      "duration_ms": 5620,
      "clauses": [
        {
          "index": 0,
          "text": "このこめについては、",
          "start_ms": 72284,
          "end_ms": 74342,
          "duration_ms": 2058
        },
        {
          "index": 1,
          "text": "人によって違う説明をしています。",
          "start_ms": 74592,
          "end_ms": 77904,
          "duration_ms": 3312
        }
      ]
    },
    {
      "index": 11,
      "text": "大切なのは、こめを手でまとめて持ちやすくすることを、にほんではとてもむかしからやっていることです。",
      "start_ms": 78404,
      "end_ms": 87505,
      "duration_ms": 9101,
      "clauses": [
        {
          "index": 0,
          "text": "大切なのは、",
          "start_ms": 78404,
          "end_ms": 80056,
          "duration_ms": 1652
        },
        {
          "index": 1,
          "text": "こめを手でまとめて持ちやすくすることを、",
          "start_ms": 80306,
          "end_ms": 83548,
          "duration_ms": 3242
        },
        {
          "index": 2,
          "text": "にほんではとてもむかしからやっていることです。",
          "start_ms": 83798,
          "end_ms": 87505,
          "duration_ms": 3707
        }
      ]
    },
    {
      "index": 12,
      "text": "むかしの本には、にほんごで「にぎりいい」と書かれたことばが出ています。",
      "start_ms": 88005,
      "end_ms": 93892,
      "duration_ms": 5887,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 88005,
          "end_ms": 89877,
          "duration_ms": 1872
        },
        {
          "index": 1,
          "text": "にほんごで「にぎりいい」と書かれたことばが出ています。",
          "start_ms": 90127,
          "end_ms": 93892,
          "duration_ms": 3765
        }
      ]
    },
    {
      "index": 13,
      "text": "人はたべものを持って会い、こめをみんなで食べていました。",
      "start_ms": 94392,
      "end_ms": 100163,
      "duration_ms": 5771,
      "clauses": [
        {
          "index": 0,
          "text": "人はたべものを持って会い、",
          "start_ms": 94392,
          "end_ms": 97263,
          "duration_ms": 2871
        },
        {
          "index": 1,
          "text": "こめをみんなで食べていました。",
          "start_ms": 97513,
          "end_ms": 100163,
          "duration_ms": 2650
        }
      ]
    },
    {
      "index": 14,
      "text": "その使い方は、とてもみじかなものでした。",
      "start_ms": 100663,
      "end_ms": 105377,
      "duration_ms": 4714,
      "clauses": [
        {
          "index": 0,
          "text": "その使い方は、",
          "start_ms": 100663,
          "end_ms": 102593,
          "duration_ms": 1930
        },
        {
          "index": 1,
          "text": "とてもみじかなものでした。",
          "start_ms": 102843,
          "end_ms": 105377,
          "duration_ms": 2534
        }
      ]
    },
    {
      "index": 15,
      "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
      "start_ms": 105877,
      "end_ms": 110814,
      "duration_ms": 4937,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
          "start_ms": 105877,
          "end_ms": 110814,
          "duration_ms": 4937
        }
      ]
    },
    {
      "index": 16,
      "text": "にほんではむかし、「にぎりいい」と言っていました。",
      "start_ms": 111314,
      "end_ms": 115750,
      "duration_ms": 4436,
      "clauses": [
        {
          "index": 0,
          "text": "にほんではむかし、",
          "start_ms": 111314,
          "end_ms": 113198,
          "duration_ms": 1884
        },
        {
          "index": 1,
          "text": "「にぎりいい」と言っていました。",
          "start_ms": 113448,
          "end_ms": 115750,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 17,
      "text": "「にぎりいい」が使われているうちに、「にぎりめし」というなまえのことばに換えました。",
      "start_ms": 116250,
      "end_ms": 122589,
      "duration_ms": 6339,
      "clauses": [
        {
          "index": 0,
          "text": "「にぎりいい」が使われているうちに、",
          "start_ms": 116250,
          "end_ms": 118923,
          "duration_ms": 2673
        },
        {
          "index": 1,
          "text": "「にぎりめし」というなまえのことばに換えました。",
          "start_ms": 119173,
          "end_ms": 122589,
          "duration_ms": 3416
        }
      ]
    },
    {
      "index": 18,
      "text": "さらに、けいごの「お」を付けたなまえが「おにぎり」です。",
      "start_ms": 123089,
      "end_ms": 127664,
      "duration_ms": 4575,
      "clauses": [
        {
          "index": 0,
          "text": "さらに、",
          "start_ms": 123089,
          "end_ms": 124218,
          "duration_ms": 1129
        },
        {
          "index": 1,
          "text": "けいごの「お」を付けたなまえが「おにぎり」です。",
          "start_ms": 124468,
          "end_ms": 127664,
          "duration_ms": 3196
        }
      ]
    },
    {
      "index": 19,
      "text": "「おにぎり」をせつめいすることばは、「おむすび」もあります。",
      "start_ms": 128164,
      "end_ms": 133122,
      "duration_ms": 4958,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」をせつめいすることばは、",
          "start_ms": 128164,
          "end_ms": 130826,
          "duration_ms": 2662
        },
        {
          "index": 1,
          "text": "「おむすび」もあります。",
          "start_ms": 131076,
          "end_ms": 133122,
          "duration_ms": 2046
        }
      ]
    },
    {
      "index": 20,
      "text": "「むすび」というなまえをみんなが使い始めたのは、えどじだいです。",
      "start_ms": 133622,
      "end_ms": 139637,
      "duration_ms": 6015,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」というなまえをみんなが使い始めたのは、",
          "start_ms": 133622,
          "end_ms": 137631,
          "duration_ms": 4009
        },
        {
          "index": 1,
          "text": "えどじだいです。",
          "start_ms": 137881,
          "end_ms": 139637,
          "duration_ms": 1756
        }
      ]
    },
    {
      "index": 21,
      "text": "そこにもけいごの「お」を付けました。",
      "start_ms": 140137,
      "end_ms": 142915,
      "duration_ms": 2778,
      "clauses": [
        {
          "index": 0,
          "text": "そこにもけいごの「お」を付けました。",
          "start_ms": 140137,
          "end_ms": 142915,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 22,
      "text": "むかしの本には、「むすび」を「にぎりいい」の別のなまえと書いて、「もとは女のことばです」とも書かれています。",
      "start_ms": 143415,
      "end_ms": 152772,
      "duration_ms": 9357,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 143415,
          "end_ms": 145276,
          "duration_ms": 1861
        },
        {
          "index": 1,
          "text": "「むすび」を「にぎりいい」の別のなまえと書いて、",
          "start_ms": 145526,
          "end_ms": 148815,
          "duration_ms": 3289
        },
        {
          "index": 2,
          "text": "「もとは女のことばです」とも書かれています。",
          "start_ms": 149065,
          "end_ms": 152772,
          "duration_ms": 3707
        }
      ]
    },
    {
      "index": 23,
      "text": "「むすび」は、なまえのいみをあらわすだけのことばではありません。",
      "start_ms": 153272,
      "end_ms": 158776,
      "duration_ms": 5504,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」は、",
          "start_ms": 153272,
          "end_ms": 154668,
          "duration_ms": 1396
        },
        {
          "index": 1,
          "text": "なまえのいみをあらわすだけのことばではありません。",
          "start_ms": 154918,
          "end_ms": 158776,
          "duration_ms": 3858
        }
      ]
    },
    {
      "index": 24,
      "text": "かみさまのなまえも、むかしの本に出ています。",
      "start_ms": 159276,
      "end_ms": 163920,
      "duration_ms": 4644,
      "clauses": [
        {
          "index": 0,
          "text": "かみさまのなまえも、",
          "start_ms": 159276,
          "end_ms": 161322,
          "duration_ms": 2046
        },
        {
          "index": 1,
          "text": "むかしの本に出ています。",
          "start_ms": 161572,
          "end_ms": 163920,
          "duration_ms": 2348
        }
      ]
    },
    {
      "index": 25,
      "text": "そこに、何かを作るいみとか、人と人がつながるいみとかが加わっているのです。",
      "start_ms": 164420,
      "end_ms": 172336,
      "duration_ms": 7916,
      "clauses": [
        {
          "index": 0,
          "text": "そこに、",
          "start_ms": 164420,
          "end_ms": 165596,
          "duration_ms": 1176
        },
        {
          "index": 1,
          "text": "何かを作るいみとか、",
          "start_ms": 165846,
          "end_ms": 168159,
          "duration_ms": 2313
        },
        {
          "index": 2,
          "text": "人と人がつながるいみとかが加わっているのです。",
          "start_ms": 168409,
          "end_ms": 172336,
          "duration_ms": 3927
        }
      ]
    },
    {
      "index": 26,
      "text": "つまり、「むすび」は、いみがさまざまに加わったことばということです。",
      "start_ms": 172836,
      "end_ms": 179893,
      "duration_ms": 7057,
      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 172836,
          "end_ms": 174105,
          "duration_ms": 1269
        },
        {
          "index": 1,
          "text": "「むすび」は、",
          "start_ms": 174355,
          "end_ms": 175809,
          "duration_ms": 1454
        },
        {
          "index": 2,
          "text": "いみがさまざまに加わったことばということです。",
          "start_ms": 176059,
          "end_ms": 179893,
          "duration_ms": 3834
        }
      ]
    },
    {
      "index": 27,
      "text": "もちろん、「むすび」というなまえがかみさまとつながっているとは言えません。",
      "start_ms": 180393,
      "end_ms": 186849,
      "duration_ms": 6456,
      "clauses": [
        {
          "index": 0,
          "text": "もちろん、",
          "start_ms": 180393,
          "end_ms": 181824,
          "duration_ms": 1431
        },
        {
          "index": 1,
          "text": "「むすび」というなまえがかみさまとつながっているとは言えません。",
          "start_ms": 182074,
          "end_ms": 186849,
          "duration_ms": 4775
        }
      ]
    },
    {
      "index": 28,
      "text": "でも、ことばのいみがさまざまに加わっていることにちゅうもくすると、この毎日のたべものがにほんに住む人にとって、大切ないみを持つのでしょう。",
      "start_ms": 187349,
      "end_ms": 200429,
      "duration_ms": 13080,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 187349,
          "end_ms": 188246,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "ことばのいみがさまざまに加わっていることにちゅうもくすると、",
          "start_ms": 188496,
          "end_ms": 193131,
          "duration_ms": 4635
        },
        {
          "index": 2,
          "text": "この毎日のたべものがにほんに住む人にとって、",
          "start_ms": 193381,
          "end_ms": 197552,
          "duration_ms": 4171
        },
        {
          "index": 3,
          "text": "大切ないみを持つのでしょう。",
          "start_ms": 197802,
          "end_ms": 200429,
          "duration_ms": 2627
        }
      ]
    },
    {
      "index": 29,
      "text": "こめを作る仕事は、一人では終わりません。",
      "start_ms": 200929,
      "end_ms": 205481,
      "duration_ms": 4552,
      "clauses": [
        {
          "index": 0,
          "text": "こめを作る仕事は、",
          "start_ms": 200929,
          "end_ms": 202987,
          "duration_ms": 2058
        },
        {
          "index": 1,
          "text": "一人では終わりません。",
          "start_ms": 203237,
          "end_ms": 205481,
          "duration_ms": 2244
        }
      ]
    },
    {
      "index": 30,
      "text": "みんなでみずを集め、みんなで使います。",
      "start_ms": 205981,
      "end_ms": 210173,
      "duration_ms": 4192,
      "clauses": [
        {
          "index": 0,
          "text": "みんなでみずを集め、",
          "start_ms": 205981,
          "end_ms": 208004,
          "duration_ms": 2023
        },
        {
          "index": 1,
          "text": "みんなで使います。",
          "start_ms": 208254,
          "end_ms": 210173,
          "duration_ms": 1919
        }
      ]
    },
    {
      "index": 31,
      "text": "みずをまもるのも、こめをうえるのも、みんなの仕事です。",
      "start_ms": 210673,
      "end_ms": 216860,
      "duration_ms": 6187,
      "clauses": [
        {
          "index": 0,
          "text": "みずをまもるのも、",
          "start_ms": 210673,
          "end_ms": 212592,
          "duration_ms": 1919
        },
        {
          "index": 1,
          "text": "こめをうえるのも、",
          "start_ms": 212842,
          "end_ms": 214610,
          "duration_ms": 1768
        },
        {
          "index": 2,
          "text": "みんなの仕事です。",
          "start_ms": 214860,
          "end_ms": 216860,
          "duration_ms": 2000
        }
      ]
    },
    {
      "index": 32,
      "text": "そして、作ったこめをみんなで食べるのに、とてもいいたべものが「おにぎり」です。",
      "start_ms": 217360,
      "end_ms": 224940,
      "duration_ms": 7580,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 217360,
          "end_ms": 218605,
          "duration_ms": 1245
        },
        {
          "index": 1,
          "text": "作ったこめをみんなで食べるのに、",
          "start_ms": 218855,
          "end_ms": 221842,
          "duration_ms": 2987
        },
        {
          "index": 2,
          "text": "とてもいいたべものが「おにぎり」です。",
          "start_ms": 222092,
          "end_ms": 224940,
          "duration_ms": 2848
        }
      ]
    },
    {
      "index": 33,
      "text": "じしんのとき、にほんではよく「おにぎり」が出ます。",
      "start_ms": 225440,
      "end_ms": 230491,
      "duration_ms": 5051,
      "clauses": [
        {
          "index": 0,
          "text": "じしんのとき、",
          "start_ms": 225440,
          "end_ms": 227196,
          "duration_ms": 1756
        },
        {
          "index": 1,
          "text": "にほんではよく「おにぎり」が出ます。",
          "start_ms": 227446,
          "end_ms": 230491,
          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 34,
      "text": "持ちやすく、作るのも楽で、食べるのに何も要りません。",
      "start_ms": 230991,
      "end_ms": 237606,
      "duration_ms": 6615,
      "clauses": [
        {
          "index": 0,
          "text": "持ちやすく、",
          "start_ms": 230991,
          "end_ms": 232561,
          "duration_ms": 1570
        },
        {
          "index": 1,
          "text": "作るのも楽で、",
          "start_ms": 232811,
          "end_ms": 234706,
          "duration_ms": 1895
        },
        {
          "index": 2,
          "text": "食べるのに何も要りません。",
          "start_ms": 234956,
          "end_ms": 237606,
          "duration_ms": 2650
        }
      ]
    },
    {
      "index": 35,
      "text": "みんなにおにぎりを与えました。",
      "start_ms": 238106,
      "end_ms": 240768,
      "duration_ms": 2662,
      "clauses": [
        {
          "index": 0,
          "text": "みんなにおにぎりを与えました。",
          "start_ms": 238106,
          "end_ms": 240768,
          "duration_ms": 2662
        }
      ]
    },
    {
      "index": 36,
      "text": "そのとき、人は人と人がつながることを知りました。",
      "start_ms": 241268,
      "end_ms": 246911,
      "duration_ms": 5643,
      "clauses": [
        {
          "index": 0,
          "text": "そのとき、",
          "start_ms": 241268,
          "end_ms": 242734,
          "duration_ms": 1466
        },
        {
          "index": 1,
          "text": "人は人と人がつながることを知りました。",
          "start_ms": 242984,
          "end_ms": 246911,
          "duration_ms": 3927
        }
      ]
    },
    {
      "index": 37,
      "text": "2000年、にほんでは1月17日を「おむすびの日」にしました。",
      "start_ms": 247411,
      "end_ms": 253936,
      "duration_ms": 6525,
      "clauses": [
        {
          "index": 0,
          "text": "2000年、",
          "start_ms": 247411,
          "end_ms": 248842,
          "duration_ms": 1431
        },
        {
          "index": 1,
          "text": "にほんでは1月17日を「おむすびの日」にしました。",
          "start_ms": 249092,
          "end_ms": 253936,
          "duration_ms": 4844
        }
      ]
    },
    {
      "index": 38,
      "text": "「おにぎり」ではなく「おむすび」というなまえを使ったのは、人と人がつながることを大切にしたからです。",
      "start_ms": 254436,
      "end_ms": 262483,
      "duration_ms": 8047,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ではなく「おむすび」というなまえを使ったのは、",
          "start_ms": 254436,
          "end_ms": 258317,
          "duration_ms": 3881
        },
        {
          "index": 1,
          "text": "人と人がつながることを大切にしたからです。",
          "start_ms": 258567,
          "end_ms": 262483,
          "duration_ms": 3916
        }
      ]
    },
    {
      "index": 39,
      "text": "にほんは、うみの近くにあって、やまが多いくにです。",
      "start_ms": 262983,
      "end_ms": 269089,
      "duration_ms": 6106,
      "clauses": [
        {
          "index": 0,
          "text": "にほんは、",
          "start_ms": 262983,
          "end_ms": 264368,
          "duration_ms": 1385
        },
        {
          "index": 1,
          "text": "うみの近くにあって、",
          "start_ms": 264618,
          "end_ms": 266688,
          "duration_ms": 2070
        },
        {
          "index": 2,
          "text": "やまが多いくにです。",
          "start_ms": 266938,
          "end_ms": 269089,
          "duration_ms": 2151
        }
      ]
    },
    {
      "index": 40,
      "text": "「おにぎり」を見ると、にほんのやまとうみのようすが分かります。",
      "start_ms": 269589,
      "end_ms": 274942,
      "duration_ms": 5353,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」を見ると、",
          "start_ms": 269589,
          "end_ms": 271496,
          "duration_ms": 1907
        },
        {
          "index": 1,
          "text": "にほんのやまとうみのようすが分かります。",
          "start_ms": 271746,
          "end_ms": 274942,
          "duration_ms": 3196
        }
      ]
    },
    {
      "index": 41,
      "text": "やまの近くに住む人はやさいを使い、うみの近くに住む人はさかなを使います。",
      "start_ms": 275442,
      "end_ms": 283036,
      "duration_ms": 7594,
      "clauses": [
        {
          "index": 0,
          "text": "やまの近くに住む人はやさいを使い、",
          "start_ms": 275442,
          "end_ms": 279021,
          "duration_ms": 3579
        },
        {
          "index": 1,
          "text": "うみの近くに住む人はさかなを使います。",
          "start_ms": 279271,
          "end_ms": 283036,
          "duration_ms": 3765
        }
      ]
    },
    {
      "index": 42,
      "text": "「おにぎり」の中には、やまとうみのたべものが入っています。",
      "start_ms": 283536,
      "end_ms": 288889,
      "duration_ms": 5353,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」の中には、",
          "start_ms": 283536,
          "end_ms": 285513,
          "duration_ms": 1977
        },
        {
          "index": 1,
          "text": "やまとうみのたべものが入っています。",
          "start_ms": 285763,
          "end_ms": 288889,
          "duration_ms": 3126
        }
      ]
    },
    {
      "index": 43,
      "text": "そのさまざまなおにぎりが、にほんのたべもののとくちょうを表しています。",
      "start_ms": 289389,
      "end_ms": 295763,
      "duration_ms": 6374,
      "clauses": [
        {
          "index": 0,
          "text": "そのさまざまなおにぎりが、",
          "start_ms": 289389,
          "end_ms": 291853,
          "duration_ms": 2464
        },
        {
          "index": 1,
          "text": "にほんのたべもののとくちょうを表しています。",
          "start_ms": 292103,
          "end_ms": 295763,
          "duration_ms": 3660
        }
      ]
    },
    {
      "index": 44,
      "text": "今は、ほかのくにのたべものも、むかしは知らなかったなかみも多くなっています。",
      "start_ms": 296263,
      "end_ms": 303703,
      "duration_ms": 7440,
      "clauses": [
        {
          "index": 0,
          "text": "今は、",
          "start_ms": 296263,
          "end_ms": 297183,
          "duration_ms": 920
        },
        {
          "index": 1,
          "text": "ほかのくにのたべものも、",
          "start_ms": 297433,
          "end_ms": 299677,
          "duration_ms": 2244
        },
        {
          "index": 2,
          "text": "むかしは知らなかったなかみも多くなっています。",
          "start_ms": 299927,
          "end_ms": 303703,
          "duration_ms": 3776
        }
      ]
    },
    {
      "index": 45,
      "text": "にほんのおにぎりは、さんかくけいがとても多いです。",
      "start_ms": 304203,
      "end_ms": 309242,
      "duration_ms": 5039,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのおにぎりは、",
          "start_ms": 304203,
          "end_ms": 306110,
          "duration_ms": 1907
        },
        {
          "index": 1,
          "text": "さんかくけいがとても多いです。",
          "start_ms": 306360,
          "end_ms": 309242,
          "duration_ms": 2882
        }
      ]
    },
    {
      "index": 46,
      "text": "コンビニのおにぎりになってから、そのようすが決まりました。",
      "start_ms": 309742,
      "end_ms": 314967,
      "duration_ms": 5225,
      "clauses": [
        {
          "index": 0,
          "text": "コンビニのおにぎりになってから、",
          "start_ms": 309742,
          "end_ms": 312311,
          "duration_ms": 2569
        },
        {
          "index": 1,
          "text": "そのようすが決まりました。",
          "start_ms": 312561,
          "end_ms": 314967,
          "duration_ms": 2406
        }
      ]
    },
    {
      "index": 47,
      "text": "さんかくけいは、持つ場合、壊さずに持ちやすいからです。",
      "start_ms": 315467,
      "end_ms": 321804,
      "duration_ms": 6337,
      "clauses": [
        {
          "index": 0,
          "text": "さんかくけいは、",
          "start_ms": 315467,
          "end_ms": 317188,
          "duration_ms": 1721
        },
        {
          "index": 1,
          "text": "持つ場合、",
          "start_ms": 317438,
          "end_ms": 318881,
          "duration_ms": 1443
        },
        {
          "index": 2,
          "text": "壊さずに持ちやすいからです。",
          "start_ms": 319131,
          "end_ms": 321804,
          "duration_ms": 2673
        }
      ]
    },
    {
      "index": 48,
      "text": "多く作って、多く運ぶのにも便利です。",
      "start_ms": 322304,
      "end_ms": 326809,
      "duration_ms": 4505,
      "clauses": [
        {
          "index": 0,
          "text": "多く作って、",
          "start_ms": 322304,
          "end_ms": 323944,
          "duration_ms": 1640
        },
        {
          "index": 1,
          "text": "多く運ぶのにも便利です。",
          "start_ms": 324194,
          "end_ms": 326809,
          "duration_ms": 2615
        }
      ]
    },
    {
      "index": 49,
      "text": "むかしは、にほんでも、ばしょによってようすが違いました。",
      "start_ms": 327309,
      "end_ms": 333495,
      "duration_ms": 6186,
      "clauses": [
        {
          "index": 0,
          "text": "むかしは、",
          "start_ms": 327309,
          "end_ms": 328647,
          "duration_ms": 1338
        },
        {
          "index": 1,
          "text": "にほんでも、",
          "start_ms": 328897,
          "end_ms": 330305,
          "duration_ms": 1408
        },
        {
          "index": 2,
          "text": "ばしょによってようすが違いました。",
          "start_ms": 330555,
          "end_ms": 333495,
          "duration_ms": 2940
        }
      ]
    },
    {
      "index": 50,
      "text": "今は、いろいろななかみを入れて、食べやすくするためのようすもあります。",
      "start_ms": 333995,
      "end_ms": 340784,
      "duration_ms": 6789,
      "clauses": [
        {
          "index": 0,
          "text": "今は、",
          "start_ms": 333995,
          "end_ms": 334915,
          "duration_ms": 920
        },
        {
          "index": 1,
          "text": "いろいろななかみを入れて、",
          "start_ms": 335165,
          "end_ms": 337478,
          "duration_ms": 2313
        },
        {
          "index": 2,
          "text": "食べやすくするためのようすもあります。",
          "start_ms": 337728,
          "end_ms": 340784,
          "duration_ms": 3056
        }
      ]
    },
    {
      "index": 51,
      "text": "にほんのおにぎりは、世界でもちゅうもくされています。",
      "start_ms": 341284,
      "end_ms": 346323,
      "duration_ms": 5039,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのおにぎりは、",
          "start_ms": 341284,
          "end_ms": 343249,
          "duration_ms": 1965
        },
        {
          "index": 1,
          "text": "世界でもちゅうもくされています。",
          "start_ms": 343499,
          "end_ms": 346323,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 52,
      "text": "おにぎりだけのみせがとても多くなっています。",
      "start_ms": 346823,
      "end_ms": 350599,
      "duration_ms": 3776,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりだけのみせがとても多くなっています。",
          "start_ms": 346823,
          "end_ms": 350599,
          "duration_ms": 3776
        }
      ]
    },
    {
      "index": 53,
      "text": "世界の人も食べるようになり、おにぎりをひょうかする人も多くなっています。",
      "start_ms": 351099,
      "end_ms": 357694,
      "duration_ms": 6595,
      "clauses": [
        {
          "index": 0,
          "text": "世界の人も食べるようになり、",
          "start_ms": 351099,
          "end_ms": 353784,
          "duration_ms": 2685
        },
        {
          "index": 1,
          "text": "おにぎりをひょうかする人も多くなっています。",
          "start_ms": 354034,
          "end_ms": 357694,
          "duration_ms": 3660
        }
      ]
    },
    {
      "index": 54,
      "text": "2024年、えいごの大きなじしょに「onigiri」が出ました。",
      "start_ms": 358194,
      "end_ms": 363291,
      "duration_ms": 5097,
      "clauses": [
        {
          "index": 0,
          "text": "2024年、",
          "start_ms": 358194,
          "end_ms": 360124,
          "duration_ms": 1930
        },
        {
          "index": 1,
          "text": "えいごの大きなじしょに「onigiri」が出ました。",
          "start_ms": 360374,
          "end_ms": 363291,
          "duration_ms": 2917
        }
      ]
    },
    {
      "index": 55,
      "text": "にほんごのなまえで知られたしょうこです。",
      "start_ms": 363791,
      "end_ms": 366929,
      "duration_ms": 3138,
      "clauses": [
        {
          "index": 0,
          "text": "にほんごのなまえで知られたしょうこです。",
          "start_ms": 363791,
          "end_ms": 366929,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 56,
      "text": "おにぎりは、いろいろなようすになり、世界にも広がっています。",
      "start_ms": 367429,
      "end_ms": 373975,
      "duration_ms": 6546,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 367429,
          "end_ms": 368895,
          "duration_ms": 1466
        },
        {
          "index": 1,
          "text": "いろいろなようすになり、",
          "start_ms": 369145,
          "end_ms": 371249,
          "duration_ms": 2104
        },
        {
          "index": 2,
          "text": "世界にも広がっています。",
          "start_ms": 371499,
          "end_ms": 373975,
          "duration_ms": 2476
        }
      ]
    },
    {
      "index": 57,
      "text": "でも、こめを手でまとめてみんなで食べるちゅうしんは、今もあります。",
      "start_ms": 374475,
      "end_ms": 381382,
      "duration_ms": 6907,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 374475,
          "end_ms": 375372,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "こめを手でまとめてみんなで食べるちゅうしんは、",
          "start_ms": 375622,
          "end_ms": 379445,
          "duration_ms": 3823
        },
        {
          "index": 2,
          "text": "今もあります。",
          "start_ms": 379695,
          "end_ms": 381382,
          "duration_ms": 1687
        }
      ]
    },
    {
      "index": 58,
      "text": "これからも、にほんのおにぎりはみんなに食べられていくでしょう。",
      "start_ms": 381882,
      "end_ms": 387549,
      "duration_ms": 5667,
      "clauses": [
        {
          "index": 0,
          "text": "これからも、",
          "start_ms": 381882,
          "end_ms": 383383,
          "duration_ms": 1501
        },
        {
          "index": 1,
          "text": "にほんのおにぎりはみんなに食べられていくでしょう。",
          "start_ms": 383633,
          "end_ms": 387549,
          "duration_ms": 3916
        }
      ]
    }
  ]
