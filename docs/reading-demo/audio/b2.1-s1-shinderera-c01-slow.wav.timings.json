          "start_ms": 148139,
          "end_ms": 150412,
          "duration_ms": 2273
        }
      ]
    },
    {
      "index": 27,
      "text": "それだけでは足りなくて、二人はできる限りのいじわるをしました。",
      "start_ms": 150912,
      "end_ms": 157483,
      "duration_ms": 6571,
      "clauses": [
        {
          "index": 0,
          "text": "それだけでは足りなくて、",
          "start_ms": 150912,
          "end_ms": 153428,
          "duration_ms": 2516
        },
        {
          "index": 1,
          "text": "二人はできる限りのいじわるをしました。",
          "start_ms": 153678,
          "end_ms": 157483,
          "duration_ms": 3805
        }
      ]
    },
    {
      "index": 28,
      "text": "娘をバカにして、灰の中にエンドウ豆やレンズ豆をまいたので、娘は一度座って豆を全部拾わなければなりませんでした。",
      "start_ms": 157983,
      "end_ms": 170630,
      "duration_ms": 12647,
      "clauses": [
        {
          "index": 0,
          "text": "娘をバカにして、",
          "start_ms": 157983,
          "end_ms": 160198,
          "duration_ms": 2215
        },
        {
          "index": 1,
          "text": "灰の中にエンドウ豆やレンズ豆をまいたので、",
          "start_ms": 160448,
          "end_ms": 164717,
          "duration_ms": 4269
        },
        {
          "index": 2,
          "text": "娘は一度座って豆を全部拾わなければなりませんでした。",
          "start_ms": 164967,
          "end_ms": 170630,
          "duration_ms": 5663
        }
      ]
    },
    {
      "index": 29,
      "text": "疲れるまで働いた夜には、ベッドがありませんでした。",
      "start_ms": 171130,
      "end_ms": 176820,
      "duration_ms": 5690,
      "clauses": [
        {
          "index": 0,
          "text": "疲れるまで働いた夜には、",
