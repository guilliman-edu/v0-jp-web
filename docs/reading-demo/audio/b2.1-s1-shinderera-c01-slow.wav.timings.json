          "text": "洗濯をしました。",
          "start_ms": 148428,
          "end_ms": 150631,
          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 27,
      "text": "それだけでは足りなくて、二人はできる限りのいじわるをしました。",
      "start_ms": 151131,
      "end_ms": 157795,
      "duration_ms": 6664,
      "clauses": [
        {
          "index": 0,
          "text": "それだけでは足りなくて、",
          "start_ms": 151131,
          "end_ms": 153659,
          "duration_ms": 2528
        },
        {
          "index": 1,
          "text": "二人はできる限りのいじわるをしました。",
          "start_ms": 153909,
          "end_ms": 157795,
          "duration_ms": 3886
        }
      ]
    },
    {
      "index": 28,
      "text": "娘をバカにして、灰の中にエンドウ豆やレンズ豆をまいたので、娘は一度座って豆を全部拾わなければなりませんでした。",
      "start_ms": 158295,
      "end_ms": 171128,
      "duration_ms": 12833,
      "clauses": [
        {
          "index": 0,
          "text": "娘をバカにして、",
          "start_ms": 158295,
          "end_ms": 160591,
          "duration_ms": 2296
        },
        {
          "index": 1,
          "text": "灰の中にエンドウ豆やレンズ豆をまいたので、",
          "start_ms": 160841,
          "end_ms": 165134,
          "duration_ms": 4293
        },
        {
          "index": 2,
          "text": "娘は一度座って豆を全部拾わなければなりませんでした。",
          "start_ms": 165384,
          "end_ms": 171128,
          "duration_ms": 5744
        }
      ]
    },
    {
      "index": 29,
      "text": "疲れるまで働いた夜には、ベッドがありませんでした。",
      "start_ms": 171628,
      "end_ms": 177364,
      "duration_ms": 5736,
      "clauses": [
        {
          "index": 0,
          "text": "疲れるまで働いた夜には、",
          "start_ms": 171628,
          "end_ms": 174574,
          "duration_ms": 2946
        },
        {
          "index": 1,
          "text": "ベッドがありませんでした。",
          "start_ms": 174824,
          "end_ms": 177364,
          "duration_ms": 2540
        }
      ]
    },
    {
      "index": 30,
      "text": "灰があるかまどのそばで寝なければなりませんでした。",
      "start_ms": 177864,
      "end_ms": 182308,
      "duration_ms": 4444,
      "clauses": [
        {
          "index": 0,
          "text": "灰があるかまどのそばで寝なければなりませんでした。",
          "start_ms": 177864,
          "end_ms": 182308,
          "duration_ms": 4444
        }
      ]
    },
    {
      "index": 31,
      "text": "だから、いつも埃をかぶって汚く見えたので、二人は娘を「はいかぶり」と呼びました。",
