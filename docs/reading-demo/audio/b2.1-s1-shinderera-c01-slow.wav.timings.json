          "start_ms": 3283,
          "end_ms": 7274,
          "duration_ms": 3991
        }
      ]
    },
    {
      "index": 2,
      "text": "とても具合が悪くて、もうすぐ死ぬということが分かりました。",
      "start_ms": 7774,
      "end_ms": 13811,
      "duration_ms": 6037,
      "clauses": [
        {
          "index": 0,
          "text": "とても具合が悪くて、",
          "start_ms": 7774,
          "end_ms": 10151,
          "duration_ms": 2377
        },
        {
          "index": 1,
          "text": "もうすぐ死ぬということが分かりました。",
          "start_ms": 10401,
          "end_ms": 13811,
          "duration_ms": 3410
        }
      ]
    },
    {
      "index": 3,
      "text": "それで、たった一人の娘をベッドのそばに呼んで、「愛しているわが子よ。",
      "start_ms": 14311,
      "end_ms": 22255,
      "duration_ms": 7944,
      "clauses": [
        {
          "index": 0,
          "text": "それで、",
          "start_ms": 14311,
          "end_ms": 15550,
          "duration_ms": 1239
        },
        {
          "index": 1,
          "text": "たった一人の娘をベッドのそばに呼んで、",
          "start_ms": 15800,
          "end_ms": 19802,
          "duration_ms": 4002
        },
        {
          "index": 2,
          "text": "「愛しているわが子よ。",
          "start_ms": 20052,
          "end_ms": 22255,
          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 4,
      "text": "いい子でいてね。",
      "start_ms": 22755,
      "end_ms": 24552,
      "duration_ms": 1797,
      "clauses": [
        {
          "index": 0,
          "text": "いい子でいてね。",
          "start_ms": 22755,
          "end_ms": 24552,
          "duration_ms": 1797
        }
      ]
    },
    {
      "index": 5,
      "text": "神様を信じているなら、神様はいつもあなたを守ってくれるよ。",
      "start_ms": 25052,
      "end_ms": 32064,
      "duration_ms": 7012,
      "clauses": [
        {
          "index": 0,
          "text": "神様を信じているなら、",
          "start_ms": 25052,
          "end_ms": 27812,
          "duration_ms": 2760
        },
        {
          "index": 1,
          "text": "神様はいつもあなたを守ってくれるよ。",
          "start_ms": 28062,
          "end_ms": 32064,
          "duration_ms": 4002
        }
      ]
    },
    {
      "index": 6,
      "text": "私は天国からあなたを見下ろしているからね。",
      "start_ms": 32564,
      "end_ms": 37066,
      "duration_ms": 4502,
      "clauses": [
        {
          "index": 0,
          "text": "私は天国からあなたを見下ろしているからね。",
          "start_ms": 32564,
          "end_ms": 37066,
          "duration_ms": 4502
        }
      ]
    },
    {
      "index": 7,
      "text": "」と言いました。",
      "start_ms": 37566,
      "end_ms": 39212,
      "duration_ms": 1646,
      "clauses": [
        {
          "index": 0,
          "text": "」と言いました。",
          "start_ms": 37566,
          "end_ms": 39212,
          "duration_ms": 1646
        }
      ]
    },
    {
      "index": 8,
      "text": "それから、目を閉じて亡くなりました。",
      "start_ms": 39712,
      "end_ms": 44170,
      "duration_ms": 4458,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 39712,
          "end_ms": 41253,
          "duration_ms": 1541
        },
        {
          "index": 1,
          "text": "目を閉じて亡くなりました。",
          "start_ms": 41503,
          "end_ms": 44170,
          "duration_ms": 2667
        }
      ]
    },
    {
      "index": 9,
      "text": "娘は毎日、母親の墓に行って泣きました。",
      "start_ms": 44670,
      "end_ms": 50266,
      "duration_ms": 5596,
      "clauses": [
