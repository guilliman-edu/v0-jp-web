          "start_ms": 79448,
          "end_ms": 82615,
          "duration_ms": 3167
        }
      ]
    },
    {
      "index": 15,
      "text": "それから、かわいそうな継子の辛い生活が始まりました。",
      "start_ms": 83115,
      "end_ms": 89454,
      "duration_ms": 6339,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 83115,
          "end_ms": 84679,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "かわいそうな継子の辛い生活が始まりました。",
          "start_ms": 84929,
          "end_ms": 89454,
          "duration_ms": 4525
        }
      ]
    },
    {
      "index": 16,
      "text": "「あの頭の悪い子が、私たちと一緒にここに座ってていいの？",
      "start_ms": 89954,
      "end_ms": 96456,
      "duration_ms": 6502,
      "clauses": [
        {
          "index": 0,
          "text": "「あの頭の悪い子が、",
          "start_ms": 89954,
          "end_ms": 92424,
          "duration_ms": 2470
        },
        {
          "index": 1,
          "text": "私たちと一緒にここに座ってていいの？",
          "start_ms": 92674,
          "end_ms": 96456,
          "duration_ms": 3782
        }
      ]
    },
    {
      "index": 17,
      "text": "ご飯が食べたいなら、自分の力で稼がなくちゃ。",
      "start_ms": 96956,
      "end_ms": 102599,
      "duration_ms": 5643,
      "clauses": [
        {
          "index": 0,
          "text": "ご飯が食べたいなら、",
          "start_ms": 96956,
          "end_ms": 99310,
          "duration_ms": 2354
        },
        {
          "index": 1,
          "text": "自分の力で稼がなくちゃ。",
          "start_ms": 99560,
          "end_ms": 102599,
          "duration_ms": 3039
        }
      ]
    },
    {
      "index": 18,
      "text": "台所女中は外よ。",
      "start_ms": 103099,
      "end_ms": 105824,
      "duration_ms": 2725,
      "clauses": [
        {
          "index": 0,
          "text": "台所女中は外よ。",
          "start_ms": 103099,
          "end_ms": 105824,
          "duration_ms": 2725
        }
      ]
    },
    {
      "index": 19,
      "text": "」二人の娘はそう言いました。",
      "start_ms": 106324,
      "end_ms": 109328,
      "duration_ms": 3004,
      "clauses": [
        {
          "index": 0,
          "text": "」二人の娘はそう言いました。",
          "start_ms": 106324,
          "end_ms": 109328,
          "duration_ms": 3004
        }
      ]
    },
    {
      "index": 20,
      "text": "二人の娘は、きれいな服を全部とりあげました。",
      "start_ms": 109828,
      "end_ms": 115483,
      "duration_ms": 5655,
      "clauses": [
        {
          "index": 0,
          "text": "二人の娘は、",
          "start_ms": 109828,
          "end_ms": 111857,
          "duration_ms": 2029
        },
        {
          "index": 1,
          "text": "きれいな服を全部とりあげました。",
          "start_ms": 112107,
          "end_ms": 115483,
          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 21,
      "text": "古い灰色の上着を着せて、木の靴をはかせました。",
      "start_ms": 115983,
      "end_ms": 121730,
      "duration_ms": 5747,
      "clauses": [
        {
          "index": 0,
          "text": "古い灰色の上着を着せて、",
          "start_ms": 115983,
          "end_ms": 118848,
          "duration_ms": 2865
        },
        {
          "index": 1,
          "text": "木の靴をはかせました。",
          "start_ms": 119098,
          "end_ms": 121730,
          "duration_ms": 2632
        }
      ]
    },
    {
      "index": 22,
      "text": "「高慢な王女様を見てごらん。",
      "start_ms": 122230,
      "end_ms": 125234,
      "duration_ms": 3004,
      "clauses": [
        {
          "index": 0,
          "text": "「高慢な王女様を見てごらん。",
          "start_ms": 122230,
          "end_ms": 125234,
          "duration_ms": 3004
        }
      ]
    },
    {
      "index": 23,
      "text": "なんておめかしているの。",
      "start_ms": 125734,
      "end_ms": 128134,
      "duration_ms": 2400,
      "clauses": [
        {
          "index": 0,
          "text": "なんておめかしているの。",
          "start_ms": 125734,
          "end_ms": 128134,
          "duration_ms": 2400
