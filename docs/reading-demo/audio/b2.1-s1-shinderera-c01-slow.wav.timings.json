          "start_ms": 79517,
          "end_ms": 82788,
          "duration_ms": 3271
        }
      ]
    },
    {
      "index": 15,
      "text": "それから、かわいそうな継子の辛い生活が始まりました。",
      "start_ms": 83288,
      "end_ms": 89639,
      "duration_ms": 6351,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 83288,
          "end_ms": 84864,
          "duration_ms": 1576
        },
        {
          "index": 1,
          "text": "かわいそうな継子の辛い生活が始まりました。",
          "start_ms": 85114,
          "end_ms": 89639,
          "duration_ms": 4525
        }
      ]
    },
    {
      "index": 16,
      "text": "「あの頭の悪い子が、私たちと一緒にここに座ってていいの？",
      "start_ms": 90139,
      "end_ms": 96734,
      "duration_ms": 6595,
      "clauses": [
        {
          "index": 0,
          "text": "「あの頭の悪い子が、",
          "start_ms": 90139,
          "end_ms": 92621,
          "duration_ms": 2482
        },
        {
          "index": 1,
          "text": "私たちと一緒にここに座ってていいの？",
          "start_ms": 92871,
          "end_ms": 96734,
          "duration_ms": 3863
        }
      ]
    },
    {
      "index": 17,
      "text": "ご飯が食べたいなら、自分の力で稼がなくちゃ。",
      "start_ms": 97234,
      "end_ms": 102900,
      "duration_ms": 5666,
      "clauses": [
        {
          "index": 0,
          "text": "ご飯が食べたいなら、",
          "start_ms": 97234,
          "end_ms": 99623,
          "duration_ms": 2389
        },
        {
          "index": 1,
          "text": "自分の力で稼がなくちゃ。",
          "start_ms": 99873,
          "end_ms": 102900,
          "duration_ms": 3027
        }
      ]
    },
    {
      "index": 18,
      "text": "台所女中は外よ。」",
      "start_ms": 103400,
      "end_ms": 106091,
      "duration_ms": 2691,
      "clauses": [
        {
          "index": 0,
          "text": "台所女中は外よ。」",
          "start_ms": 103400,
          "end_ms": 106091,
          "duration_ms": 2691
        }
      ]
    },
    {
      "index": 19,
      "text": "二人の娘はそう言いました。",
      "start_ms": 106591,
      "end_ms": 109734,
      "duration_ms": 3143,
      "clauses": [
        {
          "index": 0,
          "text": "二人の娘はそう言いました。",
          "start_ms": 106591,
          "end_ms": 109734,
          "duration_ms": 3143
        }
      ]
    },
    {
      "index": 20,
      "text": "二人の娘は、きれいな服を全部とりあげました。",
      "start_ms": 110234,
      "end_ms": 115900,
      "duration_ms": 5666,
      "clauses": [
        {
          "index": 0,
          "text": "二人の娘は、",
          "start_ms": 110234,
          "end_ms": 112309,
          "duration_ms": 2075
        },
        {
          "index": 1,
          "text": "きれいな服を全部とりあげました。",
          "start_ms": 112559,
          "end_ms": 115900,
          "duration_ms": 3341
        }
      ]
    },
    {
      "index": 21,
      "text": "古い灰色の上着を着せて、木の靴をはかせました。",
      "start_ms": 116400,
      "end_ms": 122135,
      "duration_ms": 5735,
      "clauses": [
        {
          "index": 0,
          "text": "古い灰色の上着を着せて、",
          "start_ms": 116400,
          "end_ms": 119276,
          "duration_ms": 2876
        },
        {
          "index": 1,
          "text": "木の靴をはかせました。",
          "start_ms": 119526,
          "end_ms": 122135,
          "duration_ms": 2609
        }
      ]
    },
    {
      "index": 22,
      "text": "「高慢な王女様を見てごらん。",
      "start_ms": 122635,
      "end_ms": 125593,
      "duration_ms": 2958,
      "clauses": [
        {
          "index": 0,
          "text": "「高慢な王女様を見てごらん。",
          "start_ms": 122635,
          "end_ms": 125593,
          "duration_ms": 2958
        }
      ]
    },
    {
      "index": 23,
      "text": "なんておめかしているの。」",
      "start_ms": 126093,
      "end_ms": 128424,
      "duration_ms": 2331,
      "clauses": [
        {
          "index": 0,
          "text": "なんておめかしているの。」",
          "start_ms": 126093,
          "end_ms": 128424,
          "duration_ms": 2331
        }
      ]
    },
    {
      "index": 24,
      "text": "と二人は笑いました。",
      "start_ms": 128924,
      "end_ms": 131359,
      "duration_ms": 2435,
      "clauses": [
        {
          "index": 0,
          "text": "と二人は笑いました。",
          "start_ms": 128924,
          "end_ms": 131359,
          "duration_ms": 2435
        }
      ]
    },
    {
      "index": 25,
      "text": "それから、娘は朝から晩まで辛い仕事をしなければなりませんでした。",
      "start_ms": 131859,
      "end_ms": 139336,
      "duration_ms": 7477,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 131859,
          "end_ms": 133435,
          "duration_ms": 1576
        },
        {
          "index": 1,
          "text": "娘は朝から晩まで辛い仕事をしなければなりませんでした。",
          "start_ms": 133685,
          "end_ms": 139336,
          "duration_ms": 5651
        }
      ]
    },
    {
      "index": 26,
      "text": "日の出前に起きて、水を汲んで、火をおこして、料理をして、洗濯をしました。",
      "start_ms": 139836,
      "end_ms": 150412,
      "duration_ms": 10576,
      "clauses": [
        {
          "index": 0,
          "text": "日の出前に起きて、",
          "start_ms": 139836,
          "end_ms": 141981,
          "duration_ms": 2145
        },
        {
          "index": 1,
          "text": "水を汲んで、",
          "start_ms": 142231,
          "end_ms": 143900,
          "duration_ms": 1669
        },
        {
          "index": 2,
          "text": "火をおこして、",
          "start_ms": 144150,
