          "text": "日の出前に起きて、",
          "start_ms": 139418,
          "end_ms": 141621,
          "duration_ms": 2203
        },
        {
          "index": 1,
          "text": "水を汲んで、",
          "start_ms": 141871,
          "end_ms": 143505,
          "duration_ms": 1634
        },
        {
          "index": 2,
          "text": "火をおこして、",
