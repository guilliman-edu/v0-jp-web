    },
    {
      "index": 1,
      "text": "金持ちの女の人が病気になりました。",
      "start_ms": 3330,
      "end_ms": 7286,
      "duration_ms": 3956,
      "clauses": [
        {
          "index": 0,
          "text": "金持ちの女の人が病気になりました。",
          "start_ms": 3330,
          "end_ms": 7286,
          "duration_ms": 3956
        }
      ]
    },
    {
      "index": 2,
      "text": "とても具合が悪くて、もうすぐ死ぬということが分かりました。",
      "start_ms": 7786,
      "end_ms": 13788,
      "duration_ms": 6002,
      "clauses": [
        {
          "index": 0,
          "text": "とても具合が悪くて、",
          "start_ms": 7786,
          "end_ms": 10093,
          "duration_ms": 2307
        },
        {
          "index": 1,
          "text": "もうすぐ死ぬということが分かりました。",
          "start_ms": 10343,
          "end_ms": 13788,
          "duration_ms": 3445
        }
      ]
    },
    {
      "index": 3,
      "text": "それで、たった一人の娘をベッドのそばに呼んで、「愛しているわが子よ。",
      "start_ms": 14288,
      "end_ms": 22244,
      "duration_ms": 7956,
      "clauses": [
        {
          "index": 0,
          "text": "それで、",
          "start_ms": 14288,
          "end_ms": 15585,
          "duration_ms": 1297
        },
        {
          "index": 1,
          "text": "たった一人の娘をベッドのそばに呼んで、",
          "start_ms": 15835,
          "end_ms": 19779,
          "duration_ms": 3944
        },
        {
          "index": 2,
          "text": "「愛しているわが子よ。",
          "start_ms": 20029,
          "end_ms": 22244,
          "duration_ms": 2215
        }
      ]
    },
    {
      "index": 4,
      "text": "いい子でいてね。",
      "start_ms": 22744,
      "end_ms": 24610,
      "duration_ms": 1866,
      "clauses": [
        {
          "index": 0,
          "text": "いい子でいてね。",
          "start_ms": 22744,
          "end_ms": 24610,
          "duration_ms": 1866
        }
      ]
    },
    {
      "index": 5,
      "text": "神様を信じているなら、神様はいつもあなたを守ってくれるよ。",
      "start_ms": 25110,
      "end_ms": 31983,
      "duration_ms": 6873,
      "clauses": [
        {
          "index": 0,
          "text": "神様を信じているなら、",
          "start_ms": 25110,
          "end_ms": 27812,
          "duration_ms": 2702
        },
        {
          "index": 1,
          "text": "神様はいつもあなたを守ってくれるよ。",
          "start_ms": 28062,
          "end_ms": 31983,
          "duration_ms": 3921
        }
      ]
    },
    {
      "index": 6,
      "text": "私は天国からあなたを見下ろしているからね。」",
      "start_ms": 32483,
      "end_ms": 37031,
      "duration_ms": 4548,
      "clauses": [
        {
          "index": 0,
          "text": "私は天国からあなたを見下ろしているからね。」",
          "start_ms": 32483,
          "end_ms": 37031,
          "duration_ms": 4548
        }
      ]
    },
    {
      "index": 7,
      "text": "と言いました。",
      "start_ms": 37531,
      "end_ms": 39235,
      "duration_ms": 1704,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 37531,
          "end_ms": 39235,
          "duration_ms": 1704
        }
      ]
    },
    {
      "index": 8,
      "text": "それから、目を閉じて亡くなりました。",
      "start_ms": 39735,
      "end_ms": 44286,
      "duration_ms": 4551,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 39735,
          "end_ms": 41334,
          "duration_ms": 1599
        },
        {
          "index": 1,
          "text": "目を閉じて亡くなりました。",
          "start_ms": 41584,
          "end_ms": 44286,
          "duration_ms": 2702
        }
      ]
    },
    {
      "index": 9,
      "text": "娘は毎日、母親の墓に行って泣きました。",
      "start_ms": 44786,
      "end_ms": 50301,
      "duration_ms": 5515,
      "clauses": [
        {
          "index": 0,
          "text": "娘は毎日、",
          "start_ms": 44786,
          "end_ms": 46919,
          "duration_ms": 2133
        },
        {
          "index": 1,
          "text": "母親の墓に行って泣きました。",
          "start_ms": 47169,
          "end_ms": 50301,
          "duration_ms": 3132
        }
      ]
    },
    {
      "index": 10,
      "text": "でも、いつもいい子でいました。",
      "start_ms": 50801,
      "end_ms": 54493,
      "duration_ms": 3692,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 50801,
          "end_ms": 51796,
          "duration_ms": 995
        },
        {
          "index": 1,
          "text": "いつもいい子でいました。",
          "start_ms": 52046,
          "end_ms": 54493,
          "duration_ms": 2447
        }
      ]
    },
    {
      "index": 11,
      "text": "冬になって、雪が墓の上に降りました。",
      "start_ms": 54993,
      "end_ms": 60206,
      "duration_ms": 5213,
      "clauses": [
        {
          "index": 0,
          "text": "冬になって、",
          "start_ms": 54993,
          "end_ms": 56720,
          "duration_ms": 1727
        },
        {
          "index": 1,
          "text": "雪が墓の上に降りました。",
          "start_ms": 56970,
          "end_ms": 60206,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 12,
      "text": "春の太陽が雪を溶かすころ、父は別の女の人を妻にもらいました。",
      "start_ms": 60706,
      "end_ms": 68462,
      "duration_ms": 7756,
      "clauses": [
        {
          "index": 0,
          "text": "春の太陽が雪を溶かすころ、",
          "start_ms": 60706,
          "end_ms": 63954,
          "duration_ms": 3248
        },
        {
          "index": 1,
          "text": "父は別の女の人を妻にもらいました。",
          "start_ms": 64204,
          "end_ms": 68462,
          "duration_ms": 4258
        }
      ]
    },
    {
      "index": 13,
      "text": "その女は自分の娘を二人一緒に連れてきました。",
      "start_ms": 68962,
      "end_ms": 74218,
      "duration_ms": 5256,
      "clauses": [
        {
          "index": 0,
          "text": "その女は自分の娘を二人一緒に連れてきました。",
          "start_ms": 68962,
          "end_ms": 74218,
          "duration_ms": 5256
        }
      ]
    },
    {
      "index": 14,
      "text": "二人の娘は顔はとても美しかったですが、心は汚くて真っ黒でした。",
      "start_ms": 74718,
      "end_ms": 82915,
      "duration_ms": 8197,
      "clauses": [
        {
          "index": 0,
          "text": "二人の娘は顔はとても美しかったですが、",
          "start_ms": 74718,
