          "start_ms": 128634,
          "end_ms": 131034,
          "duration_ms": 2400
        }
      ]
    },
    {
      "index": 25,
      "text": "それから、娘は朝から晩まで辛い仕事をしなければなりませんでした。",
      "start_ms": 131534,
      "end_ms": 138918,
      "duration_ms": 7384,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 131534,
          "end_ms": 133087,
          "duration_ms": 1553
        },
        {
          "index": 1,
          "text": "娘は朝から晩まで辛い仕事をしなければなりませんでした。",
          "start_ms": 133337,
          "end_ms": 138918,
          "duration_ms": 5581
        }
      ]
    },
    {
      "index": 26,
      "text": "日の出前に起きて、水を汲んで、火をおこして、料理をして、洗濯をしました。",
      "start_ms": 139418,
      "end_ms": 149993,
      "duration_ms": 10575,
      "clauses": [
        {
