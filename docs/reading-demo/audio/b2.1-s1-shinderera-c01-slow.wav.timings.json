          "duration_ms": 4711
        },
        {
          "index": 1,
          "text": "心は汚くて真っ黒でした。",
          "start_ms": 79679,
          "end_ms": 82915,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 15,
      "text": "それから、かわいそうな継子の辛い生活が始まりました。",
      "start_ms": 83415,
      "end_ms": 89777,
      "duration_ms": 6362,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 83415,
          "end_ms": 84979,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "かわいそうな継子の辛い生活が始まりました。",
          "start_ms": 85229,
          "end_ms": 89777,
          "duration_ms": 4548
        }
      ]
    },
    {
      "index": 16,
      "text": "「あの頭の悪い子が、私たちと一緒にここに座ってていいの？",
      "start_ms": 90277,
      "end_ms": 96930,
      "duration_ms": 6653,
      "clauses": [
        {
          "index": 0,
          "text": "「あの頭の悪い子が、",
          "start_ms": 90277,
          "end_ms": 92805,
          "duration_ms": 2528
        },
        {
          "index": 1,
          "text": "私たちと一緒にここに座ってていいの？",
          "start_ms": 93055,
          "end_ms": 96930,
          "duration_ms": 3875
        }
      ]
    },
    {
      "index": 17,
      "text": "ご飯が食べたいなら、自分の力で稼がなくちゃ。",
      "start_ms": 97430,
      "end_ms": 103119,
      "duration_ms": 5689,
      "clauses": [
        {
          "index": 0,
          "text": "ご飯が食べたいなら、",
          "start_ms": 97430,
          "end_ms": 99807,
          "duration_ms": 2377
        },
        {
          "index": 1,
          "text": "自分の力で稼がなくちゃ。",
          "start_ms": 100057,
          "end_ms": 103119,
          "duration_ms": 3062
        }
      ]
    },
    {
      "index": 18,
      "text": "台所女中は外よ。」",
      "start_ms": 103619,
      "end_ms": 106344,
      "duration_ms": 2725,
      "clauses": [
        {
          "index": 0,
          "text": "台所女中は外よ。」",
          "start_ms": 103619,
          "end_ms": 106344,
          "duration_ms": 2725
        }
      ]
    },
    {
      "index": 19,
      "text": "二人の娘はそう言いました。",
      "start_ms": 106844,
      "end_ms": 110034,
      "duration_ms": 3190,
      "clauses": [
        {
          "index": 0,
          "text": "二人の娘はそう言いました。",
          "start_ms": 106844,
          "end_ms": 110034,
          "duration_ms": 3190
        }
      ]
    },
    {
      "index": 20,
      "text": "二人の娘は、きれいな服を全部とりあげました。",
      "start_ms": 110534,
      "end_ms": 116177,
      "duration_ms": 5643,
      "clauses": [
        {
          "index": 0,
          "text": "二人の娘は、",
          "start_ms": 110534,
          "end_ms": 112621,
          "duration_ms": 2087
        },
        {
          "index": 1,
          "text": "きれいな服を全部とりあげました。",
          "start_ms": 112871,
          "end_ms": 116177,
          "duration_ms": 3306
        }
      ]
    },
    {
      "index": 21,
      "text": "古い灰色の上着を着せて、木の靴をはかせました。",
      "start_ms": 116677,
      "end_ms": 122320,
      "duration_ms": 5643,
      "clauses": [
        {
          "index": 0,
          "text": "古い灰色の上着を着せて、",
          "start_ms": 116677,
          "end_ms": 119530,
          "duration_ms": 2853
        },
        {
          "index": 1,
          "text": "木の靴をはかせました。",
          "start_ms": 119780,
          "end_ms": 122320,
          "duration_ms": 2540
        }
      ]
    },
    {
      "index": 22,
      "text": "「高慢な王女様を見てごらん。",
      "start_ms": 122820,
      "end_ms": 125847,
      "duration_ms": 3027,
      "clauses": [
        {
          "index": 0,
          "text": "「高慢な王女様を見てごらん。",
          "start_ms": 122820,
          "end_ms": 125847,
          "duration_ms": 3027
        }
      ]
    },
    {
      "index": 23,
      "text": "なんておめかしているの。」",
      "start_ms": 126347,
      "end_ms": 128712,
      "duration_ms": 2365,
      "clauses": [
        {
          "index": 0,
          "text": "なんておめかしているの。」",
          "start_ms": 126347,
          "end_ms": 128712,
          "duration_ms": 2365
        }
      ]
    },
    {
      "index": 24,
      "text": "と二人は笑いました。",
      "start_ms": 129212,
      "end_ms": 131659,
      "duration_ms": 2447,
      "clauses": [
        {
          "index": 0,
          "text": "と二人は笑いました。",
          "start_ms": 129212,
          "end_ms": 131659,
          "duration_ms": 2447
        }
      ]
    },
    {
      "index": 25,
      "text": "それから、娘は朝から晩まで辛い仕事をしなければなりませんでした。",
      "start_ms": 132159,
      "end_ms": 139590,
      "duration_ms": 7431,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 132159,
          "end_ms": 133747,
          "duration_ms": 1588
        },
        {
          "index": 1,
          "text": "娘は朝から晩まで辛い仕事をしなければなりませんでした。",
          "start_ms": 133997,
          "end_ms": 139590,
          "duration_ms": 5593
        }
      ]
    },
    {
      "index": 26,
      "text": "日の出前に起きて、水を汲んで、火をおこして、料理をして、洗濯をしました。",
      "start_ms": 140090,
      "end_ms": 150631,
      "duration_ms": 10541,
      "clauses": [
        {
          "index": 0,
          "text": "日の出前に起きて、",
          "start_ms": 140090,
          "end_ms": 142305,
          "duration_ms": 2215
        },
        {
          "index": 1,
          "text": "水を汲んで、",
          "start_ms": 142555,
          "end_ms": 144189,
          "duration_ms": 1634
        },
        {
          "index": 2,
          "text": "火をおこして、",
          "start_ms": 144439,
          "end_ms": 146189,
          "duration_ms": 1750
        },
        {
