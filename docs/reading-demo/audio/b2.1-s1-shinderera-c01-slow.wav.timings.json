          "duration_ms": 2203
        },
        {
          "index": 1,
          "text": "母親の墓に行って泣きました。",
          "start_ms": 47123,
          "end_ms": 50266,
          "duration_ms": 3143
        }
      ]
    },
    {
      "index": 10,
      "text": "でも、いつもいい子でいました。",
      "start_ms": 50766,
      "end_ms": 54412,
      "duration_ms": 3646,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 50766,
          "end_ms": 51785,
          "duration_ms": 1019
        },
        {
          "index": 1,
          "text": "いつもいい子でいました。",
          "start_ms": 52035,
          "end_ms": 54412,
          "duration_ms": 2377
        }
      ]
    },
    {
      "index": 11,
      "text": "冬になって、雪が墓の上に降りました。",
      "start_ms": 54912,
      "end_ms": 60137,
      "duration_ms": 5225,
      "clauses": [
        {
          "index": 0,
          "text": "冬になって、",
          "start_ms": 54912,
          "end_ms": 56674,
          "duration_ms": 1762
        },
        {
          "index": 1,
          "text": "雪が墓の上に降りました。",
          "start_ms": 56924,
          "end_ms": 60137,
          "duration_ms": 3213
        }
      ]
    },
    {
      "index": 12,
      "text": "春の太陽が雪を溶かすころ、父は別の女の人を妻にもらいました。",
      "start_ms": 60637,
      "end_ms": 68347,
      "duration_ms": 7710,
      "clauses": [
        {
          "index": 0,
          "text": "春の太陽が雪を溶かすころ、",
          "start_ms": 60637,
          "end_ms": 63920,
          "duration_ms": 3283
        },
        {
          "index": 1,
          "text": "父は別の女の人を妻にもらいました。",
          "start_ms": 64170,
          "end_ms": 68347,
          "duration_ms": 4177
        }
      ]
    },
    {
      "index": 13,
      "text": "その女は自分の娘を二人一緒に連れてきました。",
      "start_ms": 68847,
      "end_ms": 73918,
      "duration_ms": 5071,
      "clauses": [
        {
          "index": 0,
          "text": "その女は自分の娘を二人一緒に連れてきました。",
          "start_ms": 68847,
          "end_ms": 73918,
          "duration_ms": 5071
        }
      ]
    },
    {
      "index": 14,
      "text": "二人の娘は顔はとても美しかったですが、心は汚くて真っ黒でした。",
      "start_ms": 74418,
      "end_ms": 82615,
      "duration_ms": 8197,
      "clauses": [
        {
          "index": 0,
          "text": "二人の娘は顔はとても美しかったですが、",
