      "duration_ms": 9988,
      "clauses": [
        {
          "index": 0,
          "text": "それで、",
          "start_ms": 127641,
          "end_ms": 128950,
          "duration_ms": 1309
        },
        {
          "index": 1,
          "text": "はとごやを壊すために斧とつるはしを持ってこさせましたが、",
          "start_ms": 129200,
          "end_ms": 134363,
          "duration_ms": 5163
        },
        {
          "index": 2,
          "text": "誰も中にはいませんでした。",
          "start_ms": 134613,
          "end_ms": 137629,
          "duration_ms": 3016
        }
      ]
    },
    {
      "index": 24,
      "text": "みんなが帰ってきたとき、シンデレラは灰の中で汚い服を着て、薄暗いランプが暖炉の上で燃えていました。",
      "start_ms": 138129,
      "end_ms": 149313,
      "duration_ms": 11184,
      "clauses": [
        {
          "index": 0,
          "text": "みんなが帰ってきたとき、",
          "start_ms": 138129,
          "end_ms": 140669,
          "duration_ms": 2540
        },
        {
          "index": 1,
          "text": "シンデレラは灰の中で汚い服を着て、",
          "start_ms": 140919,
          "end_ms": 144805,
          "duration_ms": 3886
        },
        {
          "index": 2,
          "text": "薄暗いランプが暖炉の上で燃えていました。",
          "start_ms": 145055,
          "end_ms": 149313,
          "duration_ms": 4258
        }
      ]
    },
    {
      "index": 25,
      "text": "翌日、ぶとうかいがまた始まりました。",
      "start_ms": 149813,
