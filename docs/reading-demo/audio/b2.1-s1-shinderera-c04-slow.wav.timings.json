          "end_ms": 5080,
          "duration_ms": 2969
        },
        {
          "index": 1,
          "text": "シンデレラははしばみの木の下にある母親の墓に行きました。",
          "start_ms": 5330,
          "end_ms": 10714,
          "duration_ms": 5384
        }
      ]
    },
    {
      "index": 2,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 11214,
      "end_ms": 16431,
      "duration_ms": 5217,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 11214,
