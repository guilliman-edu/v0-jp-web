          "start_ms": 93689,
          "end_ms": 95369,
          "duration_ms": 1680
        }
      ]
    },
    {
      "index": 17,
      "text": "おうじは、このうつくしい娘が誰の娘か知りたかったからです。",
      "start_ms": 95869,
      "end_ms": 102696,
      "duration_ms": 6827,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは、",
