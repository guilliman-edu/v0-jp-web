      "end_ms": 119426,
      "duration_ms": 8746,
      "clauses": [
        {
          "index": 0,
          "text": "おうじが待っていると、",
          "start_ms": 110680,
          "end_ms": 112895,
          "duration_ms": 2215
        },
        {
          "index": 1,
