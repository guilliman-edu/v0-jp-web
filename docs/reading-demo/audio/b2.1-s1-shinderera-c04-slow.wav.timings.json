          "text": "娘は夕方まで踊りました。",
          "start_ms": 76185,
          "end_ms": 79328,
          "duration_ms": 3143
        }
      ]
    },
    {
      "index": 13,
      "text": "それから、家に帰ろうと思いました。",
      "start_ms": 79828,
      "end_ms": 84367,
      "duration_ms": 4539,
      "clauses": [
