          "text": "とても美しかったからです。",
          "start_ms": 48590,
          "end_ms": 51443,
          "duration_ms": 2853
        }
      ]
    },
    {
      "index": 8,
      "text": "おうじが娘に近づいて、手を取って一緒に踊りました。",
      "start_ms": 51943,
      "end_ms": 58178,
      "duration_ms": 6235,
      "clauses": [
        {
          "index": 0,
          "text": "おうじが娘に近づいて、",
          "start_ms": 51943,
          "end_ms": 54657,
          "duration_ms": 2714
        },
        {
          "index": 1,
          "text": "手を取って一緒に踊りました。",
          "start_ms": 54907,
          "end_ms": 58178,
          "duration_ms": 3271
        }
      ]
    },
    {
      "index": 9,
      "text": "他の娘とは踊ろうとせず、娘の手を放しませんでした。",
      "start_ms": 58678,
      "end_ms": 65319,
      "duration_ms": 6641,
      "clauses": [
        {
          "index": 0,
          "text": "他の娘とは踊ろうとせず、",
          "start_ms": 58678,
          "end_ms": 61914,
          "duration_ms": 3236
        },
        {
          "index": 1,
          "text": "娘の手を放しませんでした。",
          "start_ms": 62164,
          "end_ms": 65319,
          "duration_ms": 3155
        }
      ]
    },
    {
      "index": 10,
      "text": "他の誰かが娘に申し込もうとすると、おうじは「こちらは私の相手です。」",
      "start_ms": 65819,
      "end_ms": 73505,
      "duration_ms": 7686,
      "clauses": [
        {
          "index": 0,
          "text": "他の誰かが娘に申し込もうとすると、",
          "start_ms": 65819,
          "end_ms": 69705,
          "duration_ms": 3886
        },
        {
          "index": 1,
          "text": "おうじは「こちらは私の相手です。」",
          "start_ms": 69955,
          "end_ms": 73505,
          "duration_ms": 3550
        }
      ]
    },
    {
      "index": 11,
      "text": "と言いました。",
      "start_ms": 74005,
      "end_ms": 75685,
      "duration_ms": 1680,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 74005,
          "end_ms": 75685,
          "duration_ms": 1680
        }
      ]
    },
    {
      "index": 12,
      "text": "娘は夕方まで踊りました。",
