      "end_ms": 110180,
      "duration_ms": 7051,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 103129,
          "end_ms": 104113,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "娘はおうじから逃げて、",
