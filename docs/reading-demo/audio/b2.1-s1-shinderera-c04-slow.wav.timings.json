          "end_ms": 41234,
          "duration_ms": 2087
        },
        {
          "index": 2,
          "text": "「外国の王女様に違いない」と思いました。",
          "start_ms": 41484,
          "end_ms": 45637,
          "duration_ms": 4153
        }
      ]
    },
    {
      "index": 7,
      "text": "金のドレスを着て、とても美しかったからです。",
      "start_ms": 46137,
      "end_ms": 51443,
      "duration_ms": 5306,
      "clauses": [
        {
          "index": 0,
          "text": "金のドレスを着て、",
          "start_ms": 46137,
