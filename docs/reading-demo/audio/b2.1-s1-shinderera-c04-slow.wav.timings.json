          "end_ms": 5010,
          "duration_ms": 2911
        },
        {
          "index": 1,
          "text": "シンデレラははしばみの木の下にある母親の墓に行きました。",
          "start_ms": 5260,
          "end_ms": 10621,
          "duration_ms": 5361
        }
      ]
    },
    {
      "index": 2,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 11121,
      "end_ms": 16338,
      "duration_ms": 5217,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 11121,
          "end_ms": 12651,
          "duration_ms": 1530
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 12901,
          "end_ms": 14442,
          "duration_ms": 1541
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 14692,
          "end_ms": 16338,
          "duration_ms": 1646
        }
      ]
    },
    {
      "index": 3,
      "text": "銀と金を私に落としておくれ。」",
      "start_ms": 16838,
      "end_ms": 20318,
      "duration_ms": 3480,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。」",
          "start_ms": 16838,
          "end_ms": 20318,
          "duration_ms": 3480
        }
      ]
    },
    {
      "index": 4,
      "text": "すると、小鳥が金銀のドレスと、銀で刺しゅうされたうわぐつを落としてくれました。",
      "start_ms": 20818,
      "end_ms": 29355,
      "duration_ms": 8537,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 20818,
          "end_ms": 22046,
          "duration_ms": 1228
        },
        {
          "index": 1,
          "text": "小鳥が金銀のドレスと、",
          "start_ms": 22296,
          "end_ms": 25021,
          "duration_ms": 2725
        },
        {
          "index": 2,
          "text": "銀で刺しゅうされたうわぐつを落としてくれました。",
          "start_ms": 25271,
          "end_ms": 29355,
          "duration_ms": 4084
        }
      ]
    },
    {
      "index": 5,
      "text": "娘は急いでドレスを着て、ぶとうかいに行きました。",
      "start_ms": 29855,
      "end_ms": 35625,
      "duration_ms": 5770,
      "clauses": [
        {
          "index": 0,
          "text": "娘は急いでドレスを着て、",
          "start_ms": 29855,
          "end_ms": 32998,
          "duration_ms": 3143
        },
        {
          "index": 1,
          "text": "ぶとうかいに行きました。",
          "start_ms": 33248,
          "end_ms": 35625,
          "duration_ms": 2377
        }
      ]
    },
    {
      "index": 6,
      "text": "二人の姉やままははは、娘が分からず、「外国の王女様に違いない」と思いました。",
      "start_ms": 36125,
      "end_ms": 45475,
      "duration_ms": 9350,
      "clauses": [
        {
          "index": 0,
          "text": "二人の姉やままははは、",
          "start_ms": 36125,
          "end_ms": 38723,
          "duration_ms": 2598
        },
        {
          "index": 1,
          "text": "娘が分からず、",
          "start_ms": 38973,
          "end_ms": 41048,
          "duration_ms": 2075
        },
        {
          "index": 2,
          "text": "「外国の王女様に違いない」と思いました。",
          "start_ms": 41298,
          "end_ms": 45475,
          "duration_ms": 4177
        }
      ]
    },
    {
      "index": 7,
      "text": "金のドレスを着て、とても美しかったからです。",
      "start_ms": 45975,
      "end_ms": 51293,
      "duration_ms": 5318,
      "clauses": [
        {
          "index": 0,
          "text": "金のドレスを着て、",
          "start_ms": 45975,
          "end_ms": 48178,
          "duration_ms": 2203
        },
        {
          "index": 1,
          "text": "とても美しかったからです。",
          "start_ms": 48428,
          "end_ms": 51293,
          "duration_ms": 2865
        }
      ]
    },
    {
      "index": 8,
      "text": "おうじが娘に近づいて、手を取って一緒に踊りました。",
      "start_ms": 51793,
      "end_ms": 58051,
      "duration_ms": 6258,
      "clauses": [
        {
          "index": 0,
          "text": "おうじが娘に近づいて、",
          "start_ms": 51793,
          "end_ms": 54565,
          "duration_ms": 2772
        },
        {
          "index": 1,
          "text": "手を取って一緒に踊りました。",
          "start_ms": 54815,
          "end_ms": 58051,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 9,
      "text": "他の娘とは踊ろうとせず、娘の手を放しませんでした。",
      "start_ms": 58551,
      "end_ms": 65099,
      "duration_ms": 6548,
      "clauses": [
        {
          "index": 0,
          "text": "他の娘とは踊ろうとせず、",
          "start_ms": 58551,
          "end_ms": 61729,
          "duration_ms": 3178
        },
        {
          "index": 1,
          "text": "娘の手を放しませんでした。",
          "start_ms": 61979,
          "end_ms": 65099,
          "duration_ms": 3120
        }
      ]
    },
    {
      "index": 10,
      "text": "他の誰かが娘に申し込もうとすると、おうじは「こちらは私の相手です。」",
      "start_ms": 65599,
      "end_ms": 73262,
      "duration_ms": 7663,
      "clauses": [
        {
          "index": 0,
          "text": "他の誰かが娘に申し込もうとすると、",
          "start_ms": 65599,
          "end_ms": 69509,
          "duration_ms": 3910
        },
        {
          "index": 1,
          "text": "おうじは「こちらは私の相手です。」",
          "start_ms": 69759,
          "end_ms": 73262,
          "duration_ms": 3503
        }
      ]
    },
    {
      "index": 11,
      "text": "と言いました。",
      "start_ms": 73762,
      "end_ms": 75431,
      "duration_ms": 1669,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 73762,
          "end_ms": 75431,
          "duration_ms": 1669
        }
      ]
    },
    {
      "index": 12,
      "text": "娘は夕方まで踊りました。",
      "start_ms": 75931,
      "end_ms": 79086,
      "duration_ms": 3155,
      "clauses": [
        {
          "index": 0,
          "text": "娘は夕方まで踊りました。",
          "start_ms": 75931,
          "end_ms": 79086,
          "duration_ms": 3155
        }
      ]
    },
    {
      "index": 13,
      "text": "それから、家に帰ろうと思いました。",
      "start_ms": 79586,
      "end_ms": 84160,
      "duration_ms": 4574,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 79586,
          "end_ms": 81127,
          "duration_ms": 1541
        },
        {
          "index": 1,
          "text": "家に帰ろうと思いました。",
          "start_ms": 81377,
          "end_ms": 84160,
          "duration_ms": 2783
        }
      ]
    },
    {
      "index": 14,
      "text": "でも、おうじは「あなたと一緒に帰りたいです。",
      "start_ms": 84660,
      "end_ms": 89815,
      "duration_ms": 5155,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
