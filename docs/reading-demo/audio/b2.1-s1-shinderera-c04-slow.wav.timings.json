          "end_ms": 115162,
          "duration_ms": 2017
        },
        {
          "index": 2,
          "text": "「見知らぬ娘がはとごやに飛び込みました。」",
          "start_ms": 115412,
          "end_ms": 119426,
          "duration_ms": 4014
        }
      ]
    },
    {
      "index": 20,
      "text": "と言いました。",
      "start_ms": 119926,
      "end_ms": 121630,
      "duration_ms": 1704,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 119926,
          "end_ms": 121630,
          "duration_ms": 1704
        }
      ]
    },
    {
      "index": 21,
      "text": "父親は「シンデレラかな？」",
