          "end_ms": 216164,
          "duration_ms": 2342
        },
        {
          "index": 2,
          "text": "家の後ろの庭に入りました。",
          "start_ms": 216414,
          "end_ms": 219383,
          "duration_ms": 2969
        }
      ]
    },
    {
      "index": 35,
      "text": "庭に梨の実がついているうつくしい高い木がありました。",
      "start_ms": 219883,
      "end_ms": 224617,
      "duration_ms": 4734,
      "clauses": [
        {
          "index": 0,
          "text": "庭に梨の実がついているうつくしい高い木がありました。",
          "start_ms": 219883,
          "end_ms": 224617,
          "duration_ms": 4734
        }
      ]
    },
    {
      "index": 36,
      "text": "娘はリスのようにすばしっこく枝の間によじ登ったので、おうじはどこに消えたのか分かりませんでした。",
      "start_ms": 225117,
      "end_ms": 235357,
      "duration_ms": 10240,
      "clauses": [
        {
          "index": 0,
          "text": "娘はリスのようにすばしっこく枝の間によじ登ったので、",
          "start_ms": 225117,
          "end_ms": 230896,
          "duration_ms": 5779
        },
        {
          "index": 1,
          "text": "おうじはどこに消えたのか分かりませんでした。",
          "start_ms": 231146,
          "end_ms": 235357,
          "duration_ms": 4211
        }
      ]
    },
    {
      "index": 37,
      "text": "三日目、両親と姉たちが出かけると、シンデレラははしばみの木に行きました。",
      "start_ms": 235857,
      "end_ms": 244475,
      "duration_ms": 8618,
      "clauses": [
        {
          "index": 0,
          "text": "三日目、",
          "start_ms": 235857,
          "end_ms": 237154,
          "duration_ms": 1297
        },
        {
          "index": 1,
          "text": "両親と姉たちが出かけると、",
          "start_ms": 237404,
          "end_ms": 240780,
          "duration_ms": 3376
        },
        {
          "index": 2,
          "text": "シンデレラははしばみの木に行きました。",
          "start_ms": 241030,
          "end_ms": 244475,
          "duration_ms": 3445
        }
      ]
    },
    {
      "index": 38,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 244975,
      "end_ms": 250075,
      "duration_ms": 5100,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 244975,
          "end_ms": 246446,
          "duration_ms": 1471
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 246696,
          "end_ms": 248249,
          "duration_ms": 1553
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 248499,
          "end_ms": 250075,
          "duration_ms": 1576
        }
      ]
    },
    {
      "index": 39,
      "text": "銀と金を私に落としておくれ。」",
      "start_ms": 250575,
      "end_ms": 254043,
      "duration_ms": 3468,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。」",
          "start_ms": 250575,
          "end_ms": 254043,
          "duration_ms": 3468
        }
      ]
    },
    {
      "index": 40,
      "text": "今度の小鳥は、これまでのどのドレスよりもすばらしく豪華なドレスを落としてくれました。",
      "start_ms": 254543,
      "end_ms": 263239,
      "duration_ms": 8696,
      "clauses": [
        {
          "index": 0,
          "text": "今度の小鳥は、",
          "start_ms": 254543,
          "end_ms": 256583,
          "duration_ms": 2040
        },
        {
          "index": 1,
          "text": "これまでのどのドレスよりもすばらしく豪華なドレスを落としてくれました。",
          "start_ms": 256833,
          "end_ms": 263239,
          "duration_ms": 6406
        }
      ]
    },
    {
      "index": 41,
      "text": "うわぐつも金でした。",
      "start_ms": 263739,
      "end_ms": 266116,
      "duration_ms": 2377,
      "clauses": [
        {
          "index": 0,
          "text": "うわぐつも金でした。",
          "start_ms": 263739,
          "end_ms": 266116,
          "duration_ms": 2377
        }
      ]
    },
    {
      "index": 42,
      "text": "ぶとうかいに行くと、驚きのあまり誰もどうしていいか分かりませんでした。",
      "start_ms": 266616,
      "end_ms": 273699,
      "duration_ms": 7083,
      "clauses": [
        {
          "index": 0,
          "text": "ぶとうかいに行くと、",
          "start_ms": 266616,
          "end_ms": 268645,
          "duration_ms": 2029
        },
        {
          "index": 1,
          "text": "驚きのあまり誰もどうしていいか分かりませんでした。",
          "start_ms": 268895,
          "end_ms": 273699,
          "duration_ms": 4804
        }
      ]
    },
    {
      "index": 43,
      "text": "おうじは娘とだけ踊りました。",
      "start_ms": 274199,
      "end_ms": 277598,
      "duration_ms": 3399,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘とだけ踊りました。",
          "start_ms": 274199,
          "end_ms": 277598,
          "duration_ms": 3399
        }
      ]
    },
    {
      "index": 44,
      "text": "夕方になると、シンデレラは帰ろうとしました。",
      "start_ms": 278098,
      "end_ms": 283590,
      "duration_ms": 5492,
      "clauses": [
        {
          "index": 0,
          "text": "夕方になると、",
          "start_ms": 278098,
          "end_ms": 280162,
          "duration_ms": 2064
        },
        {
          "index": 1,
          "text": "シンデレラは帰ろうとしました。",
          "start_ms": 280412,
          "end_ms": 283590,
          "duration_ms": 3178
        }
      ]
    },
    {
      "index": 45,
      "text": "おうじは娘と一緒に行きたがりましたが、娘は素早く逃げました。",
      "start_ms": 284090,
      "end_ms": 291231,
      "duration_ms": 7141,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘と一緒に行きたがりましたが、",
          "start_ms": 284090,
          "end_ms": 287849,
          "duration_ms": 3759
        },
        {
          "index": 1,
          "text": "娘は素早く逃げました。",
          "start_ms": 288099,
          "end_ms": 291231,
          "duration_ms": 3132
        }
      ]
    },
    {
      "index": 46,
      "text": "でも、おうじはけいりゃくを練っていて、かいだんにピッチを塗らせておいたのです。",
      "start_ms": 291731,
      "end_ms": 299756,
      "duration_ms": 8025,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 291731,
          "end_ms": 292738,
          "duration_ms": 1007
        },
        {
          "index": 1,
          "text": "おうじはけいりゃくを練っていて、",
          "start_ms": 292988,
          "end_ms": 296038,
          "duration_ms": 3050
        },
        {
          "index": 2,
          "text": "かいだんにピッチを塗らせておいたのです。",
          "start_ms": 296288,
          "end_ms": 299756,
          "duration_ms": 3468
        }
      ]
    },
    {
      "index": 47,
      "text": "娘が駆け下りると、左のうわぐつがくっついて離れませんでした。",
      "start_ms": 300256,
      "end_ms": 306955,
      "duration_ms": 6699,
      "clauses": [
        {
          "index": 0,
          "text": "娘が駆け下りると、",
          "start_ms": 300256,
          "end_ms": 302656,
          "duration_ms": 2400
        },
        {
          "index": 1,
          "text": "左のうわぐつがくっついて離れませんでした。",
          "start_ms": 302906,
          "end_ms": 306955,
          "duration_ms": 4049
        }
      ]
    }
  ]
}