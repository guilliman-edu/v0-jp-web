          "duration_ms": 1518
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 12982,
          "end_ms": 14512,
          "duration_ms": 1530
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 14762,
          "end_ms": 16431,
          "duration_ms": 1669
        }
      ]
    },
    {
      "index": 3,
      "text": "銀と金を私に落としておくれ。」",
      "start_ms": 16931,
      "end_ms": 20434,
      "duration_ms": 3503,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。」",
          "start_ms": 16931,
          "end_ms": 20434,
          "duration_ms": 3503
        }
      ]
    },
    {
      "index": 4,
      "text": "すると、小鳥が金銀のドレスと、銀で刺しゅうされたうわぐつを落としてくれました。",
      "start_ms": 20934,
      "end_ms": 29587,
      "duration_ms": 8653,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 20934,
          "end_ms": 22185,
          "duration_ms": 1251
        },
        {
          "index": 1,
          "text": "小鳥が金銀のドレスと、",
          "start_ms": 22435,
          "end_ms": 25149,
          "duration_ms": 2714
        },
        {
          "index": 2,
          "text": "銀で刺しゅうされたうわぐつを落としてくれました。",
          "start_ms": 25399,
          "end_ms": 29587,
          "duration_ms": 4188
        }
      ]
    },
    {
      "index": 5,
      "text": "娘は急いでドレスを着て、ぶとうかいに行きました。",
      "start_ms": 30087,
      "end_ms": 35811,
      "duration_ms": 5724,
      "clauses": [
        {
          "index": 0,
          "text": "娘は急いでドレスを着て、",
          "start_ms": 30087,
          "end_ms": 33242,
          "duration_ms": 3155
        },
        {
          "index": 1,
          "text": "ぶとうかいに行きました。",
          "start_ms": 33492,
          "end_ms": 35811,
          "duration_ms": 2319
        }
      ]
    },
    {
      "index": 6,
      "text": "二人の姉やままははは、娘が分からず、「外国の王女様に違いない」と思いました。",
      "start_ms": 36311,
      "end_ms": 45637,
      "duration_ms": 9326,
      "clauses": [
        {
          "index": 0,
          "text": "二人の姉やままははは、",
          "start_ms": 36311,
          "end_ms": 38897,
          "duration_ms": 2586
        },
        {
          "index": 1,
          "text": "娘が分からず、",
