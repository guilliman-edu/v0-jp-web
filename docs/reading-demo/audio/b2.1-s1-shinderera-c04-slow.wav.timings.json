      "end_ms": 124879,
      "duration_ms": 2749,
      "clauses": [
        {
          "index": 0,
          "text": "父親は「シンデレラかな？」",
          "start_ms": 122130,
          "end_ms": 124879,
          "duration_ms": 2749
        }
      ]
    },
    {
      "index": 22,
      "text": "と思いました。",
