          "start_ms": 125379,
          "end_ms": 127141,
          "duration_ms": 1762
        }
      ]
    },
    {
      "index": 23,
      "text": "それで、はとごやを壊すために斧とつるはしを持ってこさせましたが、誰も中にはいませんでした。",
      "start_ms": 127641,
