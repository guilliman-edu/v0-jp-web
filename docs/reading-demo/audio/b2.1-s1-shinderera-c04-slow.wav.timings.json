          "end_ms": 85667,
          "duration_ms": 1007
        },
        {
          "index": 1,
          "text": "おうじは「あなたと一緒に帰りたいです。",
          "start_ms": 85917,
          "end_ms": 89815,
          "duration_ms": 3898
        }
      ]
    },
    {
      "index": 15,
      "text": "お伴いをさせてください。」",
      "start_ms": 90315,
      "end_ms": 93029,
      "duration_ms": 2714,
      "clauses": [
        {
          "index": 0,
          "text": "お伴いをさせてください。」",
          "start_ms": 90315,
          "end_ms": 93029,
          "duration_ms": 2714
        }
      ]
    },
    {
      "index": 16,
      "text": "と言いました。",
      "start_ms": 93529,
      "end_ms": 95233,
      "duration_ms": 1704,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 93529,
          "end_ms": 95233,
          "duration_ms": 1704
        }
      ]
    },
    {
      "index": 17,
      "text": "おうじは、このうつくしい娘が誰の娘か知りたかったからです。",
      "start_ms": 95733,
      "end_ms": 102629,
      "duration_ms": 6896,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは、",
          "start_ms": 95733,
          "end_ms": 97030,
          "duration_ms": 1297
        },
        {
          "index": 1,
          "text": "このうつくしい娘が誰の娘か知りたかったからです。",
          "start_ms": 97280,
          "end_ms": 102629,
          "duration_ms": 5349
        }
      ]
    },
    {
      "index": 18,
      "text": "でも、娘はおうじから逃げて、はとごやに飛び込みました。",
