    },
    {
      "index": 47,
      "text": "わたしは、おとうさんのともだちです。」",
      "start_ms": 185754,
      "end_ms": 190457,
      "duration_ms": 4703,
      "clauses": [
        {
          "index": 0,
          "text": "わたしは、",
          "start_ms": 185754,
          "end_ms": 187429,
          "duration_ms": 1675
        },
        {
          "index": 1,
          "text": "おとうさんのともだちです。」",
          "start_ms": 187679,
          "end_ms": 190457,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 48,
      "text": "チョウシロウはいいました。",
      "start_ms": 190957,
      "end_ms": 193584,
      "duration_ms": 2627,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはいいました。",
          "start_ms": 190957,
          "end_ms": 193584,
          "duration_ms": 2627
        }
      ]
    },
    {
      "index": 49,
      "text": "「いりません。",
      "start_ms": 194084,
      "end_ms": 195933,
      "duration_ms": 1849,
      "clauses": [
        {
          "index": 0,
          "text": "「いりません。",
          "start_ms": 194084,
          "end_ms": 195933,
          "duration_ms": 1849
        }
      ]
    },
    {
      "index": 50,
      "text": "おとうさんに、もうなにもいいたいことはありません。",
      "start_ms": 196433,
      "end_ms": 201867,
      "duration_ms": 5434,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんに、",
          "start_ms": 196433,
          "end_ms": 198247,
          "duration_ms": 1814
        },
        {
          "index": 1,
          "text": "もうなにもいいたいことはありません。",
          "start_ms": 198497,
          "end_ms": 201867,
          "duration_ms": 3370
        }
      ]
    },
    {
      "index": 51,
      "text": "さむらいはたいせつなともだちをおもって、どんなことになってもいいです。",
      "start_ms": 202367,
      "end_ms": 209729,
      "duration_ms": 7362,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいはたいせつなともだちをおもって、",
          "start_ms": 202367,
          "end_ms": 206492,
          "duration_ms": 4125
        },
        {
          "index": 1,
          "text": "どんなことになってもいいです。",
          "start_ms": 206742,
          "end_ms": 209729,
          "duration_ms": 2987
        }
      ]
    },
    {
      "index": 52,
      "text": "しょうぐんがわたしになにをしたいのか、よくわかります。",
      "start_ms": 210229,
      "end_ms": 216360,
      "duration_ms": 6131,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんがわたしになにをしたいのか、",
          "start_ms": 210229,
          "end_ms": 213901,
          "duration_ms": 3672
        },
        {
          "index": 1,
          "text": "よくわかります。",
          "start_ms": 214151,
          "end_ms": 216360,
          "duration_ms": 2209
        }
      ]
    },
    {
      "index": 53,
      "text": "わたしがこのいえをでるとき、みんながしります。",
      "start_ms": 216860,
      "end_ms": 222596,
      "duration_ms": 5736,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがこのいえをでるとき、",
          "start_ms": 216860,
          "end_ms": 220172,
          "duration_ms": 3312
        },
        {
          "index": 1,
          "text": "みんながしります。",
          "start_ms": 220422,
          "end_ms": 222596,
          "duration_ms": 2174
        }
      ]
    },
    {
      "index": 54,
      "text": "わたしがうそをつかなかったこと、そしてたけちよをおもってうそをついたことも、みんながしります。",
      "start_ms": 223096,
      "end_ms": 233868,
      "duration_ms": 10772,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがうそをつかなかったこと、",
          "start_ms": 223096,
          "end_ms": 226454,
          "duration_ms": 3358
        },
        {
          "index": 1,
          "text": "そしてたけちよをおもってうそをついたことも、",
          "start_ms": 226704,
          "end_ms": 231432,
          "duration_ms": 4728
        },
        {
          "index": 2,
          "text": "みんながしります。",
          "start_ms": 231682,
          "end_ms": 233868,
          "duration_ms": 2186
        }
      ]
    },
    {
      "index": 55,
      "text": "おとうさんにつたえることは、ひとつです。",
      "start_ms": 234368,
      "end_ms": 239291,
      "duration_ms": 4923,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんにつたえることは、",
          "start_ms": 234368,
          "end_ms": 237192,
          "duration_ms": 2824
        },
        {
          "index": 1,
          "text": "ひとつです。",
          "start_ms": 237442,
          "end_ms": 239291,
          "duration_ms": 1849
        }
      ]
    },
    {
      "index": 56,
      "text": "『わたしはたいせつなともだちをおもって、このいえをでました。』",
      "start_ms": 239791,
      "end_ms": 246340,
      "duration_ms": 6549,
      "clauses": [
        {
          "index": 0,
          "text": "『わたしはたいせつなともだちをおもって、",
          "start_ms": 239791,
          "end_ms": 243776,
          "duration_ms": 3985
        },
        {
          "index": 1,
          "text": "このいえをでました。』",
          "start_ms": 244026,
          "end_ms": 246340,
          "duration_ms": 2314
        }
      ]
    },
    {
      "index": 57,
      "text": "わたしがかなしいのは、おやのびょうきです。",
      "start_ms": 246840,
      "end_ms": 252053,
      "duration_ms": 5213,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがかなしいのは、",
          "start_ms": 246840,
          "end_ms": 249455,
          "duration_ms": 2615
        },
        {
          "index": 1,
          "text": "おやのびょうきです。",
          "start_ms": 249705,
          "end_ms": 252053,
          "duration_ms": 2348
        }
      ]
    },
    {
      "index": 58,
      "text": "これをきいて、おやのびょうきがひどくなります。」",
      "start_ms": 252553,
      "end_ms": 257929,
      "duration_ms": 5376,
      "clauses": [
        {
          "index": 0,
          "text": "これをきいて、",
          "start_ms": 252553,
          "end_ms": 254425,
          "duration_ms": 1872
        },
        {
          "index": 1,
          "text": "おやのびょうきがひどくなります。」",
          "start_ms": 254675,
          "end_ms": 257929,
          "duration_ms": 3254
        }
      ]
    },
    {
      "index": 59,
      "text": "ぶかはすごくかなしくなりました。",
      "start_ms": 258429,
      "end_ms": 261857,
      "duration_ms": 3428,
      "clauses": [
        {
          "index": 0,
          "text": "ぶかはすごくかなしくなりました。",
          "start_ms": 258429,
          "end_ms": 261857,
          "duration_ms": 3428
        }
      ]
    },
    {
      "index": 60,
      "text": "そして、チョウシロウをしょうぐんのまえへつれていきました。",
      "start_ms": 262357,
      "end_ms": 268326,
      "duration_ms": 5969,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 262357,
          "end_ms": 263858,
          "duration_ms": 1501
        },
        {
          "index": 1,
          "text": "チョウシロウをしょうぐんのまえへつれていきました。",
          "start_ms": 264108,
          "end_ms": 268326,
          "duration_ms": 4218
        }
      ]
    },
    {
      "index": 61,
      "text": "チョウシロウはすわりました。",
      "start_ms": 268826,
      "end_ms": 271871,
      "duration_ms": 3045,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはすわりました。",
          "start_ms": 268826,
          "end_ms": 271871,
          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 62,
      "text": "かみをなおしました。",
      "start_ms": 272371,
      "end_ms": 274777,
      "duration_ms": 2406,
      "clauses": [
        {
          "index": 0,
          "text": "かみをなおしました。",
          "start_ms": 272371,
          "end_ms": 274777,
          "duration_ms": 2406
        }
      ]
    },
    {
      "index": 63,
      "text": "こわくないかおをして、しょうぐんをまちました。",
      "start_ms": 275277,
      "end_ms": 280525,
      "duration_ms": 5248,
      "clauses": [
        {
          "index": 0,
          "text": "こわくないかおをして、",
          "start_ms": 275277,
          "end_ms": 277741,
          "duration_ms": 2464
        },
        {
          "index": 1,
          "text": "しょうぐんをまちました。",
          "start_ms": 277991,
          "end_ms": 280525,
          "duration_ms": 2534
        }
      ]
    },
    {
      "index": 64,
      "text": "しょうぐんはそのかおをみて、かたなをおきました。",
      "start_ms": 281025,
      "end_ms": 286703,
      "duration_ms": 5678,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはそのかおをみて、",
          "start_ms": 281025,
          "end_ms": 284128,
          "duration_ms": 3103
        },
        {
          "index": 1,
          "text": "かたなをおきました。",
          "start_ms": 284378,
          "end_ms": 286703,
          "duration_ms": 2325
        }
      ]
    },
    {
      "index": 65,
      "text": "しょうぐんはいいました。",
      "start_ms": 287203,
      "end_ms": 289691,
      "duration_ms": 2488,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはいいました。",
          "start_ms": 287203,
          "end_ms": 289691,
          "duration_ms": 2488
        }
      ]
    },
    {
      "index": 66,
      "text": "「チョウシロウ、もういいです。",
      "start_ms": 290191,
      "end_ms": 293954,
      "duration_ms": 3763,
      "clauses": [
        {
          "index": 0,
          "text": "「チョウシロウ、",
          "start_ms": 290191,
          "end_ms": 291785,
          "duration_ms": 1594
        },
        {
          "index": 1,
          "text": "もういいです。",
          "start_ms": 292035,
          "end_ms": 293954,
          "duration_ms": 1919
        }
      ]
    },
    {
      "index": 67,
      "text": "あなたはすごくいいこです。",
      "start_ms": 294454,
      "end_ms": 297441,
      "duration_ms": 2987,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはすごくいいこです。",
          "start_ms": 294454,
          "end_ms": 297441,
          "duration_ms": 2987
        }
      ]
    },
    {
      "index": 68,
      "text": "わたしはあなたのことを、よくしりました。",
      "start_ms": 297941,
      "end_ms": 303155,
      "duration_ms": 5214,
      "clauses": [
        {
          "index": 0,
          "text": "わたしはあなたのことを、",
          "start_ms": 297941,
          "end_ms": 300777,
          "duration_ms": 2836
        },
        {
          "index": 1,
          "text": "よくしりました。",
          "start_ms": 301027,
          "end_ms": 303155,
          "duration_ms": 2128
        }
      ]
    },
    {
      "index": 69,
      "text": "たけちよがしょうぐんになるとき、あなたは、いつもたけちよのそばにいてください。",
      "start_ms": 303655,
      "end_ms": 312617,
      "duration_ms": 8962,
      "clauses": [
        {
          "index": 0,
          "text": "たけちよがしょうぐんになるとき、",
          "start_ms": 303655,
          "end_ms": 306793,
          "duration_ms": 3138
        },
        {
          "index": 1,
          "text": "あなたは、",
          "start_ms": 307043,
          "end_ms": 308683,
          "duration_ms": 1640
        },
        {
          "index": 2,
          "text": "いつもたけちよのそばにいてください。",
          "start_ms": 308933,
          "end_ms": 312617,
          "duration_ms": 3684
        }
      ]
    },
    {
      "index": 70,
      "text": "あなたはたいせつなともだちです。",
      "start_ms": 313117,
      "end_ms": 316673,
      "duration_ms": 3556,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはたいせつなともだちです。",
          "start_ms": 313117,
          "end_ms": 316673,
          "duration_ms": 3556
        }
      ]
    },
    {
      "index": 71,
      "text": "あなたはもうじゆうです。」",
      "start_ms": 317173,
      "end_ms": 319951,
      "duration_ms": 2778,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうじゆうです。」",
          "start_ms": 317173,
          "end_ms": 319951,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 72,
      "text": "そのときから、ふたりはなかがいいともだちになりました。",
      "start_ms": 320451,
      "end_ms": 326571,
      "duration_ms": 6120,
      "clauses": [
        {
          "index": 0,
          "text": "そのときから、",
          "start_ms": 320451,
          "end_ms": 322428,
          "duration_ms": 1977
        },
        {
          "index": 1,
          "text": "ふたりはなかがいいともだちになりました。",
          "start_ms": 322678,
          "end_ms": 326571,
          "duration_ms": 3893
        }
      ]
    },
    {
      "index": 73,
      "text": "しょうぐんも、チョウシロウをたいせつにしました。",
      "start_ms": 327071,
      "end_ms": 332285,
      "duration_ms": 5214,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんも、",
          "start_ms": 327071,
          "end_ms": 328816,
          "duration_ms": 1745
        },
        {
          "index": 1,
          "text": "チョウシロウをたいせつにしました。",
          "start_ms": 329066,
          "end_ms": 332285,
          "duration_ms": 3219
        }
      ]
    },
    {
      "index": 74,
      "text": "ながいじかんのあとで、チョウシロウはおおきくなって、ゆうめいなひとになりました。",
      "start_ms": 332785,
      "end_ms": 341827,
      "duration_ms": 9042,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんのあとで、",
          "start_ms": 332785,
          "end_ms": 335249,
          "duration_ms": 2464
        },
        {
          "index": 1,
          "text": "チョウシロウはおおきくなって、",
          "start_ms": 335499,
          "end_ms": 338718,
          "duration_ms": 3219
        },
        {
          "index": 2,
          "text": "ゆうめいなひとになりました。",
          "start_ms": 338968,
          "end_ms": 341827,
          "duration_ms": 2859
        }
      ]
    },
    {
      "index": 75,
      "text": "みんなが、チョウシロウをおぼえています。",
      "start_ms": 342327,
      "end_ms": 347135,
      "duration_ms": 4808,
      "clauses": [
        {
          "index": 0,
          "text": "みんなが、",
          "start_ms": 342327,
          "end_ms": 343863,
          "duration_ms": 1536
        },
        {
          "index": 1,
          "text": "チョウシロウをおぼえています。",
          "start_ms": 344113,
