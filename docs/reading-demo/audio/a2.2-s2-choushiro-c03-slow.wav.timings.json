      "index": 47,
      "text": "わたしは、おとうさんのともだちです。」",
      "start_ms": 185177,
      "end_ms": 189949,
      "duration_ms": 4772,
      "clauses": [
        {
          "index": 0,
          "text": "わたしは、",
          "start_ms": 185177,
          "end_ms": 186875,
          "duration_ms": 1698
        },
        {
          "index": 1,
          "text": "おとうさんのともだちです。」",
          "start_ms": 187125,
          "end_ms": 189949,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 48,
      "text": "チョウシロウはいいました。",
      "start_ms": 190449,
      "end_ms": 193041,
      "duration_ms": 2592,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはいいました。",
          "start_ms": 190449,
          "end_ms": 193041,
          "duration_ms": 2592
        }
      ]
    },
    {
      "index": 49,
      "text": "「いりません。",
      "start_ms": 193541,
      "end_ms": 195379,
      "duration_ms": 1838,
      "clauses": [
        {
          "index": 0,
          "text": "「いりません。",
          "start_ms": 193541,
          "end_ms": 195379,
          "duration_ms": 1838
        }
      ]
    },
    {
      "index": 50,
      "text": "おとうさんに、もうなにもいいたいことはありません。",
      "start_ms": 195879,
      "end_ms": 201336,
      "duration_ms": 5457,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんに、",
          "start_ms": 195879,
          "end_ms": 197728,
          "duration_ms": 1849
        },
        {
          "index": 1,
          "text": "もうなにもいいたいことはありません。",
          "start_ms": 197978,
          "end_ms": 201336,
          "duration_ms": 3358
        }
      ]
    },
    {
      "index": 51,
      "text": "さむらいはたいせつなともだちをおもって、どんなことになってもいいです。",
      "start_ms": 201836,
      "end_ms": 209372,
      "duration_ms": 7536,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいはたいせつなともだちをおもって、",
          "start_ms": 201836,
          "end_ms": 206054,
          "duration_ms": 4218
        },
        {
          "index": 1,
          "text": "どんなことになってもいいです。",
          "start_ms": 206304,
          "end_ms": 209372,
          "duration_ms": 3068
        }
      ]
    },
    {
      "index": 52,
      "text": "しょうぐんがわたしになにをしたいのか、よくわかります。",
      "start_ms": 209872,
      "end_ms": 215922,
      "duration_ms": 6050,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんがわたしになにをしたいのか、",
          "start_ms": 209872,
          "end_ms": 213486,
          "duration_ms": 3614
        },
        {
          "index": 1,
          "text": "よくわかります。",
          "start_ms": 213736,
          "end_ms": 215922,
          "duration_ms": 2186
        }
      ]
    },
    {
      "index": 53,
      "text": "わたしがこのいえをでるとき、みんながしります。",
      "start_ms": 216422,
      "end_ms": 222158,
      "duration_ms": 5736,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがこのいえをでるとき、",
          "start_ms": 216422,
          "end_ms": 219757,
          "duration_ms": 3335
        },
        {
          "index": 1,
          "text": "みんながしります。",
          "start_ms": 220007,
          "end_ms": 222158,
          "duration_ms": 2151
        }
      ]
    },
    {
      "index": 54,
      "text": "わたしがうそをつかなかったこと、そしてたけちよをおもってうそをついたことも、みんながしります。",
      "start_ms": 222658,
      "end_ms": 233477,
      "duration_ms": 10819,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがうそをつかなかったこと、",
          "start_ms": 222658,
          "end_ms": 226051,
          "duration_ms": 3393
        },
        {
          "index": 1,
          "text": "そしてたけちよをおもってうそをついたことも、",
          "start_ms": 226301,
          "end_ms": 231018,
          "duration_ms": 4717
        },
        {
          "index": 2,
          "text": "みんながしります。",
          "start_ms": 231268,
          "end_ms": 233477,
          "duration_ms": 2209
        }
      ]
    },
    {
      "index": 55,
      "text": "おとうさんにつたえることは、ひとつです。",
      "start_ms": 233977,
      "end_ms": 238889,
      "duration_ms": 4912,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんにつたえることは、",
          "start_ms": 233977,
          "end_ms": 236836,
          "duration_ms": 2859
        },
        {
          "index": 1,
          "text": "ひとつです。",
          "start_ms": 237086,
          "end_ms": 238889,
          "duration_ms": 1803
        }
      ]
    },
    {
      "index": 56,
      "text": "『わたしはたいせつなともだちをおもって、このいえをでました。』",
      "start_ms": 239389,
      "end_ms": 245973,
      "duration_ms": 6584,
      "clauses": [
        {
          "index": 0,
          "text": "『わたしはたいせつなともだちをおもって、",
          "start_ms": 239389,
          "end_ms": 243351,
          "duration_ms": 3962
        },
        {
          "index": 1,
          "text": "このいえをでました。』",
          "start_ms": 243601,
          "end_ms": 245973,
          "duration_ms": 2372
        }
      ]
    },
    {
      "index": 57,
      "text": "わたしがかなしいのは、おやのびょうきです。",
      "start_ms": 246473,
      "end_ms": 251686,
      "duration_ms": 5213,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがかなしいのは、",
          "start_ms": 246473,
          "end_ms": 249088,
          "duration_ms": 2615
        },
        {
          "index": 1,
          "text": "おやのびょうきです。",
          "start_ms": 249338,
          "end_ms": 251686,
          "duration_ms": 2348
        }
      ]
    },
    {
      "index": 58,
      "text": "これをきいて、おやのびょうきがひどくなります。」",
      "start_ms": 252186,
      "end_ms": 257679,
      "duration_ms": 5493,
      "clauses": [
        {
          "index": 0,
          "text": "これをきいて、",
          "start_ms": 252186,
          "end_ms": 254105,
          "duration_ms": 1919
        },
        {
          "index": 1,
          "text": "おやのびょうきがひどくなります。」",
          "start_ms": 254355,
          "end_ms": 257679,
          "duration_ms": 3324
        }
      ]
    },
    {
      "index": 59,
      "text": "ぶかはすごくかなしくなりました。",
      "start_ms": 258179,
      "end_ms": 261572,
      "duration_ms": 3393,
      "clauses": [
        {
          "index": 0,
          "text": "ぶかはすごくかなしくなりました。",
          "start_ms": 258179,
          "end_ms": 261572,
          "duration_ms": 3393
        }
      ]
    },
    {
      "index": 60,
      "text": "そして、チョウシロウをしょうぐんのまえへつれていきました。",
      "start_ms": 262072,
      "end_ms": 268063,
      "duration_ms": 5991,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 262072,
          "end_ms": 263584,
          "duration_ms": 1512
        },
        {
          "index": 1,
          "text": "チョウシロウをしょうぐんのまえへつれていきました。",
          "start_ms": 263834,
          "end_ms": 268063,
          "duration_ms": 4229
        }
      ]
    },
    {
      "index": 61,
      "text": "チョウシロウはすわりました。",
      "start_ms": 268563,
      "end_ms": 271585,
      "duration_ms": 3022,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはすわりました。",
          "start_ms": 268563,
          "end_ms": 271585,
          "duration_ms": 3022
        }
      ]
    },
    {
      "index": 62,
      "text": "かみをなしました。",
      "start_ms": 272085,
      "end_ms": 274294,
      "duration_ms": 2209,
      "clauses": [
        {
          "index": 0,
          "text": "かみをなしました。",
          "start_ms": 272085,
          "end_ms": 274294,
          "duration_ms": 2209
        }
      ]
    },
    {
      "index": 63,
      "text": "こわくないかおをして、しょうぐんをまちました。",
      "start_ms": 274794,
      "end_ms": 280043,
      "duration_ms": 5249,
      "clauses": [
        {
          "index": 0,
          "text": "こわくないかおをして、",
          "start_ms": 274794,
          "end_ms": 277212,
          "duration_ms": 2418
        },
        {
          "index": 1,
          "text": "しょうぐんをまちました。",
          "start_ms": 277462,
          "end_ms": 280043,
          "duration_ms": 2581
        }
      ]
    },
    {
      "index": 64,
      "text": "しょうぐんはそのかおをみて、かたなをおきました。",
      "start_ms": 280543,
      "end_ms": 286291,
      "duration_ms": 5748,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはそのかおをみて、",
          "start_ms": 280543,
          "end_ms": 283704,
          "duration_ms": 3161
        },
        {
          "index": 1,
          "text": "かたなをおきました。",
          "start_ms": 283954,
          "end_ms": 286291,
          "duration_ms": 2337
        }
      ]
    },
    {
      "index": 65,
      "text": "しょうぐんはいいました。",
      "start_ms": 286791,
      "end_ms": 289232,
      "duration_ms": 2441,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはいいました。",
          "start_ms": 286791,
          "end_ms": 289232,
          "duration_ms": 2441
        }
      ]
    },
    {
      "index": 66,
      "text": "「チョウシロウ、もういいです。",
      "start_ms": 289732,
      "end_ms": 293460,
      "duration_ms": 3728,
      "clauses": [
        {
          "index": 0,
          "text": "「チョウシロウ、",
          "start_ms": 289732,
          "end_ms": 291372,
          "duration_ms": 1640
        },
        {
          "index": 1,
          "text": "もういいです。",
          "start_ms": 291622,
          "end_ms": 293460,
          "duration_ms": 1838
        }
      ]
    },
    {
      "index": 67,
      "text": "あなたはすごくいいこです。",
      "start_ms": 293960,
      "end_ms": 296866,
      "duration_ms": 2906,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはすごくいいこです。",
          "start_ms": 293960,
          "end_ms": 296866,
          "duration_ms": 2906
        }
      ]
    },
    {
      "index": 68,
      "text": "わたしはあなたのことを、よくしりました。",
      "start_ms": 297366,
      "end_ms": 302603,
      "duration_ms": 5237,
      "clauses": [
        {
          "index": 0,
          "text": "わたしはあなたのことを、",
          "start_ms": 297366,
          "end_ms": 300179,
          "duration_ms": 2813
        },
        {
          "index": 1,
          "text": "よくしりました。",
          "start_ms": 300429,
          "end_ms": 302603,
          "duration_ms": 2174
        }
      ]
    },
    {
      "index": 69,
      "text": "たけちよがしょうぐんになるとき、あなたは、いつもたけちよのそばにいてください。",
      "start_ms": 303103,
      "end_ms": 312041,
      "duration_ms": 8938,
      "clauses": [
        {
          "index": 0,
          "text": "たけちよがしょうぐんになるとき、",
          "start_ms": 303103,
          "end_ms": 306264,
          "duration_ms": 3161
        },
        {
          "index": 1,
          "text": "あなたは、",
          "start_ms": 306514,
          "end_ms": 308119,
          "duration_ms": 1605
        },
        {
          "index": 2,
          "text": "いつもたけちよのそばにいてください。",
          "start_ms": 308369,
          "end_ms": 312041,
          "duration_ms": 3672
        }
      ]
    },
    {
      "index": 70,
      "text": "あなたはたいせつなともだちです。",
      "start_ms": 312541,
      "end_ms": 316236,
      "duration_ms": 3695,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはたいせつなともだちです。",
          "start_ms": 312541,
          "end_ms": 316236,
          "duration_ms": 3695
        }
      ]
    },
    {
      "index": 71,
      "text": "あなたはもうじゆうです。」",
      "start_ms": 316736,
      "end_ms": 319514,
      "duration_ms": 2778,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうじゆうです。」",
          "start_ms": 316736,
          "end_ms": 319514,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 72,
      "text": "そのときから、ふたりはなかがいいともだちになりました。",
      "start_ms": 320014,
      "end_ms": 326145,
      "duration_ms": 6131,
      "clauses": [
        {
          "index": 0,
          "text": "そのときから、",
          "start_ms": 320014,
          "end_ms": 322014,
          "duration_ms": 2000
        },
        {
          "index": 1,
          "text": "ふたりはなかがいいともだちになりました。",
          "start_ms": 322264,
          "end_ms": 326145,
          "duration_ms": 3881
        }
      ]
    },
    {
      "index": 73,
      "text": "しょうぐんも、チョウシロウをたいせつにしました。",
      "start_ms": 326645,
      "end_ms": 331906,
      "duration_ms": 5261,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんも、",
          "start_ms": 326645,
          "end_ms": 328390,
          "duration_ms": 1745
        },
        {
          "index": 1,
          "text": "チョウシロウをたいせつにしました。",
          "start_ms": 328640,
          "end_ms": 331906,
          "duration_ms": 3266
        }
      ]
    },
    {
      "index": 74,
      "text": "ながいじかんのあとで、チョウシロウはおおきくなって、ゆうめいなひとになりました。",
      "start_ms": 332406,
      "end_ms": 341310,
      "duration_ms": 8904,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんのあとで、",
          "start_ms": 332406,
          "end_ms": 334929,
          "duration_ms": 2523
        },
        {
          "index": 1,
          "text": "チョウシロウはおおきくなって、",
          "start_ms": 335179,
          "end_ms": 338270,
          "duration_ms": 3091
        },
        {
          "index": 2,
          "text": "ゆうめいなひとになりました。",
          "start_ms": 338520,
          "end_ms": 341310,
          "duration_ms": 2790
        }
      ]
    },
    {
      "index": 75,
      "text": "みんなが、チョウシロウをおぼえています。",
      "start_ms": 341810,
      "end_ms": 346536,
      "duration_ms": 4726,
      "clauses": [
        {
          "index": 0,
          "text": "みんなが、",
          "start_ms": 341810,
          "end_ms": 343346,
          "duration_ms": 1536
        },
        {
          "index": 1,
          "text": "チョウシロウをおぼえています。",
          "start_ms": 343596,
          "end_ms": 346536,
          "duration_ms": 2940
        }
      ]
    }
  ]
