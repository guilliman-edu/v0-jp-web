      "index": 47,
      "text": "わたしは、おとうさんのともだちです。」",
      "start_ms": 185187,
      "end_ms": 189925,
      "duration_ms": 4738,
      "clauses": [
        {
          "index": 0,
          "text": "わたしは、",
          "start_ms": 185187,
          "end_ms": 186827,
          "duration_ms": 1640
        },
        {
          "index": 1,
          "text": "おとうさんのともだちです。」",
          "start_ms": 187077,
          "end_ms": 189925,
          "duration_ms": 2848
        }
      ]
    },
    {
      "index": 48,
      "text": "チョウシロウはいいました。",
      "start_ms": 190425,
      "end_ms": 193052,
      "duration_ms": 2627,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはいいました。",
          "start_ms": 190425,
          "end_ms": 193052,
          "duration_ms": 2627
        }
      ]
    },
    {
      "index": 49,
      "text": "「いりません。",
      "start_ms": 193552,
      "end_ms": 195390,
      "duration_ms": 1838,
      "clauses": [
        {
          "index": 0,
          "text": "「いりません。",
          "start_ms": 193552,
          "end_ms": 195390,
          "duration_ms": 1838
        }
      ]
    },
    {
      "index": 50,
      "text": "おとうさんに、もうなにもいいたいことはありません。",
      "start_ms": 195890,
      "end_ms": 201406,
      "duration_ms": 5516,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんに、",
          "start_ms": 195890,
          "end_ms": 197774,
          "duration_ms": 1884
        },
        {
          "index": 1,
          "text": "もうなにもいいたいことはありません。",
          "start_ms": 198024,
          "end_ms": 201406,
          "duration_ms": 3382
        }
      ]
    },
    {
      "index": 51,
      "text": "さむらいはたいせつなともだちをおもって、どんなことになってもいいです。",
      "start_ms": 201906,
      "end_ms": 209453,
      "duration_ms": 7547,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいはたいせつなともだちをおもって、",
          "start_ms": 201906,
          "end_ms": 206158,
          "duration_ms": 4252
        },
        {
          "index": 1,
          "text": "どんなことになってもいいです。",
          "start_ms": 206408,
          "end_ms": 209453,
          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 52,
      "text": "しょうぐんがわたしになにをしたいのか、よくわかります。",
      "start_ms": 209953,
      "end_ms": 215944,
      "duration_ms": 5991,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんがわたしになにをしたいのか、",
          "start_ms": 209953,
          "end_ms": 213578,
          "duration_ms": 3625
        },
        {
          "index": 1,
          "text": "よくわかります。",
          "start_ms": 213828,
          "end_ms": 215944,
          "duration_ms": 2116
        }
      ]
    },
    {
      "index": 53,
      "text": "わたしがこのいえをでるとき、みんながしります。",
      "start_ms": 216444,
      "end_ms": 222215,
      "duration_ms": 5771,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがこのいえをでるとき、",
          "start_ms": 216444,
          "end_ms": 219768,
          "duration_ms": 3324
        },
        {
          "index": 1,
          "text": "みんながしります。",
          "start_ms": 220018,
          "end_ms": 222215,
          "duration_ms": 2197
        }
      ]
    },
    {
      "index": 54,
      "text": "わたしがうそをつかなかったこと、そしてたけちよをおもってうそをついたことも、みんながしります。",
      "start_ms": 222715,
      "end_ms": 233395,
      "duration_ms": 10680,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがうそをつかなかったこと、",
          "start_ms": 222715,
          "end_ms": 226050,
          "duration_ms": 3335
        },
        {
          "index": 1,
          "text": "そしてたけちよをおもってうそをついたことも、",
          "start_ms": 226300,
          "end_ms": 230936,
          "duration_ms": 4636
        },
        {
          "index": 2,
          "text": "みんながしります。",
          "start_ms": 231186,
          "end_ms": 233395,
          "duration_ms": 2209
        }
      ]
    },
    {
      "index": 55,
      "text": "おとうさんにつたえることは、ひとつです。",
      "start_ms": 233895,
      "end_ms": 238749,
      "duration_ms": 4854,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんにつたえることは、",
          "start_ms": 233895,
          "end_ms": 236685,
          "duration_ms": 2790
        },
        {
          "index": 1,
          "text": "ひとつです。",
          "start_ms": 236935,
          "end_ms": 238749,
          "duration_ms": 1814
        }
      ]
    },
    {
      "index": 56,
      "text": "『わたしはたいせつなともだちをおもって、このいえをでました。』",
      "start_ms": 239249,
      "end_ms": 245891,
      "duration_ms": 6642,
      "clauses": [
        {
          "index": 0,
          "text": "『わたしはたいせつなともだちをおもって、",
          "start_ms": 239249,
          "end_ms": 243258,
          "duration_ms": 4009
        },
        {
          "index": 1,
          "text": "このいえをでました。』",
          "start_ms": 243508,
          "end_ms": 245891,
          "duration_ms": 2383
        }
      ]
    },
    {
      "index": 57,
      "text": "わたしがかなしいのは、おやのびょうきです。",
      "start_ms": 246391,
      "end_ms": 251558,
      "duration_ms": 5167,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがかなしいのは、",
          "start_ms": 246391,
          "end_ms": 248983,
          "duration_ms": 2592
        },
        {
          "index": 1,
          "text": "おやのびょうきです。",
          "start_ms": 249233,
          "end_ms": 251558,
          "duration_ms": 2325
        }
      ]
    },
    {
      "index": 58,
      "text": "これをきいて、おやのびょうきがひどくなります。」",
      "start_ms": 252058,
      "end_ms": 257434,
      "duration_ms": 5376,
      "clauses": [
        {
          "index": 0,
          "text": "これをきいて、",
          "start_ms": 252058,
          "end_ms": 253965,
          "duration_ms": 1907
        },
        {
          "index": 1,
          "text": "おやのびょうきがひどくなります。」",
          "start_ms": 254215,
          "end_ms": 257434,
          "duration_ms": 3219
        }
      ]
    },
    {
      "index": 59,
      "text": "ぶかはすごくかなしくなりました。",
      "start_ms": 257934,
      "end_ms": 261409,
      "duration_ms": 3475,
      "clauses": [
        {
          "index": 0,
          "text": "ぶかはすごくかなしくなりました。",
          "start_ms": 257934,
          "end_ms": 261409,
          "duration_ms": 3475
        }
      ]
    },
    {
      "index": 60,
      "text": "そして、チョウシロウをしょうぐんのまえへつれていきました。",
      "start_ms": 261909,
      "end_ms": 267936,
      "duration_ms": 6027,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 261909,
          "end_ms": 263445,
          "duration_ms": 1536
        },
        {
          "index": 1,
          "text": "チョウシロウをしょうぐんのまえへつれていきました。",
          "start_ms": 263695,
          "end_ms": 267936,
          "duration_ms": 4241
        }
      ]
    },
    {
      "index": 61,
      "text": "チョウシロウはすわりました。",
      "start_ms": 268436,
      "end_ms": 271481,
      "duration_ms": 3045,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはすわりました。",
          "start_ms": 268436,
          "end_ms": 271481,
          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 62,
      "text": "かみをなしました。",
      "start_ms": 271981,
      "end_ms": 274248,
      "duration_ms": 2267,
      "clauses": [
        {
          "index": 0,
          "text": "かみをなしました。",
          "start_ms": 271981,
          "end_ms": 274248,
          "duration_ms": 2267
        }
      ]
    },
    {
      "index": 63,
      "text": "こわくないかおをして、しょうぐんをまちました。",
      "start_ms": 274748,
      "end_ms": 280008,
      "duration_ms": 5260,
      "clauses": [
        {
          "index": 0,
          "text": "こわくないかおをして、",
          "start_ms": 274748,
          "end_ms": 277224,
          "duration_ms": 2476
        },
        {
          "index": 1,
          "text": "しょうぐんをまちました。",
          "start_ms": 277474,
          "end_ms": 280008,
          "duration_ms": 2534
        }
      ]
    },
    {
      "index": 64,
      "text": "しょうぐんはそのかおをみて、かたなをおきました。",
      "start_ms": 280508,
      "end_ms": 286255,
      "duration_ms": 5747,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはそのかおをみて、",
          "start_ms": 280508,
          "end_ms": 283599,
          "duration_ms": 3091
        },
        {
          "index": 1,
          "text": "かたなをおきました。",
          "start_ms": 283849,
          "end_ms": 286255,
          "duration_ms": 2406
        }
      ]
    },
    {
      "index": 65,
      "text": "しょうぐんはいいました。",
      "start_ms": 286755,
      "end_ms": 289266,
      "duration_ms": 2511,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはいいました。",
          "start_ms": 286755,
          "end_ms": 289266,
          "duration_ms": 2511
        }
      ]
    },
    {
      "index": 66,
      "text": "「チョウシロウ、もういいです。",
      "start_ms": 289766,
      "end_ms": 293529,
      "duration_ms": 3763,
      "clauses": [
        {
          "index": 0,
          "text": "「チョウシロウ、",
          "start_ms": 289766,
          "end_ms": 291418,
          "duration_ms": 1652
        },
        {
          "index": 1,
          "text": "もういいです。",
          "start_ms": 291668,
          "end_ms": 293529,
          "duration_ms": 1861
        }
      ]
    },
    {
      "index": 67,
      "text": "あなたはすごくいいこです。",
      "start_ms": 294029,
      "end_ms": 296853,
      "duration_ms": 2824,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはすごくいいこです。",
          "start_ms": 294029,
          "end_ms": 296853,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 68,
      "text": "わたしはあなたのことを、よくしりました。",
      "start_ms": 297353,
      "end_ms": 302567,
      "duration_ms": 5214,
      "clauses": [
        {
          "index": 0,
          "text": "わたしはあなたのことを、",
          "start_ms": 297353,
          "end_ms": 300201,
          "duration_ms": 2848
        },
        {
          "index": 1,
          "text": "よくしりました。",
          "start_ms": 300451,
          "end_ms": 302567,
          "duration_ms": 2116
        }
      ]
    },
    {
      "index": 69,
      "text": "たけちよがしょうぐんになるとき、あなたは、いつもたけちよのそばにいてください。",
      "start_ms": 303067,
      "end_ms": 311971,
      "duration_ms": 8904,
      "clauses": [
        {
          "index": 0,
          "text": "たけちよがしょうぐんになるとき、",
          "start_ms": 303067,
          "end_ms": 306193,
          "duration_ms": 3126
        },
        {
          "index": 1,
          "text": "あなたは、",
          "start_ms": 306443,
          "end_ms": 308072,
          "duration_ms": 1629
        },
        {
          "index": 2,
          "text": "いつもたけちよのそばにいてください。",
          "start_ms": 308322,
          "end_ms": 311971,
          "duration_ms": 3649
        }
      ]
    },
    {
      "index": 70,
      "text": "あなたはたいせつなともだちです。",
      "start_ms": 312471,
      "end_ms": 316050,
      "duration_ms": 3579,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはたいせつなともだちです。",
          "start_ms": 312471,
          "end_ms": 316050,
          "duration_ms": 3579
        }
      ]
    },
    {
      "index": 71,
      "text": "あなたはもうじゆうです。」",
      "start_ms": 316550,
      "end_ms": 319247,
      "duration_ms": 2697,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうじゆうです。」",
          "start_ms": 316550,
          "end_ms": 319247,
          "duration_ms": 2697
        }
      ]
    },
    {
      "index": 72,
      "text": "そのときから、ふたりはなかがいいともだちになりました。",
      "start_ms": 319747,
      "end_ms": 325890,
      "duration_ms": 6143,
      "clauses": [
        {
          "index": 0,
          "text": "そのときから、",
          "start_ms": 319747,
          "end_ms": 321759,
          "duration_ms": 2012
        },
        {
          "index": 1,
          "text": "ふたりはなかがいいともだちになりました。",
          "start_ms": 322009,
          "end_ms": 325890,
          "duration_ms": 3881
        }
      ]
    },
    {
      "index": 73,
      "text": "しょうぐんも、チョウシロウをたいせつにしました。",
      "start_ms": 326390,
      "end_ms": 331639,
      "duration_ms": 5249,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんも、",
          "start_ms": 326390,
          "end_ms": 328158,
          "duration_ms": 1768
        },
        {
          "index": 1,
          "text": "チョウシロウをたいせつにしました。",
          "start_ms": 328408,
          "end_ms": 331639,
          "duration_ms": 3231
        }
      ]
    },
    {
      "index": 74,
      "text": "ながいじかんのあとで、チョウシロウはおおきくなって、ゆうめいなひとになりました。",
      "start_ms": 332139,
      "end_ms": 341158,
      "duration_ms": 9019,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんのあとで、",
          "start_ms": 332139,
          "end_ms": 334603,
          "duration_ms": 2464
        },
        {
          "index": 1,
          "text": "チョウシロウはおおきくなって、",
          "start_ms": 334853,
          "end_ms": 338026,
          "duration_ms": 3173
        },
        {
          "index": 2,
          "text": "ゆうめいなひとになりました。",
          "start_ms": 338276,
          "end_ms": 341158,
          "duration_ms": 2882
        }
      ]
    },
    {
      "index": 75,
      "text": "みんなが、チョウシロウをおぼえています。",
      "start_ms": 341658,
      "end_ms": 346350,
      "duration_ms": 4692,
      "clauses": [
        {
          "index": 0,
          "text": "みんなが、",
          "start_ms": 341658,
          "end_ms": 343194,
          "duration_ms": 1536
        },
        {
          "index": 1,
          "text": "チョウシロウをおぼえています。",
          "start_ms": 343444,
          "end_ms": 346350,
          "duration_ms": 2906
        }
      ]
    }
  ]
