      "text": "わたしは、おとうさんのともだちです。",
      "start_ms": 185859,
      "end_ms": 190573,
      "duration_ms": 4714,
      "clauses": [
        {
          "index": 0,
          "text": "わたしは、",
          "start_ms": 185859,
          "end_ms": 187557,
          "duration_ms": 1698
        },
        {
          "index": 1,
          "text": "おとうさんのともだちです。",
          "start_ms": 187807,
          "end_ms": 190573,
          "duration_ms": 2766
        }
      ]
    },
    {
      "index": 48,
      "text": "」チョウシロウはいいました。",
      "start_ms": 191073,
      "end_ms": 193688,
      "duration_ms": 2615,
      "clauses": [
        {
          "index": 0,
          "text": "」チョウシロウはいいました。",
          "start_ms": 191073,
          "end_ms": 193688,
          "duration_ms": 2615
        }
      ]
    },
    {
      "index": 49,
      "text": "「いりません。",
      "start_ms": 194188,
      "end_ms": 196049,
      "duration_ms": 1861,
      "clauses": [
        {
          "index": 0,
          "text": "「いりません。",
          "start_ms": 194188,
          "end_ms": 196049,
          "duration_ms": 1861
        }
      ]
    },
    {
      "index": 50,
      "text": "おとうさんに、もうなにもいいたいことはありません。",
      "start_ms": 196549,
      "end_ms": 201972,
      "duration_ms": 5423,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんに、",
          "start_ms": 196549,
          "end_ms": 198410,
          "duration_ms": 1861
        },
        {
          "index": 1,
          "text": "もうなにもいいたいことはありません。",
          "start_ms": 198660,
          "end_ms": 201972,
          "duration_ms": 3312
        }
      ]
    },
    {
      "index": 51,
      "text": "さむらいはたいせつなともだちをおもって、どんなことになってもいいです。",
      "start_ms": 202472,
      "end_ms": 209938,
      "duration_ms": 7466,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいはたいせつなともだちをおもって、",
          "start_ms": 202472,
          "end_ms": 206643,
          "duration_ms": 4171
        },
        {
          "index": 1,
          "text": "どんなことになってもいいです。",
          "start_ms": 206893,
          "end_ms": 209938,
          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 52,
      "text": "しょうぐんがわたしになにをしたいのか、よくわかります。",
      "start_ms": 210438,
      "end_ms": 216488,
      "duration_ms": 6050,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんがわたしになにをしたいのか、",
          "start_ms": 210438,
          "end_ms": 214017,
          "duration_ms": 3579
        },
        {
          "index": 1,
          "text": "よくわかります。",
          "start_ms": 214267,
          "end_ms": 216488,
          "duration_ms": 2221
        }
      ]
    },
    {
      "index": 53,
      "text": "わたしがこのいえをでるとき、みんながしります。",
      "start_ms": 216988,
      "end_ms": 222701,
      "duration_ms": 5713,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがこのいえをでるとき、",
          "start_ms": 216988,
          "end_ms": 220300,
          "duration_ms": 3312
        },
        {
          "index": 1,
          "text": "みんながしります。",
          "start_ms": 220550,
          "end_ms": 222701,
          "duration_ms": 2151
        }
      ]
    },
    {
      "index": 54,
      "text": "わたしがうそをつかなかったこと、そしてたけちよをおもってうそをついたことも、みんながしります。",
      "start_ms": 223201,
      "end_ms": 233985,
      "duration_ms": 10784,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがうそをつかなかったこと、",
          "start_ms": 223201,
          "end_ms": 226571,
          "duration_ms": 3370
        },
        {
          "index": 1,
          "text": "そしてたけちよをおもってうそをついたことも、",
          "start_ms": 226821,
          "end_ms": 231503,
          "duration_ms": 4682
        },
        {
          "index": 2,
          "text": "みんながしります。",
          "start_ms": 231753,
          "end_ms": 233985,
          "duration_ms": 2232
        }
      ]
    },
    {
      "index": 55,
      "text": "おとうさんにつたえることは、ひとつです。",
      "start_ms": 234485,
      "end_ms": 239397,
      "duration_ms": 4912,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんにつたえることは、",
          "start_ms": 234485,
          "end_ms": 237321,
          "duration_ms": 2836
        },
        {
          "index": 1,
          "text": "ひとつです。",
          "start_ms": 237571,
          "end_ms": 239397,
          "duration_ms": 1826
        }
      ]
    },
    {
      "index": 56,
      "text": "『わたしはたいせつなともだちをおもって、このいえをでました。",
      "start_ms": 239897,
      "end_ms": 246214,
      "duration_ms": 6317,
      "clauses": [
        {
          "index": 0,
          "text": "『わたしはたいせつなともだちをおもって、",
          "start_ms": 239897,
          "end_ms": 243708,
          "duration_ms": 3811
        },
        {
          "index": 1,
          "text": "このいえをでました。",
          "start_ms": 243958,
          "end_ms": 246214,
          "duration_ms": 2256
        }
      ]
    },
    {
      "index": 57,
      "text": "』わたしがかなしいのは、おやのびょうきです。",
      "start_ms": 246714,
      "end_ms": 251882,
      "duration_ms": 5168,
      "clauses": [
        {
          "index": 0,
          "text": "』わたしがかなしいのは、",
          "start_ms": 246714,
          "end_ms": 249318,
          "duration_ms": 2604
        },
        {
          "index": 1,
          "text": "おやのびょうきです。",
          "start_ms": 249568,
          "end_ms": 251882,
          "duration_ms": 2314
        }
      ]
    },
    {
      "index": 58,
      "text": "これをきいて、おやのびょうきがひどくなります。",
      "start_ms": 252382,
      "end_ms": 257805,
      "duration_ms": 5423,
      "clauses": [
        {
          "index": 0,
          "text": "これをきいて、",
          "start_ms": 252382,
          "end_ms": 254278,
          "duration_ms": 1896
        },
        {
          "index": 1,
          "text": "おやのびょうきがひどくなります。",
          "start_ms": 254528,
          "end_ms": 257805,
          "duration_ms": 3277
        }
      ]
    },
    {
      "index": 59,
      "text": "」ぶかはすごくかなしくなりました。",
      "start_ms": 258305,
      "end_ms": 261803,
      "duration_ms": 3498,
      "clauses": [
        {
          "index": 0,
          "text": "」ぶかはすごくかなしくなりました。",
          "start_ms": 258305,
          "end_ms": 261803,
          "duration_ms": 3498
        }
      ]
    },
    {
      "index": 60,
      "text": "そして、チョウシロウをしょうぐんのまえへつれていきました。",
      "start_ms": 262303,
      "end_ms": 268353,
      "duration_ms": 6050,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 262303,
          "end_ms": 263827,
          "duration_ms": 1524
        },
        {
          "index": 1,
          "text": "チョウシロウをしょうぐんのまえへつれていきました。",
          "start_ms": 264077,
          "end_ms": 268353,
          "duration_ms": 4276
        }
      ]
    },
    {
      "index": 61,
      "text": "チョウシロウはすわりました。",
      "start_ms": 268853,
      "end_ms": 271863,
      "duration_ms": 3010,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはすわりました。",
          "start_ms": 268853,
          "end_ms": 271863,
          "duration_ms": 3010
        }
      ]
    },
    {
      "index": 62,
      "text": "かみをなしました。",
      "start_ms": 272363,
      "end_ms": 274665,
      "duration_ms": 2302,
      "clauses": [
        {
          "index": 0,
          "text": "かみをなしました。",
          "start_ms": 272363,
          "end_ms": 274665,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 63,
      "text": "こわくないかおをして、しょうぐんをまちました。",
      "start_ms": 275165,
      "end_ms": 280437,
      "duration_ms": 5272,
      "clauses": [
        {
          "index": 0,
          "text": "こわくないかおをして、",
          "start_ms": 275165,
          "end_ms": 277618,
          "duration_ms": 2453
        },
        {
          "index": 1,
          "text": "しょうぐんをまちました。",
          "start_ms": 277868,
          "end_ms": 280437,
          "duration_ms": 2569
        }
      ]
    },
    {
      "index": 64,
      "text": "しょうぐんはそのかおをみて、かたなをおきました。",
      "start_ms": 280937,
      "end_ms": 286697,
      "duration_ms": 5760,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはそのかおをみて、",
          "start_ms": 280937,
          "end_ms": 284075,
          "duration_ms": 3138
        },
        {
          "index": 1,
          "text": "かたなをおきました。",
          "start_ms": 284325,
          "end_ms": 286697,
          "duration_ms": 2372
        }
      ]
    },
    {
      "index": 65,
      "text": "しょうぐんはいいました。",
      "start_ms": 287197,
      "end_ms": 289708,
      "duration_ms": 2511,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはいいました。",
          "start_ms": 287197,
          "end_ms": 289708,
          "duration_ms": 2511
        }
      ]
    },
    {
      "index": 66,
      "text": "「チョウシロウ、もういいです。",
      "start_ms": 290208,
      "end_ms": 293994,
      "duration_ms": 3786,
      "clauses": [
        {
          "index": 0,
          "text": "「チョウシロウ、",
          "start_ms": 290208,
          "end_ms": 291860,
          "duration_ms": 1652
        },
        {
          "index": 1,
          "text": "もういいです。",
          "start_ms": 292110,
          "end_ms": 293994,
          "duration_ms": 1884
        }
      ]
    },
    {
      "index": 67,
      "text": "あなたはすごくいいこです。",
      "start_ms": 294494,
      "end_ms": 297493,
      "duration_ms": 2999,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはすごくいいこです。",
          "start_ms": 294494,
          "end_ms": 297493,
          "duration_ms": 2999
        }
      ]
    },
    {
      "index": 68,
      "text": "わたしはあなたのことを、よくしりました。",
      "start_ms": 297993,
      "end_ms": 303323,
      "duration_ms": 5330,
      "clauses": [
        {
          "index": 0,
          "text": "わたしはあなたのことを、",
          "start_ms": 297993,
          "end_ms": 300887,
          "duration_ms": 2894
        },
        {
          "index": 1,
          "text": "よくしりました。",
          "start_ms": 301137,
          "end_ms": 303323,
          "duration_ms": 2186
        }
      ]
    },
    {
      "index": 69,
      "text": "たけちよがしょうぐんになるとき、あなたは、いつもたけちよのそばにいてください。",
      "start_ms": 303823,
      "end_ms": 312761,
      "duration_ms": 8938,
      "clauses": [
        {
          "index": 0,
          "text": "たけちよがしょうぐんになるとき、",
          "start_ms": 303823,
          "end_ms": 306949,
          "duration_ms": 3126
        },
        {
          "index": 1,
          "text": "あなたは、",
          "start_ms": 307199,
          "end_ms": 308839,
          "duration_ms": 1640
        },
        {
          "index": 2,
          "text": "いつもたけちよのそばにいてください。",
          "start_ms": 309089,
          "end_ms": 312761,
          "duration_ms": 3672
        }
      ]
    },
    {
      "index": 70,
      "text": "あなたはたいせつなともだちです。",
      "start_ms": 313261,
      "end_ms": 316817,
      "duration_ms": 3556,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはたいせつなともだちです。",
          "start_ms": 313261,
          "end_ms": 316817,
          "duration_ms": 3556
        }
      ]
    },
    {
      "index": 71,
      "text": "あなたはもうじゆうです。",
      "start_ms": 317317,
      "end_ms": 320176,
      "duration_ms": 2859,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうじゆうです。",
          "start_ms": 317317,
          "end_ms": 320176,
          "duration_ms": 2859
        }
      ]
    },
    {
      "index": 72,
      "text": "」\n\nそのときから、ふたりはなかがいいともだちになりました。",
      "start_ms": 320676,
      "end_ms": 326830,
      "duration_ms": 6154,
      "clauses": [
        {
          "index": 0,
          "text": "」\n\nそのときから、",
          "start_ms": 320676,
          "end_ms": 322653,
          "duration_ms": 1977
        },
        {
          "index": 1,
          "text": "ふたりはなかがいいともだちになりました。",
          "start_ms": 322903,
          "end_ms": 326830,
          "duration_ms": 3927
        }
      ]
    },
    {
      "index": 73,
      "text": "しょうぐんも、チョウシロウをたいせつにしました。",
      "start_ms": 327330,
      "end_ms": 332614,
      "duration_ms": 5284,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんも、",
          "start_ms": 327330,
          "end_ms": 329098,
          "duration_ms": 1768
        },
        {
          "index": 1,
          "text": "チョウシロウをたいせつにしました。",
          "start_ms": 329348,
          "end_ms": 332614,
          "duration_ms": 3266
        }
      ]
    },
    {
      "index": 74,
      "text": "ながいじかんのあとで、チョウシロウはおおきくなって、ゆうめいなひとになりました。",
      "start_ms": 333114,
      "end_ms": 342098,
      "duration_ms": 8984,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんのあとで、",
          "start_ms": 333114,
          "end_ms": 335590,
          "duration_ms": 2476
        },
        {
          "index": 1,
          "text": "チョウシロウはおおきくなって、",
          "start_ms": 335840,
          "end_ms": 339024,
          "duration_ms": 3184
        },
        {
          "index": 2,
          "text": "ゆうめいなひとになりました。",
          "start_ms": 339274,
          "end_ms": 342098,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 75,
      "text": "みんなが、チョウシロウをおぼえています。",
      "start_ms": 342598,
      "end_ms": 347371,
      "duration_ms": 4773,
      "clauses": [
        {
          "index": 0,
          "text": "みんなが、",
          "start_ms": 342598,
          "end_ms": 344157,
          "duration_ms": 1559
        },
        {
          "index": 1,
          "text": "チョウシロウをおぼえています。",
          "start_ms": 344407,
          "end_ms": 347371,
          "duration_ms": 2964
        }
      ]
    }
  ]
