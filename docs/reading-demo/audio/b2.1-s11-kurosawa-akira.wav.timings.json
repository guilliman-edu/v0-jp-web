  "sentences": [
    {
      "index": 0,
      "text": "くろさわあきら — せかいで有名な映画を作った人",
      "start_ms": 0,
      "end_ms": 3962,
      "duration_ms": 3962,
      "clauses": [
        {
          "index": 0,
          "text": "くろさわあきら — せかいで有名な映画を作った人",
          "start_ms": 0,
          "end_ms": 3962,
          "duration_ms": 3962
        }
      ]
    },
    {
      "index": 1,
      "text": "くろさわあきらは1910年、とうきょうに生まれた。",
      "start_ms": 4462,
      "end_ms": 10035,
      "duration_ms": 5573,
      "clauses": [
        {
          "index": 0,
          "text": "くろさわあきらは1910年、",
          "start_ms": 4462,
          "end_ms": 7878,
          "duration_ms": 3416
        },
        {
          "index": 1,
          "text": "とうきょうに生まれた。",
          "start_ms": 8128,
          "end_ms": 10035,
          "duration_ms": 1907
        }
      ]
    },
    {
      "index": 2,
      "text": "八人のきょうだいがいた。",
      "start_ms": 10535,
      "end_ms": 12848,
      "duration_ms": 2313,
      "clauses": [
        {
          "index": 0,
          "text": "八人のきょうだいがいた。",
          "start_ms": 10535,
          "end_ms": 12848,
          "duration_ms": 2313
        }
      ]
    },
    {
      "index": 3,
      "text": "ちちは厳しかったが、映画に興味があり、よくきょうだいをえいがかんに連れて行った。",
      "start_ms": 13348,
      "end_ms": 21333,
      "duration_ms": 7985,
      "clauses": [
        {
          "index": 0,
          "text": "ちちは厳しかったが、",
          "start_ms": 13348,
          "end_ms": 15580,
          "duration_ms": 2232
        },
        {
          "index": 1,
          "text": "映画に興味があり、",
          "start_ms": 15830,
          "end_ms": 17818,
          "duration_ms": 1988
        },
        {
          "index": 2,
          "text": "よくきょうだいをえいがかんに連れて行った。",
          "start_ms": 18068,
          "end_ms": 21333,
          "duration_ms": 3265
        }
      ]
    },
    {
      "index": 4,
      "text": "黒澤は若いときから映画を見ながら育った。",
      "start_ms": 21833,
      "end_ms": 25725,
      "duration_ms": 3892,
      "clauses": [
        {
          "index": 0,
          "text": "黒澤は若いときから映画を見ながら育った。",
          "start_ms": 21833,
          "end_ms": 25725,
          "duration_ms": 3892
        }
      ]
    },
    {
      "index": 5,
      "text": "小学校の先生は、黒澤のかいがを「とてもいい」と言ってくれた。",
      "start_ms": 26225,
      "end_ms": 32390,
      "duration_ms": 6165,
      "clauses": [
        {
          "index": 0,
          "text": "小学校の先生は、",
          "start_ms": 26225,
          "end_ms": 28538,
          "duration_ms": 2313
        },
        {
          "index": 1,
          "text": "黒澤のかいがを「とてもいい」と言ってくれた。",
          "start_ms": 28788,
          "end_ms": 32390,
          "duration_ms": 3602
        }
      ]
    },
    {
      "index": 6,
      "text": "それから、黒澤はかいがを描くことにむちゅうになった。",
      "start_ms": 32890,
      "end_ms": 38544,
      "duration_ms": 5654,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 32890,
          "end_ms": 34309,
          "duration_ms": 1419
        },
        {
          "index": 1,
          "text": "黒澤はかいがを描くことにむちゅうになった。",
          "start_ms": 34559,
          "end_ms": 38544,
          "duration_ms": 3985
        }
      ]
    },
    {
      "index": 7,
      "text": "学校ではしょうせつをたくさん読み、じんせいについても勉強した。",
      "start_ms": 39044,
      "end_ms": 45117,
      "duration_ms": 6073,
      "clauses": [
        {
          "index": 0,
          "text": "学校ではしょうせつをたくさん読み、",
          "start_ms": 39044,
          "end_ms": 42054,
          "duration_ms": 3010
        },
        {
          "index": 1,
          "text": "じんせいについても勉強した。",
          "start_ms": 42304,
          "end_ms": 45117,
          "duration_ms": 2813
        }
      ]
    },
    {
      "index": 8,
      "text": "はじめはかいがの仕事をしたいと思っていた。",
      "start_ms": 45617,
      "end_ms": 49521,
      "duration_ms": 3904,
      "clauses": [
        {
          "index": 0,
          "text": "はじめはかいがの仕事をしたいと思っていた。",
          "start_ms": 45617,
          "end_ms": 49521,
          "duration_ms": 3904
        }
      ]
    },
    {
      "index": 9,
      "text": "しかし、1936年に映画のかいしゃに入り、映画を作る人のそばで作り方を習った。",
      "start_ms": 50021,
      "end_ms": 59540,
      "duration_ms": 9519,
      "clauses": [
        {
          "index": 0,
          "text": "しかし、",
          "start_ms": 50021,
          "end_ms": 51313,
          "duration_ms": 1292
        },
        {
          "index": 1,
          "text": "1936年に映画のかいしゃに入り、",
          "start_ms": 51563,
          "end_ms": 55583,
          "duration_ms": 4020
        },
        {
          "index": 2,
          "text": "映画を作る人のそばで作り方を習った。",
          "start_ms": 55833,
          "end_ms": 59540,
          "duration_ms": 3707
        }
      ]
    },
    {
      "index": 10,
      "text": "1943年、『姿三四郎』で初めて自分で映画を作った。",
      "start_ms": 60040,
      "end_ms": 66890,
      "duration_ms": 6850,
      "clauses": [
        {
          "index": 0,
          "text": "1943年、",
          "start_ms": 60040,
          "end_ms": 62597,
          "duration_ms": 2557
        },
        {
          "index": 1,
          "text": "『姿三四郎』で初めて自分で映画を作った。",
          "start_ms": 62847,
          "end_ms": 66890,
          "duration_ms": 4043
        }
      ]
    },
    {
      "index": 11,
      "text": "戦争のあと、黒澤は『酔いどれ天使』や『野良犬』をはっぴょうして注目を集めた。",
      "start_ms": 67390,
      "end_ms": 74763,
      "duration_ms": 7373,
      "clauses": [
        {
          "index": 0,
          "text": "戦争のあと、",
          "start_ms": 67390,
          "end_ms": 69135,
          "duration_ms": 1745
        },
        {
          "index": 1,
          "text": "黒澤は『酔いどれ天使』や『野良犬』をはっぴょうして注目を集めた。",
          "start_ms": 69385,
          "end_ms": 74763,
          "duration_ms": 5378
        }
      ]
    },
    {
      "index": 12,
      "text": "1950年の『羅生門』はヴェネツィア国際映画祭で金獅子賞を受け、にほんの映画にとって、せかいに知られるきっかけになった。",
      "start_ms": 75263,
      "end_ms": 87336,
      "duration_ms": 12073,
      "clauses": [
        {
          "index": 0,
          "text": "1950年の『羅生門』はヴェネツィア国際映画祭で金獅子賞を受け、",
          "start_ms": 75263,
          "end_ms": 81872,
          "duration_ms": 6609
        },
        {
          "index": 1,
          "text": "にほんの映画にとって、",
          "start_ms": 82122,
          "end_ms": 84238,
          "duration_ms": 2116
        },
        {
          "index": 2,
          "text": "せかいに知られるきっかけになった。",
          "start_ms": 84488,
          "end_ms": 87336,
          "duration_ms": 2848
        }
      ]
    },
    {
      "index": 13,
      "text": "その後も『生きる』『七人の侍』『ようじんぼう』などを作り、かいがいでも高く評価された。",
      "start_ms": 87836,
      "end_ms": 95522,
      "duration_ms": 7686,
      "clauses": [
        {
          "index": 0,
          "text": "その後も『生きる』『七人の侍』『ようじんぼう』などを作り、",
          "start_ms": 87836,
          "end_ms": 92297,
          "duration_ms": 4461
        },
        {
          "index": 1,
          "text": "かいがいでも高く評価された。",
          "start_ms": 92547,
          "end_ms": 95522,
          "duration_ms": 2975
        }
      ]
    },
    {
      "index": 14,
      "text": "かいがいでは、黒澤の映画をもとにあたらしい映画が作られた。",
      "start_ms": 96022,
      "end_ms": 102130,
      "duration_ms": 6108,
      "clauses": [
        {
          "index": 0,
          "text": "かいがいでは、",
          "start_ms": 96022,
          "end_ms": 97523,
          "duration_ms": 1501
        },
        {
          "index": 1,
          "text": "黒澤の映画をもとにあたらしい映画が作られた。",
          "start_ms": 97773,
          "end_ms": 102130,
          "duration_ms": 4357
        }
      ]
    },
    {
      "index": 15,
      "text": "1960ねんだいのこうはん、にほんでは映画を見る人が少なくなり、映画を作る仕事は困難になった。",
      "start_ms": 102630,
      "end_ms": 113309,
      "duration_ms": 10679,
      "clauses": [
        {
          "index": 0,
          "text": "1960ねんだいのこうはん、",
          "start_ms": 102630,
          "end_ms": 105814,
          "duration_ms": 3184
        },
        {
          "index": 1,
          "text": "にほんでは映画を見る人が少なくなり、",
          "start_ms": 106064,
          "end_ms": 109631,
          "duration_ms": 3567
        },
        {
          "index": 2,
          "text": "映画を作る仕事は困難になった。",
          "start_ms": 109881,
          "end_ms": 113309,
          "duration_ms": 3428
        }
      ]
    },
    {
      "index": 16,
      "text": "黒澤はアメリカで仕事をしようとしたものの、思ったようにはいかなかった。",
      "start_ms": 113809,
      "end_ms": 120985,
      "duration_ms": 7176,
      "clauses": [
        {
          "index": 0,
          "text": "黒澤はアメリカで仕事をしようとしたものの、",
          "start_ms": 113809,
          "end_ms": 117864,
          "duration_ms": 4055
        },
        {
          "index": 1,
          "text": "思ったようにはいかなかった。",
          "start_ms": 118114,
          "end_ms": 120985,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 17,
      "text": "それでも、かいがいのしきんのおかげで、『デルス・ウザーラ』『影武者』『乱』を作ることができた。",
      "start_ms": 121485,
      "end_ms": 129390,
      "duration_ms": 7905,
      "clauses": [
        {
          "index": 0,
          "text": "それでも、",
          "start_ms": 121485,
          "end_ms": 122893,
          "duration_ms": 1408
        },
        {
          "index": 1,
          "text": "かいがいのしきんのおかげで、",
          "start_ms": 123143,
          "end_ms": 125480,
          "duration_ms": 2337
        },
        {
          "index": 2,
          "text": "『デルス・ウザーラ』『影武者』『乱』を作ることができた。",
          "start_ms": 125730,
          "end_ms": 129390,
          "duration_ms": 3660
        }
      ]
    },
    {
      "index": 18,
      "text": "1985年には、映画を作る人として初めて文化勲章を受けた。",
      "start_ms": 129890,
      "end_ms": 137205,
      "duration_ms": 7315,
      "clauses": [
        {
          "index": 0,
          "text": "1985年には、",
          "start_ms": 129890,
          "end_ms": 132714,
          "duration_ms": 2824
        },
        {
          "index": 1,
          "text": "映画を作る人として初めて文化勲章を受けた。",
          "start_ms": 132964,
          "end_ms": 137205,
          "duration_ms": 4241
        }
      ]
    },
    {
      "index": 19,
      "text": "1990年には『夢』を作り、アカデミー名誉賞を受けた。",
      "start_ms": 137705,
      "end_ms": 144114,
      "duration_ms": 6409,
      "clauses": [
        {
          "index": 0,
          "text": "1990年には『夢』を作り、",
          "start_ms": 137705,
          "end_ms": 141388,
          "duration_ms": 3683
        },
        {
          "index": 1,
          "text": "アカデミー名誉賞を受けた。",
          "start_ms": 141638,
          "end_ms": 144114,
          "duration_ms": 2476
        }
      ]
    },
    {
      "index": 20,
      "text": "黒澤はしょうがいで30本のさくひんを作り、そのうち16本はみふねとしろうと作ったものだ。",
      "start_ms": 144614,
      "end_ms": 153485,
      "duration_ms": 8871,
      "clauses": [
        {
          "index": 0,
          "text": "黒澤はしょうがいで30本のさくひんを作り、",
          "start_ms": 144614,
          "end_ms": 148669,
          "duration_ms": 4055
        },
        {
          "index": 1,
          "text": "そのうち16本はみふねとしろうと作ったものだ。",
          "start_ms": 148919,
          "end_ms": 153485,
          "duration_ms": 4566
        }
      ]
    },
    {
      "index": 21,
      "text": "1998年に死んだ。",
      "start_ms": 153985,
      "end_ms": 157134,
      "duration_ms": 3149,
      "clauses": [
        {
          "index": 0,
          "text": "1998年に死んだ。",
          "start_ms": 153985,
          "end_ms": 157134,
          "duration_ms": 3149
        }
      ]
    },
    {
      "index": 22,
      "text": "死んだあと、国民栄誉賞が与えられた。",
      "start_ms": 157634,
      "end_ms": 161965,
      "duration_ms": 4331,
      "clauses": [
        {
          "index": 0,
          "text": "死んだあと、",
          "start_ms": 157634,
          "end_ms": 159123,
          "duration_ms": 1489
        },
        {
          "index": 1,
          "text": "国民栄誉賞が与えられた。",
          "start_ms": 159373,
          "end_ms": 161965,
          "duration_ms": 2592
        }
      ]
    },
    {
      "index": 23,
      "text": "黒澤の映画は今もせかいで見られ、多くの人に大きなちからを与えている。",
      "start_ms": 162465,
      "end_ms": 170128,
      "duration_ms": 7663,
      "clauses": [
        {
          "index": 0,
          "text": "黒澤の映画は今もせかいで見られ、",
          "start_ms": 162465,
          "end_ms": 166102,
          "duration_ms": 3637
        },
        {
          "index": 1,
          "text": "多くの人に大きなちからを与えている。",
          "start_ms": 166352,
          "end_ms": 170128,
          "duration_ms": 3776
        }
      ]
    },
    {
      "index": 24,
      "text": "黒澤のさくひんは、にんげんのこころの強さを描いている。",
      "start_ms": 170628,
      "end_ms": 176283,
      "duration_ms": 5655,
      "clauses": [
        {
          "index": 0,
          "text": "黒澤のさくひんは、",
          "start_ms": 170628,
          "end_ms": 172791,
          "duration_ms": 2163
        },
        {
          "index": 1,
          "text": "にんげんのこころの強さを描いている。",
          "start_ms": 173041,
          "end_ms": 176283,
          "duration_ms": 3242
        }
      ]
    },
    {
      "index": 25,
      "text": "これからも、彼の映画はせかいで見られるだろう。",
      "start_ms": 176783,
      "end_ms": 181753,
      "duration_ms": 4970,
      "clauses": [
        {
          "index": 0,
          "text": "これからも、",
          "start_ms": 176783,
          "end_ms": 178272,
          "duration_ms": 1489
        },
        {
          "index": 1,
          "text": "彼の映画はせかいで見られるだろう。",
          "start_ms": 178522,
          "end_ms": 181753,
          "duration_ms": 3231
        }
      ]
    },
    {
      "index": 26,
      "text": "そして、今も多くの人にかんどうを与えつつある。",
      "start_ms": 182253,
      "end_ms": 187234,
      "duration_ms": 4981,
      "clauses": [
        {
          "index": 0,
