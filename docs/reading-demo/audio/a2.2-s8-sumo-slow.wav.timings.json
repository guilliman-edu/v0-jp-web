          "start_ms": 55593,
          "end_ms": 59184,
          "duration_ms": 3591
        },
        {
          "index": 2,
          "text": "すもうを取らせました。",
          "start_ms": 59434,
          "end_ms": 61991,
          "duration_ms": 2557
        }
      ]
    },
    {
      "index": 10,
      "text": "えどじだいに、すもうはとても人気のあるぎょうじになりました。",
      "start_ms": 62491,
      "end_ms": 69261,
      "duration_ms": 6770,
      "clauses": [
        {
          "index": 0,
          "text": "えどじだいに、",
