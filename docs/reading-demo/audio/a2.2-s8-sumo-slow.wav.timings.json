          "duration_ms": 1919
        },
        {
          "index": 1,
          "text": "すもうはとても人気のあるぎょうじになりました。",
          "start_ms": 64660,
          "end_ms": 69261,
          "duration_ms": 4601
        }
      ]
    },
    {
      "index": 11,
      "text": "りきしはすもうでおかねをもらえましたし、すもうを見る人もたくさんいました。",
      "start_ms": 69761,
      "end_ms": 77668,
      "duration_ms": 7907,
      "clauses": [
        {
