    },
    {
      "index": 1,
      "text": "すもうのはじまりは、とても古いはなしです。",
      "start_ms": 2616,
      "end_ms": 8028,
      "duration_ms": 5412,
      "clauses": [
        {
          "index": 0,
          "text": "すもうのはじまりは、",
          "start_ms": 2616,
          "end_ms": 5046,
          "duration_ms": 2430
        },
        {
          "index": 1,
          "text": "とても古いはなしです。",
          "start_ms": 5296,
          "end_ms": 8028,
          "duration_ms": 2732
        }
      ]
    },
    {
      "index": 2,
      "text": "昔の本に、二人のかみさまがすもうをしたはなしがあります。",
      "start_ms": 8528,
      "end_ms": 15286,
      "duration_ms": 6758,
      "clauses": [
        {
          "index": 0,
          "text": "昔の本に、",
          "start_ms": 8528,
          "end_ms": 10586,
          "duration_ms": 2058
        },
        {
          "index": 1,
          "text": "二人のかみさまがすもうをしたはなしがあります。",
          "start_ms": 10836,
          "end_ms": 15286,
          "duration_ms": 4450
        }
      ]
    },
    {
      "index": 3,
      "text": "そのころ、日本ではこめを作っていました。",
      "start_ms": 15786,
      "end_ms": 21220,
      "duration_ms": 5434,
      "clauses": [
        {
          "index": 0,
          "text": "そのころ、",
          "start_ms": 15786,
          "end_ms": 17461,
          "duration_ms": 1675
        },
        {
          "index": 1,
          "text": "日本ではこめを作っていました。",
          "start_ms": 17711,
          "end_ms": 21220,
          "duration_ms": 3509
        }
      ]
    },
    {
      "index": 4,
      "text": "すもうは、のうかの大切なぎょうじでした。",
      "start_ms": 21720,
      "end_ms": 26679,
      "duration_ms": 4959,
      "clauses": [
        {
          "index": 0,
          "text": "すもうは、",
          "start_ms": 21720,
          "end_ms": 23105,
          "duration_ms": 1385
        },
        {
          "index": 1,
          "text": "のうかの大切なぎょうじでした。",
          "start_ms": 23355,
          "end_ms": 26679,
          "duration_ms": 3324
        }
      ]
    },
    {
      "index": 5,
      "text": "のうかの人は、すもうを見て、こめがたくさんできると思いました。",
      "start_ms": 27179,
      "end_ms": 35224,
      "duration_ms": 8045,
      "clauses": [
        {
          "index": 0,
          "text": "のうかの人は、",
          "start_ms": 27179,
          "end_ms": 29226,
          "duration_ms": 2047
        },
        {
          "index": 1,
          "text": "すもうを見て、",
          "start_ms": 29476,
          "end_ms": 31395,
          "duration_ms": 1919
        },
        {
          "index": 2,
          "text": "こめがたくさんできると思いました。",
          "start_ms": 31645,
          "end_ms": 35224,
          "duration_ms": 3579
        }
      ]
    },
    {
      "index": 6,
      "text": "かまくらやせんごくのじだいには、ぶしもすもうを習いました。",
      "start_ms": 35724,
      "end_ms": 42284,
      "duration_ms": 6560,
      "clauses": [
        {
          "index": 0,
          "text": "かまくらやせんごくのじだいには、",
          "start_ms": 35724,
          "end_ms": 39117,
          "duration_ms": 3393
        },
        {
          "index": 1,
          "text": "ぶしもすもうを習いました。",
          "start_ms": 39367,
          "end_ms": 42284,
          "duration_ms": 2917
        }
      ]
    },
    {
      "index": 7,
      "text": "ぶしはすもうをして、強くなりました。",
      "start_ms": 42784,
      "end_ms": 47719,
      "duration_ms": 4935,
      "clauses": [
        {
          "index": 0,
          "text": "ぶしはすもうをして、",
          "start_ms": 42784,
          "end_ms": 45202,
          "duration_ms": 2418
        },
        {
          "index": 1,
          "text": "強くなりました。",
          "start_ms": 45452,
          "end_ms": 47719,
          "duration_ms": 2267
        }
      ]
    },
    {
      "index": 8,
      "text": "おだのぶながはすもうがとてもすきだったそうです。",
      "start_ms": 48219,
      "end_ms": 52994,
      "duration_ms": 4775,
      "clauses": [
        {
          "index": 0,
          "text": "おだのぶながはすもうがとてもすきだったそうです。",
          "start_ms": 48219,
          "end_ms": 52994,
          "duration_ms": 4775
        }
      ]
    },
    {
      "index": 9,
      "text": "のぶながは、いろいろなくにからりきしを集めて、すもうを取らせました。",
      "start_ms": 53494,
      "end_ms": 61991,
      "duration_ms": 8497,
      "clauses": [
        {
          "index": 0,
          "text": "のぶながは、",
          "start_ms": 53494,
          "end_ms": 55343,
          "duration_ms": 1849
        },
        {
