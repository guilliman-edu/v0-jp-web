          "end_ms": 41072,
          "duration_ms": 4868
        }
      ]
    },
    {
      "index": 6,
      "text": "さむいきせつは、ゆかただけではさむいかもしれません。",
      "start_ms": 41572,
      "end_ms": 47854,
      "duration_ms": 6282,
      "clauses": [
        {
