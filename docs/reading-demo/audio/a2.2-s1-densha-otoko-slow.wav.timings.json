          "end_ms": 86190,
          "duration_ms": 2755
        }
      ]
    },
    {
      "index": 16,
      "text": "おんなのこはとてもおれいを言いました。",
      "start_ms": 86690,
      "end_ms": 90455,
      "duration_ms": 3765,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこはとてもおれいを言いました。",
