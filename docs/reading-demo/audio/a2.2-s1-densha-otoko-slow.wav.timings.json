          "end_ms": 59782,
          "duration_ms": 3405
        }
      ]
    },
    {
      "index": 12,
      "text": "そのとき、おさけを飲んだ男の人が、わかいおんなのこにわるいことをしていました。",
      "start_ms": 60282,
      "end_ms": 69778,
      "duration_ms": 9496,
      "clauses": [
        {
          "index": 0,
          "text": "そのとき、",
          "start_ms": 60282,
          "end_ms": 62085,
          "duration_ms": 1803
        },
        {
