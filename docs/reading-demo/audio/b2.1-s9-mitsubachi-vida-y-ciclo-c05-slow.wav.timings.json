        }
      ]
    },
    {
      "index": 1,
      "text": "ミツバチたちが長い時間をかけて作り上げたハチミツは、すの中で大切に蓄えられています。",
      "start_ms": 4735,
      "end_ms": 13884,
      "duration_ms": 9149,
      "clauses": [
        {
          "index": 0,
          "text": "ミツバチたちが長い時間をかけて作り上げたハチミツは、",
          "start_ms": 4735,
          "end_ms": 9748,
          "duration_ms": 5013
        },
        {
          "index": 1,
          "text": "すの中で大切に蓄えられています。",
          "start_ms": 9998,
          "end_ms": 13884,
          "duration_ms": 3886
        }
      ]
    },
    {
      "index": 2,
      "text": "養蜂家は、ミツバチたちが冬を越すのに必要な分を残しながら、余ったハチミツだけをさいみつしていきます。",
      "start_ms": 14384,
      "end_ms": 25626,
      "duration_ms": 11242,
      "clauses": [
        {
          "index": 0,
          "text": "養蜂家は、",
          "start_ms": 14384,
          "end_ms": 16099,
          "duration_ms": 1715
        },
        {
          "index": 1,
          "text": "ミツバチたちが冬を越すのに必要な分を残しながら、",
          "start_ms": 16349,
          "end_ms": 21118,
          "duration_ms": 4769
        },
        {
          "index": 2,
          "text": "余ったハチミツだけをさいみつしていきます。",
