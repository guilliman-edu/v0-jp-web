          "end_ms": 25626,
          "duration_ms": 4258
        }
      ]
    },
    {
      "index": 3,
      "text": "さいみつのときは、まずハニカムのふたになっているみつろうを専用の蜜刀で丁寧に取り除きます。",
      "start_ms": 26126,
      "end_ms": 35704,
      "duration_ms": 9578,
      "clauses": [
        {
          "index": 0,
          "text": "さいみつのときは、",
          "start_ms": 26126,
          "end_ms": 28294,
          "duration_ms": 2168
        },
        {
          "index": 1,
          "text": "まずハニカムのふたになっているみつろうを専用の蜜刀で丁寧に取り除きます。",
          "start_ms": 28544,
          "end_ms": 35704,
          "duration_ms": 7160
        }
      ]
    },
    {
      "index": 4,
      "text": "そして、その枠をえんしんぶんりきに入れて回転させます。",
      "start_ms": 36204,
      "end_ms": 42671,
      "duration_ms": 6467,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 36204,
          "end_ms": 37594,
          "duration_ms": 1390
        },
        {
          "index": 1,
          "text": "その枠をえんしんぶんりきに入れて回転させます。",
          "start_ms": 37844,
          "end_ms": 42671,
          "duration_ms": 4827
        }
      ]
    },
    {
      "index": 5,
      "text": "遠心力によってハチミツが枠から外に飛び出し、下のタンクに集まっていくのです。",
      "start_ms": 43171,
      "end_ms": 51159,
      "duration_ms": 7988,
      "clauses": [
