    },
    {
      "index": 47,
      "text": "わたしは、おとうさんのともだちです。」",
      "start_ms": 171183,
      "end_ms": 175525,
      "duration_ms": 4342,
      "clauses": [
        {
          "index": 0,
          "text": "わたしは、",
          "start_ms": 171183,
          "end_ms": 172701,
          "duration_ms": 1518
        },
        {
          "index": 1,
          "text": "おとうさんのともだちです。」",
          "start_ms": 172951,
          "end_ms": 175525,
          "duration_ms": 2574
        }
      ]
    },
    {
      "index": 48,
      "text": "チョウシロウはいいました。",
      "start_ms": 176025,
      "end_ms": 178414,
      "duration_ms": 2389,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはいいました。",
          "start_ms": 176025,
          "end_ms": 178414,
          "duration_ms": 2389
        }
      ]
    },
    {
      "index": 49,
      "text": "「いりません。",
      "start_ms": 178914,
      "end_ms": 180490,
      "duration_ms": 1576,
      "clauses": [
        {
          "index": 0,
          "text": "「いりません。",
          "start_ms": 178914,
          "end_ms": 180490,
          "duration_ms": 1576
        }
      ]
    },
    {
      "index": 50,
      "text": "おとうさんに、もうなにもいいたいことはありません。",
      "start_ms": 180990,
      "end_ms": 186029,
      "duration_ms": 5039,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんに、",
          "start_ms": 180990,
          "end_ms": 182705,
          "duration_ms": 1715
        },
        {
          "index": 1,
          "text": "もうなにもいいたいことはありません。",
          "start_ms": 182955,
          "end_ms": 186029,
          "duration_ms": 3074
        }
      ]
    },
    {
      "index": 51,
      "text": "さむらいはたいせつなともだちをおもって、どんなことになってもいいです。",
      "start_ms": 186529,
      "end_ms": 193345,
      "duration_ms": 6816,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいはたいせつなともだちをおもって、",
          "start_ms": 186529,
          "end_ms": 190346,
          "duration_ms": 3817
        },
        {
          "index": 1,
          "text": "どんなことになってもいいです。",
          "start_ms": 190596,
          "end_ms": 193345,
          "duration_ms": 2749
        }
      ]
    },
    {
      "index": 52,
      "text": "しょうぐんがわたしになにをしたいのか、よくわかります。",
      "start_ms": 193845,
      "end_ms": 199348,
      "duration_ms": 5503,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんがわたしになにをしたいのか、",
          "start_ms": 193845,
          "end_ms": 197151,
          "duration_ms": 3306
        },
        {
          "index": 1,
          "text": "よくわかります。",
          "start_ms": 197401,
          "end_ms": 199348,
          "duration_ms": 1947
        }
      ]
    },
    {
      "index": 53,
      "text": "わたしがこのいえをでるとき、みんながしります。",
      "start_ms": 199848,
      "end_ms": 204922,
      "duration_ms": 5074,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがこのいえをでるとき、",
          "start_ms": 199848,
          "end_ms": 202748,
          "duration_ms": 2900
        },
        {
          "index": 1,
          "text": "みんながしります。",
          "start_ms": 202998,
          "end_ms": 204922,
          "duration_ms": 1924
        }
      ]
    },
    {
      "index": 54,
      "text": "わたしがうそをつかなかったこと、そしてたけちよをおもってうそをついたことも、みんながしります。",
      "start_ms": 205422,
      "end_ms": 215201,
      "duration_ms": 9779,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがうそをつかなかったこと、",
          "start_ms": 205422,
          "end_ms": 208496,
          "duration_ms": 3074
        },
        {
          "index": 1,
          "text": "そしてたけちよをおもってうそをついたことも、",
          "start_ms": 208746,
          "end_ms": 212969,
          "duration_ms": 4223
        },
        {
          "index": 2,
          "text": "みんながしります。",
          "start_ms": 213219,
          "end_ms": 215201,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 55,
      "text": "おとうさんにつたえることは、ひとつです。",
      "start_ms": 215701,
      "end_ms": 220183,
      "duration_ms": 4482,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんにつたえることは、",
          "start_ms": 215701,
          "end_ms": 218299,
          "duration_ms": 2598
        },
        {
          "index": 1,
          "text": "ひとつです。",
          "start_ms": 218549,
          "end_ms": 220183,
          "duration_ms": 1634
        }
      ]
    },
    {
      "index": 56,
      "text": "『わたしはたいせつなともだちをおもって、このいえをでました。』",
      "start_ms": 220683,
      "end_ms": 226720,
      "duration_ms": 6037,
      "clauses": [
        {
          "index": 0,
          "text": "『わたしはたいせつなともだちをおもって、",
          "start_ms": 220683,
          "end_ms": 224337,
          "duration_ms": 3654
        },
        {
          "index": 1,
          "text": "このいえをでました。』",
          "start_ms": 224587,
          "end_ms": 226720,
          "duration_ms": 2133
        }
      ]
    },
    {
      "index": 57,
      "text": "わたしがかなしいのは、おやのびょうきです。",
      "start_ms": 227220,
      "end_ms": 231887,
      "duration_ms": 4667,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがかなしいのは、",
          "start_ms": 227220,
          "end_ms": 229504,
          "duration_ms": 2284
        },
        {
          "index": 1,
          "text": "おやのびょうきです。",
          "start_ms": 229754,
          "end_ms": 231887,
          "duration_ms": 2133
        }
      ]
    },
    {
      "index": 58,
      "text": "これをきいて、おやのびょうきがひどくなります。」",
      "start_ms": 232387,
      "end_ms": 237298,
      "duration_ms": 4911,
      "clauses": [
        {
          "index": 0,
          "text": "これをきいて、",
          "start_ms": 232387,
          "end_ms": 234137,
          "duration_ms": 1750
        },
        {
          "index": 1,
          "text": "おやのびょうきがひどくなります。」",
          "start_ms": 234387,
          "end_ms": 237298,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 59,
      "text": "ぶかはすごくかなしくなりました。",
      "start_ms": 237798,
      "end_ms": 240999,
      "duration_ms": 3201,
      "clauses": [
        {
          "index": 0,
          "text": "ぶかはすごくかなしくなりました。",
          "start_ms": 237798,
          "end_ms": 240999,
          "duration_ms": 3201
        }
      ]
    },
    {
      "index": 60,
      "text": "そして、チョウシロウをしょうぐんのまえへつれていきました。",
      "start_ms": 241499,
      "end_ms": 246967,
      "duration_ms": 5468,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 241499,
          "end_ms": 242854,
          "duration_ms": 1355
        },
        {
          "index": 1,
          "text": "チョウシロウをしょうぐんのまえへつれていきました。",
          "start_ms": 243104,
          "end_ms": 246967,
          "duration_ms": 3863
        }
      ]
    },
    {
      "index": 61,
      "text": "チョウシロウはすわりました。",
      "start_ms": 247467,
      "end_ms": 250250,
      "duration_ms": 2783,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはすわりました。",
          "start_ms": 247467,
          "end_ms": 250250,
          "duration_ms": 2783
        }
      ]
    },
    {
      "index": 62,
      "text": "かみをなしました。",
      "start_ms": 250750,
      "end_ms": 252848,
      "duration_ms": 2098,
      "clauses": [
        {
          "index": 0,
          "text": "かみをなしました。",
          "start_ms": 250750,
          "end_ms": 252848,
          "duration_ms": 2098
        }
      ]
    },
    {
      "index": 63,
      "text": "こわくないかおをして、しょうぐんをまちました。",
      "start_ms": 253348,
      "end_ms": 258178,
      "duration_ms": 4830,
      "clauses": [
        {
          "index": 0,
          "text": "こわくないかおをして、",
          "start_ms": 253348,
          "end_ms": 255539,
          "duration_ms": 2191
        },
        {
          "index": 1,
          "text": "しょうぐんをまちました。",
          "start_ms": 255789,
          "end_ms": 258178,
          "duration_ms": 2389
        }
      ]
    },
    {
      "index": 64,
      "text": "しょうぐんはそのかおをみて、かたなをおきました。",
      "start_ms": 258678,
      "end_ms": 263821,
      "duration_ms": 5143,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはそのかおをみて、",
          "start_ms": 258678,
          "end_ms": 261461,
          "duration_ms": 2783
        },
        {
          "index": 1,
          "text": "かたなをおきました。",
          "start_ms": 261711,
          "end_ms": 263821,
          "duration_ms": 2110
        }
      ]
    },
    {
      "index": 65,
      "text": "しょうぐんはいいました。",
      "start_ms": 264321,
      "end_ms": 266605,
      "duration_ms": 2284,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはいいました。",
          "start_ms": 264321,
          "end_ms": 266605,
          "duration_ms": 2284
        }
      ]
    },
    {
      "index": 66,
      "text": "「チョウシロウ、もういいです。",
      "start_ms": 267105,
      "end_ms": 270530,
      "duration_ms": 3425,
      "clauses": [
        {
          "index": 0,
          "text": "「チョウシロウ、",
          "start_ms": 267105,
          "end_ms": 268588,
          "duration_ms": 1483
        },
        {
          "index": 1,
          "text": "もういいです。",
          "start_ms": 268838,
          "end_ms": 270530,
          "duration_ms": 1692
        }
      ]
    },
    {
      "index": 67,
      "text": "あなたはすごくいいこです。",
      "start_ms": 271030,
      "end_ms": 273744,
      "duration_ms": 2714,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはすごくいいこです。",
          "start_ms": 271030,
          "end_ms": 273744,
          "duration_ms": 2714
        }
      ]
    },
    {
      "index": 68,
      "text": "わたしはあなたのことを、よくしりました。",
      "start_ms": 274244,
      "end_ms": 279074,
      "duration_ms": 4830,
      "clauses": [
        {
          "index": 0,
          "text": "わたしはあなたのことを、",
          "start_ms": 274244,
          "end_ms": 276818,
          "duration_ms": 2574
        },
        {
          "index": 1,
          "text": "よくしりました。",
          "start_ms": 277068,
          "end_ms": 279074,
          "duration_ms": 2006
        }
      ]
    },
    {
      "index": 69,
      "text": "たけちよがしょうぐんになるとき、あなたは、いつもたけちよのそばにいてください。",
      "start_ms": 279574,
      "end_ms": 287785,
      "duration_ms": 8211,
      "clauses": [
        {
          "index": 0,
          "text": "たけちよがしょうぐんになるとき、",
          "start_ms": 279574,
          "end_ms": 282450,
          "duration_ms": 2876
        },
        {
          "index": 1,
          "text": "あなたは、",
          "start_ms": 282700,
          "end_ms": 284171,
          "duration_ms": 1471
        },
        {
          "index": 2,
          "text": "いつもたけちよのそばにいてください。",
          "start_ms": 284421,
          "end_ms": 287785,
          "duration_ms": 3364
        }
      ]
    },
    {
      "index": 70,
      "text": "あなたはたいせつなともだちです。",
      "start_ms": 288285,
      "end_ms": 291521,
      "duration_ms": 3236,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはたいせつなともだちです。",
          "start_ms": 288285,
          "end_ms": 291521,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 71,
      "text": "あなたはもうじゆうです。」",
      "start_ms": 292021,
      "end_ms": 294561,
      "duration_ms": 2540,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうじゆうです。」",
          "start_ms": 292021,
          "end_ms": 294561,
          "duration_ms": 2540
        }
      ]
    },
    {
      "index": 72,
      "text": "そのときから、ふたりはなかがいいともだちになりました。",
      "start_ms": 295061,
      "end_ms": 300645,
      "duration_ms": 5584,
      "clauses": [
        {
          "index": 0,
          "text": "そのときから、",
          "start_ms": 295061,
          "end_ms": 296892,
          "duration_ms": 1831
        },
        {
          "index": 1,
          "text": "ふたりはなかがいいともだちになりました。",
          "start_ms": 297142,
          "end_ms": 300645,
          "duration_ms": 3503
        }
      ]
    },
    {
      "index": 73,
      "text": "しょうぐんも、チョウシロウをたいせつにしました。",
      "start_ms": 301145,
      "end_ms": 305894,
      "duration_ms": 4749,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんも、",
          "start_ms": 301145,
          "end_ms": 302686,
          "duration_ms": 1541
        },
        {
          "index": 1,
          "text": "チョウシロウをたいせつにしました。",
          "start_ms": 302936,
          "end_ms": 305894,
          "duration_ms": 2958
        }
      ]
    },
    {
      "index": 74,
      "text": "ながいじかんのあとで、チョウシロウはおおきくなって、ゆうめいなひとになりました。",
      "start_ms": 306394,
      "end_ms": 314547,
      "duration_ms": 8153,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんのあとで、",
          "start_ms": 306394,
          "end_ms": 308620,
          "duration_ms": 2226
        },
        {
          "index": 1,
          "text": "チョウシロウはおおきくなって、",
          "start_ms": 308870,
          "end_ms": 311653,
          "duration_ms": 2783
        },
        {
          "index": 2,
          "text": "ゆうめいなひとになりました。",
          "start_ms": 311903,
          "end_ms": 314547,
          "duration_ms": 2644
        }
      ]
    },
    {
      "index": 75,
      "text": "みんなが、チョウシロウをおぼえています。",
      "start_ms": 315047,
      "end_ms": 319320,
      "duration_ms": 4273,
      "clauses": [
        {
          "index": 0,
          "text": "みんなが、",
          "start_ms": 315047,
          "end_ms": 316426,
          "duration_ms": 1379
        },
        {
          "index": 1,
          "text": "チョウシロウをおぼえています。",
          "start_ms": 316676,
