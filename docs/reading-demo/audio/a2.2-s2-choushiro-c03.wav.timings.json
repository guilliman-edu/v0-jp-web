      "text": "わたしは、おとうさんのともだちです。」",
      "start_ms": 170929,
      "end_ms": 175341,
      "duration_ms": 4412,
      "clauses": [
        {
          "index": 0,
          "text": "わたしは、",
          "start_ms": 170929,
          "end_ms": 172459,
          "duration_ms": 1530
        },
        {
          "index": 1,
          "text": "おとうさんのともだちです。」",
          "start_ms": 172709,
          "end_ms": 175341,
          "duration_ms": 2632
        }
      ]
    },
    {
      "index": 48,
      "text": "チョウシロウはいいました。",
      "start_ms": 175841,
      "end_ms": 178206,
      "duration_ms": 2365,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはいいました。",
          "start_ms": 175841,
          "end_ms": 178206,
          "duration_ms": 2365
        }
      ]
    },
    {
      "index": 49,
      "text": "「いりません。",
      "start_ms": 178706,
      "end_ms": 180398,
      "duration_ms": 1692,
      "clauses": [
        {
          "index": 0,
          "text": "「いりません。",
          "start_ms": 178706,
          "end_ms": 180398,
          "duration_ms": 1692
        }
      ]
    },
    {
      "index": 50,
      "text": "おとうさんに、もうなにもいいたいことはありません。",
      "start_ms": 180898,
      "end_ms": 185867,
      "duration_ms": 4969,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんに、",
          "start_ms": 180898,
          "end_ms": 182578,
          "duration_ms": 1680
        },
        {
          "index": 1,
          "text": "もうなにもいいたいことはありません。",
          "start_ms": 182828,
          "end_ms": 185867,
          "duration_ms": 3039
        }
      ]
    },
    {
      "index": 51,
      "text": "さむらいはたいせつなともだちをおもって、どんなことになってもいいです。",
      "start_ms": 186367,
      "end_ms": 193159,
      "duration_ms": 6792,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいはたいせつなともだちをおもって、",
          "start_ms": 186367,
          "end_ms": 190207,
          "duration_ms": 3840
        },
        {
          "index": 1,
          "text": "どんなことになってもいいです。",
          "start_ms": 190457,
          "end_ms": 193159,
          "duration_ms": 2702
        }
      ]
    },
    {
      "index": 52,
      "text": "しょうぐんがわたしになにをしたいのか、よくわかります。",
      "start_ms": 193659,
      "end_ms": 199185,
      "duration_ms": 5526,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんがわたしになにをしたいのか、",
          "start_ms": 193659,
          "end_ms": 196976,
          "duration_ms": 3317
        },
        {
          "index": 1,
          "text": "よくわかります。",
          "start_ms": 197226,
          "end_ms": 199185,
          "duration_ms": 1959
        }
      ]
    },
    {
      "index": 53,
      "text": "わたしがこのいえをでるとき、みんながしります。",
      "start_ms": 199685,
      "end_ms": 204922,
      "duration_ms": 5237,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがこのいえをでるとき、",
          "start_ms": 199685,
          "end_ms": 202701,
          "duration_ms": 3016
        },
        {
          "index": 1,
          "text": "みんながしります。",
          "start_ms": 202951,
          "end_ms": 204922,
          "duration_ms": 1971
        }
      ]
    },
    {
      "index": 54,
      "text": "わたしがうそをつかなかったこと、そしてたけちよをおもってうそをついたことも、みんながしります。",
      "start_ms": 205422,
      "end_ms": 215247,
      "duration_ms": 9825,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがうそをつかなかったこと、",
          "start_ms": 205422,
          "end_ms": 208530,
          "duration_ms": 3108
        },
        {
          "index": 1,
          "text": "そしてたけちよをおもってうそをついたことも、",
          "start_ms": 208780,
          "end_ms": 213003,
          "duration_ms": 4223
        },
        {
          "index": 2,
          "text": "みんながしります。",
          "start_ms": 213253,
          "end_ms": 215247,
          "duration_ms": 1994
        }
      ]
    },
    {
      "index": 55,
      "text": "おとうさんにつたえることは、ひとつです。",
      "start_ms": 215747,
      "end_ms": 220206,
      "duration_ms": 4459,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんにつたえることは、",
          "start_ms": 215747,
          "end_ms": 218310,
          "duration_ms": 2563
        },
        {
          "index": 1,
          "text": "ひとつです。",
          "start_ms": 218560,
          "end_ms": 220206,
          "duration_ms": 1646
        }
      ]
    },
    {
      "index": 56,
      "text": "『わたしはたいせつなともだちをおもって、このいえをでました。』",
      "start_ms": 220706,
      "end_ms": 226697,
      "duration_ms": 5991,
      "clauses": [
        {
          "index": 0,
          "text": "『わたしはたいせつなともだちをおもって、",
          "start_ms": 220706,
          "end_ms": 224360,
          "duration_ms": 3654
        },
        {
          "index": 1,
          "text": "このいえをでました。』",
          "start_ms": 224610,
          "end_ms": 226697,
          "duration_ms": 2087
        }
      ]
    },
    {
      "index": 57,
      "text": "わたしがかなしいのは、おやのびょうきです。",
      "start_ms": 227197,
      "end_ms": 231899,
      "duration_ms": 4702,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがかなしいのは、",
          "start_ms": 227197,
          "end_ms": 229551,
          "duration_ms": 2354
        },
        {
          "index": 1,
          "text": "おやのびょうきです。",
          "start_ms": 229801,
          "end_ms": 231899,
          "duration_ms": 2098
        }
      ]
    },
    {
      "index": 58,
      "text": "これをきいて、おやのびょうきがひどくなります。」",
      "start_ms": 232399,
      "end_ms": 237357,
      "duration_ms": 4958,
      "clauses": [
        {
          "index": 0,
          "text": "これをきいて、",
          "start_ms": 232399,
          "end_ms": 234138,
          "duration_ms": 1739
        },
        {
          "index": 1,
          "text": "おやのびょうきがひどくなります。」",
          "start_ms": 234388,
          "end_ms": 237357,
          "duration_ms": 2969
        }
      ]
    },
    {
      "index": 59,
      "text": "ぶかはすごくかなしくなりました。",
      "start_ms": 237857,
      "end_ms": 240954,
      "duration_ms": 3097,
      "clauses": [
        {
          "index": 0,
          "text": "ぶかはすごくかなしくなりました。",
          "start_ms": 237857,
          "end_ms": 240954,
          "duration_ms": 3097
        }
      ]
    },
    {
      "index": 60,
      "text": "そして、チョウシロウをしょうぐんのまえへつれていきました。",
      "start_ms": 241454,
      "end_ms": 246888,
      "duration_ms": 5434,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 241454,
          "end_ms": 242775,
          "duration_ms": 1321
        },
        {
          "index": 1,
          "text": "チョウシロウをしょうぐんのまえへつれていきました。",
          "start_ms": 243025,
          "end_ms": 246888,
          "duration_ms": 3863
        }
      ]
    },
    {
      "index": 61,
      "text": "チョウシロウはすわりました。",
      "start_ms": 247388,
      "end_ms": 250148,
      "duration_ms": 2760,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはすわりました。",
          "start_ms": 247388,
          "end_ms": 250148,
          "duration_ms": 2760
        }
      ]
    },
    {
      "index": 62,
      "text": "かみをなおしました。",
