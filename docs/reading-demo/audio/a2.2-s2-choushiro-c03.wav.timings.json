    {
      "index": 47,
      "text": "わたしは、おとうさんのともだちです。",
      "start_ms": 170860,
      "end_ms": 175214,
      "duration_ms": 4354,
      "clauses": [
        {
          "index": 0,
          "text": "わたしは、",
          "start_ms": 170860,
          "end_ms": 172378,
          "duration_ms": 1518
        },
        {
          "index": 1,
          "text": "おとうさんのともだちです。",
          "start_ms": 172628,
          "end_ms": 175214,
          "duration_ms": 2586
        }
      ]
    },
    {
      "index": 48,
      "text": "」チョウシロウはいいました。",
      "start_ms": 175714,
      "end_ms": 178056,
      "duration_ms": 2342,
      "clauses": [
        {
          "index": 0,
          "text": "」チョウシロウはいいました。",
          "start_ms": 175714,
          "end_ms": 178056,
          "duration_ms": 2342
        }
      ]
    },
    {
      "index": 49,
      "text": "「いりません。",
      "start_ms": 178556,
      "end_ms": 180236,
      "duration_ms": 1680,
      "clauses": [
        {
          "index": 0,
          "text": "「いりません。",
          "start_ms": 178556,
          "end_ms": 180236,
          "duration_ms": 1680
        }
      ]
    },
    {
      "index": 50,
      "text": "おとうさんに、もうなにもいいたいことはありません。",
      "start_ms": 180736,
      "end_ms": 185693,
      "duration_ms": 4957,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんに、",
          "start_ms": 180736,
          "end_ms": 182451,
          "duration_ms": 1715
        },
        {
          "index": 1,
          "text": "もうなにもいいたいことはありません。",
          "start_ms": 182701,
          "end_ms": 185693,
          "duration_ms": 2992
        }
      ]
    },
    {
      "index": 51,
      "text": "さむらいはたいせつなともだちをおもって、どんなことになってもいいです。",
      "start_ms": 186193,
      "end_ms": 193008,
      "duration_ms": 6815,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいはたいせつなともだちをおもって、",
          "start_ms": 186193,
          "end_ms": 189986,
          "duration_ms": 3793
        },
        {
          "index": 1,
          "text": "どんなことになってもいいです。",
          "start_ms": 190236,
          "end_ms": 193008,
          "duration_ms": 2772
        }
      ]
    },
    {
      "index": 52,
      "text": "しょうぐんがわたしになにをしたいのか、よくわかります。",
      "start_ms": 193508,
      "end_ms": 199058,
      "duration_ms": 5550,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんがわたしになにをしたいのか、",
          "start_ms": 193508,
          "end_ms": 196849,
          "duration_ms": 3341
        },
        {
          "index": 1,
          "text": "よくわかります。",
          "start_ms": 197099,
          "end_ms": 199058,
          "duration_ms": 1959
        }
      ]
    },
    {
      "index": 53,
      "text": "わたしがこのいえをでるとき、みんながしります。",
      "start_ms": 199558,
      "end_ms": 204795,
      "duration_ms": 5237,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがこのいえをでるとき、",
          "start_ms": 199558,
          "end_ms": 202539,
          "duration_ms": 2981
        },
        {
          "index": 1,
          "text": "みんながしります。",
          "start_ms": 202789,
          "end_ms": 204795,
          "duration_ms": 2006
        }
      ]
    },
    {
      "index": 54,
      "text": "わたしがうそをつかなかったこと、そしてたけちよをおもってうそをついたことも、みんながしります。",
      "start_ms": 205295,
      "end_ms": 215167,
      "duration_ms": 9872,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがうそをつかなかったこと、",
          "start_ms": 205295,
          "end_ms": 208415,
          "duration_ms": 3120
        },
        {
          "index": 1,
          "text": "そしてたけちよをおもってうそをついたことも、",
          "start_ms": 208665,
          "end_ms": 212900,
          "duration_ms": 4235
        },
        {
          "index": 2,
          "text": "みんながしります。",
          "start_ms": 213150,
          "end_ms": 215167,
          "duration_ms": 2017
        }
      ]
    },
    {
      "index": 55,
      "text": "おとうさんにつたえることは、ひとつです。",
      "start_ms": 215667,
      "end_ms": 220183,
      "duration_ms": 4516,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんにつたえることは、",
          "start_ms": 215667,
          "end_ms": 218253,
          "duration_ms": 2586
        },
        {
          "index": 1,
          "text": "ひとつです。",
          "start_ms": 218503,
          "end_ms": 220183,
          "duration_ms": 1680
        }
      ]
    },
    {
      "index": 56,
      "text": "『わたしはたいせつなともだちをおもって、このいえをでました。",
      "start_ms": 220683,
      "end_ms": 226767,
      "duration_ms": 6084,
      "clauses": [
        {
          "index": 0,
          "text": "『わたしはたいせつなともだちをおもって、",
          "start_ms": 220683,
          "end_ms": 224372,
          "duration_ms": 3689
        },
        {
          "index": 1,
          "text": "このいえをでました。",
          "start_ms": 224622,
          "end_ms": 226767,
          "duration_ms": 2145
        }
      ]
    },
    {
      "index": 57,
      "text": "』わたしがかなしいのは、おやのびょうきです。",
      "start_ms": 227267,
      "end_ms": 232016,
      "duration_ms": 4749,
      "clauses": [
        {
          "index": 0,
          "text": "』わたしがかなしいのは、",
          "start_ms": 227267,
          "end_ms": 229621,
          "duration_ms": 2354
        },
        {
          "index": 1,
          "text": "おやのびょうきです。",
          "start_ms": 229871,
          "end_ms": 232016,
          "duration_ms": 2145
        }
      ]
    },
    {
      "index": 58,
      "text": "これをきいて、おやのびょうきがひどくなります。",
      "start_ms": 232516,
      "end_ms": 237485,
      "duration_ms": 4969,
      "clauses": [
        {
          "index": 0,
          "text": "これをきいて、",
          "start_ms": 232516,
          "end_ms": 234266,
          "duration_ms": 1750
        },
        {
          "index": 1,
          "text": "おやのびょうきがひどくなります。",
          "start_ms": 234516,
          "end_ms": 237485,
          "duration_ms": 2969
        }
      ]
    },
    {
      "index": 59,
      "text": "」ぶかはすごくかなしくなりました。",
      "start_ms": 237985,
      "end_ms": 241105,
      "duration_ms": 3120,
      "clauses": [
        {
          "index": 0,
          "text": "」ぶかはすごくかなしくなりました。",
          "start_ms": 237985,
          "end_ms": 241105,
          "duration_ms": 3120
        }
      ]
    },
    {
      "index": 60,
      "text": "そして、チョウシロウをしょうぐんのまえへつれていきました。",
      "start_ms": 241605,
      "end_ms": 247108,
      "duration_ms": 5503,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 241605,
          "end_ms": 242960,
          "duration_ms": 1355
        },
        {
          "index": 1,
          "text": "チョウシロウをしょうぐんのまえへつれていきました。",
          "start_ms": 243210,
          "end_ms": 247108,
          "duration_ms": 3898
        }
      ]
    },
    {
      "index": 61,
      "text": "チョウシロウはすわりました。",
      "start_ms": 247608,
      "end_ms": 250299,
      "duration_ms": 2691,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはすわりました。",
          "start_ms": 247608,
          "end_ms": 250299,
          "duration_ms": 2691
        }
      ]
    },
    {
      "index": 62,
      "text": "かみをなしました。",
      "start_ms": 250799,
      "end_ms": 252758,
      "duration_ms": 1959,
      "clauses": [
        {
          "index": 0,
          "text": "かみをなしました。",
          "start_ms": 250799,
          "end_ms": 252758,
          "duration_ms": 1959
        }
      ]
    },
    {
      "index": 63,
      "text": "こわくないかおをして、しょうぐんをまちました。",
      "start_ms": 253258,
      "end_ms": 258146,
      "duration_ms": 4888,
      "clauses": [
        {
          "index": 0,
          "text": "こわくないかおをして、",
          "start_ms": 253258,
          "end_ms": 255554,
          "duration_ms": 2296
        },
        {
          "index": 1,
          "text": "しょうぐんをまちました。",
          "start_ms": 255804,
          "end_ms": 258146,
          "duration_ms": 2342
        }
      ]
    },
    {
      "index": 64,
      "text": "しょうぐんはそのかおをみて、かたなをおきました。",
      "start_ms": 258646,
      "end_ms": 263859,
      "duration_ms": 5213,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはそのかおをみて、",
          "start_ms": 258646,
          "end_ms": 261441,
          "duration_ms": 2795
        },
        {
          "index": 1,
          "text": "かたなをおきました。",
          "start_ms": 261691,
          "end_ms": 263859,
          "duration_ms": 2168
        }
      ]
    },
    {
      "index": 65,
      "text": "しょうぐんはいいました。",
      "start_ms": 264359,
      "end_ms": 266643,
      "duration_ms": 2284,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはいいました。",
          "start_ms": 264359,
          "end_ms": 266643,
          "duration_ms": 2284
        }
      ]
    },
    {
      "index": 66,
      "text": "「チョウシロウ、もういいです。",
      "start_ms": 267143,
      "end_ms": 270592,
      "duration_ms": 3449,
      "clauses": [
        {
          "index": 0,
          "text": "「チョウシロウ、",
          "start_ms": 267143,
          "end_ms": 268673,
          "duration_ms": 1530
        },
        {
          "index": 1,
          "text": "もういいです。",
          "start_ms": 268923,
          "end_ms": 270592,
          "duration_ms": 1669
        }
      ]
    },
    {
      "index": 67,
      "text": "あなたはすごくいいこです。",
      "start_ms": 271092,
      "end_ms": 273806,
      "duration_ms": 2714,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはすごくいいこです。",
          "start_ms": 271092,
          "end_ms": 273806,
          "duration_ms": 2714
        }
      ]
    },
    {
      "index": 68,
      "text": "わたしはあなたのことを、よくしりました。",
      "start_ms": 274306,
      "end_ms": 279136,
      "duration_ms": 4830,
      "clauses": [
        {
          "index": 0,
          "text": "わたしはあなたのことを、",
          "start_ms": 274306,
          "end_ms": 276904,
          "duration_ms": 2598
        },
        {
          "index": 1,
          "text": "よくしりました。",
          "start_ms": 277154,
          "end_ms": 279136,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 69,
      "text": "たけちよがしょうぐんになるとき、あなたは、いつもたけちよのそばにいてください。",
      "start_ms": 279636,
      "end_ms": 287918,
      "duration_ms": 8282,
      "clauses": [
        {
          "index": 0,
          "text": "たけちよがしょうぐんになるとき、",
          "start_ms": 279636,
          "end_ms": 282524,
          "duration_ms": 2888
        },
        {
          "index": 1,
          "text": "あなたは、",
          "start_ms": 282774,
          "end_ms": 284304,
          "duration_ms": 1530
        },
        {
          "index": 2,
          "text": "いつもたけちよのそばにいてください。",
          "start_ms": 284554,
          "end_ms": 287918,
          "duration_ms": 3364
        }
      ]
    },
    {
      "index": 70,
      "text": "あなたはたいせつなともだちです。",
      "start_ms": 288418,
      "end_ms": 291631,
      "duration_ms": 3213,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはたいせつなともだちです。",
          "start_ms": 288418,
          "end_ms": 291631,
          "duration_ms": 3213
        }
      ]
    },
    {
      "index": 71,
      "text": "あなたはもうじゆうです。",
      "start_ms": 292131,
      "end_ms": 294647,
      "duration_ms": 2516,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうじゆうです。",
          "start_ms": 292131,
          "end_ms": 294647,
          "duration_ms": 2516
        }
      ]
    },
    {
      "index": 72,
      "text": "」\n\nそのときから、ふたりはなかがいいともだちになりました。",
      "start_ms": 295147,
      "end_ms": 300802,
      "duration_ms": 5655,
      "clauses": [
        {
          "index": 0,
          "text": "」\n\nそのときから、",
          "start_ms": 295147,
          "end_ms": 297002,
          "duration_ms": 1855
        },
        {
          "index": 1,
          "text": "ふたりはなかがいいともだちになりました。",
          "start_ms": 297252,
          "end_ms": 300802,
          "duration_ms": 3550
        }
      ]
    },
    {
      "index": 73,
      "text": "しょうぐんも、チョウシロウをたいせつにしました。",
      "start_ms": 301302,
      "end_ms": 306028,
      "duration_ms": 4726,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんも、",
          "start_ms": 301302,
          "end_ms": 302820,
          "duration_ms": 1518
        },
        {
          "index": 1,
          "text": "チョウシロウをたいせつにしました。",
          "start_ms": 303070,
          "end_ms": 306028,
          "duration_ms": 2958
        }
      ]
    },
    {
      "index": 74,
      "text": "ながいじかんのあとで、チョウシロウはおおきくなって、ゆうめいなひとになりました。",
      "start_ms": 306528,
      "end_ms": 314542,
      "duration_ms": 8014,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんのあとで、",
          "start_ms": 306528,
          "end_ms": 308789,
          "duration_ms": 2261
        },
        {
          "index": 1,
          "text": "チョウシロウはおおきくなって、",
          "start_ms": 309039,
          "end_ms": 311776,
          "duration_ms": 2737
        },
        {
          "index": 2,
          "text": "ゆうめいなひとになりました。",
          "start_ms": 312026,
          "end_ms": 314542,
          "duration_ms": 2516
        }
      ]
    },
    {
      "index": 75,
      "text": "みんなが、チョウシロウをおぼえています。",
      "start_ms": 315042,
      "end_ms": 319396,
      "duration_ms": 4354,
      "clauses": [
        {
          "index": 0,
          "text": "みんなが、",
          "start_ms": 315042,
          "end_ms": 316374,
          "duration_ms": 1332
        },
        {
          "index": 1,
          "text": "チョウシロウをおぼえています。",
          "start_ms": 316624,
          "end_ms": 319396,
          "duration_ms": 2772
        }
      ]
    }
  ]
