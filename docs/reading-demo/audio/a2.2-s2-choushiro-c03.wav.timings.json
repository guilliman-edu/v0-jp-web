          "end_ms": 268394,
          "duration_ms": 1448
        },
        {
          "index": 1,
          "text": "もういいです。",
          "start_ms": 268644,
          "end_ms": 270359,
          "duration_ms": 1715
        }
      ]
    },
    {
      "index": 67,
      "text": "あなたはすごくいいこです。",
      "start_ms": 270859,
      "end_ms": 273573,
      "duration_ms": 2714,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはすごくいいこです。",
          "start_ms": 270859,
          "end_ms": 273573,
          "duration_ms": 2714
        }
      ]
    },
    {
      "index": 68,
      "text": "わたしはあなたのことを、よくしりました。",
      "start_ms": 274073,
      "end_ms": 278856,
      "duration_ms": 4783,
      "clauses": [
        {
          "index": 0,
          "text": "わたしはあなたのことを、",
          "start_ms": 274073,
          "end_ms": 276659,
          "duration_ms": 2586
        },
        {
          "index": 1,
          "text": "よくしりました。",
          "start_ms": 276909,
          "end_ms": 278856,
          "duration_ms": 1947
        }
      ]
    },
    {
      "index": 69,
      "text": "たけちよがしょうぐんになるとき、あなたは、いつもたけちよのそばにいてください。",
      "start_ms": 279356,
      "end_ms": 287603,
      "duration_ms": 8247,
      "clauses": [
        {
          "index": 0,
          "text": "たけちよがしょうぐんになるとき、",
          "start_ms": 279356,
          "end_ms": 282221,
          "duration_ms": 2865
        },
        {
          "index": 1,
          "text": "あなたは、",
          "start_ms": 282471,
          "end_ms": 283954,
          "duration_ms": 1483
        },
        {
          "index": 2,
          "text": "いつもたけちよのそばにいてください。",
          "start_ms": 284204,
          "end_ms": 287603,
          "duration_ms": 3399
        }
      ]
    },
    {
      "index": 70,
      "text": "あなたはたいせつなともだちです。",
      "start_ms": 288103,
      "end_ms": 291397,
      "duration_ms": 3294,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはたいせつなともだちです。",
          "start_ms": 288103,
          "end_ms": 291397,
          "duration_ms": 3294
        }
      ]
    },
    {
      "index": 71,
      "text": "あなたはもうじゆうです。」",
      "start_ms": 291897,
      "end_ms": 294355,
      "duration_ms": 2458,
      "clauses": [
