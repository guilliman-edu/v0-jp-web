      "start_ms": 294855,
      "end_ms": 300417,
      "duration_ms": 5562,
      "clauses": [
        {
          "index": 0,
          "text": "そのときから、",
          "start_ms": 294855,
          "end_ms": 296617,
          "duration_ms": 1762
        },
        {
          "index": 1,
          "text": "ふたりはなかがいいともだちになりました。",
          "start_ms": 296867,
          "end_ms": 300417,
          "duration_ms": 3550
        }
      ]
    },
    {
      "index": 73,
      "text": "しょうぐんも、チョウシロウをたいせつにしました。",
      "start_ms": 300917,
      "end_ms": 305642,
      "duration_ms": 4725,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんも、",
          "start_ms": 300917,
          "end_ms": 302481,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "チョウシロウをたいせつにしました。",
          "start_ms": 302731,
          "end_ms": 305642,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 74,
      "text": "ながいじかんのあとで、チョウシロウはおおきくなって、ゆうめいなひとになりました。",
      "start_ms": 306142,
      "end_ms": 314424,
      "duration_ms": 8282,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんのあとで、",
          "start_ms": 306142,
          "end_ms": 308438,
          "duration_ms": 2296
        },
        {
          "index": 1,
          "text": "チョウシロウはおおきくなって、",
          "start_ms": 308688,
          "end_ms": 311646,
          "duration_ms": 2958
        },
        {
