      "end_ms": 252828,
      "duration_ms": 2180,
      "clauses": [
        {
          "index": 0,
          "text": "かみをなおしました。",
          "start_ms": 250648,
          "end_ms": 252828,
          "duration_ms": 2180
        }
      ]
    },
    {
      "index": 63,
      "text": "こわくないかおをして、しょうぐんをまちました。",
      "start_ms": 253328,
      "end_ms": 258146,
      "duration_ms": 4818,
      "clauses": [
        {
          "index": 0,
          "text": "こわくないかおをして、",
          "start_ms": 253328,
          "end_ms": 255577,
          "duration_ms": 2249
        },
