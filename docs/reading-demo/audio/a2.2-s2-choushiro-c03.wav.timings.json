          "index": 1,
          "text": "しょうぐんをまちました。",
          "start_ms": 255827,
          "end_ms": 258146,
          "duration_ms": 2319
        }
      ]
    },
    {
      "index": 64,
      "text": "しょうぐんはそのかおをみて、かたなをおきました。",
      "start_ms": 258646,
      "end_ms": 263801,
      "duration_ms": 5155,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはそのかおをみて、",
          "start_ms": 258646,
          "end_ms": 261453,
          "duration_ms": 2807
        },
        {
          "index": 1,
          "text": "かたなをおきました。",
          "start_ms": 261703,
          "end_ms": 263801,
          "duration_ms": 2098
        }
      ]
    },
    {
      "index": 65,
      "text": "しょうぐんはいいました。",
      "start_ms": 264301,
      "end_ms": 266446,
      "duration_ms": 2145,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはいいました。",
          "start_ms": 264301,
          "end_ms": 266446,
          "duration_ms": 2145
        }
      ]
    },
    {
      "index": 66,
      "text": "「チョウシロウ、もういいです。",
      "start_ms": 266946,
      "end_ms": 270359,
      "duration_ms": 3413,
      "clauses": [
        {
          "index": 0,
          "text": "「チョウシロウ、",
