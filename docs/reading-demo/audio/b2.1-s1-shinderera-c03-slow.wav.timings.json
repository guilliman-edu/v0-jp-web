  "total_duration_ms": 239141,
  "sentences": [
    {
      "index": 0,
      "text": "舞踏会への招待",
      "start_ms": 0,
      "end_ms": 2296,
      "duration_ms": 2296,
      "clauses": [
        {
          "index": 0,
          "text": "舞踏会への招待",
          "start_ms": 0,
          "end_ms": 2296,
          "duration_ms": 2296
        }
      ]
    },
    {
      "index": 1,
      "text": "ところが、おうさまがお祝いを開くことになりました。",
      "start_ms": 2796,
      "end_ms": 8358,
      "duration_ms": 5562,
      "clauses": [
        {
          "index": 0,
          "text": "ところが、",
          "start_ms": 2796,
          "end_ms": 4291,
          "duration_ms": 1495
        },
        {
          "index": 1,
          "text": "おうさまがお祝いを開くことになりました。",
          "start_ms": 4541,
          "end_ms": 8358,
          "duration_ms": 3817
        }
      ]
    },
    {
      "index": 2,
      "text": "三日間続くお祝いで、おうさまの息子がはなよめを選ぶために、国のうつくしい若い娘は全部しょうたいされることになりました。",
      "start_ms": 8858,
      "end_ms": 21296,
      "duration_ms": 12438,
      "clauses": [
        {
          "index": 0,
          "text": "三日間続くお祝いで、",
          "start_ms": 8858,
          "end_ms": 11421,
          "duration_ms": 2563
        },
        {
          "index": 1,
          "text": "おうさまの息子がはなよめを選ぶために、",
          "start_ms": 11671,
          "end_ms": 15348,
          "duration_ms": 3677
        },
        {
          "index": 2,
          "text": "国のうつくしい若い娘は全部しょうたいされることになりました。",
          "start_ms": 15598,
          "end_ms": 21296,
          "duration_ms": 5698
        }
      ]
    },
    {
      "index": 3,
      "text": "二人のこいもうとは、自分たちもお祝いに行けると聞いて、とても喜びました。",
      "start_ms": 21796,
      "end_ms": 30310,
      "duration_ms": 8514,
      "clauses": [
        {
          "index": 0,
          "text": "二人のこいもうとは、",
          "start_ms": 21796,
          "end_ms": 24069,
          "duration_ms": 2273
        },
        {
          "index": 1,
          "text": "自分たちもお祝いに行けると聞いて、",
          "start_ms": 24319,
          "end_ms": 27695,
          "duration_ms": 3376
        },
        {
          "index": 2,
          "text": "とても喜びました。",
          "start_ms": 27945,
          "end_ms": 30310,
          "duration_ms": 2365
        }
      ]
    },
    {
      "index": 4,
      "text": "そして、シンデレラを呼びました。",
      "start_ms": 30810,
      "end_ms": 34943,
      "duration_ms": 4133,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 30810,
          "end_ms": 32177,
          "duration_ms": 1367
        },
        {
          "index": 1,
          "text": "シンデレラを呼びました。",
          "start_ms": 32427,
          "end_ms": 34943,
          "duration_ms": 2516
        }
      ]
    },
    {
      "index": 5,
      "text": "「私たちの髪をとかして、靴を磨いて、ベルトをしめて。",
      "start_ms": 35443,
      "end_ms": 42586,
      "duration_ms": 7143,
      "clauses": [
        {
          "index": 0,
          "text": "「私たちの髪をとかして、",
          "start_ms": 35443,
          "end_ms": 38238,
          "duration_ms": 2795
        },
        {
          "index": 1,
          "text": "靴を磨いて、",
          "start_ms": 38488,
          "end_ms": 40354,
          "duration_ms": 1866
        },
        {
          "index": 2,
          "text": "ベルトをしめて。",
          "start_ms": 40604,
          "end_ms": 42586,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 6,
      "text": "私たちはおうさまのきゅうでんのお祝いに行くのだから。」",
      "start_ms": 43086,
      "end_ms": 47948,
      "duration_ms": 4862,
      "clauses": [
        {
          "index": 0,
          "text": "私たちはおうさまのきゅうでんのお祝いに行くのだから。」",
          "start_ms": 43086,
          "end_ms": 47948,
          "duration_ms": 4862
        }
      ]
    },
    {
      "index": 7,
      "text": "シンデレラも行きたくて、泣きました。",
      "start_ms": 48448,
      "end_ms": 52813,
      "duration_ms": 4365,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラも行きたくて、",
          "start_ms": 48448,
          "end_ms": 50883,
          "duration_ms": 2435
        },
        {
          "index": 1,
          "text": "泣きました。",
          "start_ms": 51133,
          "end_ms": 52813,
          "duration_ms": 1680
        }
      ]
    },
    {
      "index": 8,
      "text": "自分も一緒に踊りに行きたかったからです。",
      "start_ms": 53313,
      "end_ms": 57362,
      "duration_ms": 4049,
      "clauses": [
        {
          "index": 0,
          "text": "自分も一緒に踊りに行きたかったからです。",
          "start_ms": 53313,
          "end_ms": 57362,
          "duration_ms": 4049
        }
      ]
    },
    {
      "index": 9,
      "text": "それから、ままははにそうするきょかをもらおうと頼みました。",
      "start_ms": 57862,
      "end_ms": 63922,
      "duration_ms": 6060,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 57862,
          "end_ms": 59333,
          "duration_ms": 1471
        },
        {
          "index": 1,
          "text": "ままははにそうするきょかをもらおうと頼みました。",
          "start_ms": 59583,
          "end_ms": 63922,
          "duration_ms": 4339
        }
      ]
    },
    {
      "index": 10,
      "text": "「あなたは埃と泥まみれでしょう。",
      "start_ms": 64422,
      "end_ms": 67798,
      "duration_ms": 3376,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたは埃と泥まみれでしょう。",
          "start_ms": 64422,
          "end_ms": 67798,
          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 11,
      "text": "それでぶとうかいに行くの？",
      "start_ms": 68298,
      "end_ms": 70780,
      "duration_ms": 2482,
      "clauses": [
        {
          "index": 0,
          "text": "それでぶとうかいに行くの？",
          "start_ms": 68298,
          "end_ms": 70780,
          "duration_ms": 2482
        }
      ]
    },
    {
      "index": 12,
      "text": "服もないし、靴もないのに、踊るっていうの？」",
      "start_ms": 71280,
      "end_ms": 77321,
      "duration_ms": 6041,
      "clauses": [
        {
          "index": 0,
          "text": "服もないし、",
          "start_ms": 71280,
          "end_ms": 73100,
          "duration_ms": 1820
        },
        {
          "index": 1,
          "text": "靴もないのに、",
          "start_ms": 73350,
          "end_ms": 75170,
          "duration_ms": 1820
        },
        {
          "index": 2,
          "text": "踊るっていうの？」",
          "start_ms": 75420,
          "end_ms": 77321,
          "duration_ms": 1901
        }
      ]
    },
    {
      "index": 13,
      "text": "でも、シンデレラがしつこく頼み続けたので、ままはははついにこう言いました。",
      "start_ms": 77821,
      "end_ms": 86009,
      "duration_ms": 8188,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 77821,
          "end_ms": 78793,
          "duration_ms": 972
        },
        {
          "index": 1,
          "text": "シンデレラがしつこく頼み続けたので、",
          "start_ms": 79043,
          "end_ms": 82604,
          "duration_ms": 3561
        },
        {
          "index": 2,
          "text": "ままはははついにこう言いました。",
          "start_ms": 82854,
          "end_ms": 86009,
          "duration_ms": 3155
        }
      ]
    },
    {
      "index": 14,
      "text": "「ほら、灰の中にレンズ豆を一皿空けておいたから。",
      "start_ms": 86509,
      "end_ms": 91815,
      "duration_ms": 5306,
      "clauses": [
        {
          "index": 0,
          "text": "「ほら、",
          "start_ms": 86509,
          "end_ms": 87307,
          "duration_ms": 798
        },
        {
          "index": 1,
          "text": "灰の中にレンズ豆を一皿空けておいたから。",
          "start_ms": 87557,
          "end_ms": 91815,
          "duration_ms": 4258
        }
      ]
    },
    {
      "index": 15,
      "text": "二時間でそれを全部拾えたら、一緒に行ってあげるよ。」",
      "start_ms": 92315,
      "end_ms": 98062,
      "duration_ms": 5747,
      "clauses": [
        {
          "index": 0,
          "text": "二時間でそれを全部拾えたら、",
          "start_ms": 92315,
          "end_ms": 95563,
          "duration_ms": 3248
        },
        {
          "index": 1,
          "text": "一緒に行ってあげるよ。」",
          "start_ms": 95813,
          "end_ms": 98062,
          "duration_ms": 2249
        }
      ]
    },
    {
      "index": 16,
      "text": "娘は裏口から庭に出ました。",
      "start_ms": 98562,
      "end_ms": 101914,
      "duration_ms": 3352,
      "clauses": [
        {
          "index": 0,
          "text": "娘は裏口から庭に出ました。",
          "start_ms": 98562,
          "end_ms": 101914,
          "duration_ms": 3352
        }
      ]
    },
    {
      "index": 17,
      "text": "「お友達のハトさん、キジバトさん、空の下の小鳥さんたち、みんな。",
      "start_ms": 102414,
      "end_ms": 111407,
      "duration_ms": 8993,
      "clauses": [
        {
          "index": 0,
          "text": "「お友達のハトさん、",
          "start_ms": 102414,
          "end_ms": 104756,
          "duration_ms": 2342
        },
        {
          "index": 1,
          "text": "キジバトさん、",
          "start_ms": 105006,
          "end_ms": 106803,
          "duration_ms": 1797
        },
        {
          "index": 2,
          "text": "空の下の小鳥さんたち、",
          "start_ms": 107053,
          "end_ms": 109918,
          "duration_ms": 2865
        },
        {
          "index": 3,
          "text": "みんな。",
          "start_ms": 110168,
          "end_ms": 111407,
          "duration_ms": 1239
        }
      ]
    },
    {
      "index": 18,
      "text": "いい豆はかごに、悪い豆はみんなさんに。",
      "start_ms": 111907,
      "end_ms": 116970,
      "duration_ms": 5063,
      "clauses": [
        {
          "index": 0,
          "text": "いい豆はかごに、",
          "start_ms": 111907,
          "end_ms": 113971,
          "duration_ms": 2064
        },
        {
          "index": 1,
          "text": "悪い豆はみんなさんに。",
          "start_ms": 114221,
          "end_ms": 116970,
          "duration_ms": 2749
        }
      ]
    },
    {
      "index": 19,
      "text": "拾うのを手伝ってちょうだい。」",
      "start_ms": 117470,
      "end_ms": 120219,
      "duration_ms": 2749,
      "clauses": [
        {
          "index": 0,
          "text": "拾うのを手伝ってちょうだい。」",
          "start_ms": 117470,
          "end_ms": 120219,
          "duration_ms": 2749
        }
      ]
    },
    {
      "index": 20,
      "text": "すると、二羽の白いはとが台所の窓から入ってきました。",
      "start_ms": 120719,
      "end_ms": 127035,
      "duration_ms": 6316,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 120719,
          "end_ms": 122016,
          "duration_ms": 1297
        },
        {
          "index": 1,
          "text": "二羽の白いはとが台所の窓から入ってきました。",
          "start_ms": 122266,
          "end_ms": 127035,
          "duration_ms": 4769
        }
      ]
    },
    {
      "index": 21,
      "text": "そのあとでキジバトが来て、最後に空の下の小鳥たちが全部集まってきて、灰の中に降りました。",
      "start_ms": 127535,
      "end_ms": 137988,
      "duration_ms": 10453,
      "clauses": [
        {
          "index": 0,
          "text": "そのあとでキジバトが来て、",
          "start_ms": 127535,
          "end_ms": 130191,
          "duration_ms": 2656
        },
        {
          "index": 1,
          "text": "最後に空の下の小鳥たちが全部集まってきて、",
          "start_ms": 130441,
          "end_ms": 135291,
          "duration_ms": 4850
        },
        {
          "index": 2,
          "text": "灰の中に降りました。",
          "start_ms": 135541,
          "end_ms": 137988,
          "duration_ms": 2447
        }
      ]
    },
    {
      "index": 22,
      "text": "はとたちが頭をひょこひょこさせて、コッコッコッとつつき始めました。",
      "start_ms": 138488,
      "end_ms": 145663,
      "duration_ms": 7175,
      "clauses": [
        {
          "index": 0,
          "text": "はとたちが頭をひょこひょこさせて、",
          "start_ms": 138488,
          "end_ms": 142223,
          "duration_ms": 3735
        },
        {
          "index": 1,
          "text": "コッコッコッとつつき始めました。",
          "start_ms": 142473,
          "end_ms": 145663,
          "duration_ms": 3190
        }
      ]
    },
    {
      "index": 23,
      "text": "残りの鳥たちもコッコッコッと始めて、皿に全部の良い豆を集めました。",
      "start_ms": 146163,
      "end_ms": 154023,
      "duration_ms": 7860,
      "clauses": [
        {
          "index": 0,
          "text": "残りの鳥たちもコッコッコッと始めて、",
          "start_ms": 146163,
          "end_ms": 150177,
          "duration_ms": 4014
        },
        {
          "index": 1,
          "text": "皿に全部の良い豆を集めました。",
          "start_ms": 150427,
          "end_ms": 154023,
          "duration_ms": 3596
        }
      ]
    },
    {
      "index": 24,
      "text": "一時間もたたないうちに、小鳥たちは終わって、また飛び去りました。",
      "start_ms": 154523,
      "end_ms": 162618,
      "duration_ms": 8095,
      "clauses": [
        {
          "index": 0,
          "text": "一時間もたたないうちに、",
          "start_ms": 154523,
          "end_ms": 157248,
          "duration_ms": 2725
        },
        {
          "index": 1,
          "text": "小鳥たちは終わって、",
          "start_ms": 157498,
          "end_ms": 159840,
          "duration_ms": 2342
        },
        {
          "index": 2,
          "text": "また飛び去りました。",
          "start_ms": 160090,
          "end_ms": 162618,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 25,
      "text": "娘は皿をままははのところに持って行きました。",
      "start_ms": 163118,
      "end_ms": 167620,
      "duration_ms": 4502,
      "clauses": [
        {
          "index": 0,
          "text": "娘は皿をままははのところに持って行きました。",
          "start_ms": 163118,
          "end_ms": 167620,
          "duration_ms": 4502
        }
      ]
    },
    {
      "index": 26,
      "text": "嬉しくて、今度こそお祝いに行けると信じていました。",
      "start_ms": 168120,
      "end_ms": 174006,
      "duration_ms": 5886,
      "clauses": [
        {
          "index": 0,
          "text": "嬉しくて、",
          "start_ms": 168120,
          "end_ms": 169696,
          "duration_ms": 1576
        },
        {
          "index": 1,
          "text": "今度こそお祝いに行けると信じていました。",
          "start_ms": 169946,
          "end_ms": 174006,
          "duration_ms": 4060
        }
      ]
    },
    {
      "index": 27,
      "text": "でも、ままははは「だめよ、シンデレラ。",
      "start_ms": 174506,
      "end_ms": 179769,
      "duration_ms": 5263,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 174506,
          "end_ms": 175490,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "ままははは「だめよ、",
          "start_ms": 175740,
          "end_ms": 177862,
          "duration_ms": 2122
        },
        {
          "index": 2,
          "text": "シンデレラ。",
          "start_ms": 178112,
          "end_ms": 179769,
          "duration_ms": 1657
        }
      ]
    },
    {
      "index": 28,
      "text": "服がないじゃないし、踊れないわ。",
      "start_ms": 180269,
      "end_ms": 184391,
      "duration_ms": 4122,
      "clauses": [
        {
          "index": 0,
          "text": "服がないじゃないし、",
          "start_ms": 180269,
          "end_ms": 182495,
          "duration_ms": 2226
        },
        {
          "index": 1,
          "text": "踊れないわ。",
          "start_ms": 182745,
          "end_ms": 184391,
          "duration_ms": 1646
        }
      ]
    },
    {
      "index": 29,
      "text": "ただ笑われるだけだよ。」",
      "start_ms": 184891,
      "end_ms": 187326,
      "duration_ms": 2435,
      "clauses": [
        {
          "index": 0,
          "text": "ただ笑われるだけだよ。」",
          "start_ms": 184891,
          "end_ms": 187326,
          "duration_ms": 2435
        }
      ]
    },
    {
      "index": 30,
      "text": "と言いました。",
      "start_ms": 187826,
      "end_ms": 189518,
      "duration_ms": 1692,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 187826,
          "end_ms": 189518,
          "duration_ms": 1692
        }
      ]
    },
    {
      "index": 31,
      "text": "シンデレラが泣くと、ままははは「一時間で灰から二皿のレンズ豆を拾ったら、一緒に行ってあげるよ。」",
      "start_ms": 190018,
      "end_ms": 200181,
      "duration_ms": 10163,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラが泣くと、",
          "start_ms": 190018,
          "end_ms": 192233,
          "duration_ms": 2215
        },
        {
          "index": 1,
          "text": "ままははは「一時間で灰から二皿のレンズ豆を拾ったら、",
          "start_ms": 192483,
          "end_ms": 197670,
          "duration_ms": 5187
        },
        {
          "index": 2,
          "text": "一緒に行ってあげるよ。」",
          "start_ms": 197920,
          "end_ms": 200181,
          "duration_ms": 2261
        }
      ]
    },
    {
      "index": 32,
      "text": "と言いました。",
      "start_ms": 200681,
      "end_ms": 202396,
      "duration_ms": 1715,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 200681,
          "end_ms": 202396,
          "duration_ms": 1715
        }
      ]
    },
    {
      "index": 33,
      "text": "娘はまた庭に行って、小鳥たちにてつだいを頼みました。",
      "start_ms": 202896,
      "end_ms": 209200,
      "duration_ms": 6304,
      "clauses": [
        {
          "index": 0,
          "text": "娘はまた庭に行って、",
          "start_ms": 202896,
          "end_ms": 205528,
          "duration_ms": 2632
        },
        {
          "index": 1,
          "text": "小鳥たちにてつだいを頼みました。",
          "start_ms": 205778,
          "end_ms": 209200,
          "duration_ms": 3422
        }
      ]
    },
    {
      "index": 34,
      "text": "今度は三十分もたたないうちに、全部の豆を集めました。",
      "start_ms": 209700,
      "end_ms": 216422,
      "duration_ms": 6722,
      "clauses": [
        {
          "index": 0,
          "text": "今度は三十分もたたないうちに、",
          "start_ms": 209700,
          "end_ms": 213319,
          "duration_ms": 3619
        },
        {
          "index": 1,
          "text": "全部の豆を集めました。",
