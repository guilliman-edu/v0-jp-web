  "sentences": [
    {
      "index": 0,
      "text": "ぶとうかいへのしょうたい",
      "start_ms": 0,
      "end_ms": 2307,
      "duration_ms": 2307,
      "clauses": [
        {
          "index": 0,
          "text": "ぶとうかいへのしょうたい",
          "start_ms": 0,
          "end_ms": 2307,
          "duration_ms": 2307
        }
      ]
    },
    {
      "index": 1,
      "text": "ところが、おうさまがお祝いを開くことになりました。",
      "start_ms": 2807,
      "end_ms": 8508,
      "duration_ms": 5701,
      "clauses": [
        {
          "index": 0,
          "text": "ところが、",
          "start_ms": 2807,
          "end_ms": 4290,
          "duration_ms": 1483
        },
        {
          "index": 1,
          "text": "おうさまがお祝いを開くことになりました。",
          "start_ms": 4540,
          "end_ms": 8508,
          "duration_ms": 3968
        }
      ]
    },
    {
      "index": 2,
      "text": "三日間続くお祝いで、おうさまの息子がはなよめを選ぶために、国のうつくしい若い娘は全部しょうたいされることになりました。",
      "start_ms": 9008,
      "end_ms": 21678,
      "duration_ms": 12670,
      "clauses": [
        {
          "index": 0,
          "text": "三日間続くお祝いで、",
          "start_ms": 9008,
          "end_ms": 11582,
          "duration_ms": 2574
        },
        {
          "index": 1,
          "text": "おうさまの息子がはなよめを選ぶために、",
          "start_ms": 11832,
          "end_ms": 15556,
          "duration_ms": 3724
        },
        {
          "index": 2,
          "text": "国のうつくしい若い娘は全部しょうたいされることになりました。",
          "start_ms": 15806,
          "end_ms": 21678,
          "duration_ms": 5872
        }
      ]
    },
    {
      "index": 3,
      "text": "二人のままむすめは、自分たちもお祝いに行けると聞いて、とても喜びました。",
      "start_ms": 22178,
      "end_ms": 30587,
      "duration_ms": 8409,
      "clauses": [
        {
          "index": 0,
          "text": "二人のままむすめは、",
          "start_ms": 22178,
          "end_ms": 24497,
          "duration_ms": 2319
        },
        {
          "index": 1,
          "text": "自分たちもお祝いに行けると聞いて、",
          "start_ms": 24747,
          "end_ms": 28018,
          "duration_ms": 3271
        },
        {
          "index": 2,
          "text": "とても喜びました。",
          "start_ms": 28268,
          "end_ms": 30587,
          "duration_ms": 2319
        }
      ]
    },
    {
      "index": 4,
      "text": "そして、シンデレラを呼びました。",
      "start_ms": 31087,
      "end_ms": 35185,
      "duration_ms": 4098,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 31087,
          "end_ms": 32442,
          "duration_ms": 1355
        },
        {
          "index": 1,
          "text": "シンデレラを呼びました。",
          "start_ms": 32692,
          "end_ms": 35185,
          "duration_ms": 2493
        }
      ]
    },
    {
      "index": 5,
      "text": "「私たちの髪をとかして、靴を磨いて、ベルトをしめて。",
      "start_ms": 35685,
      "end_ms": 42898,
      "duration_ms": 7213,
      "clauses": [
        {
          "index": 0,
          "text": "「私たちの髪をとかして、",
          "start_ms": 35685,
          "end_ms": 38515,
          "duration_ms": 2830
        },
        {
          "index": 1,
          "text": "靴を磨いて、",
          "start_ms": 38765,
          "end_ms": 40666,
          "duration_ms": 1901
        },
        {
          "index": 2,
          "text": "ベルトをしめて。",
          "start_ms": 40916,
          "end_ms": 42898,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 6,
      "text": "私たちはおうさまのきゅうでんのお祝いに行くのだから。」",
      "start_ms": 43398,
      "end_ms": 48248,
      "duration_ms": 4850,
      "clauses": [
        {
          "index": 0,
          "text": "私たちはおうさまのきゅうでんのお祝いに行くのだから。」",
          "start_ms": 43398,
          "end_ms": 48248,
          "duration_ms": 4850
        }
      ]
    },
    {
      "index": 7,
      "text": "シンデレラも行きたくて、泣きました。",
      "start_ms": 48748,
      "end_ms": 53137,
      "duration_ms": 4389,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラも行きたくて、",
          "start_ms": 48748,
          "end_ms": 51218,
          "duration_ms": 2470
        },
        {
          "index": 1,
          "text": "泣きました。",
          "start_ms": 51468,
          "end_ms": 53137,
          "duration_ms": 1669
        }
      ]
    },
    {
      "index": 8,
      "text": "自分も一緒に踊りに行きたかったからです。",
      "start_ms": 53637,
      "end_ms": 57616,
      "duration_ms": 3979,
      "clauses": [
        {
          "index": 0,
          "text": "自分も一緒に踊りに行きたかったからです。",
          "start_ms": 53637,
          "end_ms": 57616,
          "duration_ms": 3979
        }
      ]
    },
    {
      "index": 9,
      "text": "それから、ままははにそうするきょかをもらおうと頼みました。",
      "start_ms": 58116,
      "end_ms": 64258,
      "duration_ms": 6142,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 58116,
          "end_ms": 59680,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "ままははにそうするきょかをもらおうと頼みました。",
          "start_ms": 59930,
          "end_ms": 64258,
          "duration_ms": 4328
        }
      ]
    },
    {
      "index": 10,
      "text": "「あなたは埃と泥まみれでしょう。",
      "start_ms": 64758,
      "end_ms": 68145,
      "duration_ms": 3387,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたは埃と泥まみれでしょう。",
          "start_ms": 64758,
          "end_ms": 68145,
          "duration_ms": 3387
        }
      ]
    },
    {
      "index": 11,
      "text": "それでぶとうかいに行くの？",
      "start_ms": 68645,
      "end_ms": 71127,
      "duration_ms": 2482,
      "clauses": [
        {
          "index": 0,
          "text": "それでぶとうかいに行くの？",
          "start_ms": 68645,
          "end_ms": 71127,
          "duration_ms": 2482
        }
      ]
    },
    {
      "index": 12,
      "text": "服もないし、靴もないのに、踊るっていうの？」",
      "start_ms": 71627,
      "end_ms": 77574,
      "duration_ms": 5947,
      "clauses": [
        {
          "index": 0,
          "text": "服もないし、",
          "start_ms": 71627,
          "end_ms": 73377,
          "duration_ms": 1750
        },
        {
          "index": 1,
          "text": "靴もないのに、",
          "start_ms": 73627,
          "end_ms": 75458,
          "duration_ms": 1831
        },
        {
          "index": 2,
          "text": "踊るっていうの？」",
          "start_ms": 75708,
          "end_ms": 77574,
          "duration_ms": 1866
        }
      ]
    },
    {
      "index": 13,
      "text": "でも、シンデレラがしつこく頼み続けたので、ままはははついにこう言いました。",
      "start_ms": 78074,
      "end_ms": 86343,
      "duration_ms": 8269,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 78074,
          "end_ms": 79058,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "シンデレラがしつこく頼み続けたので、",
          "start_ms": 79308,
          "end_ms": 82892,
          "duration_ms": 3584
        },
        {
          "index": 2,
          "text": "ままはははついにこう言いました。",
          "start_ms": 83142,
          "end_ms": 86343,
          "duration_ms": 3201
        }
      ]
    },
    {
      "index": 14,
      "text": "「ほら、灰の中にレンズ豆を一皿空けておいたから。",
      "start_ms": 86843,
      "end_ms": 92137,
      "duration_ms": 5294,
      "clauses": [
        {
          "index": 0,
          "text": "「ほら、",
          "start_ms": 86843,
          "end_ms": 87629,
          "duration_ms": 786
        },
        {
          "index": 1,
          "text": "灰の中にレンズ豆を一皿空けておいたから。",
          "start_ms": 87879,
          "end_ms": 92137,
          "duration_ms": 4258
        }
      ]
    },
    {
      "index": 15,
      "text": "二時間でそれを全部拾えたら、一緒に行ってあげるよ。」",
      "start_ms": 92637,
      "end_ms": 98338,
      "duration_ms": 5701,
      "clauses": [
        {
          "index": 0,
          "text": "二時間でそれを全部拾えたら、",
          "start_ms": 92637,
          "end_ms": 95827,
          "duration_ms": 3190
        },
        {
          "index": 1,
          "text": "一緒に行ってあげるよ。」",
          "start_ms": 96077,
          "end_ms": 98338,
          "duration_ms": 2261
        }
      ]
    },
    {
      "index": 16,
      "text": "娘は裏口から庭に出ました。",
      "start_ms": 98838,
      "end_ms": 102167,
      "duration_ms": 3329,
      "clauses": [
        {
          "index": 0,
          "text": "娘は裏口から庭に出ました。",
          "start_ms": 98838,
          "end_ms": 102167,
          "duration_ms": 3329
        }
      ]
    },
    {
      "index": 17,
      "text": "「お友達のハトさん、キジバトさん、空の下の小鳥さんたち、みんな。",
      "start_ms": 102667,
      "end_ms": 111567,
      "duration_ms": 8900,
      "clauses": [
        {
          "index": 0,
          "text": "「お友達のハトさん、",
          "start_ms": 102667,
          "end_ms": 104998,
          "duration_ms": 2331
        },
        {
          "index": 1,
          "text": "キジバトさん、",
          "start_ms": 105248,
          "end_ms": 107033,
          "duration_ms": 1785
        },
        {
          "index": 2,
          "text": "空の下の小鳥さんたち、",
          "start_ms": 107283,
          "end_ms": 110159,
          "duration_ms": 2876
        },
        {
          "index": 3,
          "text": "みんな。",
          "start_ms": 110409,
          "end_ms": 111567,
          "duration_ms": 1158
        }
      ]
    },
    {
      "index": 18,
      "text": "いい豆はかごに、悪い豆はみんなさんに。",
      "start_ms": 112067,
      "end_ms": 117153,
      "duration_ms": 5086,
      "clauses": [
        {
          "index": 0,
          "text": "いい豆はかごに、",
          "start_ms": 112067,
          "end_ms": 114096,
          "duration_ms": 2029
        },
        {
          "index": 1,
          "text": "悪い豆はみんなさんに。",
          "start_ms": 114346,
          "end_ms": 117153,
          "duration_ms": 2807
        }
      ]
    },
    {
      "index": 19,
      "text": "拾うのを手伝ってちょうだい。」",
      "start_ms": 117653,
      "end_ms": 120239,
      "duration_ms": 2586,
      "clauses": [
        {
          "index": 0,
          "text": "拾うのを手伝ってちょうだい。」",
          "start_ms": 117653,
          "end_ms": 120239,
          "duration_ms": 2586
        }
      ]
    },
    {
      "index": 20,
      "text": "すると、二羽の白いはとが台所の窓から入ってきました。",
      "start_ms": 120739,
      "end_ms": 127125,
      "duration_ms": 6386,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 120739,
          "end_ms": 122048,
          "duration_ms": 1309
        },
        {
          "index": 1,
          "text": "二羽の白いはとが台所の窓から入ってきました。",
          "start_ms": 122298,
          "end_ms": 127125,
          "duration_ms": 4827
        }
      ]
    },
    {
      "index": 21,
      "text": "そのあとでキジバトが来て、最後に空の下の小鳥たちが全部集まってきて、灰の中に降りました。",
      "start_ms": 127625,
      "end_ms": 138065,
      "duration_ms": 10440,
      "clauses": [
        {
          "index": 0,
          "text": "そのあとでキジバトが来て、",
          "start_ms": 127625,
          "end_ms": 130257,
          "duration_ms": 2632
        },
        {
          "index": 1,
          "text": "最後に空の下の小鳥たちが全部集まってきて、",
          "start_ms": 130507,
          "end_ms": 135380,
          "duration_ms": 4873
        },
        {
          "index": 2,
          "text": "灰の中に降りました。",
          "start_ms": 135630,
          "end_ms": 138065,
          "duration_ms": 2435
        }
      ]
    },
    {
      "index": 22,
      "text": "はとたちが頭をひょこひょこさせて、コッコッコッとつつき始めました。",
      "start_ms": 138565,
      "end_ms": 145670,
      "duration_ms": 7105,
      "clauses": [
        {
          "index": 0,
          "text": "はとたちが頭をひょこひょこさせて、",
          "start_ms": 138565,
          "end_ms": 142312,
          "duration_ms": 3747
        },
        {
          "index": 1,
          "text": "コッコッコッとつつき始めました。",
          "start_ms": 142562,
          "end_ms": 145670,
          "duration_ms": 3108
        }
      ]
    },
    {
      "index": 23,
      "text": "残りの鳥たちもコッコッコッと始めて、皿に全部の良い豆を集めました。",
      "start_ms": 146170,
      "end_ms": 153984,
      "duration_ms": 7814,
      "clauses": [
        {
          "index": 0,
          "text": "残りの鳥たちもコッコッコッと始めて、",
          "start_ms": 146170,
          "end_ms": 150138,
          "duration_ms": 3968
        },
        {
          "index": 1,
          "text": "皿に全部の良い豆を集めました。",
          "start_ms": 150388,
          "end_ms": 153984,
          "duration_ms": 3596
        }
      ]
    },
    {
      "index": 24,
      "text": "一時間もたたないうちに、小鳥たちは終わって、また飛び去りました。",
      "start_ms": 154484,
      "end_ms": 162590,
      "duration_ms": 8106,
      "clauses": [
        {
          "index": 0,
          "text": "一時間もたたないうちに、",
          "start_ms": 154484,
          "end_ms": 157209,
          "duration_ms": 2725
        },
        {
          "index": 1,
          "text": "小鳥たちは終わって、",
          "start_ms": 157459,
          "end_ms": 159824,
          "duration_ms": 2365
        },
        {
          "index": 2,
          "text": "また飛び去りました。",
          "start_ms": 160074,
          "end_ms": 162590,
          "duration_ms": 2516
        }
      ]
    },
    {
      "index": 25,
      "text": "娘は皿をままははのところに持って行きました。",
      "start_ms": 163090,
      "end_ms": 167568,
      "duration_ms": 4478,
      "clauses": [
        {
          "index": 0,
          "text": "娘は皿をままははのところに持って行きました。",
          "start_ms": 163090,
          "end_ms": 167568,
          "duration_ms": 4478
        }
      ]
    },
    {
      "index": 26,
      "text": "嬉しくて、今度こそお祝いに行けると信じていました。",
      "start_ms": 168068,
      "end_ms": 173954,
      "duration_ms": 5886,
      "clauses": [
        {
          "index": 0,
          "text": "嬉しくて、",
          "start_ms": 168068,
          "end_ms": 169632,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "今度こそお祝いに行けると信じていました。",
          "start_ms": 169882,
          "end_ms": 173954,
          "duration_ms": 4072
        }
      ]
    },
    {
      "index": 27,
      "text": "でも、ままははは「だめよ、シンデレラ。",
      "start_ms": 174454,
      "end_ms": 179693,
      "duration_ms": 5239,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 174454,
          "end_ms": 175461,
          "duration_ms": 1007
        },
        {
          "index": 1,
          "text": "ままははは「だめよ、",
          "start_ms": 175711,
          "end_ms": 177763,
          "duration_ms": 2052
        },
        {
          "index": 2,
          "text": "シンデレラ。",
          "start_ms": 178013,
          "end_ms": 179693,
          "duration_ms": 1680
        }
      ]
    },
    {
      "index": 28,
      "text": "服がないじゃないし、踊れないわ。",
      "start_ms": 180193,
      "end_ms": 184326,
      "duration_ms": 4133,
      "clauses": [
        {
          "index": 0,
          "text": "服がないじゃないし、",
          "start_ms": 180193,
          "end_ms": 182361,
          "duration_ms": 2168
        },
        {
          "index": 1,
          "text": "踊れないわ。",
          "start_ms": 182611,
          "end_ms": 184326,
          "duration_ms": 1715
        }
      ]
    },
    {
      "index": 29,
      "text": "ただ笑われるだけだよ。」",
      "start_ms": 184826,
      "end_ms": 187249,
      "duration_ms": 2423,
      "clauses": [
        {
          "index": 0,
          "text": "ただ笑われるだけだよ。」",
          "start_ms": 184826,
          "end_ms": 187249,
          "duration_ms": 2423
        }
      ]
    },
    {
      "index": 30,
      "text": "と言いました。",
      "start_ms": 187749,
      "end_ms": 189429,
      "duration_ms": 1680,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 187749,
          "end_ms": 189429,
          "duration_ms": 1680
        }
      ]
    },
    {
      "index": 31,
      "text": "シンデレラが泣くと、ままははは「一時間で灰から二皿のレンズ豆を拾ったら、一緒に行ってあげるよ。」",
      "start_ms": 189929,
      "end_ms": 200277,
      "duration_ms": 10348,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラが泣くと、",
          "start_ms": 189929,
          "end_ms": 192155,
          "duration_ms": 2226
        },
        {
          "index": 1,
          "text": "ままははは「一時間で灰から二皿のレンズ豆を拾ったら、",
          "start_ms": 192405,
          "end_ms": 197708,
          "duration_ms": 5303
        },
        {
          "index": 2,
          "text": "一緒に行ってあげるよ。」",
          "start_ms": 197958,
          "end_ms": 200277,
          "duration_ms": 2319
        }
      ]
    },
    {
      "index": 32,
      "text": "と言いました。",
      "start_ms": 200777,
      "end_ms": 202446,
      "duration_ms": 1669,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 200777,
          "end_ms": 202446,
          "duration_ms": 1669
        }
      ]
    },
    {
      "index": 33,
      "text": "娘はまた庭に行って、小鳥たちにてつだいを頼みました。",
      "start_ms": 202946,
      "end_ms": 209204,
      "duration_ms": 6258,
      "clauses": [
        {
          "index": 0,
          "text": "娘はまた庭に行って、",
          "start_ms": 202946,
          "end_ms": 205486,
          "duration_ms": 2540
        },
        {
          "index": 1,
          "text": "小鳥たちにてつだいを頼みました。",
          "start_ms": 205736,
          "end_ms": 209204,
          "duration_ms": 3468
        }
      ]
    },
    {
      "index": 34,
      "text": "今度は三十分もたたないうちに、全部の豆を集めました。",
      "start_ms": 209704,
      "end_ms": 216369,
      "duration_ms": 6665,
      "clauses": [
        {
          "index": 0,
          "text": "今度は三十分もたたないうちに、",
          "start_ms": 209704,
          "end_ms": 213254,
          "duration_ms": 3550
        },
        {
          "index": 1,
          "text": "全部の豆を集めました。",
