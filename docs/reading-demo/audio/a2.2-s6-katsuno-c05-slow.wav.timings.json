          "duration_ms": 2488
        },
        {
          "index": 1,
          "text": "いますね」。",
          "start_ms": 192767,
          "end_ms": 194303,
          "duration_ms": 1536
        }
      ]
    },
    {
      "index": 48,
      "text": "おくさんはこたえました。",
      "start_ms": 194803,
      "end_ms": 197453,
      "duration_ms": 2650,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはこたえました。",
          "start_ms": 194803,
          "end_ms": 197453,
          "duration_ms": 2650
        }
      ]
    },
    {
      "index": 49,
      "text": "「あした、ゆみのたいかいがあります。",
      "start_ms": 197953,
      "end_ms": 202401,
      "duration_ms": 4448,
      "clauses": [
        {
          "index": 0,
          "text": "「あした、",
          "start_ms": 197953,
          "end_ms": 199396,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "ゆみのたいかいがあります。",
          "start_ms": 199646,
          "end_ms": 202401,
          "duration_ms": 2755
        }
      ]
    },
    {
      "index": 50,
      "text": "さむらいがおおく、きます。",
      "start_ms": 202901,
      "end_ms": 206930,
      "duration_ms": 4029,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいがおおく、",
          "start_ms": 202901,
          "end_ms": 205191,
          "duration_ms": 2290
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 205441,
          "end_ms": 206930,
          "duration_ms": 1489
        }
      ]
    },
    {
      "index": 51,
      "text": "みな、ゆみをじょうずにつかいます。",
      "start_ms": 207430,
      "end_ms": 211773,
      "duration_ms": 4343,
      "clauses": [
        {
          "index": 0,
          "text": "みな、",
          "start_ms": 207430,
          "end_ms": 208571,
          "duration_ms": 1141
        },
        {
          "index": 1,
          "text": "ゆみをじょうずにつかいます。",
          "start_ms": 208821,
          "end_ms": 211773,
          "duration_ms": 2952
        }
      ]
    },
    {
      "index": 52,
      "text": "あるいて、じょうずにします」。",
      "start_ms": 212273,
      "end_ms": 216314,
      "duration_ms": 4041,
      "clauses": [
        {
          "index": 0,
          "text": "あるいて、",
          "start_ms": 212273,
          "end_ms": 213925,
          "duration_ms": 1652
        },
        {
          "index": 1,
          "text": "じょうずにします」。",
          "start_ms": 214175,
          "end_ms": 216314,
          "duration_ms": 2139
        }
      ]
    },
    {
      "index": 53,
      "text": "「さむらいはみな、きますか」。",
      "start_ms": 216814,
      "end_ms": 220925,
      "duration_ms": 4111,
      "clauses": [
        {
          "index": 0,
          "text": "「さむらいはみな、",
          "start_ms": 216814,
          "end_ms": 218977,
          "duration_ms": 2163
        },
        {
          "index": 1,
          "text": "きますか」。",
          "start_ms": 219227,
          "end_ms": 220925,
          "duration_ms": 1698
        }
      ]
    },
    {
      "index": 54,
      "text": "おくさんはわらいました。",
      "start_ms": 221425,
      "end_ms": 224133,
      "duration_ms": 2708,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはわらいました。",
          "start_ms": 221425,
          "end_ms": 224133,
          "duration_ms": 2708
        }
      ]
    },
    {
      "index": 55,
      "text": "「みな、きます。",
      "start_ms": 224633,
      "end_ms": 227513,
      "duration_ms": 2880,
      "clauses": [
        {
          "index": 0,
          "text": "「みな、",
          "start_ms": 224633,
          "end_ms": 225739,
          "duration_ms": 1106
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 225989,
          "end_ms": 227513,
          "duration_ms": 1524
        }
      ]
    },
    {
      "index": 56,
      "text": "とのさまもきます。",
      "start_ms": 228013,
      "end_ms": 230361,
      "duration_ms": 2348,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまもきます。",
          "start_ms": 228013,
          "end_ms": 230361,
          "duration_ms": 2348
        }
      ]
    },
    {
      "index": 57,
      "text": "あなたはゆみがすきですか」。",
      "start_ms": 230861,
      "end_ms": 233952,
      "duration_ms": 3091,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはゆみがすきですか」。",
          "start_ms": 230861,
          "end_ms": 233952,
          "duration_ms": 3091
        }
      ]
    },
    {
      "index": 58,
      "text": "「いいえ。",
      "start_ms": 234452,
      "end_ms": 235256,
      "duration_ms": 804,
      "clauses": [
        {
          "index": 0,
          "text": "「いいえ。",
          "start_ms": 234452,
          "end_ms": 235256,
          "duration_ms": 804
        }
      ]
    },
    {
      "index": 59,
      "text": "ちちがすきでした。",
      "start_ms": 235756,
      "end_ms": 238070,
      "duration_ms": 2314,
      "clauses": [
        {
          "index": 0,
          "text": "ちちがすきでした。",
          "start_ms": 235756,
          "end_ms": 238070,
          "duration_ms": 2314
        }
      ]
    },
    {
      "index": 60,
      "text": "まえからゆみをみたことがありました。",
      "start_ms": 238570,
      "end_ms": 242161,
      "duration_ms": 3591,
      "clauses": [
        {
          "index": 0,
          "text": "まえからゆみをみたことがありました。",
          "start_ms": 238570,
          "end_ms": 242161,
          "duration_ms": 3591
        }
      ]
    },
    {
      "index": 61,
      "text": "だからすこし、しっています」。",
      "start_ms": 242661,
      "end_ms": 246888,
      "duration_ms": 4227,
      "clauses": [
        {
          "index": 0,
          "text": "だからすこし、",
          "start_ms": 242661,
          "end_ms": 244731,
          "duration_ms": 2070
        },
        {
          "index": 1,
          "text": "しっています」。",
          "start_ms": 244981,
          "end_ms": 246888,
          "duration_ms": 1907
        }
      ]
    },
    {
      "index": 62,
      "text": "おくさんはかいてあるものをだしました。",
      "start_ms": 247388,
      "end_ms": 251524,
      "duration_ms": 4136,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはかいてあるものをだしました。",
          "start_ms": 247388,
          "end_ms": 251524,
          "duration_ms": 4136
        }
      ]
    },
    {
      "index": 63,
      "text": "「ではこれをみてください。",
      "start_ms": 252024,
      "end_ms": 254976,
      "duration_ms": 2952,
      "clauses": [
        {
          "index": 0,
          "text": "「ではこれをみてください。",
          "start_ms": 252024,
          "end_ms": 254976,
          "duration_ms": 2952
        }
      ]
    },
    {
      "index": 64,
      "text": "くるさむらいの、なまえがかいてあります」。",
      "start_ms": 255476,
      "end_ms": 260446,
      "duration_ms": 4970,
      "clauses": [
        {
          "index": 0,
          "text": "くるさむらいの、",
          "start_ms": 255476,
          "end_ms": 257476,
          "duration_ms": 2000
        },
        {
          "index": 1,
          "text": "なまえがかいてあります」。",
          "start_ms": 257726,
          "end_ms": 260446,
          "duration_ms": 2720
        }
      ]
    },
    {
      "index": 65,
      "text": "カツノはそれをもちました。",
      "start_ms": 260946,
      "end_ms": 264188,
      "duration_ms": 3242,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはそれをもちました。",
          "start_ms": 260946,
          "end_ms": 264188,
          "duration_ms": 3242
        }
      ]
    },
    {
      "index": 66,
      "text": "うえからしたまでよみました。",
      "start_ms": 264688,
      "end_ms": 267826,
      "duration_ms": 3138,
      "clauses": [
        {
          "index": 0,
          "text": "うえからしたまでよみました。",
          "start_ms": 264688,
          "end_ms": 267826,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 67,
      "text": "なまえがありました。",
      "start_ms": 268326,
      "end_ms": 270674,
      "duration_ms": 2348,
      "clauses": [
        {
          "index": 0,
          "text": "なまえがありました。",
          "start_ms": 268326,
          "end_ms": 270674,
          "duration_ms": 2348
        }
      ]
    },
    {
      "index": 68,
      "text": "「シチロウエモン」。",
      "start_ms": 271174,
      "end_ms": 273116,
      "duration_ms": 1942,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 271174,
          "end_ms": 273116,
          "duration_ms": 1942
        }
      ]
    },
    {
      "index": 69,
      "text": "カツノはまた、よみました。",
      "start_ms": 273616,
      "end_ms": 277762,
      "duration_ms": 4146,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはまた、",
          "start_ms": 273616,
          "end_ms": 275674,
          "duration_ms": 2058
        },
        {
          "index": 1,
          "text": "よみました。",
          "start_ms": 275924,
          "end_ms": 277762,
          "duration_ms": 1838
        }
      ]
    },
    {
      "index": 70,
      "text": "「シチロウエモン」。",
      "start_ms": 278262,
      "end_ms": 280227,
      "duration_ms": 1965,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 278262,
          "end_ms": 280227,
          "duration_ms": 1965
        }
      ]
    },
    {
      "index": 71,
      "text": "はい、シチロウエモンです。",
      "start_ms": 280727,
      "end_ms": 284014,
      "duration_ms": 3287,
      "clauses": [
        {
          "index": 0,
          "text": "はい、",
          "start_ms": 280727,
          "end_ms": 281450,
          "duration_ms": 723
        },
        {
          "index": 1,
          "text": "シチロウエモンです。",
          "start_ms": 281700,
          "end_ms": 284014,
          "duration_ms": 2314
        }
      ]
    },
    {
      "index": 72,
      "text": "「ついにきます。",
      "start_ms": 284514,
      "end_ms": 286491,
      "duration_ms": 1977,
      "clauses": [
        {
          "index": 0,
          "text": "「ついにきます。",
          "start_ms": 284514,
          "end_ms": 286491,
          "duration_ms": 1977
        }
      ]
    },
    {
      "index": 73,
      "text": "もう、まちません」。",
      "start_ms": 286991,
      "end_ms": 289941,
      "duration_ms": 2950,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 286991,
          "end_ms": 287911,
          "duration_ms": 920
        },
        {
          "index": 1,
          "text": "まちません」。",
          "start_ms": 288161,
          "end_ms": 289941,
          "duration_ms": 1780
        }
      ]
    },
    {
      "index": 74,
      "text": "そのよる、カツノはおきていました。",
      "start_ms": 290441,
      "end_ms": 295190,
      "duration_ms": 4749,
      "clauses": [
        {
          "index": 0,
          "text": "そのよる、",
          "start_ms": 290441,
          "end_ms": 292162,
          "duration_ms": 1721
        },
        {
          "index": 1,
          "text": "カツノはおきていました。",
          "start_ms": 292412,
          "end_ms": 295190,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 75,
      "text": "ちいさなかたなをもちました。",
      "start_ms": 295690,
      "end_ms": 298828,
      "duration_ms": 3138,
      "clauses": [
        {
          "index": 0,
          "text": "ちいさなかたなをもちました。",
          "start_ms": 295690,
          "end_ms": 298828,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 76,
      "text": "「ハチヤ。",
      "start_ms": 299328,
      "end_ms": 300933,
      "duration_ms": 1605,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤ。",
          "start_ms": 299328,
          "end_ms": 300933,
          "duration_ms": 1605
        }
      ]
    },
    {
      "index": 77,
      "text": "あした、あいます。",
      "start_ms": 301433,
      "end_ms": 304766,
      "duration_ms": 3333,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 301433,
          "end_ms": 302853,
          "duration_ms": 1420
        },
        {
          "index": 1,
          "text": "あいます。",
          "start_ms": 303103,
          "end_ms": 304766,
          "duration_ms": 1663
        }
      ]
    },
    {
      "index": 78,
      "text": "あした、ころします。",
      "start_ms": 305266,
      "end_ms": 308645,
      "duration_ms": 3379,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 305266,
          "end_ms": 306720,
          "duration_ms": 1454
        },
        {
          "index": 1,
          "text": "ころします。",
          "start_ms": 306970,
          "end_ms": 308645,
          "duration_ms": 1675
        }
      ]
    },
    {
      "index": 79,
      "text": "もう、まってください」。",
      "start_ms": 309145,
      "end_ms": 312362,
      "duration_ms": 3217,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 309145,
          "end_ms": 310100,
          "duration_ms": 955
        },
        {
          "index": 1,
          "text": "まってください」。",
          "start_ms": 310350,
          "end_ms": 312362,
          "duration_ms": 2012
        }
      ]
    }
  ]
}