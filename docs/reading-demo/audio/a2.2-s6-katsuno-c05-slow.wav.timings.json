        },
        {
          "index": 1,
          "text": "いますね」。",
          "start_ms": 192450,
          "end_ms": 193962,
          "duration_ms": 1512
        }
      ]
    },
    {
      "index": 48,
      "text": "おくさんはこたえました。",
      "start_ms": 194462,
      "end_ms": 197147,
      "duration_ms": 2685,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはこたえました。",
          "start_ms": 194462,
          "end_ms": 197147,
          "duration_ms": 2685
        }
      ]
    },
    {
      "index": 49,
      "text": "「あした、ゆみのたいかいがあります。",
      "start_ms": 197647,
      "end_ms": 202106,
      "duration_ms": 4459,
      "clauses": [
        {
          "index": 0,
          "text": "「あした、",
          "start_ms": 197647,
          "end_ms": 199101,
          "duration_ms": 1454
        },
        {
          "index": 1,
          "text": "ゆみのたいかいがあります。",
          "start_ms": 199351,
          "end_ms": 202106,
          "duration_ms": 2755
        }
      ]
    },
    {
      "index": 50,
      "text": "さむらいがおおく、きます。",
      "start_ms": 202606,
      "end_ms": 206589,
      "duration_ms": 3983,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいがおおく、",
          "start_ms": 202606,
          "end_ms": 204838,
          "duration_ms": 2232
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 205088,
          "end_ms": 206589,
          "duration_ms": 1501
        }
      ]
    },
    {
      "index": 51,
      "text": "みな、ゆみをじょうずにつかいます。",
      "start_ms": 207089,
      "end_ms": 211444,
      "duration_ms": 4355,
      "clauses": [
        {
          "index": 0,
          "text": "みな、",
          "start_ms": 207089,
          "end_ms": 208230,
          "duration_ms": 1141
        },
        {
          "index": 1,
          "text": "ゆみをじょうずにつかいます。",
          "start_ms": 208480,
          "end_ms": 211444,
          "duration_ms": 2964
        }
      ]
    },
    {
      "index": 52,
      "text": "あるいて、じょうずにします」。",
      "start_ms": 211944,
      "end_ms": 215950,
      "duration_ms": 4006,
      "clauses": [
        {
          "index": 0,
          "text": "あるいて、",
          "start_ms": 211944,
          "end_ms": 213549,
          "duration_ms": 1605
        },
        {
          "index": 1,
          "text": "じょうずにします」。",
          "start_ms": 213799,
          "end_ms": 215950,
          "duration_ms": 2151
        }
      ]
    },
    {
      "index": 53,
      "text": "「さむらいはみな、きますか」。",
      "start_ms": 216450,
      "end_ms": 220654,
      "duration_ms": 4204,
      "clauses": [
        {
          "index": 0,
          "text": "「さむらいはみな、",
          "start_ms": 216450,
          "end_ms": 218624,
          "duration_ms": 2174
        },
        {
          "index": 1,
          "text": "きますか」。",
          "start_ms": 218874,
          "end_ms": 220654,
          "duration_ms": 1780
        }
      ]
    },
    {
      "index": 54,
      "text": "おくさんはわらいました。",
      "start_ms": 221154,
      "end_ms": 223862,
      "duration_ms": 2708,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはわらいました。",
          "start_ms": 221154,
          "end_ms": 223862,
          "duration_ms": 2708
        }
      ]
    },
    {
      "index": 55,
      "text": "「みな、きます。",
      "start_ms": 224362,
      "end_ms": 227184,
      "duration_ms": 2822,
      "clauses": [
        {
          "index": 0,
          "text": "「みな、",
          "start_ms": 224362,
          "end_ms": 225468,
          "duration_ms": 1106
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 225718,
          "end_ms": 227184,
          "duration_ms": 1466
        }
      ]
    },
    {
      "index": 56,
      "text": "とのさまもきます。",
      "start_ms": 227684,
      "end_ms": 230032,
      "duration_ms": 2348,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまもきます。",
          "start_ms": 227684,
          "end_ms": 230032,
          "duration_ms": 2348
        }
      ]
    },
    {
      "index": 57,
      "text": "あなたはゆみがすきですか」。",
      "start_ms": 230532,
      "end_ms": 233600,
      "duration_ms": 3068,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはゆみがすきですか」。",
          "start_ms": 230532,
          "end_ms": 233600,
          "duration_ms": 3068
        }
      ]
    },
    {
      "index": 58,
      "text": "「いいえ。",
      "start_ms": 234100,
      "end_ms": 234904,
      "duration_ms": 804,
      "clauses": [
        {
          "index": 0,
          "text": "「いいえ。",
          "start_ms": 234100,
          "end_ms": 234904,
          "duration_ms": 804
        }
      ]
    },
    {
      "index": 59,
      "text": "ちちがすきでした。",
      "start_ms": 235404,
      "end_ms": 237706,
      "duration_ms": 2302,
      "clauses": [
        {
          "index": 0,
          "text": "ちちがすきでした。",
          "start_ms": 235404,
          "end_ms": 237706,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 60,
      "text": "まえからゆみをみたことがありました。",
      "start_ms": 238206,
      "end_ms": 241797,
      "duration_ms": 3591,
      "clauses": [
        {
          "index": 0,
          "text": "まえからゆみをみたことがありました。",
          "start_ms": 238206,
          "end_ms": 241797,
          "duration_ms": 3591
        }
      ]
    },
    {
      "index": 61,
      "text": "だからすこし、しっています」。",
      "start_ms": 242297,
      "end_ms": 246431,
      "duration_ms": 4134,
      "clauses": [
        {
          "index": 0,
          "text": "だからすこし、",
          "start_ms": 242297,
          "end_ms": 244274,
          "duration_ms": 1977
        },
        {
          "index": 1,
          "text": "しっています」。",
          "start_ms": 244524,
          "end_ms": 246431,
          "duration_ms": 1907
        }
      ]
    },
    {
      "index": 62,
      "text": "おくさんはかいてあるものをだしました。",
      "start_ms": 246931,
      "end_ms": 251056,
      "duration_ms": 4125,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはかいてあるものをだしました。",
          "start_ms": 246931,
          "end_ms": 251056,
          "duration_ms": 4125
        }
      ]
    },
    {
      "index": 63,
      "text": "「ではこれをみてください。",
      "start_ms": 251556,
      "end_ms": 254508,
      "duration_ms": 2952,
      "clauses": [
        {
          "index": 0,
          "text": "「ではこれをみてください。",
          "start_ms": 251556,
          "end_ms": 254508,
          "duration_ms": 2952
        }
      ]
    },
    {
      "index": 64,
      "text": "くるさむらいの、なまえがかいてあります」。",
      "start_ms": 255008,
      "end_ms": 259978,
      "duration_ms": 4970,
      "clauses": [
        {
          "index": 0,
          "text": "くるさむらいの、",
          "start_ms": 255008,
          "end_ms": 257055,
          "duration_ms": 2047
        },
        {
          "index": 1,
          "text": "なまえがかいてあります」。",
          "start_ms": 257305,
          "end_ms": 259978,
          "duration_ms": 2673
        }
      ]
    },
    {
      "index": 65,
      "text": "カツノはそれをもちました。",
      "start_ms": 260478,
      "end_ms": 263709,
      "duration_ms": 3231,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはそれをもちました。",
          "start_ms": 260478,
          "end_ms": 263709,
          "duration_ms": 3231
        }
      ]
    },
    {
      "index": 66,
      "text": "うえからしたまでよみました。",
      "start_ms": 264209,
      "end_ms": 267300,
      "duration_ms": 3091,
      "clauses": [
        {
          "index": 0,
          "text": "うえからしたまでよみました。",
          "start_ms": 264209,
          "end_ms": 267300,
          "duration_ms": 3091
        }
      ]
    },
    {
      "index": 67,
      "text": "なまえがありました。",
      "start_ms": 267800,
      "end_ms": 270137,
      "duration_ms": 2337,
      "clauses": [
        {
          "index": 0,
          "text": "なまえがありました。",
          "start_ms": 267800,
          "end_ms": 270137,
          "duration_ms": 2337
        }
      ]
    },
    {
      "index": 68,
      "text": "「シチロウエモン」。",
      "start_ms": 270637,
      "end_ms": 272637,
      "duration_ms": 2000,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 270637,
          "end_ms": 272637,
          "duration_ms": 2000
        }
      ]
    },
    {
      "index": 69,
      "text": "カツノはまた、よみました。",
      "start_ms": 273137,
      "end_ms": 277294,
      "duration_ms": 4157,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはまた、",
          "start_ms": 273137,
          "end_ms": 275195,
          "duration_ms": 2058
        },
        {
          "index": 1,
          "text": "よみました。",
          "start_ms": 275445,
          "end_ms": 277294,
          "duration_ms": 1849
        }
      ]
    },
    {
      "index": 70,
      "text": "「シチロウエモン」。",
      "start_ms": 277794,
      "end_ms": 279759,
      "duration_ms": 1965,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 277794,
          "end_ms": 279759,
          "duration_ms": 1965
        }
      ]
    },
    {
      "index": 71,
      "text": "はい、シチロウエモンです。",
      "start_ms": 280259,
      "end_ms": 283568,
      "duration_ms": 3309,
      "clauses": [
        {
          "index": 0,
          "text": "はい、",
          "start_ms": 280259,
          "end_ms": 280970,
          "duration_ms": 711
        },
        {
          "index": 1,
          "text": "シチロウエモンです。",
          "start_ms": 281220,
          "end_ms": 283568,
          "duration_ms": 2348
        }
      ]
    },
    {
      "index": 72,
      "text": "「ついにきます。",
      "start_ms": 284068,
      "end_ms": 286091,
      "duration_ms": 2023,
      "clauses": [
        {
          "index": 0,
          "text": "「ついにきます。",
          "start_ms": 284068,
          "end_ms": 286091,
          "duration_ms": 2023
        }
      ]
    },
    {
      "index": 73,
      "text": "もう、まちません」。",
      "start_ms": 286591,
      "end_ms": 289611,
      "duration_ms": 3020,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 286591,
          "end_ms": 287477,
          "duration_ms": 886
        },
        {
          "index": 1,
          "text": "まちません」。",
          "start_ms": 287727,
          "end_ms": 289611,
          "duration_ms": 1884
        }
      ]
    },
    {
      "index": 74,
      "text": "そのよる、カツノはおきていました。",
      "start_ms": 290111,
      "end_ms": 294895,
      "duration_ms": 4784,
      "clauses": [
        {
          "index": 0,
          "text": "そのよる、",
          "start_ms": 290111,
          "end_ms": 291844,
          "duration_ms": 1733
        },
        {
          "index": 1,
          "text": "カツノはおきていました。",
          "start_ms": 292094,
          "end_ms": 294895,
          "duration_ms": 2801
        }
      ]
    },
    {
      "index": 75,
      "text": "ちいさなかたなをもちました。",
      "start_ms": 295395,
      "end_ms": 298521,
      "duration_ms": 3126,
      "clauses": [
        {
          "index": 0,
          "text": "ちいさなかたなをもちました。",
          "start_ms": 295395,
          "end_ms": 298521,
          "duration_ms": 3126
        }
      ]
    },
    {
      "index": 76,
      "text": "「ハチヤ。",
      "start_ms": 299021,
      "end_ms": 300603,
      "duration_ms": 1582,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤ。",
          "start_ms": 299021,
          "end_ms": 300603,
          "duration_ms": 1582
        }
      ]
    },
    {
      "index": 77,
      "text": "あした、あいます。",
      "start_ms": 301103,
      "end_ms": 304459,
      "duration_ms": 3356,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 301103,
          "end_ms": 302557,
          "duration_ms": 1454
        },
        {
          "index": 1,
          "text": "あいます。",
          "start_ms": 302807,
          "end_ms": 304459,
          "duration_ms": 1652
        }
      ]
    },
    {
      "index": 78,
      "text": "あした、ころします。",
      "start_ms": 304959,
      "end_ms": 308420,
      "duration_ms": 3461,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 304959,
          "end_ms": 306367,
          "duration_ms": 1408
        },
        {
          "index": 1,
          "text": "ころします。",
          "start_ms": 306617,
          "end_ms": 308420,
          "duration_ms": 1803
        }
      ]
    },
    {
      "index": 79,
      "text": "もう、まってください」。",
      "start_ms": 308920,
      "end_ms": 312172,
      "duration_ms": 3252,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 308920,
          "end_ms": 309864,
          "duration_ms": 944
        },
        {
          "index": 1,
          "text": "まってください」。",
          "start_ms": 310114,
          "end_ms": 312172,
          "duration_ms": 2058
        }
      ]
    }
  ]
}