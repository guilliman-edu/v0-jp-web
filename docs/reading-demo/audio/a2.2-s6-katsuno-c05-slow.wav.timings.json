        },
        {
          "index": 1,
          "text": "いますね」。",
          "start_ms": 188702,
          "end_ms": 190130,
          "duration_ms": 1428
        }
      ]
    },
    {
      "index": 48,
      "text": "おくさんはこたえました。",
      "start_ms": 190630,
      "end_ms": 193335,
      "duration_ms": 2705,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはこたえました。",
          "start_ms": 190630,
          "end_ms": 193335,
          "duration_ms": 2705
        }
      ]
    },
    {
      "index": 49,
      "text": "「あした、ゆみのたいかいがあります。",
      "start_ms": 193835,
      "end_ms": 198182,
      "duration_ms": 4347,
      "clauses": [
        {
          "index": 0,
          "text": "「あした、",
          "start_ms": 193835,
          "end_ms": 195274,
          "duration_ms": 1439
        },
        {
          "index": 1,
          "text": "ゆみのたいかいがあります。",
          "start_ms": 195524,
          "end_ms": 198182,
          "duration_ms": 2658
        }
      ]
    },
    {
      "index": 50,
      "text": "さむらいがおおく、きます。",
      "start_ms": 198682,
      "end_ms": 202612,
      "duration_ms": 3930,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいがおおく、",
          "start_ms": 198682,
          "end_ms": 200911,
          "duration_ms": 2229
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 201161,
          "end_ms": 202612,
          "duration_ms": 1451
        }
      ]
    },
    {
      "index": 51,
      "text": "みな、ゆみをじょうずにつかいます。",
      "start_ms": 203112,
      "end_ms": 207343,
      "duration_ms": 4231,
      "clauses": [
        {
          "index": 0,
          "text": "みな、",
          "start_ms": 203112,
          "end_ms": 204191,
          "duration_ms": 1079
        },
        {
          "index": 1,
          "text": "ゆみをじょうずにつかいます。",
          "start_ms": 204441,
          "end_ms": 207343,
          "duration_ms": 2902
        }
      ]
    },
    {
      "index": 52,
      "text": "あるいて、じょうずにします」。",
      "start_ms": 207843,
      "end_ms": 211749,
      "duration_ms": 3906,
      "clauses": [
        {
          "index": 0,
          "text": "あるいて、",
          "start_ms": 207843,
          "end_ms": 209421,
          "duration_ms": 1578
        },
        {
          "index": 1,
          "text": "じょうずにします」。",
          "start_ms": 209671,
          "end_ms": 211749,
          "duration_ms": 2078
        }
      ]
    },
    {
      "index": 53,
      "text": "「さむらいはみな、きますか」。",
      "start_ms": 212249,
      "end_ms": 216341,
      "duration_ms": 4092,
      "clauses": [
        {
          "index": 0,
          "text": "「さむらいはみな、",
          "start_ms": 212249,
          "end_ms": 214362,
          "duration_ms": 2113
        },
        {
          "index": 1,
          "text": "きますか」。",
          "start_ms": 214612,
          "end_ms": 216341,
          "duration_ms": 1729
        }
      ]
    },
    {
      "index": 54,
      "text": "おくさんはわらいました。",
      "start_ms": 216841,
      "end_ms": 219476,
      "duration_ms": 2635,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはわらいました。",
          "start_ms": 216841,
          "end_ms": 219476,
          "duration_ms": 2635
        }
      ]
    },
    {
      "index": 55,
      "text": "「みな、きます。",
      "start_ms": 219976,
      "end_ms": 222756,
      "duration_ms": 2780,
      "clauses": [
        {
          "index": 0,
          "text": "「みな、",
          "start_ms": 219976,
          "end_ms": 221055,
          "duration_ms": 1079
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 221305,
          "end_ms": 222756,
          "duration_ms": 1451
        }
      ]
    },
    {
      "index": 56,
      "text": "とのさまもきます。",
      "start_ms": 223256,
      "end_ms": 225543,
      "duration_ms": 2287,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまもきます。",
          "start_ms": 223256,
          "end_ms": 225543,
          "duration_ms": 2287
        }
      ]
    },
    {
      "index": 57,
      "text": "あなたはゆみがすきですか」。",
      "start_ms": 226043,
      "end_ms": 229003,
      "duration_ms": 2960,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはゆみがすきですか」。",
          "start_ms": 226043,
          "end_ms": 229003,
          "duration_ms": 2960
        }
      ]
    },
    {
      "index": 58,
      "text": "「いいえ。",
      "start_ms": 229503,
      "end_ms": 230269,
      "duration_ms": 766,
      "clauses": [
        {
          "index": 0,
          "text": "「いいえ。",
          "start_ms": 229503,
          "end_ms": 230269,
          "duration_ms": 766
        }
      ]
    },
    {
      "index": 59,
      "text": "ちちがすきでした。",
      "start_ms": 230769,
      "end_ms": 232998,
      "duration_ms": 2229,
      "clauses": [
        {
          "index": 0,
          "text": "ちちがすきでした。",
          "start_ms": 230769,
          "end_ms": 232998,
          "duration_ms": 2229
        }
      ]
    },
    {
      "index": 60,
      "text": "まえからゆみをみたことがありました。",
      "start_ms": 233498,
      "end_ms": 237050,
      "duration_ms": 3552,
      "clauses": [
        {
          "index": 0,
          "text": "まえからゆみをみたことがありました。",
          "start_ms": 233498,
          "end_ms": 237050,
          "duration_ms": 3552
        }
      ]
    },
    {
      "index": 61,
      "text": "だからすこし、しっています」。",
      "start_ms": 237550,
      "end_ms": 241607,
      "duration_ms": 4057,
      "clauses": [
        {
          "index": 0,
          "text": "だからすこし、",
          "start_ms": 237550,
          "end_ms": 239465,
          "duration_ms": 1915
        },
        {
          "index": 1,
          "text": "しっています」。",
          "start_ms": 239715,
          "end_ms": 241607,
          "duration_ms": 1892
        }
      ]
    },
    {
      "index": 62,
      "text": "おくさんはかいてあるものをだしました。",
      "start_ms": 242107,
      "end_ms": 246170,
      "duration_ms": 4063,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはかいてあるものをだしました。",
          "start_ms": 242107,
          "end_ms": 246170,
          "duration_ms": 4063
        }
      ]
    },
    {
      "index": 63,
      "text": "「ではこれをみてください。",
      "start_ms": 246670,
      "end_ms": 249595,
      "duration_ms": 2925,
      "clauses": [
        {
          "index": 0,
          "text": "「ではこれをみてください。",
          "start_ms": 246670,
          "end_ms": 249595,
          "duration_ms": 2925
        }
      ]
    },
    {
      "index": 64,
      "text": "くるさむらいの、なまえがかいてあります」。",
      "start_ms": 250095,
      "end_ms": 254895,
      "duration_ms": 4800,
      "clauses": [
        {
          "index": 0,
          "text": "くるさむらいの、",
          "start_ms": 250095,
          "end_ms": 252022,
          "duration_ms": 1927
        },
        {
          "index": 1,
          "text": "なまえがかいてあります」。",
          "start_ms": 252272,
          "end_ms": 254895,
          "duration_ms": 2623
        }
      ]
    },
    {
      "index": 65,
      "text": "カツノはそれをもちました。",
      "start_ms": 255395,
      "end_ms": 258518,
      "duration_ms": 3123,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはそれをもちました。",
          "start_ms": 255395,
          "end_ms": 258518,
          "duration_ms": 3123
        }
      ]
    },
    {
      "index": 66,
      "text": "うえからしたまでよみました。",
      "start_ms": 259018,
      "end_ms": 262071,
      "duration_ms": 3053,
      "clauses": [
        {
          "index": 0,
          "text": "うえからしたまでよみました。",
          "start_ms": 259018,
          "end_ms": 262071,
          "duration_ms": 3053
        }
      ]
    },
    {
      "index": 67,
      "text": "なまえがありました。",
      "start_ms": 262571,
      "end_ms": 264800,
      "duration_ms": 2229,
      "clauses": [
        {
          "index": 0,
          "text": "なまえがありました。",
          "start_ms": 262571,
          "end_ms": 264800,
          "duration_ms": 2229
        }
      ]
    },
    {
      "index": 68,
      "text": "「シチロウエモン」。",
      "start_ms": 265300,
      "end_ms": 267001,
      "duration_ms": 1701,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 265300,
          "end_ms": 267001,
          "duration_ms": 1701
        }
      ]
    },
    {
      "index": 69,
      "text": "カツノはまた、よみました。",
      "start_ms": 267501,
      "end_ms": 271581,
      "duration_ms": 4080,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはまた、",
          "start_ms": 267501,
          "end_ms": 269544,
          "duration_ms": 2043
        },
        {
          "index": 1,
          "text": "よみました。",
          "start_ms": 269794,
          "end_ms": 271581,
          "duration_ms": 1787
        }
      ]
    },
    {
      "index": 70,
      "text": "「シチロウエモン」。",
      "start_ms": 272081,
      "end_ms": 273782,
      "duration_ms": 1701,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 272081,
          "end_ms": 273782,
          "duration_ms": 1701
        }
      ]
    },
    {
      "index": 71,
      "text": "はい、シチロウエモンです。",
      "start_ms": 274282,
      "end_ms": 277556,
      "duration_ms": 3274,
      "clauses": [
        {
          "index": 0,
          "text": "はい、",
          "start_ms": 274282,
          "end_ms": 274932,
          "duration_ms": 650
        },
        {
          "index": 1,
          "text": "シチロウエモンです。",
          "start_ms": 275182,
          "end_ms": 277556,
          "duration_ms": 2374
        }
      ]
    },
    {
      "index": 72,
      "text": "「ついにきます。",
      "start_ms": 278056,
      "end_ms": 279971,
      "duration_ms": 1915,
      "clauses": [
        {
          "index": 0,
          "text": "「ついにきます。",
          "start_ms": 278056,
          "end_ms": 279971,
          "duration_ms": 1915
        }
      ]
    },
    {
      "index": 73,
      "text": "もう、まちません」。",
      "start_ms": 280471,
      "end_ms": 283309,
      "duration_ms": 2838,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 280471,
          "end_ms": 281341,
          "duration_ms": 870
        },
        {
          "index": 1,
          "text": "まちません」。",
          "start_ms": 281591,
          "end_ms": 283309,
          "duration_ms": 1718
        }
      ]
    },
    {
      "index": 74,
      "text": "そのよる、カツノはおきていました。",
      "start_ms": 283809,
      "end_ms": 288551,
      "duration_ms": 4742,
      "clauses": [
        {
          "index": 0,
          "text": "そのよる、",
          "start_ms": 283809,
          "end_ms": 285492,
          "duration_ms": 1683
        },
        {
          "index": 1,
          "text": "カツノはおきていました。",
          "start_ms": 285742,
          "end_ms": 288551,
          "duration_ms": 2809
        }
      ]
    },
    {
      "index": 75,
      "text": "ちいさなかたなをもちました。",
      "start_ms": 289051,
      "end_ms": 292069,
      "duration_ms": 3018,
      "clauses": [
        {
          "index": 0,
          "text": "ちいさなかたなをもちました。",
          "start_ms": 289051,
          "end_ms": 292069,
          "duration_ms": 3018
        }
      ]
    },
    {
      "index": 76,
      "text": "「ハチヤ。",
      "start_ms": 292569,
      "end_ms": 294066,
      "duration_ms": 1497,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤ。",
          "start_ms": 292569,
          "end_ms": 294066,
          "duration_ms": 1497
        }
      ]
    },
    {
      "index": 77,
      "text": "あした、あいます。",
      "start_ms": 294566,
      "end_ms": 297834,
      "duration_ms": 3268,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 294566,
          "end_ms": 295982,
          "duration_ms": 1416
        },
        {
          "index": 1,
          "text": "あいます。",
          "start_ms": 296232,
          "end_ms": 297834,
          "duration_ms": 1602
        }
      ]
    },
    {
      "index": 78,
      "text": "あした、ころします。",
      "start_ms": 298334,
      "end_ms": 301729,
      "duration_ms": 3395,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 298334,
          "end_ms": 299750,
          "duration_ms": 1416
        },
        {
          "index": 1,
          "text": "ころします。",
          "start_ms": 300000,
          "end_ms": 301729,
          "duration_ms": 1729
        }
      ]
    },
    {
      "index": 79,
      "text": "もう、まってください」。",
      "start_ms": 302229,
      "end_ms": 305334,
      "duration_ms": 3105,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 302229,
          "end_ms": 303099,
          "duration_ms": 870
        },
        {
          "index": 1,
          "text": "まってください」。",
          "start_ms": 303349,
          "end_ms": 305334,
          "duration_ms": 1985
        }
      ]
    }
  ]
}