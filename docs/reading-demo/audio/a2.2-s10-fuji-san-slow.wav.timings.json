          "duration_ms": 1780
        },
        {
          "index": 1,
          "text": "ふじさんをえがく人がたくさんいました。",
          "start_ms": 117077,
          "end_ms": 120923,
          "duration_ms": 3846
        }
      ]
    },
    {
      "index": 19,
      "text": "いまも、ふじさんは日本のれきしとぶんかのたいせつなばしょです。",
      "start_ms": 121423,
