          "end_ms": 79315,
          "duration_ms": 2279
        }
      ]
    },
    {
      "index": 13,
      "text": "むかしから、日本人はふじさんをかみさまのやまだと思っていました。",
      "start_ms": 79815,
      "end_ms": 87560,
      "duration_ms": 7745,
      "clauses": [
        {
          "index": 0,
          "text": "むかしから、",
          "start_ms": 79815,
