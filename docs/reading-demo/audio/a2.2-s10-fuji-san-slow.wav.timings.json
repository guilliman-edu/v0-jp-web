          "end_ms": 130983,
          "duration_ms": 2221
        },
        {
          "index": 1,
          "text": "ふじさんはせかいぶんかいさんになりました。",
          "start_ms": 131233,
          "end_ms": 135683,
          "duration_ms": 4450
        }
      ]
    },
    {
      "index": 21,
      "text": "その名前は「しんこうのたいしょうとげいじゅつのげんせん」です。",
