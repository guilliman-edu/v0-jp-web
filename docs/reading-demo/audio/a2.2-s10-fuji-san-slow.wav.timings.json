      "text": "ふじさんにのぼる人は、あたたかいふくを持っていかなければいけません。",
      "start_ms": 173366,
      "end_ms": 180425,
      "duration_ms": 7059,
      "clauses": [
        {
          "index": 0,
          "text": "ふじさんにのぼる人は、",
          "start_ms": 173366,
          "end_ms": 176074,
          "duration_ms": 2708
