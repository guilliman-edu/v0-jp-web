          "duration_ms": 1071
        },
        {
          "index": 1,
          "text": "ふじさんは日本のれきしとぶんかのたいせつなばしょです。",
          "start_ms": 122744,
          "end_ms": 128262,
          "duration_ms": 5518
        }
      ]
    },
    {
      "index": 20,
      "text": "にせんじゅうさん年、ふじさんはせかいぶんかいさんになりました。",
