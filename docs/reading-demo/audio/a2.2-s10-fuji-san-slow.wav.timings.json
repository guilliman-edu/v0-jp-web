      "clauses": [
        {
          "index": 0,
          "text": "その名前は「しんこうのたいしょうとげいじゅつのげんせん」です。",
          "start_ms": 136183,
          "end_ms": 141724,
          "duration_ms": 5541
        }
      ]
    },
    {
      "index": 22,
      "text": "日本人は、ふじさんを日本で一番たいせつなやまだと思っています。",
