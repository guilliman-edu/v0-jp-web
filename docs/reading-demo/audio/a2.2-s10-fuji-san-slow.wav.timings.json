          "start_ms": 98448,
          "end_ms": 102004,
          "duration_ms": 3556
        }
      ]
    },
    {
      "index": 16,
      "text": "せんげんじんじゃは、ふじさんのかみさまのじんじゃです。",
      "start_ms": 102504,
      "end_ms": 108612,
      "duration_ms": 6108,
      "clauses": [
        {
          "index": 0,
          "text": "せんげんじんじゃは、",
          "start_ms": 102504,
          "end_ms": 104806,
          "duration_ms": 2302
