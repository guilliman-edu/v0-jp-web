          "start_ms": 81821,
          "end_ms": 87560,
          "duration_ms": 5739
        }
      ]
    },
    {
      "index": 14,
      "text": "やまの上には、せんげんじんじゃがあります。",
      "start_ms": 88060,
      "end_ms": 93111,
      "duration_ms": 5051,
      "clauses": [
        {
          "index": 0,
          "text": "やまの上には、",
