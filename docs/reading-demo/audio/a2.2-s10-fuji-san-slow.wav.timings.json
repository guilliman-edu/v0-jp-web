          "index": 0,
          "text": "日本には、",
          "start_ms": 109112,
          "end_ms": 110880,
          "duration_ms": 1768
        },
        {
          "index": 1,
          "text": "せんげんじんじゃがたくさんあります。",
          "start_ms": 111130,
          "end_ms": 114547,
          "duration_ms": 3417
        }
      ]
    },
    {
      "index": 18,
      "text": "むかしから、ふじさんをえがく人がたくさんいました。",
      "start_ms": 115047,
