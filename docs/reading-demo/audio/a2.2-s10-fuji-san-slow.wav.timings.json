          "start_ms": 16458,
          "end_ms": 20316,
          "duration_ms": 3858
        }
      ]
    },
    {
      "index": 4,
      "text": "ふじさんはかつかざんです。",
      "start_ms": 20816,
      "end_ms": 24105,
