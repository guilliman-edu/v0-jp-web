          "start_ms": 144393,
          "end_ms": 150097,
          "duration_ms": 5704
        }
      ]
    },
    {
      "index": 23,
      "text": "なつは、ふじさんにのぼる人がたくさんいます。",
      "start_ms": 150597,
      "end_ms": 156055,
      "duration_ms": 5458,
      "clauses": [
