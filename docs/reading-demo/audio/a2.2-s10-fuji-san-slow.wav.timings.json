          "text": "ふじさんはかつかざんです。",
          "start_ms": 20816,
          "end_ms": 24105,
          "duration_ms": 3289
        }
      ]
    },
    {
      "index": 5,
      "text": "いまはふんかしていませんが、むかしはなんかいもふんかしました。",
      "start_ms": 24605,
      "end_ms": 31409,
      "duration_ms": 6804,
      "clauses": [
        {
          "index": 0,
          "text": "いまはふんかしていませんが、",
          "start_ms": 24605,
          "end_ms": 27499,
          "duration_ms": 2894
        },
        {
          "index": 1,
