          "start_ms": 27749,
          "end_ms": 31409,
          "duration_ms": 3660
        }
      ]
    },
    {
      "index": 6,
      "text": "だから、いまのきれいなかたちになりました。",
      "start_ms": 31909,
      "end_ms": 36937,
      "duration_ms": 5028,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 31909,
          "end_ms": 33212,
          "duration_ms": 1303
        },
        {
          "index": 1,
          "text": "いまのきれいなかたちになりました。",
          "start_ms": 33462,
          "end_ms": 36937,
          "duration_ms": 3475
        }
      ]
    },
    {
      "index": 7,
      "text": "ふじさんのきれいなかたちは、せかいでゆうめいです。",
      "start_ms": 37437,
      "end_ms": 43255,
      "duration_ms": 5818,
      "clauses": [
        {
          "index": 0,
          "text": "ふじさんのきれいなかたちは、",
          "start_ms": 37437,
          "end_ms": 40494,
          "duration_ms": 3057
        },
        {
          "index": 1,
          "text": "せかいでゆうめいです。",
          "start_ms": 40744,
          "end_ms": 43255,
          "duration_ms": 2511
        }
      ]
    },
    {
      "index": 8,
      "text": "外国の人がふじさんのしゃしんを見たとき、すぐに日本のやまだと思います。",
      "start_ms": 43755,
      "end_ms": 51848,
      "duration_ms": 8093,
      "clauses": [
        {
          "index": 0,
          "text": "外国の人がふじさんのしゃしんを見たとき、",
          "start_ms": 43755,
          "end_ms": 48089,
          "duration_ms": 4334
        },
        {
          "index": 1,
          "text": "すぐに日本のやまだと思います。",
          "start_ms": 48339,
          "end_ms": 51848,
          "duration_ms": 3509
        }
      ]
    },
    {
      "index": 9,
      "text": "やまのちかくにすむ人も、とおいまちにすむ人も、ふじさんが好きです。",
      "start_ms": 52348,
      "end_ms": 60798,
      "duration_ms": 8450,
      "clauses": [
        {
          "index": 0,
          "text": "やまのちかくにすむ人も、",
          "start_ms": 52348,
          "end_ms": 55172,
          "duration_ms": 2824
        },
        {
          "index": 1,
          "text": "とおいまちにすむ人も、",
          "start_ms": 55422,
          "end_ms": 58072,
          "duration_ms": 2650
        },
        {
          "index": 2,
          "text": "ふじさんが好きです。",
          "start_ms": 58322,
          "end_ms": 60798,
          "duration_ms": 2476
        }
      ]
    },
    {
      "index": 10,
      "text": "やまの一番たかいところはさんぜんななひゃくななじゅうろくてんいちにメートルです。",
      "start_ms": 61298,
      "end_ms": 68430,
      "duration_ms": 7132,
      "clauses": [
        {
          "index": 0,
          "text": "やまの一番たかいところはさんぜんななひゃくななじゅうろくてんいちにメートルです。",
          "start_ms": 61298,
          "end_ms": 68430,
          "duration_ms": 7132
        }
      ]
    },
    {
      "index": 11,
      "text": "でも、そくりょうの点はさんぜんななひゃくななじゅうごてんごろくメートルです。",
      "start_ms": 68930,
      "end_ms": 76536,
      "duration_ms": 7606,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 68930,
          "end_ms": 70013,
          "duration_ms": 1083
        },
        {
          "index": 1,
          "text": "そくりょうの点はさんぜんななひゃくななじゅうごてんごろくメートルです。",
          "start_ms": 70263,
          "end_ms": 76536,
          "duration_ms": 6273
        }
      ]
    },
    {
