          "start_ms": 176324,
          "end_ms": 180425,
          "duration_ms": 4101
        }
      ]
    },
    {
      "index": 27,
      "text": "やまの上は、なつでもさむいからです。",
      "start_ms": 180925,
      "end_ms": 185918,
      "duration_ms": 4993,
      "clauses": [
        {
