      "end_ms": 272259,
      "duration_ms": 5170,
      "clauses": [
        {
          "index": 0,
          "text": "よっつめのてがみはむかしのとのさまへのてがみです。",
          "start_ms": 267089,
          "end_ms": 272259,
          "duration_ms": 5170
        }
      ]
    },
