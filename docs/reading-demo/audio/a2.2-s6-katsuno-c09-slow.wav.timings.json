      "start_ms": 272759,
      "end_ms": 274446,
      "duration_ms": 1687,
      "clauses": [
        {
          "index": 0,
          "text": "「とのさま。",
          "start_ms": 272759,
          "end_ms": 274446,
          "duration_ms": 1687
        }
      ]
    },
