          "index": 1,
          "text": "してもらいました。",
          "start_ms": 277475,
          "end_ms": 279661,
          "duration_ms": 2186
        }
      ]
    },
    {
      "index": 64,
      "text": "カツノはわるいおんなのひとですか。",
      "start_ms": 280161,
      "end_ms": 283740,
      "duration_ms": 3579,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはわるいおんなのひとですか。",
          "start_ms": 280161,
          "end_ms": 283740,
          "duration_ms": 3579
        }
      ]
    },
    {
      "index": 65,
      "text": "でももう、おわりです。",
      "start_ms": 284240,
      "end_ms": 287793,
      "duration_ms": 3553,
      "clauses": [
        {
          "index": 0,
          "text": "でももう、",
          "start_ms": 284240,
          "end_ms": 285752,
          "duration_ms": 1512
        },
        {
          "index": 1,
