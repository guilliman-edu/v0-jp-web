      "index": 63,
      "text": "むかしからいろいろ、してもらいました。",
      "start_ms": 274946,
      "end_ms": 279661,
      "duration_ms": 4715,
      "clauses": [
        {
          "index": 0,
          "text": "むかしからいろいろ、",
          "start_ms": 274946,
          "end_ms": 277225,
          "duration_ms": 2279
        },
