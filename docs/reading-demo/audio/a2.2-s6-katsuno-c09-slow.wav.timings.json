          "start_ms": 194718,
          "end_ms": 195650,
          "duration_ms": 932
        },
        {
          "index": 1,
          "text": "なにもしんぱい、",
          "start_ms": 195900,
          "end_ms": 198086,
          "duration_ms": 2186
        },
        {
          "index": 2,
          "text": "しないでください。",
          "start_ms": 198336,
          "end_ms": 200557,
          "duration_ms": 2221
        }
      ]
    },
    {
      "index": 47,
      "text": "どうぞ、げんきでいてください」。",
      "start_ms": 201057,
      "end_ms": 205075,
      "duration_ms": 4018,
      "clauses": [
        {
          "index": 0,
          "text": "どうぞ、",
          "start_ms": 201057,
          "end_ms": 202337,
          "duration_ms": 1280
        },
        {
          "index": 1,
          "text": "げんきでいてください」。",
          "start_ms": 202587,
          "end_ms": 205075,
          "duration_ms": 2488
        }
      ]
    },
    {
      "index": 48,
      "text": "につめのてがみはわかいさむらいへのてがみです。",
      "start_ms": 205575,
      "end_ms": 210199,
      "duration_ms": 4624,
      "clauses": [
        {
          "index": 0,
          "text": "につめのてがみはわかいさむらいへのてがみです。",
          "start_ms": 205575,
          "end_ms": 210199,
          "duration_ms": 4624
        }
      ]
    },
    {
      "index": 49,
      "text": "「あなたはわたしをたいせつにおもいました。",
      "start_ms": 210699,
      "end_ms": 214800,
      "duration_ms": 4101,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたはわたしをたいせつにおもいました。",
          "start_ms": 210699,
          "end_ms": 214800,
          "duration_ms": 4101
        }
      ]
    },
    {
      "index": 50,
      "text": "あなたといて、うれしかったです。",
      "start_ms": 215300,
      "end_ms": 219701,
      "duration_ms": 4401,
      "clauses": [
        {
          "index": 0,
          "text": "あなたといて、",
          "start_ms": 215300,
          "end_ms": 217288,
          "duration_ms": 1988
        },
        {
          "index": 1,
          "text": "うれしかったです。",
          "start_ms": 217538,
          "end_ms": 219701,
          "duration_ms": 2163
        }
      ]
    },
    {
      "index": 51,
      "text": "ありがとう。",
      "start_ms": 220201,
      "end_ms": 221992,
      "duration_ms": 1791,
      "clauses": [
        {
          "index": 0,
          "text": "ありがとう。",
          "start_ms": 220201,
          "end_ms": 221992,
          "duration_ms": 1791
        }
      ]
    },
    {
      "index": 52,
      "text": "もう、かなしまないでください」。",
      "start_ms": 222492,
      "end_ms": 226231,
      "duration_ms": 3739,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 222492,
          "end_ms": 223389,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "かなしまないでください」。",
          "start_ms": 223639,
          "end_ms": 226231,
          "duration_ms": 2592
        }
      ]
    },
    {
      "index": 53,
      "text": "みっつめのてがみはおくさんへのてがみです。",
      "start_ms": 226731,
      "end_ms": 231239,
      "duration_ms": 4508,
      "clauses": [
        {
          "index": 0,
          "text": "みっつめのてがみはおくさんへのてがみです。",
          "start_ms": 226731,
          "end_ms": 231239,
          "duration_ms": 4508
        }
      ]
    },
    {
      "index": 54,
      "text": "「おくさん。",
      "start_ms": 231739,
      "end_ms": 233205,
      "duration_ms": 1466,
      "clauses": [
        {
          "index": 0,
          "text": "「おくさん。",
          "start_ms": 231739,
          "end_ms": 233205,
          "duration_ms": 1466
        }
      ]
    },
    {
      "index": 55,
      "text": "あなたはわたしの、いいともだちです。",
      "start_ms": 233705,
      "end_ms": 238525,
      "duration_ms": 4820,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはわたしの、",
          "start_ms": 233705,
          "end_ms": 236019,
          "duration_ms": 2314
        },
        {
          "index": 1,
          "text": "いいともだちです。",
          "start_ms": 236269,
          "end_ms": 238525,
          "duration_ms": 2256
        }
      ]
    },
    {
      "index": 56,
      "text": "あのよる、わたしのへやへきました。",
      "start_ms": 239025,
      "end_ms": 243751,
      "duration_ms": 4726,
      "clauses": [
        {
          "index": 0,
          "text": "あのよる、",
          "start_ms": 239025,
          "end_ms": 240723,
          "duration_ms": 1698
        },
        {
          "index": 1,
          "text": "わたしのへやへきました。",
          "start_ms": 240973,
          "end_ms": 243751,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 57,
      "text": "そして、「にげてください」といいました。",
      "start_ms": 244251,
      "end_ms": 248965,
      "duration_ms": 4714,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 244251,
          "end_ms": 245763,
          "duration_ms": 1512
        },
        {
          "index": 1,
          "text": "「にげてください」といいました。",
          "start_ms": 246013,
          "end_ms": 248965,
          "duration_ms": 2952
        }
      ]
    },
    {
      "index": 58,
      "text": "あなたがなければ、わたしはもう、しんでいました。",
      "start_ms": 249465,
      "end_ms": 256244,
      "duration_ms": 6779,
      "clauses": [
        {
          "index": 0,
          "text": "あなたがなければ、",
          "start_ms": 249465,
          "end_ms": 251709,
          "duration_ms": 2244
        },
        {
          "index": 1,
          "text": "わたしはもう、",
          "start_ms": 251959,
          "end_ms": 253889,
          "duration_ms": 1930
        },
        {
          "index": 2,
          "text": "しんでいました。",
          "start_ms": 254139,
          "end_ms": 256244,
          "duration_ms": 2105
        }
      ]
    },
    {
      "index": 59,
      "text": "でももう、こうして、しにます。",
      "start_ms": 256744,
      "end_ms": 262118,
      "duration_ms": 5374,
      "clauses": [
        {
          "index": 0,
          "text": "でももう、",
          "start_ms": 256744,
          "end_ms": 258291,
          "duration_ms": 1547
        },
        {
          "index": 1,
          "text": "こうして、",
          "start_ms": 258541,
          "end_ms": 260042,
          "duration_ms": 1501
        },
        {
          "index": 2,
          "text": "しにます。",
          "start_ms": 260292,
          "end_ms": 262118,
          "duration_ms": 1826
        }
      ]
    },
    {
      "index": 60,
      "text": "どうぞ、げんきでいてください」。",
      "start_ms": 262618,
