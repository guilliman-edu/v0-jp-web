          "start_ms": 236170,
          "end_ms": 238426,
          "duration_ms": 2256
        }
      ]
    },
    {
      "index": 56,
      "text": "あのよる、わたしのへやへきました。",
      "start_ms": 238926,
      "end_ms": 243594,
      "duration_ms": 4668,
      "clauses": [
        {
          "index": 0,
