      "index": 62,
      "text": "「とのさま。",
      "start_ms": 272163,
      "end_ms": 273873,
      "duration_ms": 1710,
      "clauses": [
        {
          "index": 0,
          "text": "「とのさま。",
          "start_ms": 272163,
          "end_ms": 273873,
          "duration_ms": 1710
        }
      ]
    },
    {
      "index": 63,
      "text": "むかしからいろいろ、してもらいました。",
      "start_ms": 274373,
      "end_ms": 279076,
      "duration_ms": 4703,
      "clauses": [
        {
          "index": 0,
          "text": "むかしからいろいろ、",
          "start_ms": 274373,
          "end_ms": 276675,
          "duration_ms": 2302
        },
        {
          "index": 1,
          "text": "してもらいました。",
          "start_ms": 276925,
          "end_ms": 279076,
          "duration_ms": 2151
        }
      ]
    },
    {
      "index": 64,
      "text": "カツノはわるいおんなのひとですか。",
      "start_ms": 279576,
      "end_ms": 283155,
      "duration_ms": 3579,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはわるいおんなのひとですか。",
          "start_ms": 279576,
          "end_ms": 283155,
          "duration_ms": 3579
        }
      ]
    },
    {
      "index": 65,
      "text": "でももう、おわりです。",
      "start_ms": 283655,
      "end_ms": 287209,
      "duration_ms": 3554,
      "clauses": [
        {
          "index": 0,
          "text": "でももう、",
          "start_ms": 283655,
          "end_ms": 285191,
          "duration_ms": 1536
        },
        {
          "index": 1,
          "text": "おわりです。",
          "start_ms": 285441,
          "end_ms": 287209,
          "duration_ms": 1768
        }
      ]
    },
    {
      "index": 66,
      "text": "どうぞ、げんきでいてください。",
      "start_ms": 287709,
      "end_ms": 291704,
      "duration_ms": 3995,
      "clauses": [
        {
          "index": 0,
          "text": "どうぞ、",
          "start_ms": 287709,
          "end_ms": 288966,
          "duration_ms": 1257
        },
        {
          "index": 1,
          "text": "げんきでいてください。",
          "start_ms": 289216,
          "end_ms": 291704,
          "duration_ms": 2488
        }
      ]
    },
    {
      "index": 67,
      "text": "そして、もう、かなしまないでください」。",
      "start_ms": 292204,
      "end_ms": 297776,
      "duration_ms": 5572,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 292204,
          "end_ms": 293705,
          "duration_ms": 1501
        },
        {
          "index": 1,
