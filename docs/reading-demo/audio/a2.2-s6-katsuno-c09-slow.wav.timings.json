        },
        {
          "index": 1,
          "text": "なにもしんぱい、",
          "start_ms": 195713,
          "end_ms": 197829,
          "duration_ms": 2116
        },
        {
          "index": 2,
          "text": "しないでください。",
          "start_ms": 198079,
          "end_ms": 200253,
          "duration_ms": 2174
        }
      ]
    },
    {
      "index": 47,
      "text": "どうぞ、げんきでいてください」。",
      "start_ms": 200753,
      "end_ms": 204782,
      "duration_ms": 4029,
      "clauses": [
        {
          "index": 0,
          "text": "どうぞ、",
          "start_ms": 200753,
          "end_ms": 202033,
          "duration_ms": 1280
        },
        {
          "index": 1,
          "text": "げんきでいてください」。",
          "start_ms": 202283,
          "end_ms": 204782,
          "duration_ms": 2499
        }
      ]
    },
    {
      "index": 48,
      "text": "につめのてがみはわかいさむらいへのてがみです。",
      "start_ms": 205282,
      "end_ms": 209964,
      "duration_ms": 4682,
      "clauses": [
        {
          "index": 0,
          "text": "につめのてがみはわかいさむらいへのてがみです。",
          "start_ms": 205282,
          "end_ms": 209964,
          "duration_ms": 4682
        }
      ]
    },
    {
      "index": 49,
      "text": "「あなたはわたしをたいせつにおもいました。",
      "start_ms": 210464,
      "end_ms": 214484,
      "duration_ms": 4020,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたはわたしをたいせつにおもいました。",
          "start_ms": 210464,
          "end_ms": 214484,
          "duration_ms": 4020
        }
      ]
    },
    {
      "index": 50,
      "text": "あなたといて、うれしかったです。",
      "start_ms": 214984,
      "end_ms": 219362,
      "duration_ms": 4378,
      "clauses": [
        {
          "index": 0,
          "text": "あなたといて、",
          "start_ms": 214984,
          "end_ms": 216961,
          "duration_ms": 1977
        },
        {
          "index": 1,
          "text": "うれしかったです。",
          "start_ms": 217211,
          "end_ms": 219362,
          "duration_ms": 2151
        }
      ]
    },
    {
      "index": 51,
      "text": "ありがとう。",
      "start_ms": 219862,
      "end_ms": 221630,
      "duration_ms": 1768,
      "clauses": [
        {
          "index": 0,
          "text": "ありがとう。",
          "start_ms": 219862,
          "end_ms": 221630,
          "duration_ms": 1768
        }
      ]
    },
    {
      "index": 52,
      "text": "もう、かなしまないでください」。",
      "start_ms": 222130,
      "end_ms": 225927,
      "duration_ms": 3797,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 222130,
          "end_ms": 223050,
          "duration_ms": 920
        },
        {
          "index": 1,
          "text": "かなしまないでください」。",
          "start_ms": 223300,
          "end_ms": 225927,
          "duration_ms": 2627
        }
      ]
    },
    {
      "index": 53,
      "text": "みっつめのてがみはおくさんへのてがみです。",
      "start_ms": 226427,
      "end_ms": 230842,
      "duration_ms": 4415,
      "clauses": [
        {
          "index": 0,
          "text": "みっつめのてがみはおくさんへのてがみです。",
          "start_ms": 226427,
          "end_ms": 230842,
          "duration_ms": 4415
        }
      ]
    },
    {
      "index": 54,
      "text": "「おくさん。",
      "start_ms": 231342,
      "end_ms": 232796,
      "duration_ms": 1454,
      "clauses": [
        {
          "index": 0,
          "text": "「おくさん。",
          "start_ms": 231342,
          "end_ms": 232796,
          "duration_ms": 1454
        }
      ]
    },
    {
      "index": 55,
      "text": "あなたはわたしの、いいともだちです。",
      "start_ms": 233296,
      "end_ms": 238034,
      "duration_ms": 4738,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはわたしの、",
          "start_ms": 233296,
          "end_ms": 235563,
          "duration_ms": 2267
        },
        {
          "index": 1,
          "text": "いいともだちです。",
          "start_ms": 235813,
          "end_ms": 238034,
          "duration_ms": 2221
        }
      ]
    },
    {
      "index": 56,
      "text": "あのよる、わたしのへやへきました。",
      "start_ms": 238534,
      "end_ms": 243109,
      "duration_ms": 4575,
      "clauses": [
        {
          "index": 0,
          "text": "あのよる、",
          "start_ms": 238534,
          "end_ms": 240139,
          "duration_ms": 1605
        },
        {
          "index": 1,
          "text": "わたしのへやへきました。",
          "start_ms": 240389,
          "end_ms": 243109,
          "duration_ms": 2720
        }
      ]
    },
    {
      "index": 57,
      "text": "そして、「にげてください」といいました。",
      "start_ms": 243609,
      "end_ms": 248335,
      "duration_ms": 4726,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 243609,
          "end_ms": 245098,
          "duration_ms": 1489
        },
        {
          "index": 1,
          "text": "「にげてください」といいました。",
          "start_ms": 245348,
          "end_ms": 248335,
          "duration_ms": 2987
        }
      ]
    },
    {
      "index": 58,
      "text": "あなたがなければ、わたしはもう、しんでいました。",
      "start_ms": 248835,
      "end_ms": 255590,
      "duration_ms": 6755,
      "clauses": [
        {
          "index": 0,
          "text": "あなたがなければ、",
          "start_ms": 248835,
          "end_ms": 251160,
          "duration_ms": 2325
        },
        {
          "index": 1,
          "text": "わたしはもう、",
          "start_ms": 251410,
          "end_ms": 253282,
          "duration_ms": 1872
        },
        {
          "index": 2,
          "text": "しんでいました。",
          "start_ms": 253532,
          "end_ms": 255590,
          "duration_ms": 2058
        }
      ]
    },
    {
      "index": 59,
      "text": "でももう、こうして、しにます。",
      "start_ms": 256090,
      "end_ms": 261441,
      "duration_ms": 5351,
      "clauses": [
        {
          "index": 0,
          "text": "でももう、",
          "start_ms": 256090,
          "end_ms": 257602,
          "duration_ms": 1512
        },
        {
          "index": 1,
          "text": "こうして、",
          "start_ms": 257852,
          "end_ms": 259388,
          "duration_ms": 1536
        },
        {
          "index": 2,
          "text": "しにます。",
          "start_ms": 259638,
          "end_ms": 261441,
          "duration_ms": 1803
        }
      ]
    },
    {
      "index": 60,
      "text": "どうぞ、げんきでいてください」。",
      "start_ms": 261941,
      "end_ms": 265924,
      "duration_ms": 3983,
      "clauses": [
        {
          "index": 0,
          "text": "どうぞ、",
          "start_ms": 261941,
          "end_ms": 263210,
          "duration_ms": 1269
        },
