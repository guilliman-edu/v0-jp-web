          "end_ms": 294864,
          "duration_ms": 909
        },
        {
          "index": 2,
          "text": "かなしまないでください」。",
          "start_ms": 295114,
          "end_ms": 297776,
          "duration_ms": 2662
        }
      ]
    },
    {
      "index": 68,
      "text": "カツノのてがみはよっつ、ありました。",
      "start_ms": 298276,
      "end_ms": 303211,
      "duration_ms": 4935,
      "clauses": [
        {
          "index": 0,
          "text": "カツノのてがみはよっつ、",
          "start_ms": 298276,
          "end_ms": 301158,
          "duration_ms": 2882
        },
        {
          "index": 1,
          "text": "ありました。",
          "start_ms": 301408,
          "end_ms": 303211,
          "duration_ms": 1803
        }
      ]
    },
    {
      "index": 69,
      "text": "しろのひとはみな、カツノをおもっていました。",
      "start_ms": 303711,
      "end_ms": 308959,
      "duration_ms": 5248,
      "clauses": [
        {
          "index": 0,
          "text": "しろのひとはみな、",
          "start_ms": 303711,
          "end_ms": 306001,
          "duration_ms": 2290
        },
        {
          "index": 1,
          "text": "カツノをおもっていました。",
          "start_ms": 306251,
          "end_ms": 308959,
          "duration_ms": 2708
        }
      ]
    },
    {
      "index": 70,
      "text": "「いいおんなのひとでした。",
      "start_ms": 309459,
      "end_ms": 311958,
      "duration_ms": 2499,
      "clauses": [
        {
          "index": 0,
          "text": "「いいおんなのひとでした。",
          "start_ms": 309459,
          "end_ms": 311958,
          "duration_ms": 2499
        }
      ]
    },
    {
      "index": 71,
      "text": "でももう、ありません。",
      "start_ms": 312458,
      "end_ms": 316000,
      "duration_ms": 3542,
      "clauses": [
