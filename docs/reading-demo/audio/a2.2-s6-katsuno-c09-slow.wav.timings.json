          "start_ms": 198400,
          "end_ms": 200528,
          "duration_ms": 2128
        }
      ]
    },
    {
      "index": 47,
      "text": "どうぞ、げんきでいてください」。",
      "start_ms": 201028,
      "end_ms": 204976,
      "duration_ms": 3948,
      "clauses": [
        {
          "index": 0,
          "text": "どうぞ、",
          "start_ms": 201028,
          "end_ms": 202320,
          "duration_ms": 1292
        },
        {
          "index": 1,
          "text": "げんきでいてください」。",
          "start_ms": 202570,
          "end_ms": 204976,
          "duration_ms": 2406
        }
      ]
    },
    {
      "index": 48,
      "text": "につめのてがみはわかいさむらいへのてがみです。",
      "start_ms": 205476,
      "end_ms": 210065,
      "duration_ms": 4589,
      "clauses": [
        {
          "index": 0,
          "text": "につめのてがみはわかいさむらいへのてがみです。",
          "start_ms": 205476,
          "end_ms": 210065,
          "duration_ms": 4589
        }
      ]
    },
    {
      "index": 49,
      "text": "「あなたはわたしをたいせつにおもいました。",
      "start_ms": 210565,
      "end_ms": 214666,
      "duration_ms": 4101,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたはわたしをたいせつにおもいました。",
          "start_ms": 210565,
          "end_ms": 214666,
          "duration_ms": 4101
        }
      ]
    },
    {
      "index": 50,
      "text": "あなたといて、うれしかったです。",
      "start_ms": 215166,
      "end_ms": 219520,
      "duration_ms": 4354,
      "clauses": [
        {
          "index": 0,
          "text": "あなたといて、",
          "start_ms": 215166,
          "end_ms": 217096,
          "duration_ms": 1930
        },
        {
          "index": 1,
          "text": "うれしかったです。",
          "start_ms": 217346,
          "end_ms": 219520,
          "duration_ms": 2174
        }
      ]
    },
    {
      "index": 51,
      "text": "ありがとう。",
