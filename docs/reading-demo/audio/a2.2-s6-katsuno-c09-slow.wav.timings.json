        {
          "index": 1,
          "text": "いいともだちです。",
          "start_ms": 231288,
          "end_ms": 233412,
          "duration_ms": 2124
        }
      ]
    },
    {
      "index": 56,
      "text": "あのよる、わたしのへやへきました。",
      "start_ms": 233912,
      "end_ms": 238469,
      "duration_ms": 4557,
      "clauses": [
        {
          "index": 0,
          "text": "あのよる、",
