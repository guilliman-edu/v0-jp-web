      "start_ms": 292776,
      "end_ms": 298381,
      "duration_ms": 5605,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 292776,
          "end_ms": 294288,
          "duration_ms": 1512
        },
        {
          "index": 1,
