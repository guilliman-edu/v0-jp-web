          "end_ms": 235572,
          "duration_ms": 1660
        },
        {
          "index": 1,
          "text": "わたしのへやへきました。",
          "start_ms": 235822,
          "end_ms": 238469,
          "duration_ms": 2647
        }
      ]
    },
    {
      "index": 57,
