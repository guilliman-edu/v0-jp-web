      "end_ms": 231105,
      "duration_ms": 4531,
      "clauses": [
        {
          "index": 0,
          "text": "みっつめのてがみはおくさんへのてがみです。",
          "start_ms": 226574,
          "end_ms": 231105,
          "duration_ms": 4531
        }
      ]
    },
    {
