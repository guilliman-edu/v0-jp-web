          "start_ms": 304270,
          "end_ms": 306653,
          "duration_ms": 2383
        },
        {
          "index": 1,
          "text": "カツノをおもっていました。",
          "start_ms": 306903,
          "end_ms": 309530,
          "duration_ms": 2627
        }
      ]
    },
