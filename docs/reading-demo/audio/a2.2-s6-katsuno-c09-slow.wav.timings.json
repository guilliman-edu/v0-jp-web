          "index": 2,
          "text": "かなしまないでください」。",
          "start_ms": 295708,
          "end_ms": 298381,
          "duration_ms": 2673
        }
      ]
    },
    {
      "index": 68,
      "text": "カツノのてがみはよっつ、ありました。",
      "start_ms": 298881,
      "end_ms": 303770,
      "duration_ms": 4889,
      "clauses": [
        {
          "index": 0,
          "text": "カツノのてがみはよっつ、",
