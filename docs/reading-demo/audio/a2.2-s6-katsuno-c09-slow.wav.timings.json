          "start_ms": 226952,
          "end_ms": 228321,
          "duration_ms": 1369
        }
      ]
    },
    {
      "index": 55,
      "text": "あなたはわたしの、いいともだちです。",
      "start_ms": 228821,
      "end_ms": 233412,
      "duration_ms": 4591,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはわたしの、",
