          "end_ms": 301729,
          "duration_ms": 2848
        },
        {
          "index": 1,
          "text": "ありました。",
          "start_ms": 301979,
          "end_ms": 303770,
          "duration_ms": 1791
        }
      ]
    },
    {
      "index": 69,
      "text": "しろのひとはみな、カツノをおもっていました。",
      "start_ms": 304270,
      "end_ms": 309530,
      "duration_ms": 5260,
      "clauses": [
        {
          "index": 0,
