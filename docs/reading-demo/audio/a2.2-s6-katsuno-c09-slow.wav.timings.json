      "end_ms": 221776,
      "duration_ms": 1756,
      "clauses": [
        {
          "index": 0,
          "text": "ありがとう。",
          "start_ms": 220020,
          "end_ms": 221776,
          "duration_ms": 1756
        }
      ]
    },
    {
      "index": 52,
      "text": "もう、かなしまないでください」。",
