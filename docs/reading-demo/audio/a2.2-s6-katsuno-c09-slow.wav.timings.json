          "end_ms": 191533,
          "duration_ms": 870
        },
        {
          "index": 1,
          "text": "なにもしんぱい、",
          "start_ms": 191783,
          "end_ms": 193907,
          "duration_ms": 2124
        },
        {
          "index": 2,
          "text": "しないでください。",
          "start_ms": 194157,
          "end_ms": 196328,
          "duration_ms": 2171
        }
      ]
    },
    {
      "index": 47,
      "text": "どうぞ、げんきでいてください」。",
      "start_ms": 196828,
      "end_ms": 200560,
      "duration_ms": 3732,
      "clauses": [
        {
          "index": 0,
          "text": "どうぞ、",
          "start_ms": 196828,
          "end_ms": 198035,
          "duration_ms": 1207
        },
        {
          "index": 1,
          "text": "げんきでいてください」。",
          "start_ms": 198285,
          "end_ms": 200560,
          "duration_ms": 2275
        }
      ]
    },
    {
      "index": 48,
      "text": "ふたつめのてがみはわかいさむらいへのてがみです。",
      "start_ms": 201060,
      "end_ms": 205820,
      "duration_ms": 4760,
      "clauses": [
        {
          "index": 0,
          "text": "ふたつめのてがみはわかいさむらいへのてがみです。",
          "start_ms": 201060,
          "end_ms": 205820,
          "duration_ms": 4760
        }
      ]
    },
    {
      "index": 49,
      "text": "「あなたはわたしをたいせつにおもいました。",
      "start_ms": 206320,
      "end_ms": 210371,
      "duration_ms": 4051,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたはわたしをたいせつにおもいました。",
          "start_ms": 206320,
          "end_ms": 210371,
          "duration_ms": 4051
        }
      ]
    },
    {
      "index": 50,
      "text": "あなたといて、うれしかったです。",
      "start_ms": 210871,
      "end_ms": 215172,
      "duration_ms": 4301,
      "clauses": [
        {
          "index": 0,
          "text": "あなたといて、",
          "start_ms": 210871,
          "end_ms": 212821,
          "duration_ms": 1950
        },
        {
          "index": 1,
          "text": "うれしかったです。",
          "start_ms": 213071,
          "end_ms": 215172,
          "duration_ms": 2101
        }
      ]
    },
    {
      "index": 51,
      "text": "ありがとう。",
      "start_ms": 215672,
      "end_ms": 217367,
      "duration_ms": 1695,
      "clauses": [
        {
          "index": 0,
          "text": "ありがとう。",
          "start_ms": 215672,
          "end_ms": 217367,
          "duration_ms": 1695
        }
      ]
    },
    {
      "index": 52,
      "text": "もう、かなしまないでください」。",
