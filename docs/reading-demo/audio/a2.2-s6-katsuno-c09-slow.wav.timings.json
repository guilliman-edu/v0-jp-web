          "index": 1,
          "text": "げんきでいてください」。",
          "start_ms": 263460,
          "end_ms": 265924,
          "duration_ms": 2464
        }
      ]
    },
    {
      "index": 61,
      "text": "よっつめのてがみはむかしのとのさまへのてがみです。",
      "start_ms": 266424,
      "end_ms": 271663,
      "duration_ms": 5239,
      "clauses": [
        {
          "index": 0,
          "text": "よっつめのてがみはむかしのとのさまへのてがみです。",
          "start_ms": 266424,
          "end_ms": 271663,
          "duration_ms": 5239
        }
      ]
    },
