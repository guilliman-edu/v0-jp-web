      "index": 70,
      "text": "「いいおんなのひとでした。",
      "start_ms": 310030,
      "end_ms": 312541,
      "duration_ms": 2511,
      "clauses": [
        {
          "index": 0,
          "text": "「いいおんなのひとでした。",
          "start_ms": 310030,
          "end_ms": 312541,
          "duration_ms": 2511
        }
      ]
    },
