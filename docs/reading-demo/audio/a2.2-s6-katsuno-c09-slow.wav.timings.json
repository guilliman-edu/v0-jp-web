          "end_ms": 218737,
          "duration_ms": 870
        },
        {
          "index": 1,
          "text": "かなしまないでください」。",
          "start_ms": 218987,
          "end_ms": 221506,
          "duration_ms": 2519
        }
      ]
    },
    {
      "index": 53,
      "text": "みっつめのてがみはおくさんへのてがみです。",
      "start_ms": 222006,
      "end_ms": 226452,
      "duration_ms": 4446,
      "clauses": [
        {
          "index": 0,
          "text": "みっつめのてがみはおくさんへのてがみです。",
          "start_ms": 222006,
          "end_ms": 226452,
          "duration_ms": 4446
        }
      ]
    },
    {
      "index": 54,
      "text": "「おくさん。",
      "start_ms": 226952,
      "end_ms": 228321,
      "duration_ms": 1369,
      "clauses": [
