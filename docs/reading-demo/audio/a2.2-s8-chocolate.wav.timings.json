{
  "audio_file": "a2.2-s8-chocolate.wav",
  "sample_rate": 44100,
  "pause_ms": 500,
  "total_duration_ms": 345230,
  "sentences": [
    {
      "index": 0,
      "text": "チョコレートをあげる日の話",
      "start_ms": 0,
      "end_ms": 2900,
      "duration_ms": 2900,
      "clauses": [
        {
          "index": 0,
          "text": "チョコレートをあげる日の話",
          "start_ms": 0,
          "end_ms": 2900,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 1,
      "text": "日本では、バレンタインデーに、女の人がすきな男の人にチョコレートをあげるしゅうかんがあります。",
      "start_ms": 3400,
      "end_ms": 13016,
      "duration_ms": 9616,
      "clauses": [
        {
          "index": 0,
          "text": "日本では、",
          "start_ms": 3400,
          "end_ms": 5022,
          "duration_ms": 1622
        },
        {
          "index": 1,
          "text": "バレンタインデーに、",
          "start_ms": 5272,
          "end_ms": 7208,
          "duration_ms": 1936
        },
        {
          "index": 2,
          "text": "女の人がすきな男の人にチョコレートをあげるしゅうかんがあります。",
          "start_ms": 7458,
          "end_ms": 13016,
          "duration_ms": 5558
        }
      ]
    },
    {
      "index": 2,
      "text": "これはがいこくにはあまりない、日本でゆうめいなしゅうかんです。",
      "start_ms": 13516,
      "end_ms": 19542,
      "duration_ms": 6026,
      "clauses": [
        {
          "index": 0,
          "text": "これはがいこくにはあまりない、",
          "start_ms": 13516,
          "end_ms": 16369,
          "duration_ms": 2853
        },
        {
          "index": 1,
          "text": "日本でゆうめいなしゅうかんです。",
          "start_ms": 16619,
          "end_ms": 19542,
          "duration_ms": 2923
        }
      ]
    },
    {
      "index": 3,
      "text": "こうべのもろぞふせいかというかいしゃが、このしゅうかんを始めたそうです。",
      "start_ms": 20042,
      "end_ms": 26927,
      "duration_ms": 6885,
      "clauses": [
        {
          "index": 0,
          "text": "こうべのもろぞふせいかというかいしゃが、",
          "start_ms": 20042,
          "end_ms": 23452,
          "duration_ms": 3410
        },
        {
          "index": 1,
          "text": "このしゅうかんを始めたそうです。",
          "start_ms": 23702,
          "end_ms": 26927,
          "duration_ms": 3225
        }
      ]
    },
    {
      "index": 4,
      "text": "かいしゃは、がいこくの人が読む英語のしんぶん『The Japan Advertiser』に、チョコレートのこうこくを出しました。",
      "start_ms": 27427,
      "end_ms": 36416,
      "duration_ms": 8989,
      "clauses": [
        {
          "index": 0,
          "text": "かいしゃは、",
          "start_ms": 27427,
          "end_ms": 29026,
          "duration_ms": 1599
        },
        {
          "index": 1,
          "text": "がいこくの人が読む英語のしんぶん『The Japan Advertiser』に、",
          "start_ms": 29276,
          "end_ms": 33046,
          "duration_ms": 3770
        },
        {
          "index": 2,
          "text": "チョコレートのこうこくを出しました。",
          "start_ms": 33296,
          "end_ms": 36416,
          "duration_ms": 3120
        }
      ]
    },
    {
      "index": 5,
      "text": "その後、ふじややもりながせいかなどのおかしのかいしゃも、なんかいも「バレンタインデーは女の人が男の人にチョコレートをあげる日です」と言いました。",
      "start_ms": 36916,
      "end_ms": 50317,
      "duration_ms": 13401,
      "clauses": [
        {
          "index": 0,
          "text": "その後、",
          "start_ms": 36916,
          "end_ms": 38480,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "ふじややもりながせいかなどのおかしのかいしゃも、",
          "start_ms": 38730,
          "end_ms": 42767,
          "duration_ms": 4037
        },
        {
          "index": 2,
          "text": "なんかいも「バレンタインデーは女の人が男の人にチョコレートをあげる日です」と言いました。",
          "start_ms": 43017,
          "end_ms": 50317,
          "duration_ms": 7300
        }
      ]
    },
    {
      "index": 6,
      "text": "こうして、むかしは日本になかったがいこくのぎょうじが、「チョコレートの日」になりました。",
      "start_ms": 50817,
      "end_ms": 59400,
      "duration_ms": 8583,
      "clauses": [
        {
          "index": 0,
          "text": "こうして、",
          "start_ms": 50817,
          "end_ms": 52254,
          "duration_ms": 1437
        },
        {
          "index": 1,
          "text": "むかしは日本になかったがいこくのぎょうじが、",
          "start_ms": 52504,
          "end_ms": 56448,
          "duration_ms": 3944
        },
        {
          "index": 2,
          "text": "「チョコレートの日」になりました。",
          "start_ms": 56698,
          "end_ms": 59400,
          "duration_ms": 2702
        }
      ]
    },
    {
      "index": 7,
      "text": "バレンタインデーはせんきゅうひゃくごじゅう年代に日本でゆうめいになりました。",
      "start_ms": 59900,
      "end_ms": 65981,
      "duration_ms": 6081,
      "clauses": [
        {
          "index": 0,
          "text": "バレンタインデーはせんきゅうひゃくごじゅう年代に日本でゆうめいになりました。",
          "start_ms": 59900,
          "end_ms": 65981,
          "duration_ms": 6081
        }
      ]
    },
    {
      "index": 8,
      "text": "せんきゅうひゃくごじゅうはち年、メリーチョコレートカムパニーというかいしゃが、いせたんのみせに「バレンタインセール」と書いたこうこくを出して、チョコレートを売りました。",
      "start_ms": 66481,
      "end_ms": 80687,
      "duration_ms": 14206,
      "clauses": [
        {
          "index": 0,
          "text": "せんきゅうひゃくごじゅうはち年、",
          "start_ms": 66481,
          "end_ms": 69357,
          "duration_ms": 2876
        },
        {
          "index": 1,
          "text": "メリーチョコレートカムパニーというかいしゃが、",
          "start_ms": 69607,
          "end_ms": 73087,
          "duration_ms": 3480
        },
        {
          "index": 2,
          "text": "いせたんのみせに「バレンタインセール」と書いたこうこくを出して、",
          "start_ms": 73337,
          "end_ms": 78164,
          "duration_ms": 4827
        },
        {
          "index": 3,
          "text": "チョコレートを売りました。",
          "start_ms": 78414,
          "end_ms": 80687,
          "duration_ms": 2273
        }
      ]
    },
    {
      "index": 9,
      "text": "さらにせんきゅうひゃくろくじゅう年には、もりながせいかがテレビやしんぶんで、バレンタインのこうこくをたくさん出しました。",
      "start_ms": 81187,
      "end_ms": 92335,
      "duration_ms": 11148,
      "clauses": [
        {
          "index": 0,
          "text": "さらにせんきゅうひゃくろくじゅう年には、",
          "start_ms": 81187,
          "end_ms": 84574,
          "duration_ms": 3387
        },
        {
          "index": 1,
          "text": "もりながせいかがテレビやしんぶんで、",
          "start_ms": 84824,
          "end_ms": 88083,
          "duration_ms": 3259
        },
        {
          "index": 2,
          "text": "バレンタインのこうこくをたくさん出しました。",
          "start_ms": 88333,
          "end_ms": 92335,
          "duration_ms": 4002
        }
      ]
    },
    {
      "index": 10,
      "text": "こうして、バレンタインデーは日本でおおきいぎょうじになりました。",
      "start_ms": 92835,
      "end_ms": 99093,
      "duration_ms": 6258,
      "clauses": [
        {
          "index": 0,
          "text": "こうして、",
          "start_ms": 92835,
          "end_ms": 94202,
          "duration_ms": 1367
        },
        {
          "index": 1,
          "text": "バレンタインデーは日本でおおきいぎょうじになりました。",
          "start_ms": 94452,
          "end_ms": 99093,
          "duration_ms": 4641
        }
      ]
    },
    {
      "index": 11,
      "text": "すきな男の人にチョコレートをあげる人もおおいし、いちねんでチョコレートをたくさん食べられる日にもなりました。",
      "start_ms": 99593,
      "end_ms": 108997,
      "duration_ms": 9404,
      "clauses": [
        {
          "index": 0,
          "text": "すきな男の人にチョコレートをあげる人もおおいし、",
          "start_ms": 99593,
          "end_ms": 104083,
          "duration_ms": 4490
        },
        {
          "index": 1,
          "text": "いちねんでチョコレートをたくさん食べられる日にもなりました。",
          "start_ms": 104333,
          "end_ms": 108997,
          "duration_ms": 4664
        }
      ]
    },
    {
      "index": 12,
      "text": "チョコレートをもらった男の人は、おかえしに何がほしいですか。",
      "start_ms": 109497,
      "end_ms": 115999,
      "duration_ms": 6502,
      "clauses": [
        {
          "index": 0,
          "text": "チョコレートをもらった男の人は、",
          "start_ms": 109497,
          "end_ms": 112571,
          "duration_ms": 3074
        },
        {
          "index": 1,
          "text": "おかえしに何がほしいですか。",
          "start_ms": 112821,
          "end_ms": 115999,
          "duration_ms": 3178
        }
      ]
    },
    {
      "index": 13,
      "text": "そこで、ふくおかしのおかしのみせ、いしむらまんせいどうが、せんきゅうひゃくななじゅうはち年に「マシュマロデー」を始めました。",
      "start_ms": 116499,
      "end_ms": 128498,
      "duration_ms": 11999,
      "clauses": [
        {
          "index": 0,
          "text": "そこで、",
          "start_ms": 116499,
          "end_ms": 117703,
          "duration_ms": 1204
        },
        {
          "index": 1,
          "text": "ふくおかしのおかしのみせ、",
          "start_ms": 117953,
          "end_ms": 120504,
          "duration_ms": 2551
        },
        {
          "index": 2,
          "text": "いしむらまんせいどうが、",
          "start_ms": 120754,
          "end_ms": 123143,
          "duration_ms": 2389
        },
        {
          "index": 3,
          "text": "せんきゅうひゃくななじゅうはち年に「マシュマロデー」を始めました。",
          "start_ms": 123393,
          "end_ms": 128498,
          "duration_ms": 5105
        }
      ]
    },
    {
      "index": 14,
      "text": "そして、「おかえしにマシュマロをあげましょう」と言いました。",
      "start_ms": 128998,
      "end_ms": 134339,
      "duration_ms": 5341,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 128998,
          "end_ms": 130319,
          "duration_ms": 1321
        },
        {
          "index": 1,
          "text": "「おかえしにマシュマロをあげましょう」と言いました。",
          "start_ms": 130569,
          "end_ms": 134339,
          "duration_ms": 3770
        }
      ]
    },
    {
      "index": 15,
      "text": "その後も、いちねんに一回、あたらしいこうこくやしゃしんを作りました。",
      "start_ms": 134839,
      "end_ms": 143086,
      "duration_ms": 8247,
      "clauses": [
        {
          "index": 0,
          "text": "その後も、",
          "start_ms": 134839,
          "end_ms": 136636,
          "duration_ms": 1797
        },
        {
          "index": 1,
          "text": "いちねんに一回、",
          "start_ms": 136886,
          "end_ms": 138926,
          "duration_ms": 2040
        },
        {
          "index": 2,
          "text": "あたらしいこうこくやしゃしんを作りました。",
          "start_ms": 139176,
          "end_ms": 143086,
          "duration_ms": 3910
        }
      ]
    },
    {
      "index": 16,
      "text": "「マシュマロデー」が「ホワイトデー」というなまえになったときも、みせは「ホワイトデーはマシュマロデー」と言って、「おかえしにマシュマロをあげましょう」と言いました。",
      "start_ms": 143586,
      "end_ms": 155734,
      "duration_ms": 12148,
      "clauses": [
        {
          "index": 0,
          "text": "「マシュマロデー」が「ホワイトデー」というなまえになったときも、",
          "start_ms": 143586,
          "end_ms": 147914,
          "duration_ms": 4328
        },
        {
          "index": 1,
          "text": "みせは「ホワイトデーはマシュマロデー」と言って、",
          "start_ms": 148164,
          "end_ms": 151853,
          "duration_ms": 3689
        },
        {
          "index": 2,
          "text": "「おかえしにマシュマロをあげましょう」と言いました。",
          "start_ms": 152103,
          "end_ms": 155734,
          "duration_ms": 3631
        }
      ]
    },
    {
      "index": 17,
      "text": "ながいれきしの中で作ったこうこくやしゃしんには、ふるいじだいのものもおおいです。",
      "start_ms": 156234,
      "end_ms": 163758,
      "duration_ms": 7524,
      "clauses": [
        {
          "index": 0,
          "text": "ながいれきしの中で作ったこうこくやしゃしんには、",
          "start_ms": 156234,
          "end_ms": 160550,
          "duration_ms": 4316
        },
        {
          "index": 1,
          "text": "ふるいじだいのものもおおいです。",
          "start_ms": 160800,
          "end_ms": 163758,
          "duration_ms": 2958
        }
      ]
    },
    {
      "index": 18,
      "text": "でも、とうきょうの「ぜんこくあめがしこうぎょうきょうどうくみあい」は、せんきゅうひゃくはちじゅう年に「ホワイトデー」というぎょうじを作りました。",
      "start_ms": 164258,
      "end_ms": 175906,
      "duration_ms": 11648,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 164258,
          "end_ms": 165195,
          "duration_ms": 937
        },
        {
          "index": 1,
          "text": "とうきょうの「ぜんこくあめがしこうぎょうきょうどうくみあい」は、",
          "start_ms": 165445,
          "end_ms": 170098,
          "duration_ms": 4653
        },
        {
          "index": 2,
          "text": "せんきゅうひゃくはちじゅう年に「ホワイトデー」というぎょうじを作りました。",
          "start_ms": 170348,
          "end_ms": 175906,
          "duration_ms": 5558
        }
      ]
    },
    {
      "index": 19,
      "text": "ただ、その前から、いろいろなみせやかいしゃが売っていたそうです。",
      "start_ms": 176406,
      "end_ms": 183885,
      "duration_ms": 7479,
      "clauses": [
        {
          "index": 0,
          "text": "ただ、",
          "start_ms": 176406,
          "end_ms": 177610,
          "duration_ms": 1204
        },
        {
          "index": 1,
          "text": "その前から、",
          "start_ms": 177860,
          "end_ms": 179540,
          "duration_ms": 1680
        },
        {
          "index": 2,
          "text": "いろいろなみせやかいしゃが売っていたそうです。",
          "start_ms": 179790,
          "end_ms": 183885,
          "duration_ms": 4095
        }
      ]
    },
    {
      "index": 20,
      "text": "だから、始まりにはいろいろな話があります。",
      "start_ms": 184385,
      "end_ms": 189633,
      "duration_ms": 5248,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 184385,
          "end_ms": 185578,
          "duration_ms": 1193
        },
        {
          "index": 1,
          "text": "始まりにはいろいろな話があります。",
          "start_ms": 185828,
          "end_ms": 189633,
          "duration_ms": 3805
        }
      ]
    },
    {
      "index": 21,
      "text": "てんぷるだいがくにほんこうのほりぐち先生は、ホワイトデーもおかしのかいしゃが作ったぶんかだと言っています。",
      "start_ms": 190133,
      "end_ms": 199258,
      "duration_ms": 9125,
      "clauses": [
        {
          "index": 0,
          "text": "てんぷるだいがくにほんこうのほりぐち先生は、",
          "start_ms": 190133,
          "end_ms": 194135,
          "duration_ms": 4002
        },
        {
          "index": 1,
          "text": "ホワイトデーもおかしのかいしゃが作ったぶんかだと言っています。",
          "start_ms": 194385,
          "end_ms": 199258,
          "duration_ms": 4873
        }
      ]
    },
    {
      "index": 22,
      "text": "ホワイトデーは日本のぶんかで、かんこくやちゅうごく、たいわんなどでもぎょうじになっています。",
      "start_ms": 199758,
      "end_ms": 209096,
      "duration_ms": 9338,
      "clauses": [
        {
          "index": 0,
          "text": "ホワイトデーは日本のぶんかで、",
          "start_ms": 199758,
          "end_ms": 202959,
          "duration_ms": 3201
        },
        {
          "index": 1,
          "text": "かんこくやちゅうごく、",
          "start_ms": 203209,
          "end_ms": 205412,
          "duration_ms": 2203
        },
        {
          "index": 2,
          "text": "たいわんなどでもぎょうじになっています。",
          "start_ms": 205662,
          "end_ms": 209096,
          "duration_ms": 3434
        }
      ]
    },
    {
      "index": 23,
      "text": "でも、アメリカやヨーロッパでは、あまりありません。",
      "start_ms": 209596,
      "end_ms": 215636,
      "duration_ms": 6040,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 209596,
          "end_ms": 210580,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "アメリカやヨーロッパでは、",
          "start_ms": 210830,
          "end_ms": 213439,
          "duration_ms": 2609
        },
        {
          "index": 2,
          "text": "あまりありません。",
          "start_ms": 213689,
          "end_ms": 215636,
          "duration_ms": 1947
        }
      ]
    },
    {
      "index": 24,
      "text": "バレンタインデーが日本でゆうめいになって、かいしゃではたらく女の人が、かいしゃの男の人にチョコレートをあげることも多くなりました。",
      "start_ms": 216136,
      "end_ms": 228145,
      "duration_ms": 12009,
      "clauses": [
        {
          "index": 0,
          "text": "バレンタインデーが日本でゆうめいになって、",
          "start_ms": 216136,
          "end_ms": 219570,
          "duration_ms": 3434
        },
        {
          "index": 1,
          "text": "かいしゃではたらく女の人が、",
          "start_ms": 219820,
          "end_ms": 222859,
          "duration_ms": 3039
        },
        {
          "index": 2,
          "text": "かいしゃの男の人にチョコレートをあげることも多くなりました。",
          "start_ms": 223109,
          "end_ms": 228145,
          "duration_ms": 5036
        }
      ]
    },
    {
      "index": 25,
      "text": "これを「ぎりちょこ」と言います。",
      "start_ms": 228645,
      "end_ms": 231231,
      "duration_ms": 2586,
      "clauses": [
        {
          "index": 0,
          "text": "これを「ぎりちょこ」と言います。",
          "start_ms": 228645,
          "end_ms": 231231,
          "duration_ms": 2586
        }
      ]
    },
    {
      "index": 26,
      "text": "ぎりちょこはせんきゅうひゃくはちじゅう年代に多くなりました。",
      "start_ms": 231731,
      "end_ms": 237080,
      "duration_ms": 5349,
      "clauses": [
        {
          "index": 0,
          "text": "ぎりちょこはせんきゅうひゃくはちじゅう年代に多くなりました。",
          "start_ms": 231731,
          "end_ms": 237080,
          "duration_ms": 5349
        }
      ]
    },
    {
      "index": 27,
      "text": "ホワイトデーも多くなったじだいです。",
      "start_ms": 237580,
      "end_ms": 241025,
      "duration_ms": 3445,
      "clauses": [
        {
          "index": 0,
          "text": "ホワイトデーも多くなったじだいです。",
          "start_ms": 237580,
          "end_ms": 241025,
          "duration_ms": 3445
        }
      ]
    },
    {
      "index": 28,
      "text": "ぎりちょこは、がいこくにはない日本のぶんかです。",
      "start_ms": 241525,
      "end_ms": 246680,
      "duration_ms": 5155,
      "clauses": [
        {
          "index": 0,
          "text": "ぎりちょこは、",
          "start_ms": 241525,
          "end_ms": 243136,
          "duration_ms": 1611
        },
        {
          "index": 1,
          "text": "がいこくにはない日本のぶんかです。",
          "start_ms": 243386,
          "end_ms": 246680,
          "duration_ms": 3294
        }
      ]
    },
    {
      "index": 29,
      "text": "にせんじゅうさん年には、「これはぎりちょこだと見てわかるチョコ」というこうこくのことばで、おかしを売るかいしゃもありました。",
      "start_ms": 247180,
      "end_ms": 257900,
      "duration_ms": 10720,
      "clauses": [
        {
          "index": 0,
          "text": "にせんじゅうさん年には、",
          "start_ms": 247180,
          "end_ms": 249511,
          "duration_ms": 2331
        },
        {
          "index": 1,
          "text": "「これはぎりちょこだと見てわかるチョコ」というこうこくのことばで、",
          "start_ms": 249761,
          "end_ms": 254704,
          "duration_ms": 4943
        },
        {
          "index": 2,
          "text": "おかしを売るかいしゃもありました。",
          "start_ms": 254954,
          "end_ms": 257900,
          "duration_ms": 2946
        }
      ]
    },
    {
      "index": 30,
      "text": "しかし、女の人にも、おかえしをする男の人にも、おかねとじかんがかかります。",
      "start_ms": 258400,
      "end_ms": 268390,
      "duration_ms": 9990,
      "clauses": [
        {
          "index": 0,
          "text": "しかし、",
          "start_ms": 258400,
          "end_ms": 259906,
          "duration_ms": 1506
        },
        {
          "index": 1,
          "text": "女の人にも、",
          "start_ms": 260156,
          "end_ms": 262103,
          "duration_ms": 1947
        },
        {
          "index": 2,
          "text": "おかえしをする男の人にも、",
          "start_ms": 262353,
          "end_ms": 265357,
          "duration_ms": 3004
        },
        {
          "index": 3,
          "text": "おかねとじかんがかかります。",
          "start_ms": 265607,
          "end_ms": 268390,
          "duration_ms": 2783
        }
      ]
    },
    {
      "index": 31,
      "text": "だから、せんきゅうひゃくきゅうじゅう年代には、もう「ぎりちょこをやめたい」と言う人もいました。",
      "start_ms": 268890,
      "end_ms": 277554,
      "duration_ms": 8664,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 268890,
          "end_ms": 270060,
          "duration_ms": 1170
        },
        {
          "index": 1,
          "text": "せんきゅうひゃくきゅうじゅう年代には、",
          "start_ms": 270310,
          "end_ms": 273418,
          "duration_ms": 3108
        },
        {
          "index": 2,
          "text": "もう「ぎりちょこをやめたい」と言う人もいました。",
          "start_ms": 273668,
          "end_ms": 277554,
          "duration_ms": 3886
        }
      ]
    },
    {
      "index": 32,
      "text": "あるかいしゃは、ぎりちょこをやめました。",
      "start_ms": 278054,
      "end_ms": 282536,
      "duration_ms": 4482,
      "clauses": [
        {
          "index": 0,
          "text": "あるかいしゃは、",
          "start_ms": 278054,
          "end_ms": 279851,
          "duration_ms": 1797
        },
        {
          "index": 1,
          "text": "ぎりちょこをやめました。",
          "start_ms": 280101,
          "end_ms": 282536,
          "duration_ms": 2435
        }
      ]
    },
    {
      "index": 33,
      "text": "そして、かいしゃの人から、500円を出してもいい人から集めて、にしあふりかのおとこのこやおんなのこに送りました。",
      "start_ms": 283036,
      "end_ms": 295128,
      "duration_ms": 12092,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 283036,
          "end_ms": 284438,
          "duration_ms": 1402
        },
        {
          "index": 1,
          "text": "かいしゃの人から、",
          "start_ms": 284688,
          "end_ms": 286670,
          "duration_ms": 1982
        },
        {
          "index": 2,
          "text": "500円を出してもいい人から集めて、",
          "start_ms": 286920,
          "end_ms": 290388,
          "duration_ms": 3468
        },
        {
          "index": 3,
          "text": "にしあふりかのおとこのこやおんなのこに送りました。",
          "start_ms": 290638,
          "end_ms": 295128,
          "duration_ms": 4490
        }
      ]
    },
    {
      "index": 34,
      "text": "にせんきゅう年には、マッチ・ドットコム ジャパンというかいしゃが、かいしゃの中でぎりちょこをあげることをやめました。",
      "start_ms": 295628,
      "end_ms": 306300,
      "duration_ms": 10672,
      "clauses": [
        {
          "index": 0,
          "text": "にせんきゅう年には、",
          "start_ms": 295628,
          "end_ms": 297819,
          "duration_ms": 2191
        },
        {
          "index": 1,
          "text": "マッチ・ドットコム ジャパンというかいしゃが、",
          "start_ms": 298069,
          "end_ms": 301630,
          "duration_ms": 3561
        },
        {
          "index": 2,
          "text": "かいしゃの中でぎりちょこをあげることをやめました。",
          "start_ms": 301880,
          "end_ms": 306300,
          "duration_ms": 4420
        }
      ]
    },
    {
      "index": 35,
      "text": "そしてにせんじゅうはち年、チョコレートのかいしゃのゴディバが、しんぶんに「日本は、ぎりちょこをやめよう」というこうこくを出しました。",
      "start_ms": 306800,
      "end_ms": 319648,
      "duration_ms": 12848,
      "clauses": [
        {
          "index": 0,
          "text": "そしてにせんじゅうはち年、",
          "start_ms": 306800,
          "end_ms": 309700,
          "duration_ms": 2900
        },
        {
          "index": 1,
          "text": "チョコレートのかいしゃのゴディバが、",
          "start_ms": 309950,
          "end_ms": 312931,
          "duration_ms": 2981
        },
        {
          "index": 2,
          "text": "しんぶんに「日本は、",
          "start_ms": 313181,
          "end_ms": 315407,
          "duration_ms": 2226
        },
        {
          "index": 3,
          "text": "ぎりちょこをやめよう」というこうこくを出しました。",
          "start_ms": 315657,
          "end_ms": 319648,
          "duration_ms": 3991
        }
      ]
    },
    {
      "index": 36,
      "text": "多くの人がこのこうこくの話をしました。",
      "start_ms": 320148,
      "end_ms": 324893,
      "duration_ms": 4745,
      "clauses": [
        {
          "index": 0,
          "text": "多くの人がこのこうこくの話をしました。",
          "start_ms": 320148,
          "end_ms": 324893,
          "duration_ms": 4745
        }
      ]
    },
    {
      "index": 37,
      "text": "ゴディバジャパンのしゃちょうは、バレンタインデーはチョコレートをもらう人の日ではなく、あげる人の日だと言っています。",
      "start_ms": 325393,
      "end_ms": 335961,
      "duration_ms": 10568,
      "clauses": [
        {
          "index": 0,
          "text": "ゴディバジャパンのしゃちょうは、",
          "start_ms": 325393,
          "end_ms": 328037,
          "duration_ms": 2644
        },
        {
          "index": 1,
          "text": "バレンタインデーはチョコレートをもらう人の日ではなく、",
          "start_ms": 328287,
          "end_ms": 332777,
          "duration_ms": 4490
        },
        {
          "index": 2,
          "text": "あげる人の日だと言っています。",
          "start_ms": 333027,
          "end_ms": 335961,
          "duration_ms": 2934
        }
      ]
    },
    {
      "index": 38,
      "text": "そして、ぎりちょこをあげたくない人がいるなら、やめたほうがいいと説明しています。",
      "start_ms": 336461,
      "end_ms": 345230,
      "duration_ms": 8769,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 336461,
          "end_ms": 337805,
          "duration_ms": 1344
        },
        {
          "index": 1,
          "text": "ぎりちょこをあげたくない人がいるなら、",
          "start_ms": 338055,
          "end_ms": 341291,
          "duration_ms": 3236
        },
        {
          "index": 2,
          "text": "やめたほうがいいと説明しています。",
          "start_ms": 341541,
          "end_ms": 345230,
          "duration_ms": 3689
        }
      ]
    }
  ]
}