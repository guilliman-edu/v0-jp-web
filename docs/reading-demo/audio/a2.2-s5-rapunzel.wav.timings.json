      "clauses": [
        {
          "index": 0,
          "text": "「おばさん、",
          "start_ms": 400046,
          "end_ms": 401308,
          "duration_ms": 1262
        },
        {
          "index": 1,
          "text": "あなたはおもいです。",
          "start_ms": 401558,
          "end_ms": 403773,
          "duration_ms": 2215
        }
      ]
    },
    {
      "index": 82,
      "text": "だから、うえにのぼるとき、かみがすごくおもかったです」。",
      "start_ms": 404273,
      "end_ms": 410756,
      "duration_ms": 6483,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 404273,
          "end_ms": 405443,
          "duration_ms": 1170
        },
        {
          "index": 1,
          "text": "うえにのぼるとき、",
          "start_ms": 405693,
          "end_ms": 407699,
          "duration_ms": 2006
        },
        {
          "index": 2,
          "text": "かみがすごくおもかったです」。",
          "start_ms": 407949,
          "end_ms": 410756,
          "duration_ms": 2807
        }
      ]
    },
    {
      "index": 83,
      "text": "まじょは「あなたはおうじとはなしたのでしょう。",
      "start_ms": 411256,
      "end_ms": 415270,
      "duration_ms": 4014,
      "clauses": [
        {
          "index": 0,
          "text": "まじょは「あなたはおうじとはなしたのでしょう。",
          "start_ms": 411256,
          "end_ms": 415270,
          "duration_ms": 4014
        }
      ]
    },
    {
      "index": 84,
      "text": "わるいこですね」とおこりました。",
      "start_ms": 415770,
      "end_ms": 418670,
      "duration_ms": 2900,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこですね」とおこりました。",
          "start_ms": 415770,
          "end_ms": 418670,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 85,
      "text": "まじょはラプンツェルのながいかみをきりました。",
      "start_ms": 419170,
      "end_ms": 423033,
      "duration_ms": 3863,
      "clauses": [
        {
          "index": 0,
          "text": "まじょはラプンツェルのながいかみをきりました。",
          "start_ms": 419170,
          "end_ms": 423033,
          "duration_ms": 3863
        }
      ]
    },
    {
      "index": 86,
      "text": "そして、ラプンツェルをとおいやまにつれていきました。",
      "start_ms": 423533,
      "end_ms": 428804,
      "duration_ms": 5271,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 423533,
          "end_ms": 424865,
          "duration_ms": 1332
        },
        {
          "index": 1,
          "text": "ラプンツェルをとおいやまにつれていきました。",
          "start_ms": 425115,
          "end_ms": 428804,
          "duration_ms": 3689
        }
      ]
    },
    {
      "index": 87,
      "text": "ラプンツェルはそこでひとりでせいかつしました。",
      "start_ms": 429304,
      "end_ms": 433388,
      "duration_ms": 4084,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはそこでひとりでせいかつしました。",
          "start_ms": 429304,
          "end_ms": 433388,
          "duration_ms": 4084
        }
      ]
    },
    {
      "index": 88,
      "text": "すごくかなしかったです。",
      "start_ms": 433888,
      "end_ms": 436335,
      "duration_ms": 2447,
      "clauses": [
        {
          "index": 0,
          "text": "すごくかなしかったです。",
          "start_ms": 433888,
          "end_ms": 436335,
          "duration_ms": 2447
        }
      ]
    },
    {
      "index": 89,
      "text": "そのひ、まじょはきったかみをまどのそばにおくきました。",
      "start_ms": 436835,
      "end_ms": 442652,
      "duration_ms": 5817,
      "clauses": [
        {
          "index": 0,
          "text": "そのひ、",
          "start_ms": 436835,
          "end_ms": 438260,
          "duration_ms": 1425
        },
        {
          "index": 1,
          "text": "まじょはきったかみをまどのそばにおくきました。",
          "start_ms": 438510,
          "end_ms": 442652,
          "duration_ms": 4142
        }
      ]
    },
    {
      "index": 90,
      "text": "よる、おうじがきました。",
      "start_ms": 443152,
      "end_ms": 446392,
      "duration_ms": 3240,
      "clauses": [
        {
          "index": 0,
          "text": "よる、",
          "start_ms": 443152,
          "end_ms": 444078,
          "duration_ms": 926
        },
        {
          "index": 1,
          "text": "おうじがきました。",
          "start_ms": 444328,
          "end_ms": 446392,
          "duration_ms": 2064
        }
      ]
    },
    {
      "index": 91,
      "text": "「ラプンツェル、かみをおろしてください」といいました。",
      "start_ms": 446892,
      "end_ms": 452024,
      "duration_ms": 5132,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 446892,
          "end_ms": 448607,
          "duration_ms": 1715
        },
        {
          "index": 1,
          "text": "かみをおろしてください」といいました。",
          "start_ms": 448857,
          "end_ms": 452024,
          "duration_ms": 3167
        }
      ]
    },
    {
      "index": 92,
      "text": "かみをおろしたので、おうじはうえにのぼりました。",
      "start_ms": 452524,
      "end_ms": 457958,
      "duration_ms": 5434,
      "clauses": [
        {
          "index": 0,
          "text": "かみをおろしたので、",
          "start_ms": 452524,
          "end_ms": 454669,
          "duration_ms": 2145
        },
        {
          "index": 1,
          "text": "おうじはうえにのぼりました。",
          "start_ms": 454919,
          "end_ms": 457958,
          "duration_ms": 3039
        }
      ]
    },
    {
      "index": 93,
      "text": "でも、そこにはまじょがいました。",
      "start_ms": 458458,
      "end_ms": 462592,
      "duration_ms": 4134,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 458458,
          "end_ms": 459477,
          "duration_ms": 1019
        },
        {
          "index": 1,
          "text": "そこにはまじょがいました。",
          "start_ms": 459727,
          "end_ms": 462592,
          "duration_ms": 2865
        }
      ]
    },
    {
      "index": 94,
      "text": "「もうラプンツェルはここにいません。",
      "start_ms": 463092,
      "end_ms": 466189,
      "duration_ms": 3097,
      "clauses": [
        {
          "index": 0,
          "text": "「もうラプンツェルはここにいません。",
          "start_ms": 463092,
          "end_ms": 466189,
          "duration_ms": 3097
        }
      ]
    },
    {
      "index": 95,
      "text": "あなたはもうラプンツェルにあいません」といいました。",
      "start_ms": 466689,
      "end_ms": 470645,
      "duration_ms": 3956,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうラプンツェルにあいません」といいました。",
          "start_ms": 466689,
          "end_ms": 470645,
          "duration_ms": 3956
        }
      ]
    },
    {
      "index": 96,
      "text": "おうじはすごくかなしくて、とうのうえからおちました。",
      "start_ms": 471145,
      "end_ms": 476765,
      "duration_ms": 5620,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはすごくかなしくて、",
          "start_ms": 471145,
          "end_ms": 473894,
          "duration_ms": 2749
        },
        {
          "index": 1,
          "text": "とうのうえからおちました。",
          "start_ms": 474144,
          "end_ms": 476765,
          "duration_ms": 2621
        }
      ]
    },
    {
      "index": 97,
      "text": "おうじはたすかりました。",
      "start_ms": 477265,
      "end_ms": 479793,
      "duration_ms": 2528,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはたすかりました。",
          "start_ms": 477265,
          "end_ms": 479793,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 98,
      "text": "でも、おうじのめは、もうなにもみることができなくなりました。",
      "start_ms": 480293,
      "end_ms": 487077,
      "duration_ms": 6784,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 480293,
          "end_ms": 481300,
          "duration_ms": 1007
        },
        {
          "index": 1,
          "text": "おうじのめは、",
          "start_ms": 481550,
          "end_ms": 483277,
          "duration_ms": 1727
        },
        {
          "index": 2,
          "text": "もうなにもみることができなくなりました。",
          "start_ms": 483527,
          "end_ms": 487077,
          "duration_ms": 3550
        }
      ]
    },
    {
      "index": 99,
      "text": "おうじはまいにち、やまのなかをあるきました。",
      "start_ms": 487577,
      "end_ms": 492836,
      "duration_ms": 5259,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはまいにち、",
          "start_ms": 487577,
          "end_ms": 489733,
          "duration_ms": 2156
        },
        {
          "index": 1,
          "text": "やまのなかをあるきました。",
          "start_ms": 489983,
          "end_ms": 492836,
          "duration_ms": 2853
        }
      ]
    },
    {
      "index": 100,
      "text": "ラプンツェルのことを、いつもおもいでしていました。",
      "start_ms": 493336,
      "end_ms": 498398,
      "duration_ms": 5062,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルのことを、",
          "start_ms": 493336,
          "end_ms": 495504,
          "duration_ms": 2168
        },
        {
          "index": 1,
          "text": "いつもおもいでしていました。",
          "start_ms": 495754,
          "end_ms": 498398,
          "duration_ms": 2644
        }
      ]
    },
    {
      "index": 101,
      "text": "ながいじかんがたちました。",
      "start_ms": 498898,
      "end_ms": 501461,
      "duration_ms": 2563,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんがたちました。",
          "start_ms": 498898,
          "end_ms": 501461,
          "duration_ms": 2563
        }
      ]
    },
    {
      "index": 102,
      "text": "あるひ、おうじはとおいやまでうたがきこえました。",
      "start_ms": 501961,
      "end_ms": 507278,
      "duration_ms": 5317,
      "clauses": [
        {
          "index": 0,
          "text": "あるひ、",
          "start_ms": 501961,
          "end_ms": 503316,
          "duration_ms": 1355
        },
        {
          "index": 1,
          "text": "おうじはとおいやまでうたがきこえました。",
          "start_ms": 503566,
          "end_ms": 507278,
          "duration_ms": 3712
        }
      ]
    },
    {
      "index": 103,
      "text": "それはラプンツェルのうたでした。",
      "start_ms": 507778,
      "end_ms": 511014,
      "duration_ms": 3236,
      "clauses": [
        {
          "index": 0,
          "text": "それはラプンツェルのうたでした。",
          "start_ms": 507778,
          "end_ms": 511014,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 104,
      "text": "おうじはうたのばしょにいきました。",
      "start_ms": 511514,
      "end_ms": 514924,
      "duration_ms": 3410,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはうたのばしょにいきました。",
          "start_ms": 511514,
          "end_ms": 514924,
          "duration_ms": 3410
        }
      ]
    },
    {
      "index": 105,
      "text": "ラプンツェルには、おとこのことおんなのこのあかちゃんがいました。",
      "start_ms": 515424,
      "end_ms": 521717,
      "duration_ms": 6293,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルには、",
          "start_ms": 515424,
          "end_ms": 517418,
          "duration_ms": 1994
        },
        {
          "index": 1,
          "text": "おとこのことおんなのこのあかちゃんがいました。",
          "start_ms": 517668,
          "end_ms": 521717,
          "duration_ms": 4049
        }
      ]
    },
    {
      "index": 106,
      "text": "ラプンツェルはおうじのなまえをいいました。",
      "start_ms": 522217,
      "end_ms": 526080,
      "duration_ms": 3863,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはおうじのなまえをいいました。",
          "start_ms": 522217,
          "end_ms": 526080,
          "duration_ms": 3863
        }
      ]
    },
    {
      "index": 107,
      "text": "ラプンツェルがおうじのかおにさわったとき、おうじのめはなおりました。",
      "start_ms": 526580,
      "end_ms": 533361,
      "duration_ms": 6781,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルがおうじのかおにさわったとき、",
          "start_ms": 526580,
          "end_ms": 530548,
          "duration_ms": 3968
        },
        {
          "index": 1,
          "text": "おうじのめはなおりました。",
          "start_ms": 530798,
          "end_ms": 533361,
          "duration_ms": 2563
        }
      ]
    },
    {
      "index": 108,
      "text": "ふたりはすごくうれしかったです。",
      "start_ms": 533861,
      "end_ms": 537028,
      "duration_ms": 3167,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはすごくうれしかったです。",
          "start_ms": 533861,
          "end_ms": 537028,
          "duration_ms": 3167
        }
      ]
    },
    {
      "index": 109,
      "text": "ふたりはおうじのくににかえりました。",
      "start_ms": 537528,
      "end_ms": 541089,
      "duration_ms": 3561,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはおうじのくににかえりました。",
          "start_ms": 537528,
          "end_ms": 541089,
          "duration_ms": 3561
        }
      ]
    },
    {
      "index": 110,
      "text": "ふたりはなかよく、すごくたのしくすみました。",
      "start_ms": 541589,
      "end_ms": 546802,
      "duration_ms": 5213,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなかよく、",
          "start_ms": 541589,
          "end_ms": 543745,
          "duration_ms": 2156
        },
        {
          "index": 1,
          "text": "すごくたのしくすみました。",
          "start_ms": 543995,
          "end_ms": 546802,
          "duration_ms": 2807
        }
      ]
    }
  ]
