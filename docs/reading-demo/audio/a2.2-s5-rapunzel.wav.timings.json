          "index": 0,
          "text": "「おばさん、",
          "start_ms": 400406,
          "end_ms": 401645,
          "duration_ms": 1239
        },
        {
          "index": 1,
          "text": "あなたはおもいです。",
          "start_ms": 401895,
          "end_ms": 404133,
          "duration_ms": 2238
        }
      ]
    },
    {
      "index": 82,
      "text": "だから、うえにのぼるとき、かみがすごくおもかったです」。",
      "start_ms": 404633,
      "end_ms": 411243,
      "duration_ms": 6610,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 404633,
          "end_ms": 405826,
          "duration_ms": 1193
        },
        {
          "index": 1,
          "text": "うえにのぼるとき、",
          "start_ms": 406076,
          "end_ms": 408163,
          "duration_ms": 2087
        },
        {
          "index": 2,
          "text": "かみがすごくおもかったです」。",
          "start_ms": 408413,
          "end_ms": 411243,
          "duration_ms": 2830
        }
      ]
    },
    {
      "index": 83,
      "text": "まじょは「あなたはおうじとはなしたのでしょう。",
      "start_ms": 411743,
      "end_ms": 415780,
      "duration_ms": 4037,
      "clauses": [
        {
          "index": 0,
          "text": "まじょは「あなたはおうじとはなしたのでしょう。",
          "start_ms": 411743,
          "end_ms": 415780,
          "duration_ms": 4037
        }
      ]
    },
    {
      "index": 84,
      "text": "わるいこですね」とおこりました。",
      "start_ms": 416280,
      "end_ms": 419156,
      "duration_ms": 2876,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこですね」とおこりました。",
          "start_ms": 416280,
          "end_ms": 419156,
          "duration_ms": 2876
        }
      ]
    },
    {
      "index": 85,
      "text": "まじょはラプンツェルのながいかみをきりました。",
      "start_ms": 419656,
      "end_ms": 423531,
      "duration_ms": 3875,
      "clauses": [
        {
          "index": 0,
          "text": "まじょはラプンツェルのながいかみをきりました。",
          "start_ms": 419656,
          "end_ms": 423531,
          "duration_ms": 3875
        }
      ]
    },
    {
      "index": 86,
      "text": "そして、ラプンツェルをとおいやまにつれていきました。",
      "start_ms": 424031,
      "end_ms": 429326,
      "duration_ms": 5295,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 424031,
          "end_ms": 425375,
          "duration_ms": 1344
        },
        {
          "index": 1,
          "text": "ラプンツェルをとおいやまにつれていきました。",
          "start_ms": 425625,
          "end_ms": 429326,
          "duration_ms": 3701
        }
      ]
    },
    {
      "index": 87,
      "text": "ラプンツェルはそこでひとりでせいかつしました。",
      "start_ms": 429826,
      "end_ms": 433886,
      "duration_ms": 4060,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはそこでひとりでせいかつしました。",
          "start_ms": 429826,
          "end_ms": 433886,
          "duration_ms": 4060
        }
      ]
    },
    {
      "index": 88,
      "text": "すごくかなしかったです。",
      "start_ms": 434386,
      "end_ms": 436926,
      "duration_ms": 2540,
      "clauses": [
        {
          "index": 0,
          "text": "すごくかなしかったです。",
          "start_ms": 434386,
          "end_ms": 436926,
          "duration_ms": 2540
        }
      ]
    },
    {
      "index": 89,
      "text": "そのひ、まじょはきったかみをまどのそばにおくきました。",
      "start_ms": 437426,
      "end_ms": 443173,
      "duration_ms": 5747,
      "clauses": [
        {
          "index": 0,
          "text": "そのひ、",
          "start_ms": 437426,
          "end_ms": 438851,
          "duration_ms": 1425
        },
        {
          "index": 1,
          "text": "まじょはきったかみをまどのそばにおくきました。",
          "start_ms": 439101,
          "end_ms": 443173,
          "duration_ms": 4072
        }
      ]
    },
    {
      "index": 90,
      "text": "よる、おうじがきました。",
      "start_ms": 443673,
      "end_ms": 446912,
      "duration_ms": 3239,
      "clauses": [
        {
          "index": 0,
          "text": "よる、",
          "start_ms": 443673,
          "end_ms": 444587,
          "duration_ms": 914
        },
        {
          "index": 1,
          "text": "おうじがきました。",
          "start_ms": 444837,
          "end_ms": 446912,
          "duration_ms": 2075
        }
      ]
    },
    {
      "index": 91,
      "text": "「ラプンツェル、かみをおろしてください」といいました。",
      "start_ms": 447412,
      "end_ms": 452648,
      "duration_ms": 5236,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 447412,
          "end_ms": 449162,
          "duration_ms": 1750
        },
        {
          "index": 1,
          "text": "かみをおろしてください」といいました。",
          "start_ms": 449412,
          "end_ms": 452648,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 92,
      "text": "かみをおろしたので、おうじはうえにのぼりました。",
      "start_ms": 453148,
      "end_ms": 458604,
      "duration_ms": 5456,
      "clauses": [
        {
          "index": 0,
          "text": "かみをおろしたので、",
          "start_ms": 453148,
          "end_ms": 455304,
          "duration_ms": 2156
        },
        {
          "index": 1,
          "text": "おうじはうえにのぼりました。",
          "start_ms": 455554,
          "end_ms": 458604,
          "duration_ms": 3050
        }
      ]
    },
    {
      "index": 93,
      "text": "でも、そこにはまじょがいました。",
      "start_ms": 459104,
      "end_ms": 463226,
      "duration_ms": 4122,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 459104,
          "end_ms": 460111,
          "duration_ms": 1007
        },
        {
          "index": 1,
          "text": "そこにはまじょがいました。",
          "start_ms": 460361,
          "end_ms": 463226,
          "duration_ms": 2865
        }
      ]
    },
    {
      "index": 94,
      "text": "「もうラプンツェルはここにいません。",
      "start_ms": 463726,
      "end_ms": 466788,
      "duration_ms": 3062,
      "clauses": [
        {
          "index": 0,
          "text": "「もうラプンツェルはここにいません。",
          "start_ms": 463726,
          "end_ms": 466788,
          "duration_ms": 3062
        }
      ]
    },
    {
      "index": 95,
      "text": "あなたはもうラプンツェルにあいません」といいました。",
      "start_ms": 467288,
      "end_ms": 471383,
      "duration_ms": 4095,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうラプンツェルにあいません」といいました。",
          "start_ms": 467288,
          "end_ms": 471383,
          "duration_ms": 4095
        }
      ]
    },
    {
      "index": 96,
      "text": "おうじはすごくかなしくて、とうのうえからおちました。",
      "start_ms": 471883,
      "end_ms": 477491,
      "duration_ms": 5608,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはすごくかなしくて、",
          "start_ms": 471883,
          "end_ms": 474690,
          "duration_ms": 2807
        },
        {
          "index": 1,
          "text": "とうのうえからおちました。",
          "start_ms": 474940,
          "end_ms": 477491,
          "duration_ms": 2551
        }
      ]
    },
    {
      "index": 97,
      "text": "おうじはたすかりました。",
      "start_ms": 477991,
      "end_ms": 480554,
      "duration_ms": 2563,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはたすかりました。",
          "start_ms": 477991,
          "end_ms": 480554,
          "duration_ms": 2563
        }
      ]
    },
    {
      "index": 98,
      "text": "でも、おうじのめは、もうなにもみることができなくなりました。",
      "start_ms": 481054,
      "end_ms": 487814,
      "duration_ms": 6760,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 481054,
          "end_ms": 482038,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "おうじのめは、",
          "start_ms": 482288,
          "end_ms": 484038,
          "duration_ms": 1750
        },
        {
          "index": 2,
          "text": "もうなにもみることができなくなりました。",
          "start_ms": 484288,
          "end_ms": 487814,
          "duration_ms": 3526
        }
      ]
    },
    {
      "index": 99,
      "text": "おうじはまいにち、やまのなかをあるきました。",
      "start_ms": 488314,
      "end_ms": 493596,
      "duration_ms": 5282,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはまいにち、",
          "start_ms": 488314,
          "end_ms": 490505,
          "duration_ms": 2191
        },
        {
          "index": 1,
          "text": "やまのなかをあるきました。",
          "start_ms": 490755,
          "end_ms": 493596,
          "duration_ms": 2841
        }
      ]
    },
    {
      "index": 100,
      "text": "ラプンツェルのことを、いつもおもいでしていました。",
      "start_ms": 494096,
      "end_ms": 499239,
      "duration_ms": 5143,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルのことを、",
          "start_ms": 494096,
          "end_ms": 496322,
          "duration_ms": 2226
        },
        {
          "index": 1,
          "text": "いつもおもいでしていました。",
          "start_ms": 496572,
          "end_ms": 499239,
          "duration_ms": 2667
        }
      ]
    },
    {
      "index": 101,
      "text": "ながいじかんがたちました。",
      "start_ms": 499739,
      "end_ms": 502371,
      "duration_ms": 2632,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんがたちました。",
          "start_ms": 499739,
          "end_ms": 502371,
          "duration_ms": 2632
        }
      ]
    },
    {
      "index": 102,
      "text": "あるひ、おうじはとおいやまでうたがきこえました。",
      "start_ms": 502871,
      "end_ms": 508131,
      "duration_ms": 5260,
      "clauses": [
        {
          "index": 0,
          "text": "あるひ、",
          "start_ms": 502871,
          "end_ms": 504192,
          "duration_ms": 1321
        },
        {
          "index": 1,
          "text": "おうじはとおいやまでうたがきこえました。",
          "start_ms": 504442,
          "end_ms": 508131,
          "duration_ms": 3689
        }
      ]
    },
    {
      "index": 103,
      "text": "それはラプンツェルのうたでした。",
      "start_ms": 508631,
      "end_ms": 511681,
      "duration_ms": 3050,
      "clauses": [
        {
          "index": 0,
          "text": "それはラプンツェルのうたでした。",
          "start_ms": 508631,
          "end_ms": 511681,
          "duration_ms": 3050
        }
      ]
    },
    {
      "index": 104,
      "text": "おうじはうたのばしょにいきました。",
      "start_ms": 512181,
      "end_ms": 515557,
      "duration_ms": 3376,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはうたのばしょにいきました。",
          "start_ms": 512181,
          "end_ms": 515557,
          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 105,
      "text": "ラプンツェルには、おとこのことおんなのこのあかちゃんがいました。",
      "start_ms": 516057,
      "end_ms": 522222,
      "duration_ms": 6165,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルには、",
          "start_ms": 516057,
          "end_ms": 517981,
          "duration_ms": 1924
        },
        {
          "index": 1,
          "text": "おとこのことおんなのこのあかちゃんがいました。",
          "start_ms": 518231,
          "end_ms": 522222,
          "duration_ms": 3991
        }
      ]
    },
    {
      "index": 106,
      "text": "ラプンツェルはおうじのなまえをいいました。",
      "start_ms": 522722,
      "end_ms": 526608,
      "duration_ms": 3886,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはおうじのなまえをいいました。",
          "start_ms": 522722,
          "end_ms": 526608,
          "duration_ms": 3886
        }
      ]
    },
    {
      "index": 107,
      "text": "ラプンツェルがおうじのかおにさわったとき、おうじのめはなおりました。",
      "start_ms": 527108,
      "end_ms": 533725,
      "duration_ms": 6617,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルがおうじのかおにさわったとき、",
          "start_ms": 527108,
          "end_ms": 531052,
          "duration_ms": 3944
        },
        {
          "index": 1,
          "text": "おうじのめはなおりました。",
          "start_ms": 531302,
          "end_ms": 533725,
          "duration_ms": 2423
        }
      ]
    },
    {
      "index": 108,
      "text": "ふたりはすごくうれしかったです。",
      "start_ms": 534225,
      "end_ms": 537357,
      "duration_ms": 3132,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはすごくうれしかったです。",
          "start_ms": 534225,
          "end_ms": 537357,
          "duration_ms": 3132
        }
      ]
    },
    {
      "index": 109,
      "text": "ふたりはおうじのくににかえりました。",
      "start_ms": 537857,
      "end_ms": 541441,
      "duration_ms": 3584,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはおうじのくににかえりました。",
          "start_ms": 537857,
          "end_ms": 541441,
          "duration_ms": 3584
        }
      ]
    },
    {
      "index": 110,
      "text": "ふたりはなかよく、すごくたのしくすみました。",
      "start_ms": 541941,
      "end_ms": 547154,
      "duration_ms": 5213,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなかよく、",
          "start_ms": 541941,
          "end_ms": 544121,
          "duration_ms": 2180
        },
        {
          "index": 1,
          "text": "すごくたのしくすみました。",
          "start_ms": 544371,
          "end_ms": 547154,
          "duration_ms": 2783
        }
      ]
    }
  ]
}