      "end_ms": 406127,
      "duration_ms": 3727,
      "clauses": [
        {
          "index": 0,
          "text": "「おばさん、",
          "start_ms": 402400,
          "end_ms": 403628,
          "duration_ms": 1228
        },
        {
          "index": 1,
          "text": "あなたはおもいです。",
          "start_ms": 403878,
          "end_ms": 406127,
          "duration_ms": 2249
        }
      ]
    },
    {
      "index": 82,
      "text": "だから、うえにのぼるとき、かみがすごくおもかったです」。",
      "start_ms": 406627,
      "end_ms": 413132,
      "duration_ms": 6505,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 406627,
          "end_ms": 407785,
          "duration_ms": 1158
        },
        {
          "index": 1,
          "text": "うえにのぼるとき、",
          "start_ms": 408035,
          "end_ms": 410122,
          "duration_ms": 2087
        },
        {
          "index": 2,
          "text": "かみがすごくおもかったです」。",
          "start_ms": 410372,
          "end_ms": 413132,
          "duration_ms": 2760
        }
      ]
    },
    {
      "index": 83,
      "text": "まじょは「あなたはおうじとはなしたのでしょう。",
      "start_ms": 413632,
      "end_ms": 417623,
      "duration_ms": 3991,
      "clauses": [
        {
          "index": 0,
          "text": "まじょは「あなたはおうじとはなしたのでしょう。",
          "start_ms": 413632,
          "end_ms": 417623,
          "duration_ms": 3991
        }
      ]
    },
    {
      "index": 84,
      "text": "わるいこですね」とおこりました。",
      "start_ms": 418123,
      "end_ms": 421023,
      "duration_ms": 2900,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこですね」とおこりました。",
          "start_ms": 418123,
          "end_ms": 421023,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 85,
      "text": "まじょはラプンツェルのながいかみをきりました。",
      "start_ms": 421523,
      "end_ms": 425363,
      "duration_ms": 3840,
      "clauses": [
        {
          "index": 0,
          "text": "まじょはラプンツェルのながいかみをきりました。",
          "start_ms": 421523,
          "end_ms": 425363,
          "duration_ms": 3840
        }
      ]
    },
    {
      "index": 86,
      "text": "そして、ラプンツェルをとおいやまにつれていきました。",
      "start_ms": 425863,
      "end_ms": 431157,
      "duration_ms": 5294,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 425863,
          "end_ms": 427230,
          "duration_ms": 1367
        },
        {
          "index": 1,
          "text": "ラプンツェルをとおいやまにつれていきました。",
          "start_ms": 427480,
          "end_ms": 431157,
          "duration_ms": 3677
        }
      ]
    },
    {
      "index": 87,
      "text": "ラプンツェルはそこでひとりでせいかつしました。",
      "start_ms": 431657,
      "end_ms": 435706,
      "duration_ms": 4049,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはそこでひとりでせいかつしました。",
          "start_ms": 431657,
          "end_ms": 435706,
          "duration_ms": 4049
        }
      ]
    },
    {
      "index": 88,
      "text": "すごくかなしかったです。",
      "start_ms": 436206,
      "end_ms": 438722,
      "duration_ms": 2516,
      "clauses": [
        {
          "index": 0,
          "text": "すごくかなしかったです。",
          "start_ms": 436206,
          "end_ms": 438722,
          "duration_ms": 2516
        }
      ]
    },
    {
      "index": 89,
      "text": "そのひ、まじょはきったかみをまどのそばにおくきました。",
      "start_ms": 439222,
      "end_ms": 444922,
      "duration_ms": 5700,
      "clauses": [
        {
          "index": 0,
          "text": "そのひ、",
          "start_ms": 439222,
          "end_ms": 440635,
          "duration_ms": 1413
        },
        {
          "index": 1,
          "text": "まじょはきったかみをまどのそばにおくきました。",
          "start_ms": 440885,
          "end_ms": 444922,
          "duration_ms": 4037
        }
      ]
    },
    {
      "index": 90,
      "text": "よる、おうじがきました。",
      "start_ms": 445422,
      "end_ms": 448650,
      "duration_ms": 3228,
      "clauses": [
        {
          "index": 0,
          "text": "よる、",
          "start_ms": 445422,
          "end_ms": 446336,
          "duration_ms": 914
        },
        {
          "index": 1,
          "text": "おうじがきました。",
          "start_ms": 446586,
          "end_ms": 448650,
          "duration_ms": 2064
        }
      ]
    },
    {
      "index": 91,
      "text": "「ラプンツェル、かみをおろしてください」といいました。",
      "start_ms": 449150,
      "end_ms": 454282,
      "duration_ms": 5132,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 449150,
          "end_ms": 450877,
          "duration_ms": 1727
        },
        {
          "index": 1,
          "text": "かみをおろしてください」といいました。",
          "start_ms": 451127,
          "end_ms": 454282,
          "duration_ms": 3155
        }
      ]
    },
    {
      "index": 92,
      "text": "かみをおろしたので、おうじはうえにのぼりました。",
      "start_ms": 454782,
      "end_ms": 460204,
      "duration_ms": 5422,
      "clauses": [
        {
          "index": 0,
          "text": "かみをおろしたので、",
          "start_ms": 454782,
          "end_ms": 456927,
          "duration_ms": 2145
        },
        {
          "index": 1,
          "text": "おうじはうえにのぼりました。",
          "start_ms": 457177,
          "end_ms": 460204,
          "duration_ms": 3027
        }
      ]
    },
    {
      "index": 93,
      "text": "でも、そこにはまじょがいました。",
      "start_ms": 460704,
      "end_ms": 464710,
      "duration_ms": 4006,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 460704,
          "end_ms": 461711,
          "duration_ms": 1007
        },
        {
          "index": 1,
          "text": "そこにはまじょがいました。",
          "start_ms": 461961,
          "end_ms": 464710,
          "duration_ms": 2749
        }
      ]
    },
    {
      "index": 94,
      "text": "「もうラプンツェルはここにいません。",
      "start_ms": 465210,
      "end_ms": 468260,
      "duration_ms": 3050,
      "clauses": [
        {
          "index": 0,
          "text": "「もうラプンツェルはここにいません。",
          "start_ms": 465210,
          "end_ms": 468260,
          "duration_ms": 3050
        }
      ]
    },
    {
      "index": 95,
      "text": "あなたはもうラプンツェルにあいません」といいました。",
      "start_ms": 468760,
      "end_ms": 472774,
      "duration_ms": 4014,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうラプンツェルにあいません」といいました。",
          "start_ms": 468760,
          "end_ms": 472774,
          "duration_ms": 4014
        }
      ]
    },
    {
      "index": 96,
      "text": "おうじはすごくかなしくて、とうのうえからおちました。",
      "start_ms": 473274,
      "end_ms": 478881,
      "duration_ms": 5607,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはすごくかなしくて、",
          "start_ms": 473274,
          "end_ms": 476057,
          "duration_ms": 2783
        },
        {
          "index": 1,
          "text": "とうのうえからおちました。",
          "start_ms": 476307,
          "end_ms": 478881,
          "duration_ms": 2574
        }
      ]
    },
    {
      "index": 97,
      "text": "おうじはたすかりました。",
      "start_ms": 479381,
      "end_ms": 481979,
      "duration_ms": 2598,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはたすかりました。",
          "start_ms": 479381,
          "end_ms": 481979,
          "duration_ms": 2598
        }
      ]
    },
    {
      "index": 98,
      "text": "でも、おうじのめは、もうなにもみることができなくなりました。",
      "start_ms": 482479,
      "end_ms": 489228,
      "duration_ms": 6749,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 482479,
          "end_ms": 483463,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "おうじのめは、",
          "start_ms": 483713,
          "end_ms": 485463,
          "duration_ms": 1750
        },
        {
          "index": 2,
          "text": "もうなにもみることができなくなりました。",
          "start_ms": 485713,
          "end_ms": 489228,
          "duration_ms": 3515
        }
      ]
    },
    {
      "index": 99,
      "text": "おうじはまいにち、やまのなかをあるきました。",
      "start_ms": 489728,
      "end_ms": 494894,
      "duration_ms": 5166,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはまいにち、",
          "start_ms": 489728,
          "end_ms": 491861,
          "duration_ms": 2133
        },
        {
          "index": 1,
          "text": "やまのなかをあるきました。",
          "start_ms": 492111,
          "end_ms": 494894,
          "duration_ms": 2783
        }
      ]
    },
    {
      "index": 100,
      "text": "ラプンツェルのことを、いつもおもいでしていました。",
      "start_ms": 495394,
      "end_ms": 500537,
      "duration_ms": 5143,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルのことを、",
          "start_ms": 495394,
          "end_ms": 497655,
          "duration_ms": 2261
        },
        {
          "index": 1,
          "text": "いつもおもいでしていました。",
          "start_ms": 497905,
          "end_ms": 500537,
          "duration_ms": 2632
        }
      ]
    },
    {
      "index": 101,
      "text": "ながいじかんがたちました。",
      "start_ms": 501037,
      "end_ms": 503635,
      "duration_ms": 2598,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんがたちました。",
          "start_ms": 501037,
          "end_ms": 503635,
          "duration_ms": 2598
        }
      ]
    },
    {
      "index": 102,
      "text": "あるひ、おうじはとおいやまでうたがきこえました。",
      "start_ms": 504135,
      "end_ms": 509499,
      "duration_ms": 5364,
      "clauses": [
        {
          "index": 0,
          "text": "あるひ、",
          "start_ms": 504135,
          "end_ms": 505537,
          "duration_ms": 1402
        },
        {
          "index": 1,
          "text": "おうじはとおいやまでうたがきこえました。",
          "start_ms": 505787,
          "end_ms": 509499,
          "duration_ms": 3712
        }
      ]
    },
    {
      "index": 103,
      "text": "それはラプンツェルのうたでした。",
      "start_ms": 509999,
      "end_ms": 513177,
      "duration_ms": 3178,
      "clauses": [
        {
          "index": 0,
          "text": "それはラプンツェルのうたでした。",
          "start_ms": 509999,
          "end_ms": 513177,
          "duration_ms": 3178
        }
      ]
    },
    {
      "index": 104,
      "text": "おうじはうたのばしょにいきました。",
      "start_ms": 513677,
      "end_ms": 517018,
      "duration_ms": 3341,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはうたのばしょにいきました。",
          "start_ms": 513677,
          "end_ms": 517018,
          "duration_ms": 3341
        }
      ]
    },
    {
      "index": 105,
      "text": "ラプンツェルには、おとこのことおんなのこのあかちゃんがいました。",
      "start_ms": 517518,
      "end_ms": 523730,
      "duration_ms": 6212,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルには、",
          "start_ms": 517518,
          "end_ms": 519512,
          "duration_ms": 1994
        },
        {
          "index": 1,
          "text": "おとこのことおんなのこのあかちゃんがいました。",
          "start_ms": 519762,
          "end_ms": 523730,
          "duration_ms": 3968
        }
      ]
    },
    {
      "index": 106,
      "text": "ラプンツェルはおうじのなまえをいいました。",
      "start_ms": 524230,
      "end_ms": 528058,
      "duration_ms": 3828,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはおうじのなまえをいいました。",
          "start_ms": 524230,
          "end_ms": 528058,
          "duration_ms": 3828
        }
      ]
    },
    {
      "index": 107,
      "text": "ラプンツェルがおうじのかおにさわったとき、おうじのめはなおりました。",
      "start_ms": 528558,
      "end_ms": 535269,
      "duration_ms": 6711,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルがおうじのかおにさわったとき、",
          "start_ms": 528558,
          "end_ms": 532433,
          "duration_ms": 3875
        },
        {
          "index": 1,
          "text": "おうじのめはなおりました。",
          "start_ms": 532683,
          "end_ms": 535269,
          "duration_ms": 2586
        }
      ]
    },
    {
      "index": 108,
      "text": "ふたりはすごくうれしかったです。",
      "start_ms": 535769,
      "end_ms": 538912,
      "duration_ms": 3143,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはすごくうれしかったです。",
          "start_ms": 535769,
          "end_ms": 538912,
          "duration_ms": 3143
        }
      ]
    },
    {
      "index": 109,
      "text": "ふたりはおうじのくににかえりました。",
      "start_ms": 539412,
      "end_ms": 543055,
      "duration_ms": 3643,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはおうじのくににかえりました。",
          "start_ms": 539412,
          "end_ms": 543055,
          "duration_ms": 3643
        }
      ]
    },
    {
      "index": 110,
      "text": "ふたりはなかよく、すごくたのしくすみました。",
      "start_ms": 543555,
      "end_ms": 548675,
      "duration_ms": 5120,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなかよく、",
          "start_ms": 543555,
          "end_ms": 545607,
          "duration_ms": 2052
        },
        {
          "index": 1,
          "text": "すごくたのしくすみました。",
          "start_ms": 545857,
          "end_ms": 548675,
          "duration_ms": 2818
        }
      ]
    }
  ]
}