          "start_ms": 20319,
          "end_ms": 23608,
          "duration_ms": 3289
        }
      ]
    },
    {
      "index": 4,
      "text": "手で作ったのではなく、ほかのしゅだんで作られたと考えられているものもあります。",
      "start_ms": 24108,
      "end_ms": 31179,
      "duration_ms": 7071,
      "clauses": [
