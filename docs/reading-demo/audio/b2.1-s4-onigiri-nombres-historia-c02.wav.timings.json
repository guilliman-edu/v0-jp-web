          "end_ms": 31179,
          "duration_ms": 4589
        }
      ]
    },
    {
      "index": 5,
      "text": "そして、それを「むかしのおにぎりのしょうこ」と言っています。",
      "start_ms": 31679,
      "end_ms": 36997,
      "duration_ms": 5318,
      "clauses": [
