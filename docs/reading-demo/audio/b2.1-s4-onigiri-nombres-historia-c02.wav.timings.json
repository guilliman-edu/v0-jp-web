          "duration_ms": 1245
        },
        {
          "index": 1,
          "text": "それを「むかしのおにぎりのしょうこ」と言っています。",
          "start_ms": 33174,
          "end_ms": 36997,
          "duration_ms": 3823
        }
      ]
    },
    {
      "index": 6,
      "text": "このこめについては、人によって違う説明をしています。",
      "start_ms": 37497,
      "end_ms": 43059,
      "duration_ms": 5562,
      "clauses": [
        {
          "index": 0,
          "text": "このこめについては、",
          "start_ms": 37497,
          "end_ms": 39485,
          "duration_ms": 1988
        },
