          "duration_ms": 1977
        }
      ]
    },
    {
      "index": 2,
      "text": "にほんでこめを作るようになってから、人は作ったこめを手でまとめていたと考えられています。",
      "start_ms": 9338,
      "end_ms": 17465,
      "duration_ms": 8127,
      "clauses": [
        {
          "index": 0,
          "text": "にほんでこめを作るようになってから、",
