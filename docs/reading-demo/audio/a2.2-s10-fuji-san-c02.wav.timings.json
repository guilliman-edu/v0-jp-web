          "start_ms": 25584,
          "end_ms": 28704,
          "duration_ms": 3120
        }
      ]
    },
    {
      "index": 5,
      "text": "日本には、せんげんじんじゃがたくさんあります。",
      "start_ms": 29204,
      "end_ms": 34139,
      "duration_ms": 4935,
      "clauses": [
        {
          "index": 0,
          "text": "日本には、",
          "start_ms": 29204,
