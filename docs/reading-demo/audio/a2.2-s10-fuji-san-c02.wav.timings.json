          "end_ms": 19342,
          "duration_ms": 2458
        },
        {
          "index": 2,
          "text": "かみさまのたいせつなぎょうじでした。",
          "start_ms": 19592,
          "end_ms": 22805,
          "duration_ms": 3213
        }
      ]
    },
    {
      "index": 4,
      "text": "せんげんじんじゃは、ふじさんのかみさまのじんじゃです。",
      "start_ms": 23305,
      "end_ms": 28704,
      "duration_ms": 5399,
      "clauses": [
        {
