          "end_ms": 11873,
          "duration_ms": 1878
        },
        {
          "index": 1,
          "text": "せんげんじんじゃがあります。",
          "start_ms": 12123,
          "end_ms": 14651,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 3,
      "text": "むかしは、ふじさんにのぼることは、かみさまのたいせつなぎょうじでした。",
      "start_ms": 15151,
      "end_ms": 22805,
      "duration_ms": 7654,
      "clauses": [
        {
          "index": 0,
          "text": "むかしは、",
