          "start_ms": 4343,
          "end_ms": 9495,
          "duration_ms": 5152
        }
      ]
    },
    {
      "index": 2,
      "text": "やまの上には、せんげんじんじゃがあります。",
      "start_ms": 9995,
      "end_ms": 14651,
      "duration_ms": 4656,
      "clauses": [
        {
          "index": 0,
          "text": "やまの上には、",
