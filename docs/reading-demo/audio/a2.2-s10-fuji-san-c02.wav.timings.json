          "end_ms": 40026,
          "duration_ms": 3526
        }
      ]
    },
    {
      "index": 7,
      "text": "いまも、ふじさんは日本のれきしとぶんかのたいせつなばしょです。",
      "start_ms": 40526,
      "end_ms": 46656,
      "duration_ms": 6130,
      "clauses": [
