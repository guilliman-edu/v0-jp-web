{
  "audio_file": "b2.1-s11-reglas-mesa-japonesa-slow.wav",
  "sample_rate": 44100,
  "pause_ms": 500,
  "total_duration_ms": 370434,
  "sentences": [
    {
      "index": 0,
      "text": "日本食のマナーとして本当に大切なこと",
      "start_ms": 0,
      "end_ms": 4374,
      "duration_ms": 4374,
      "clauses": [
        {
          "index": 0,
          "text": "日本食のマナーとして本当に大切なこと",
          "start_ms": 0,
          "end_ms": 4374,
          "duration_ms": 4374
        }
      ]
    },
    {
      "index": 1,
      "text": "アメリカからの旅行者に「日本で何が心配ですか」と尋ねると、たいてい返ってくるのは言葉や電車のことではなく、食事の場で失礼をしてしまうのではないかという心配だ。",
      "start_ms": 4874,
      "end_ms": 21015,
      "duration_ms": 16141,
      "clauses": [
        {
          "index": 0,
          "text": "アメリカからの旅行者に「日本で何が心配ですか」と尋ねると、",
          "start_ms": 4874,
          "end_ms": 10734,
          "duration_ms": 5860
        },
        {
          "index": 1,
          "text": "たいてい返ってくるのは言葉や電車のことではなく、",
          "start_ms": 10984,
          "end_ms": 15799,
          "duration_ms": 4815
        },
        {
          "index": 2,
          "text": "食事の場で失礼をしてしまうのではないかという心配だ。",
          "start_ms": 16049,
          "end_ms": 21015,
          "duration_ms": 4966
        }
      ]
    },
    {
      "index": 2,
      "text": "座った人にとって、ほかの人の目は意外に気になるものである。",
      "start_ms": 21515,
      "end_ms": 28307,
      "duration_ms": 6792,
      "clauses": [
        {
          "index": 0,
          "text": "座った人にとって、",
          "start_ms": 21515,
          "end_ms": 23764,
          "duration_ms": 2249
        },
        {
          "index": 1,
          "text": "ほかの人の目は意外に気になるものである。",
          "start_ms": 24014,
          "end_ms": 28307,
          "duration_ms": 4293
        }
      ]
    },
    {
      "index": 3,
      "text": "ところが、インターネットに出回っている情報というのは、たいてい古いか、ひどく誇張されているということだ。",
      "start_ms": 28807,
      "end_ms": 40098,
      "duration_ms": 11291,
      "clauses": [
        {
          "index": 0,
          "text": "ところが、",
          "start_ms": 28807,
          "end_ms": 30290,
          "duration_ms": 1483
        },
        {
          "index": 1,
          "text": "インターネットに出回っている情報というのは、",
          "start_ms": 30540,
          "end_ms": 34368,
          "duration_ms": 3828
        },
        {
          "index": 2,
          "text": "たいてい古いか、",
          "start_ms": 34618,
          "end_ms": 36600,
          "duration_ms": 1982
        },
        {
          "index": 3,
          "text": "ひどく誇張されているということだ。",
          "start_ms": 36850,
          "end_ms": 40098,
          "duration_ms": 3248
        }
      ]
    },
    {
      "index": 4,
      "text": "日本の「おもてなし」の心は、客人が地元の習慣を知らないことを前提にしている。",
      "start_ms": 40598,
      "end_ms": 48969,
      "duration_ms": 8371,
      "clauses": [
        {
          "index": 0,
          "text": "日本の「おもてなし」の心は、",
          "start_ms": 40598,
          "end_ms": 43486,
          "duration_ms": 2888
        },
        {
          "index": 1,
          "text": "客人が地元の習慣を知らないことを前提にしている。",
          "start_ms": 43736,
          "end_ms": 48969,
          "duration_ms": 5233
        }
      ]
    },
    {
      "index": 5,
      "text": "それゆえ、観光客にそれほど完全なさほうを求めるわけではない。",
      "start_ms": 49469,
      "end_ms": 56586,
      "duration_ms": 7117,
      "clauses": [
        {
          "index": 0,
          "text": "それゆえ、",
          "start_ms": 49469,
          "end_ms": 51033,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "観光客にそれほど完全なさほうを求めるわけではない。",
          "start_ms": 51283,
          "end_ms": 56586,
          "duration_ms": 5303
        }
      ]
    },
    {
      "index": 6,
      "text": "ただ、本当に大切なことがいくつかある。",
      "start_ms": 57086,
      "end_ms": 62125,
      "duration_ms": 5039,
      "clauses": [
        {
          "index": 0,
          "text": "ただ、",
          "start_ms": 57086,
          "end_ms": 58186,
          "duration_ms": 1100
        },
        {
          "index": 1,
          "text": "本当に大切なことがいくつかある。",
          "start_ms": 58436,
          "end_ms": 62125,
          "duration_ms": 3689
        }
      ]
    },
    {
      "index": 7,
      "text": "それを知っていることは、不安を抱えて食べることと、心から美味しく食べることを分ける。",
      "start_ms": 62625,
      "end_ms": 72044,
      "duration_ms": 9419,
      "clauses": [
        {
          "index": 0,
          "text": "それを知っていることは、",
          "start_ms": 62625,
          "end_ms": 64944,
          "duration_ms": 2319
        },
        {
          "index": 1,
          "text": "不安を抱えて食べることと、",
          "start_ms": 65194,
          "end_ms": 68070,
          "duration_ms": 2876
        },
        {
          "index": 2,
          "text": "心から美味しく食べることを分ける。",
          "start_ms": 68320,
          "end_ms": 72044,
          "duration_ms": 3724
        }
      ]
    },
    {
      "index": 8,
      "text": "まず、はしのマナーは二つだけだ。",
      "start_ms": 72544,
      "end_ms": 76480,
      "duration_ms": 3936,
      "clauses": [
        {
          "index": 0,
          "text": "まず、",
          "start_ms": 72544,
          "end_ms": 73458,
          "duration_ms": 914
        },
        {
          "index": 1,
          "text": "はしのマナーは二つだけだ。",
          "start_ms": 73708,
          "end_ms": 76480,
          "duration_ms": 2772
        }
      ]
    },
    {
      "index": 9,
      "text": "はしをごはんに突き刺さないこと、そしてはしからはしへと食べ物を直接受け渡ししないことだ。",
      "start_ms": 76980,
      "end_ms": 85897,
      "duration_ms": 8917,
      "clauses": [
        {
          "index": 0,
          "text": "はしをごはんに突き刺さないこと、",
          "start_ms": 76980,
          "end_ms": 80135,
          "duration_ms": 3155
        },
        {
          "index": 1,
          "text": "そしてはしからはしへと食べ物を直接受け渡ししないことだ。",
          "start_ms": 80385,
          "end_ms": 85897,
          "duration_ms": 5512
        }
      ]
    },
    {
      "index": 10,
      "text": "どちらも死者の儀式を連想させるせいで、周りの人はとても嫌がる。",
      "start_ms": 86397,
      "end_ms": 94037,
      "duration_ms": 7640,
      "clauses": [
        {
          "index": 0,
          "text": "どちらも死者の儀式を連想させるせいで、",
          "start_ms": 86397,
          "end_ms": 90620,
          "duration_ms": 4223
        },
        {
          "index": 1,
          "text": "周りの人はとても嫌がる。",
          "start_ms": 90870,
          "end_ms": 94037,
          "duration_ms": 3167
        }
      ]
    },
    {
      "index": 11,
      "text": "それ以外のことであれば、持ち方、はしを置く場所、少しくらいぎこちなく使ってしまうことなどは、誰も気にしない。",
      "start_ms": 94537,
      "end_ms": 107666,
      "duration_ms": 13129,
      "clauses": [
        {
          "index": 0,
          "text": "それ以外のことであれば、",
          "start_ms": 94537,
          "end_ms": 97019,
          "duration_ms": 2482
        },
        {
          "index": 1,
          "text": "持ち方、",
          "start_ms": 97269,
          "end_ms": 98810,
          "duration_ms": 1541
        },
        {
          "index": 2,
          "text": "はしを置く場所、",
          "start_ms": 99060,
          "end_ms": 101054,
          "duration_ms": 1994
        },
        {
          "index": 3,
          "text": "少しくらいぎこちなく使ってしまうことなどは、",
          "start_ms": 101304,
          "end_ms": 105399,
          "duration_ms": 4095
        },
        {
          "index": 4,
          "text": "誰も気にしない。",
          "start_ms": 105649,
          "end_ms": 107666,
          "duration_ms": 2017
        }
      ]
    },
    {
      "index": 12,
      "text": "次に、カウンターでは、出されたらすぐに食べたいものだ。",
      "start_ms": 108166,
      "end_ms": 115228,
      "duration_ms": 7062,
      "clauses": [
        {
          "index": 0,
          "text": "次に、",
          "start_ms": 108166,
          "end_ms": 109579,
          "duration_ms": 1413
        },
        {
          "index": 1,
          "text": "カウンターでは、",
          "start_ms": 109829,
          "end_ms": 111568,
          "duration_ms": 1739
        },
        {
          "index": 2,
          "text": "出されたらすぐに食べたいものだ。",
          "start_ms": 111818,
          "end_ms": 115228,
          "duration_ms": 3410
        }
      ]
    },
    {
      "index": 13,
      "text": "目の前にお寿司が一貫置かれたとき、職人はしゃりとネタの温度をその瞬間に合わせている。",
      "start_ms": 115728,
      "end_ms": 124947,
      "duration_ms": 9219,
      "clauses": [
        {
          "index": 0,
          "text": "目の前にお寿司が一貫置かれたとき、",
          "start_ms": 115728,
          "end_ms": 119510,
          "duration_ms": 3782
        },
        {
          "index": 1,
          "text": "職人はしゃりとネタの温度をその瞬間に合わせている。",
          "start_ms": 119760,
          "end_ms": 124947,
          "duration_ms": 5187
        }
      ]
    },
    {
      "index": 14,
      "text": "最初の一分間も写真を撮っていると、せっかく支払ったのにその経験を楽しめなくなってしまう。",
      "start_ms": 125447,
      "end_ms": 134886,
      "duration_ms": 9439,
      "clauses": [
        {
          "index": 0,
          "text": "最初の一分間も写真を撮っていると、",
          "start_ms": 125447,
          "end_ms": 129252,
          "duration_ms": 3805
        },
        {
          "index": 1,
          "text": "せっかく支払ったのにその経験を楽しめなくなってしまう。",
          "start_ms": 129502,
          "end_ms": 134886,
          "duration_ms": 5384
        }
      ]
    },
    {
      "index": 15,
      "text": "写真は二秒で済ませるか、あきらめるのが良い。",
      "start_ms": 135386,
      "end_ms": 140913,
      "duration_ms": 5527,
      "clauses": [
        {
          "index": 0,
          "text": "写真は二秒で済ませるか、",
          "start_ms": 135386,
          "end_ms": 138460,
          "duration_ms": 3074
        },
        {
          "index": 1,
          "text": "あきらめるのが良い。",
          "start_ms": 138710,
          "end_ms": 140913,
          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 16,
      "text": "もし職人を撮りたい場合には、事前に声をかけてほしい。",
      "start_ms": 141413,
      "end_ms": 147520,
      "duration_ms": 6107,
      "clauses": [
        {
          "index": 0,
          "text": "もし職人を撮りたい場合には、",
          "start_ms": 141413,
          "end_ms": 144487,
          "duration_ms": 3074
        },
        {
          "index": 1,
          "text": "事前に声をかけてほしい。",
          "start_ms": 144737,
          "end_ms": 147520,
          "duration_ms": 2783
        }
      ]
    },
    {
      "index": 17,
      "text": "そして、こうすいは控えめにするのが良い。",
      "start_ms": 148020,
      "end_ms": 152630,
      "duration_ms": 4610,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 148020,
          "end_ms": 149341,
          "duration_ms": 1321
        },
        {
          "index": 1,
          "text": "こうすいは控えめにするのが良い。",
          "start_ms": 149591,
          "end_ms": 152630,
          "duration_ms": 3039
        }
      ]
    },
    {
      "index": 18,
      "text": "これは誰もアメリカ人に教えてくれないが、高級店の店主がひそかにいちばん気にしていることだ。",
      "start_ms": 153130,
      "end_ms": 162847,
      "duration_ms": 9717,
      "clauses": [
        {
          "index": 0,
          "text": "これは誰もアメリカ人に教えてくれないが、",
          "start_ms": 153130,
          "end_ms": 157399,
          "duration_ms": 4269
        },
        {
          "index": 1,
          "text": "高級店の店主がひそかにいちばん気にしていることだ。",
          "start_ms": 157649,
          "end_ms": 162847,
          "duration_ms": 5198
        }
      ]
    },
    {
      "index": 19,
      "text": "料理の場では、香りも料理の一部として考えられている。",
      "start_ms": 163347,
      "end_ms": 169721,
      "duration_ms": 6374,
      "clauses": [
        {
          "index": 0,
          "text": "料理の場では、",
          "start_ms": 163347,
          "end_ms": 165306,
          "duration_ms": 1959
        },
        {
          "index": 1,
          "text": "香りも料理の一部として考えられている。",
          "start_ms": 165556,
          "end_ms": 169721,
          "duration_ms": 4165
        }
      ]
    },
    {
      "index": 20,
      "text": "強い匂いは二メートル以内に座っている全員に影響を与える。",
      "start_ms": 170221,
      "end_ms": 175953,
      "duration_ms": 5732,
      "clauses": [
        {
          "index": 0,
          "text": "強い匂いは二メートル以内に座っている全員に影響を与える。",
          "start_ms": 170221,
          "end_ms": 175953,
          "duration_ms": 5732
        }
      ]
    },
    {
      "index": 21,
      "text": "予約の規則に書かれている店もあることだし、書かない店も、ただ客の配慮を願っているだけだ。",
      "start_ms": 176453,
      "end_ms": 186835,
      "duration_ms": 10382,
      "clauses": [
        {
          "index": 0,
          "text": "予約の規則に書かれている店もあることだし、",
          "start_ms": 176453,
          "end_ms": 180664,
          "duration_ms": 4211
        },
        {
          "index": 1,
          "text": "書かない店も、",
          "start_ms": 180914,
          "end_ms": 182815,
          "duration_ms": 1901
        },
        {
          "index": 2,
          "text": "ただ客の配慮を願っているだけだ。",
          "start_ms": 183065,
          "end_ms": 186835,
          "duration_ms": 3770
        }
      ]
    },
    {
      "index": 22,
      "text": "それから、キャンセルするなら正しくキャンセルしてほしい。",
      "start_ms": 187335,
      "end_ms": 193292,
      "duration_ms": 5957,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 187335,
          "end_ms": 188865,
          "duration_ms": 1530
        },
        {
          "index": 1,
          "text": "キャンセルするなら正しくキャンセルしてほしい。",
          "start_ms": 189115,
          "end_ms": 193292,
          "duration_ms": 4177
        }
      ]
    },
    {
      "index": 23,
      "text": "八席だけの店では、八人分の魚を仕入れている。",
      "start_ms": 193792,
      "end_ms": 199736,
      "duration_ms": 5944,
      "clauses": [
        {
          "index": 0,
          "text": "八席だけの店では、",
          "start_ms": 193792,
          "end_ms": 196378,
          "duration_ms": 2586
        },
        {
          "index": 1,
          "text": "八人分の魚を仕入れている。",
          "start_ms": 196628,
          "end_ms": 199736,
          "duration_ms": 3108
        }
      ]
    },
    {
      "index": 24,
      "text": "無断でいなくなることは、ただの空席ではなく、職人の損失そのものである。",
      "start_ms": 200236,
      "end_ms": 209005,
      "duration_ms": 8769,
      "clauses": [
        {
          "index": 0,
          "text": "無断でいなくなることは、",
          "start_ms": 200236,
          "end_ms": 202729,
          "duration_ms": 2493
        },
        {
          "index": 1,
          "text": "ただの空席ではなく、",
          "start_ms": 202979,
          "end_ms": 205461,
          "duration_ms": 2482
        },
        {
          "index": 2,
          "text": "職人の損失そのものである。",
          "start_ms": 205711,
          "end_ms": 209005,
          "duration_ms": 3294
        }
      ]
    },
    {
      "index": 25,
      "text": "外国からの観光客による無断キャンセルは、とうきょうの飲食店を経営する人がいちばんこぼす不満の一つだ。",
      "start_ms": 209505,
      "end_ms": 220012,
      "duration_ms": 10507,
      "clauses": [
        {
          "index": 0,
          "text": "外国からの観光客による無断キャンセルは、",
          "start_ms": 209505,
          "end_ms": 213763,
          "duration_ms": 4258
        },
        {
          "index": 1,
          "text": "とうきょうの飲食店を経営する人がいちばんこぼす不満の一つだ。",
          "start_ms": 214013,
          "end_ms": 220012,
          "duration_ms": 5999
        }
      ]
    },
    {
      "index": 26,
      "text": "遅くなったとしても気まずくても、オンラインでも電話でも、とにかくキャンセルすることが大切だ。",
      "start_ms": 220512,
      "end_ms": 230268,
      "duration_ms": 9756,
      "clauses": [
        {
          "index": 0,
          "text": "遅くなったとしても気まずくても、",
          "start_ms": 220512,
          "end_ms": 223737,
          "duration_ms": 3225
        },
        {
          "index": 1,
          "text": "オンラインでも電話でも、",
          "start_ms": 223987,
          "end_ms": 226480,
          "duration_ms": 2493
        },
        {
          "index": 2,
          "text": "とにかくキャンセルすることが大切だ。",
          "start_ms": 226730,
          "end_ms": 230268,
          "duration_ms": 3538
        }
      ]
    },
    {
      "index": 27,
      "text": "帰るときには、一言をかけたい。",
      "start_ms": 230768,
      "end_ms": 235076,
      "duration_ms": 4308,
      "clauses": [
        {
          "index": 0,
          "text": "帰るときには、",
          "start_ms": 230768,
          "end_ms": 232623,
          "duration_ms": 1855
        },
        {
          "index": 1,
          "text": "一言をかけたい。",
          "start_ms": 232873,
          "end_ms": 235076,
          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 28,
      "text": "「ごちそうさまでした」という言葉だ。",
      "start_ms": 235576,
      "end_ms": 238684,
      "duration_ms": 3108,
      "clauses": [
        {
          "index": 0,
          "text": "「ごちそうさまでした」という言葉だ。",
          "start_ms": 235576,
          "end_ms": 238684,
          "duration_ms": 3108
        }
      ]
    },
    {
      "index": 29,
      "text": "これは大体「素晴らしい食事をありがとう」という意味だと言われている。",
      "start_ms": 239184,
      "end_ms": 245067,
      "duration_ms": 5883,
      "clauses": [
        {
          "index": 0,
          "text": "これは大体「素晴らしい食事をありがとう」という意味だと言われている。",
          "start_ms": 239184,
          "end_ms": 245067,
          "duration_ms": 5883
        }
      ]
    },
    {
      "index": 30,
      "text": "お金はかからないことだし、チップの代わりに文化的に正しい習慣でもあり、小さな店では店員の心に確かに響く。",
      "start_ms": 245567,
      "end_ms": 258155,
      "duration_ms": 12588,
      "clauses": [
        {
          "index": 0,
          "text": "お金はかからないことだし、",
          "start_ms": 245567,
          "end_ms": 248408,
          "duration_ms": 2841
        },
        {
          "index": 1,
          "text": "チップの代わりに文化的に正しい習慣でもあり、",
          "start_ms": 248658,
          "end_ms": 253287,
          "duration_ms": 4629
        },
        {
          "index": 2,
          "text": "小さな店では店員の心に確かに響く。",
          "start_ms": 253537,
          "end_ms": 258155,
          "duration_ms": 4618
        }
      ]
    },
    {
      "index": 31,
      "text": "もし日本の食事の場で使う言葉を一つだけ覚えるなら、これを覚えよう。",
      "start_ms": 258655,
      "end_ms": 266225,
      "duration_ms": 7570,
      "clauses": [
        {
          "index": 0,
          "text": "もし日本の食事の場で使う言葉を一つだけ覚えるなら、",
          "start_ms": 258655,
          "end_ms": 263993,
          "duration_ms": 5338
        },
        {
          "index": 1,
          "text": "これを覚えよう。",
          "start_ms": 264243,
          "end_ms": 266225,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 32,
      "text": "「めんは必ず音を立てて食べるものだ」というルールは、実はそれほどではない。",
      "start_ms": 266725,
      "end_ms": 274294,
      "duration_ms": 7569,
      "clauses": [
        {
          "index": 0,
          "text": "「めんは必ず音を立てて食べるものだ」というルールは、",
          "start_ms": 266725,
          "end_ms": 271412,
          "duration_ms": 4687
        },
        {
          "index": 1,
          "text": "実はそれほどではない。",
          "start_ms": 271662,
          "end_ms": 274294,
          "duration_ms": 2632
        }
      ]
    },
    {
      "index": 33,
      "text": "音を立ててすする人もいれば、静かに食べる人もいる。",
      "start_ms": 274794,
      "end_ms": 280704,
      "duration_ms": 5910,
      "clauses": [
        {
          "index": 0,
          "text": "音を立ててすする人もいれば、",
          "start_ms": 274794,
          "end_ms": 277798,
          "duration_ms": 3004
        },
        {
          "index": 1,
          "text": "静かに食べる人もいる。",
          "start_ms": 278048,
          "end_ms": 280704,
          "duration_ms": 2656
        }
      ]
    },
    {
      "index": 34,
      "text": "どちらであっても誰も評価しない。",
      "start_ms": 281204,
      "end_ms": 284765,
      "duration_ms": 3561,
      "clauses": [
        {
          "index": 0,
          "text": "どちらであっても誰も評価しない。",
          "start_ms": 281204,
          "end_ms": 284765,
          "duration_ms": 3561
        }
      ]
    },
    {
      "index": 35,
      "text": "無理にすすると、かえって不自然に映ることもある。",
      "start_ms": 285265,
      "end_ms": 290745,
      "duration_ms": 5480,
      "clauses": [
        {
          "index": 0,
          "text": "無理にすすると、",
          "start_ms": 285265,
          "end_ms": 287294,
          "duration_ms": 2029
        },
        {
          "index": 1,
          "text": "かえって不自然に映ることもある。",
          "start_ms": 287544,
          "end_ms": 290745,
          "duration_ms": 3201
        }
      ]
    },
    {
      "index": 36,
      "text": "「すべて食べきるものだ」ということもない。",
      "start_ms": 291245,
      "end_ms": 294760,
      "duration_ms": 3515,
      "clauses": [
        {
          "index": 0,
          "text": "「すべて食べきるものだ」ということもない。",
          "start_ms": 291245,
          "end_ms": 294760,
          "duration_ms": 3515
        }
      ]
    },
    {
      "index": 37,
      "text": "かんしょくすれば喜ばれるが、ごはんが残っても誰も責めない。",
      "start_ms": 295260,
      "end_ms": 301762,
      "duration_ms": 6502,
      "clauses": [
        {
          "index": 0,
          "text": "かんしょくすれば喜ばれるが、",
          "start_ms": 295260,
          "end_ms": 298125,
          "duration_ms": 2865
        },
        {
          "index": 1,
          "text": "ごはんが残っても誰も責めない。",
          "start_ms": 298375,
          "end_ms": 301762,
          "duration_ms": 3387
        }
      ]
    },
    {
      "index": 38,
      "text": "少なめに注文するのが、賢い解決策だ。",
      "start_ms": 302262,
      "end_ms": 307718,
      "duration_ms": 5456,
      "clauses": [
        {
          "index": 0,
          "text": "少なめに注文するのが、",
          "start_ms": 302262,
          "end_ms": 305045,
          "duration_ms": 2783
        },
        {
          "index": 1,
          "text": "賢い解決策だ。",
          "start_ms": 305295,
          "end_ms": 307718,
          "duration_ms": 2423
        }
      ]
    },
    {
      "index": 39,
      "text": "「外国人だからという理由で入店を断られる」と聞いたことがあるかもしれない。",
      "start_ms": 308218,
      "end_ms": 314717,
      "duration_ms": 6499,
      "clauses": [
        {
          "index": 0,
          "text": "「外国人だからという理由で入店を断られる」と聞いたことがあるかもしれない。",
          "start_ms": 308218,
          "end_ms": 314717,
          "duration_ms": 6499
        }
      ]
    },
    {
      "index": 40,
      "text": "一部では日本語を話す客だけを受け入れる店もあることだし、インターネットで言われているほど頻繁ではない。",
      "start_ms": 315217,
      "end_ms": 324912,
      "duration_ms": 9695,
      "clauses": [
        {
          "index": 0,
          "text": "一部では日本語を話す客だけを受け入れる店もあることだし、",
          "start_ms": 315217,
          "end_ms": 320787,
          "duration_ms": 5570
        },
        {
          "index": 1,
          "text": "インターネットで言われているほど頻繁ではない。",
          "start_ms": 321037,
          "end_ms": 324912,
          "duration_ms": 3875
        }
      ]
    },
    {
      "index": 41,
      "text": "それはあくまでも、客に食事をスムーズに提供する上での問題であり、あなた個人に対して向けられた話ではない。",
      "start_ms": 325412,
      "end_ms": 336979,
      "duration_ms": 11567,
      "clauses": [
        {
          "index": 0,
          "text": "それはあくまでも、",
          "start_ms": 325412,
          "end_ms": 327685,
          "duration_ms": 2273
        },
        {
          "index": 1,
          "text": "客に食事をスムーズに提供する上での問題であり、",
          "start_ms": 327935,
          "end_ms": 332599,
          "duration_ms": 4664
        },
        {
          "index": 2,
          "text": "あなた個人に対して向けられた話ではない。",
          "start_ms": 332849,
          "end_ms": 336979,
          "duration_ms": 4130
        }
      ]
    },
    {
      "index": 42,
      "text": "言葉の壁を解消してくれる予約の仕組みを使えば、十分に避けられる。",
      "start_ms": 337479,
      "end_ms": 344956,
      "duration_ms": 7477,
      "clauses": [
        {
          "index": 0,
          "text": "言葉の壁を解消してくれる予約の仕組みを使えば、",
          "start_ms": 337479,
          "end_ms": 342433,
          "duration_ms": 4954
        },
        {
          "index": 1,
          "text": "十分に避けられる。",
          "start_ms": 342683,
          "end_ms": 344956,
          "duration_ms": 2273
        }
      ]
    },
    {
      "index": 43,
      "text": "席につくと出される温かいタオルは、手を拭くときに使うものだ。",
      "start_ms": 345456,
      "end_ms": 352202,
      "duration_ms": 6746,
      "clauses": [
        {
          "index": 0,
          "text": "席につくと出される温かいタオルは、",
          "start_ms": 345456,
          "end_ms": 349203,
          "duration_ms": 3747
        },
        {
          "index": 1,
          "text": "手を拭くときに使うものだ。",
          "start_ms": 349453,
          "end_ms": 352202,
          "duration_ms": 2749
        }
      ]
    },
    {
      "index": 44,
      "text": "それで顔を拭くのは、いかにも観光客らしい光景ではある。",
      "start_ms": 352702,
      "end_ms": 359297,
      "duration_ms": 6595,
      "clauses": [
        {
          "index": 0,
          "text": "それで顔を拭くのは、",
          "start_ms": 352702,
          "end_ms": 355242,
          "duration_ms": 2540
        },
        {
          "index": 1,
          "text": "いかにも観光客らしい光景ではある。",
          "start_ms": 355492,
          "end_ms": 359297,
          "duration_ms": 3805
        }
      ]
    },
    {
      "index": 45,
      "text": "といっても、長い一日の終わりに、日本人の男性でもよく拭いている光景を目にすることがあるけれど。",
      "start_ms": 359797,
      "end_ms": 370434,
      "duration_ms": 10637,
      "clauses": [
        {
          "index": 0,
          "text": "といっても、",
          "start_ms": 359797,
          "end_ms": 361361,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "長い一日の終わりに、",
          "start_ms": 361611,
          "end_ms": 364243,
          "duration_ms": 2632
        },
        {
          "index": 2,
          "text": "日本人の男性でもよく拭いている光景を目にすることがあるけれど。",
          "start_ms": 364493,
          "end_ms": 370434,
          "duration_ms": 5941
        }
      ]
    }
  ]
}