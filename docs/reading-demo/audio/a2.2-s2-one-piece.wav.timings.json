          "end_ms": 35634,
          "duration_ms": 1680
        },
        {
          "index": 1,
          "text": "じぶんで探してください。",
          "start_ms": 35884,
          "end_ms": 38412,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 8,
      "text": "わたしはたからを、あそこに置きました。",
      "start_ms": 38912,
      "end_ms": 43463,
      "duration_ms": 4551,
      "clauses": [
        {
          "index": 0,
          "text": "わたしはたからを、",
          "start_ms": 38912,
          "end_ms": 40987,
          "duration_ms": 2075
        },
        {
