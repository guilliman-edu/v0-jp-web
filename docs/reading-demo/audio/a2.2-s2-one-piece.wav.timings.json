          "start_ms": 15513,
          "end_ms": 17948,
          "duration_ms": 2435
        }
      ]
    },
    {
      "index": 4,
      "text": "ロジャーは、ふねで、せかいじゅうをりょこうしました。",
      "start_ms": 18448,
      "end_ms": 23990,
      "duration_ms": 5542,
      "clauses": [
        {
