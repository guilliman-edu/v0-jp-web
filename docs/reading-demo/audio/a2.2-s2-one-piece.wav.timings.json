          "end_ms": 5583,
          "duration_ms": 1785
        },
        {
          "index": 2,
          "text": "すごくゆうめいなかいぞくがいました。",
          "start_ms": 5833,
          "end_ms": 9069,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 2,
      "text": "なまえはゴール・D・ロジャーです。",
      "start_ms": 9569,
      "end_ms": 12352,
      "duration_ms": 2783,
      "clauses": [
        {
          "index": 0,
          "text": "なまえはゴール・D・ロジャーです。",
          "start_ms": 9569,
          "end_ms": 12352,
          "duration_ms": 2783
        }
      ]
    },
    {
      "index": 3,
      "text": "みんなはロジャーのことを、「かいぞくおう」と言いました。",
      "start_ms": 12852,
      "end_ms": 17879,
      "duration_ms": 5027,
      "clauses": [
        {
          "index": 0,
          "text": "みんなはロジャーのことを、",
          "start_ms": 12852,
          "end_ms": 15206,
          "duration_ms": 2354
        },
        {
          "index": 1,
          "text": "「かいぞくおう」と言いました。",
          "start_ms": 15456,
          "end_ms": 17879,
          "duration_ms": 2423
        }
      ]
    },
    {
      "index": 4,
      "text": "ロジャーは、ふねで、せかいじゅうをりょこうしました。",
      "start_ms": 18379,
      "end_ms": 23955,
      "duration_ms": 5576,
      "clauses": [
        {
          "index": 0,
          "text": "ロジャーは、",
          "start_ms": 18379,
          "end_ms": 19583,
          "duration_ms": 1204
        },
