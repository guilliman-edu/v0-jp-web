          "text": "あそこに置きました。",
          "start_ms": 41237,
          "end_ms": 43463,
          "duration_ms": 2226
        }
      ]
    },
    {
      "index": 9,
      "text": "」\n\nこのことばを聞いて、せかいじゅうの人が大きなゆめを持ちました。",
      "start_ms": 43963,
      "end_ms": 50569,
      "duration_ms": 6606,
      "clauses": [
        {
          "index": 0,
          "text": "」\n\nこのことばを聞いて、",
          "start_ms": 43963,
          "end_ms": 46154,
          "duration_ms": 2191
        },
        {
          "index": 1,
          "text": "せかいじゅうの人が大きなゆめを持ちました。",
          "start_ms": 46404,
          "end_ms": 50569,
          "duration_ms": 4165
        }
      ]
    },
    {
      "index": 10,
      "text": "たからを探して、うみにでる人が多くなりました。",
      "start_ms": 51069,
      "end_ms": 56723,
      "duration_ms": 5654,
      "clauses": [
        {
          "index": 0,
          "text": "たからを探して、",
