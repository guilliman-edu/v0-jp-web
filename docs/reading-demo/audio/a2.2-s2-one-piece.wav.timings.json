        },
        {
          "index": 2,
          "text": "すごくゆうめいなかいぞくがいました。",
          "start_ms": 5797,
          "end_ms": 9033,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 2,
      "text": "なまえはゴール・D・ロジャーです。",
