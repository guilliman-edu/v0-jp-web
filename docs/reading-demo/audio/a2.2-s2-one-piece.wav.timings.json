          "end_ms": 21003,
          "duration_ms": 1170
        },
        {
          "index": 2,
          "text": "せかいじゅうをりょこうしました。",
          "start_ms": 21253,
          "end_ms": 23955,
          "duration_ms": 2702
        }
      ]
    },
    {
      "index": 5,
      "text": "ロジャーはしぬまえに、言いました。",
      "start_ms": 24455,
      "end_ms": 28344,
      "duration_ms": 3889,
      "clauses": [
        {
          "index": 0,
          "text": "ロジャーはしぬまえに、",
          "start_ms": 24455,
          "end_ms": 26495,
          "duration_ms": 2040
        },
        {
          "index": 1,
          "text": "言いました。",
          "start_ms": 26745,
          "end_ms": 28344,
          "duration_ms": 1599
        }
      ]
    },
    {
      "index": 6,
      "text": "「みなさん、わたしのたからがほしいですか。",
      "start_ms": 28844,
      "end_ms": 33454,
      "duration_ms": 4610,
      "clauses": [
        {
          "index": 0,
          "text": "「みなさん、",
          "start_ms": 28844,
          "end_ms": 30281,
          "duration_ms": 1437
        },
        {
          "index": 1,
          "text": "わたしのたからがほしいですか。",
          "start_ms": 30531,
          "end_ms": 33454,
          "duration_ms": 2923
        }
      ]
    },
    {
      "index": 7,
      "text": "ほしい人は、じぶんで探してください。",
      "start_ms": 33954,
      "end_ms": 38412,
      "duration_ms": 4458,
      "clauses": [
        {
          "index": 0,
          "text": "ほしい人は、",
