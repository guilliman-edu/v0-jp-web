          "index": 1,
          "text": "言いました。",
          "start_ms": 26838,
          "end_ms": 28437,
          "duration_ms": 1599
        }
      ]
    },
    {
      "index": 6,
      "text": "「みなさん、わたしのたからがほしいですか。",
      "start_ms": 28937,
      "end_ms": 33593,
      "duration_ms": 4656,
      "clauses": [
        {
          "index": 0,
          "text": "「みなさん、",
          "start_ms": 28937,
          "end_ms": 30374,
          "duration_ms": 1437
        },
        {
          "index": 1,
          "text": "わたしのたからがほしいですか。",
          "start_ms": 30624,
          "end_ms": 33593,
          "duration_ms": 2969
        }
      ]
    },
    {
      "index": 7,
      "text": "ほしい人は、じぶんで探してください。",
      "start_ms": 34093,
      "end_ms": 38609,
      "duration_ms": 4516,
      "clauses": [
        {
          "index": 0,
          "text": "ほしい人は、",
