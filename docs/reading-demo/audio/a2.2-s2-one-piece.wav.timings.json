          "start_ms": 9533,
          "end_ms": 12421,
          "duration_ms": 2888
        }
      ]
    },
    {
      "index": 3,
      "text": "みんなはロジャーのことを、「かいぞくおう」と言いました。",
      "start_ms": 12921,
      "end_ms": 17948,
      "duration_ms": 5027,
      "clauses": [
