          "text": "あそこに置きました。」",
          "start_ms": 41492,
          "end_ms": 43695,
          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 9,
      "text": "このことばを聞いて、せかいじゅうの人が大きなゆめを持ちました。",
      "start_ms": 44195,
      "end_ms": 50976,
      "duration_ms": 6781,
      "clauses": [
        {
          "index": 0,
          "text": "このことばを聞いて、",
