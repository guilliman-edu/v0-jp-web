          "index": 2,
          "text": "シャンプーなどがあることが多いです。",
          "start_ms": 24063,
          "end_ms": 27137,
          "duration_ms": 3074
        }
      ]
    },
    {
      "index": 5,
      "text": "しかし、小さいりょかんにはないものもありますから、よやくのときにりょかんのページを見たほうがいいです。",
      "start_ms": 27637,
      "end_ms": 37682,
      "duration_ms": 10045,
      "clauses": [
        {
          "index": 0,
          "text": "しかし、",
          "start_ms": 27637,
          "end_ms": 29108,
          "duration_ms": 1471
        },
        {
          "index": 1,
          "text": "小さいりょかんにはないものもありますから、",
          "start_ms": 29358,
          "end_ms": 32919,
          "duration_ms": 3561
        },
        {
          "index": 2,
          "text": "よやくのときにりょかんのページを見たほうがいいです。",
          "start_ms": 33169,
          "end_ms": 37682,
          "duration_ms": 4513
        }
      ]
    },
    {
      "index": 6,
      "text": "さむいきせつは、ゆかただけではさむいかもしれません。",
      "start_ms": 38182,
      "end_ms": 44011,
      "duration_ms": 5829,
      "clauses": [
        {
          "index": 0,
          "text": "さむいきせつは、",
          "start_ms": 38182,
          "end_ms": 40188,
