          "start_ms": 16524,
          "end_ms": 19424,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 4,
      "text": "りょかんには、タオルやゆかた、シャンプーなどがあることが多いです。",
      "start_ms": 19924,
      "end_ms": 27137,
      "duration_ms": 7213,
      "clauses": [
        {
          "index": 0,
          "text": "りょかんには、",
          "start_ms": 19924,
          "end_ms": 21581,
          "duration_ms": 1657
        },
