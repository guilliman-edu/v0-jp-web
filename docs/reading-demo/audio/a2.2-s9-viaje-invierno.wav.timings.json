          "text": "自分で持っていくものがあります。",
          "start_ms": 11983,
          "end_ms": 14883,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 3,
      "text": "まず、りょかんにあるものを知りましょう。",
      "start_ms": 15383,
      "end_ms": 19424,
      "duration_ms": 4041,
      "clauses": [
        {
          "index": 0,
          "text": "まず、",
          "start_ms": 15383,
          "end_ms": 16274,
