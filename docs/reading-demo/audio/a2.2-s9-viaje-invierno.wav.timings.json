          "text": "ゆかただけではさむいかもしれません。",
          "start_ms": 40438,
          "end_ms": 44011,
          "duration_ms": 3573
        }
      ]
    },
    {
      "index": 7,
      "text": "かおやかみにつかうものは、自分で持っていったほうがいいです。",
      "start_ms": 44511,
      "end_ms": 50374,
      "duration_ms": 5863,
      "clauses": [
        {
          "index": 0,
          "text": "かおやかみにつかうものは、",
