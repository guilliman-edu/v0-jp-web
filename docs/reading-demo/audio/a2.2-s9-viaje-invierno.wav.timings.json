          "start_ms": 5539,
          "end_ms": 9007,
          "duration_ms": 3468
        }
      ]
    },
    {
      "index": 2,
      "text": "りょかんにあるものと、自分で持っていくものがあります。",
      "start_ms": 9507,
      "end_ms": 14883,
      "duration_ms": 5376,
      "clauses": [
        {
