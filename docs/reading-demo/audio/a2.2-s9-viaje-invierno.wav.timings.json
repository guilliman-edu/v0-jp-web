          "end_ms": 56923,
          "duration_ms": 3538
        }
      ]
    },
    {
      "index": 9,
      "text": "コンタクトレンズをつかう人は、めがねも忘れないでください。",
      "start_ms": 57423,
      "end_ms": 63344,
      "duration_ms": 5921,
      "clauses": [
        {
          "index": 0,
          "text": "コンタクトレンズをつかう人は、",
          "start_ms": 57423,
          "end_ms": 60218,
          "duration_ms": 2795
