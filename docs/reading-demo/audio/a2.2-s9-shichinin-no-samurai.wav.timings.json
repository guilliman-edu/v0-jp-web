  "sentences": [
    {
      "index": 0,
      "text": "しちにんのさむらい",
      "start_ms": 0,
      "end_ms": 1514,
      "duration_ms": 1514,
      "clauses": [
        {
          "index": 0,
          "text": "しちにんのさむらい",
          "start_ms": 0,
          "end_ms": 1514,
          "duration_ms": 1514
        }
      ]
    },
    {
      "index": 1,
      "text": "「しちにんのさむらい」は、せんきゅうひゃくごじゅうよ年のにほんのえいがです。",
      "start_ms": 2014,
      "end_ms": 8749,
      "duration_ms": 6735,
      "clauses": [
        {
          "index": 0,
          "text": "「しちにんのさむらい」は、",
          "start_ms": 2014,
          "end_ms": 4160,
          "duration_ms": 2146
        },
        {
          "index": 1,
          "text": "せんきゅうひゃくごじゅうよ年のにほんのえいがです。",
          "start_ms": 4410,
          "end_ms": 8749,
          "duration_ms": 4339
        }
      ]
    },
    {
      "index": 2,
      "text": "くろさわあきらがかんとくしました。",
      "start_ms": 9249,
      "end_ms": 12381,
      "duration_ms": 3132,
      "clauses": [
        {
          "index": 0,
          "text": "くろさわあきらがかんとくしました。",
          "start_ms": 9249,
          "end_ms": 12381,
          "duration_ms": 3132
        }
      ]
    },
    {
      "index": 3,
      "text": "みふねとしろうとしむらたかしが出ています。",
      "start_ms": 12881,
      "end_ms": 16733,
      "duration_ms": 3852,
      "clauses": [
        {
          "index": 0,
          "text": "みふねとしろうとしむらたかしが出ています。",
          "start_ms": 12881,
          "end_ms": 16733,
          "duration_ms": 3852
        }
      ]
    },
    {
      "index": 4,
      "text": "しろくろのえいがで、じかんは207分もあります。",
      "start_ms": 17233,
      "end_ms": 23015,
      "duration_ms": 5782,
      "clauses": [
        {
          "index": 0,
          "text": "しろくろのえいがで、",
          "start_ms": 17233,
          "end_ms": 19389,
          "duration_ms": 2156
        },
        {
          "index": 1,
          "text": "じかんは207分もあります。",
          "start_ms": 19639,
          "end_ms": 23015,
          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 5,
      "text": "今から400年いじょう前のせんごくじだいのはなしです。",
      "start_ms": 23515,
      "end_ms": 28562,
      "duration_ms": 5047,
      "clauses": [
        {
          "index": 0,
          "text": "今から400年いじょう前のせんごくじだいのはなしです。",
          "start_ms": 23515,
          "end_ms": 28562,
          "duration_ms": 5047
        }
      ]
    },
    {
      "index": 6,
      "text": "むかし、山のむらに、のうかの人たちが住んでいました。",
      "start_ms": 29062,
      "end_ms": 34623,
      "duration_ms": 5561,
      "clauses": [
        {
          "index": 0,
          "text": "むかし、山のむらに、",
          "start_ms": 29062,
          "end_ms": 31265,
          "duration_ms": 2203
        },
        {
          "index": 1,
          "text": "のうかの人たちが住んでいました。",
          "start_ms": 31515,
          "end_ms": 34623,
          "duration_ms": 3108
        }
      ]
    },
    {
      "index": 7,
      "text": "のぶし（わるいぶしたち）がいつもむらに来て、たべものを取りました。",
      "start_ms": 35123,
      "end_ms": 41706,
      "duration_ms": 6583,
      "clauses": [
        {
          "index": 0,
          "text": "のぶし（わるいぶしたち）がいつもむらに来て、",
          "start_ms": 35123,
          "end_ms": 39125,
          "duration_ms": 4002
        },
        {
          "index": 1,
          "text": "たべものを取りました。",
          "start_ms": 39375,
          "end_ms": 41706,
          "duration_ms": 2331
        }
      ]
    },
    {
      "index": 8,
      "text": "むらびとたちは、強いぶしがほしいと思いました。",
      "start_ms": 42206,
      "end_ms": 47605,
      "duration_ms": 5399,
      "clauses": [
        {
          "index": 0,
          "text": "むらびとたちは、",
          "start_ms": 42206,
          "end_ms": 44188,
          "duration_ms": 1982
        },
        {
          "index": 1,
          "text": "強いぶしがほしいと思いました。",
          "start_ms": 44438,
          "end_ms": 47605,
          "duration_ms": 3167
        }
      ]
    },
    {
      "index": 9,
      "text": "ですから、町へぶしを探しに行きました。",
      "start_ms": 48105,
      "end_ms": 53004,
      "duration_ms": 4899,
      "clauses": [
        {
          "index": 0,
          "text": "ですから、",
          "start_ms": 48105,
          "end_ms": 49495,
          "duration_ms": 1390
        },
        {
          "index": 1,
          "text": "町へぶしを探しに行きました。",
          "start_ms": 49745,
          "end_ms": 53004,
          "duration_ms": 3259
        }
      ]
    },
    {
      "index": 10,
      "text": "町で、かんべえというぶしに会いました。",
      "start_ms": 53504,
      "end_ms": 57892,
      "duration_ms": 4388,
      "clauses": [
        {
          "index": 0,
          "text": "町で、",
          "start_ms": 53504,
          "end_ms": 54766,
          "duration_ms": 1262
        },
        {
          "index": 1,
          "text": "かんべえというぶしに会いました。",
          "start_ms": 55016,
          "end_ms": 57892,
          "duration_ms": 2876
        }
      ]
    },
    {
      "index": 11,
      "text": "かんべえはほかのぶしを集めて、七人になりました。",
      "start_ms": 58392,
      "end_ms": 63371,
      "duration_ms": 4979,
      "clauses": [
        {
          "index": 0,
          "text": "かんべえはほかのぶしを集めて、",
          "start_ms": 58392,
          "end_ms": 61547,
          "duration_ms": 3155
        },
        {
          "index": 1,
          "text": "七人になりました。",
          "start_ms": 61797,
          "end_ms": 63371,
          "duration_ms": 1574
        }
      ]
    },
    {
      "index": 12,
      "text": "ぶしたちはむらに行って、むらびとたちとみんなで戦いました。",
      "start_ms": 63871,
      "end_ms": 70175,
      "duration_ms": 6304,
      "clauses": [
        {
          "index": 0,
          "text": "ぶしたちはむらに行って、",
          "start_ms": 63871,
          "end_ms": 66445,
          "duration_ms": 2574
        },
        {
          "index": 1,
          "text": "むらびとたちとみんなで戦いました。",
          "start_ms": 66695,
          "end_ms": 70175,
          "duration_ms": 3480
        }
      ]
    },
    {
      "index": 13,
      "text": "やっと、ぶしたちは勝ちました。",
      "start_ms": 70675,
      "end_ms": 74808,
      "duration_ms": 4133,
      "clauses": [
        {
          "index": 0,
          "text": "やっと、",
          "start_ms": 70675,
          "end_ms": 72042,
          "duration_ms": 1367
        },
        {
          "index": 1,
          "text": "ぶしたちは勝ちました。",
          "start_ms": 72292,
          "end_ms": 74808,
          "duration_ms": 2516
        }
      ]
    },
    {
      "index": 14,
      "text": "でも、四人のぶしが死にました。",
      "start_ms": 75308,
      "end_ms": 79151,
      "duration_ms": 3843,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 75308,
          "end_ms": 76292,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "四人のぶしが死にました。",
          "start_ms": 76542,
          "end_ms": 79151,
          "duration_ms": 2609
        }
      ]
    },
    {
      "index": 15,
      "text": "かんべえは言いました。",
      "start_ms": 79651,
      "end_ms": 81854,
      "duration_ms": 2203,
      "clauses": [
        {
          "index": 0,
          "text": "かんべえは言いました。",
          "start_ms": 79651,
          "end_ms": 81854,
          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 16,
      "text": "「勝ったのはむらびとたちです。",
      "start_ms": 82354,
      "end_ms": 85439,
      "duration_ms": 3085,
      "clauses": [
        {
          "index": 0,
          "text": "「勝ったのはむらびとたちです。",
          "start_ms": 82354,
          "end_ms": 85439,
          "duration_ms": 3085
        }
      ]
    },
    {
      "index": 17,
      "text": "わたしたちではありません。」",
      "start_ms": 85939,
      "end_ms": 88490,
      "duration_ms": 2551,
      "clauses": [
        {
          "index": 0,
          "text": "わたしたちではありません。」",
          "start_ms": 85939,
          "end_ms": 88490,
          "duration_ms": 2551
        }
      ]
    },
    {
      "index": 18,
      "text": "このえいがを作るとき、たくさんのじかんとお金がかかりました。",
      "start_ms": 88990,
      "end_ms": 95202,
      "duration_ms": 6212,
      "clauses": [
        {
          "index": 0,
          "text": "このえいがを作るとき、",
          "start_ms": 88990,
          "end_ms": 91460,
          "duration_ms": 2470
        },
        {
          "index": 1,
          "text": "たくさんのじかんとお金がかかりました。",
          "start_ms": 91710,
          "end_ms": 95202,
          "duration_ms": 3492
        }
      ]
    },
    {
      "index": 19,
      "text": "お金は、ふつうのえいがのななばいでした。",
      "start_ms": 95702,
      "end_ms": 100126,
      "duration_ms": 4424,
      "clauses": [
        {
          "index": 0,
          "text": "お金は、",
          "start_ms": 95702,
          "end_ms": 96988,
          "duration_ms": 1286
        },
        {
          "index": 1,
          "text": "ふつうのえいがのななばいでした。",
          "start_ms": 97238,
          "end_ms": 100126,
          "duration_ms": 2888
        }
      ]
    },
    {
      "index": 20,
      "text": "天気がわるい日が多くて、九十日で撮るよていでしたが、いちねんぐらいかかりました。",
      "start_ms": 100626,
      "end_ms": 109418,
      "duration_ms": 8792,
      "clauses": [
        {
          "index": 0,
          "text": "天気がわるい日が多くて、",
          "start_ms": 100626,
          "end_ms": 103212,
          "duration_ms": 2586
        },
        {
          "index": 1,
          "text": "九十日で撮るよていでしたが、",
          "start_ms": 103462,
          "end_ms": 106536,
          "duration_ms": 3074
        },
        {
          "index": 2,
          "text": "いちねんぐらいかかりました。",
          "start_ms": 106786,
          "end_ms": 109418,
          "duration_ms": 2632
        }
      ]
    },
    {
      "index": 21,
      "text": "雨の中の戦いは、寒い二月に撮りました。",
      "start_ms": 109918,
      "end_ms": 115387,
      "duration_ms": 5469,
      "clauses": [
        {
          "index": 0,
          "text": "雨の中の戦いは、",
          "start_ms": 109918,
          "end_ms": 112388,
          "duration_ms": 2470
        },
        {
          "index": 1,
          "text": "寒い二月に撮りました。",
          "start_ms": 112638,
          "end_ms": 115387,
          "duration_ms": 2749
        }
      ]
    },
    {
      "index": 22,
      "text": "このえいがはせかいでとてもゆうめいになりました。",
      "start_ms": 115887,
      "end_ms": 120156,
      "duration_ms": 4269,
      "clauses": [
        {
          "index": 0,
          "text": "このえいがはせかいでとてもゆうめいになりました。",
          "start_ms": 115887,
          "end_ms": 120156,
          "duration_ms": 4269
        }
      ]
    },
    {
      "index": 23,
      "text": "せんきゅうひゃくごじゅうよ年に、ヴェネツィアこくさいえいがさいでしょうをもらいました。",
      "start_ms": 120656,
      "end_ms": 127587,
      "duration_ms": 6931,
      "clauses": [
        {
          "index": 0,
          "text": "せんきゅうひゃくごじゅうよ年に、",
          "start_ms": 120656,
          "end_ms": 123393,
          "duration_ms": 2737
        },
        {
          "index": 1,
          "text": "ヴェネツィアこくさいえいがさいでしょうをもらいました。",
          "start_ms": 123643,
          "end_ms": 127587,
          "duration_ms": 3944
        }
      ]
    },
    {
      "index": 24,
      "text": "にせんじゅうはち年には、BBCの「がいこくごえいがベスト100」でいちいになりました。",
      "start_ms": 128087,
      "end_ms": 135308,
      "duration_ms": 7221,
      "clauses": [
        {
          "index": 0,
          "text": "にせんじゅうはち年には、",
          "start_ms": 128087,
          "end_ms": 130510,
          "duration_ms": 2423
        },
        {
          "index": 1,
          "text": "BBCの「がいこくごえいがベスト100」でいちいになりました。",
          "start_ms": 130760,
          "end_ms": 135308,
          "duration_ms": 4548
        }
      ]
    },
    {
      "index": 25,
      "text": "せんきゅうひゃくろくじゅう年に、アメリカの人がこのえいがとおなじはなしで「こうやのしちにん」というえいがを作りました。",
      "start_ms": 135808,
      "end_ms": 145019,
      "duration_ms": 9211,
      "clauses": [
        {
          "index": 0,
          "text": "せんきゅうひゃくろくじゅう年に、",
          "start_ms": 135808,
          "end_ms": 138510,
          "duration_ms": 2702
        },
        {
          "index": 1,
          "text": "アメリカの人がこのえいがとおなじはなしで「こうやのしちにん」というえいがを作りました。",
          "start_ms": 138760,
          "end_ms": 145019,
          "duration_ms": 6259
        }
      ]
    },
    {
      "index": 26,
      "text": "ジョージ・ルーカスはこのえいがを見て、とてもびっくりしました。",
      "start_ms": 145519,
      "end_ms": 151521,
      "duration_ms": 6002,
      "clauses": [
        {
          "index": 0,
          "text": "ジョージ・ルーカスはこのえいがを見て、",
          "start_ms": 145519,
          "end_ms": 148848,
          "duration_ms": 3329
        },
        {
          "index": 1,
          "text": "とてもびっくりしました。",
          "start_ms": 149098,
          "end_ms": 151521,
          "duration_ms": 2423
        }
      ]
    },
    {
      "index": 27,
      "text": "スター・ウォーズも、このえいがからおおきなえいきょうを受けました。",
      "start_ms": 152021,
      "end_ms": 157850,
      "duration_ms": 5829,
      "clauses": [
        {
          "index": 0,
          "text": "スター・ウォーズも、",
          "start_ms": 152021,
          "end_ms": 153899,
          "duration_ms": 1878
        },
        {
          "index": 1,
          "text": "このえいがからおおきなえいきょうを受けました。",
          "start_ms": 154149,
          "end_ms": 157850,
          "duration_ms": 3701
        }
      ]
    },
    {
      "index": 28,
      "text": "今も、たくさんの人がこのえいがを見ています。",
      "start_ms": 158350,
      "end_ms": 163273,
      "duration_ms": 4923,
      "clauses": [
        {
          "index": 0,
          "text": "今も、",
          "start_ms": 158350,
          "end_ms": 159299,
          "duration_ms": 949
        },
        {
          "index": 1,
          "text": "たくさんの人がこのえいがを見ています。",
          "start_ms": 159549,
          "end_ms": 163273,
          "duration_ms": 3724
        }
      ]
    },
    {
      "index": 29,
      "text": "今の若い人も、このえいがが好きかもしれません。",
      "start_ms": 163773,
      "end_ms": 169090,
      "duration_ms": 5317,
      "clauses": [
        {
          "index": 0,
          "text": "今の若い人も、",
          "start_ms": 163773,
          "end_ms": 165929,
          "duration_ms": 2156
        },
        {
          "index": 1,
          "text": "このえいがが好きかもしれません。",
          "start_ms": 166179,
          "end_ms": 169090,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 30,
      "text": "むかしのにほんのえいがが好きなら、このえいがを見たらどうですか。",
      "start_ms": 169590,
      "end_ms": 175930,
      "duration_ms": 6340,
      "clauses": [
        {
          "index": 0,
          "text": "むかしのにほんのえいがが好きなら、",
