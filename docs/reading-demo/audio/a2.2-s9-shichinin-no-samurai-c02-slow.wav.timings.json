          "start_ms": 4867,
          "end_ms": 8342,
          "duration_ms": 3475
        }
      ]
    },
    {
      "index": 2,
      "text": "のぶし（わるいぶしたち）がいつもむらに来て、たべものを取りました。",
      "start_ms": 8842,
