    },
    {
      "index": 1,
      "text": "むかし、山のむらに、のうかの人たちが住んでいました。",
      "start_ms": 2233,
      "end_ms": 8341,
      "duration_ms": 6108,
      "clauses": [
        {
          "index": 0,
          "text": "むかし、山のむらに、",
          "start_ms": 2233,
