          "start_ms": 13378,
          "end_ms": 15866,
          "duration_ms": 2488
        }
      ]
    },
    {
      "index": 3,
      "text": "むらびとたちは、強いぶしがほしいと思いました。",
      "start_ms": 16366,
      "end_ms": 22323,
      "duration_ms": 5957,
      "clauses": [
        {
          "index": 0,
          "text": "むらびとたちは、",
