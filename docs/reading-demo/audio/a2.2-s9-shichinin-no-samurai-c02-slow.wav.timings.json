          "start_ms": 24632,
          "end_ms": 28281,
          "duration_ms": 3649
        }
      ]
    },
    {
      "index": 5,
      "text": "町で、かんべえというぶしに会いました。",
      "start_ms": 28781,
      "end_ms": 33623,
      "duration_ms": 4842,
      "clauses": [
