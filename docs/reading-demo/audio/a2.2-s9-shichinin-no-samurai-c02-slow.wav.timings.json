          "start_ms": 30509,
          "end_ms": 33693,
          "duration_ms": 3184
        }
      ]
    },
    {
      "index": 6,
      "text": "かんべえはほかのぶしを集めて、七人になりました。",
      "start_ms": 34193,
      "end_ms": 40464,
      "duration_ms": 6271,
      "clauses": [
        {
          "index": 0,
          "text": "かんべえはほかのぶしを集めて、",
