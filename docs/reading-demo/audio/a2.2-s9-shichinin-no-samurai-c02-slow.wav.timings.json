          "start_ms": 38092,
          "end_ms": 40464,
          "duration_ms": 2372
        }
      ]
    },
    {
      "index": 7,
      "text": "ぶしたちはむらに行って、むらびとたちとみんなで戦いました。",
      "start_ms": 40964,
      "end_ms": 47884,
      "duration_ms": 6920,
      "clauses": [
