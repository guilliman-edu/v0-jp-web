          "start_ms": 13437,
          "end_ms": 15960,
          "duration_ms": 2523
        }
      ]
    },
    {
      "index": 3,
      "text": "むらびとたちは、強いぶしがほしいと思いました。",
      "start_ms": 16460,
      "end_ms": 22405,
      "duration_ms": 5945,
      "clauses": [
        {
