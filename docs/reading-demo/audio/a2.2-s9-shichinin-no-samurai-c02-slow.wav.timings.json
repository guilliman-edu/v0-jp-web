          "start_ms": 18964,
          "end_ms": 22450,
          "duration_ms": 3486
        }
      ]
    },
    {
      "index": 4,
      "text": "ですから、町へぶしを探しに行きました。",
      "start_ms": 22950,
      "end_ms": 28396,
      "duration_ms": 5446,
