          "start_ms": 18861,
          "end_ms": 22405,
          "duration_ms": 3544
        }
      ]
    },
    {
      "index": 4,
      "text": "ですから、町へぶしを探しに行きました。",
      "start_ms": 22905,
      "end_ms": 28351,
      "duration_ms": 5446,
      "clauses": [
        {
          "index": 0,
          "text": "ですから、",
