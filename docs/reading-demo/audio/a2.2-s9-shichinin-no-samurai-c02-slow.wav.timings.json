          "start_ms": 30427,
          "end_ms": 33623,
          "duration_ms": 3196
        }
      ]
    },
    {
      "index": 6,
      "text": "かんべえはほかのぶしを集めて、七人になりました。",
      "start_ms": 34123,
      "end_ms": 39680,
      "duration_ms": 5557,
      "clauses": [
        {
          "index": 0,
          "text": "かんべえはほかのぶしを集めて、",
