          "start_ms": 37906,
          "end_ms": 39680,
          "duration_ms": 1774
        }
      ]
    },
    {
      "index": 7,
      "text": "ぶしたちはむらに行って、むらびとたちとみんなで戦いました。",
      "start_ms": 40180,
      "end_ms": 47159,
      "duration_ms": 6979,
      "clauses": [
        {
