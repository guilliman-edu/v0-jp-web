          "text": "強いぶしがほしいと思いました。",
          "start_ms": 18802,
          "end_ms": 22323,
          "duration_ms": 3521
        }
      ]
    },
    {
      "index": 4,
      "text": "ですから、町へぶしを探しに行きました。",
      "start_ms": 22823,
      "end_ms": 28281,
      "duration_ms": 5458,
      "clauses": [
        {
          "index": 0,
          "text": "ですから、",
          "start_ms": 22823,
          "end_ms": 24382,
          "duration_ms": 1559
        },
        {
