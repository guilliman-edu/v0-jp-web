          "text": "のうかの人たちが住んでいました。",
          "start_ms": 4924,
          "end_ms": 8341,
          "duration_ms": 3417
        }
      ]
    },
    {
      "index": 2,
      "text": "のぶし（わるいぶしたち）がいつもむらに来て、たべものを取りました。",
      "start_ms": 8841,
      "end_ms": 15866,
      "duration_ms": 7025,
      "clauses": [
        {
          "index": 0,
          "text": "のぶし（わるいぶしたち）がいつもむらに来て、",
