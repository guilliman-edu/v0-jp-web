          "end_ms": 28351,
          "duration_ms": 3625
        }
      ]
    },
    {
      "index": 5,
      "text": "町で、かんべえというぶしに会いました。",
      "start_ms": 28851,
      "end_ms": 33693,
      "duration_ms": 4842,
      "clauses": [
