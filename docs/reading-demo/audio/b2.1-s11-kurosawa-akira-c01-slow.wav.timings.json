          "duration_ms": 2098
        }
      ]
    },
    {
      "index": 1,
      "text": "くろさわあきらは1910年、とうきょうに生まれた。",
      "start_ms": 3634,
      "end_ms": 9729,
      "duration_ms": 6095,
      "clauses": [
        {
          "index": 0,
          "text": "くろさわあきらは1910年、",
          "start_ms": 3634,
          "end_ms": 7369,
          "duration_ms": 3735
        },
        {
          "index": 1,
          "text": "とうきょうに生まれた。",
          "start_ms": 7619,
          "end_ms": 9729,
          "duration_ms": 2110
        }
      ]
    },
    {
      "index": 2,
      "text": "八人のきょうだいがいた。",
      "start_ms": 10229,
      "end_ms": 12827,
      "duration_ms": 2598,
      "clauses": [
        {
          "index": 0,
          "text": "八人のきょうだいがいた。",
          "start_ms": 10229,
          "end_ms": 12827,
          "duration_ms": 2598
        }
      ]
    },
    {
      "index": 3,
      "text": "ちちは厳しかったが、映画に興味があり、よくきょうだいをえいがかんに連れて行った。",
      "start_ms": 13327,
      "end_ms": 22119,
      "duration_ms": 8792,
      "clauses": [
        {
          "index": 0,
          "text": "ちちは厳しかったが、",
          "start_ms": 13327,
          "end_ms": 15750,
          "duration_ms": 2423
        },
        {
          "index": 1,
          "text": "映画に興味があり、",
          "start_ms": 16000,
          "end_ms": 18238,
          "duration_ms": 2238
        },
        {
          "index": 2,
          "text": "よくきょうだいをえいがかんに連れて行った。",
          "start_ms": 18488,
          "end_ms": 22119,
          "duration_ms": 3631
        }
      ]
    },
    {
      "index": 4,
      "text": "黒澤は若いときから映画を見ながら育った。",
      "start_ms": 22619,
      "end_ms": 26981,
      "duration_ms": 4362,
      "clauses": [
        {
          "index": 0,
          "text": "黒澤は若いときから映画を見ながら育った。",
          "start_ms": 22619,
          "end_ms": 26981,
          "duration_ms": 4362
        }
      ]
    },
    {
      "index": 5,
      "text": "小学校の先生は、黒澤のかいがを「とてもいい」と言ってくれた。",
      "start_ms": 27481,
      "end_ms": 34157,
      "duration_ms": 6676,
      "clauses": [
        {
          "index": 0,
          "text": "小学校の先生は、",
          "start_ms": 27481,
          "end_ms": 29986,
          "duration_ms": 2505
        },
        {
          "index": 1,
          "text": "黒澤のかいがを「とてもいい」と言ってくれた。",
          "start_ms": 30236,
          "end_ms": 34157,
          "duration_ms": 3921
        }
      ]
    },
    {
      "index": 6,
      "text": "それから、黒澤はかいがを描くことにむちゅうになった。",
      "start_ms": 34657,
      "end_ms": 40857,
      "duration_ms": 6200,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 34657,
          "end_ms": 36210,
          "duration_ms": 1553
        },
        {
          "index": 1,
          "text": "黒澤はかいがを描くことにむちゅうになった。",
          "start_ms": 36460,
          "end_ms": 40857,
          "duration_ms": 4397
        }
      ]
    },
    {
      "index": 7,
      "text": "学校ではしょうせつをたくさん読み、じんせいについても勉強した。",
      "start_ms": 41357,
      "end_ms": 47916,
      "duration_ms": 6559,
      "clauses": [
        {
          "index": 0,
          "text": "学校ではしょうせつをたくさん読み、",
          "start_ms": 41357,
          "end_ms": 44616,
          "duration_ms": 3259
        },
        {
          "index": 1,
          "text": "じんせいについても勉強した。",
          "start_ms": 44866,
          "end_ms": 47916,
          "duration_ms": 3050
        }
      ]
    },
    {
      "index": 8,
      "text": "はじめはかいがの仕事をしたいと思っていた。",
      "start_ms": 48416,
      "end_ms": 52709,
      "duration_ms": 4293,
      "clauses": [
        {
          "index": 0,
          "text": "はじめはかいがの仕事をしたいと思っていた。",
          "start_ms": 48416,
          "end_ms": 52709,
          "duration_ms": 4293
        }
      ]
    },
    {
      "index": 9,
      "text": "しかし、1936年に映画のかいしゃに入り、映画を作る人のそばで作り方を習った。",
      "start_ms": 53209,
      "end_ms": 63627,
      "duration_ms": 10418,
      "clauses": [
        {
          "index": 0,
          "text": "しかし、",
          "start_ms": 53209,
          "end_ms": 54669,
          "duration_ms": 1460
        },
        {
          "index": 1,
          "text": "1936年に映画のかいしゃに入り、",
          "start_ms": 54919,
          "end_ms": 59328,
          "duration_ms": 4409
        },
        {
          "index": 2,
          "text": "映画を作る人のそばで作り方を習った。",
