  "sentences": [
    {
      "index": 0,
      "text": "はしばみの木",
      "start_ms": 0,
      "end_ms": 1849,
      "duration_ms": 1849,
      "clauses": [
        {
          "index": 0,
          "text": "はしばみの木",
          "start_ms": 0,
          "end_ms": 1849,
          "duration_ms": 1849
        }
      ]
    },
    {
      "index": 1,
      "text": "たまたまある日、父親が町に行くところでした。",
      "start_ms": 2349,
      "end_ms": 7342,
      "duration_ms": 4993,
      "clauses": [
        {
          "index": 0,
          "text": "たまたまある日、",
          "start_ms": 2349,
          "end_ms": 4198,
          "duration_ms": 1849
        },
        {
          "index": 1,
          "text": "父親が町に行くところでした。",
          "start_ms": 4448,
          "end_ms": 7342,
          "duration_ms": 2894
        }
      ]
    },
    {
      "index": 2,
      "text": "二人のこいもうとに「お土産に何がほしい？」",
      "start_ms": 7842,
      "end_ms": 11467,
      "duration_ms": 3625,
      "clauses": [
        {
          "index": 0,
          "text": "二人のこいもうとに「お土産に何がほしい？」",
          "start_ms": 7842,
          "end_ms": 11467,
          "duration_ms": 3625
        }
      ]
    },
    {
      "index": 3,
      "text": "と聞きました。",
      "start_ms": 11967,
      "end_ms": 13688,
      "duration_ms": 1721,
      "clauses": [
        {
          "index": 0,
          "text": "と聞きました。",
          "start_ms": 11967,
          "end_ms": 13688,
          "duration_ms": 1721
        }
      ]
    },
    {
      "index": 4,
      "text": "「きれいなドレスがいいです。」",
      "start_ms": 14188,
      "end_ms": 16443,
      "duration_ms": 2255,
      "clauses": [
        {
          "index": 0,
          "text": "「きれいなドレスがいいです。」",
          "start_ms": 14188,
          "end_ms": 16443,
          "duration_ms": 2255
        }
      ]
    },
    {
      "index": 5,
      "text": "一人が言いました。",
      "start_ms": 16943,
      "end_ms": 18920,
      "duration_ms": 1977,
      "clauses": [
        {
          "index": 0,
          "text": "一人が言いました。",
          "start_ms": 16943,
          "end_ms": 18920,
          "duration_ms": 1977
        }
      ]
    },
    {
      "index": 6,
      "text": "「しんじゅとほうせきをお願いします。」",
      "start_ms": 19420,
      "end_ms": 22326,
      "duration_ms": 2906,
      "clauses": [
        {
          "index": 0,
          "text": "「しんじゅとほうせきをお願いします。」",
          "start_ms": 19420,
          "end_ms": 22326,
          "duration_ms": 2906
        }
      ]
    },
    {
      "index": 7,
      "text": "もう一人が言いました。",
      "start_ms": 22826,
      "end_ms": 24896,
      "duration_ms": 2070,
      "clauses": [
        {
          "index": 0,
          "text": "もう一人が言いました。",
          "start_ms": 22826,
          "end_ms": 24896,
          "duration_ms": 2070
        }
      ]
    },
    {
      "index": 8,
      "text": "「それでは、シンデレラ、あなたは何かほしいものがある？」",
      "start_ms": 25396,
      "end_ms": 31965,
      "duration_ms": 6569,
      "clauses": [
        {
          "index": 0,
          "text": "「それでは、",
          "start_ms": 25396,
          "end_ms": 26827,
          "duration_ms": 1431
        },
        {
          "index": 1,
          "text": "シンデレラ、",
          "start_ms": 27077,
          "end_ms": 28624,
          "duration_ms": 1547
        },
        {
          "index": 2,
          "text": "あなたは何かほしいものがある？」",
          "start_ms": 28874,
          "end_ms": 31965,
          "duration_ms": 3091
        }
      ]
    },
    {
      "index": 9,
      "text": "「お父さん、帰り道で、お父さんのぼうしにぶつかる最初の枝を折ってきてください。」",
      "start_ms": 32465,
      "end_ms": 40625,
      "duration_ms": 8160,
      "clauses": [
        {
          "index": 0,
          "text": "「お父さん、",
          "start_ms": 32465,
          "end_ms": 33850,
          "duration_ms": 1385
        },
        {
          "index": 1,
          "text": "帰り道で、",
          "start_ms": 34100,
          "end_ms": 35705,
          "duration_ms": 1605
        },
        {
          "index": 2,
          "text": "お父さんのぼうしにぶつかる最初の枝を折ってきてください。」",
          "start_ms": 35955,
          "end_ms": 40625,
          "duration_ms": 4670
        }
      ]
    },
    {
      "index": 10,
      "text": "父親は二人のこいもうとにはドレスとしんじゅとほうせきを買いました。",
      "start_ms": 41125,
      "end_ms": 46678,
      "duration_ms": 5553,
      "clauses": [
        {
          "index": 0,
          "text": "父親は二人のこいもうとにはドレスとしんじゅとほうせきを買いました。",
          "start_ms": 41125,
          "end_ms": 46678,
          "duration_ms": 5553
        }
      ]
    },
    {
      "index": 11,
      "text": "帰り道に、緑のしげみを馬で通ったとき、はしばみの枝に当たりました。",
      "start_ms": 47178,
      "end_ms": 55036,
      "duration_ms": 7858,
      "clauses": [
        {
          "index": 0,
          "text": "帰り道に、",
          "start_ms": 47178,
          "end_ms": 48748,
          "duration_ms": 1570
        },
        {
          "index": 1,
          "text": "緑のしげみを馬で通ったとき、",
          "start_ms": 48998,
          "end_ms": 52078,
          "duration_ms": 3080
        },
        {
          "index": 2,
          "text": "はしばみの枝に当たりました。",
          "start_ms": 52328,
          "end_ms": 55036,
          "duration_ms": 2708
        }
      ]
    },
    {
      "index": 12,
      "text": "ぼうしが落ちたので、その枝を折って持ち帰りました。",
      "start_ms": 55536,
      "end_ms": 60762,
      "duration_ms": 5226,
      "clauses": [
        {
          "index": 0,
          "text": "ぼうしが落ちたので、",
          "start_ms": 55536,
          "end_ms": 57490,
          "duration_ms": 1954
        },
        {
          "index": 1,
          "text": "その枝を折って持ち帰りました。",
          "start_ms": 57740,
          "end_ms": 60762,
          "duration_ms": 3022
        }
      ]
    },
    {
      "index": 13,
      "text": "家に着くと、こいもうとには望んだ品物を渡しました。",
      "start_ms": 61262,
      "end_ms": 66882,
      "duration_ms": 5620,
      "clauses": [
        {
          "index": 0,
          "text": "家に着くと、",
          "start_ms": 61262,
          "end_ms": 62798,
          "duration_ms": 1536
        },
        {
          "index": 1,
          "text": "こいもうとには望んだ品物を渡しました。",
          "start_ms": 63048,
          "end_ms": 66882,
          "duration_ms": 3834
        }
      ]
    },
    {
      "index": 14,
      "text": "シンデレラには、はしばみの木から取った枝を渡しました。",
      "start_ms": 67382,
      "end_ms": 72932,
      "duration_ms": 5550,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラには、",
          "start_ms": 67382,
          "end_ms": 69138,
          "duration_ms": 1756
        },
        {
          "index": 1,
          "text": "はしばみの木から取った枝を渡しました。",
          "start_ms": 69388,
          "end_ms": 72932,
          "duration_ms": 3544
        }
      ]
    },
    {
      "index": 15,
      "text": "シンデレラは父親にお礼を言いました。",
      "start_ms": 73432,
      "end_ms": 77023,
      "duration_ms": 3591,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラは父親にお礼を言いました。",
          "start_ms": 73432,
          "end_ms": 77023,
          "duration_ms": 3591
        }
      ]
    },
    {
      "index": 16,
      "text": "それから、母親の墓に行って、枝を植えました。",
      "start_ms": 77523,
      "end_ms": 83605,
      "duration_ms": 6082,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 77523,
          "end_ms": 78942,
          "duration_ms": 1419
        },
        {
          "index": 1,
          "text": "母親の墓に行って、",
          "start_ms": 79192,
          "end_ms": 81436,
          "duration_ms": 2244
        },
        {
          "index": 2,
          "text": "枝を植えました。",
          "start_ms": 81686,
          "end_ms": 83605,
          "duration_ms": 1919
        }
      ]
    },
    {
      "index": 17,
      "text": "とても泣いたので、なみだが枝に落ちて、枝を濡らしました。",
      "start_ms": 84105,
      "end_ms": 90466,
      "duration_ms": 6361,
      "clauses": [
        {
          "index": 0,
          "text": "とても泣いたので、",
          "start_ms": 84105,
          "end_ms": 85838,
          "duration_ms": 1733
        },
        {
          "index": 1,
          "text": "なみだが枝に落ちて、",
          "start_ms": 86088,
          "end_ms": 88204,
          "duration_ms": 2116
        },
        {
          "index": 2,
          "text": "枝を濡らしました。",
          "start_ms": 88454,
          "end_ms": 90466,
          "duration_ms": 2012
        }
      ]
    },
    {
      "index": 18,
      "text": "すると、その枝は大きくなって、りっぱな木になりました。",
      "start_ms": 90966,
      "end_ms": 97362,
      "duration_ms": 6396,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 90966,
          "end_ms": 92142,
          "duration_ms": 1176
        },
        {
          "index": 1,
          "text": "その枝は大きくなって、",
          "start_ms": 92392,
          "end_ms": 94868,
          "duration_ms": 2476
        },
        {
          "index": 2,
          "text": "りっぱな木になりました。",
          "start_ms": 95118,
          "end_ms": 97362,
          "duration_ms": 2244
        }
      ]
    },
    {
      "index": 19,
      "text": "日に三度、シンデレラはその木の下に行って座り、泣いて、お祈りをしました。",
      "start_ms": 97862,
      "end_ms": 106706,
      "duration_ms": 8844,
      "clauses": [
        {
          "index": 0,
          "text": "日に三度、",
          "start_ms": 97862,
          "end_ms": 99549,
          "duration_ms": 1687
        },
        {
          "index": 1,
          "text": "シンデレラはその木の下に行って座り、",
          "start_ms": 99799,
          "end_ms": 103285,
          "duration_ms": 3486
        },
        {
          "index": 2,
          "text": "泣いて、",
          "start_ms": 103535,
          "end_ms": 104537,
          "duration_ms": 1002
        },
        {
          "index": 3,
          "text": "お祈りをしました。",
          "start_ms": 104787,
          "end_ms": 106706,
          "duration_ms": 1919
        }
      ]
    },
    {
      "index": 20,
      "text": "すると、一羽の小さい白い鳥がその木に来て、シンデレラが何かを望むと、その鳥が望んだものを落としてくれました。",
      "start_ms": 107206,
      "end_ms": 119288,
      "duration_ms": 12082,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 107206,
          "end_ms": 108370,
          "duration_ms": 1164
        },
        {
          "index": 1,
          "text": "一羽の小さい白い鳥がその木に来て、",
          "start_ms": 108620,
          "end_ms": 112478,
          "duration_ms": 3858
        },
        {
          "index": 2,
          "text": "シンデレラが何かを望むと、",
          "start_ms": 112728,
          "end_ms": 115517,
          "duration_ms": 2789
        },
        {
          "index": 3,
          "text": "その鳥が望んだものを落としてくれました。",
          "start_ms": 115767,
          "end_ms": 119288,
          "duration_ms": 3521
        }
      ]
    }
  ]
}