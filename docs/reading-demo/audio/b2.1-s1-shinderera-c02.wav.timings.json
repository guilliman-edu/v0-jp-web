  "sentences": [
    {
      "index": 0,
      "text": "はしばみの木",
      "start_ms": 0,
      "end_ms": 1849,
      "duration_ms": 1849,
      "clauses": [
        {
          "index": 0,
          "text": "はしばみの木",
          "start_ms": 0,
          "end_ms": 1849,
          "duration_ms": 1849
        }
      ]
    },
    {
      "index": 1,
      "text": "たまたまある日、父親が町に行くところでした。",
      "start_ms": 2349,
      "end_ms": 7319,
      "duration_ms": 4970,
      "clauses": [
        {
          "index": 0,
          "text": "たまたまある日、",
          "start_ms": 2349,
          "end_ms": 4198,
          "duration_ms": 1849
        },
        {
          "index": 1,
          "text": "父親が町に行くところでした。",
          "start_ms": 4448,
          "end_ms": 7319,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 2,
      "text": "二人のままむすめに「お土産に何がほしい？」",
      "start_ms": 7819,
      "end_ms": 11479,
      "duration_ms": 3660,
      "clauses": [
        {
          "index": 0,
          "text": "二人のままむすめに「お土産に何がほしい？」",
          "start_ms": 7819,
          "end_ms": 11479,
          "duration_ms": 3660
        }
      ]
    },
    {
      "index": 3,
      "text": "と聞きました。",
      "start_ms": 11979,
      "end_ms": 13735,
      "duration_ms": 1756,
      "clauses": [
        {
          "index": 0,
          "text": "と聞きました。",
          "start_ms": 11979,
          "end_ms": 13735,
          "duration_ms": 1756
        }
      ]
    },
    {
      "index": 4,
      "text": "「きれいなドレスがいいです。」",
      "start_ms": 14235,
      "end_ms": 16548,
      "duration_ms": 2313,
      "clauses": [
        {
          "index": 0,
          "text": "「きれいなドレスがいいです。」",
          "start_ms": 14235,
          "end_ms": 16548,
          "duration_ms": 2313
        }
      ]
    },
    {
      "index": 5,
      "text": "一人が言いました。",
      "start_ms": 17048,
      "end_ms": 18990,
      "duration_ms": 1942,
      "clauses": [
        {
          "index": 0,
          "text": "一人が言いました。",
          "start_ms": 17048,
          "end_ms": 18990,
          "duration_ms": 1942
        }
      ]
    },
    {
      "index": 6,
      "text": "「しんじゅとほうせきをお願いします。」",
      "start_ms": 19490,
      "end_ms": 22372,
      "duration_ms": 2882,
      "clauses": [
        {
          "index": 0,
          "text": "「しんじゅとほうせきをお願いします。」",
          "start_ms": 19490,
          "end_ms": 22372,
          "duration_ms": 2882
        }
      ]
    },
    {
      "index": 7,
      "text": "もう一人が言いました。",
      "start_ms": 22872,
      "end_ms": 24976,
      "duration_ms": 2104,
      "clauses": [
        {
          "index": 0,
          "text": "もう一人が言いました。",
          "start_ms": 22872,
          "end_ms": 24976,
          "duration_ms": 2104
        }
      ]
    },
    {
      "index": 8,
      "text": "「それでは、シンデレラ、あなたは何かほしいものがある？」",
      "start_ms": 25476,
      "end_ms": 31918,
      "duration_ms": 6442,
      "clauses": [
        {
          "index": 0,
          "text": "「それでは、",
          "start_ms": 25476,
          "end_ms": 26884,
          "duration_ms": 1408
        },
        {
          "index": 1,
          "text": "シンデレラ、",
          "start_ms": 27134,
          "end_ms": 28646,
          "duration_ms": 1512
        },
        {
          "index": 2,
          "text": "あなたは何かほしいものがある？」",
          "start_ms": 28896,
          "end_ms": 31918,
          "duration_ms": 3022
        }
      ]
    },
    {
      "index": 9,
      "text": "「お父さん、帰り道で、お父さんのぼうしにぶつかる最初の枝を折ってきてください。」",
      "start_ms": 32418,
      "end_ms": 40578,
      "duration_ms": 8160,
      "clauses": [
        {
          "index": 0,
          "text": "「お父さん、",
          "start_ms": 32418,
          "end_ms": 33861,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "帰り道で、",
          "start_ms": 34111,
          "end_ms": 35693,
          "duration_ms": 1582
        },
        {
          "index": 2,
          "text": "お父さんのぼうしにぶつかる最初の枝を折ってきてください。」",
          "start_ms": 35943,
          "end_ms": 40578,
          "duration_ms": 4635
        }
      ]
    },
    {
      "index": 10,
      "text": "父親は二人のままむすめにはドレスとしんじゅとほうせきを買いました。",
      "start_ms": 41078,
      "end_ms": 46665,
      "duration_ms": 5587,
      "clauses": [
        {
          "index": 0,
          "text": "父親は二人のままむすめにはドレスとしんじゅとほうせきを買いました。",
          "start_ms": 41078,
          "end_ms": 46665,
          "duration_ms": 5587
        }
      ]
    },
    {
      "index": 11,
      "text": "帰り道に、緑のしげみを馬で通ったとき、はしばみの枝に当たりました。",
      "start_ms": 47165,
      "end_ms": 54988,
      "duration_ms": 7823,
      "clauses": [
        {
          "index": 0,
          "text": "帰り道に、",
          "start_ms": 47165,
          "end_ms": 48793,
          "duration_ms": 1628
        },
        {
          "index": 1,
          "text": "緑のしげみを馬で通ったとき、",
          "start_ms": 49043,
          "end_ms": 52099,
          "duration_ms": 3056
        },
        {
          "index": 2,
          "text": "はしばみの枝に当たりました。",
          "start_ms": 52349,
          "end_ms": 54988,
          "duration_ms": 2639
        }
      ]
    },
    {
      "index": 12,
      "text": "ぼうしが落ちたので、その枝を折って持ち帰りました。",
      "start_ms": 55488,
      "end_ms": 60644,
      "duration_ms": 5156,
      "clauses": [
        {
          "index": 0,
          "text": "ぼうしが落ちたので、",
          "start_ms": 55488,
          "end_ms": 57407,
          "duration_ms": 1919
        },
        {
          "index": 1,
          "text": "その枝を折って持ち帰りました。",
          "start_ms": 57657,
          "end_ms": 60644,
          "duration_ms": 2987
        }
      ]
    },
    {
      "index": 13,
      "text": "家に着くと、ままむすめには望んだ品物を渡しました。",
      "start_ms": 61144,
      "end_ms": 66857,
      "duration_ms": 5713,
      "clauses": [
        {
          "index": 0,
          "text": "家に着くと、",
          "start_ms": 61144,
          "end_ms": 62761,
          "duration_ms": 1617
        },
        {
          "index": 1,
          "text": "ままむすめには望んだ品物を渡しました。",
          "start_ms": 63011,
          "end_ms": 66857,
          "duration_ms": 3846
        }
      ]
    },
    {
      "index": 14,
      "text": "シンデレラには、はしばみの木から取った枝を渡しました。",
      "start_ms": 67357,
      "end_ms": 72849,
      "duration_ms": 5492,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラには、",
          "start_ms": 67357,
          "end_ms": 69090,
          "duration_ms": 1733
        },
        {
          "index": 1,
          "text": "はしばみの木から取った枝を渡しました。",
          "start_ms": 69340,
          "end_ms": 72849,
          "duration_ms": 3509
        }
      ]
    },
    {
      "index": 15,
      "text": "シンデレラは父親にお礼を言いました。",
      "start_ms": 73349,
      "end_ms": 76916,
      "duration_ms": 3567,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラは父親にお礼を言いました。",
          "start_ms": 73349,
          "end_ms": 76916,
          "duration_ms": 3567
        }
      ]
    },
    {
      "index": 16,
      "text": "それから、母親の墓に行って、枝を植えました。",
      "start_ms": 77416,
      "end_ms": 83486,
      "duration_ms": 6070,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 77416,
          "end_ms": 78835,
          "duration_ms": 1419
        },
        {
          "index": 1,
          "text": "母親の墓に行って、",
          "start_ms": 79085,
          "end_ms": 81329,
          "duration_ms": 2244
        },
        {
          "index": 2,
          "text": "枝を植えました。",
          "start_ms": 81579,
          "end_ms": 83486,
          "duration_ms": 1907
        }
      ]
    },
    {
      "index": 17,
      "text": "とても泣いたので、なみだが枝に落ちて、枝を濡らしました。",
      "start_ms": 83986,
      "end_ms": 90463,
      "duration_ms": 6477,
      "clauses": [
        {
          "index": 0,
          "text": "とても泣いたので、",
          "start_ms": 83986,
          "end_ms": 85812,
          "duration_ms": 1826
        },
        {
          "index": 1,
          "text": "なみだが枝に落ちて、",
          "start_ms": 86062,
          "end_ms": 88213,
          "duration_ms": 2151
        },
        {
          "index": 2,
          "text": "枝を濡らしました。",
          "start_ms": 88463,
          "end_ms": 90463,
          "duration_ms": 2000
        }
      ]
    },
    {
      "index": 18,
      "text": "すると、その枝は大きくなって、りっぱな木になりました。",
      "start_ms": 90963,
      "end_ms": 97336,
      "duration_ms": 6373,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 90963,
          "end_ms": 92139,
          "duration_ms": 1176
        },
        {
          "index": 1,
          "text": "その枝は大きくなって、",
          "start_ms": 92389,
          "end_ms": 94900,
          "duration_ms": 2511
        },
        {
          "index": 2,
          "text": "りっぱな木になりました。",
          "start_ms": 95150,
          "end_ms": 97336,
          "duration_ms": 2186
        }
      ]
    },
    {
      "index": 19,
      "text": "日に三度、シンデレラはその木の下に行って座り、泣いて、お祈りをしました。",
      "start_ms": 97836,
      "end_ms": 106644,
      "duration_ms": 8808,
      "clauses": [
        {
          "index": 0,
          "text": "日に三度、",
          "start_ms": 97836,
          "end_ms": 99488,
          "duration_ms": 1652
        },
        {
          "index": 1,
          "text": "シンデレラはその木の下に行って座り、",
          "start_ms": 99738,
          "end_ms": 103212,
          "duration_ms": 3474
        },
        {
          "index": 2,
          "text": "泣いて、",
          "start_ms": 103462,
          "end_ms": 104429,
          "duration_ms": 967
        },
        {
          "index": 3,
          "text": "お祈りをしました。",
          "start_ms": 104679,
          "end_ms": 106644,
          "duration_ms": 1965
        }
      ]
    },
    {
      "index": 20,
      "text": "すると、一羽の小さい白い鳥がその木に来て、シンデレラが何かを望むと、その鳥が望んだものを落としてくれました。",
      "start_ms": 107144,
      "end_ms": 119179,
      "duration_ms": 12035,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 107144,
          "end_ms": 108331,
          "duration_ms": 1187
        },
        {
          "index": 1,
          "text": "一羽の小さい白い鳥がその木に来て、",
          "start_ms": 108581,
          "end_ms": 112299,
          "duration_ms": 3718
        },
        {
          "index": 2,
          "text": "シンデレラが何かを望むと、",
          "start_ms": 112549,
          "end_ms": 115408,
          "duration_ms": 2859
        },
        {
          "index": 3,
          "text": "その鳥が望んだものを落としてくれました。",
          "start_ms": 115658,
          "end_ms": 119179,
          "duration_ms": 3521
        }
      ]
    }
  ]
}