  "sentences": [
    {
      "index": 0,
      "text": "はしばみの木",
      "start_ms": 0,
      "end_ms": 1884,
      "duration_ms": 1884,
      "clauses": [
        {
          "index": 0,
          "text": "はしばみの木",
          "start_ms": 0,
          "end_ms": 1884,
          "duration_ms": 1884
        }
      ]
    },
    {
      "index": 1,
      "text": "たまたまある日、父親が町に行くところでした。",
      "start_ms": 2384,
      "end_ms": 7388,
      "duration_ms": 5004,
      "clauses": [
        {
          "index": 0,
          "text": "たまたまある日、",
          "start_ms": 2384,
          "end_ms": 4279,
          "duration_ms": 1895
        },
        {
          "index": 1,
          "text": "父親が町に行くところでした。",
          "start_ms": 4529,
          "end_ms": 7388,
          "duration_ms": 2859
        }
      ]
    },
    {
      "index": 2,
      "text": "二人の継娘に「お土産に何がほしい？",
      "start_ms": 7888,
      "end_ms": 11571,
      "duration_ms": 3683,
      "clauses": [
        {
          "index": 0,
          "text": "二人の継娘に「お土産に何がほしい？",
          "start_ms": 7888,
          "end_ms": 11571,
          "duration_ms": 3683
        }
      ]
    },
    {
      "index": 3,
      "text": "」と聞きました。",
      "start_ms": 12071,
      "end_ms": 13827,
      "duration_ms": 1756,
      "clauses": [
        {
          "index": 0,
          "text": "」と聞きました。",
          "start_ms": 12071,
          "end_ms": 13827,
          "duration_ms": 1756
        }
      ]
    },
    {
      "index": 4,
      "text": "「きれいなドレスがいいです。",
      "start_ms": 14327,
      "end_ms": 16582,
      "duration_ms": 2255,
      "clauses": [
        {
          "index": 0,
          "text": "「きれいなドレスがいいです。",
          "start_ms": 14327,
          "end_ms": 16582,
          "duration_ms": 2255
        }
      ]
    },
    {
      "index": 5,
      "text": "」一人が言いました。",
      "start_ms": 17082,
      "end_ms": 19024,
      "duration_ms": 1942,
      "clauses": [
        {
          "index": 0,
          "text": "」一人が言いました。",
          "start_ms": 17082,
          "end_ms": 19024,
          "duration_ms": 1942
        }
      ]
    },
    {
      "index": 6,
      "text": "「真珠と宝石をお願いします。",
      "start_ms": 19524,
      "end_ms": 22395,
      "duration_ms": 2871,
      "clauses": [
        {
          "index": 0,
          "text": "「真珠と宝石をお願いします。",
          "start_ms": 19524,
          "end_ms": 22395,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 7,
      "text": "」もう一人が言いました。",
      "start_ms": 22895,
      "end_ms": 25034,
      "duration_ms": 2139,
      "clauses": [
        {
          "index": 0,
          "text": "」もう一人が言いました。",
          "start_ms": 22895,
          "end_ms": 25034,
          "duration_ms": 2139
        }
      ]
    },
    {
      "index": 8,
      "text": "「それでは、シンデレラ、あなたは何かほしいものがある？",
      "start_ms": 25534,
      "end_ms": 31791,
      "duration_ms": 6257,
      "clauses": [
        {
          "index": 0,
          "text": "「それでは、",
          "start_ms": 25534,
          "end_ms": 26907,
          "duration_ms": 1373
        },
        {
          "index": 1,
          "text": "シンデレラ、",
          "start_ms": 27157,
          "end_ms": 28635,
          "duration_ms": 1478
        },
        {
          "index": 2,
          "text": "あなたは何かほしいものがある？",
          "start_ms": 28885,
          "end_ms": 31791,
          "duration_ms": 2906
        }
      ]
    },
    {
      "index": 9,
      "text": "」 「お父さん、帰り道で、お父さんの帽子にぶつかる最初の枝を折ってきてください。",
      "start_ms": 32291,
      "end_ms": 40358,
      "duration_ms": 8067,
      "clauses": [
        {
          "index": 0,
          "text": "」 「お父さん、",
          "start_ms": 32291,
          "end_ms": 33652,
          "duration_ms": 1361
        },
        {
          "index": 1,
          "text": "帰り道で、",
          "start_ms": 33902,
          "end_ms": 35507,
          "duration_ms": 1605
        },
        {
          "index": 2,
          "text": "お父さんの帽子にぶつかる最初の枝を折ってきてください。",
          "start_ms": 35757,
          "end_ms": 40358,
          "duration_ms": 4601
        }
      ]
    },
    {
      "index": 10,
      "text": "」 父親は二人の継娘にはドレスと真珠と宝石を買いました。",
      "start_ms": 40858,
      "end_ms": 46469,
      "duration_ms": 5611,
      "clauses": [
        {
          "index": 0,
          "text": "」 父親は二人の継娘にはドレスと真珠と宝石を買いました。",
          "start_ms": 40858,
          "end_ms": 46469,
          "duration_ms": 5611
        }
      ]
    },
    {
      "index": 11,
      "text": "帰り道に、緑の茂みを馬で通ったとき、はしばみの枝に当たりました。",
      "start_ms": 46969,
      "end_ms": 54757,
      "duration_ms": 7788,
      "clauses": [
        {
          "index": 0,
          "text": "帰り道に、",
          "start_ms": 46969,
          "end_ms": 48551,
          "duration_ms": 1582
        },
        {
          "index": 1,
          "text": "緑の茂みを馬で通ったとき、",
          "start_ms": 48801,
          "end_ms": 51834,
          "duration_ms": 3033
        },
        {
          "index": 2,
          "text": "はしばみの枝に当たりました。",
          "start_ms": 52084,
          "end_ms": 54757,
          "duration_ms": 2673
        }
      ]
    },
    {
      "index": 12,
      "text": "帽子が落ちたので、その枝を折って持ち帰りました。",
      "start_ms": 55257,
      "end_ms": 60482,
      "duration_ms": 5225,
      "clauses": [
        {
          "index": 0,
          "text": "帽子が落ちたので、",
          "start_ms": 55257,
          "end_ms": 57222,
          "duration_ms": 1965
        },
        {
          "index": 1,
          "text": "その枝を折って持ち帰りました。",
          "start_ms": 57472,
          "end_ms": 60482,
          "duration_ms": 3010
        }
      ]
    },
    {
      "index": 13,
      "text": "家に着くと、継娘には望んだ品物を渡しました。",
      "start_ms": 60982,
      "end_ms": 66578,
      "duration_ms": 5596,
      "clauses": [
        {
          "index": 0,
          "text": "家に着くと、",
          "start_ms": 60982,
          "end_ms": 62494,
          "duration_ms": 1512
        },
        {
          "index": 1,
          "text": "継娘には望んだ品物を渡しました。",
          "start_ms": 62744,
          "end_ms": 66578,
          "duration_ms": 3834
        }
      ]
    },
    {
      "index": 14,
      "text": "シンデレラには、はしばみの木から取った枝を渡しました。",
      "start_ms": 67078,
      "end_ms": 72628,
      "duration_ms": 5550,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラには、",
          "start_ms": 67078,
          "end_ms": 68799,
          "duration_ms": 1721
        },
        {
          "index": 1,
          "text": "はしばみの木から取った枝を渡しました。",
          "start_ms": 69049,
          "end_ms": 72628,
          "duration_ms": 3579
        }
      ]
    },
    {
      "index": 15,
      "text": "シンデレラは父親にお礼を言いました。",
      "start_ms": 73128,
      "end_ms": 76707,
      "duration_ms": 3579,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラは父親にお礼を言いました。",
          "start_ms": 73128,
          "end_ms": 76707,
          "duration_ms": 3579
        }
      ]
    },
    {
      "index": 16,
      "text": "それから、母親の墓に行って、枝を植えました。",
      "start_ms": 77207,
      "end_ms": 83254,
      "duration_ms": 6047,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 77207,
          "end_ms": 78638,
          "duration_ms": 1431
        },
        {
          "index": 1,
          "text": "母親の墓に行って、",
          "start_ms": 78888,
          "end_ms": 81109,
          "duration_ms": 2221
        },
        {
          "index": 2,
          "text": "枝を植えました。",
          "start_ms": 81359,
          "end_ms": 83254,
          "duration_ms": 1895
        }
      ]
    },
    {
      "index": 17,
      "text": "とても泣いたので、涙が枝に落ちて、枝を濡らしました。",
      "start_ms": 83754,
      "end_ms": 90149,
      "duration_ms": 6395,
      "clauses": [
        {
          "index": 0,
          "text": "とても泣いたので、",
          "start_ms": 83754,
          "end_ms": 85580,
          "duration_ms": 1826
        },
        {
          "index": 1,
          "text": "涙が枝に落ちて、",
          "start_ms": 85830,
          "end_ms": 87911,
          "duration_ms": 2081
        },
        {
          "index": 2,
          "text": "枝を濡らしました。",
          "start_ms": 88161,
          "end_ms": 90149,
          "duration_ms": 1988
        }
      ]
    },
    {
      "index": 18,
      "text": "すると、その枝は大きくなって、立派な木になりました。",
      "start_ms": 90649,
      "end_ms": 97160,
      "duration_ms": 6511,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 90649,
          "end_ms": 91836,
          "duration_ms": 1187
        },
        {
          "index": 1,
          "text": "その枝は大きくなって、",
          "start_ms": 92086,
          "end_ms": 94643,
          "duration_ms": 2557
        },
        {
          "index": 2,
          "text": "立派な木になりました。",
          "start_ms": 94893,
          "end_ms": 97160,
          "duration_ms": 2267
        }
      ]
    },
    {
      "index": 19,
      "text": "日に三度、シンデレラはその木の下に行って座り、泣いて、お祈りをしました。",
      "start_ms": 97660,
      "end_ms": 106398,
      "duration_ms": 8738,
      "clauses": [
        {
          "index": 0,
          "text": "日に三度、",
          "start_ms": 97660,
          "end_ms": 99277,
          "duration_ms": 1617
        },
        {
          "index": 1,
          "text": "シンデレラはその木の下に行って座り、",
          "start_ms": 99527,
          "end_ms": 103013,
          "duration_ms": 3486
        },
        {
          "index": 2,
          "text": "泣いて、",
          "start_ms": 103263,
          "end_ms": 104241,
          "duration_ms": 978
        },
        {
          "index": 3,
          "text": "お祈りをしました。",
          "start_ms": 104491,
          "end_ms": 106398,
          "duration_ms": 1907
        }
      ]
    },
    {
      "index": 20,
      "text": "すると、一羽の小さい白い鳥がその木に来て、シンデレラが何かを望むと、その鳥が望んだものを落としてくれました。",
      "start_ms": 106898,
      "end_ms": 118969,
      "duration_ms": 12071,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 106898,
          "end_ms": 108062,
          "duration_ms": 1164
        },
        {
          "index": 1,
          "text": "一羽の小さい白い鳥がその木に来て、",
          "start_ms": 108312,
          "end_ms": 112077,
          "duration_ms": 3765
        },
        {
          "index": 2,
          "text": "シンデレラが何かを望むと、",
          "start_ms": 112327,
          "end_ms": 115163,
          "duration_ms": 2836
        },
        {
          "index": 3,
          "text": "その鳥が望んだものを落としてくれました。",
          "start_ms": 115413,
          "end_ms": 118969,
          "duration_ms": 3556
        }
      ]
    }
  ]
}