  "sentences": [
    {
      "index": 0,
      "text": "はしばみの木",
      "start_ms": 0,
      "end_ms": 2064,
      "duration_ms": 2064,
      "clauses": [
        {
          "index": 0,
          "text": "はしばみの木",
          "start_ms": 0,
          "end_ms": 2064,
          "duration_ms": 2064
        }
      ]
    },
    {
      "index": 1,
      "text": "たまたまある日、父親が町に行くところでした。",
      "start_ms": 2564,
      "end_ms": 8021,
      "duration_ms": 5457,
      "clauses": [
        {
          "index": 0,
          "text": "たまたまある日、",
          "start_ms": 2564,
          "end_ms": 4604,
          "duration_ms": 2040
        },
        {
          "index": 1,
          "text": "父親が町に行くところでした。",
          "start_ms": 4854,
          "end_ms": 8021,
          "duration_ms": 3167
        }
      ]
    },
    {
      "index": 2,
      "text": "二人のこいもうとに「お土産に何がほしい？」",
      "start_ms": 8521,
      "end_ms": 12384,
      "duration_ms": 3863,
      "clauses": [
        {
          "index": 0,
          "text": "二人のこいもうとに「お土産に何がほしい？」",
          "start_ms": 8521,
          "end_ms": 12384,
          "duration_ms": 3863
        }
      ]
    },
    {
      "index": 3,
      "text": "と聞きました。",
      "start_ms": 12884,
      "end_ms": 14773,
      "duration_ms": 1889,
      "clauses": [
        {
          "index": 0,
          "text": "と聞きました。",
          "start_ms": 12884,
          "end_ms": 14773,
          "duration_ms": 1889
        }
      ]
    },
    {
      "index": 4,
      "text": "「きれいなドレスがいいです。」",
      "start_ms": 15273,
      "end_ms": 17755,
      "duration_ms": 2482,
      "clauses": [
        {
          "index": 0,
          "text": "「きれいなドレスがいいです。」",
          "start_ms": 15273,
          "end_ms": 17755,
          "duration_ms": 2482
        }
      ]
    },
    {
      "index": 5,
      "text": "一人が言いました。",
      "start_ms": 18255,
      "end_ms": 20388,
      "duration_ms": 2133,
      "clauses": [
        {
          "index": 0,
          "text": "一人が言いました。",
          "start_ms": 18255,
          "end_ms": 20388,
          "duration_ms": 2133
        }
      ]
    },
    {
      "index": 6,
      "text": "「しんじゅとほうせきをお願いします。」",
      "start_ms": 20888,
      "end_ms": 24043,
      "duration_ms": 3155,
      "clauses": [
        {
          "index": 0,
          "text": "「しんじゅとほうせきをお願いします。」",
          "start_ms": 20888,
          "end_ms": 24043,
          "duration_ms": 3155
        }
      ]
    },
    {
      "index": 7,
      "text": "もう一人が言いました。",
      "start_ms": 24543,
      "end_ms": 26862,
      "duration_ms": 2319,
      "clauses": [
        {
          "index": 0,
          "text": "もう一人が言いました。",
          "start_ms": 24543,
          "end_ms": 26862,
          "duration_ms": 2319
        }
      ]
    },
    {
      "index": 8,
      "text": "「それでは、シンデレラ、あなたは何かほしいものがある？」",
      "start_ms": 27362,
      "end_ms": 34471,
      "duration_ms": 7109,
      "clauses": [
        {
          "index": 0,
          "text": "「それでは、",
          "start_ms": 27362,
          "end_ms": 28915,
          "duration_ms": 1553
        },
        {
          "index": 1,
          "text": "シンデレラ、",
          "start_ms": 29165,
          "end_ms": 30822,
          "duration_ms": 1657
        },
        {
          "index": 2,
          "text": "あなたは何かほしいものがある？」",
          "start_ms": 31072,
          "end_ms": 34471,
          "duration_ms": 3399
        }
      ]
    },
    {
      "index": 9,
      "text": "「お父さん、帰り道で、お父さんのぼうしにぶつかる最初の枝を折ってきてください。」",
      "start_ms": 34971,
      "end_ms": 43868,
      "duration_ms": 8897,
      "clauses": [
        {
          "index": 0,
          "text": "「お父さん、",
          "start_ms": 34971,
          "end_ms": 36547,
          "duration_ms": 1576
        },
        {
          "index": 1,
          "text": "帰り道で、",
          "start_ms": 36797,
          "end_ms": 38582,
          "duration_ms": 1785
        },
        {
          "index": 2,
          "text": "お父さんのぼうしにぶつかる最初の枝を折ってきてください。」",
          "start_ms": 38832,
          "end_ms": 43868,
          "duration_ms": 5036
        }
      ]
    },
    {
      "index": 10,
      "text": "父親は二人のこいもうとにはドレスとしんじゅとほうせきを買いました。",
      "start_ms": 44368,
      "end_ms": 50333,
      "duration_ms": 5965,
      "clauses": [
        {
          "index": 0,
          "text": "父親は二人のこいもうとにはドレスとしんじゅとほうせきを買いました。",
          "start_ms": 44368,
          "end_ms": 50333,
          "duration_ms": 5965
        }
      ]
    },
    {
      "index": 11,
      "text": "帰り道に、緑のしげみを馬で通ったとき、はしばみの枝に当たりました。",
      "start_ms": 50833,
      "end_ms": 59463,
      "duration_ms": 8630,
      "clauses": [
        {
          "index": 0,
          "text": "帰り道に、",
          "start_ms": 50833,
          "end_ms": 52606,
          "duration_ms": 1773
        },
        {
          "index": 1,
          "text": "緑のしげみを馬で通ったとき、",
          "start_ms": 52856,
          "end_ms": 56255,
          "duration_ms": 3399
        },
        {
          "index": 2,
          "text": "はしばみの枝に当たりました。",
          "start_ms": 56505,
          "end_ms": 59463,
          "duration_ms": 2958
        }
      ]
    },
    {
      "index": 12,
      "text": "ぼうしが落ちたので、その枝を折って持ち帰りました。",
      "start_ms": 59963,
      "end_ms": 65641,
      "duration_ms": 5678,
      "clauses": [
        {
          "index": 0,
          "text": "ぼうしが落ちたので、",
          "start_ms": 59963,
          "end_ms": 62085,
          "duration_ms": 2122
        },
        {
          "index": 1,
          "text": "その枝を折って持ち帰りました。",
          "start_ms": 62335,
          "end_ms": 65641,
          "duration_ms": 3306
        }
      ]
    },
    {
      "index": 13,
      "text": "家に着くと、こいもうとには望んだ品物を渡しました。",
      "start_ms": 66141,
      "end_ms": 72445,
      "duration_ms": 6304,
      "clauses": [
        {
          "index": 0,
          "text": "家に着くと、",
          "start_ms": 66141,
          "end_ms": 67914,
          "duration_ms": 1773
        },
        {
          "index": 1,
          "text": "こいもうとには望んだ品物を渡しました。",
          "start_ms": 68164,
          "end_ms": 72445,
          "duration_ms": 4281
        }
      ]
    },
    {
      "index": 14,
      "text": "シンデレラには、はしばみの木から取った枝を渡しました。",
      "start_ms": 72945,
      "end_ms": 79214,
      "duration_ms": 6269,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラには、",
          "start_ms": 72945,
          "end_ms": 74904,
          "duration_ms": 1959
        },
        {
          "index": 1,
          "text": "はしばみの木から取った枝を渡しました。",
          "start_ms": 75154,
          "end_ms": 79214,
          "duration_ms": 4060
        }
      ]
    },
    {
      "index": 15,
      "text": "シンデレラは父親にお礼を言いました。",
      "start_ms": 79714,
      "end_ms": 83612,
      "duration_ms": 3898,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラは父親にお礼を言いました。",
          "start_ms": 79714,
          "end_ms": 83612,
          "duration_ms": 3898
        }
      ]
    },
    {
      "index": 16,
      "text": "それから、母親の墓に行って、枝を植えました。",
      "start_ms": 84112,
      "end_ms": 90779,
      "duration_ms": 6667,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 84112,
          "end_ms": 85676,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "母親の墓に行って、",
          "start_ms": 85926,
          "end_ms": 88396,
          "duration_ms": 2470
        },
        {
          "index": 2,
          "text": "枝を植えました。",
          "start_ms": 88646,
          "end_ms": 90779,
          "duration_ms": 2133
        }
      ]
    },
    {
      "index": 17,
      "text": "とても泣いたので、なみだが枝に落ちて、枝を濡らしました。",
      "start_ms": 91279,
      "end_ms": 98307,
      "duration_ms": 7028,
      "clauses": [
        {
          "index": 0,
          "text": "とても泣いたので、",
          "start_ms": 91279,
          "end_ms": 93250,
          "duration_ms": 1971
        },
        {
          "index": 1,
          "text": "なみだが枝に落ちて、",
          "start_ms": 93500,
          "end_ms": 95831,
          "duration_ms": 2331
        },
        {
          "index": 2,
          "text": "枝を濡らしました。",
          "start_ms": 96081,
          "end_ms": 98307,
          "duration_ms": 2226
        }
      ]
    },
    {
      "index": 18,
      "text": "すると、その枝は大きくなって、りっぱな木になりました。",
      "start_ms": 98807,
      "end_ms": 105683,
      "duration_ms": 6876,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 98807,
          "end_ms": 100093,
          "duration_ms": 1286
        },
        {
          "index": 1,
          "text": "その枝は大きくなって、",
          "start_ms": 100343,
          "end_ms": 103010,
          "duration_ms": 2667
        },
        {
          "index": 2,
          "text": "りっぱな木になりました。",
          "start_ms": 103260,
          "end_ms": 105683,
          "duration_ms": 2423
        }
      ]
    },
    {
      "index": 19,
      "text": "日に三度、シンデレラはその木の下に行って座り、泣いて、お祈りをしました。",
      "start_ms": 106183,
      "end_ms": 115941,
      "duration_ms": 9758,
      "clauses": [
        {
          "index": 0,
          "text": "日に三度、",
          "start_ms": 106183,
          "end_ms": 108107,
          "duration_ms": 1924
        },
        {
          "index": 1,
          "text": "シンデレラはその木の下に行って座り、",
          "start_ms": 108357,
          "end_ms": 112150,
          "duration_ms": 3793
        },
        {
          "index": 2,
          "text": "泣いて、",
          "start_ms": 112400,
          "end_ms": 113535,
          "duration_ms": 1135
        },
        {
          "index": 3,
          "text": "お祈りをしました。",
          "start_ms": 113785,
          "end_ms": 115941,
          "duration_ms": 2156
        }
      ]
    },
    {
      "index": 20,
      "text": "すると、一羽の小さい白い鳥がその木に来て、シンデレラが何かを望むと、その鳥が望んだものを落としてくれました。",
      "start_ms": 116441,
      "end_ms": 129473,
      "duration_ms": 13032,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 116441,
          "end_ms": 117738,
          "duration_ms": 1297
        },
        {
          "index": 1,
          "text": "一羽の小さい白い鳥がその木に来て、",
          "start_ms": 117988,
          "end_ms": 122072,
          "duration_ms": 4084
        },
        {
          "index": 2,
          "text": "シンデレラが何かを望むと、",
          "start_ms": 122322,
          "end_ms": 125430,
          "duration_ms": 3108
        },
        {
          "index": 3,
          "text": "その鳥が望んだものを落としてくれました。",
          "start_ms": 125680,
          "end_ms": 129473,
          "duration_ms": 3793
        }
      ]
    }
  ]
