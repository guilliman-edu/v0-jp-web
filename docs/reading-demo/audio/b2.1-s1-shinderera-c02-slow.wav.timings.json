  "sentences": [
    {
      "index": 0,
      "text": "はしばみの木",
      "start_ms": 0,
      "end_ms": 1982,
      "duration_ms": 1982,
      "clauses": [
        {
          "index": 0,
          "text": "はしばみの木",
          "start_ms": 0,
          "end_ms": 1982,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 1,
      "text": "たまたまある日、父親が町に行くところでした。",
      "start_ms": 2482,
      "end_ms": 7915,
      "duration_ms": 5433,
      "clauses": [
        {
          "index": 0,
          "text": "たまたまある日、",
          "start_ms": 2482,
          "end_ms": 4522,
          "duration_ms": 2040
        },
        {
          "index": 1,
          "text": "父親が町に行くところでした。",
          "start_ms": 4772,
          "end_ms": 7915,
          "duration_ms": 3143
        }
      ]
    },
    {
      "index": 2,
      "text": "二人のままむすめに「お土産に何がほしい？」",
      "start_ms": 8415,
      "end_ms": 12406,
      "duration_ms": 3991,
      "clauses": [
        {
          "index": 0,
          "text": "二人のままむすめに「お土産に何がほしい？」",
          "start_ms": 8415,
          "end_ms": 12406,
          "duration_ms": 3991
        }
      ]
    },
    {
      "index": 3,
      "text": "と聞きました。",
      "start_ms": 12906,
      "end_ms": 14842,
      "duration_ms": 1936,
      "clauses": [
        {
          "index": 0,
          "text": "と聞きました。",
          "start_ms": 12906,
          "end_ms": 14842,
          "duration_ms": 1936
        }
      ]
    },
    {
      "index": 4,
      "text": "「きれいなドレスがいいです。」",
      "start_ms": 15342,
      "end_ms": 17870,
      "duration_ms": 2528,
      "clauses": [
        {
          "index": 0,
          "text": "「きれいなドレスがいいです。」",
          "start_ms": 15342,
          "end_ms": 17870,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 5,
      "text": "一人が言いました。",
      "start_ms": 18370,
      "end_ms": 20503,
      "duration_ms": 2133,
      "clauses": [
        {
          "index": 0,
          "text": "一人が言いました。",
          "start_ms": 18370,
          "end_ms": 20503,
          "duration_ms": 2133
        }
      ]
    },
    {
      "index": 6,
      "text": "「しんじゅとほうせきをお願いします。」",
      "start_ms": 21003,
      "end_ms": 24193,
      "duration_ms": 3190,
      "clauses": [
        {
          "index": 0,
          "text": "「しんじゅとほうせきをお願いします。」",
          "start_ms": 21003,
          "end_ms": 24193,
          "duration_ms": 3190
        }
      ]
    },
    {
      "index": 7,
      "text": "もう一人が言いました。",
      "start_ms": 24693,
      "end_ms": 27047,
      "duration_ms": 2354,
      "clauses": [
        {
          "index": 0,
          "text": "もう一人が言いました。",
          "start_ms": 24693,
          "end_ms": 27047,
          "duration_ms": 2354
        }
      ]
    },
    {
      "index": 8,
      "text": "「それでは、シンデレラ、あなたは何かほしいものがある？」",
      "start_ms": 27547,
      "end_ms": 34725,
      "duration_ms": 7178,
      "clauses": [
        {
          "index": 0,
          "text": "「それでは、",
          "start_ms": 27547,
          "end_ms": 29111,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "シンデレラ、",
          "start_ms": 29361,
          "end_ms": 31007,
          "duration_ms": 1646
        },
        {
          "index": 2,
          "text": "あなたは何かほしいものがある？」",
          "start_ms": 31257,
          "end_ms": 34725,
          "duration_ms": 3468
        }
      ]
    },
    {
      "index": 9,
      "text": "「お父さん、帰り道で、お父さんのぼうしにぶつかる最初の枝を折ってきてください。」",
      "start_ms": 35225,
      "end_ms": 44087,
      "duration_ms": 8862,
      "clauses": [
        {
          "index": 0,
          "text": "「お父さん、",
          "start_ms": 35225,
          "end_ms": 36755,
          "duration_ms": 1530
        },
        {
          "index": 1,
          "text": "帰り道で、",
          "start_ms": 37005,
          "end_ms": 38778,
          "duration_ms": 1773
        },
        {
          "index": 2,
          "text": "お父さんのぼうしにぶつかる最初の枝を折ってきてください。」",
          "start_ms": 39028,
          "end_ms": 44087,
          "duration_ms": 5059
        }
      ]
    },
    {
      "index": 10,
      "text": "父親は二人のままむすめにはドレスとしんじゅとほうせきを買いました。",
      "start_ms": 44587,
      "end_ms": 50691,
      "duration_ms": 6104,
      "clauses": [
        {
          "index": 0,
          "text": "父親は二人のままむすめにはドレスとしんじゅとほうせきを買いました。",
          "start_ms": 44587,
          "end_ms": 50691,
          "duration_ms": 6104
        }
      ]
    },
    {
      "index": 11,
      "text": "帰り道に、緑のしげみを馬で通ったとき、はしばみの枝に当たりました。",
      "start_ms": 51191,
      "end_ms": 59763,
      "duration_ms": 8572,
      "clauses": [
        {
          "index": 0,
          "text": "帰り道に、",
          "start_ms": 51191,
          "end_ms": 52976,
          "duration_ms": 1785
        },
        {
          "index": 1,
          "text": "緑のしげみを馬で通ったとき、",
          "start_ms": 53226,
          "end_ms": 56590,
          "duration_ms": 3364
        },
        {
          "index": 2,
          "text": "はしばみの枝に当たりました。",
          "start_ms": 56840,
          "end_ms": 59763,
          "duration_ms": 2923
        }
      ]
    },
    {
      "index": 12,
      "text": "ぼうしが落ちたので、その枝を折って持ち帰りました。",
      "start_ms": 60263,
      "end_ms": 65848,
      "duration_ms": 5585,
      "clauses": [
        {
          "index": 0,
          "text": "ぼうしが落ちたので、",
          "start_ms": 60263,
          "end_ms": 62350,
          "duration_ms": 2087
        },
        {
          "index": 1,
          "text": "その枝を折って持ち帰りました。",
          "start_ms": 62600,
          "end_ms": 65848,
          "duration_ms": 3248
        }
      ]
    },
    {
      "index": 13,
      "text": "家に着くと、ままむすめには望んだ品物を渡しました。",
      "start_ms": 66348,
      "end_ms": 72513,
      "duration_ms": 6165,
      "clauses": [
        {
          "index": 0,
          "text": "家に着くと、",
          "start_ms": 66348,
          "end_ms": 68110,
          "duration_ms": 1762
        },
        {
          "index": 1,
          "text": "ままむすめには望んだ品物を渡しました。",
          "start_ms": 68360,
          "end_ms": 72513,
          "duration_ms": 4153
        }
      ]
    },
    {
      "index": 14,
      "text": "シンデレラには、はしばみの木から取った枝を渡しました。",
      "start_ms": 73013,
      "end_ms": 79166,
      "duration_ms": 6153,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラには、",
          "start_ms": 73013,
          "end_ms": 74914,
          "duration_ms": 1901
        },
        {
          "index": 1,
          "text": "はしばみの木から取った枝を渡しました。",
          "start_ms": 75164,
          "end_ms": 79166,
          "duration_ms": 4002
        }
      ]
    },
    {
      "index": 15,
      "text": "シンデレラは父親にお礼を言いました。",
      "start_ms": 79666,
      "end_ms": 83599,
      "duration_ms": 3933,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラは父親にお礼を言いました。",
          "start_ms": 79666,
          "end_ms": 83599,
          "duration_ms": 3933
        }
      ]
    },
    {
      "index": 16,
      "text": "それから、母親の墓に行って、枝を植えました。",
      "start_ms": 84099,
      "end_ms": 90732,
      "duration_ms": 6633,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 84099,
          "end_ms": 85675,
          "duration_ms": 1576
        },
        {
          "index": 1,
          "text": "母親の墓に行って、",
          "start_ms": 85925,
          "end_ms": 88407,
          "duration_ms": 2482
        },
        {
          "index": 2,
          "text": "枝を植えました。",
          "start_ms": 88657,
          "end_ms": 90732,
          "duration_ms": 2075
        }
      ]
    },
    {
      "index": 17,
      "text": "とても泣いたので、なみだが枝に落ちて、枝を濡らしました。",
      "start_ms": 91232,
      "end_ms": 98272,
      "duration_ms": 7040,
      "clauses": [
        {
          "index": 0,
          "text": "とても泣いたので、",
          "start_ms": 91232,
          "end_ms": 93226,
          "duration_ms": 1994
        },
        {
          "index": 1,
          "text": "なみだが枝に落ちて、",
          "start_ms": 93476,
          "end_ms": 95807,
          "duration_ms": 2331
        },
        {
          "index": 2,
          "text": "枝を濡らしました。",
          "start_ms": 96057,
          "end_ms": 98272,
          "duration_ms": 2215
        }
      ]
    },
    {
      "index": 18,
      "text": "すると、その枝は大きくなって、りっぱな木になりました。",
      "start_ms": 98772,
      "end_ms": 105788,
      "duration_ms": 7016,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 98772,
          "end_ms": 100046,
          "duration_ms": 1274
        },
        {
          "index": 1,
          "text": "その枝は大きくなって、",
          "start_ms": 100296,
          "end_ms": 103056,
          "duration_ms": 2760
        },
        {
          "index": 2,
          "text": "りっぱな木になりました。",
          "start_ms": 103306,
          "end_ms": 105788,
          "duration_ms": 2482
        }
      ]
    },
    {
      "index": 19,
      "text": "日に三度、シンデレラはその木の下に行って座り、泣いて、お祈りをしました。",
      "start_ms": 106288,
      "end_ms": 115942,
      "duration_ms": 9654,
      "clauses": [
        {
          "index": 0,
          "text": "日に三度、",
          "start_ms": 106288,
          "end_ms": 108119,
          "duration_ms": 1831
        },
        {
          "index": 1,
          "text": "シンデレラはその木の下に行って座り、",
          "start_ms": 108369,
          "end_ms": 112151,
          "duration_ms": 3782
        },
        {
          "index": 2,
          "text": "泣いて、",
          "start_ms": 112401,
          "end_ms": 113559,
          "duration_ms": 1158
        },
        {
          "index": 3,
          "text": "お祈りをしました。",
          "start_ms": 113809,
          "end_ms": 115942,
          "duration_ms": 2133
        }
      ]
    },
    {
      "index": 20,
      "text": "すると、一羽の小さい白い鳥がその木に来て、シンデレラが何かを望むと、その鳥が望んだものを落としてくれました。",
      "start_ms": 116442,
      "end_ms": 129463,
      "duration_ms": 13021,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 116442,
          "end_ms": 117751,
          "duration_ms": 1309
        },
        {
          "index": 1,
          "text": "一羽の小さい白い鳥がその木に来て、",
          "start_ms": 118001,
          "end_ms": 122131,
          "duration_ms": 4130
        },
        {
          "index": 2,
          "text": "シンデレラが何かを望むと、",
          "start_ms": 122381,
          "end_ms": 125443,
          "duration_ms": 3062
        },
        {
          "index": 3,
          "text": "その鳥が望んだものを落としてくれました。",
          "start_ms": 125693,
          "end_ms": 129463,
          "duration_ms": 3770
        }
      ]
    }
  ]
