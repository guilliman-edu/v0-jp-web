{
  "audio_file": "a2.2-s8-chocolate-slow.wav",
  "sample_rate": 44100,
  "pause_ms": 500,
  "total_duration_ms": 375661,
  "sentences": [
    {
      "index": 0,
      "text": "チョコレートをあげる日の話",
      "start_ms": 0,
      "end_ms": 3103,
      "duration_ms": 3103,
      "clauses": [
        {
          "index": 0,
          "text": "チョコレートをあげる日の話",
          "start_ms": 0,
          "end_ms": 3103,
          "duration_ms": 3103
        }
      ]
    },
    {
      "index": 1,
      "text": "日本では、バレンタインデーに、女の人がすきな男の人にチョコレートをあげるしゅうかんがあります。",
      "start_ms": 3603,
      "end_ms": 14144,
      "duration_ms": 10541,
      "clauses": [
        {
          "index": 0,
          "text": "日本では、",
          "start_ms": 3603,
          "end_ms": 5406,
          "duration_ms": 1803
        },
        {
          "index": 1,
          "text": "バレンタインデーに、",
          "start_ms": 5656,
          "end_ms": 7761,
          "duration_ms": 2105
        },
        {
          "index": 2,
          "text": "女の人がすきな男の人にチョコレートをあげるしゅうかんがあります。",
          "start_ms": 8011,
          "end_ms": 14144,
          "duration_ms": 6133
        }
      ]
    },
    {
      "index": 2,
      "text": "これはがいこくにはあまりない、日本でゆうめいなしゅうかんです。",
      "start_ms": 14644,
      "end_ms": 21193,
      "duration_ms": 6549,
      "clauses": [
        {
          "index": 0,
          "text": "これはがいこくにはあまりない、",
          "start_ms": 14644,
          "end_ms": 17735,
          "duration_ms": 3091
        },
        {
          "index": 1,
          "text": "日本でゆうめいなしゅうかんです。",
          "start_ms": 17985,
          "end_ms": 21193,
          "duration_ms": 3208
        }
      ]
    },
    {
      "index": 3,
      "text": "こうべのもろぞふせいかというかいしゃが、このしゅうかんを始めたそうです。",
      "start_ms": 21693,
      "end_ms": 29112,
      "duration_ms": 7419,
      "clauses": [
        {
          "index": 0,
          "text": "こうべのもろぞふせいかというかいしゃが、",
          "start_ms": 21693,
          "end_ms": 25411,
          "duration_ms": 3718
        },
        {
          "index": 1,
          "text": "このしゅうかんを始めたそうです。",
          "start_ms": 25661,
          "end_ms": 29112,
          "duration_ms": 3451
        }
      ]
    },
    {
      "index": 4,
      "text": "かいしゃは、がいこくの人が読む英語のしんぶん『The Japan Advertiser』に、チョコレートのこうこくを出しました。",
      "start_ms": 29612,
      "end_ms": 39293,
      "duration_ms": 9681,
      "clauses": [
        {
          "index": 0,
          "text": "かいしゃは、",
          "start_ms": 29612,
          "end_ms": 31322,
          "duration_ms": 1710
        },
        {
          "index": 1,
          "text": "がいこくの人が読む英語のしんぶん『The Japan Advertiser』に、",
          "start_ms": 31572,
          "end_ms": 35685,
          "duration_ms": 4113
        },
        {
          "index": 2,
          "text": "チョコレートのこうこくを出しました。",
          "start_ms": 35935,
          "end_ms": 39293,
          "duration_ms": 3358
        }
      ]
    },
    {
      "index": 5,
      "text": "その後、ふじややもりながせいかなどのおかしのかいしゃも、なんかいも「バレンタインデーは女の人が男の人にチョコレートをあげる日です」と言いました。",
      "start_ms": 39793,
      "end_ms": 54396,
      "duration_ms": 14603,
      "clauses": [
        {
          "index": 0,
          "text": "その後、",
          "start_ms": 39793,
          "end_ms": 41549,
          "duration_ms": 1756
        },
        {
          "index": 1,
          "text": "ふじややもりながせいかなどのおかしのかいしゃも、",
          "start_ms": 41799,
          "end_ms": 46318,
          "duration_ms": 4519
        },
        {
          "index": 2,
          "text": "なんかいも「バレンタインデーは女の人が男の人にチョコレートをあげる日です」と言いました。",
          "start_ms": 46568,
          "end_ms": 54396,
          "duration_ms": 7828
        }
      ]
    },
    {
      "index": 6,
      "text": "こうして、むかしは日本になかったがいこくのぎょうじが、「チョコレートの日」になりました。",
      "start_ms": 54896,
      "end_ms": 64252,
      "duration_ms": 9356,
      "clauses": [
        {
          "index": 0,
          "text": "こうして、",
          "start_ms": 54896,
          "end_ms": 56432,
          "duration_ms": 1536
        },
        {
          "index": 1,
          "text": "むかしは日本になかったがいこくのぎょうじが、",
          "start_ms": 56682,
          "end_ms": 60992,
          "duration_ms": 4310
        },
        {
          "index": 2,
          "text": "「チョコレートの日」になりました。",
          "start_ms": 61242,
          "end_ms": 64252,
          "duration_ms": 3010
        }
      ]
    },
    {
      "index": 7,
      "text": "バレンタインデーはせんきゅうひゃくごじゅう年代に日本でゆうめいになりました。",
      "start_ms": 64752,
      "end_ms": 71408,
      "duration_ms": 6656,
      "clauses": [
        {
          "index": 0,
          "text": "バレンタインデーはせんきゅうひゃくごじゅう年代に日本でゆうめいになりました。",
          "start_ms": 64752,
          "end_ms": 71408,
          "duration_ms": 6656
        }
      ]
    },
    {
      "index": 8,
      "text": "せんきゅうひゃくごじゅうはち年、メリーチョコレートカムパニーというかいしゃが、いせたんのみせに「バレンタインセール」と書いたこうこくを出して、チョコレートを売りました。",
      "start_ms": 71908,
      "end_ms": 87335,
      "duration_ms": 15427,
      "clauses": [
        {
          "index": 0,
          "text": "せんきゅうひゃくごじゅうはち年、",
          "start_ms": 71908,
          "end_ms": 75023,
          "duration_ms": 3115
        },
        {
          "index": 1,
          "text": "メリーチョコレートカムパニーというかいしゃが、",
          "start_ms": 75273,
          "end_ms": 79096,
          "duration_ms": 3823
        },
        {
          "index": 2,
          "text": "いせたんのみせに「バレンタインセール」と書いたこうこくを出して、",
          "start_ms": 79346,
          "end_ms": 84574,
          "duration_ms": 5228
        },
        {
          "index": 3,
          "text": "チョコレートを売りました。",
          "start_ms": 84824,
          "end_ms": 87335,
          "duration_ms": 2511
        }
      ]
    },
    {
      "index": 9,
      "text": "さらにせんきゅうひゃくろくじゅう年には、もりながせいかがテレビやしんぶんで、バレンタインのこうこくをたくさん出しました。",
      "start_ms": 87835,
      "end_ms": 100001,
      "duration_ms": 12166,
      "clauses": [
        {
          "index": 0,
          "text": "さらにせんきゅうひゃくろくじゅう年には、",
          "start_ms": 87835,
          "end_ms": 91484,
          "duration_ms": 3649
        },
        {
          "index": 1,
          "text": "もりながせいかがテレビやしんぶんで、",
          "start_ms": 91734,
          "end_ms": 95371,
          "duration_ms": 3637
        },
        {
          "index": 2,
          "text": "バレンタインのこうこくをたくさん出しました。",
          "start_ms": 95621,
          "end_ms": 100001,
          "duration_ms": 4380
        }
      ]
    },
    {
      "index": 10,
      "text": "こうして、バレンタインデーは日本でおおきいぎょうじになりました。",
      "start_ms": 100501,
      "end_ms": 107340,
      "duration_ms": 6839,
      "clauses": [
        {
          "index": 0,
          "text": "こうして、",
          "start_ms": 100501,
          "end_ms": 102002,
          "duration_ms": 1501
        },
        {
          "index": 1,
          "text": "バレンタインデーは日本でおおきいぎょうじになりました。",
          "start_ms": 102252,
          "end_ms": 107340,
          "duration_ms": 5088
        }
      ]
    },
    {
      "index": 11,
      "text": "すきな男の人にチョコレートをあげる人もおおいし、いちねんでチョコレートをたくさん食べられる日にもなりました。",
      "start_ms": 107840,
      "end_ms": 118000,
      "duration_ms": 10160,
      "clauses": [
        {
          "index": 0,
          "text": "すきな男の人にチョコレートをあげる人もおおいし、",
          "start_ms": 107840,
          "end_ms": 112696,
          "duration_ms": 4856
        },
        {
          "index": 1,
          "text": "いちねんでチョコレートをたくさん食べられる日にもなりました。",
          "start_ms": 112946,
          "end_ms": 118000,
          "duration_ms": 5054
        }
      ]
    },
    {
      "index": 12,
      "text": "チョコレートをもらった男の人は、おかえしに何がほしいですか。",
      "start_ms": 118500,
      "end_ms": 125641,
      "duration_ms": 7141,
      "clauses": [
        {
          "index": 0,
          "text": "チョコレートをもらった男の人は、",
          "start_ms": 118500,
          "end_ms": 121893,
          "duration_ms": 3393
        },
        {
          "index": 1,
          "text": "おかえしに何がほしいですか。",
          "start_ms": 122143,
          "end_ms": 125641,
          "duration_ms": 3498
        }
      ]
    },
    {
      "index": 13,
      "text": "そこで、ふくおかしのおかしのみせ、いしむらまんせいどうが、せんきゅうひゃくななじゅうはち年に「マシュマロデー」を始めました。",
      "start_ms": 126141,
      "end_ms": 139362,
      "duration_ms": 13221,
      "clauses": [
        {
          "index": 0,
          "text": "そこで、",
          "start_ms": 126141,
          "end_ms": 127468,
          "duration_ms": 1327
        },
        {
          "index": 1,
          "text": "ふくおかしのおかしのみせ、",
          "start_ms": 127718,
          "end_ms": 130612,
          "duration_ms": 2894
        },
        {
          "index": 2,
          "text": "いしむらまんせいどうが、",
          "start_ms": 130862,
          "end_ms": 133443,
          "duration_ms": 2581
        },
        {
          "index": 3,
          "text": "せんきゅうひゃくななじゅうはち年に「マシュマロデー」を始めました。",
          "start_ms": 133693,
          "end_ms": 139362,
          "duration_ms": 5669
        }
      ]
    },
    {
      "index": 14,
      "text": "そして、「おかえしにマシュマロをあげましょう」と言いました。",
      "start_ms": 139862,
      "end_ms": 145691,
      "duration_ms": 5829,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 139862,
          "end_ms": 141363,
          "duration_ms": 1501
        },
        {
          "index": 1,
          "text": "「おかえしにマシュマロをあげましょう」と言いました。",
          "start_ms": 141613,
          "end_ms": 145691,
          "duration_ms": 4078
        }
      ]
    },
    {
      "index": 15,
      "text": "その後も、いちねんに一回、あたらしいこうこくやしゃしんを作りました。",
      "start_ms": 146191,
      "end_ms": 155175,
      "duration_ms": 8984,
      "clauses": [
        {
          "index": 0,
          "text": "その後も、",
          "start_ms": 146191,
          "end_ms": 148121,
          "duration_ms": 1930
        },
        {
          "index": 1,
          "text": "いちねんに一回、",
          "start_ms": 148371,
          "end_ms": 150661,
          "duration_ms": 2290
        },
        {
          "index": 2,
          "text": "あたらしいこうこくやしゃしんを作りました。",
          "start_ms": 150911,
          "end_ms": 155175,
          "duration_ms": 4264
        }
      ]
    },
    {
      "index": 16,
      "text": "「マシュマロデー」が「ホワイトデー」というなまえになったときも、みせは「ホワイトデーはマシュマロデー」と言って、「おかえしにマシュマロをあげましょう」と言いました。",
      "start_ms": 155675,
      "end_ms": 169187,
      "duration_ms": 13512,
      "clauses": [
        {
          "index": 0,
          "text": "「マシュマロデー」が「ホワイトデー」というなまえになったときも、",
          "start_ms": 155675,
          "end_ms": 160473,
          "duration_ms": 4798
        },
        {
          "index": 1,
          "text": "みせは「ホワイトデーはマシュマロデー」と言って、",
          "start_ms": 160723,
          "end_ms": 164824,
          "duration_ms": 4101
        },
        {
          "index": 2,
          "text": "「おかえしにマシュマロをあげましょう」と言いました。",
          "start_ms": 165074,
          "end_ms": 169187,
          "duration_ms": 4113
        }
      ]
    },
    {
      "index": 17,
      "text": "ながいれきしの中で作ったこうこくやしゃしんには、ふるいじだいのものもおおいです。",
      "start_ms": 169687,
      "end_ms": 177792,
      "duration_ms": 8105,
      "clauses": [
        {
          "index": 0,
          "text": "ながいれきしの中で作ったこうこくやしゃしんには、",
          "start_ms": 169687,
          "end_ms": 174543,
          "duration_ms": 4856
        },
        {
          "index": 1,
          "text": "ふるいじだいのものもおおいです。",
          "start_ms": 174793,
          "end_ms": 177792,
          "duration_ms": 2999
        }
      ]
    },
    {
      "index": 18,
      "text": "でも、とうきょうの「ぜんこくあめがしこうぎょうきょうどうくみあい」は、せんきゅうひゃくはちじゅう年に「ホワイトデー」というぎょうじを作りました。",
      "start_ms": 178292,
      "end_ms": 191027,
      "duration_ms": 12735,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 178292,
          "end_ms": 179375,
          "duration_ms": 1083
        },
        {
          "index": 1,
          "text": "とうきょうの「ぜんこくあめがしこうぎょうきょうどうくみあい」は、",
          "start_ms": 179625,
          "end_ms": 184679,
          "duration_ms": 5054
        },
        {
          "index": 2,
          "text": "せんきゅうひゃくはちじゅう年に「ホワイトデー」というぎょうじを作りました。",
          "start_ms": 184929,
          "end_ms": 191027,
          "duration_ms": 6098
        }
      ]
    },
    {
      "index": 19,
      "text": "ただ、その前から、いろいろなみせやかいしゃが売っていたそうです。",
      "start_ms": 191527,
      "end_ms": 199746,
      "duration_ms": 8219,
      "clauses": [
        {
          "index": 0,
          "text": "ただ、",
          "start_ms": 191527,
          "end_ms": 192738,
          "duration_ms": 1211
        },
        {
          "index": 1,
          "text": "その前から、",
          "start_ms": 192988,
          "end_ms": 194953,
          "duration_ms": 1965
        },
        {
          "index": 2,
          "text": "いろいろなみせやかいしゃが売っていたそうです。",
          "start_ms": 195203,
          "end_ms": 199746,
          "duration_ms": 4543
        }
      ]
    },
    {
      "index": 20,
      "text": "だから、始まりにはいろいろな話があります。",
      "start_ms": 200246,
      "end_ms": 206040,
      "duration_ms": 5794,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 200246,
          "end_ms": 201561,
          "duration_ms": 1315
        },
        {
          "index": 1,
          "text": "始まりにはいろいろな話があります。",
          "start_ms": 201811,
          "end_ms": 206040,
          "duration_ms": 4229
        }
      ]
    },
    {
      "index": 21,
      "text": "てんぷるだいがくにほんこうのほりぐち先生は、ホワイトデーもおかしのかいしゃが作ったぶんかだと言っています。",
      "start_ms": 206540,
      "end_ms": 216688,
      "duration_ms": 10148,
      "clauses": [
        {
          "index": 0,
          "text": "てんぷるだいがくにほんこうのほりぐち先生は、",
          "start_ms": 206540,
          "end_ms": 210920,
          "duration_ms": 4380
        },
        {
          "index": 1,
          "text": "ホワイトデーもおかしのかいしゃが作ったぶんかだと言っています。",
          "start_ms": 211170,
          "end_ms": 216688,
          "duration_ms": 5518
        }
      ]
    },
    {
      "index": 22,
      "text": "ホワイトデーは日本のぶんかで、かんこくやちゅうごく、たいわんなどでもぎょうじになっています。",
      "start_ms": 217188,
      "end_ms": 227393,
      "duration_ms": 10205,
      "clauses": [
        {
          "index": 0,
          "text": "ホワイトデーは日本のぶんかで、",
          "start_ms": 217188,
          "end_ms": 220663,
          "duration_ms": 3475
        },
        {
          "index": 1,
          "text": "かんこくやちゅうごく、",
          "start_ms": 220913,
          "end_ms": 223343,
          "duration_ms": 2430
        },
        {
          "index": 2,
          "text": "たいわんなどでもぎょうじになっています。",
          "start_ms": 223593,
          "end_ms": 227393,
          "duration_ms": 3800
        }
      ]
    },
    {
      "index": 23,
      "text": "でも、アメリカやヨーロッパでは、あまりありません。",
      "start_ms": 227893,
      "end_ms": 234370,
      "duration_ms": 6477,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 227893,
          "end_ms": 228964,
          "duration_ms": 1071
        },
        {
          "index": 1,
          "text": "アメリカやヨーロッパでは、",
          "start_ms": 229214,
          "end_ms": 232004,
          "duration_ms": 2790
        },
        {
          "index": 2,
          "text": "あまりありません。",
          "start_ms": 232254,
          "end_ms": 234370,
          "duration_ms": 2116
        }
      ]
    },
    {
      "index": 24,
      "text": "バレンタインデーが日本でゆうめいになって、かいしゃではたらく女の人が、かいしゃの男の人にチョコレートをあげることも多くなりました。",
      "start_ms": 234870,
      "end_ms": 248104,
      "duration_ms": 13234,
      "clauses": [
        {
          "index": 0,
          "text": "バレンタインデーが日本でゆうめいになって、",
          "start_ms": 234870,
          "end_ms": 238716,
          "duration_ms": 3846
        },
        {
          "index": 1,
          "text": "かいしゃではたらく女の人が、",
          "start_ms": 238966,
          "end_ms": 242255,
          "duration_ms": 3289
        },
        {
          "index": 2,
          "text": "かいしゃの男の人にチョコレートをあげることも多くなりました。",
          "start_ms": 242505,
          "end_ms": 248104,
          "duration_ms": 5599
        }
      ]
    },
    {
      "index": 25,
      "text": "これを「ぎりちょこ」と言います。",
      "start_ms": 248604,
      "end_ms": 251452,
      "duration_ms": 2848,
      "clauses": [
        {
          "index": 0,
          "text": "これを「ぎりちょこ」と言います。",
          "start_ms": 248604,
          "end_ms": 251452,
          "duration_ms": 2848
        }
      ]
    },
    {
      "index": 26,
      "text": "ぎりちょこはせんきゅうひゃくはちじゅう年代に多くなりました。",
      "start_ms": 251952,
      "end_ms": 257749,
      "duration_ms": 5797,
      "clauses": [
        {
          "index": 0,
          "text": "ぎりちょこはせんきゅうひゃくはちじゅう年代に多くなりました。",
          "start_ms": 251952,
          "end_ms": 257749,
          "duration_ms": 5797
        }
      ]
    },
    {
      "index": 27,
      "text": "ホワイトデーも多くなったじだいです。",
      "start_ms": 258249,
      "end_ms": 261933,
      "duration_ms": 3684,
      "clauses": [
        {
          "index": 0,
          "text": "ホワイトデーも多くなったじだいです。",
          "start_ms": 258249,
          "end_ms": 261933,
          "duration_ms": 3684
        }
      ]
    },
    {
      "index": 28,
      "text": "ぎりちょこは、がいこくにはない日本のぶんかです。",
      "start_ms": 262433,
      "end_ms": 268019,
      "duration_ms": 5586,
      "clauses": [
        {
          "index": 0,
          "text": "ぎりちょこは、",
          "start_ms": 262433,
          "end_ms": 264178,
          "duration_ms": 1745
        },
        {
          "index": 1,
          "text": "がいこくにはない日本のぶんかです。",
          "start_ms": 264428,
          "end_ms": 268019,
          "duration_ms": 3591
        }
      ]
    },
    {
      "index": 29,
      "text": "にせんじゅうさん年には、「これはぎりちょこだと見てわかるチョコ」というこうこくのことばで、おかしを売るかいしゃもありました。",
      "start_ms": 268519,
      "end_ms": 280477,
      "duration_ms": 11958,
      "clauses": [
        {
          "index": 0,
          "text": "にせんじゅうさん年には、",
          "start_ms": 268519,
          "end_ms": 271123,
          "duration_ms": 2604
        },
        {
          "index": 1,
          "text": "「これはぎりちょこだと見てわかるチョコ」というこうこくのことばで、",
          "start_ms": 271373,
          "end_ms": 276903,
          "duration_ms": 5530
        },
        {
          "index": 2,
          "text": "おかしを売るかいしゃもありました。",
          "start_ms": 277153,
          "end_ms": 280477,
          "duration_ms": 3324
        }
      ]
    },
    {
      "index": 30,
      "text": "しかし、女の人にも、おかえしをする男の人にも、おかねとじかんがかかります。",
      "start_ms": 280977,
      "end_ms": 291898,
      "duration_ms": 10921,
      "clauses": [
        {
          "index": 0,
          "text": "しかし、",
          "start_ms": 280977,
          "end_ms": 282617,
          "duration_ms": 1640
        },
        {
          "index": 1,
          "text": "女の人にも、",
          "start_ms": 282867,
          "end_ms": 285030,
          "duration_ms": 2163
        },
        {
          "index": 2,
          "text": "おかえしをする男の人にも、",
          "start_ms": 285280,
          "end_ms": 288580,
          "duration_ms": 3300
        },
        {
          "index": 3,
          "text": "おかねとじかんがかかります。",
          "start_ms": 288830,
          "end_ms": 291898,
          "duration_ms": 3068
        }
      ]
    },
    {
      "index": 31,
      "text": "だから、せんきゅうひゃくきゅうじゅう年代には、もう「ぎりちょこをやめたい」と言う人もいました。",
      "start_ms": 292398,
      "end_ms": 301929,
      "duration_ms": 9531,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 292398,
          "end_ms": 293725,
          "duration_ms": 1327
        },
        {
          "index": 1,
          "text": "せんきゅうひゃくきゅうじゅう年代には、",
          "start_ms": 293975,
          "end_ms": 297438,
          "duration_ms": 3463
        },
        {
          "index": 2,
          "text": "もう「ぎりちょこをやめたい」と言う人もいました。",
          "start_ms": 297688,
          "end_ms": 301929,
          "duration_ms": 4241
        }
      ]
    },
    {
      "index": 32,
      "text": "あるかいしゃは、ぎりちょこをやめました。",
      "start_ms": 302429,
      "end_ms": 307306,
      "duration_ms": 4877,
      "clauses": [
        {
          "index": 0,
          "text": "あるかいしゃは、",
          "start_ms": 302429,
          "end_ms": 304417,
          "duration_ms": 1988
        },
        {
          "index": 1,
          "text": "ぎりちょこをやめました。",
          "start_ms": 304667,
          "end_ms": 307306,
          "duration_ms": 2639
        }
      ]
    },
    {
      "index": 33,
      "text": "そして、かいしゃの人から、500円を出してもいい人から集めて、にしあふりかのおとこのこやおんなのこに送りました。",
      "start_ms": 307806,
      "end_ms": 321258,
      "duration_ms": 13452,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 307806,
          "end_ms": 309318,
          "duration_ms": 1512
        },
        {
          "index": 1,
          "text": "かいしゃの人から、",
          "start_ms": 309568,
          "end_ms": 311824,
          "duration_ms": 2256
        },
        {
          "index": 2,
          "text": "500円を出してもいい人から集めて、",
          "start_ms": 312074,
          "end_ms": 316036,
          "duration_ms": 3962
        },
        {
          "index": 3,
          "text": "にしあふりかのおとこのこやおんなのこに送りました。",
          "start_ms": 316286,
          "end_ms": 321258,
          "duration_ms": 4972
        }
      ]
    },
    {
      "index": 34,
      "text": "にせんきゅう年には、マッチ・ドットコム ジャパンというかいしゃが、かいしゃの中でぎりちょこをあげることをやめました。",
      "start_ms": 321758,
      "end_ms": 333413,
      "duration_ms": 11655,
      "clauses": [
        {
          "index": 0,
          "text": "にせんきゅう年には、",
          "start_ms": 321758,
          "end_ms": 324106,
          "duration_ms": 2348
        },
        {
          "index": 1,
          "text": "マッチ・ドットコム ジャパンというかいしゃが、",
          "start_ms": 324356,
          "end_ms": 328318,
          "duration_ms": 3962
        },
        {
          "index": 2,
          "text": "かいしゃの中でぎりちょこをあげることをやめました。",
          "start_ms": 328568,
          "end_ms": 333413,
          "duration_ms": 4845
        }
      ]
    },
    {
      "index": 35,
      "text": "そしてにせんじゅうはち年、チョコレートのかいしゃのゴディバが、しんぶんに「日本は、ぎりちょこをやめよう」というこうこくを出しました。",
      "start_ms": 333913,
      "end_ms": 347841,
      "duration_ms": 13928,
      "clauses": [
        {
          "index": 0,
          "text": "そしてにせんじゅうはち年、",
          "start_ms": 333913,
          "end_ms": 337109,
          "duration_ms": 3196
        },
        {
          "index": 1,
          "text": "チョコレートのかいしゃのゴディバが、",
          "start_ms": 337359,
          "end_ms": 340636,
          "duration_ms": 3277
        },
        {
          "index": 2,
          "text": "しんぶんに「日本は、",
          "start_ms": 340886,
          "end_ms": 343269,
          "duration_ms": 2383
        },
        {
          "index": 3,
          "text": "ぎりちょこをやめよう」というこうこくを出しました。",
          "start_ms": 343519,
          "end_ms": 347841,
          "duration_ms": 4322
        }
      ]
    },
    {
      "index": 36,
      "text": "多くの人がこのこうこくの話をしました。",
      "start_ms": 348341,
      "end_ms": 353499,
      "duration_ms": 5158,
      "clauses": [
        {
          "index": 0,
          "text": "多くの人がこのこうこくの話をしました。",
          "start_ms": 348341,
          "end_ms": 353499,
          "duration_ms": 5158
        }
      ]
    },
    {
      "index": 37,
      "text": "ゴディバジャパンのしゃちょうは、バレンタインデーはチョコレートをもらう人の日ではなく、あげる人の日だと言っています。",
      "start_ms": 353999,
      "end_ms": 365561,
      "duration_ms": 11562,
      "clauses": [
        {
          "index": 0,
          "text": "ゴディバジャパンのしゃちょうは、",
          "start_ms": 353999,
          "end_ms": 356847,
          "duration_ms": 2848
        },
        {
          "index": 1,
          "text": "バレンタインデーはチョコレートをもらう人の日ではなく、",
          "start_ms": 357097,
          "end_ms": 362069,
          "duration_ms": 4972
        },
        {
          "index": 2,
          "text": "あげる人の日だと言っています。",
          "start_ms": 362319,
          "end_ms": 365561,
          "duration_ms": 3242
        }
      ]
    },
    {
      "index": 38,
      "text": "そして、ぎりちょこをあげたくない人がいるなら、やめたほうがいいと説明しています。",
      "start_ms": 366061,
      "end_ms": 375661,
      "duration_ms": 9600,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 366061,
          "end_ms": 367550,
          "duration_ms": 1489
        },
        {
          "index": 1,
          "text": "ぎりちょこをあげたくない人がいるなら、",
          "start_ms": 367800,
          "end_ms": 371391,
          "duration_ms": 3591
        },
        {
          "index": 2,
          "text": "やめたほうがいいと説明しています。",
          "start_ms": 371641,
          "end_ms": 375661,
          "duration_ms": 4020
        }
      ]
    }
  ]
}