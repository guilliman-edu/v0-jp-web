          "duration_ms": 1884
        },
        {
          "index": 1,
          "text": "がいきんばちと呼ばれるはたらきばちたちは、",
          "start_ms": 38452,
          "end_ms": 41764,
          "duration_ms": 3312
        },
        {
          "index": 2,
