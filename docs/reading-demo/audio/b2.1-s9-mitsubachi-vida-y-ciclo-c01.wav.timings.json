          "end_ms": 22045,
          "duration_ms": 4879
        }
      ]
    },
    {
      "index": 4,
      "text": "かみつとハチミツは、性質も成分も少しずつ違っていくのです。",
      "start_ms": 22545,
      "end_ms": 28850,
      "duration_ms": 6305,
      "clauses": [
        {
          "index": 0,
          "text": "かみつとハチミツは、",
