          "end_ms": 9002,
          "duration_ms": 3834
        }
      ]
    },
    {
      "index": 2,
      "text": "「ミツバチが花のかみつを集めて作るもの」と思う人が多いかもしれません。",
      "start_ms": 9502,
      "end_ms": 15101,
      "duration_ms": 5599,
      "clauses": [
        {
          "index": 0,
          "text": "「ミツバチが花のかみつを集めて作るもの」と思う人が多いかもしれません。",
          "start_ms": 9502,
          "end_ms": 15101,
          "duration_ms": 5599
        }
      ]
    },
    {
      "index": 3,
      "text": "しかし、かみつそのものがそのままハチミツになるわけではありません。",
      "start_ms": 15601,
      "end_ms": 22045,
      "duration_ms": 6444,
      "clauses": [
        {
          "index": 0,
