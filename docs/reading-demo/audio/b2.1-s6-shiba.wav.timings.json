      "duration_ms": 4540,
      "clauses": [
        {
          "index": 0,
          "text": "ただ、",
          "start_ms": 204455,
          "end_ms": 205584,
          "duration_ms": 1129
        },
        {
          "index": 1,
          "text": "都合がよすぎるというひはんもあります。",
