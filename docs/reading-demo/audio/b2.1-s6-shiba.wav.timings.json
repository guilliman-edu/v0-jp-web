      "end_ms": 176698,
      "duration_ms": 4264,
      "clauses": [
        {
          "index": 0,
          "text": "彼はれきしを一つの長い話として見ました。",
          "start_ms": 172434,
          "end_ms": 176698,
          "duration_ms": 4264
        }
      ]
    },
    {
      "index": 22,
      "text": "これは「しばしかん」と言われ、日本に強いえいきょうを与えました。",
      "start_ms": 177198,
      "end_ms": 182818,
      "duration_ms": 5620,
      "clauses": [
        {
          "index": 0,
          "text": "これは「しばしかん」と言われ、",
          "start_ms": 177198,
          "end_ms": 179593,
          "duration_ms": 2395
        },
        {
          "index": 1,
          "text": "日本に強いえいきょうを与えました。",
          "start_ms": 179843,
          "end_ms": 182818,
          "duration_ms": 2975
        }
      ]
    },
    {
      "index": 23,
      "text": "しばしかんとは、にっしん・にちろ戦争のころの日本をりそうとし、たいへいようせんそうのころを暗いじだいと見るたちばです。",
      "start_ms": 183318,
      "end_ms": 193893,
      "duration_ms": 10575,
      "clauses": [
        {
          "index": 0,
          "text": "しばしかんとは、",
          "start_ms": 183318,
          "end_ms": 185155,
          "duration_ms": 1837
        },
        {
          "index": 1,
          "text": "にっしん・にちろ戦争のころの日本をりそうとし、",
          "start_ms": 185405,
          "end_ms": 189379,
          "duration_ms": 3974
        },
        {
          "index": 2,
          "text": "たいへいようせんそうのころを暗いじだいと見るたちばです。",
          "start_ms": 189629,
          "end_ms": 193893,
          "duration_ms": 4264
        }
      ]
    },
    {
      "index": 24,
      "text": "おだのぶなが、さいごうたかもり、さかもとりょうま、おおくぼとしみちなどを高く評価しました。",
      "start_ms": 194393,
      "end_ms": 203955,
      "duration_ms": 9562,
      "clauses": [
        {
          "index": 0,
          "text": "おだのぶなが、",
          "start_ms": 194393,
          "end_ms": 195952,
          "duration_ms": 1559
        },
        {
          "index": 1,
          "text": "さいごうたかもり、",
          "start_ms": 196202,
          "end_ms": 198074,
          "duration_ms": 1872
        },
        {
          "index": 2,
          "text": "さかもとりょうま、",
