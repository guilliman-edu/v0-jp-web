        }
      ]
    },
    {
      "index": 1,
      "text": "しばりょうたろうはせんきゅうひゃくにじゅうさん年におおさかで生まれ、せんきゅうひゃくきゅうじゅうろく年に亡くなりました。",
      "start_ms": 3707,
      "end_ms": 12648,
      "duration_ms": 8941,
      "clauses": [
        {
          "index": 0,
          "text": "しばりょうたろうはせんきゅうひゃくにじゅうさん年におおさかで生まれ、",
          "start_ms": 3707,
          "end_ms": 8784,
          "duration_ms": 5077
        },
        {
          "index": 1,
          "text": "せんきゅうひゃくきゅうじゅうろく年に亡くなりました。",
          "start_ms": 9034,
          "end_ms": 12648,
          "duration_ms": 3614
        }
      ]
    },
    {
      "index": 2,
      "text": "本名はふくだていいちです。",
      "start_ms": 13148,
      "end_ms": 15845,
      "duration_ms": 2697,
      "clauses": [
        {
          "index": 0,
          "text": "本名はふくだていいちです。",
          "start_ms": 13148,
          "end_ms": 15845,
          "duration_ms": 2697
        }
      ]
    },
    {
      "index": 3,
      "text": "おおさかの町で育ち、「しばりょうたろう」という名前は、「しばせんにはるかに及ばない日本の者（太郎）」という意味から付けました。",
      "start_ms": 16345,
      "end_ms": 27093,
      "duration_ms": 10748,
      "clauses": [
        {
          "index": 0,
          "text": "おおさかの町で育ち、",
          "start_ms": 16345,
          "end_ms": 18716,
          "duration_ms": 2371
        },
        {
          "index": 1,
          "text": "「しばりょうたろう」という名前は、",
          "start_ms": 18966,
          "end_ms": 21523,
          "duration_ms": 2557
        },
        {
          "index": 2,
          "text": "「しばせんにはるかに及ばない日本の者（太郎）」という意味から付けました。",
          "start_ms": 21773,
          "end_ms": 27093,
          "duration_ms": 5320
        }
      ]
    },
    {
      "index": 4,
      "text": "戦争が終わった後、「昔の日本人は、もう少しましだったのではないか」と考え、日本のれきしに関心を持つようになりました。",
      "start_ms": 27593,
      "end_ms": 39767,
      "duration_ms": 12174,
      "clauses": [
        {
          "index": 0,
          "text": "戦争が終わった後、",
          "start_ms": 27593,
          "end_ms": 29779,
          "duration_ms": 2186
        },
        {
          "index": 1,
          "text": "「昔の日本人は、",
          "start_ms": 30029,
          "end_ms": 32075,
          "duration_ms": 2046
        },
        {
          "index": 2,
          "text": "もう少しましだったのではないか」と考え、",
          "start_ms": 32325,
          "end_ms": 35683,
          "duration_ms": 3358
        },
        {
          "index": 3,
          "text": "日本のれきしに関心を持つようになりました。",
          "start_ms": 35933,
          "end_ms": 39767,
          "duration_ms": 3834
        }
      ]
    },
    {
      "index": 5,
      "text": "詳しく調べてしょうせつを書くようになったのも、この経験がもとになっています。",
      "start_ms": 40267,
      "end_ms": 47211,
      "duration_ms": 6944,
      "clauses": [
        {
          "index": 0,
          "text": "詳しく調べてしょうせつを書くようになったのも、",
          "start_ms": 40267,
          "end_ms": 44125,
          "duration_ms": 3858
        },
        {
          "index": 1,
          "text": "この経験がもとになっています。",
          "start_ms": 44375,
          "end_ms": 47211,
          "duration_ms": 2836
        }
      ]
    },
    {
      "index": 6,
      "text": "初めはしんぶんのきしゃとして働き、しょうせつも書いていました。",
      "start_ms": 47711,
      "end_ms": 53761,
      "duration_ms": 6050,
      "clauses": [
