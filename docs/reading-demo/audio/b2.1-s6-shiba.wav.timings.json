          "duration_ms": 2801
        }
      ]
    },
    {
      "index": 14,
      "text": "せんきゅうひゃくななじゅういち年からは、日本のさまざまな土地を歩いて、町のれきしや特徴を書く『かいどうをゆく』を書きはじめました。",
      "start_ms": 122358,
      "end_ms": 133513,
      "duration_ms": 11155,
      "clauses": [
        {
          "index": 0,
          "text": "せんきゅうひゃくななじゅういち年からは、",
