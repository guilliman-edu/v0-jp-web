          "end_ms": 103211,
          "duration_ms": 2430
        }
      ]
    },
    {
      "index": 12,
      "text": "『さかのうえのくも』といえば、めいじの日本を描いた長いさくひんとして有名です。",
      "start_ms": 103711,
      "end_ms": 110504,
      "duration_ms": 6793,
      "clauses": [
        {
