      "duration_ms": 4763,
      "clauses": [
        {
          "index": 0,
          "text": "せんきゅうひゃくきゅうじゅうさん年にはぶんかくんしょうを受けました。",
          "start_ms": 167171,
          "end_ms": 171934,
          "duration_ms": 4763
        }
      ]
    },
    {
      "index": 21,
      "text": "彼はれきしを一つの長い話として見ました。",
