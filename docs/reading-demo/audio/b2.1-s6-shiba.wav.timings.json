          "end_ms": 160154,
          "duration_ms": 3718
        }
      ]
    },
    {
      "index": 19,
      "text": "「国民的さっか」と呼ばれるようになったのはせんきゅうひゃくななじゅう年代からです。",
      "start_ms": 160654,
      "end_ms": 166671,
      "duration_ms": 6017,
      "clauses": [
        {
          "index": 0,
          "text": "「国民的さっか」と呼ばれるようになったのはせんきゅうひゃくななじゅう年代からです。",
          "start_ms": 160654,
          "end_ms": 166671,
          "duration_ms": 6017
        }
      ]
    },
    {
      "index": 20,
      "text": "せんきゅうひゃくきゅうじゅうさん年にはぶんかくんしょうを受けました。",
