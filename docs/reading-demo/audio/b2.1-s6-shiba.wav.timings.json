          "end_ms": 200138,
          "duration_ms": 1814
        },
        {
          "index": 3,
          "text": "おおくぼとしみちなどを高く評価しました。",
          "start_ms": 200388,
          "end_ms": 203955,
          "duration_ms": 3567
        }
      ]
    },
    {
