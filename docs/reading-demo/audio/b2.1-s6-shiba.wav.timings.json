          "text": "『さかのうえのくも』といえば、",
          "start_ms": 103711,
          "end_ms": 106141,
          "duration_ms": 2430
        },
        {
          "index": 1,
          "text": "めいじの日本を描いた長いさくひんとして有名です。",
          "start_ms": 106391,
          "end_ms": 110504,
          "duration_ms": 4113
        }
      ]
    },
    {
      "index": 13,
      "text": "せんきゅうひゃくろくじゅうよ年に、当時のふせししもこさか（げんざいのひがしおおさか市）に移り、なくなるまでそこに住みました。",
      "start_ms": 111004,
      "end_ms": 121858,
      "duration_ms": 10854,
      "clauses": [
        {
          "index": 0,
          "text": "せんきゅうひゃくろくじゅうよ年に、",
          "start_ms": 111004,
          "end_ms": 113631,
          "duration_ms": 2627
        },
        {
          "index": 1,
          "text": "当時のふせししもこさか（げんざいのひがしおおさか市）に移り、",
