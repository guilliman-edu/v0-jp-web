      "end_ms": 182887,
      "duration_ms": 8381,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘が来るまで待っていて、",
          "start_ms": 174506,
          "end_ms": 177493,
          "duration_ms": 2987
        },
        {
