          "duration_ms": 1385
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 152159,
          "end_ms": 153567,
          "duration_ms": 1408
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 153817,
          "end_ms": 155283,
          "duration_ms": 1466
        }
      ]
    },
    {
      "index": 28,
      "text": "銀と金を私に落としておくれ。",
      "start_ms": 155783,
      "end_ms": 158944,
      "duration_ms": 3161,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。",
          "start_ms": 155783,
          "end_ms": 158944,
          "duration_ms": 3161
        }
      ]
    },
    {
      "index": 29,
      "text": "」 すると、小鳥は前日よりさらに美しいドレスを落としてくれました。",
      "start_ms": 159444,
      "end_ms": 165946,
      "duration_ms": 6502,
      "clauses": [
        {
          "index": 0,
          "text": "」 すると、",
          "start_ms": 159444,
          "end_ms": 160573,
          "duration_ms": 1129
        },
        {
          "index": 1,
          "text": "小鳥は前日よりさらに美しいドレスを落としてくれました。",
          "start_ms": 160823,
          "end_ms": 165946,
          "duration_ms": 5123
        }
      ]
    },
    {
      "index": 30,
      "text": "シンデレラがそのドレスを着て舞踏会に現れると、みんながその美しさに驚きました。",
      "start_ms": 166446,
      "end_ms": 174562,
      "duration_ms": 8116,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラがそのドレスを着て舞踏会に現れると、",
          "start_ms": 166446,
          "end_ms": 170965,
          "duration_ms": 4519
        },
        {
          "index": 1,
          "text": "みんながその美しさに驚きました。",
          "start_ms": 171215,
          "end_ms": 174562,
          "duration_ms": 3347
        }
      ]
    },
    {
      "index": 31,
      "text": "王子は娘が来るまで待っていて、すぐに娘の手を取って、娘とだけ踊りました。",
      "start_ms": 175062,
      "end_ms": 183373,
      "duration_ms": 8311,
      "clauses": [
        {
          "index": 0,
          "text": "王子は娘が来るまで待っていて、",
          "start_ms": 175062,
          "end_ms": 178014,
          "duration_ms": 2952
        },
        {
          "index": 1,
          "text": "すぐに娘の手を取って、",
          "start_ms": 178264,
          "end_ms": 180670,
          "duration_ms": 2406
        },
        {
          "index": 2,
          "text": "娘とだけ踊りました。",
          "start_ms": 180920,
          "end_ms": 183373,
          "duration_ms": 2453
        }
      ]
    },
    {
      "index": 32,
      "text": "夕方になると、娘は家に帰ろうとしました。",
      "start_ms": 183873,
      "end_ms": 189179,
      "duration_ms": 5306,
      "clauses": [
        {
          "index": 0,
          "text": "夕方になると、",
          "start_ms": 183873,
          "end_ms": 185780,
          "duration_ms": 1907
        },
        {
          "index": 1,
          "text": "娘は家に帰ろうとしました。",
          "start_ms": 186030,
          "end_ms": 189179,
          "duration_ms": 3149
        }
      ]
    },
    {
      "index": 33,
      "text": "王子は娘のあとをつけて、どの家に行ったか確かめしようとしました。",
      "start_ms": 189679,
      "end_ms": 196065,
      "duration_ms": 6386,
      "clauses": [
        {
          "index": 0,
          "text": "王子は娘のあとをつけて、",
          "start_ms": 189679,
          "end_ms": 192329,
          "duration_ms": 2650
        },
        {
          "index": 1,
          "text": "どの家に行ったか確かめしようとしました。",
          "start_ms": 192579,
          "end_ms": 196065,
          "duration_ms": 3486
        }
      ]
    },
    {
      "index": 34,
      "text": "でも、娘は跳んで逃げて、家の後ろの庭に入りました。",
      "start_ms": 196565,
      "end_ms": 202844,
      "duration_ms": 6279,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 196565,
          "end_ms": 197450,
          "duration_ms": 885
        },
        {
          "index": 1,
          "text": "娘は跳んで逃げて、",
          "start_ms": 197700,
          "end_ms": 199886,
          "duration_ms": 2186
        },
        {
          "index": 2,
          "text": "家の後ろの庭に入りました。",
          "start_ms": 200136,
          "end_ms": 202844,
          "duration_ms": 2708
        }
      ]
    },
    {
      "index": 35,
      "text": "庭に梨の実がついている美しい高い木がありました。",
      "start_ms": 203344,
      "end_ms": 207724,
      "duration_ms": 4380,
      "clauses": [
        {
          "index": 0,
          "text": "庭に梨の実がついている美しい高い木がありました。",
          "start_ms": 203344,
          "end_ms": 207724,
          "duration_ms": 4380
        }
      ]
    },
    {
      "index": 36,
      "text": "娘はリスのようにすばしっこく枝の間によじ登ったので、王子はどこに消えたのか分かりませんでした。",
      "start_ms": 208224,
      "end_ms": 217548,
      "duration_ms": 9324,
      "clauses": [
        {
          "index": 0,
          "text": "娘はリスのようにすばしっこく枝の間によじ登ったので、",
          "start_ms": 208224,
          "end_ms": 213498,
          "duration_ms": 5274
        },
        {
          "index": 1,
          "text": "王子はどこに消えたのか分かりませんでした。",
          "start_ms": 213748,
          "end_ms": 217548,
          "duration_ms": 3800
        }
      ]
    },
    {
      "index": 37,
      "text": "三日目、両親と姉たちが出かけると、シンデレラははしばみの木に行きました。",
      "start_ms": 218048,
      "end_ms": 226069,
      "duration_ms": 8021,
      "clauses": [
        {
          "index": 0,
          "text": "三日目、",
          "start_ms": 218048,
          "end_ms": 219177,
          "duration_ms": 1129
        },
        {
          "index": 1,
          "text": "両親と姉たちが出かけると、",
          "start_ms": 219427,
          "end_ms": 222542,
          "duration_ms": 3115
        },
        {
          "index": 2,
          "text": "シンデレラははしばみの木に行きました。",
          "start_ms": 222792,
          "end_ms": 226069,
          "duration_ms": 3277
        }
      ]
    },
    {
      "index": 38,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 226569,
      "end_ms": 231374,
      "duration_ms": 4805,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 226569,
          "end_ms": 227930,
          "duration_ms": 1361
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 228180,
          "end_ms": 229588,
          "duration_ms": 1408
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 229838,
          "end_ms": 231374,
          "duration_ms": 1536
        }
      ]
    },
    {
      "index": 39,
      "text": "銀と金を私に落としておくれ。",
      "start_ms": 231874,
      "end_ms": 235047,
      "duration_ms": 3173,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。",
          "start_ms": 231874,
          "end_ms": 235047,
          "duration_ms": 3173
        }
      ]
    },
    {
      "index": 40,
      "text": "」 今度の小鳥は、これまでのどのドレスよりもすばらしく豪華なドレスを落としてくれました。",
      "start_ms": 235547,
      "end_ms": 243558,
      "duration_ms": 8011,
      "clauses": [
        {
          "index": 0,
          "text": "」 今度の小鳥は、",
          "start_ms": 235547,
          "end_ms": 237384,
          "duration_ms": 1837
        },
        {
          "index": 1,
          "text": "これまでのどのドレスよりもすばらしく豪華なドレスを落としてくれました。",
          "start_ms": 237634,
          "end_ms": 243558,
          "duration_ms": 5924
        }
      ]
    },
    {
      "index": 41,
      "text": "上靴も金でした。",
      "start_ms": 244058,
      "end_ms": 246197,
      "duration_ms": 2139,
      "clauses": [
        {
          "index": 0,
          "text": "上靴も金でした。",
          "start_ms": 244058,
          "end_ms": 246197,
          "duration_ms": 2139
        }
      ]
    },
    {
      "index": 42,
      "text": "舞踏会に行くと、驚きのあまり誰もどうしていいか分かりませんでした。",
      "start_ms": 246697,
      "end_ms": 253199,
      "duration_ms": 6502,
      "clauses": [
        {
          "index": 0,
          "text": "舞踏会に行くと、",
          "start_ms": 246697,
          "end_ms": 248511,
          "duration_ms": 1814
        },
        {
          "index": 1,
          "text": "驚きのあまり誰もどうしていいか分かりませんでした。",
          "start_ms": 248761,
          "end_ms": 253199,
          "duration_ms": 4438
        }
      ]
    },
    {
      "index": 43,
      "text": "王子は娘とだけ踊りました。",
      "start_ms": 253699,
      "end_ms": 256825,
      "duration_ms": 3126,
      "clauses": [
        {
          "index": 0,
          "text": "王子は娘とだけ踊りました。",
          "start_ms": 253699,
          "end_ms": 256825,
          "duration_ms": 3126
        }
      ]
    },
    {
      "index": 44,
      "text": "夕方になると、シンデレラは帰ろうとしました。",
      "start_ms": 257325,
      "end_ms": 262341,
      "duration_ms": 5016,
      "clauses": [
        {
          "index": 0,
          "text": "夕方になると、",
          "start_ms": 257325,
          "end_ms": 259162,
          "duration_ms": 1837
        },
        {
          "index": 1,
          "text": "シンデレラは帰ろうとしました。",
          "start_ms": 259412,
          "end_ms": 262341,
          "duration_ms": 2929
        }
      ]
    },
    {
      "index": 45,
      "text": "王子は娘と一緒に行きたがりましたが、娘は素早く逃げました。",
      "start_ms": 262841,
      "end_ms": 269297,
      "duration_ms": 6456,
      "clauses": [
        {
          "index": 0,
          "text": "王子は娘と一緒に行きたがりましたが、",
          "start_ms": 262841,
          "end_ms": 266269,
          "duration_ms": 3428
        },
        {
          "index": 1,
          "text": "娘は素早く逃げました。",
          "start_ms": 266519,
          "end_ms": 269297,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 46,
      "text": "でも、王子は計略を練っていて、階段にピッチを塗らせておいたのです。",
      "start_ms": 269797,
      "end_ms": 277179,
      "duration_ms": 7382,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 269797,
          "end_ms": 270694,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "王子は計略を練っていて、",
          "start_ms": 270944,
          "end_ms": 273722,
          "duration_ms": 2778
        },
        {
          "index": 2,
          "text": "階段にピッチを塗らせておいたのです。",
          "start_ms": 273972,
          "end_ms": 277179,
          "duration_ms": 3207
        }
      ]
    },
    {
      "index": 47,
      "text": "娘が駆け下りると、左の上靴がくっついて離れませんでした。",
      "start_ms": 277679,
      "end_ms": 283787,
      "duration_ms": 6108,
      "clauses": [
        {
          "index": 0,
          "text": "娘が駆け下りると、",
          "start_ms": 277679,
          "end_ms": 279865,
          "duration_ms": 2186
        },
        {
          "index": 1,
          "text": "左の上靴がくっついて離れませんでした。",
          "start_ms": 280115,
          "end_ms": 283787,
          "duration_ms": 3672
        }
      ]
    }
  ]
}