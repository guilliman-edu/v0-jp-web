          "end_ms": 1408,
          "duration_ms": 1408
        }
      ]
    },
    {
      "index": 1,
      "text": "もう誰もいないと分かると、シンデレラははしばみの木の下にある母親の墓に行きました。",
      "start_ms": 1908,
      "end_ms": 9769,
      "duration_ms": 7861,
      "clauses": [
        {
          "index": 0,
          "text": "もう誰もいないと分かると、",
          "start_ms": 1908,
          "end_ms": 4605,
          "duration_ms": 2697
        },
        {
          "index": 1,
          "text": "シンデレラははしばみの木の下にある母親の墓に行きました。",
          "start_ms": 4855,
          "end_ms": 9769,
          "duration_ms": 4914
        }
      ]
    },
    {
      "index": 2,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 10269,
      "end_ms": 15016,
      "duration_ms": 4747,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 10269,
          "end_ms": 11654,
          "duration_ms": 1385
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 11904,
          "end_ms": 13300,
          "duration_ms": 1396
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 13550,
          "end_ms": 15016,
          "duration_ms": 1466
        }
      ]
    },
    {
      "index": 3,
      "text": "銀と金を私に落としておくれ。",
      "start_ms": 15516,
      "end_ms": 18677,
      "duration_ms": 3161,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。",
          "start_ms": 15516,
          "end_ms": 18677,
          "duration_ms": 3161
        }
      ]
    },
    {
      "index": 4,
      "text": "」 すると、小鳥が金銀のドレスと、銀で刺しゅうされたうわぐつを落としてくれました。",
      "start_ms": 19177,
      "end_ms": 27070,
      "duration_ms": 7893,
      "clauses": [
        {
          "index": 0,
          "text": "」 すると、",
          "start_ms": 19177,
          "end_ms": 20329,
          "duration_ms": 1152
        },
        {
          "index": 1,
          "text": "小鳥が金銀のドレスと、",
          "start_ms": 20579,
          "end_ms": 23055,
          "duration_ms": 2476
        },
        {
          "index": 2,
          "text": "銀で刺しゅうされたうわぐつを落としてくれました。",
          "start_ms": 23305,
          "end_ms": 27070,
          "duration_ms": 3765
        }
      ]
    },
    {
      "index": 5,
      "text": "娘は急いでドレスを着て、ぶとうかいに行きました。",
      "start_ms": 27570,
      "end_ms": 32900,
      "duration_ms": 5330,
      "clauses": [
        {
          "index": 0,
          "text": "娘は急いでドレスを着て、",
          "start_ms": 27570,
          "end_ms": 30464,
          "duration_ms": 2894
        },
        {
          "index": 1,
          "text": "ぶとうかいに行きました。",
          "start_ms": 30714,
          "end_ms": 32900,
          "duration_ms": 2186
        }
      ]
    },
    {
      "index": 6,
      "text": "二人の姉やままははは、娘が分からず、「外国の王女様に違いない」と思いました。",
      "start_ms": 33400,
      "end_ms": 41931,
      "duration_ms": 8531,
      "clauses": [
        {
          "index": 0,
          "text": "二人の姉やままははは、",
          "start_ms": 33400,
          "end_ms": 35771,
          "duration_ms": 2371
        },
        {
          "index": 1,
          "text": "娘が分からず、",
          "start_ms": 36021,
          "end_ms": 37858,
          "duration_ms": 1837
        },
        {
          "index": 2,
          "text": "「外国の王女様に違いない」と思いました。",
          "start_ms": 38108,
          "end_ms": 41931,
          "duration_ms": 3823
        }
      ]
    },
    {
      "index": 7,
      "text": "金のドレスを着て、とても美しかったからです。",
      "start_ms": 42431,
      "end_ms": 47296,
      "duration_ms": 4865,
      "clauses": [
        {
          "index": 0,
          "text": "金のドレスを着て、",
          "start_ms": 42431,
          "end_ms": 44419,
          "duration_ms": 1988
        },
        {
          "index": 1,
          "text": "とても美しかったからです。",
          "start_ms": 44669,
          "end_ms": 47296,
          "duration_ms": 2627
        }
      ]
    },
    {
      "index": 8,
      "text": "おうじが娘に近づいて、手を取って一緒に踊りました。",
      "start_ms": 47796,
      "end_ms": 53474,
      "duration_ms": 5678,
      "clauses": [
        {
          "index": 0,
          "text": "おうじが娘に近づいて、",
          "start_ms": 47796,
          "end_ms": 50284,
          "duration_ms": 2488
        },
        {
          "index": 1,
          "text": "手を取って一緒に踊りました。",
          "start_ms": 50534,
          "end_ms": 53474,
          "duration_ms": 2940
        }
      ]
    },
    {
      "index": 9,
      "text": "他の娘とは踊ろうとせず、娘の手を放しませんでした。",
      "start_ms": 53974,
      "end_ms": 59977,
      "duration_ms": 6003,
      "clauses": [
        {
          "index": 0,
          "text": "他の娘とは踊ろうとせず、",
          "start_ms": 53974,
          "end_ms": 56903,
          "duration_ms": 2929
        },
        {
          "index": 1,
          "text": "娘の手を放しませんでした。",
          "start_ms": 57153,
          "end_ms": 59977,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 10,
      "text": "他の誰かが娘に申し込もうとすると、おうじは「こちらは私の相手です。",
      "start_ms": 60477,
      "end_ms": 67467,
      "duration_ms": 6990,
      "clauses": [
        {
          "index": 0,
          "text": "他の誰かが娘に申し込もうとすると、",
          "start_ms": 60477,
          "end_ms": 64056,
          "duration_ms": 3579
        },
        {
          "index": 1,
          "text": "おうじは「こちらは私の相手です。",
          "start_ms": 64306,
          "end_ms": 67467,
          "duration_ms": 3161
        }
      ]
    },
    {
      "index": 11,
      "text": "」と言いました。",
      "start_ms": 67967,
      "end_ms": 69468,
      "duration_ms": 1501,
      "clauses": [
        {
          "index": 0,
          "text": "」と言いました。",
          "start_ms": 67967,
          "end_ms": 69468,
          "duration_ms": 1501
        }
      ]
    },
    {
      "index": 12,
      "text": "娘は夕方まで踊りました。",
      "start_ms": 69968,
      "end_ms": 72874,
      "duration_ms": 2906,
      "clauses": [
        {
          "index": 0,
          "text": "娘は夕方まで踊りました。",
          "start_ms": 69968,
          "end_ms": 72874,
          "duration_ms": 2906
        }
      ]
    },
    {
      "index": 13,
      "text": "それから、家に帰ろうと思いました。",
      "start_ms": 73374,
      "end_ms": 77613,
      "duration_ms": 4239,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 73374,
          "end_ms": 74817,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "家に帰ろうと思いました。",
          "start_ms": 75067,
          "end_ms": 77613,
          "duration_ms": 2546
        }
      ]
    },
    {
      "index": 14,
      "text": "でも、おうじは「あなたと一緒に帰りたいです。",
      "start_ms": 78113,
      "end_ms": 82863,
      "duration_ms": 4750,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 78113,
          "end_ms": 79022,
          "duration_ms": 909
        },
        {
          "index": 1,
          "text": "おうじは「あなたと一緒に帰りたいです。",
          "start_ms": 79272,
          "end_ms": 82863,
          "duration_ms": 3591
        }
      ]
    },
    {
      "index": 15,
      "text": "お伴いをさせてください。",
      "start_ms": 83363,
      "end_ms": 85839,
      "duration_ms": 2476,
      "clauses": [
        {
          "index": 0,
          "text": "お伴いをさせてください。",
          "start_ms": 83363,
          "end_ms": 85839,
          "duration_ms": 2476
        }
      ]
    },
    {
      "index": 16,
      "text": "」と言いました。",
      "start_ms": 86339,
      "end_ms": 87863,
      "duration_ms": 1524,
      "clauses": [
        {
          "index": 0,
          "text": "」と言いました。",
          "start_ms": 86339,
          "end_ms": 87863,
          "duration_ms": 1524
        }
      ]
    },
    {
      "index": 17,
      "text": "おうじは、このうつくしい娘が誰の娘か知りたかったからです。",
      "start_ms": 88363,
      "end_ms": 94563,
      "duration_ms": 6200,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは、",
          "start_ms": 88363,
          "end_ms": 89515,
          "duration_ms": 1152
        },
        {
          "index": 1,
          "text": "このうつくしい娘が誰の娘か知りたかったからです。",
          "start_ms": 89765,
          "end_ms": 94563,
          "duration_ms": 4798
        }
      ]
    },
    {
      "index": 18,
      "text": "でも、娘はおうじから逃げて、はとやに飛び込みました。",
      "start_ms": 95063,
      "end_ms": 101470,
      "duration_ms": 6407,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 95063,
          "end_ms": 95960,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "娘はおうじから逃げて、",
          "start_ms": 96210,
          "end_ms": 98860,
          "duration_ms": 2650
        },
        {
          "index": 2,
          "text": "はとやに飛び込みました。",
          "start_ms": 99110,
          "end_ms": 101470,
          "duration_ms": 2360
        }
      ]
    },
    {
      "index": 19,
      "text": "おうじが待っていると、父親が来て、「見知らぬ娘がはとやに飛び込みました。",
      "start_ms": 101970,
      "end_ms": 109933,
      "duration_ms": 7963,
      "clauses": [
        {
          "index": 0,
          "text": "おうじが待っていると、",
          "start_ms": 101970,
          "end_ms": 104016,
          "duration_ms": 2046
        },
        {
