  "sentences": [
    {
      "index": 0,
      "text": "舞踏会",
      "start_ms": 0,
      "end_ms": 1443,
      "duration_ms": 1443,
      "clauses": [
        {
          "index": 0,
          "text": "舞踏会",
          "start_ms": 0,
          "end_ms": 1443,
          "duration_ms": 1443
        }
      ]
    },
    {
      "index": 1,
      "text": "もう誰もいないと分かると、シンデレラははしばみの木の下にある母親の墓に行きました。",
      "start_ms": 1943,
      "end_ms": 9746,
      "duration_ms": 7803,
      "clauses": [
        {
          "index": 0,
          "text": "もう誰もいないと分かると、",
          "start_ms": 1943,
          "end_ms": 4570,
          "duration_ms": 2627
        },
        {
          "index": 1,
          "text": "シンデレラははしばみの木の下にある母親の墓に行きました。",
          "start_ms": 4820,
          "end_ms": 9746,
          "duration_ms": 4926
        }
      ]
    },
    {
      "index": 2,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 10246,
      "end_ms": 14981,
      "duration_ms": 4735,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 10246,
          "end_ms": 11619,
          "duration_ms": 1373
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 11869,
          "end_ms": 13230,
          "duration_ms": 1361
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 13480,
          "end_ms": 14981,
          "duration_ms": 1501
        }
      ]
    },
    {
      "index": 3,
      "text": "銀と金を私に落としておくれ。」",
      "start_ms": 15481,
      "end_ms": 18642,
      "duration_ms": 3161,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。」",
          "start_ms": 15481,
          "end_ms": 18642,
          "duration_ms": 3161
        }
      ]
    },
    {
      "index": 4,
      "text": "すると、小鳥が金銀のドレスと、銀で刺しゅうされたうわぐつを落としてくれました。",
      "start_ms": 19142,
      "end_ms": 27058,
      "duration_ms": 7916,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 19142,
          "end_ms": 20329,
          "duration_ms": 1187
        },
        {
          "index": 1,
          "text": "小鳥が金銀のドレスと、",
          "start_ms": 20579,
          "end_ms": 23067,
          "duration_ms": 2488
        },
        {
          "index": 2,
          "text": "銀で刺しゅうされたうわぐつを落としてくれました。",
          "start_ms": 23317,
          "end_ms": 27058,
          "duration_ms": 3741
        }
      ]
    },
    {
      "index": 5,
      "text": "娘は急いでドレスを着て、ぶとうかいに行きました。",
      "start_ms": 27558,
      "end_ms": 32830,
      "duration_ms": 5272,
      "clauses": [
        {
          "index": 0,
          "text": "娘は急いでドレスを着て、",
          "start_ms": 27558,
          "end_ms": 30417,
          "duration_ms": 2859
        },
        {
          "index": 1,
          "text": "ぶとうかいに行きました。",
          "start_ms": 30667,
          "end_ms": 32830,
          "duration_ms": 2163
        }
      ]
    },
    {
      "index": 6,
      "text": "二人の姉やままははは、娘が分からず、「外国の王女様に違いない」と思いました。",
      "start_ms": 33330,
      "end_ms": 41955,
      "duration_ms": 8625,
      "clauses": [
        {
          "index": 0,
          "text": "二人の姉やままははは、",
          "start_ms": 33330,
          "end_ms": 35736,
          "duration_ms": 2406
        },
        {
          "index": 1,
          "text": "娘が分からず、",
          "start_ms": 35986,
          "end_ms": 37905,
          "duration_ms": 1919
        },
        {
          "index": 2,
          "text": "「外国の王女様に違いない」と思いました。",
          "start_ms": 38155,
          "end_ms": 41955,
          "duration_ms": 3800
        }
      ]
    },
    {
      "index": 7,
      "text": "金のドレスを着て、とても美しかったからです。",
      "start_ms": 42455,
      "end_ms": 47320,
      "duration_ms": 4865,
      "clauses": [
        {
          "index": 0,
          "text": "金のドレスを着て、",
          "start_ms": 42455,
          "end_ms": 44443,
          "duration_ms": 1988
        },
        {
          "index": 1,
          "text": "とても美しかったからです。",
          "start_ms": 44693,
          "end_ms": 47320,
          "duration_ms": 2627
        }
      ]
    },
    {
      "index": 8,
      "text": "おうじが娘に近づいて、手を取って一緒に踊りました。",
      "start_ms": 47820,
      "end_ms": 53463,
      "duration_ms": 5643,
      "clauses": [
        {
          "index": 0,
          "text": "おうじが娘に近づいて、",
          "start_ms": 47820,
          "end_ms": 50284,
          "duration_ms": 2464
        },
        {
          "index": 1,
          "text": "手を取って一緒に踊りました。",
          "start_ms": 50534,
          "end_ms": 53463,
          "duration_ms": 2929
        }
      ]
    },
    {
      "index": 9,
      "text": "他の娘とは踊ろうとせず、娘の手を放しませんでした。",
      "start_ms": 53963,
      "end_ms": 59931,
      "duration_ms": 5968,
      "clauses": [
        {
          "index": 0,
          "text": "他の娘とは踊ろうとせず、",
          "start_ms": 53963,
          "end_ms": 56845,
          "duration_ms": 2882
        },
        {
          "index": 1,
          "text": "娘の手を放しませんでした。",
          "start_ms": 57095,
          "end_ms": 59931,
          "duration_ms": 2836
        }
      ]
    },
    {
      "index": 10,
      "text": "他の誰かが娘に申し込もうとすると、おうじは「こちらは私の相手です。」",
      "start_ms": 60431,
      "end_ms": 67397,
      "duration_ms": 6966,
      "clauses": [
        {
          "index": 0,
          "text": "他の誰かが娘に申し込もうとすると、",
          "start_ms": 60431,
          "end_ms": 63963,
          "duration_ms": 3532
        },
        {
          "index": 1,
          "text": "おうじは「こちらは私の相手です。」",
          "start_ms": 64213,
          "end_ms": 67397,
          "duration_ms": 3184
        }
      ]
    },
    {
      "index": 11,
      "text": "と言いました。",
      "start_ms": 67897,
      "end_ms": 69386,
      "duration_ms": 1489,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 67897,
          "end_ms": 69386,
          "duration_ms": 1489
        }
      ]
    },
    {
      "index": 12,
      "text": "娘は夕方まで踊りました。",
      "start_ms": 69886,
      "end_ms": 72838,
      "duration_ms": 2952,
      "clauses": [
        {
          "index": 0,
          "text": "娘は夕方まで踊りました。",
          "start_ms": 69886,
          "end_ms": 72838,
          "duration_ms": 2952
        }
      ]
    },
    {
      "index": 13,
      "text": "それから、家に帰ろうと思いました。",
      "start_ms": 73338,
      "end_ms": 77588,
      "duration_ms": 4250,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 73338,
          "end_ms": 74769,
          "duration_ms": 1431
        },
        {
          "index": 1,
          "text": "家に帰ろうと思いました。",
          "start_ms": 75019,
          "end_ms": 77588,
          "duration_ms": 2569
        }
      ]
    },
    {
      "index": 14,
      "text": "でも、おうじは「あなたと一緒に帰りたいです。",
      "start_ms": 78088,
      "end_ms": 82872,
      "duration_ms": 4784,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 78088,
          "end_ms": 79008,
          "duration_ms": 920
        },
        {
          "index": 1,
          "text": "おうじは「あなたと一緒に帰りたいです。",
          "start_ms": 79258,
          "end_ms": 82872,
          "duration_ms": 3614
        }
      ]
    },
    {
      "index": 15,
      "text": "お伴いをさせてください。」",
      "start_ms": 83372,
      "end_ms": 85836,
      "duration_ms": 2464,
      "clauses": [
        {
          "index": 0,
          "text": "お伴いをさせてください。」",
          "start_ms": 83372,
          "end_ms": 85836,
          "duration_ms": 2464
        }
      ]
    },
    {
      "index": 16,
      "text": "と言いました。",
      "start_ms": 86336,
      "end_ms": 87883,
      "duration_ms": 1547,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 86336,
          "end_ms": 87883,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 17,
      "text": "おうじは、このうつくしい娘が誰の娘か知りたかったからです。",
      "start_ms": 88383,
      "end_ms": 94619,
      "duration_ms": 6236,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは、",
          "start_ms": 88383,
          "end_ms": 89559,
          "duration_ms": 1176
        },
        {
          "index": 1,
          "text": "このうつくしい娘が誰の娘か知りたかったからです。",
          "start_ms": 89809,
          "end_ms": 94619,
          "duration_ms": 4810
        }
      ]
    },
    {
      "index": 18,
      "text": "でも、娘はおうじから逃げて、はとやに飛び込みました。",
      "start_ms": 95119,
      "end_ms": 101445,
      "duration_ms": 6326,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 95119,
          "end_ms": 96016,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "娘はおうじから逃げて、",
          "start_ms": 96266,
          "end_ms": 98905,
          "duration_ms": 2639
        },
        {
          "index": 2,
          "text": "はとやに飛び込みました。",
          "start_ms": 99155,
          "end_ms": 101445,
          "duration_ms": 2290
        }
      ]
    },
    {
      "index": 19,
      "text": "おうじが待っていると、父親が来て、「見知らぬ娘がはとやに飛び込みました。」",
      "start_ms": 101945,
      "end_ms": 109781,
      "duration_ms": 7836,
      "clauses": [
        {
          "index": 0,
          "text": "おうじが待っていると、",
          "start_ms": 101945,
          "end_ms": 103957,
          "duration_ms": 2012
        },
        {
          "index": 1,
          "text": "父親が来て、",
          "start_ms": 104207,
          "end_ms": 106068,
          "duration_ms": 1861
        },
        {
          "index": 2,
          "text": "「見知らぬ娘がはとやに飛び込みました。」",
          "start_ms": 106318,
          "end_ms": 109781,
          "duration_ms": 3463
        }
      ]
    },
    {
      "index": 20,
      "text": "と言いました。",
      "start_ms": 110281,
      "end_ms": 111840,
      "duration_ms": 1559,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 110281,
          "end_ms": 111840,
          "duration_ms": 1559
        }
      ]
    },
    {
      "index": 21,
      "text": "父親は「シンデレラかな？」",
      "start_ms": 112340,
      "end_ms": 114770,
      "duration_ms": 2430,
      "clauses": [
        {
          "index": 0,
          "text": "父親は「シンデレラかな？」",
          "start_ms": 112340,
          "end_ms": 114770,
          "duration_ms": 2430
        }
      ]
    },
    {
      "index": 22,
      "text": "と思いました。",
      "start_ms": 115270,
      "end_ms": 116910,
      "duration_ms": 1640,
      "clauses": [
        {
          "index": 0,
          "text": "と思いました。",
          "start_ms": 115270,
          "end_ms": 116910,
          "duration_ms": 1640
        }
      ]
    },
    {
      "index": 23,
      "text": "それで、はとやを壊すために斧とつるはしを持ってこさせましたが、誰も中にはいませんでした。",
      "start_ms": 117410,
      "end_ms": 126383,
      "duration_ms": 8973,
      "clauses": [
        {
          "index": 0,
          "text": "それで、",
          "start_ms": 117410,
          "end_ms": 118481,
          "duration_ms": 1071
        },
        {
          "index": 1,
          "text": "はとやを壊すために斧とつるはしを持ってこさせましたが、",
          "start_ms": 118731,
          "end_ms": 123390,
          "duration_ms": 4659
        },
        {
          "index": 2,
          "text": "誰も中にはいませんでした。",
          "start_ms": 123640,
          "end_ms": 126383,
          "duration_ms": 2743
        }
      ]
    },
    {
      "index": 24,
      "text": "みんなが帰ってきたとき、シンデレラは灰の中で汚い服を着て、薄暗いランプが暖炉の上で燃えていました。",
      "start_ms": 126883,
      "end_ms": 137005,
      "duration_ms": 10122,
      "clauses": [
        {
          "index": 0,
          "text": "みんなが帰ってきたとき、",
          "start_ms": 126883,
          "end_ms": 129115,
          "duration_ms": 2232
        },
        {
          "index": 1,
          "text": "シンデレラは灰の中で汚い服を着て、",
          "start_ms": 129365,
          "end_ms": 132851,
          "duration_ms": 3486
        },
        {
          "index": 2,
          "text": "薄暗いランプが暖炉の上で燃えていました。",
          "start_ms": 133101,
          "end_ms": 137005,
          "duration_ms": 3904
        }
      ]
    },
    {
      "index": 25,
      "text": "翌日、ぶとうかいがまた始まりました。",
      "start_ms": 137505,
      "end_ms": 142034,
      "duration_ms": 4529,
      "clauses": [
        {
          "index": 0,
          "text": "翌日、",
          "start_ms": 137505,
          "end_ms": 138948,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "ぶとうかいがまた始まりました。",
          "start_ms": 139198,
          "end_ms": 142034,
          "duration_ms": 2836
        }
      ]
    },
    {
      "index": 26,
      "text": "両親と姉たちが出かけると、シンデレラははしばみの木に行きました。",
      "start_ms": 142534,
      "end_ms": 149175,
      "duration_ms": 6641,
      "clauses": [
        {
          "index": 0,
          "text": "両親と姉たちが出かけると、",
          "start_ms": 142534,
          "end_ms": 145660,
          "duration_ms": 3126
        },
        {
          "index": 1,
          "text": "シンデレラははしばみの木に行きました。",
          "start_ms": 145910,
          "end_ms": 149175,
          "duration_ms": 3265
        }
      ]
    },
    {
      "index": 27,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 149675,
      "end_ms": 154456,
      "duration_ms": 4781,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 149675,
          "end_ms": 151071,
          "duration_ms": 1396
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 151321,
          "end_ms": 152717,
          "duration_ms": 1396
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 152967,
          "end_ms": 154456,
          "duration_ms": 1489
        }
      ]
    },
    {
      "index": 28,
      "text": "銀と金を私に落としておくれ。」",
      "start_ms": 154956,
      "end_ms": 158117,
      "duration_ms": 3161,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。」",
          "start_ms": 154956,
          "end_ms": 158117,
          "duration_ms": 3161
        }
      ]
    },
    {
      "index": 29,
      "text": "すると、小鳥は前日よりさらにうつくしいドレスを落としてくれました。",
      "start_ms": 158617,
      "end_ms": 165131,
      "duration_ms": 6514,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 158617,
          "end_ms": 159793,
          "duration_ms": 1176
        },
        {
          "index": 1,
          "text": "小鳥は前日よりさらにうつくしいドレスを落としてくれました。",
          "start_ms": 160043,
          "end_ms": 165131,
          "duration_ms": 5088
        }
      ]
    },
    {
      "index": 30,
      "text": "シンデレラがそのドレスを着てぶとうかいに現れると、みんながその美しさに驚きました。",
      "start_ms": 165631,
      "end_ms": 173793,
      "duration_ms": 8162,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラがそのドレスを着てぶとうかいに現れると、",
          "start_ms": 165631,
          "end_ms": 170127,
          "duration_ms": 4496
        },
        {
          "index": 1,
          "text": "みんながその美しさに驚きました。",
          "start_ms": 170377,
          "end_ms": 173793,
          "duration_ms": 3416
        }
      ]
    },
    {
      "index": 31,
      "text": "おうじは娘が来るまで待っていて、すぐに娘の手を取って、娘とだけ踊りました。",
      "start_ms": 174293,
      "end_ms": 182686,
      "duration_ms": 8393,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘が来るまで待っていて、",
          "start_ms": 174293,
          "end_ms": 177315,
          "duration_ms": 3022
        },
        {
          "index": 1,
          "text": "すぐに娘の手を取って、",
          "start_ms": 177565,
          "end_ms": 179995,
          "duration_ms": 2430
        },
        {
          "index": 2,
          "text": "娘とだけ踊りました。",
          "start_ms": 180245,
          "end_ms": 182686,
          "duration_ms": 2441
        }
      ]
    },
    {
      "index": 32,
      "text": "夕方になると、娘は家に帰ろうとしました。",
      "start_ms": 183186,
      "end_ms": 188272,
      "duration_ms": 5086,
      "clauses": [
        {
          "index": 0,
          "text": "夕方になると、",
          "start_ms": 183186,
          "end_ms": 185035,
          "duration_ms": 1849
        },
        {
          "index": 1,
          "text": "娘は家に帰ろうとしました。",
          "start_ms": 185285,
          "end_ms": 188272,
          "duration_ms": 2987
        }
      ]
    },
    {
      "index": 33,
      "text": "おうじは娘のあとをつけて、どの家に行ったか確かめしようとしました。",
      "start_ms": 188772,
      "end_ms": 195181,
      "duration_ms": 6409,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘のあとをつけて、",
          "start_ms": 188772,
          "end_ms": 191422,
          "duration_ms": 2650
        },
        {
          "index": 1,
          "text": "どの家に行ったか確かめしようとしました。",
          "start_ms": 191672,
          "end_ms": 195181,
          "duration_ms": 3509
        }
      ]
    },
    {
      "index": 34,
      "text": "でも、娘は跳んで逃げて、家の後ろの庭に入りました。",
      "start_ms": 195681,
      "end_ms": 201879,
      "duration_ms": 6198,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 195681,
          "end_ms": 196566,
          "duration_ms": 885
        },
        {
          "index": 1,
          "text": "娘は跳んで逃げて、",
          "start_ms": 196816,
          "end_ms": 198979,
          "duration_ms": 2163
        },
        {
          "index": 2,
          "text": "家の後ろの庭に入りました。",
          "start_ms": 199229,
          "end_ms": 201879,
          "duration_ms": 2650
        }
      ]
    },
    {
      "index": 35,
      "text": "庭に梨の実がついているうつくしい高い木がありました。",
      "start_ms": 202379,
      "end_ms": 206666,
      "duration_ms": 4287,
      "clauses": [
        {
          "index": 0,
          "text": "庭に梨の実がついているうつくしい高い木がありました。",
          "start_ms": 202379,
          "end_ms": 206666,
          "duration_ms": 4287
        }
      ]
    },
    {
      "index": 36,
      "text": "娘はリスのようにすばしっこく枝の間によじ登ったので、おうじはどこに消えたのか分かりませんでした。",
      "start_ms": 207166,
      "end_ms": 216478,
      "duration_ms": 9312,
      "clauses": [
        {
          "index": 0,
          "text": "娘はリスのようにすばしっこく枝の間によじ登ったので、",
          "start_ms": 207166,
          "end_ms": 212417,
          "duration_ms": 5251
        },
        {
          "index": 1,
          "text": "おうじはどこに消えたのか分かりませんでした。",
          "start_ms": 212667,
          "end_ms": 216478,
          "duration_ms": 3811
        }
      ]
    },
    {
      "index": 37,
      "text": "三日目、両親と姉たちが出かけると、シンデレラははしばみの木に行きました。",
      "start_ms": 216978,
      "end_ms": 224905,
      "duration_ms": 7927,
      "clauses": [
        {
          "index": 0,
          "text": "三日目、",
          "start_ms": 216978,
          "end_ms": 218165,
          "duration_ms": 1187
        },
        {
          "index": 1,
          "text": "両親と姉たちが出かけると、",
          "start_ms": 218415,
          "end_ms": 221471,
          "duration_ms": 3056
        },
        {
          "index": 2,
          "text": "シンデレラははしばみの木に行きました。",
          "start_ms": 221721,
          "end_ms": 224905,
          "duration_ms": 3184
        }
      ]
    },
    {
      "index": 38,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 225405,
      "end_ms": 230210,
      "duration_ms": 4805,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 225405,
          "end_ms": 226813,
          "duration_ms": 1408
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 227063,
          "end_ms": 228448,
          "duration_ms": 1385
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 228698,
          "end_ms": 230210,
          "duration_ms": 1512
        }
      ]
    },
    {
      "index": 39,
      "text": "銀と金を私に落としておくれ。」",
      "start_ms": 230710,
      "end_ms": 233848,
      "duration_ms": 3138,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。」",
          "start_ms": 230710,
          "end_ms": 233848,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 40,
      "text": "今度の小鳥は、これまでのどのドレスよりもすばらしく豪華なドレスを落としてくれました。",
      "start_ms": 234348,
      "end_ms": 242441,
      "duration_ms": 8093,
      "clauses": [
        {
          "index": 0,
          "text": "今度の小鳥は、",
          "start_ms": 234348,
          "end_ms": 236209,
          "duration_ms": 1861
        },
        {
          "index": 1,
          "text": "これまでのどのドレスよりもすばらしく豪華なドレスを落としてくれました。",
          "start_ms": 236459,
          "end_ms": 242441,
          "duration_ms": 5982
        }
      ]
    },
    {
      "index": 41,
      "text": "うわぐつも金でした。",
      "start_ms": 242941,
      "end_ms": 245104,
      "duration_ms": 2163,
      "clauses": [
        {
          "index": 0,
          "text": "うわぐつも金でした。",
          "start_ms": 242941,
          "end_ms": 245104,
          "duration_ms": 2163
        }
      ]
    },
    {
      "index": 42,
      "text": "ぶとうかいに行くと、驚きのあまり誰もどうしていいか分かりませんでした。",
      "start_ms": 245604,
      "end_ms": 252187,
      "duration_ms": 6583,
      "clauses": [
        {
          "index": 0,
          "text": "ぶとうかいに行くと、",
          "start_ms": 245604,
          "end_ms": 247476,
          "duration_ms": 1872
        },
        {
          "index": 1,
          "text": "驚きのあまり誰もどうしていいか分かりませんでした。",
          "start_ms": 247726,
          "end_ms": 252187,
          "duration_ms": 4461
        }
      ]
    },
    {
      "index": 43,
      "text": "おうじは娘とだけ踊りました。",
      "start_ms": 252687,
      "end_ms": 255813,
      "duration_ms": 3126,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘とだけ踊りました。",
          "start_ms": 252687,
          "end_ms": 255813,
          "duration_ms": 3126
        }
      ]
    },
    {
      "index": 44,
      "text": "夕方になると、シンデレラは帰ろうとしました。",
      "start_ms": 256313,
      "end_ms": 261318,
      "duration_ms": 5005,
      "clauses": [
        {
          "index": 0,
          "text": "夕方になると、",
          "start_ms": 256313,
          "end_ms": 258197,
          "duration_ms": 1884
        },
        {
          "index": 1,
          "text": "シンデレラは帰ろうとしました。",
          "start_ms": 258447,
          "end_ms": 261318,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 45,
      "text": "おうじは娘と一緒に行きたがりましたが、娘は素早く逃げました。",
      "start_ms": 261818,
      "end_ms": 268436,
      "duration_ms": 6618,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘と一緒に行きたがりましたが、",
          "start_ms": 261818,
          "end_ms": 265350,
          "duration_ms": 3532
        },
        {
          "index": 1,
          "text": "娘は素早く逃げました。",
          "start_ms": 265600,
          "end_ms": 268436,
          "duration_ms": 2836
        }
      ]
    },
    {
      "index": 46,
      "text": "でも、おうじはけいりゃくを練っていて、かいだんにピッチを塗らせておいたのです。",
      "start_ms": 268936,
      "end_ms": 276237,
      "duration_ms": 7301,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 268936,
          "end_ms": 269833,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "おうじはけいりゃくを練っていて、",
          "start_ms": 270083,
          "end_ms": 272768,
          "duration_ms": 2685
        },
        {
          "index": 2,
          "text": "かいだんにピッチを塗らせておいたのです。",
          "start_ms": 273018,
          "end_ms": 276237,
          "duration_ms": 3219
        }
      ]
    },
    {
      "index": 47,
      "text": "娘が駆け下りると、左のうわぐつがくっついて離れませんでした。",
      "start_ms": 276737,
      "end_ms": 282880,
      "duration_ms": 6143,
      "clauses": [
        {
          "index": 0,
          "text": "娘が駆け下りると、",
          "start_ms": 276737,
          "end_ms": 278900,
          "duration_ms": 2163
        },
        {
          "index": 1,
          "text": "左のうわぐつがくっついて離れませんでした。",
          "start_ms": 279150,
          "end_ms": 282880,
          "duration_ms": 3730
        }
      ]
    }
  ]
}