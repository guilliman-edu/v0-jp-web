  "sentences": [
    {
      "index": 0,
      "text": "ぶとうかい",
      "start_ms": 0,
      "end_ms": 1466,
      "duration_ms": 1466,
      "clauses": [
        {
          "index": 0,
          "text": "ぶとうかい",
          "start_ms": 0,
          "end_ms": 1466,
          "duration_ms": 1466
        }
      ]
    },
    {
      "index": 1,
      "text": "もう誰もいないと分かると、シンデレラははしばみの木の下にある母親の墓に行きました。",
      "start_ms": 1966,
      "end_ms": 9873,
      "duration_ms": 7907,
      "clauses": [
        {
          "index": 0,
          "text": "もう誰もいないと分かると、",
          "start_ms": 1966,
          "end_ms": 4686,
          "duration_ms": 2720
        },
        {
          "index": 1,
          "text": "シンデレラははしばみの木の下にある母親の墓に行きました。",
          "start_ms": 4936,
          "end_ms": 9873,
          "duration_ms": 4937
        }
      ]
    },
    {
      "index": 2,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 10373,
      "end_ms": 15167,
      "duration_ms": 4794,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 10373,
          "end_ms": 11758,
          "duration_ms": 1385
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 12008,
          "end_ms": 13416,
          "duration_ms": 1408
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 13666,
          "end_ms": 15167,
          "duration_ms": 1501
        }
      ]
    },
    {
      "index": 3,
      "text": "銀と金を私に落としておくれ。」",
      "start_ms": 15667,
      "end_ms": 18828,
      "duration_ms": 3161,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。」",
          "start_ms": 15667,
          "end_ms": 18828,
          "duration_ms": 3161
        }
      ]
    },
    {
      "index": 4,
      "text": "すると、小鳥が金銀のドレスと、銀で刺しゅうされたうわぐつを落としてくれました。",
      "start_ms": 19328,
      "end_ms": 27314,
      "duration_ms": 7986,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 19328,
          "end_ms": 20515,
          "duration_ms": 1187
        },
        {
          "index": 1,
          "text": "小鳥が金銀のドレスと、",
          "start_ms": 20765,
          "end_ms": 23264,
          "duration_ms": 2499
        },
        {
          "index": 2,
          "text": "銀で刺しゅうされたうわぐつを落としてくれました。",
          "start_ms": 23514,
          "end_ms": 27314,
          "duration_ms": 3800
        }
      ]
    },
    {
      "index": 5,
      "text": "娘は急いでドレスを着て、ぶとうかいに行きました。",
      "start_ms": 27814,
      "end_ms": 33121,
      "duration_ms": 5307,
      "clauses": [
        {
          "index": 0,
          "text": "娘は急いでドレスを着て、",
          "start_ms": 27814,
          "end_ms": 30708,
          "duration_ms": 2894
        },
        {
          "index": 1,
          "text": "ぶとうかいに行きました。",
          "start_ms": 30958,
          "end_ms": 33121,
          "duration_ms": 2163
        }
      ]
    },
    {
      "index": 6,
      "text": "二人の姉やままははは、娘が分からず、「外国の王女様に違いない」と思いました。",
      "start_ms": 33621,
      "end_ms": 42234,
      "duration_ms": 8613,
      "clauses": [
        {
          "index": 0,
          "text": "二人の姉やままははは、",
          "start_ms": 33621,
          "end_ms": 36051,
          "duration_ms": 2430
        },
        {
          "index": 1,
          "text": "娘が分からず、",
          "start_ms": 36301,
          "end_ms": 38173,
          "duration_ms": 1872
        },
        {
          "index": 2,
          "text": "「外国の王女様に違いない」と思いました。",
          "start_ms": 38423,
          "end_ms": 42234,
          "duration_ms": 3811
        }
      ]
    },
    {
      "index": 7,
      "text": "金のドレスを着て、とても美しかったからです。",
      "start_ms": 42734,
      "end_ms": 47460,
      "duration_ms": 4726,
      "clauses": [
        {
          "index": 0,
          "text": "金のドレスを着て、",
          "start_ms": 42734,
          "end_ms": 44676,
          "duration_ms": 1942
        },
        {
          "index": 1,
          "text": "とても美しかったからです。",
          "start_ms": 44926,
          "end_ms": 47460,
          "duration_ms": 2534
        }
      ]
    },
    {
      "index": 8,
      "text": "おうじが娘に近づいて、手を取って一緒に踊りました。",
      "start_ms": 47960,
      "end_ms": 53684,
      "duration_ms": 5724,
      "clauses": [
        {
          "index": 0,
          "text": "おうじが娘に近づいて、",
          "start_ms": 47960,
          "end_ms": 50459,
          "duration_ms": 2499
        },
        {
          "index": 1,
          "text": "手を取って一緒に踊りました。",
          "start_ms": 50709,
          "end_ms": 53684,
          "duration_ms": 2975
        }
      ]
    },
    {
      "index": 9,
      "text": "他の娘とは踊ろうとせず、娘の手を放しませんでした。",
      "start_ms": 54184,
      "end_ms": 60117,
      "duration_ms": 5933,
      "clauses": [
        {
          "index": 0,
          "text": "他の娘とは踊ろうとせず、",
          "start_ms": 54184,
          "end_ms": 57066,
          "duration_ms": 2882
        },
        {
          "index": 1,
          "text": "娘の手を放しませんでした。",
          "start_ms": 57316,
          "end_ms": 60117,
          "duration_ms": 2801
        }
      ]
    },
    {
      "index": 10,
      "text": "他の誰かが娘に申し込もうとすると、おうじは「こちらは私の相手です。」",
      "start_ms": 60617,
      "end_ms": 67665,
      "duration_ms": 7048,
      "clauses": [
        {
          "index": 0,
          "text": "他の誰かが娘に申し込もうとすると、",
          "start_ms": 60617,
          "end_ms": 64184,
          "duration_ms": 3567
        },
        {
          "index": 1,
          "text": "おうじは「こちらは私の相手です。」",
          "start_ms": 64434,
          "end_ms": 67665,
          "duration_ms": 3231
        }
      ]
    },
    {
      "index": 11,
      "text": "と言いました。",
      "start_ms": 68165,
      "end_ms": 69712,
      "duration_ms": 1547,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 68165,
          "end_ms": 69712,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 12,
      "text": "娘は夕方まで踊りました。",
      "start_ms": 70212,
      "end_ms": 73129,
      "duration_ms": 2917,
      "clauses": [
        {
          "index": 0,
          "text": "娘は夕方まで踊りました。",
          "start_ms": 70212,
          "end_ms": 73129,
          "duration_ms": 2917
        }
      ]
    },
    {
      "index": 13,
      "text": "それから、家に帰ろうと思いました。",
      "start_ms": 73629,
      "end_ms": 77786,
      "duration_ms": 4157,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 73629,
          "end_ms": 75025,
          "duration_ms": 1396
        },
        {
          "index": 1,
          "text": "家に帰ろうと思いました。",
          "start_ms": 75275,
          "end_ms": 77786,
          "duration_ms": 2511
        }
      ]
    },
    {
      "index": 14,
      "text": "でも、おうじは「あなたと一緒に帰りたいです。",
      "start_ms": 78286,
      "end_ms": 82953,
      "duration_ms": 4667,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 78286,
          "end_ms": 79171,
          "duration_ms": 885
        },
        {
          "index": 1,
          "text": "おうじは「あなたと一緒に帰りたいです。",
          "start_ms": 79421,
          "end_ms": 82953,
          "duration_ms": 3532
        }
      ]
    },
    {
      "index": 15,
      "text": "お伴いをさせてください。」",
      "start_ms": 83453,
      "end_ms": 85906,
      "duration_ms": 2453,
      "clauses": [
        {
          "index": 0,
          "text": "お伴いをさせてください。」",
          "start_ms": 83453,
          "end_ms": 85906,
          "duration_ms": 2453
        }
      ]
    },
    {
      "index": 16,
      "text": "と言いました。",
      "start_ms": 86406,
      "end_ms": 87953,
      "duration_ms": 1547,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 86406,
          "end_ms": 87953,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 17,
      "text": "おうじは、このうつくしい娘が誰の娘か知りたかったからです。",
      "start_ms": 88453,
      "end_ms": 94630,
      "duration_ms": 6177,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは、",
          "start_ms": 88453,
          "end_ms": 89501,
          "duration_ms": 1048
        },
        {
          "index": 1,
          "text": "このうつくしい娘が誰の娘か知りたかったからです。",
          "start_ms": 89751,
          "end_ms": 94630,
          "duration_ms": 4879
        }
      ]
    },
    {
      "index": 18,
      "text": "でも、娘はおうじから逃げて、はとやに飛び込みました。",
      "start_ms": 95130,
      "end_ms": 101491,
      "duration_ms": 6361,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 95130,
          "end_ms": 96015,
          "duration_ms": 885
        },
        {
          "index": 1,
          "text": "娘はおうじから逃げて、",
          "start_ms": 96265,
          "end_ms": 98904,
          "duration_ms": 2639
        },
        {
          "index": 2,
          "text": "はとやに飛び込みました。",
          "start_ms": 99154,
          "end_ms": 101491,
          "duration_ms": 2337
        }
      ]
    },
    {
      "index": 19,
      "text": "おうじが待っていると、父親が来て、「見知らぬ娘がはとやに飛び込みました。」",
      "start_ms": 101991,
      "end_ms": 109895,
      "duration_ms": 7904,
      "clauses": [
        {
          "index": 0,
          "text": "おうじが待っていると、",
          "start_ms": 101991,
          "end_ms": 103956,
          "duration_ms": 1965
        },
        {
          "index": 1,
          "text": "父親が来て、",
          "start_ms": 104206,
          "end_ms": 106043,
          "duration_ms": 1837
        },
        {
          "index": 2,
          "text": "「見知らぬ娘がはとやに飛び込みました。」",
          "start_ms": 106293,
          "end_ms": 109895,
          "duration_ms": 3602
        }
      ]
    },
    {
      "index": 20,
      "text": "と言いました。",
      "start_ms": 110395,
      "end_ms": 111942,
      "duration_ms": 1547,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 110395,
          "end_ms": 111942,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 21,
      "text": "父親は「シンデレラかな？」",
      "start_ms": 112442,
      "end_ms": 114860,
      "duration_ms": 2418,
      "clauses": [
        {
          "index": 0,
          "text": "父親は「シンデレラかな？」",
          "start_ms": 112442,
          "end_ms": 114860,
          "duration_ms": 2418
        }
      ]
    },
    {
      "index": 22,
      "text": "と思いました。",
      "start_ms": 115360,
      "end_ms": 117012,
      "duration_ms": 1652,
      "clauses": [
        {
          "index": 0,
          "text": "と思いました。",
          "start_ms": 115360,
          "end_ms": 117012,
          "duration_ms": 1652
        }
      ]
    },
    {
      "index": 23,
      "text": "それで、はとやを壊すために斧とつるはしを持ってこさせましたが、誰も中にはいませんでした。",
      "start_ms": 117512,
      "end_ms": 126450,
      "duration_ms": 8938,
      "clauses": [
        {
          "index": 0,
          "text": "それで、",
          "start_ms": 117512,
          "end_ms": 118653,
          "duration_ms": 1141
        },
        {
          "index": 1,
          "text": "はとやを壊すために斧とつるはしを持ってこさせましたが、",
          "start_ms": 118903,
          "end_ms": 123515,
          "duration_ms": 4612
        },
        {
          "index": 2,
          "text": "誰も中にはいませんでした。",
          "start_ms": 123765,
          "end_ms": 126450,
          "duration_ms": 2685
        }
      ]
    },
    {
      "index": 24,
      "text": "みんなが帰ってきたとき、シンデレラは灰の中で汚い服を着て、薄暗いランプが暖炉の上で燃えていました。",
      "start_ms": 126950,
      "end_ms": 137096,
      "duration_ms": 10146,
      "clauses": [
        {
          "index": 0,
          "text": "みんなが帰ってきたとき、",
          "start_ms": 126950,
          "end_ms": 129217,
          "duration_ms": 2267
        },
        {
          "index": 1,
          "text": "シンデレラは灰の中で汚い服を着て、",
          "start_ms": 129467,
          "end_ms": 132930,
          "duration_ms": 3463
        },
        {
          "index": 2,
          "text": "薄暗いランプが暖炉の上で燃えていました。",
          "start_ms": 133180,
          "end_ms": 137096,
          "duration_ms": 3916
        }
      ]
    },
    {
      "index": 25,
      "text": "翌日、ぶとうかいがまた始まりました。",
      "start_ms": 137596,
      "end_ms": 142055,
      "duration_ms": 4459,
      "clauses": [
        {
          "index": 0,
          "text": "翌日、",
          "start_ms": 137596,
          "end_ms": 139027,
          "duration_ms": 1431
        },
        {
          "index": 1,
          "text": "ぶとうかいがまた始まりました。",
          "start_ms": 139277,
          "end_ms": 142055,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 26,
      "text": "両親と姉たちが出かけると、シンデレラははしばみの木に行きました。",
      "start_ms": 142555,
      "end_ms": 149103,
      "duration_ms": 6548,
      "clauses": [
        {
          "index": 0,
          "text": "両親と姉たちが出かけると、",
          "start_ms": 142555,
          "end_ms": 145611,
          "duration_ms": 3056
        },
        {
          "index": 1,
          "text": "シンデレラははしばみの木に行きました。",
          "start_ms": 145861,
          "end_ms": 149103,
          "duration_ms": 3242
        }
      ]
    },
    {
      "index": 27,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 149603,
      "end_ms": 154407,
      "duration_ms": 4804,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 149603,
          "end_ms": 150999,
          "duration_ms": 1396
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 151249,
          "end_ms": 152645,
          "duration_ms": 1396
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 152895,
          "end_ms": 154407,
          "duration_ms": 1512
        }
      ]
    },
    {
      "index": 28,
      "text": "銀と金を私に落としておくれ。」",
      "start_ms": 154907,
      "end_ms": 158033,
      "duration_ms": 3126,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。」",
          "start_ms": 154907,
          "end_ms": 158033,
          "duration_ms": 3126
        }
      ]
    },
    {
      "index": 29,
      "text": "すると、小鳥は前日よりさらにうつくしいドレスを落としてくれました。",
      "start_ms": 158533,
      "end_ms": 165209,
      "duration_ms": 6676,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 158533,
          "end_ms": 159697,
          "duration_ms": 1164
        },
        {
          "index": 1,
          "text": "小鳥は前日よりさらにうつくしいドレスを落としてくれました。",
          "start_ms": 159947,
          "end_ms": 165209,
          "duration_ms": 5262
        }
      ]
    },
    {
      "index": 30,
      "text": "シンデレラがそのドレスを着てぶとうかいに現れると、みんながその美しさに驚きました。",
      "start_ms": 165709,
      "end_ms": 173987,
      "duration_ms": 8278,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラがそのドレスを着てぶとうかいに現れると、",
          "start_ms": 165709,
          "end_ms": 170286,
          "duration_ms": 4577
        },
        {
          "index": 1,
          "text": "みんながその美しさに驚きました。",
          "start_ms": 170536,
          "end_ms": 173987,
          "duration_ms": 3451
        }
      ]
    },
    {
      "index": 31,
      "text": "おうじは娘が来るまで待っていて、すぐに娘の手を取って、娘とだけ踊りました。",
      "start_ms": 174487,
      "end_ms": 182949,
      "duration_ms": 8462,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘が来るまで待っていて、",
          "start_ms": 174487,
          "end_ms": 177474,
          "duration_ms": 2987
        },
        {
          "index": 1,
          "text": "すぐに娘の手を取って、",
          "start_ms": 177724,
          "end_ms": 180235,
          "duration_ms": 2511
        },
        {
          "index": 2,
          "text": "娘とだけ踊りました。",
          "start_ms": 180485,
          "end_ms": 182949,
          "duration_ms": 2464
        }
      ]
    },
    {
      "index": 32,
      "text": "夕方になると、娘は家に帰ろうとしました。",
      "start_ms": 183449,
      "end_ms": 188639,
      "duration_ms": 5190,
      "clauses": [
        {
          "index": 0,
          "text": "夕方になると、",
          "start_ms": 183449,
          "end_ms": 185286,
          "duration_ms": 1837
        },
        {
          "index": 1,
          "text": "娘は家に帰ろうとしました。",
          "start_ms": 185536,
          "end_ms": 188639,
          "duration_ms": 3103
        }
      ]
    },
    {
      "index": 33,
      "text": "おうじは娘のあとをつけて、どの家に行ったか確かめしようとしました。",
      "start_ms": 189139,
      "end_ms": 195502,
      "duration_ms": 6363,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘のあとをつけて、",
          "start_ms": 189139,
          "end_ms": 191824,
          "duration_ms": 2685
        },
        {
          "index": 1,
          "text": "どの家に行ったか確かめしようとしました。",
          "start_ms": 192074,
          "end_ms": 195502,
          "duration_ms": 3428
        }
      ]
    },
    {
      "index": 34,
      "text": "でも、娘は跳んで逃げて、家の後ろの庭に入りました。",
      "start_ms": 196002,
      "end_ms": 202293,
      "duration_ms": 6291,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 196002,
          "end_ms": 196911,
          "duration_ms": 909
        },
        {
          "index": 1,
          "text": "娘は跳んで逃げて、",
          "start_ms": 197161,
          "end_ms": 199335,
          "duration_ms": 2174
        },
        {
          "index": 2,
          "text": "家の後ろの庭に入りました。",
          "start_ms": 199585,
          "end_ms": 202293,
          "duration_ms": 2708
        }
      ]
    },
    {
      "index": 35,
      "text": "庭に梨の実がついているうつくしい高い木がありました。",
      "start_ms": 202793,
      "end_ms": 207057,
      "duration_ms": 4264,
      "clauses": [
        {
          "index": 0,
          "text": "庭に梨の実がついているうつくしい高い木がありました。",
          "start_ms": 202793,
          "end_ms": 207057,
          "duration_ms": 4264
        }
      ]
    },
    {
      "index": 36,
      "text": "娘はリスのようにすばしっこく枝の間によじ登ったので、おうじはどこに消えたのか分かりませんでした。",
      "start_ms": 207557,
      "end_ms": 216799,
      "duration_ms": 9242,
      "clauses": [
        {
          "index": 0,
          "text": "娘はリスのようにすばしっこく枝の間によじ登ったので、",
          "start_ms": 207557,
          "end_ms": 212761,
          "duration_ms": 5204
        },
        {
          "index": 1,
          "text": "おうじはどこに消えたのか分かりませんでした。",
          "start_ms": 213011,
          "end_ms": 216799,
          "duration_ms": 3788
        }
      ]
    },
    {
      "index": 37,
      "text": "三日目、両親と姉たちが出かけると、シンデレラははしばみの木に行きました。",
      "start_ms": 217299,
      "end_ms": 225273,
      "duration_ms": 7974,
      "clauses": [
        {
          "index": 0,
          "text": "三日目、",
          "start_ms": 217299,
          "end_ms": 218463,
          "duration_ms": 1164
        },
        {
          "index": 1,
          "text": "両親と姉たちが出かけると、",
          "start_ms": 218713,
          "end_ms": 221781,
          "duration_ms": 3068
        },
        {
          "index": 2,
          "text": "シンデレラははしばみの木に行きました。",
          "start_ms": 222031,
          "end_ms": 225273,
          "duration_ms": 3242
        }
      ]
    },
    {
      "index": 38,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 225773,
      "end_ms": 230484,
      "duration_ms": 4711,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 225773,
          "end_ms": 227111,
          "duration_ms": 1338
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 227361,
          "end_ms": 228722,
          "duration_ms": 1361
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 228972,
          "end_ms": 230484,
          "duration_ms": 1512
        }
      ]
    },
    {
      "index": 39,
      "text": "銀と金を私に落としておくれ。」",
      "start_ms": 230984,
      "end_ms": 234133,
      "duration_ms": 3149,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。」",
          "start_ms": 230984,
          "end_ms": 234133,
          "duration_ms": 3149
        }
      ]
    },
    {
      "index": 40,
      "text": "今度の小鳥は、これまでのどのドレスよりもすばらしく豪華なドレスを落としてくれました。",
      "start_ms": 234633,
      "end_ms": 242703,
      "duration_ms": 8070,
      "clauses": [
        {
          "index": 0,
          "text": "今度の小鳥は、",
          "start_ms": 234633,
          "end_ms": 236459,
          "duration_ms": 1826
        },
        {
          "index": 1,
          "text": "これまでのどのドレスよりもすばらしく豪華なドレスを落としてくれました。",
          "start_ms": 236709,
          "end_ms": 242703,
          "duration_ms": 5994
        }
      ]
    },
    {
      "index": 41,
      "text": "うわぐつも金でした。",
      "start_ms": 243203,
      "end_ms": 245319,
      "duration_ms": 2116,
      "clauses": [
        {
          "index": 0,
          "text": "うわぐつも金でした。",
          "start_ms": 243203,
          "end_ms": 245319,
          "duration_ms": 2116
        }
      ]
    },
    {
      "index": 42,
      "text": "ぶとうかいに行くと、驚きのあまり誰もどうしていいか分かりませんでした。",
      "start_ms": 245819,
      "end_ms": 252333,
      "duration_ms": 6514,
      "clauses": [
        {
          "index": 0,
          "text": "ぶとうかいに行くと、",
          "start_ms": 245819,
          "end_ms": 247691,
          "duration_ms": 1872
        },
        {
          "index": 1,
          "text": "驚きのあまり誰もどうしていいか分かりませんでした。",
          "start_ms": 247941,
          "end_ms": 252333,
          "duration_ms": 4392
        }
      ]
    },
    {
      "index": 43,
      "text": "おうじは娘とだけ踊りました。",
      "start_ms": 252833,
      "end_ms": 255936,
      "duration_ms": 3103,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘とだけ踊りました。",
          "start_ms": 252833,
          "end_ms": 255936,
          "duration_ms": 3103
        }
      ]
    },
    {
      "index": 44,
      "text": "夕方になると、シンデレラは帰ろうとしました。",
      "start_ms": 256436,
      "end_ms": 261359,
      "duration_ms": 4923,
      "clauses": [
        {
          "index": 0,
          "text": "夕方になると、",
          "start_ms": 256436,
          "end_ms": 258227,
          "duration_ms": 1791
        },
        {
          "index": 1,
          "text": "シンデレラは帰ろうとしました。",
          "start_ms": 258477,
          "end_ms": 261359,
          "duration_ms": 2882
        }
      ]
    },
    {
      "index": 45,
      "text": "おうじは娘と一緒に行きたがりましたが、娘は素早く逃げました。",
      "start_ms": 261859,
      "end_ms": 268385,
      "duration_ms": 6526,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘と一緒に行きたがりましたが、",
          "start_ms": 261859,
          "end_ms": 265299,
          "duration_ms": 3440
        },
        {
          "index": 1,
          "text": "娘は素早く逃げました。",
          "start_ms": 265549,
          "end_ms": 268385,
          "duration_ms": 2836
        }
      ]
    },
    {
      "index": 46,
      "text": "でも、おうじはけいりゃくを練っていて、かいだんにピッチを塗らせておいたのです。",
      "start_ms": 268885,
      "end_ms": 276303,
      "duration_ms": 7418,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 268885,
          "end_ms": 269794,
          "duration_ms": 909
        },
        {
          "index": 1,
          "text": "おうじはけいりゃくを練っていて、",
          "start_ms": 270044,
          "end_ms": 272857,
          "duration_ms": 2813
        },
        {
          "index": 2,
          "text": "かいだんにピッチを塗らせておいたのです。",
          "start_ms": 273107,
          "end_ms": 276303,
          "duration_ms": 3196
        }
      ]
    },
    {
      "index": 47,
      "text": "娘が駆け下りると、左のうわぐつがくっついて離れませんでした。",
      "start_ms": 276803,
      "end_ms": 282957,
      "duration_ms": 6154,
      "clauses": [
        {
          "index": 0,
          "text": "娘が駆け下りると、",
          "start_ms": 276803,
          "end_ms": 278954,
          "duration_ms": 2151
        },
        {
          "index": 1,
          "text": "左のうわぐつがくっついて離れませんでした。",
          "start_ms": 279204,
          "end_ms": 282957,
          "duration_ms": 3753
        }
      ]
    }
  ]
}