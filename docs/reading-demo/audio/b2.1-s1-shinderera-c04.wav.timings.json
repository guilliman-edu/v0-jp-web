          "start_ms": 0,
          "end_ms": 1431,
          "duration_ms": 1431
        }
      ]
    },
    {
      "index": 1,
      "text": "もう誰もいないと分かると、シンデレラははしばみの木の下にある母親の墓に行きました。",
      "start_ms": 1931,
      "end_ms": 9780,
      "duration_ms": 7849,
      "clauses": [
        {
          "index": 0,
          "text": "もう誰もいないと分かると、",
          "start_ms": 1931,
          "end_ms": 4662,
          "duration_ms": 2731
        },
        {
          "index": 1,
          "text": "シンデレラははしばみの木の下にある母親の墓に行きました。",
          "start_ms": 4912,
          "end_ms": 9780,
          "duration_ms": 4868
        }
      ]
    },
    {
      "index": 2,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 10280,
      "end_ms": 15050,
      "duration_ms": 4770,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 10280,
          "end_ms": 11653,
          "duration_ms": 1373
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 11903,
          "end_ms": 13288,
          "duration_ms": 1385
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 13538,
          "end_ms": 15050,
          "duration_ms": 1512
        }
      ]
    },
    {
      "index": 3,
      "text": "銀と金を私に落としておくれ。」",
      "start_ms": 15550,
      "end_ms": 18734,
      "duration_ms": 3184,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。」",
          "start_ms": 15550,
          "end_ms": 18734,
          "duration_ms": 3184
        }
      ]
    },
    {
      "index": 4,
      "text": "すると、小鳥が金銀のドレスと、銀で刺しゅうされたうわぐつを落としてくれました。",
      "start_ms": 19234,
      "end_ms": 27093,
      "duration_ms": 7859,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 19234,
          "end_ms": 20410,
          "duration_ms": 1176
        },
        {
          "index": 1,
          "text": "小鳥が金銀のドレスと、",
          "start_ms": 20660,
          "end_ms": 23090,
          "duration_ms": 2430
        },
        {
          "index": 2,
          "text": "銀で刺しゅうされたうわぐつを落としてくれました。",
          "start_ms": 23340,
          "end_ms": 27093,
          "duration_ms": 3753
        }
      ]
    },
    {
      "index": 5,
      "text": "娘は急いでドレスを着て、ぶとうかいに行きました。",
      "start_ms": 27593,
      "end_ms": 32830,
      "duration_ms": 5237,
      "clauses": [
        {
          "index": 0,
          "text": "娘は急いでドレスを着て、",
          "start_ms": 27593,
          "end_ms": 30464,
          "duration_ms": 2871
        },
        {
          "index": 1,
          "text": "ぶとうかいに行きました。",
          "start_ms": 30714,
          "end_ms": 32830,
          "duration_ms": 2116
        }
      ]
    },
    {
      "index": 6,
      "text": "二人の姉やままははは、娘が分からず、「外国の王女様に違いない」と思いました。",
      "start_ms": 33330,
      "end_ms": 41966,
      "duration_ms": 8636,
      "clauses": [
        {
          "index": 0,
          "text": "二人の姉やままははは、",
          "start_ms": 33330,
          "end_ms": 35783,
          "duration_ms": 2453
        },
        {
          "index": 1,
          "text": "娘が分からず、",
          "start_ms": 36033,
          "end_ms": 37975,
          "duration_ms": 1942
        },
        {
          "index": 2,
          "text": "「外国の王女様に違いない」と思いました。",
          "start_ms": 38225,
          "end_ms": 41966,
          "duration_ms": 3741
        }
      ]
    },
    {
      "index": 7,
      "text": "金のドレスを着て、とても美しかったからです。",
      "start_ms": 42466,
      "end_ms": 47355,
      "duration_ms": 4889,
      "clauses": [
        {
          "index": 0,
          "text": "金のドレスを着て、",
          "start_ms": 42466,
          "end_ms": 44443,
          "duration_ms": 1977
        },
        {
          "index": 1,
          "text": "とても美しかったからです。",
          "start_ms": 44693,
          "end_ms": 47355,
          "duration_ms": 2662
        }
      ]
    },
    {
      "index": 8,
      "text": "おうじが娘に近づいて、手を取って一緒に踊りました。",
      "start_ms": 47855,
      "end_ms": 53568,
      "duration_ms": 5713,
      "clauses": [
        {
          "index": 0,
          "text": "おうじが娘に近づいて、",
          "start_ms": 47855,
          "end_ms": 50331,
          "duration_ms": 2476
        },
        {
          "index": 1,
          "text": "手を取って一緒に踊りました。",
          "start_ms": 50581,
          "end_ms": 53568,
          "duration_ms": 2987
        }
      ]
    },
    {
      "index": 9,
      "text": "他の娘とは踊ろうとせず、娘の手を放しませんでした。",
      "start_ms": 54068,
      "end_ms": 60060,
      "duration_ms": 5992,
      "clauses": [
        {
          "index": 0,
          "text": "他の娘とは踊ろうとせず、",
          "start_ms": 54068,
          "end_ms": 56962,
          "duration_ms": 2894
        },
        {
          "index": 1,
          "text": "娘の手を放しませんでした。",
          "start_ms": 57212,
          "end_ms": 60060,
          "duration_ms": 2848
        }
      ]
    },
    {
      "index": 10,
      "text": "他の誰かが娘に申し込もうとすると、おうじは「こちらは私の相手です。」",
      "start_ms": 60560,
      "end_ms": 67678,
      "duration_ms": 7118,
      "clauses": [
        {
          "index": 0,
          "text": "他の誰かが娘に申し込もうとすると、",
          "start_ms": 60560,
          "end_ms": 64151,
          "duration_ms": 3591
        },
        {
          "index": 1,
          "text": "おうじは「こちらは私の相手です。」",
          "start_ms": 64401,
          "end_ms": 67678,
          "duration_ms": 3277
        }
      ]
    },
    {
      "index": 11,
      "text": "と言いました。",
      "start_ms": 68178,
      "end_ms": 69748,
      "duration_ms": 1570,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 68178,
          "end_ms": 69748,
          "duration_ms": 1570
        }
      ]
    },
    {
      "index": 12,
      "text": "娘は夕方まで踊りました。",
      "start_ms": 70248,
      "end_ms": 73130,
      "duration_ms": 2882,
      "clauses": [
        {
          "index": 0,
          "text": "娘は夕方まで踊りました。",
          "start_ms": 70248,
          "end_ms": 73130,
          "duration_ms": 2882
        }
      ]
    },
    {
      "index": 13,
      "text": "それから、家に帰ろうと思いました。",
      "start_ms": 73630,
      "end_ms": 77822,
      "duration_ms": 4192,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 73630,
          "end_ms": 75026,
          "duration_ms": 1396
        },
        {
          "index": 1,
          "text": "家に帰ろうと思いました。",
          "start_ms": 75276,
          "end_ms": 77822,
          "duration_ms": 2546
        }
      ]
    },
    {
      "index": 14,
      "text": "でも、おうじは「あなたと一緒に帰りたいです。",
      "start_ms": 78322,
      "end_ms": 83025,
      "duration_ms": 4703,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 78322,
          "end_ms": 79231,
          "duration_ms": 909
        },
        {
          "index": 1,
          "text": "おうじは「あなたと一緒に帰りたいです。",
          "start_ms": 79481,
          "end_ms": 83025,
          "duration_ms": 3544
        }
      ]
    },
    {
      "index": 15,
      "text": "お伴いをさせてください。」",
      "start_ms": 83525,
      "end_ms": 85955,
      "duration_ms": 2430,
      "clauses": [
        {
          "index": 0,
          "text": "お伴いをさせてください。」",
          "start_ms": 83525,
          "end_ms": 85955,
          "duration_ms": 2430
        }
      ]
    },
    {
      "index": 16,
      "text": "と言いました。",
      "start_ms": 86455,
      "end_ms": 88002,
      "duration_ms": 1547,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 86455,
          "end_ms": 88002,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 17,
      "text": "おうじは、このうつくしい娘が誰の娘か知りたかったからです。",
      "start_ms": 88502,
      "end_ms": 94690,
      "duration_ms": 6188,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは、",
          "start_ms": 88502,
          "end_ms": 89654,
          "duration_ms": 1152
        },
        {
          "index": 1,
          "text": "このうつくしい娘が誰の娘か知りたかったからです。",
          "start_ms": 89904,
          "end_ms": 94690,
          "duration_ms": 4786
        }
      ]
    },
    {
      "index": 18,
      "text": "でも、娘はおうじから逃げて、はとごやに飛び込みました。",
      "start_ms": 95190,
      "end_ms": 101643,
      "duration_ms": 6453,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 95190,
          "end_ms": 96052,
          "duration_ms": 862
        },
        {
          "index": 1,
          "text": "娘はおうじから逃げて、",
          "start_ms": 96302,
          "end_ms": 98952,
          "duration_ms": 2650
        },
        {
          "index": 2,
          "text": "はとごやに飛び込みました。",
          "start_ms": 99202,
          "end_ms": 101643,
          "duration_ms": 2441
        }
      ]
    },
    {
      "index": 19,
      "text": "おうじが待っていると、父親が来て、「見知らぬ娘がはとごやに飛び込みました。」",
      "start_ms": 102143,
      "end_ms": 110152,
      "duration_ms": 8009,
      "clauses": [
        {
          "index": 0,
          "text": "おうじが待っていると、",
          "start_ms": 102143,
          "end_ms": 104189,
          "duration_ms": 2046
        },
        {
          "index": 1,
          "text": "父親が来て、",
          "start_ms": 104439,
          "end_ms": 106253,
          "duration_ms": 1814
        },
        {
          "index": 2,
          "text": "「見知らぬ娘がはとごやに飛び込みました。」",
          "start_ms": 106503,
          "end_ms": 110152,
          "duration_ms": 3649
        }
      ]
    },
    {
      "index": 20,
      "text": "と言いました。",
      "start_ms": 110652,
      "end_ms": 112176,
      "duration_ms": 1524,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 110652,
          "end_ms": 112176,
          "duration_ms": 1524
        }
      ]
    },
    {
      "index": 21,
      "text": "父親は「シンデレラかな？」",
      "start_ms": 112676,
      "end_ms": 115106,
      "duration_ms": 2430,
      "clauses": [
        {
          "index": 0,
          "text": "父親は「シンデレラかな？」",
          "start_ms": 112676,
          "end_ms": 115106,
          "duration_ms": 2430
        }
      ]
    },
    {
      "index": 22,
      "text": "と思いました。",
      "start_ms": 115606,
      "end_ms": 117281,
      "duration_ms": 1675,
      "clauses": [
        {
          "index": 0,
          "text": "と思いました。",
          "start_ms": 115606,
          "end_ms": 117281,
          "duration_ms": 1675
        }
      ]
    },
    {
      "index": 23,
      "text": "それで、はとごやを壊すために斧とつるはしを持ってこさせましたが、誰も中にはいませんでした。",
      "start_ms": 117781,
      "end_ms": 126929,
      "duration_ms": 9148,
      "clauses": [
        {
          "index": 0,
          "text": "それで、",
          "start_ms": 117781,
          "end_ms": 118922,
          "duration_ms": 1141
        },
        {
          "index": 1,
          "text": "はとごやを壊すために斧とつるはしを持ってこさせましたが、",
          "start_ms": 119172,
          "end_ms": 123982,
          "duration_ms": 4810
        },
        {
          "index": 2,
          "text": "誰も中にはいませんでした。",
          "start_ms": 124232,
          "end_ms": 126929,
          "duration_ms": 2697
        }
      ]
    },
    {
      "index": 24,
      "text": "みんなが帰ってきたとき、シンデレラは灰の中で汚い服を着て、薄暗いランプが暖炉の上で燃えていました。",
      "start_ms": 127429,
      "end_ms": 137493,
      "duration_ms": 10064,
      "clauses": [
        {
          "index": 0,
          "text": "みんなが帰ってきたとき、",
          "start_ms": 127429,
          "end_ms": 129742,
          "duration_ms": 2313
        },
        {
          "index": 1,
          "text": "シンデレラは灰の中で汚い服を着て、",
          "start_ms": 129992,
          "end_ms": 133455,
          "duration_ms": 3463
        },
        {
          "index": 2,
          "text": "薄暗いランプが暖炉の上で燃えていました。",
          "start_ms": 133705,
          "end_ms": 137493,
          "duration_ms": 3788
        }
      ]
    },
    {
      "index": 25,
      "text": "翌日、ぶとうかいがまた始まりました。",
      "start_ms": 137993,
      "end_ms": 142579,
      "duration_ms": 4586,
      "clauses": [
        {
          "index": 0,
          "text": "翌日、",
          "start_ms": 137993,
          "end_ms": 139447,
          "duration_ms": 1454
        },
        {
          "index": 1,
          "text": "ぶとうかいがまた始まりました。",
          "start_ms": 139697,
          "end_ms": 142579,
          "duration_ms": 2882
        }
      ]
    },
    {
      "index": 26,
      "text": "両親と姉たちが出かけると、シンデレラははしばみの木に行きました。",
      "start_ms": 143079,
      "end_ms": 149663,
      "duration_ms": 6584,
      "clauses": [
        {
          "index": 0,
          "text": "両親と姉たちが出かけると、",
          "start_ms": 143079,
          "end_ms": 146159,
          "duration_ms": 3080
        },
        {
          "index": 1,
          "text": "シンデレラははしばみの木に行きました。",
          "start_ms": 146409,
          "end_ms": 149663,
          "duration_ms": 3254
        }
      ]
    },
    {
      "index": 27,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 150163,
      "end_ms": 154979,
      "duration_ms": 4816,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 150163,
          "end_ms": 151559,
          "duration_ms": 1396
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 151809,
          "end_ms": 153205,
          "duration_ms": 1396
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 153455,
          "end_ms": 154979,
          "duration_ms": 1524
        }
      ]
    },
    {
      "index": 28,
      "text": "銀と金を私に落としておくれ。」",
      "start_ms": 155479,
      "end_ms": 158617,
      "duration_ms": 3138,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。」",
          "start_ms": 155479,
          "end_ms": 158617,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 29,
      "text": "すると、小鳥は前日よりさらにうつくしいドレスを落としてくれました。",
      "start_ms": 159117,
      "end_ms": 165794,
      "duration_ms": 6677,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 159117,
          "end_ms": 160293,
          "duration_ms": 1176
        },
        {
          "index": 1,
          "text": "小鳥は前日よりさらにうつくしいドレスを落としてくれました。",
          "start_ms": 160543,
          "end_ms": 165794,
          "duration_ms": 5251
        }
      ]
    },
    {
      "index": 30,
      "text": "シンデレラがそのドレスを着てぶとうかいに現れると、みんながその美しさに驚きました。",
      "start_ms": 166294,
      "end_ms": 174410,
      "duration_ms": 8116,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラがそのドレスを着てぶとうかいに現れると、",
          "start_ms": 166294,
          "end_ms": 170802,
          "duration_ms": 4508
        },
        {
          "index": 1,
          "text": "みんながその美しさに驚きました。",
          "start_ms": 171052,
          "end_ms": 174410,
          "duration_ms": 3358
        }
      ]
    },
    {
      "index": 31,
      "text": "おうじは娘が来るまで待っていて、すぐに娘の手を取って、娘とだけ踊りました。",
      "start_ms": 174910,
      "end_ms": 183337,
      "duration_ms": 8427,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘が来るまで待っていて、",
          "start_ms": 174910,
          "end_ms": 177874,
          "duration_ms": 2964
        },
        {
          "index": 1,
          "text": "すぐに娘の手を取って、",
          "start_ms": 178124,
          "end_ms": 180588,
          "duration_ms": 2464
        },
        {
          "index": 2,
          "text": "娘とだけ踊りました。",
          "start_ms": 180838,
          "end_ms": 183337,
          "duration_ms": 2499
        }
      ]
    },
    {
      "index": 32,
      "text": "夕方になると、娘は家に帰ろうとしました。",
      "start_ms": 183837,
      "end_ms": 189062,
      "duration_ms": 5225,
      "clauses": [
        {
          "index": 0,
          "text": "夕方になると、",
          "start_ms": 183837,
          "end_ms": 185721,
          "duration_ms": 1884
        },
        {
          "index": 1,
          "text": "娘は家に帰ろうとしました。",
          "start_ms": 185971,
          "end_ms": 189062,
          "duration_ms": 3091
        }
      ]
    },
    {
      "index": 33,
      "text": "おうじは娘のあとをつけて、どの家に行ったか確かめしようとしました。",
      "start_ms": 189562,
      "end_ms": 196018,
      "duration_ms": 6456,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘のあとをつけて、",
          "start_ms": 189562,
          "end_ms": 192282,
          "duration_ms": 2720
        },
        {
          "index": 1,
          "text": "どの家に行ったか確かめしようとしました。",
          "start_ms": 192532,
          "end_ms": 196018,
          "duration_ms": 3486
        }
      ]
    },
    {
      "index": 34,
      "text": "でも、娘は跳んで逃げて、家の後ろの庭に入りました。",
      "start_ms": 196518,
      "end_ms": 202797,
      "duration_ms": 6279,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 196518,
          "end_ms": 197403,
          "duration_ms": 885
        },
        {
          "index": 1,
          "text": "娘は跳んで逃げて、",
          "start_ms": 197653,
          "end_ms": 199827,
          "duration_ms": 2174
        },
        {
          "index": 2,
          "text": "家の後ろの庭に入りました。",
          "start_ms": 200077,
          "end_ms": 202797,
          "duration_ms": 2720
        }
      ]
    },
    {
      "index": 35,
      "text": "庭に梨の実がついているうつくしい高い木がありました。",
      "start_ms": 203297,
      "end_ms": 207619,
      "duration_ms": 4322,
      "clauses": [
        {
          "index": 0,
          "text": "庭に梨の実がついているうつくしい高い木がありました。",
          "start_ms": 203297,
          "end_ms": 207619,
          "duration_ms": 4322
        }
      ]
    },
    {
      "index": 36,
      "text": "娘はリスのようにすばしっこく枝の間によじ登ったので、おうじはどこに消えたのか分かりませんでした。",
      "start_ms": 208119,
      "end_ms": 217419,
      "duration_ms": 9300,
      "clauses": [
        {
          "index": 0,
          "text": "娘はリスのようにすばしっこく枝の間によじ登ったので、",
          "start_ms": 208119,
          "end_ms": 213381,
          "duration_ms": 5262
        },
        {
          "index": 1,
          "text": "おうじはどこに消えたのか分かりませんでした。",
          "start_ms": 213631,
          "end_ms": 217419,
          "duration_ms": 3788
        }
      ]
    },
    {
      "index": 37,
      "text": "三日目、両親と姉たちが出かけると、シンデレラははしばみの木に行きました。",
      "start_ms": 217919,
      "end_ms": 225823,
      "duration_ms": 7904,
      "clauses": [
        {
          "index": 0,
          "text": "三日目、",
          "start_ms": 217919,
          "end_ms": 219071,
          "duration_ms": 1152
        },
        {
          "index": 1,
          "text": "両親と姉たちが出かけると、",
          "start_ms": 219321,
          "end_ms": 222308,
          "duration_ms": 2987
        },
        {
          "index": 2,
          "text": "シンデレラははしばみの木に行きました。",
          "start_ms": 222558,
          "end_ms": 225823,
          "duration_ms": 3265
        }
      ]
    },
    {
      "index": 38,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 226323,
      "end_ms": 231093,
      "duration_ms": 4770,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 226323,
          "end_ms": 227696,
          "duration_ms": 1373
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 227946,
          "end_ms": 229331,
          "duration_ms": 1385
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 229581,
          "end_ms": 231093,
          "duration_ms": 1512
        }
      ]
    },
    {
      "index": 39,
      "text": "銀と金を私に落としておくれ。」",
      "start_ms": 231593,
      "end_ms": 234800,
      "duration_ms": 3207,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。」",
          "start_ms": 231593,
          "end_ms": 234800,
          "duration_ms": 3207
        }
      ]
    },
    {
      "index": 40,
      "text": "今度の小鳥は、これまでのどのドレスよりもすばらしく豪華なドレスを落としてくれました。",
      "start_ms": 235300,
      "end_ms": 243451,
      "duration_ms": 8151,
      "clauses": [
        {
          "index": 0,
          "text": "今度の小鳥は、",
          "start_ms": 235300,
          "end_ms": 237172,
          "duration_ms": 1872
        },
        {
          "index": 1,
          "text": "これまでのどのドレスよりもすばらしく豪華なドレスを落としてくれました。",
          "start_ms": 237422,
          "end_ms": 243451,
          "duration_ms": 6029
        }
      ]
    },
    {
      "index": 41,
      "text": "うわぐつも金でした。",
      "start_ms": 243951,
      "end_ms": 246137,
      "duration_ms": 2186,
      "clauses": [
        {
          "index": 0,
          "text": "うわぐつも金でした。",
          "start_ms": 243951,
          "end_ms": 246137,
          "duration_ms": 2186
        }
      ]
    },
    {
      "index": 42,
      "text": "ぶとうかいに行くと、驚きのあまり誰もどうしていいか分かりませんでした。",
      "start_ms": 246637,
      "end_ms": 253185,
      "duration_ms": 6548,
      "clauses": [
        {
          "index": 0,
          "text": "ぶとうかいに行くと、",
          "start_ms": 246637,
          "end_ms": 248532,
          "duration_ms": 1895
        },
        {
          "index": 1,
          "text": "驚きのあまり誰もどうしていいか分かりませんでした。",
          "start_ms": 248782,
          "end_ms": 253185,
          "duration_ms": 4403
        }
      ]
    },
    {
      "index": 43,
      "text": "おうじは娘とだけ踊りました。",
      "start_ms": 253685,
      "end_ms": 256788,
      "duration_ms": 3103,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘とだけ踊りました。",
          "start_ms": 253685,
          "end_ms": 256788,
          "duration_ms": 3103
        }
      ]
    },
    {
      "index": 44,
      "text": "夕方になると、シンデレラは帰ろうとしました。",
      "start_ms": 257288,
      "end_ms": 262293,
      "duration_ms": 5005,
      "clauses": [
        {
          "index": 0,
          "text": "夕方になると、",
          "start_ms": 257288,
          "end_ms": 259149,
          "duration_ms": 1861
        },
        {
          "index": 1,
          "text": "シンデレラは帰ろうとしました。",
          "start_ms": 259399,
          "end_ms": 262293,
          "duration_ms": 2894
        }
      ]
    },
    {
      "index": 45,
      "text": "おうじは娘と一緒に行きたがりましたが、娘は素早く逃げました。",
      "start_ms": 262793,
      "end_ms": 269400,
      "duration_ms": 6607,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘と一緒に行きたがりましたが、",
          "start_ms": 262793,
          "end_ms": 266302,
          "duration_ms": 3509
        },
        {
          "index": 1,
          "text": "娘は素早く逃げました。",
          "start_ms": 266552,
          "end_ms": 269400,
          "duration_ms": 2848
        }
      ]
    },
    {
      "index": 46,
      "text": "でも、おうじはけいりゃくを練っていて、かいだんにピッチを塗らせておいたのです。",
      "start_ms": 269900,
      "end_ms": 277398,
      "duration_ms": 7498,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 269900,
          "end_ms": 270820,
          "duration_ms": 920
        },
        {
          "index": 1,
          "text": "おうじはけいりゃくを練っていて、",
          "start_ms": 271070,
          "end_ms": 273871,
          "duration_ms": 2801
        },
        {
          "index": 2,
          "text": "かいだんにピッチを塗らせておいたのです。",
          "start_ms": 274121,
          "end_ms": 277398,
          "duration_ms": 3277
        }
      ]
    },
    {
      "index": 47,
      "text": "娘が駆け下りると、左のうわぐつがくっついて離れませんでした。",
      "start_ms": 277898,
      "end_ms": 284099,
      "duration_ms": 6201,
      "clauses": [
        {
          "index": 0,
          "text": "娘が駆け下りると、",
          "start_ms": 277898,
          "end_ms": 280142,
          "duration_ms": 2244
        },
        {
          "index": 1,
          "text": "左のうわぐつがくっついて離れませんでした。",
          "start_ms": 280392,
          "end_ms": 284099,
          "duration_ms": 3707
        }
      ]
    }
  ]
}