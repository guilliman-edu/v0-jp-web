          "start_ms": 155041,
          "end_ms": 158272,
          "duration_ms": 3231
        }
      ]
    },
    {
      "index": 29,
      "text": "」 すると、小鳥は前日よりさらにうつくしいドレスを落としてくれました。",
      "start_ms": 158772,
      "end_ms": 165390,
      "duration_ms": 6618,
      "clauses": [
