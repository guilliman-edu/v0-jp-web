          "duration_ms": 2151
        },
        {
          "index": 2,
          "text": "家の後ろの庭に入りました。",
          "start_ms": 199558,
          "end_ms": 202266,
          "duration_ms": 2708
        }
      ]
    },
    {
      "index": 35,
      "text": "庭に梨の実がついているうつくしい高い木がありました。",
      "start_ms": 202766,
      "end_ms": 207123,
      "duration_ms": 4357,
      "clauses": [
        {
          "index": 0,
          "text": "庭に梨の実がついているうつくしい高い木がありました。",
          "start_ms": 202766,
          "end_ms": 207123,
          "duration_ms": 4357
        }
      ]
    },
    {
      "index": 36,
      "text": "娘はリスのようにすばしっこく枝の間によじ登ったので、おうじはどこに消えたのか分かりませんでした。",
      "start_ms": 207623,
      "end_ms": 216796,
      "duration_ms": 9173,
      "clauses": [
        {
          "index": 0,
          "text": "娘はリスのようにすばしっこく枝の間によじ登ったので、",
          "start_ms": 207623,
          "end_ms": 212793,
          "duration_ms": 5170
        },
        {
          "index": 1,
          "text": "おうじはどこに消えたのか分かりませんでした。",
          "start_ms": 213043,
          "end_ms": 216796,
          "duration_ms": 3753
        }
      ]
    },
    {
      "index": 37,
      "text": "三日目、両親と姉たちが出かけると、シンデレラははしばみの木に行きました。",
      "start_ms": 217296,
      "end_ms": 225224,
      "duration_ms": 7928,
      "clauses": [
        {
          "index": 0,
          "text": "三日目、",
          "start_ms": 217296,
          "end_ms": 218472,
          "duration_ms": 1176
        },
        {
          "index": 1,
          "text": "両親と姉たちが出かけると、",
          "start_ms": 218722,
          "end_ms": 221767,
          "duration_ms": 3045
        },
        {
          "index": 2,
          "text": "シンデレラははしばみの木に行きました。",
          "start_ms": 222017,
          "end_ms": 225224,
          "duration_ms": 3207
        }
      ]
    },
    {
      "index": 38,
      "text": "「ゆすって、ゆすって、若木さん。",
      "start_ms": 225724,
      "end_ms": 230401,
      "duration_ms": 4677,
      "clauses": [
        {
          "index": 0,
          "text": "「ゆすって、",
          "start_ms": 225724,
          "end_ms": 227132,
          "duration_ms": 1408
        },
        {
          "index": 1,
          "text": "ゆすって、",
          "start_ms": 227382,
          "end_ms": 228743,
          "duration_ms": 1361
        },
        {
          "index": 2,
          "text": "若木さん。",
          "start_ms": 228993,
          "end_ms": 230401,
          "duration_ms": 1408
        }
      ]
    },
    {
      "index": 39,
      "text": "銀と金を私に落としておくれ。",
      "start_ms": 230901,
      "end_ms": 234050,
      "duration_ms": 3149,
      "clauses": [
        {
          "index": 0,
          "text": "銀と金を私に落としておくれ。",
          "start_ms": 230901,
          "end_ms": 234050,
          "duration_ms": 3149
        }
      ]
    },
    {
      "index": 40,
      "text": "」 今度の小鳥は、これまでのどのドレスよりもすばらしく豪華なドレスを落としてくれました。",
      "start_ms": 234550,
      "end_ms": 242376,
      "duration_ms": 7826,
      "clauses": [
        {
          "index": 0,
          "text": "」 今度の小鳥は、",
          "start_ms": 234550,
          "end_ms": 236341,
          "duration_ms": 1791
        },
        {
          "index": 1,
          "text": "これまでのどのドレスよりもすばらしく豪華なドレスを落としてくれました。",
          "start_ms": 236591,
          "end_ms": 242376,
          "duration_ms": 5785
        }
      ]
    },
    {
      "index": 41,
      "text": "うわぐつも金でした。",
      "start_ms": 242876,
      "end_ms": 244992,
      "duration_ms": 2116,
      "clauses": [
        {
          "index": 0,
          "text": "うわぐつも金でした。",
          "start_ms": 242876,
          "end_ms": 244992,
          "duration_ms": 2116
        }
      ]
    },
    {
      "index": 42,
      "text": "ぶとうかいに行くと、驚きのあまり誰もどうしていいか分かりませんでした。",
      "start_ms": 245492,
      "end_ms": 252087,
      "duration_ms": 6595,
      "clauses": [
        {
          "index": 0,
          "text": "ぶとうかいに行くと、",
          "start_ms": 245492,
          "end_ms": 247387,
          "duration_ms": 1895
        },
        {
          "index": 1,
          "text": "驚きのあまり誰もどうしていいか分かりませんでした。",
          "start_ms": 247637,
          "end_ms": 252087,
          "duration_ms": 4450
        }
      ]
    },
    {
      "index": 43,
      "text": "おうじは娘とだけ踊りました。",
      "start_ms": 252587,
      "end_ms": 255690,
      "duration_ms": 3103,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘とだけ踊りました。",
          "start_ms": 252587,
          "end_ms": 255690,
          "duration_ms": 3103
        }
      ]
    },
    {
      "index": 44,
      "text": "夕方になると、シンデレラは帰ろうとしました。",
      "start_ms": 256190,
      "end_ms": 261183,
      "duration_ms": 4993,
      "clauses": [
        {
          "index": 0,
          "text": "夕方になると、",
          "start_ms": 256190,
          "end_ms": 258051,
          "duration_ms": 1861
        },
        {
          "index": 1,
          "text": "シンデレラは帰ろうとしました。",
          "start_ms": 258301,
          "end_ms": 261183,
          "duration_ms": 2882
        }
      ]
    },
    {
      "index": 45,
      "text": "おうじは娘と一緒に行きたがりましたが、娘は素早く逃げました。",
      "start_ms": 261683,
      "end_ms": 268267,
      "duration_ms": 6584,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは娘と一緒に行きたがりましたが、",
          "start_ms": 261683,
          "end_ms": 265146,
          "duration_ms": 3463
        },
        {
          "index": 1,
          "text": "娘は素早く逃げました。",
          "start_ms": 265396,
          "end_ms": 268267,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 46,
      "text": "でも、おうじはけいりゃくを練っていて、かいだんにピッチを塗らせておいたのです。",
      "start_ms": 268767,
      "end_ms": 276022,
      "duration_ms": 7255,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 268767,
          "end_ms": 269664,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "おうじはけいりゃくを練っていて、",
          "start_ms": 269914,
          "end_ms": 272634,
          "duration_ms": 2720
        },
        {
          "index": 2,
          "text": "かいだんにピッチを塗らせておいたのです。",
          "start_ms": 272884,
          "end_ms": 276022,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 47,
      "text": "娘が駆け下りると、左のうわぐつがくっついて離れませんでした。",
      "start_ms": 276522,
      "end_ms": 282700,
      "duration_ms": 6178,
      "clauses": [
        {
          "index": 0,
          "text": "娘が駆け下りると、",
          "start_ms": 276522,
          "end_ms": 278685,
          "duration_ms": 2163
        },
        {
          "index": 1,
          "text": "左のうわぐつがくっついて離れませんでした。",
          "start_ms": 278935,
          "end_ms": 282700,
          "duration_ms": 3765
        }
      ]
    }
  ]
}