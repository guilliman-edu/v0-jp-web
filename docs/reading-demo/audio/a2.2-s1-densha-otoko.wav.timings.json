      "end_ms": 23749,
      "duration_ms": 3016,
      "clauses": [
        {
          "index": 0,
          "text": "テレビでもみることができました。",
          "start_ms": 20733,
          "end_ms": 23749,
          "duration_ms": 3016
        }
      ]
    },
    {
