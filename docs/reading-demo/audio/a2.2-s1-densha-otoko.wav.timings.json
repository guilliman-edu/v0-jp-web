      "text": "そして、せかいじゅうでゆうめいになりました。",
      "start_ms": 27068,
      "end_ms": 31979,
      "duration_ms": 4911,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 27068,
          "end_ms": 28423,
          "duration_ms": 1355
        },
        {
          "index": 1,
