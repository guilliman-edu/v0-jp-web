          "end_ms": 85836,
          "duration_ms": 1216
        },
        {
          "index": 2,
          "text": "エルメスのとてもたかいおちゃのコップをかれにあげました。",
          "start_ms": 86086,
          "end_ms": 90994,
          "duration_ms": 4908
        }
      ]
    },
    {
      "index": 18,
      "text": "おんなのこのなまえはエルメスです。",
      "start_ms": 91494,
      "end_ms": 95044,
      "duration_ms": 3550,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこのなまえはエルメスです。",
          "start_ms": 91494,
          "end_ms": 95044,
          "duration_ms": 3550
        }
      ]
    },
    {
      "index": 19,
      "text": "男の人はどうしようかと思いました。",
      "start_ms": 95544,
      "end_ms": 99558,
      "duration_ms": 4014,
      "clauses": [
        {
          "index": 0,
          "text": "男の人はどうしようかと思いました。",
          "start_ms": 95544,
          "end_ms": 99558,
          "duration_ms": 4014
        }
      ]
    },
    {
      "index": 20,
      "text": "そこで、かれはなやみをインターネットのばしょに書きました。",
      "start_ms": 100058,
      "end_ms": 105782,
      "duration_ms": 5724,
      "clauses": [
        {
          "index": 0,
          "text": "そこで、",
          "start_ms": 100058,
          "end_ms": 101274,
          "duration_ms": 1216
        },
        {
          "index": 1,
          "text": "かれはなやみをインターネットのばしょに書きました。",
          "start_ms": 101524,
          "end_ms": 105782,
          "duration_ms": 4258
        }
      ]
    },
    {
      "index": 21,
      "text": "すると、かおもなまえも知らない人が、かれを応援しました。",
