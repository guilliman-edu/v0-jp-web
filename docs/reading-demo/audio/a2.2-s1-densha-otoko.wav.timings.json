      "start_ms": 20838,
      "end_ms": 23865,
      "duration_ms": 3027,
      "clauses": [
        {
          "index": 0,
          "text": "テレビでもみることができました。",
          "start_ms": 20838,
          "end_ms": 23865,
          "duration_ms": 3027
        }
      ]
    },
    {
      "index": 5,
      "text": "えいがにもなりました。",
      "start_ms": 24365,
      "end_ms": 26626,
      "duration_ms": 2261,
      "clauses": [
