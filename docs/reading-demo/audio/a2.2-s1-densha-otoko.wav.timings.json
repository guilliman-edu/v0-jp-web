      "text": "そして、せかいなかでゆうめいになりました。",
      "start_ms": 27126,
      "end_ms": 31794,
      "duration_ms": 4668,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 27126,
          "end_ms": 28470,
          "duration_ms": 1344
        },
        {
          "index": 1,
