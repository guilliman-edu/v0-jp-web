          "start_ms": 123661,
          "end_ms": 127025,
          "duration_ms": 3364
        }
      ]
    },
    {
      "index": 25,
      "text": "ともだちがしんせつなことばを言ったから、男の人は自信をもつようになりました。",
      "start_ms": 127525,
      "end_ms": 135350,
      "duration_ms": 7825,
      "clauses": [
        {
          "index": 0,
          "text": "ともだちがしんせつなことばを言ったから、",
          "start_ms": 127525,
          "end_ms": 131063,
          "duration_ms": 3538
        },
        {
          "index": 1,
          "text": "男の人は自信をもつようになりました。",
          "start_ms": 131313,
          "end_ms": 135350,
          "duration_ms": 4037
        }
      ]
    },
    {
      "index": 26,
      "text": "おんなのことあうときは、いつも緊張していました。",
      "start_ms": 135850,
      "end_ms": 141296,
      "duration_ms": 5446,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのことあうときは、",
          "start_ms": 135850,
          "end_ms": 138332,
          "duration_ms": 2482
        },
