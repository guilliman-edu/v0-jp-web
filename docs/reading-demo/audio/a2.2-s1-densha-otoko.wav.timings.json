          "start_ms": 28720,
          "end_ms": 31794,
          "duration_ms": 3074
        }
      ]
    },
    {
      "index": 7,
      "text": "男の人は22歳で、オタクです。",
      "start_ms": 32294,
      "end_ms": 37263,
      "duration_ms": 4969,
      "clauses": [
        {
          "index": 0,
          "text": "男の人は22歳で、",
          "start_ms": 32294,
          "end_ms": 35356,
          "duration_ms": 3062
        },
        {
          "index": 1,
          "text": "オタクです。",
          "start_ms": 35606,
          "end_ms": 37263,
          "duration_ms": 1657
        }
      ]
    },
    {
      "index": 8,
      "text": "とてもしんせつな人です。",
      "start_ms": 37763,
      "end_ms": 40442,
      "duration_ms": 2679,
      "clauses": [
        {
          "index": 0,
          "text": "とてもしんせつな人です。",
          "start_ms": 37763,
          "end_ms": 40442,
          "duration_ms": 2679
        }
      ]
    },
    {
      "index": 9,
      "text": "かれのしゅみはアニメとまんがとゲームでした。",
      "start_ms": 40942,
      "end_ms": 44944,
      "duration_ms": 4002,
      "clauses": [
        {
          "index": 0,
          "text": "かれのしゅみはアニメとまんがとゲームでした。",
          "start_ms": 40942,
          "end_ms": 44944,
          "duration_ms": 4002
        }
      ]
    },
    {
      "index": 10,
      "text": "おんなのこと付き合ったことがありませんでした。",
      "start_ms": 45444,
      "end_ms": 49168,
      "duration_ms": 3724,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこと付き合ったことがありませんでした。",
          "start_ms": 45444,
          "end_ms": 49168,
          "duration_ms": 3724
        }
      ]
    },
    {
      "index": 11,
      "text": "あるひ / にち、かれはでんしゃのなかにいました。",
      "start_ms": 49668,
      "end_ms": 54684,
      "duration_ms": 5016,
      "clauses": [
        {
          "index": 0,
          "text": "あるひ / にち、",
          "start_ms": 49668,
          "end_ms": 51395,
          "duration_ms": 1727
        },
        {
          "index": 1,
          "text": "かれはでんしゃのなかにいました。",
          "start_ms": 51645,
          "end_ms": 54684,
          "duration_ms": 3039
        }
      ]
    },
    {
      "index": 12,
      "text": "そのとき、おさけを飲んだ男の人が、わかいおんなのこにわるいことをしていました。",
      "start_ms": 55184,
      "end_ms": 63848,
      "duration_ms": 8664,
      "clauses": [
        {
          "index": 0,
          "text": "そのとき、",
          "start_ms": 55184,
          "end_ms": 56806,
          "duration_ms": 1622
        },
        {
          "index": 1,
          "text": "おさけを飲んだ男の人が、",
          "start_ms": 57056,
          "end_ms": 59897,
          "duration_ms": 2841
        },
        {
          "index": 2,
          "text": "わかいおんなのこにわるいことをしていました。",
          "start_ms": 60147,
          "end_ms": 63848,
          "duration_ms": 3701
        }
      ]
    },
    {
      "index": 13,
      "text": "おんなのこはとても困っていました。",
      "start_ms": 64348,
      "end_ms": 67805,
      "duration_ms": 3457,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこはとても困っていました。",
          "start_ms": 64348,
          "end_ms": 67805,
          "duration_ms": 3457
        }
      ]
    },
    {
      "index": 14,
      "text": "かれはちょっと怖かったですが、立って、おんなのこのまえに行きました。",
      "start_ms": 68305,
      "end_ms": 75808,
      "duration_ms": 7503,
      "clauses": [
        {
          "index": 0,
          "text": "かれはちょっと怖かったですが、",
          "start_ms": 68305,
          "end_ms": 71309,
          "duration_ms": 3004
        },
        {
          "index": 1,
          "text": "立って、",
          "start_ms": 71559,
          "end_ms": 72775,
          "duration_ms": 1216
        },
        {
          "index": 2,
          "text": "おんなのこのまえに行きました。",
          "start_ms": 73025,
          "end_ms": 75808,
          "duration_ms": 2783
        }
      ]
    },
    {
      "index": 15,
      "text": "おんなのこを助けました。",
      "start_ms": 76308,
      "end_ms": 78848,
      "duration_ms": 2540,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこを助けました。",
          "start_ms": 76308,
          "end_ms": 78848,
          "duration_ms": 2540
        }
      ]
    },
    {
      "index": 16,
      "text": "おんなのこはとてもおれいを言いました。",
      "start_ms": 79348,
      "end_ms": 82700,
      "duration_ms": 3352,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこはとてもおれいを言いました。",
          "start_ms": 79348,
          "end_ms": 82700,
          "duration_ms": 3352
        }
      ]
    },
    {
      "index": 17,
      "text": "あとで、おれいに、エルメスのとてもたかいおちゃのコップをかれにあげました。",
      "start_ms": 83200,
      "end_ms": 90994,
      "duration_ms": 7794,
      "clauses": [
        {
          "index": 0,
          "text": "あとで、",
          "start_ms": 83200,
          "end_ms": 84370,
          "duration_ms": 1170
        },
        {
          "index": 1,
          "text": "おれいに、",
