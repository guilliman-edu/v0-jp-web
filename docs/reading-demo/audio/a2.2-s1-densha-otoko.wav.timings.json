          "duration_ms": 1866
        },
        {
          "index": 2,
          "text": "よくおんなのこに会いました。",
          "start_ms": 145103,
          "end_ms": 147794,
          "duration_ms": 2691
        }
      ]
    },
    {
      "index": 28,
      "text": "おんなのこはかれがまじめでしんせつだとわかりました。",
