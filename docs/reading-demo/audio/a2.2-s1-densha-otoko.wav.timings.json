          "end_ms": 86357,
          "duration_ms": 1204
        },
        {
          "index": 2,
          "text": "エルメスのとてもたかいおちゃのコップをかれにあげました。",
          "start_ms": 86607,
          "end_ms": 91538,
          "duration_ms": 4931
        }
      ]
    },
    {
      "index": 18,
      "text": "おんなのこのなまえはエルメスです。",
      "start_ms": 92038,
      "end_ms": 95541,
      "duration_ms": 3503,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこのなまえはエルメスです。",
          "start_ms": 92038,
          "end_ms": 95541,
          "duration_ms": 3503
        }
      ]
    },
    {
      "index": 19,
      "text": "男の人はどうしようかと思いました。",
      "start_ms": 96041,
      "end_ms": 100032,
      "duration_ms": 3991,
      "clauses": [
        {
          "index": 0,
          "text": "男の人はどうしようかと思いました。",
          "start_ms": 96041,
          "end_ms": 100032,
          "duration_ms": 3991
        }
      ]
    },
    {
      "index": 20,
      "text": "そこで、かれはなやみをインターネットのばしょに書きました。",
      "start_ms": 100532,
      "end_ms": 106128,
      "duration_ms": 5596,
      "clauses": [
        {
          "index": 0,
          "text": "そこで、",
          "start_ms": 100532,
          "end_ms": 101713,
          "duration_ms": 1181
        },
        {
          "index": 1,
          "text": "かれはなやみをインターネットのばしょに書きました。",
          "start_ms": 101963,
          "end_ms": 106128,
          "duration_ms": 4165
        }
      ]
    },
    {
      "index": 21,
      "text": "すると、かおもなまえも知らない人が、かれを応援しました。",
      "start_ms": 106628,
      "end_ms": 113492,
      "duration_ms": 6864,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 106628,
          "end_ms": 107902,
          "duration_ms": 1274
        },
        {
          "index": 1,
          "text": "かおもなまえも知らない人が、",
          "start_ms": 108152,
          "end_ms": 110877,
          "duration_ms": 2725
        },
        {
          "index": 2,
          "text": "かれを応援しました。",
          "start_ms": 111127,
          "end_ms": 113492,
          "duration_ms": 2365
        }
      ]
    },
    {
      "index": 22,
      "text": "みんなで「かみを切ってください」と言いました。",
      "start_ms": 113992,
      "end_ms": 117727,
      "duration_ms": 3735,
      "clauses": [
        {
          "index": 0,
          "text": "みんなで「かみを切ってください」と言いました。",
          "start_ms": 113992,
          "end_ms": 117727,
          "duration_ms": 3735
        }
      ]
    },
    {
      "index": 23,
      "text": "「ふくを買いに行ってください」とも言いました。",
      "start_ms": 118227,
      "end_ms": 121579,
      "duration_ms": 3352,
      "clauses": [
        {
          "index": 0,
          "text": "「ふくを買いに行ってください」とも言いました。",
          "start_ms": 118227,
          "end_ms": 121579,
          "duration_ms": 3352
        }
      ]
    },
    {
      "index": 24,
      "text": "そして、ふたりでいるときのことも教えました。",
      "start_ms": 122079,
      "end_ms": 127025,
      "duration_ms": 4946,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 122079,
          "end_ms": 123411,
          "duration_ms": 1332
        },
        {
