      "end_ms": 153199,
      "duration_ms": 4804,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこはかれがまじめでしんせつだとわかりました。",
          "start_ms": 148395,
          "end_ms": 153199,
          "duration_ms": 4804
        }
      ]
    },
    {
      "index": 29,
      "text": "そして、おんなのこもかれのことが好きになりました。",
      "start_ms": 153699,
      "end_ms": 159318,
      "duration_ms": 5619,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 153699,
          "end_ms": 155089,
          "duration_ms": 1390
        },
        {
          "index": 1,
          "text": "おんなのこもかれのことが好きになりました。",
          "start_ms": 155339,
          "end_ms": 159318,
          "duration_ms": 3979
        }
      ]
    },
    {
      "index": 30,
      "text": "ともだちもしんぱいして、ふたりのことをまいにち見ていました。",
