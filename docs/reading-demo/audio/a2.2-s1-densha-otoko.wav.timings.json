          "end_ms": 162207,
          "duration_ms": 2389
        },
        {
          "index": 1,
          "text": "ふたりのことをまいにち見ていました。",
          "start_ms": 162457,
          "end_ms": 166018,
          "duration_ms": 3561
        }
      ]
    },
    {
      "index": 31,
      "text": "男の人はおんなのこに「あなたのことが好きです」と言いました。",
      "start_ms": 166518,
      "end_ms": 172041,
      "duration_ms": 5523,
      "clauses": [
        {
          "index": 0,
          "text": "男の人はおんなのこに「あなたのことが好きです」と言いました。",
          "start_ms": 166518,
          "end_ms": 172041,
          "duration_ms": 5523
        }
      ]
    },
    {
      "index": 32,
      "text": "おんなのこは笑って、うれしそうでした。",
      "start_ms": 172541,
      "end_ms": 176988,
      "duration_ms": 4447,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこは笑って、",
          "start_ms": 172541,
          "end_ms": 174779,
          "duration_ms": 2238
