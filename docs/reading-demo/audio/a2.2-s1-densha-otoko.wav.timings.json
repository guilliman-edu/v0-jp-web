      "end_ms": 171985,
      "duration_ms": 5558,
      "clauses": [
        {
          "index": 0,
          "text": "男の人はおんなのこに「あなたのことが好きです」と言いました。",
          "start_ms": 166427,
          "end_ms": 171985,
          "duration_ms": 5558
        }
      ]
    },
    {
      "index": 32,
      "text": "おんなのこは笑って、うれしそうでした。",
      "start_ms": 172485,
      "end_ms": 176920,
      "duration_ms": 4435,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこは笑って、",
