          "end_ms": 126890,
          "duration_ms": 3352
        }
      ]
    },
    {
      "index": 25,
      "text": "ともだちがしんせつなことばを言ったから、男の人は自信をもつようになりました。",
      "start_ms": 127390,
      "end_ms": 135273,
      "duration_ms": 7883,
      "clauses": [
        {
          "index": 0,
          "text": "ともだちがしんせつなことばを言ったから、",
          "start_ms": 127390,
          "end_ms": 130870,
          "duration_ms": 3480
        },
        {
          "index": 1,
          "text": "男の人は自信をもつようになりました。",
          "start_ms": 131120,
          "end_ms": 135273,
          "duration_ms": 4153
        }
      ]
    },
    {
      "index": 26,
      "text": "おんなのことあうときは、いつも緊張していました。",
      "start_ms": 135773,
      "end_ms": 141242,
      "duration_ms": 5469,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのことあうときは、",
