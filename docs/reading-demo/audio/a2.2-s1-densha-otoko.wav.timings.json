      "end_ms": 185831,
      "duration_ms": 4769,
      "clauses": [
        {
          "index": 0,
          "text": "男の人は今までしゅみのことをしていました。",
          "start_ms": 181062,
          "end_ms": 185831,
          "duration_ms": 4769
        }
      ]
    },
