      "duration_ms": 6842,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 106282,
          "end_ms": 107579,
          "duration_ms": 1297
        },
        {
          "index": 1,
          "text": "かおもなまえも知らない人が、",
          "start_ms": 107829,
          "end_ms": 110578,
          "duration_ms": 2749
        },
        {
          "index": 2,
          "text": "かれを応援しました。",
          "start_ms": 110828,
          "end_ms": 113124,
          "duration_ms": 2296
        }
      ]
    },
    {
      "index": 22,
      "text": "みんなで「かみを切ってください」と言いました。",
      "start_ms": 113624,
      "end_ms": 117441,
      "duration_ms": 3817,
      "clauses": [
        {
          "index": 0,
          "text": "みんなで「かみを切ってください」と言いました。",
          "start_ms": 113624,
          "end_ms": 117441,
          "duration_ms": 3817
        }
      ]
    },
    {
      "index": 23,
      "text": "「ふくを買いに行ってください」とも言いました。",
      "start_ms": 117941,
      "end_ms": 121421,
      "duration_ms": 3480,
      "clauses": [
        {
          "index": 0,
          "text": "「ふくを買いに行ってください」とも言いました。",
          "start_ms": 117941,
          "end_ms": 121421,
          "duration_ms": 3480
        }
      ]
    },
    {
      "index": 24,
      "text": "そして、ふたりでいるときのことも教えました。",
      "start_ms": 121921,
      "end_ms": 126890,
      "duration_ms": 4969,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 121921,
