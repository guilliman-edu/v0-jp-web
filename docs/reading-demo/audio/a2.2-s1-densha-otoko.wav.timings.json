          "start_ms": 28673,
          "end_ms": 31979,
          "duration_ms": 3306
        }
      ]
    },
    {
      "index": 7,
      "text": "男の人は22歳で、オタクです。",
      "start_ms": 32479,
      "end_ms": 37530,
      "duration_ms": 5051,
      "clauses": [
        {
          "index": 0,
          "text": "男の人は22歳で、",
          "start_ms": 32479,
          "end_ms": 35611,
          "duration_ms": 3132
        },
        {
          "index": 1,
          "text": "オタクです。",
          "start_ms": 35861,
          "end_ms": 37530,
          "duration_ms": 1669
        }
      ]
    },
    {
      "index": 8,
      "text": "とてもしんせつな人です。",
      "start_ms": 38030,
      "end_ms": 40674,
      "duration_ms": 2644,
      "clauses": [
        {
          "index": 0,
          "text": "とてもしんせつな人です。",
          "start_ms": 38030,
          "end_ms": 40674,
          "duration_ms": 2644
        }
      ]
    },
    {
      "index": 9,
      "text": "かれのしゅみはアニメとまんがとゲームでした。",
      "start_ms": 41174,
      "end_ms": 45258,
      "duration_ms": 4084,
      "clauses": [
        {
          "index": 0,
          "text": "かれのしゅみはアニメとまんがとゲームでした。",
          "start_ms": 41174,
          "end_ms": 45258,
          "duration_ms": 4084
        }
      ]
    },
    {
      "index": 10,
      "text": "おんなのこと付き合ったことがありませんでした。",
      "start_ms": 45758,
      "end_ms": 49563,
      "duration_ms": 3805,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこと付き合ったことがありませんでした。",
          "start_ms": 45758,
          "end_ms": 49563,
          "duration_ms": 3805
        }
      ]
    },
    {
      "index": 11,
      "text": "あるひ / にち、かれはでんしゃのなかにいました。",
      "start_ms": 50063,
      "end_ms": 55009,
      "duration_ms": 4946,
      "clauses": [
        {
          "index": 0,
          "text": "あるひ / にち、",
          "start_ms": 50063,
          "end_ms": 51755,
          "duration_ms": 1692
        },
        {
          "index": 1,
          "text": "かれはでんしゃのなかにいました。",
          "start_ms": 52005,
          "end_ms": 55009,
          "duration_ms": 3004
        }
      ]
    },
    {
      "index": 12,
      "text": "そのとき、おさけを飲んだ男の人が、わかいおんなのこにわるいことをしていました。",
      "start_ms": 55509,
      "end_ms": 64184,
      "duration_ms": 8675,
      "clauses": [
        {
          "index": 0,
          "text": "そのとき、",
          "start_ms": 55509,
          "end_ms": 57166,
          "duration_ms": 1657
        },
        {
          "index": 1,
          "text": "おさけを飲んだ男の人が、",
          "start_ms": 57416,
          "end_ms": 60257,
          "duration_ms": 2841
        },
        {
          "index": 2,
          "text": "わかいおんなのこにわるいことをしていました。",
          "start_ms": 60507,
          "end_ms": 64184,
          "duration_ms": 3677
        }
      ]
    },
    {
      "index": 13,
      "text": "おんなのこはとても困っていました。",
      "start_ms": 64684,
      "end_ms": 68187,
      "duration_ms": 3503,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこはとても困っていました。",
          "start_ms": 64684,
          "end_ms": 68187,
          "duration_ms": 3503
        }
      ]
    },
    {
      "index": 14,
      "text": "かれはちょっと怖かったですが、立って、おんなのこのまえに行きました。",
      "start_ms": 68687,
      "end_ms": 76307,
      "duration_ms": 7620,
      "clauses": [
        {
          "index": 0,
          "text": "かれはちょっと怖かったですが、",
          "start_ms": 68687,
          "end_ms": 71714,
          "duration_ms": 3027
        },
        {
          "index": 1,
          "text": "立って、",
          "start_ms": 71964,
          "end_ms": 73250,
          "duration_ms": 1286
        },
        {
          "index": 2,
          "text": "おんなのこのまえに行きました。",
          "start_ms": 73500,
          "end_ms": 76307,
          "duration_ms": 2807
        }
      ]
    },
    {
      "index": 15,
      "text": "おんなのこを助けました。",
      "start_ms": 76807,
      "end_ms": 79358,
      "duration_ms": 2551,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこを助けました。",
          "start_ms": 76807,
          "end_ms": 79358,
          "duration_ms": 2551
        }
      ]
    },
    {
      "index": 16,
      "text": "おんなのこはとてもおれいを言いました。",
      "start_ms": 79858,
      "end_ms": 83245,
      "duration_ms": 3387,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこはとてもおれいを言いました。",
          "start_ms": 79858,
          "end_ms": 83245,
          "duration_ms": 3387
        }
      ]
    },
    {
      "index": 17,
      "text": "あとで、おれいに、エルメスのとてもたかいおちゃのコップをかれにあげました。",
      "start_ms": 83745,
      "end_ms": 91538,
      "duration_ms": 7793,
      "clauses": [
        {
          "index": 0,
          "text": "あとで、",
          "start_ms": 83745,
          "end_ms": 84903,
          "duration_ms": 1158
        },
        {
          "index": 1,
          "text": "おれいに、",
