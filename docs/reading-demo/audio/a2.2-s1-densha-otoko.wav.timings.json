      "end_ms": 153039,
      "duration_ms": 4745,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのこはかれがまじめでしんせつだとわかりました。",
          "start_ms": 148294,
          "end_ms": 153039,
          "duration_ms": 4745
        }
      ]
    },
    {
      "index": 29,
      "text": "そして、おんなのこもかれのことが好きになりました。",
      "start_ms": 153539,
      "end_ms": 159216,
      "duration_ms": 5677,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 153539,
          "end_ms": 154929,
          "duration_ms": 1390
        },
        {
          "index": 1,
