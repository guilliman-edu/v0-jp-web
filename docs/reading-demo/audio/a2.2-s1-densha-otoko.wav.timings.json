          "end_ms": 144931,
          "duration_ms": 1901
        },
        {
          "index": 2,
          "text": "よくおんなのこに会いました。",
          "start_ms": 145181,
          "end_ms": 147895,
          "duration_ms": 2714
        }
      ]
    },
    {
      "index": 28,
      "text": "おんなのこはかれがまじめでしんせつだとわかりました。",
