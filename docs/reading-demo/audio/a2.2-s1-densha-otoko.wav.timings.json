          "end_ms": 162174,
          "duration_ms": 2458
        },
        {
          "index": 1,
          "text": "ふたりのことをまいにち見ていました。",
          "start_ms": 162424,
          "end_ms": 165927,
          "duration_ms": 3503
        }
      ]
    },
    {
      "index": 31,
      "text": "男の人はおんなのこに「あなたのことが好きです」と言いました。",
