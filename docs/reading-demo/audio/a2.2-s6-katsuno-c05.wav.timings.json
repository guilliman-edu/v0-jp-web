          "index": 0,
          "text": "おおくのおきゃくがきて、",
          "start_ms": 175637,
          "end_ms": 177898,
          "duration_ms": 2261
        },
        {
          "index": 1,
          "text": "いますね」。",
          "start_ms": 178148,
          "end_ms": 179538,
          "duration_ms": 1390
        }
      ]
    },
    {
      "index": 48,
      "text": "おくさんはこたえました。",
      "start_ms": 180038,
      "end_ms": 182520,
      "duration_ms": 2482,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはこたえました。",
          "start_ms": 180038,
          "end_ms": 182520,
          "duration_ms": 2482
        }
      ]
    },
    {
      "index": 49,
      "text": "「あした、ゆみのたいかいがあります。",
      "start_ms": 183020,
      "end_ms": 186956,
      "duration_ms": 3936,
      "clauses": [
        {
          "index": 0,
          "text": "「あした、",
          "start_ms": 183020,
          "end_ms": 184224,
          "duration_ms": 1204
        },
        {
          "index": 1,
          "text": "ゆみのたいかいがあります。",
          "start_ms": 184474,
          "end_ms": 186956,
          "duration_ms": 2482
        }
      ]
    },
    {
      "index": 50,
      "text": "さむらいがおおく、きます。",
      "start_ms": 187456,
      "end_ms": 191171,
      "duration_ms": 3715,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいがおおく、",
          "start_ms": 187456,
          "end_ms": 189496,
          "duration_ms": 2040
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 189746,
          "end_ms": 191171,
          "duration_ms": 1425
        }
      ]
    },
    {
      "index": 51,
      "text": "みな、ゆみをじょうずにつかいます。",
      "start_ms": 191671,
      "end_ms": 195677,
      "duration_ms": 4006,
      "clauses": [
        {
          "index": 0,
          "text": "みな、",
          "start_ms": 191671,
          "end_ms": 192713,
          "duration_ms": 1042
        },
        {
          "index": 1,
          "text": "ゆみをじょうずにつかいます。",
          "start_ms": 192963,
          "end_ms": 195677,
          "duration_ms": 2714
        }
      ]
    },
    {
      "index": 52,
      "text": "あるいて、じょうずにします」。",
      "start_ms": 196177,
      "end_ms": 199892,
      "duration_ms": 3715,
      "clauses": [
        {
          "index": 0,
          "text": "あるいて、",
          "start_ms": 196177,
          "end_ms": 197695,
          "duration_ms": 1518
        },
        {
          "index": 1,
          "text": "じょうずにします」。",
          "start_ms": 197945,
          "end_ms": 199892,
          "duration_ms": 1947
        }
      ]
    },
    {
      "index": 53,
      "text": "「さむらいはみな、きますか」。",
      "start_ms": 200392,
      "end_ms": 204165,
      "duration_ms": 3773,
      "clauses": [
        {
          "index": 0,
          "text": "「さむらいはみな、",
          "start_ms": 200392,
          "end_ms": 202339,
          "duration_ms": 1947
        },
        {
          "index": 1,
          "text": "きますか」。",
          "start_ms": 202589,
          "end_ms": 204165,
          "duration_ms": 1576
        }
      ]
    },
    {
      "index": 54,
      "text": "おくさんはわらいました。",
      "start_ms": 204665,
      "end_ms": 207112,
      "duration_ms": 2447,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはわらいました。",
          "start_ms": 204665,
          "end_ms": 207112,
          "duration_ms": 2447
        }
      ]
    },
    {
      "index": 55,
      "text": "「みな、きます。",
      "start_ms": 207612,
      "end_ms": 210341,
      "duration_ms": 2729,
      "clauses": [
        {
          "index": 0,
          "text": "「みな、",
          "start_ms": 207612,
          "end_ms": 208666,
          "duration_ms": 1054
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 208916,
          "end_ms": 210341,
          "duration_ms": 1425
        }
      ]
    },
    {
      "index": 56,
      "text": "とのさまもきます。",
      "start_ms": 210841,
      "end_ms": 212963,
      "duration_ms": 2122,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまもきます。",
          "start_ms": 210841,
          "end_ms": 212963,
          "duration_ms": 2122
        }
      ]
    },
    {
      "index": 57,
      "text": "あなたはゆみがすきですか」。",
      "start_ms": 213463,
      "end_ms": 216223,
      "duration_ms": 2760,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはゆみがすきですか」。",
          "start_ms": 213463,
          "end_ms": 216223,
          "duration_ms": 2760
        }
      ]
    },
    {
      "index": 58,
      "text": "「いいえ。",
      "start_ms": 216723,
      "end_ms": 217440,
      "duration_ms": 717,
      "clauses": [
        {
          "index": 0,
          "text": "「いいえ。",
          "start_ms": 216723,
          "end_ms": 217440,
          "duration_ms": 717
        }
      ]
    },
    {
      "index": 59,
      "text": "ちちがすきでした。",
      "start_ms": 217940,
      "end_ms": 220015,
      "duration_ms": 2075,
      "clauses": [
        {
          "index": 0,
          "text": "ちちがすきでした。",
          "start_ms": 217940,
          "end_ms": 220015,
          "duration_ms": 2075
        }
      ]
    },
    {
      "index": 60,
      "text": "まえからゆみをみたことがありました。",
      "start_ms": 220515,
      "end_ms": 223798,
      "duration_ms": 3283,
      "clauses": [
        {
          "index": 0,
          "text": "まえからゆみをみたことがありました。",
          "start_ms": 220515,
          "end_ms": 223798,
          "duration_ms": 3283
        }
      ]
    },
    {
      "index": 61,
      "text": "だからすこし、しっています」。",
      "start_ms": 224298,
      "end_ms": 228176,
      "duration_ms": 3878,
      "clauses": [
        {
          "index": 0,
          "text": "だからすこし、",
          "start_ms": 224298,
          "end_ms": 226187,
          "duration_ms": 1889
        },
        {
          "index": 1,
          "text": "しっています」。",
          "start_ms": 226437,
          "end_ms": 228176,
          "duration_ms": 1739
        }
      ]
    },
    {
      "index": 62,
      "text": "おくさんはかいてあるものをだしました。",
      "start_ms": 228676,
      "end_ms": 232458,
      "duration_ms": 3782,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはかいてあるものをだしました。",
          "start_ms": 228676,
          "end_ms": 232458,
          "duration_ms": 3782
        }
      ]
    },
    {
      "index": 63,
      "text": "「ではこれをみてください。",
      "start_ms": 232958,
      "end_ms": 235730,
      "duration_ms": 2772,
      "clauses": [
        {
          "index": 0,
          "text": "「ではこれをみてください。",
          "start_ms": 232958,
          "end_ms": 235730,
          "duration_ms": 2772
        }
      ]
    },
    {
      "index": 64,
      "text": "くるさむらいの、なまえがかいてあります」。",
      "start_ms": 236230,
      "end_ms": 240746,
      "duration_ms": 4516,
      "clauses": [
        {
          "index": 0,
          "text": "くるさむらいの、",
          "start_ms": 236230,
          "end_ms": 238061,
          "duration_ms": 1831
        },
        {
          "index": 1,
          "text": "なまえがかいてあります」。",
          "start_ms": 238311,
          "end_ms": 240746,
          "duration_ms": 2435
        }
      ]
    },
    {
      "index": 65,
      "text": "カツノはそれをもちました。",
      "start_ms": 241246,
      "end_ms": 244064,
      "duration_ms": 2818,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはそれをもちました。",
          "start_ms": 241246,
          "end_ms": 244064,
          "duration_ms": 2818
        }
      ]
    },
    {
      "index": 66,
      "text": "うえからしたまでよみました。",
      "start_ms": 244564,
      "end_ms": 247417,
      "duration_ms": 2853,
      "clauses": [
        {
          "index": 0,
          "text": "うえからしたまでよみました。",
          "start_ms": 244564,
          "end_ms": 247417,
          "duration_ms": 2853
        }
      ]
    },
    {
      "index": 67,
      "text": "なまえがありました。",
      "start_ms": 247917,
      "end_ms": 250027,
      "duration_ms": 2110,
      "clauses": [
        {
          "index": 0,
          "text": "なまえがありました。",
          "start_ms": 247917,
          "end_ms": 250027,
          "duration_ms": 2110
        }
      ]
    },
    {
      "index": 68,
      "text": "「シチロウエモン」。",
      "start_ms": 250527,
      "end_ms": 252111,
      "duration_ms": 1584,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 250527,
          "end_ms": 252111,
          "duration_ms": 1584
        }
      ]
    },
    {
      "index": 69,
      "text": "カツノはまた、よみました。",
      "start_ms": 252611,
      "end_ms": 256477,
      "duration_ms": 3866,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはまた、",
          "start_ms": 252611,
          "end_ms": 254535,
          "duration_ms": 1924
        },
        {
          "index": 1,
          "text": "よみました。",
          "start_ms": 254785,
          "end_ms": 256477,
          "duration_ms": 1692
        }
      ]
    },
    {
      "index": 70,
      "text": "「シチロウエモン」。",
      "start_ms": 256977,
      "end_ms": 258561,
      "duration_ms": 1584,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 256977,
          "end_ms": 258561,
          "duration_ms": 1584
        }
      ]
    },
    {
      "index": 71,
      "text": "はい、シチロウエモンです。",
      "start_ms": 259061,
      "end_ms": 262146,
      "duration_ms": 3085,
      "clauses": [
        {
          "index": 0,
          "text": "はい、",
          "start_ms": 259061,
          "end_ms": 259720,
          "duration_ms": 659
        },
        {
          "index": 1,
          "text": "シチロウエモンです。",
          "start_ms": 259970,
          "end_ms": 262146,
          "duration_ms": 2176
        }
      ]
    },
    {
      "index": 72,
      "text": "「ついにきます。",
      "start_ms": 262646,
      "end_ms": 264489,
      "duration_ms": 1843,
      "clauses": [
        {
          "index": 0,
          "text": "「ついにきます。",
          "start_ms": 262646,
          "end_ms": 264489,
          "duration_ms": 1843
        }
      ]
    },
    {
      "index": 73,
      "text": "もう、まちません」。",
      "start_ms": 264989,
      "end_ms": 267694,
      "duration_ms": 2705,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 264989,
          "end_ms": 265822,
          "duration_ms": 833
        },
        {
          "index": 1,
          "text": "まちません」。",
          "start_ms": 266072,
          "end_ms": 267694,
          "duration_ms": 1622
        }
      ]
    },
    {
      "index": 74,
      "text": "そのよる、カツノはおきていました。",
      "start_ms": 268194,
      "end_ms": 272536,
      "duration_ms": 4342,
      "clauses": [
        {
          "index": 0,
          "text": "そのよる、",
          "start_ms": 268194,
          "end_ms": 269816,
          "duration_ms": 1622
        },
        {
          "index": 1,
          "text": "カツノはおきていました。",
          "start_ms": 270066,
          "end_ms": 272536,
          "duration_ms": 2470
        }
      ]
    },
    {
      "index": 75,
      "text": "ちいさなかたなをもちました。",
      "start_ms": 273036,
      "end_ms": 275889,
      "duration_ms": 2853,
      "clauses": [
        {
          "index": 0,
          "text": "ちいさなかたなをもちました。",
          "start_ms": 273036,
          "end_ms": 275889,
          "duration_ms": 2853
        }
      ]
    },
    {
      "index": 76,
      "text": "「ハチヤ。",
      "start_ms": 276389,
      "end_ms": 277837,
      "duration_ms": 1448,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤ。",
          "start_ms": 276389,
          "end_ms": 277837,
          "duration_ms": 1448
        }
      ]
    },
    {
      "index": 77,
      "text": "あした、あいます。",
      "start_ms": 278337,
      "end_ms": 281402,
      "duration_ms": 3065,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 278337,
          "end_ms": 279646,
          "duration_ms": 1309
        },
        {
          "index": 1,
          "text": "あいます。",
          "start_ms": 279896,
          "end_ms": 281402,
          "duration_ms": 1506
        }
      ]
    },
    {
      "index": 78,
      "text": "あした、ころします。",
      "start_ms": 281902,
      "end_ms": 285107,
      "duration_ms": 3205,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 281902,
          "end_ms": 283211,
          "duration_ms": 1309
        },
        {
          "index": 1,
          "text": "ころします。",
          "start_ms": 283461,
          "end_ms": 285107,
          "duration_ms": 1646
        }
      ]
    },
    {
      "index": 79,
      "text": "もう、まってください」。",
      "start_ms": 285607,
      "end_ms": 288579,
      "duration_ms": 2972,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 285607,
          "end_ms": 286440,
          "duration_ms": 833
        },
        {
          "index": 1,
          "text": "まってください」。",
          "start_ms": 286690,
          "end_ms": 288579,
          "duration_ms": 1889
        }
      ]
    }
  ]
}