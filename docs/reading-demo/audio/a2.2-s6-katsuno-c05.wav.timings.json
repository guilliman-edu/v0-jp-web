          "text": "おおくのおきゃくがきて、",
          "start_ms": 175249,
          "end_ms": 177522,
          "duration_ms": 2273
        },
        {
          "index": 1,
          "text": "いますね」。",
          "start_ms": 177772,
          "end_ms": 179151,
          "duration_ms": 1379
        }
      ]
    },
    {
      "index": 48,
      "text": "おくさんはこたえました。",
      "start_ms": 179651,
      "end_ms": 182179,
      "duration_ms": 2528,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはこたえました。",
          "start_ms": 179651,
          "end_ms": 182179,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 49,
      "text": "「あした、ゆみのたいかいがあります。",
      "start_ms": 182679,
      "end_ms": 186720,
      "duration_ms": 4041,
      "clauses": [
        {
          "index": 0,
          "text": "「あした、",
          "start_ms": 182679,
          "end_ms": 183988,
          "duration_ms": 1309
        },
        {
          "index": 1,
          "text": "ゆみのたいかいがあります。",
          "start_ms": 184238,
          "end_ms": 186720,
          "duration_ms": 2482
        }
      ]
    },
    {
      "index": 50,
      "text": "さむらいがおおく、きます。",
      "start_ms": 187220,
      "end_ms": 190866,
      "duration_ms": 3646,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいがおおく、",
          "start_ms": 187220,
          "end_ms": 189249,
          "duration_ms": 2029
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 189499,
          "end_ms": 190866,
          "duration_ms": 1367
        }
      ]
    },
    {
      "index": 51,
      "text": "みな、ゆみをじょうずにつかいます。",
      "start_ms": 191366,
      "end_ms": 195291,
      "duration_ms": 3925,
      "clauses": [
        {
          "index": 0,
          "text": "みな、",
          "start_ms": 191366,
          "end_ms": 192350,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "ゆみをじょうずにつかいます。",
          "start_ms": 192600,
          "end_ms": 195291,
          "duration_ms": 2691
        }
      ]
    },
    {
      "index": 52,
      "text": "あるいて、じょうずにします」。",
      "start_ms": 195791,
      "end_ms": 199437,
      "duration_ms": 3646,
      "clauses": [
        {
          "index": 0,
          "text": "あるいて、",
          "start_ms": 195791,
          "end_ms": 197274,
          "duration_ms": 1483
        },
        {
          "index": 1,
          "text": "じょうずにします」。",
          "start_ms": 197524,
          "end_ms": 199437,
          "duration_ms": 1913
        }
      ]
    },
    {
      "index": 53,
      "text": "「さむらいはみな、きますか」。",
      "start_ms": 199937,
      "end_ms": 203652,
      "duration_ms": 3715,
      "clauses": [
        {
          "index": 0,
          "text": "「さむらいはみな、",
          "start_ms": 199937,
          "end_ms": 201838,
          "duration_ms": 1901
        },
        {
          "index": 1,
          "text": "きますか」。",
          "start_ms": 202088,
          "end_ms": 203652,
          "duration_ms": 1564
        }
      ]
    },
    {
      "index": 54,
      "text": "おくさんはわらいました。",
      "start_ms": 204152,
      "end_ms": 206587,
      "duration_ms": 2435,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはわらいました。",
          "start_ms": 204152,
          "end_ms": 206587,
          "duration_ms": 2435
        }
      ]
    },
    {
      "index": 55,
      "text": "「みな、きます。",
      "start_ms": 207087,
      "end_ms": 209781,
      "duration_ms": 2694,
      "clauses": [
        {
          "index": 0,
          "text": "「みな、",
          "start_ms": 207087,
          "end_ms": 208106,
          "duration_ms": 1019
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 208356,
          "end_ms": 209781,
          "duration_ms": 1425
        }
      ]
    },
    {
      "index": 56,
      "text": "とのさまもきます。",
      "start_ms": 210281,
      "end_ms": 212449,
      "duration_ms": 2168,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまもきます。",
          "start_ms": 210281,
          "end_ms": 212449,
          "duration_ms": 2168
        }
      ]
    },
    {
      "index": 57,
      "text": "あなたはゆみがすきですか」。",
      "start_ms": 212949,
      "end_ms": 215709,
      "duration_ms": 2760,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはゆみがすきですか」。",
          "start_ms": 212949,
          "end_ms": 215709,
          "duration_ms": 2760
        }
      ]
    },
    {
      "index": 58,
      "text": "「いいえ。",
      "start_ms": 216209,
      "end_ms": 216926,
      "duration_ms": 717,
      "clauses": [
        {
          "index": 0,
          "text": "「いいえ。",
          "start_ms": 216209,
          "end_ms": 216926,
          "duration_ms": 717
        }
      ]
    },
    {
      "index": 59,
      "text": "ちちがすきでした。",
      "start_ms": 217426,
      "end_ms": 219420,
      "duration_ms": 1994,
      "clauses": [
        {
          "index": 0,
          "text": "ちちがすきでした。",
          "start_ms": 217426,
          "end_ms": 219420,
          "duration_ms": 1994
        }
      ]
    },
    {
      "index": 60,
      "text": "まえからゆみをみたことがありました。",
      "start_ms": 219920,
      "end_ms": 223226,
      "duration_ms": 3306,
      "clauses": [
        {
          "index": 0,
          "text": "まえからゆみをみたことがありました。",
          "start_ms": 219920,
          "end_ms": 223226,
          "duration_ms": 3306
        }
      ]
    },
    {
      "index": 61,
      "text": "だからすこし、しっています」。",
      "start_ms": 223726,
      "end_ms": 227604,
      "duration_ms": 3878,
      "clauses": [
        {
          "index": 0,
          "text": "だからすこし、",
          "start_ms": 223726,
          "end_ms": 225592,
          "duration_ms": 1866
        },
        {
          "index": 1,
          "text": "しっています」。",
          "start_ms": 225842,
          "end_ms": 227604,
          "duration_ms": 1762
        }
      ]
    },
    {
      "index": 62,
      "text": "おくさんはかいてあるものをだしました。",
      "start_ms": 228104,
      "end_ms": 231851,
      "duration_ms": 3747,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはかいてあるものをだしました。",
          "start_ms": 228104,
          "end_ms": 231851,
          "duration_ms": 3747
        }
      ]
    },
    {
      "index": 63,
      "text": "「ではこれをみてください。",
      "start_ms": 232351,
      "end_ms": 234983,
      "duration_ms": 2632,
      "clauses": [
        {
          "index": 0,
          "text": "「ではこれをみてください。",
          "start_ms": 232351,
          "end_ms": 234983,
          "duration_ms": 2632
        }
      ]
    },
    {
      "index": 64,
      "text": "くるさむらいの、なまえがかいてあります」。",
      "start_ms": 235483,
      "end_ms": 240022,
      "duration_ms": 4539,
      "clauses": [
        {
          "index": 0,
          "text": "くるさむらいの、",
          "start_ms": 235483,
          "end_ms": 237349,
          "duration_ms": 1866
        },
        {
          "index": 1,
          "text": "なまえがかいてあります」。",
          "start_ms": 237599,
          "end_ms": 240022,
          "duration_ms": 2423
        }
      ]
    },
    {
      "index": 65,
      "text": "カツノはそれをもちました。",
      "start_ms": 240522,
      "end_ms": 243468,
      "duration_ms": 2946,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはそれをもちました。",
          "start_ms": 240522,
          "end_ms": 243468,
          "duration_ms": 2946
        }
      ]
    },
    {
      "index": 66,
      "text": "うえからしたまでよみました。",
      "start_ms": 243968,
      "end_ms": 246786,
      "duration_ms": 2818,
      "clauses": [
        {
          "index": 0,
          "text": "うえからしたまでよみました。",
          "start_ms": 243968,
          "end_ms": 246786,
          "duration_ms": 2818
        }
      ]
    },
    {
      "index": 67,
      "text": "なまえがありました。",
      "start_ms": 247286,
      "end_ms": 249431,
      "duration_ms": 2145,
      "clauses": [
        {
          "index": 0,
          "text": "なまえがありました。",
          "start_ms": 247286,
          "end_ms": 249431,
          "duration_ms": 2145
        }
      ]
    },
    {
      "index": 68,
      "text": "「シチロウエモン」。",
      "start_ms": 249931,
      "end_ms": 251588,
      "duration_ms": 1657,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 249931,
          "end_ms": 251588,
          "duration_ms": 1657
        }
      ]
    },
    {
      "index": 69,
      "text": "カツノはまた、よみました。",
      "start_ms": 252088,
      "end_ms": 255873,
      "duration_ms": 3785,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはまた、",
          "start_ms": 252088,
          "end_ms": 253966,
          "duration_ms": 1878
        },
        {
          "index": 1,
          "text": "よみました。",
          "start_ms": 254216,
          "end_ms": 255873,
          "duration_ms": 1657
        }
      ]
    },
    {
      "index": 70,
      "text": "「シチロウエモン」。",
      "start_ms": 256373,
      "end_ms": 258135,
      "duration_ms": 1762,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 256373,
          "end_ms": 258135,
          "duration_ms": 1762
        }
      ]
    },
    {
      "index": 71,
      "text": "はい、シチロウエモンです。",
      "start_ms": 258635,
      "end_ms": 261550,
      "duration_ms": 2915,
      "clauses": [
        {
          "index": 0,
          "text": "はい、",
          "start_ms": 258635,
          "end_ms": 259236,
          "duration_ms": 601
        },
        {
          "index": 1,
          "text": "シチロウエモンです。",
          "start_ms": 259486,
          "end_ms": 261550,
          "duration_ms": 2064
        }
      ]
    },
    {
      "index": 72,
      "text": "「ついにきます。",
      "start_ms": 262050,
      "end_ms": 263881,
      "duration_ms": 1831,
      "clauses": [
        {
          "index": 0,
          "text": "「ついにきます。",
          "start_ms": 262050,
          "end_ms": 263881,
          "duration_ms": 1831
        }
      ]
    },
    {
      "index": 73,
      "text": "もう、まちません」。",
      "start_ms": 264381,
      "end_ms": 267122,
      "duration_ms": 2741,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 264381,
          "end_ms": 265226,
          "duration_ms": 845
        },
        {
          "index": 1,
          "text": "まちません」。",
          "start_ms": 265476,
          "end_ms": 267122,
          "duration_ms": 1646
        }
      ]
    },
    {
      "index": 74,
      "text": "そのよる、カツノはおきていました。",
      "start_ms": 267622,
      "end_ms": 272081,
      "duration_ms": 4459,
      "clauses": [
        {
          "index": 0,
          "text": "そのよる、",
          "start_ms": 267622,
          "end_ms": 269233,
          "duration_ms": 1611
        },
        {
          "index": 1,
          "text": "カツノはおきていました。",
          "start_ms": 269483,
          "end_ms": 272081,
          "duration_ms": 2598
        }
      ]
    },
    {
      "index": 75,
      "text": "ちいさなかたなをもちました。",
      "start_ms": 272581,
      "end_ms": 275399,
      "duration_ms": 2818,
      "clauses": [
        {
          "index": 0,
          "text": "ちいさなかたなをもちました。",
          "start_ms": 272581,
          "end_ms": 275399,
          "duration_ms": 2818
        }
      ]
    },
    {
      "index": 76,
      "text": "「ハチヤ。",
      "start_ms": 275899,
      "end_ms": 277324,
      "duration_ms": 1425,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤ。",
          "start_ms": 275899,
          "end_ms": 277324,
          "duration_ms": 1425
        }
      ]
    },
    {
      "index": 77,
      "text": "あした、あいます。",
      "start_ms": 277824,
      "end_ms": 280854,
      "duration_ms": 3030,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 277824,
          "end_ms": 279121,
          "duration_ms": 1297
        },
        {
          "index": 1,
          "text": "あいます。",
          "start_ms": 279371,
          "end_ms": 280854,
          "duration_ms": 1483
        }
      ]
    },
    {
      "index": 78,
      "text": "あした、ころします。",
      "start_ms": 281354,
      "end_ms": 284501,
      "duration_ms": 3147,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 281354,
          "end_ms": 282640,
          "duration_ms": 1286
        },
        {
          "index": 1,
          "text": "ころします。",
          "start_ms": 282890,
          "end_ms": 284501,
          "duration_ms": 1611
        }
      ]
    },
    {
      "index": 79,
      "text": "もう、まってください」。",
      "start_ms": 285001,
      "end_ms": 287997,
      "duration_ms": 2996,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 285001,
          "end_ms": 285834,
          "duration_ms": 833
        },
        {
          "index": 1,
          "text": "まってください」。",
          "start_ms": 286084,
          "end_ms": 287997,
          "duration_ms": 1913
        }
      ]
    }
  ]
}