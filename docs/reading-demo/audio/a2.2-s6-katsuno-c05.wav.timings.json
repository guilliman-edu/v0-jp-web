          "index": 0,
          "text": "おおくのおきゃくがきて、",
          "start_ms": 175778,
          "end_ms": 178051,
          "duration_ms": 2273
        },
        {
          "index": 1,
          "text": "いますね」。",
          "start_ms": 178301,
          "end_ms": 179703,
          "duration_ms": 1402
        }
      ]
    },
    {
      "index": 48,
      "text": "おくさんはこたえました。",
      "start_ms": 180203,
      "end_ms": 182708,
      "duration_ms": 2505,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはこたえました。",
          "start_ms": 180203,
          "end_ms": 182708,
          "duration_ms": 2505
        }
      ]
    },
    {
      "index": 49,
      "text": "「あした、ゆみのたいかいがあります。",
      "start_ms": 183208,
      "end_ms": 187271,
      "duration_ms": 4063,
      "clauses": [
        {
          "index": 0,
          "text": "「あした、",
          "start_ms": 183208,
          "end_ms": 184505,
          "duration_ms": 1297
        },
        {
          "index": 1,
          "text": "ゆみのたいかいがあります。",
          "start_ms": 184755,
          "end_ms": 187271,
          "duration_ms": 2516
        }
      ]
    },
    {
      "index": 50,
      "text": "さむらいがおおく、きます。",
      "start_ms": 187771,
      "end_ms": 191371,
      "duration_ms": 3600,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいがおおく、",
          "start_ms": 187771,
          "end_ms": 189777,
          "duration_ms": 2006
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 190027,
          "end_ms": 191371,
          "duration_ms": 1344
        }
      ]
    },
    {
      "index": 51,
      "text": "みな、ゆみをじょうずにつかいます。",
      "start_ms": 191871,
      "end_ms": 195854,
      "duration_ms": 3983,
      "clauses": [
        {
          "index": 0,
          "text": "みな、",
          "start_ms": 191871,
          "end_ms": 192913,
          "duration_ms": 1042
        },
        {
          "index": 1,
          "text": "ゆみをじょうずにつかいます。",
          "start_ms": 193163,
          "end_ms": 195854,
          "duration_ms": 2691
        }
      ]
    },
    {
      "index": 52,
      "text": "あるいて、じょうずにします」。",
      "start_ms": 196354,
      "end_ms": 199977,
      "duration_ms": 3623,
      "clauses": [
        {
          "index": 0,
          "text": "あるいて、",
          "start_ms": 196354,
          "end_ms": 197791,
          "duration_ms": 1437
        },
        {
          "index": 1,
          "text": "じょうずにします」。",
          "start_ms": 198041,
          "end_ms": 199977,
          "duration_ms": 1936
        }
      ]
    },
    {
      "index": 53,
      "text": "「さむらいはみな、きますか」。",
      "start_ms": 200477,
      "end_ms": 204286,
      "duration_ms": 3809,
      "clauses": [
        {
          "index": 0,
          "text": "「さむらいはみな、",
          "start_ms": 200477,
          "end_ms": 202448,
          "duration_ms": 1971
        },
        {
          "index": 1,
          "text": "きますか」。",
          "start_ms": 202698,
          "end_ms": 204286,
          "duration_ms": 1588
        }
      ]
    },
    {
      "index": 54,
      "text": "おくさんはわらいました。",
      "start_ms": 204786,
      "end_ms": 207279,
      "duration_ms": 2493,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはわらいました。",
          "start_ms": 204786,
          "end_ms": 207279,
          "duration_ms": 2493
        }
      ]
    },
    {
      "index": 55,
      "text": "「みな、きます。",
      "start_ms": 207779,
      "end_ms": 210472,
      "duration_ms": 2693,
      "clauses": [
        {
          "index": 0,
          "text": "「みな、",
          "start_ms": 207779,
          "end_ms": 208809,
          "duration_ms": 1030
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 209059,
          "end_ms": 210472,
          "duration_ms": 1413
        }
      ]
    },
    {
      "index": 56,
      "text": "とのさまもきます。",
      "start_ms": 210972,
      "end_ms": 213117,
      "duration_ms": 2145,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまもきます。",
          "start_ms": 210972,
          "end_ms": 213117,
          "duration_ms": 2145
        }
      ]
    },
    {
      "index": 57,
      "text": "あなたはゆみがすきですか」。",
      "start_ms": 213617,
      "end_ms": 216389,
      "duration_ms": 2772,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはゆみがすきですか」。",
          "start_ms": 213617,
          "end_ms": 216389,
          "duration_ms": 2772
        }
      ]
    },
    {
      "index": 58,
      "text": "「いいえ。",
      "start_ms": 216889,
      "end_ms": 217629,
      "duration_ms": 740,
      "clauses": [
        {
          "index": 0,
          "text": "「いいえ。",
          "start_ms": 216889,
          "end_ms": 217629,
          "duration_ms": 740
        }
      ]
    },
    {
      "index": 59,
      "text": "ちちがすきでした。",
      "start_ms": 218129,
      "end_ms": 220158,
      "duration_ms": 2029,
      "clauses": [
        {
          "index": 0,
          "text": "ちちがすきでした。",
          "start_ms": 218129,
          "end_ms": 220158,
          "duration_ms": 2029
        }
      ]
    },
    {
      "index": 60,
      "text": "まえからゆみをみたことがありました。",
      "start_ms": 220658,
      "end_ms": 223987,
      "duration_ms": 3329,
      "clauses": [
        {
          "index": 0,
          "text": "まえからゆみをみたことがありました。",
          "start_ms": 220658,
          "end_ms": 223987,
          "duration_ms": 3329
        }
      ]
    },
    {
      "index": 61,
      "text": "だからすこし、しっています」。",
      "start_ms": 224487,
      "end_ms": 228307,
      "duration_ms": 3820,
      "clauses": [
        {
          "index": 0,
          "text": "だからすこし、",
          "start_ms": 224487,
          "end_ms": 226295,
          "duration_ms": 1808
        },
        {
          "index": 1,
          "text": "しっています」。",
          "start_ms": 226545,
          "end_ms": 228307,
          "duration_ms": 1762
        }
      ]
    },
    {
      "index": 62,
      "text": "おくさんはかいてあるものをだしました。",
      "start_ms": 228807,
      "end_ms": 232531,
      "duration_ms": 3724,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはかいてあるものをだしました。",
          "start_ms": 228807,
          "end_ms": 232531,
          "duration_ms": 3724
        }
      ]
    },
    {
      "index": 63,
      "text": "「ではこれをみてください。",
      "start_ms": 233031,
      "end_ms": 235663,
      "duration_ms": 2632,
      "clauses": [
        {
          "index": 0,
          "text": "「ではこれをみてください。",
          "start_ms": 233031,
          "end_ms": 235663,
          "duration_ms": 2632
        }
      ]
    },
    {
      "index": 64,
      "text": "くるさむらいの、なまえがかいてあります」。",
      "start_ms": 236163,
      "end_ms": 240691,
      "duration_ms": 4528,
      "clauses": [
        {
          "index": 0,
          "text": "くるさむらいの、",
          "start_ms": 236163,
          "end_ms": 238029,
          "duration_ms": 1866
        },
        {
          "index": 1,
          "text": "なまえがかいてあります」。",
          "start_ms": 238279,
          "end_ms": 240691,
          "duration_ms": 2412
        }
      ]
    },
    {
      "index": 65,
      "text": "カツノはそれをもちました。",
      "start_ms": 241191,
      "end_ms": 244125,
      "duration_ms": 2934,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはそれをもちました。",
          "start_ms": 241191,
          "end_ms": 244125,
          "duration_ms": 2934
        }
      ]
    },
    {
      "index": 66,
      "text": "うえからしたまでよみました。",
      "start_ms": 244625,
      "end_ms": 247420,
      "duration_ms": 2795,
      "clauses": [
        {
          "index": 0,
          "text": "うえからしたまでよみました。",
          "start_ms": 244625,
          "end_ms": 247420,
          "duration_ms": 2795
        }
      ]
    },
    {
      "index": 67,
      "text": "なまえがありました。",
      "start_ms": 247920,
      "end_ms": 249972,
      "duration_ms": 2052,
      "clauses": [
        {
          "index": 0,
          "text": "なまえがありました。",
          "start_ms": 247920,
          "end_ms": 249972,
          "duration_ms": 2052
        }
      ]
    },
    {
      "index": 68,
      "text": "「シチロウエモン」。",
      "start_ms": 250472,
      "end_ms": 252245,
      "duration_ms": 1773,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 250472,
          "end_ms": 252245,
          "duration_ms": 1773
        }
      ]
    },
    {
      "index": 69,
      "text": "カツノはまた、よみました。",
      "start_ms": 252745,
      "end_ms": 256518,
      "duration_ms": 3773,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはまた、",
          "start_ms": 252745,
          "end_ms": 254611,
          "duration_ms": 1866
        },
        {
          "index": 1,
          "text": "よみました。",
          "start_ms": 254861,
          "end_ms": 256518,
          "duration_ms": 1657
        }
      ]
    },
    {
      "index": 70,
      "text": "「シチロウエモン」。",
      "start_ms": 257018,
      "end_ms": 258780,
      "duration_ms": 1762,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 257018,
          "end_ms": 258780,
          "duration_ms": 1762
        }
      ]
    },
    {
      "index": 71,
      "text": "はい、シチロウエモンです。",
      "start_ms": 259280,
      "end_ms": 262276,
      "duration_ms": 2996,
      "clauses": [
        {
          "index": 0,
          "text": "はい、",
          "start_ms": 259280,
          "end_ms": 259904,
          "duration_ms": 624
        },
        {
          "index": 1,
          "text": "シチロウエモンです。",
          "start_ms": 260154,
          "end_ms": 262276,
          "duration_ms": 2122
        }
      ]
    },
    {
      "index": 72,
      "text": "「ついにきます。",
      "start_ms": 262776,
      "end_ms": 264596,
      "duration_ms": 1820,
      "clauses": [
        {
          "index": 0,
          "text": "「ついにきます。",
          "start_ms": 262776,
          "end_ms": 264596,
          "duration_ms": 1820
        }
      ]
    },
    {
      "index": 73,
      "text": "もう、まちません」。",
      "start_ms": 265096,
      "end_ms": 267801,
      "duration_ms": 2705,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 265096,
          "end_ms": 265929,
          "duration_ms": 833
        },
        {
          "index": 1,
          "text": "まちません」。",
          "start_ms": 266179,
          "end_ms": 267801,
          "duration_ms": 1622
        }
      ]
    },
    {
      "index": 74,
      "text": "そのよる、カツノはおきていました。",
      "start_ms": 268301,
      "end_ms": 272678,
      "duration_ms": 4377,
      "clauses": [
        {
          "index": 0,
          "text": "そのよる、",
          "start_ms": 268301,
          "end_ms": 269865,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "カツノはおきていました。",
          "start_ms": 270115,
          "end_ms": 272678,
          "duration_ms": 2563
        }
      ]
    },
    {
      "index": 75,
      "text": "ちいさなかたなをもちました。",
      "start_ms": 273178,
      "end_ms": 276019,
      "duration_ms": 2841,
      "clauses": [
        {
          "index": 0,
          "text": "ちいさなかたなをもちました。",
          "start_ms": 273178,
          "end_ms": 276019,
          "duration_ms": 2841
        }
      ]
    },
    {
      "index": 76,
      "text": "「ハチヤ。",
      "start_ms": 276519,
      "end_ms": 277921,
      "duration_ms": 1402,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤ。",
          "start_ms": 276519,
          "end_ms": 277921,
          "duration_ms": 1402
        }
      ]
    },
    {
      "index": 77,
      "text": "あした、あいます。",
      "start_ms": 278421,
      "end_ms": 281474,
      "duration_ms": 3053,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 278421,
          "end_ms": 279718,
          "duration_ms": 1297
        },
        {
          "index": 1,
          "text": "あいます。",
          "start_ms": 279968,
          "end_ms": 281474,
          "duration_ms": 1506
        }
      ]
    },
    {
      "index": 78,
      "text": "あした、ころします。",
      "start_ms": 281974,
      "end_ms": 285144,
      "duration_ms": 3170,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 281974,
          "end_ms": 283295,
          "duration_ms": 1321
        },
        {
          "index": 1,
          "text": "ころします。",
          "start_ms": 283545,
          "end_ms": 285144,
          "duration_ms": 1599
        }
      ]
    },
    {
      "index": 79,
      "text": "もう、まってください」。",
      "start_ms": 285644,
      "end_ms": 288604,
      "duration_ms": 2960,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 285644,
          "end_ms": 286465,
          "duration_ms": 821
        },
        {
          "index": 1,
          "text": "まってください」。",
          "start_ms": 286715,
          "end_ms": 288604,
          "duration_ms": 1889
        }
      ]
    }
  ]
}