          "start_ms": 171342,
          "end_ms": 173501,
          "duration_ms": 2159
        },
        {
          "index": 1,
          "text": "いますね」。",
          "start_ms": 173751,
          "end_ms": 175120,
          "duration_ms": 1369
        }
      ]
    },
    {
      "index": 48,
      "text": "おくさんはこたえました。",
      "start_ms": 175620,
      "end_ms": 178069,
      "duration_ms": 2449,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはこたえました。",
          "start_ms": 175620,
          "end_ms": 178069,
          "duration_ms": 2449
        }
      ]
    },
    {
      "index": 49,
      "text": "「あした、ゆみのたいかいがあります。",
      "start_ms": 178569,
      "end_ms": 182464,
      "duration_ms": 3895,
      "clauses": [
        {
          "index": 0,
          "text": "「あした、",
          "start_ms": 178569,
          "end_ms": 179811,
          "duration_ms": 1242
        },
        {
          "index": 1,
          "text": "ゆみのたいかいがあります。",
          "start_ms": 180061,
          "end_ms": 182464,
          "duration_ms": 2403
        }
      ]
    },
    {
      "index": 50,
      "text": "さむらいがおおく、きます。",
      "start_ms": 182964,
      "end_ms": 186429,
      "duration_ms": 3465,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいがおおく、",
          "start_ms": 182964,
          "end_ms": 184949,
          "duration_ms": 1985
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 185199,
          "end_ms": 186429,
          "duration_ms": 1230
        }
      ]
    },
    {
      "index": 51,
      "text": "みな、ゆみをじょうずにつかいます。",
      "start_ms": 186929,
      "end_ms": 190800,
      "duration_ms": 3871,
      "clauses": [
        {
          "index": 0,
          "text": "みな、",
          "start_ms": 186929,
          "end_ms": 187892,
          "duration_ms": 963
        },
        {
          "index": 1,
          "text": "ゆみをじょうずにつかいます。",
          "start_ms": 188142,
          "end_ms": 190800,
          "duration_ms": 2658
        }
      ]
    },
    {
      "index": 52,
      "text": "あるいて、じょうずにします」。",
      "start_ms": 191300,
      "end_ms": 194893,
      "duration_ms": 3593,
      "clauses": [
        {
          "index": 0,
          "text": "あるいて、",
          "start_ms": 191300,
          "end_ms": 192716,
          "duration_ms": 1416
        },
        {
          "index": 1,
          "text": "じょうずにします」。",
          "start_ms": 192966,
          "end_ms": 194893,
          "duration_ms": 1927
        }
      ]
    },
    {
      "index": 53,
      "text": "「さむらいはみな、きますか」。",
      "start_ms": 195393,
      "end_ms": 199102,
      "duration_ms": 3709,
      "clauses": [
        {
          "index": 0,
          "text": "「さむらいはみな、",
          "start_ms": 195393,
          "end_ms": 197285,
          "duration_ms": 1892
        },
        {
          "index": 1,
          "text": "きますか」。",
          "start_ms": 197535,
          "end_ms": 199102,
          "duration_ms": 1567
        }
      ]
    },
    {
      "index": 54,
      "text": "おくさんはわらいました。",
      "start_ms": 199602,
      "end_ms": 202005,
      "duration_ms": 2403,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはわらいました。",
          "start_ms": 199602,
          "end_ms": 202005,
          "duration_ms": 2403
        }
      ]
    },
    {
      "index": 55,
      "text": "「みな、きます。",
      "start_ms": 202505,
      "end_ms": 204913,
      "duration_ms": 2408,
      "clauses": [
        {
          "index": 0,
          "text": "「みな、",
          "start_ms": 202505,
          "end_ms": 203433,
          "duration_ms": 928
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 203683,
          "end_ms": 204913,
          "duration_ms": 1230
        }
      ]
    },
    {
      "index": 56,
      "text": "とのさまもきます。",
      "start_ms": 205413,
      "end_ms": 207456,
      "duration_ms": 2043,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまもきます。",
          "start_ms": 205413,
          "end_ms": 207456,
          "duration_ms": 2043
        }
      ]
    },
    {
      "index": 57,
      "text": "あなたはゆみがすきですか」。",
      "start_ms": 207956,
      "end_ms": 210661,
      "duration_ms": 2705,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはゆみがすきですか」。",
          "start_ms": 207956,
          "end_ms": 210661,
          "duration_ms": 2705
        }
      ]
    },
    {
      "index": 58,
      "text": "「いいえ。",
      "start_ms": 211161,
      "end_ms": 211822,
      "duration_ms": 661,
      "clauses": [
        {
          "index": 0,
          "text": "「いいえ。",
          "start_ms": 211161,
          "end_ms": 211822,
          "duration_ms": 661
        }
      ]
    },
    {
      "index": 59,
      "text": "ちちがすきでした。",
      "start_ms": 212322,
      "end_ms": 214330,
      "duration_ms": 2008,
      "clauses": [
        {
          "index": 0,
          "text": "ちちがすきでした。",
          "start_ms": 212322,
          "end_ms": 214330,
          "duration_ms": 2008
        }
      ]
    },
    {
      "index": 60,
      "text": "まえからゆみをみたことがありました。",
      "start_ms": 214830,
      "end_ms": 218011,
      "duration_ms": 3181,
      "clauses": [
        {
          "index": 0,
          "text": "まえからゆみをみたことがありました。",
          "start_ms": 214830,
          "end_ms": 218011,
          "duration_ms": 3181
        }
      ]
    },
    {
      "index": 61,
      "text": "だからすこし、しっています」。",
      "start_ms": 218511,
      "end_ms": 222196,
      "duration_ms": 3685,
      "clauses": [
        {
          "index": 0,
          "text": "だからすこし、",
          "start_ms": 218511,
          "end_ms": 220275,
          "duration_ms": 1764
        },
        {
          "index": 1,
          "text": "しっています」。",
          "start_ms": 220525,
          "end_ms": 222196,
          "duration_ms": 1671
        }
      ]
    },
    {
      "index": 62,
      "text": "おくさんはかいてあるものをだしました。",
      "start_ms": 222696,
      "end_ms": 226434,
      "duration_ms": 3738,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはかいてあるものをだしました。",
          "start_ms": 222696,
          "end_ms": 226434,
          "duration_ms": 3738
        }
      ]
    },
    {
      "index": 63,
      "text": "「ではこれをみてください。",
      "start_ms": 226934,
      "end_ms": 229546,
      "duration_ms": 2612,
      "clauses": [
        {
          "index": 0,
          "text": "「ではこれをみてください。",
          "start_ms": 226934,
          "end_ms": 229546,
          "duration_ms": 2612
        }
      ]
    },
    {
      "index": 64,
      "text": "くるさむらいの、なまえがかいてあります」。",
      "start_ms": 230046,
      "end_ms": 234405,
      "duration_ms": 4359,
      "clauses": [
        {
          "index": 0,
          "text": "くるさむらいの、",
          "start_ms": 230046,
          "end_ms": 231857,
          "duration_ms": 1811
        },
        {
          "index": 1,
          "text": "なまえがかいてあります」。",
          "start_ms": 232107,
          "end_ms": 234405,
          "duration_ms": 2298
        }
      ]
    },
    {
      "index": 65,
      "text": "カツノはそれをもちました。",
      "start_ms": 234905,
      "end_ms": 237807,
      "duration_ms": 2902,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはそれをもちました。",
          "start_ms": 234905,
          "end_ms": 237807,
          "duration_ms": 2902
        }
      ]
    },
    {
      "index": 66,
      "text": "うえからしたまでよみました。",
      "start_ms": 238307,
      "end_ms": 241058,
      "duration_ms": 2751,
      "clauses": [
        {
          "index": 0,
          "text": "うえからしたまでよみました。",
          "start_ms": 238307,
          "end_ms": 241058,
          "duration_ms": 2751
        }
      ]
    },
    {
      "index": 67,
      "text": "なまえがありました。",
      "start_ms": 241558,
      "end_ms": 243601,
      "duration_ms": 2043,
      "clauses": [
        {
          "index": 0,
          "text": "なまえがありました。",
          "start_ms": 241558,
          "end_ms": 243601,
          "duration_ms": 2043
        }
      ]
    },
    {
      "index": 68,
      "text": "「シチロウエモン」。",
      "start_ms": 244101,
      "end_ms": 245665,
      "duration_ms": 1564,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 244101,
          "end_ms": 245665,
          "duration_ms": 1564
        }
      ]
    },
    {
      "index": 69,
      "text": "カツノはまた、よみました。",
      "start_ms": 246165,
      "end_ms": 249839,
      "duration_ms": 3674,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはまた、",
          "start_ms": 246165,
          "end_ms": 247976,
          "duration_ms": 1811
        },
        {
          "index": 1,
          "text": "よみました。",
          "start_ms": 248226,
          "end_ms": 249839,
          "duration_ms": 1613
        }
      ]
    },
    {
      "index": 70,
      "text": "「シチロウエモン」。",
      "start_ms": 250339,
      "end_ms": 251903,
      "duration_ms": 1564,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 250339,
          "end_ms": 251903,
          "duration_ms": 1564
        }
      ]
    },
    {
      "index": 71,
      "text": "はい、シチロウエモンです。",
      "start_ms": 252403,
      "end_ms": 255331,
      "duration_ms": 2928,
      "clauses": [
        {
          "index": 0,
          "text": "はい、",
          "start_ms": 252403,
          "end_ms": 252948,
          "duration_ms": 545
        },
        {
          "index": 1,
          "text": "シチロウエモンです。",
          "start_ms": 253198,
          "end_ms": 255331,
          "duration_ms": 2133
        }
      ]
    },
    {
      "index": 72,
      "text": "「ついにきます。",
      "start_ms": 255831,
      "end_ms": 257630,
      "duration_ms": 1799,
      "clauses": [
        {
          "index": 0,
          "text": "「ついにきます。",
          "start_ms": 255831,
          "end_ms": 257630,
          "duration_ms": 1799
        }
      ]
    },
    {
      "index": 73,
      "text": "もう、まちません」。",
      "start_ms": 258130,
      "end_ms": 260771,
      "duration_ms": 2641,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 258130,
          "end_ms": 258931,
          "duration_ms": 801
        },
        {
          "index": 1,
          "text": "まちません」。",
          "start_ms": 259181,
          "end_ms": 260771,
          "duration_ms": 1590
        }
      ]
    },
    {
      "index": 74,
      "text": "そのよる、カツノはおきていました。",
      "start_ms": 261271,
      "end_ms": 265572,
      "duration_ms": 4301,
      "clauses": [
        {
          "index": 0,
          "text": "そのよる、",
          "start_ms": 261271,
          "end_ms": 262838,
          "duration_ms": 1567
        },
        {
          "index": 1,
          "text": "カツノはおきていました。",
          "start_ms": 263088,
          "end_ms": 265572,
          "duration_ms": 2484
        }
      ]
    },
    {
      "index": 75,
      "text": "ちいさなかたなをもちました。",
      "start_ms": 266072,
      "end_ms": 268870,
      "duration_ms": 2798,
      "clauses": [
        {
          "index": 0,
          "text": "ちいさなかたなをもちました。",
          "start_ms": 266072,
          "end_ms": 268870,
          "duration_ms": 2798
        }
      ]
    },
    {
      "index": 76,
      "text": "「ハチヤ。",
      "start_ms": 269370,
      "end_ms": 270751,
      "duration_ms": 1381,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤ。",
          "start_ms": 269370,
          "end_ms": 270751,
          "duration_ms": 1381
        }
      ]
    },
    {
      "index": 77,
      "text": "あした、あいます。",
      "start_ms": 271251,
      "end_ms": 274194,
      "duration_ms": 2943,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 271251,
          "end_ms": 272493,
          "duration_ms": 1242
        },
        {
          "index": 1,
          "text": "あいます。",
          "start_ms": 272743,
          "end_ms": 274194,
          "duration_ms": 1451
        }
      ]
    },
    {
      "index": 78,
      "text": "あした、ころします。",
      "start_ms": 274694,
      "end_ms": 277730,
      "duration_ms": 3036,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 274694,
          "end_ms": 275936,
          "duration_ms": 1242
        },
        {
          "index": 1,
          "text": "ころします。",
          "start_ms": 276186,
          "end_ms": 277730,
          "duration_ms": 1544
        }
      ]
    },
    {
      "index": 79,
      "text": "もう、まってください」。",
      "start_ms": 278230,
      "end_ms": 281092,
      "duration_ms": 2862,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 278230,
          "end_ms": 279031,
          "duration_ms": 801
        },
        {
          "index": 1,
          "text": "まってください」。",
          "start_ms": 279281,
          "end_ms": 281092,
          "duration_ms": 1811
        }
      ]
    }
  ]
}