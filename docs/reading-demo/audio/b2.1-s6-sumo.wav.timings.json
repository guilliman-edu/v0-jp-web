          "start_ms": 0,
          "end_ms": 2383,
          "duration_ms": 2383
        }
      ]
    },
    {
      "index": 1,
      "text": "すもうはにほんのふるいぶんかです。",
      "start_ms": 2883,
      "end_ms": 6009,
      "duration_ms": 3126,
      "clauses": [
        {
          "index": 0,
          "text": "すもうはにほんのふるいぶんかです。",
          "start_ms": 2883,
          "end_ms": 6009,
          "duration_ms": 3126
        }
      ]
    },
    {
      "index": 2,
      "text": "二人のりきしがどひょうの上で組み合い、相手をどひょうの外に出すか、足の裏以外の体をじめんにたおすと勝ちます。",
      "start_ms": 6509,
      "end_ms": 17281,
      "duration_ms": 10772,
      "clauses": [
        {
          "index": 0,
          "text": "二人のりきしがどひょうの上で組み合い、",
          "start_ms": 6509,
          "end_ms": 9960,
          "duration_ms": 3451
        },
        {
          "index": 1,
          "text": "相手をどひょうの外に出すか、",
          "start_ms": 10210,
          "end_ms": 12953,
          "duration_ms": 2743
        },
        {
          "index": 2,
          "text": "足の裏以外の体をじめんにたおすと勝ちます。",
          "start_ms": 13203,
          "end_ms": 17281,
          "duration_ms": 4078
        }
      ]
    },
    {
      "index": 3,
      "text": "どひょう際では、体がまだどひょうの中にあっても、相手につかまらなければ倒れることがはっきりしている場合があります。",
      "start_ms": 17781,
      "end_ms": 28472,
      "duration_ms": 10691,
      "clauses": [
        {
          "index": 0,
          "text": "どひょう際では、",
          "start_ms": 17781,
          "end_ms": 19537,
          "duration_ms": 1756
        },
        {
          "index": 1,
          "text": "体がまだどひょうの中にあっても、",
          "start_ms": 19787,
          "end_ms": 22878,
          "duration_ms": 3091
        },
        {
          "index": 2,
          "text": "相手につかまらなければ倒れることがはっきりしている場合があります。",
          "start_ms": 23128,
          "end_ms": 28472,
          "duration_ms": 5344
        }
      ]
    },
    {
      "index": 4,
      "text": "その時、しんぱんは「しにたい」として負けを言い渡します。",
      "start_ms": 28972,
      "end_ms": 34383,
      "duration_ms": 5411,
      "clauses": [
        {
          "index": 0,
          "text": "その時、",
          "start_ms": 28972,
          "end_ms": 30450,
          "duration_ms": 1478
        },
        {
          "index": 1,
          "text": "しんぱんは「しにたい」として負けを言い渡します。",
          "start_ms": 30700,
          "end_ms": 34383,
          "duration_ms": 3683
        }
      ]
    },
    {
      "index": 5,
      "text": "次の行為は、はんそくとして、すぐに負けになります。",
      "start_ms": 34883,
      "end_ms": 41011,
      "duration_ms": 6128,
      "clauses": [
        {
          "index": 0,
          "text": "次の行為は、",
          "start_ms": 34883,
          "end_ms": 36616,
          "duration_ms": 1733
        },
        {
          "index": 1,
          "text": "はんそくとして、",
          "start_ms": 36866,
          "end_ms": 38587,
          "duration_ms": 1721
        },
        {
          "index": 2,
          "text": "すぐに負けになります。",
          "start_ms": 38837,
          "end_ms": 41011,
          "duration_ms": 2174
        }
      ]
    },
    {
      "index": 6,
      "text": "こぶしでなぐる、目やみぞおちをつく、胸や腹をける。",
      "start_ms": 41511,
      "end_ms": 47569,
      "duration_ms": 6058,
      "clauses": [
        {
          "index": 0,
          "text": "こぶしでなぐる、",
          "start_ms": 41511,
          "end_ms": 43267,
          "duration_ms": 1756
        },
        {
          "index": 1,
          "text": "目やみぞおちをつく、",
          "start_ms": 43517,
          "end_ms": 45482,
          "duration_ms": 1965
        },
        {
          "index": 2,
          "text": "胸や腹をける。",
          "start_ms": 45732,
          "end_ms": 47569,
          "duration_ms": 1837
        }
      ]
    },
