          "text": "しんわの時代です。",
          "start_ms": 76435,
          "end_ms": 78505,
          "duration_ms": 2070
        }
      ]
    },
    {
      "index": 12,
      "text": "昔のほんには、かみさま同士の力くらべが書かれています。",
      "start_ms": 79005,
      "end_ms": 84776,
      "duration_ms": 5771,
