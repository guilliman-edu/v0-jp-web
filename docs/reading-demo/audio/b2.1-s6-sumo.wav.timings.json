          "start_ms": 56439,
          "end_ms": 59507,
          "duration_ms": 3068
        }
      ]
    },
    {
      "index": 9,
      "text": "この制限じかんは、せんきゅうひゃくにじゅうはち年に始まったラジオほうそうに備えて決まりました。",
      "start_ms": 60007,
      "end_ms": 67868,
      "duration_ms": 7861,
      "clauses": [
        {
          "index": 0,
          "text": "この制限じかんは、",
          "start_ms": 60007,
