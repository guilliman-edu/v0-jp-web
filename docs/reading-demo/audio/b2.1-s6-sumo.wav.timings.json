          "end_ms": 73604,
          "duration_ms": 2882
        }
      ]
    },
    {
      "index": 11,
      "text": "すもうの始まりは、しんわの時代です。",
      "start_ms": 74104,
      "end_ms": 78505,
      "duration_ms": 4401,
      "clauses": [
        {
          "index": 0,
          "text": "すもうの始まりは、",
