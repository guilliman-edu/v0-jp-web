          "start_ms": 51550,
          "end_ms": 53329,
          "duration_ms": 1779
        }
      ]
    },
    {
      "index": 8,
      "text": "立ち合いの前の準備は、かいきゅうごとにじかんが決まっています。",
      "start_ms": 53829,
      "end_ms": 59507,
      "duration_ms": 5678,
      "clauses": [
        {
