      "start_ms": 24720,
      "end_ms": 27708,
      "duration_ms": 2988
    },
    {
      "index": 9,
      "text": "十二じにひるごはんをたべます。",
      "start_ms": 28208,
      "end_ms": 31614,
      "duration_ms": 3406
    },
    {
      "index": 10,
      "text": "ともだちといっしょにたべます。",
