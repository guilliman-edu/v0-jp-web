      "index": 42,
      "text": "あかちゃんのなまえはラプンツェルになりました。",
      "start_ms": 213921,
      "end_ms": 218150,
      "duration_ms": 4229,
      "clauses": [
        {
          "index": 0,
          "text": "あかちゃんのなまえはラプンツェルになりました。",
          "start_ms": 213921,
          "end_ms": 218150,
          "duration_ms": 4229
        }
      ]
    },
    {
      "index": 43,
      "text": "むじょはラプンツェルを連れて行きました。",
      "start_ms": 218650,
      "end_ms": 222299,
      "duration_ms": 3649,
      "clauses": [
        {
          "index": 0,
          "text": "むじょはラプンツェルを連れて行きました。",
          "start_ms": 218650,
          "end_ms": 222299,
          "duration_ms": 3649
        }
      ]
    },
    {
      "index": 44,
      "text": "ラプンツェルは大きくなって、すごくかわいいおんなのこになりました。",
      "start_ms": 222799,
      "end_ms": 229812,
      "duration_ms": 7013,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルは大きくなって、",
