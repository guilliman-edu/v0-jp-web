      "start_ms": 434920,
      "end_ms": 439019,
      "duration_ms": 4099,
      "clauses": [
        {
          "index": 0,
          "text": "「おばさん、",
          "start_ms": 434920,
          "end_ms": 436305,
          "duration_ms": 1385
        },
        {
          "index": 1,
          "text": "あなたはおもいです。",
          "start_ms": 436555,
          "end_ms": 439019,
          "duration_ms": 2464
        }
      ]
    },
    {
      "index": 82,
      "text": "だから、うえにのぼるとき、かみがすごくおもかったです」。",
      "start_ms": 439519,
      "end_ms": 446762,
      "duration_ms": 7243,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 439519,
          "end_ms": 440834,
          "duration_ms": 1315
        },
        {
          "index": 1,
          "text": "うえにのぼるとき、",
          "start_ms": 441084,
          "end_ms": 443432,
          "duration_ms": 2348
        },
        {
          "index": 2,
          "text": "かみがすごくおもかったです」。",
          "start_ms": 443682,
          "end_ms": 446762,
          "duration_ms": 3080
        }
      ]
    },
    {
      "index": 83,
      "text": "まじょは「あなたはおうじとはなしたのでしょう。",
      "start_ms": 447262,
      "end_ms": 451631,
      "duration_ms": 4369,
      "clauses": [
        {
          "index": 0,
          "text": "まじょは「あなたはおうじとはなしたのでしょう。",
          "start_ms": 447262,
          "end_ms": 451631,
          "duration_ms": 4369
        }
      ]
    },
    {
      "index": 84,
      "text": "わるいこですね」とおこりました。",
      "start_ms": 452131,
      "end_ms": 455315,
      "duration_ms": 3184,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこですね」とおこりました。",
          "start_ms": 452131,
          "end_ms": 455315,
          "duration_ms": 3184
        }
      ]
    },
    {
      "index": 85,
      "text": "まじょはラプンツェルのながいかみをきりました。",
      "start_ms": 455815,
      "end_ms": 460067,
      "duration_ms": 4252,
      "clauses": [
        {
          "index": 0,
          "text": "まじょはラプンツェルのながいかみをきりました。",
          "start_ms": 455815,
          "end_ms": 460067,
          "duration_ms": 4252
        }
      ]
    },
    {
      "index": 86,
      "text": "そして、ラプンツェルをとおいやまにつれていきました。",
      "start_ms": 460567,
      "end_ms": 466408,
      "duration_ms": 5841,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 460567,
          "end_ms": 462045,
          "duration_ms": 1478
        },
        {
          "index": 1,
          "text": "ラプンツェルをとおいやまにつれていきました。",
          "start_ms": 462295,
          "end_ms": 466408,
          "duration_ms": 4113
        }
      ]
    },
    {
      "index": 87,
      "text": "ラプンツェルはそこでひとりでせいかつしました。",
      "start_ms": 466908,
      "end_ms": 471311,
      "duration_ms": 4403,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはそこでひとりでせいかつしました。",
          "start_ms": 466908,
          "end_ms": 471311,
          "duration_ms": 4403
        }
      ]
    },
    {
      "index": 88,
      "text": "すごくかなしかったです。",
      "start_ms": 471811,
      "end_ms": 474589,
      "duration_ms": 2778,
      "clauses": [
        {
          "index": 0,
          "text": "すごくかなしかったです。",
          "start_ms": 471811,
          "end_ms": 474589,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 89,
      "text": "そのひ、まじょはきったかみをまどのそばにおくきました。",
      "start_ms": 475089,
      "end_ms": 481394,
      "duration_ms": 6305,
      "clauses": [
        {
          "index": 0,
          "text": "そのひ、",
          "start_ms": 475089,
          "end_ms": 476671,
          "duration_ms": 1582
        },
        {
          "index": 1,
          "text": "まじょはきったかみをまどのそばにおくきました。",
          "start_ms": 476921,
          "end_ms": 481394,
          "duration_ms": 4473
        }
      ]
    },
    {
      "index": 90,
      "text": "よる、おうじがきました。",
      "start_ms": 481894,
      "end_ms": 485355,
      "duration_ms": 3461,
      "clauses": [
        {
          "index": 0,
          "text": "よる、",
          "start_ms": 481894,
          "end_ms": 482838,
          "duration_ms": 944
        },
        {
          "index": 1,
          "text": "おうじがきました。",
          "start_ms": 483088,
          "end_ms": 485355,
          "duration_ms": 2267
        }
      ]
    },
    {
      "index": 91,
      "text": "「ラプンツェル、かみをおろしてください」といいました。",
      "start_ms": 485855,
      "end_ms": 491394,
      "duration_ms": 5539,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 485855,
          "end_ms": 487669,
          "duration_ms": 1814
        },
        {
          "index": 1,
          "text": "かみをおろしてください」といいました。",
          "start_ms": 487919,
          "end_ms": 491394,
          "duration_ms": 3475
        }
      ]
    },
    {
      "index": 92,
      "text": "かみをおろしたので、おうじはうえにのぼりました。",
      "start_ms": 491894,
      "end_ms": 497875,
      "duration_ms": 5981,
      "clauses": [
        {
          "index": 0,
          "text": "かみをおろしたので、",
          "start_ms": 491894,
          "end_ms": 494208,
          "duration_ms": 2314
        },
        {
          "index": 1,
          "text": "おうじはうえにのぼりました。",
          "start_ms": 494458,
          "end_ms": 497875,
          "duration_ms": 3417
        }
      ]
    },
    {
      "index": 93,
      "text": "でも、そこにはまじょがいました。",
      "start_ms": 498375,
      "end_ms": 502788,
      "duration_ms": 4413,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 498375,
          "end_ms": 499458,
          "duration_ms": 1083
        },
        {
          "index": 1,
          "text": "そこにはまじょがいました。",
          "start_ms": 499708,
          "end_ms": 502788,
          "duration_ms": 3080
        }
      ]
    },
    {
      "index": 94,
      "text": "「もうラプンツェルはここにいません。",
      "start_ms": 503288,
      "end_ms": 506716,
      "duration_ms": 3428,
      "clauses": [
        {
          "index": 0,
          "text": "「もうラプンツェルはここにいません。",
          "start_ms": 503288,
          "end_ms": 506716,
          "duration_ms": 3428
        }
      ]
    },
    {
      "index": 95,
      "text": "あなたはもうラプンツェルにあいません」といいました。",
      "start_ms": 507216,
      "end_ms": 511735,
      "duration_ms": 4519,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうラプンツェルにあいません」といいました。",
          "start_ms": 507216,
          "end_ms": 511735,
          "duration_ms": 4519
        }
      ]
    },
    {
      "index": 96,
      "text": "おうじはすごくかなしくて、とうのうえからおちました。",
      "start_ms": 512235,
      "end_ms": 518400,
      "duration_ms": 6165,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはすごくかなしくて、",
          "start_ms": 512235,
          "end_ms": 515326,
          "duration_ms": 3091
        },
        {
          "index": 1,
          "text": "とうのうえからおちました。",
          "start_ms": 515576,
          "end_ms": 518400,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 97,
      "text": "おうじはたすかりました。",
      "start_ms": 518900,
      "end_ms": 521690,
      "duration_ms": 2790,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはたすかりました。",
          "start_ms": 518900,
          "end_ms": 521690,
          "duration_ms": 2790
        }
      ]
    },
    {
      "index": 98,
      "text": "でも、おうじのめは、もうなにもみることができなくなりました。",
      "start_ms": 522190,
      "end_ms": 529491,
      "duration_ms": 7301,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 522190,
          "end_ms": 523238,
          "duration_ms": 1048
        },
        {
          "index": 1,
          "text": "おうじのめは、",
          "start_ms": 523488,
          "end_ms": 525407,
          "duration_ms": 1919
        },
        {
          "index": 2,
          "text": "もうなにもみることができなくなりました。",
          "start_ms": 525657,
          "end_ms": 529491,
          "duration_ms": 3834
        }
      ]
    },
    {
      "index": 99,
      "text": "おうじはまいにち、やまのなかをあるきました。",
      "start_ms": 529991,
      "end_ms": 535704,
      "duration_ms": 5713,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはまいにち、",
          "start_ms": 529991,
          "end_ms": 532351,
          "duration_ms": 2360
        },
        {
          "index": 1,
          "text": "やまのなかをあるきました。",
          "start_ms": 532601,
          "end_ms": 535704,
          "duration_ms": 3103
        }
      ]
    },
    {
      "index": 100,
      "text": "ラプンツェルのことを、いつもおもいでしていました。",
      "start_ms": 536204,
      "end_ms": 541836,
      "duration_ms": 5632,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルのことを、",
          "start_ms": 536204,
          "end_ms": 538692,
          "duration_ms": 2488
        },
        {
          "index": 1,
          "text": "いつもおもいでしていました。",
          "start_ms": 538942,
          "end_ms": 541836,
          "duration_ms": 2894
        }
      ]
    },
    {
      "index": 101,
      "text": "ながいじかんがたちました。",
      "start_ms": 542336,
      "end_ms": 545207,
      "duration_ms": 2871,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんがたちました。",
          "start_ms": 542336,
          "end_ms": 545207,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 102,
      "text": "あるひ、おうじはとおいやまでうたがきこえました。",
      "start_ms": 545707,
      "end_ms": 551467,
      "duration_ms": 5760,
      "clauses": [
        {
          "index": 0,
          "text": "あるひ、",
          "start_ms": 545707,
          "end_ms": 547185,
          "duration_ms": 1478
        },
        {
          "index": 1,
          "text": "おうじはとおいやまでうたがきこえました。",
          "start_ms": 547435,
          "end_ms": 551467,
          "duration_ms": 4032
        }
      ]
    },
    {
      "index": 103,
      "text": "それはラプンツェルのうたでした。",
      "start_ms": 551967,
      "end_ms": 555453,
      "duration_ms": 3486,
      "clauses": [
        {
          "index": 0,
          "text": "それはラプンツェルのうたでした。",
          "start_ms": 551967,
          "end_ms": 555453,
          "duration_ms": 3486
        }
      ]
    },
    {
      "index": 104,
      "text": "おうじはうたのばしょにいきました。",
      "start_ms": 555953,
      "end_ms": 559718,
      "duration_ms": 3765,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはうたのばしょにいきました。",
          "start_ms": 555953,
          "end_ms": 559718,
          "duration_ms": 3765
        }
      ]
    },
    {
      "index": 105,
      "text": "ラプンツェルには、おとこのことおんなのこのあかちゃんがいました。",
      "start_ms": 560218,
      "end_ms": 567068,
      "duration_ms": 6850,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルには、",
          "start_ms": 560218,
          "end_ms": 562415,
          "duration_ms": 2197
        },
        {
          "index": 1,
          "text": "おとこのことおんなのこのあかちゃんがいました。",
          "start_ms": 562665,
          "end_ms": 567068,
          "duration_ms": 4403
        }
      ]
    },
    {
      "index": 106,
      "text": "ラプンツェルはおうじのなまえをいいました。",
      "start_ms": 567568,
      "end_ms": 571820,
      "duration_ms": 4252,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはおうじのなまえをいいました。",
          "start_ms": 567568,
          "end_ms": 571820,
          "duration_ms": 4252
        }
      ]
    },
    {
      "index": 107,
      "text": "ラプンツェルがおうじのかおにさわったとき、おうじのめはなおりました。",
      "start_ms": 572320,
      "end_ms": 579716,
      "duration_ms": 7396,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルがおうじのかおにさわったとき、",
          "start_ms": 572320,
          "end_ms": 576642,
          "duration_ms": 4322
        },
        {
          "index": 1,
          "text": "おうじのめはなおりました。",
          "start_ms": 576892,
          "end_ms": 579716,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 108,
      "text": "ふたりはすごくうれしかったです。",
      "start_ms": 580216,
      "end_ms": 583656,
      "duration_ms": 3440,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはすごくうれしかったです。",
          "start_ms": 580216,
          "end_ms": 583656,
          "duration_ms": 3440
        }
      ]
    },
    {
      "index": 109,
      "text": "ふたりはおうじのくににかえりました。",
      "start_ms": 584156,
      "end_ms": 588130,
      "duration_ms": 3974,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはおうじのくににかえりました。",
          "start_ms": 584156,
          "end_ms": 588130,
          "duration_ms": 3974
        }
      ]
    },
    {
      "index": 110,
      "text": "ふたりはなかよく、すごくたのしくすみました。",
      "start_ms": 588630,
      "end_ms": 594377,
      "duration_ms": 5747,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなかよく、",
          "start_ms": 588630,
          "end_ms": 591036,
          "duration_ms": 2406
        },
        {
          "index": 1,
          "text": "すごくたのしくすみました。",
          "start_ms": 591286,
          "end_ms": 594377,
          "duration_ms": 3091
        }
      ]
    }
  ]
}