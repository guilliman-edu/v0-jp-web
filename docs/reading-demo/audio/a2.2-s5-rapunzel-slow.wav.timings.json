          "end_ms": 225948,
          "duration_ms": 3149
        },
        {
          "index": 1,
          "text": "すごくかわいいおんなのこになりました。",
          "start_ms": 226198,
          "end_ms": 229812,
          "duration_ms": 3614
        }
      ]
    },
    {
      "index": 45,
      "text": "12歳になったとき、むじょはラプンツェルをたかいとうに入れました。",
