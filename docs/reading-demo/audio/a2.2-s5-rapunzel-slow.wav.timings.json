        {
          "index": 0,
          "text": "「おばさん、",
          "start_ms": 434126,
          "end_ms": 435499,
          "duration_ms": 1373
        },
        {
          "index": 1,
          "text": "あなたはおもいです。",
          "start_ms": 435749,
          "end_ms": 438144,
          "duration_ms": 2395
        }
      ]
    },
    {
      "index": 82,
      "text": "だから、うえにのぼるとき、かみがすごくおもかったです」。",
      "start_ms": 438644,
      "end_ms": 445795,
      "duration_ms": 7151,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 438644,
          "end_ms": 439878,
          "duration_ms": 1234
        },
        {
          "index": 1,
          "text": "うえにのぼるとき、",
          "start_ms": 440128,
          "end_ms": 442442,
          "duration_ms": 2314
        },
        {
          "index": 2,
          "text": "かみがすごくおもかったです」。",
          "start_ms": 442692,
          "end_ms": 445795,
          "duration_ms": 3103
        }
      ]
    },
    {
      "index": 83,
      "text": "まじょは「あなたはおうじとはなしたのでしょう。",
      "start_ms": 446295,
      "end_ms": 450698,
      "duration_ms": 4403,
      "clauses": [
        {
          "index": 0,
          "text": "まじょは「あなたはおうじとはなしたのでしょう。",
          "start_ms": 446295,
          "end_ms": 450698,
          "duration_ms": 4403
        }
      ]
    },
    {
      "index": 84,
      "text": "わるいこですね」とおこりました。",
      "start_ms": 451198,
      "end_ms": 454347,
      "duration_ms": 3149,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこですね」とおこりました。",
          "start_ms": 451198,
          "end_ms": 454347,
          "duration_ms": 3149
        }
      ]
    },
    {
      "index": 85,
      "text": "まじょはラプンツェルのながいかみをきりました。",
      "start_ms": 454847,
      "end_ms": 459041,
      "duration_ms": 4194,
      "clauses": [
        {
          "index": 0,
          "text": "まじょはラプンツェルのながいかみをきりました。",
          "start_ms": 454847,
          "end_ms": 459041,
          "duration_ms": 4194
        }
      ]
    },
    {
      "index": 86,
      "text": "そして、ラプンツェルをとおいやまにつれていきました。",
      "start_ms": 459541,
      "end_ms": 465277,
      "duration_ms": 5736,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 459541,
          "end_ms": 461053,
          "duration_ms": 1512
        },
        {
          "index": 1,
          "text": "ラプンツェルをとおいやまにつれていきました。",
          "start_ms": 461303,
          "end_ms": 465277,
          "duration_ms": 3974
        }
      ]
    },
    {
      "index": 87,
      "text": "ラプンツェルはそこでひとりでせいかつしました。",
      "start_ms": 465777,
      "end_ms": 470169,
      "duration_ms": 4392,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはそこでひとりでせいかつしました。",
          "start_ms": 465777,
          "end_ms": 470169,
          "duration_ms": 4392
        }
      ]
    },
    {
      "index": 88,
      "text": "すごくかなしかったです。",
      "start_ms": 470669,
      "end_ms": 473470,
      "duration_ms": 2801,
      "clauses": [
        {
          "index": 0,
          "text": "すごくかなしかったです。",
          "start_ms": 470669,
          "end_ms": 473470,
          "duration_ms": 2801
        }
      ]
    },
    {
      "index": 89,
      "text": "そのひ、まじょはきったかみをまどのそばにおくきました。",
      "start_ms": 473970,
      "end_ms": 480263,
      "duration_ms": 6293,
      "clauses": [
        {
          "index": 0,
          "text": "そのひ、",
          "start_ms": 473970,
          "end_ms": 475552,
          "duration_ms": 1582
        },
        {
          "index": 1,
          "text": "まじょはきったかみをまどのそばにおくきました。",
          "start_ms": 475802,
          "end_ms": 480263,
          "duration_ms": 4461
        }
      ]
    },
    {
      "index": 90,
      "text": "よる、おうじがきました。",
      "start_ms": 480763,
      "end_ms": 484351,
      "duration_ms": 3588,
      "clauses": [
        {
          "index": 0,
          "text": "よる、",
          "start_ms": 480763,
          "end_ms": 481811,
          "duration_ms": 1048
        },
        {
          "index": 1,
          "text": "おうじがきました。",
          "start_ms": 482061,
          "end_ms": 484351,
          "duration_ms": 2290
        }
      ]
    },
    {
      "index": 91,
      "text": "「ラプンツェル、かみをおろしてください」といいました。",
      "start_ms": 484851,
      "end_ms": 490482,
      "duration_ms": 5631,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 484851,
          "end_ms": 486781,
          "duration_ms": 1930
        },
        {
          "index": 1,
          "text": "かみをおろしてください」といいました。",
          "start_ms": 487031,
          "end_ms": 490482,
          "duration_ms": 3451
        }
      ]
    },
    {
      "index": 92,
      "text": "かみをおろしたので、おうじはうえにのぼりました。",
      "start_ms": 490982,
      "end_ms": 496915,
      "duration_ms": 5933,
      "clauses": [
        {
          "index": 0,
          "text": "かみをおろしたので、",
          "start_ms": 490982,
          "end_ms": 493307,
          "duration_ms": 2325
        },
        {
          "index": 1,
          "text": "おうじはうえにのぼりました。",
          "start_ms": 493557,
          "end_ms": 496915,
          "duration_ms": 3358
        }
      ]
    },
    {
      "index": 93,
      "text": "でも、そこにはまじょがいました。",
      "start_ms": 497415,
      "end_ms": 501886,
      "duration_ms": 4471,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 497415,
          "end_ms": 498510,
          "duration_ms": 1095
        },
        {
          "index": 1,
          "text": "そこにはまじょがいました。",
          "start_ms": 498760,
          "end_ms": 501886,
          "duration_ms": 3126
        }
      ]
    },
    {
      "index": 94,
      "text": "「もうラプンツェルはここにいません。",
      "start_ms": 502386,
      "end_ms": 505826,
      "duration_ms": 3440,
      "clauses": [
        {
          "index": 0,
          "text": "「もうラプンツェルはここにいません。",
          "start_ms": 502386,
          "end_ms": 505826,
          "duration_ms": 3440
        }
      ]
    },
    {
      "index": 95,
      "text": "あなたはもうラプンツェルにあいません」といいました。",
      "start_ms": 506326,
      "end_ms": 510799,
      "duration_ms": 4473,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうラプンツェルにあいません」といいました。",
          "start_ms": 506326,
          "end_ms": 510799,
          "duration_ms": 4473
        }
      ]
    },
    {
      "index": 96,
      "text": "おうじはすごくかなしくて、とうのうえからおちました。",
      "start_ms": 511299,
      "end_ms": 517418,
      "duration_ms": 6119,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはすごくかなしくて、",
          "start_ms": 511299,
          "end_ms": 514367,
          "duration_ms": 3068
        },
        {
          "index": 1,
          "text": "とうのうえからおちました。",
          "start_ms": 514617,
          "end_ms": 517418,
          "duration_ms": 2801
        }
      ]
    },
    {
      "index": 97,
      "text": "おうじはたすかりました。",
      "start_ms": 517918,
      "end_ms": 520708,
      "duration_ms": 2790,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはたすかりました。",
          "start_ms": 517918,
          "end_ms": 520708,
          "duration_ms": 2790
        }
      ]
    },
    {
      "index": 98,
      "text": "でも、おうじのめは、もうなにもみることができなくなりました。",
      "start_ms": 521208,
      "end_ms": 528555,
      "duration_ms": 7347,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 521208,
          "end_ms": 522314,
          "duration_ms": 1106
        },
        {
          "index": 1,
          "text": "おうじのめは、",
          "start_ms": 522564,
          "end_ms": 524471,
          "duration_ms": 1907
        },
        {
          "index": 2,
          "text": "もうなにもみることができなくなりました。",
          "start_ms": 524721,
          "end_ms": 528555,
          "duration_ms": 3834
        }
      ]
    },
    {
      "index": 99,
      "text": "おうじはまいにち、やまのなかをあるきました。",
      "start_ms": 529055,
      "end_ms": 534838,
      "duration_ms": 5783,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはまいにち、",
          "start_ms": 529055,
          "end_ms": 531450,
          "duration_ms": 2395
        },
        {
          "index": 1,
          "text": "やまのなかをあるきました。",
          "start_ms": 531700,
          "end_ms": 534838,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 100,
      "text": "ラプンツェルのことを、いつもおもいでしていました。",
      "start_ms": 535338,
      "end_ms": 541016,
      "duration_ms": 5678,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルのことを、",
          "start_ms": 535338,
          "end_ms": 537849,
          "duration_ms": 2511
        },
        {
          "index": 1,
          "text": "いつもおもいでしていました。",
          "start_ms": 538099,
          "end_ms": 541016,
          "duration_ms": 2917
        }
      ]
    },
    {
      "index": 101,
      "text": "ながいじかんがたちました。",
      "start_ms": 541516,
      "end_ms": 544387,
      "duration_ms": 2871,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんがたちました。",
          "start_ms": 541516,
          "end_ms": 544387,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 102,
      "text": "あるひ、おうじはとおいやまでうたがきこえました。",
      "start_ms": 544887,
      "end_ms": 550681,
      "duration_ms": 5794,
      "clauses": [
        {
          "index": 0,
          "text": "あるひ、",
          "start_ms": 544887,
          "end_ms": 546388,
          "duration_ms": 1501
        },
        {
          "index": 1,
          "text": "おうじはとおいやまでうたがきこえました。",
          "start_ms": 546638,
          "end_ms": 550681,
          "duration_ms": 4043
        }
      ]
    },
    {
      "index": 103,
      "text": "それはラプンツェルのうたでした。",
      "start_ms": 551181,
      "end_ms": 554748,
      "duration_ms": 3567,
      "clauses": [
        {
          "index": 0,
          "text": "それはラプンツェルのうたでした。",
          "start_ms": 551181,
          "end_ms": 554748,
          "duration_ms": 3567
        }
      ]
    },
    {
      "index": 104,
      "text": "おうじはうたのばしょにいきました。",
      "start_ms": 555248,
      "end_ms": 558990,
      "duration_ms": 3742,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはうたのばしょにいきました。",
          "start_ms": 555248,
          "end_ms": 558990,
          "duration_ms": 3742
        }
      ]
    },
    {
      "index": 105,
      "text": "ラプンツェルには、おとこのことおんなのこのあかちゃんがいました。",
      "start_ms": 559490,
      "end_ms": 566341,
      "duration_ms": 6851,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルには、",
          "start_ms": 559490,
          "end_ms": 561664,
          "duration_ms": 2174
        },
        {
          "index": 1,
          "text": "おとこのことおんなのこのあかちゃんがいました。",
          "start_ms": 561914,
          "end_ms": 566341,
          "duration_ms": 4427
        }
      ]
    },
    {
      "index": 106,
      "text": "ラプンツェルはおうじのなまえをいいました。",
      "start_ms": 566841,
      "end_ms": 571070,
      "duration_ms": 4229,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはおうじのなまえをいいました。",
          "start_ms": 566841,
          "end_ms": 571070,
          "duration_ms": 4229
        }
      ]
    },
    {
      "index": 107,
      "text": "ラプンツェルがおうじのかおにさわったとき、おうじのめはなおりました。",
      "start_ms": 571570,
      "end_ms": 578920,
      "duration_ms": 7350,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルがおうじのかおにさわったとき、",
          "start_ms": 571570,
          "end_ms": 575846,
          "duration_ms": 4276
        },
        {
          "index": 1,
          "text": "おうじのめはなおりました。",
          "start_ms": 576096,
          "end_ms": 578920,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 108,
      "text": "ふたりはすごくうれしかったです。",
      "start_ms": 579420,
      "end_ms": 582871,
      "duration_ms": 3451,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはすごくうれしかったです。",
          "start_ms": 579420,
          "end_ms": 582871,
          "duration_ms": 3451
        }
      ]
    },
    {
      "index": 109,
      "text": "ふたりはおうじのくににかえりました。",
      "start_ms": 583371,
      "end_ms": 587345,
      "duration_ms": 3974,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはおうじのくににかえりました。",
          "start_ms": 583371,
          "end_ms": 587345,
          "duration_ms": 3974
        }
      ]
    },
    {
      "index": 110,
      "text": "ふたりはなかよく、すごくたのしくすみました。",
      "start_ms": 587845,
      "end_ms": 593581,
      "duration_ms": 5736,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなかよく、",
          "start_ms": 587845,
          "end_ms": 590205,
          "duration_ms": 2360
        },
        {
          "index": 1,
          "text": "すごくたのしくすみました。",
          "start_ms": 590455,
          "end_ms": 593581,
          "duration_ms": 3126
        }
      ]
    }
  ]
