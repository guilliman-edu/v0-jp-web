          "end_ms": 247925,
          "duration_ms": 1884
        },
        {
          "index": 1,
          "text": "かみを下ろしてください」と言いました。",
          "start_ms": 248175,
          "end_ms": 251835,
          "duration_ms": 3660
        }
      ]
    },
    {
      "index": 49,
      "text": "ラプンツェルはとてもながいかみをしていました。",
      "start_ms": 252335,
      "end_ms": 256831,
      "duration_ms": 4496,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはとてもながいかみをしていました。",
          "start_ms": 252335,
          "end_ms": 256831,
          "duration_ms": 4496
        }
      ]
    },
    {
      "index": 50,
      "text": "ラプンツェルはまどからかみを下ろしました。",
      "start_ms": 257331,
      "end_ms": 261746,
      "duration_ms": 4415,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはまどからかみを下ろしました。",
          "start_ms": 257331,
          "end_ms": 261746,
          "duration_ms": 4415
        }
      ]
    },
    {
      "index": 51,
      "text": "むじょはそのかみを持って、上に登りました。",
      "start_ms": 262246,
      "end_ms": 267820,
      "duration_ms": 5574,
      "clauses": [
        {
          "index": 0,
          "text": "むじょはそのかみを持って、",
          "start_ms": 262246,
          "end_ms": 265152,
          "duration_ms": 2906
        },
        {
          "index": 1,
          "text": "上に登りました。",
          "start_ms": 265402,
          "end_ms": 267820,
          "duration_ms": 2418
        }
      ]
    },
    {
      "index": 52,
      "text": "時間がたちました。",
      "start_ms": 268320,
      "end_ms": 270761,
      "duration_ms": 2441,
      "clauses": [
        {
          "index": 0,
          "text": "時間がたちました。",
          "start_ms": 268320,
          "end_ms": 270761,
          "duration_ms": 2441
        }
      ]
    },
    {
      "index": 53,
      "text": "ある日のゆうがた、おうじがやまの近くを歩いていました。",
      "start_ms": 271261,
      "end_ms": 277821,
      "duration_ms": 6560,
      "clauses": [
        {
          "index": 0,
          "text": "ある日のゆうがた、",
          "start_ms": 271261,
          "end_ms": 273586,
          "duration_ms": 2325
        },
        {
          "index": 1,
          "text": "おうじがやまの近くを歩いていました。",
          "start_ms": 273836,
          "end_ms": 277821,
          "duration_ms": 3985
        }
      ]
    },
    {
      "index": 54,
      "text": "そのとき、とうからすてきなうたが聞こえました。",
      "start_ms": 278321,
      "end_ms": 283907,
      "duration_ms": 5586,
      "clauses": [
        {
          "index": 0,
          "text": "そのとき、",
          "start_ms": 278321,
          "end_ms": 280066,
          "duration_ms": 1745
        },
        {
          "index": 1,
          "text": "とうからすてきなうたが聞こえました。",
          "start_ms": 280316,
          "end_ms": 283907,
          "duration_ms": 3591
        }
      ]
    },
    {
      "index": 55,
      "text": "おうじは立って、うたを聞きました。",
      "start_ms": 284407,
      "end_ms": 288948,
      "duration_ms": 4541,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは立って、",
          "start_ms": 284407,
          "end_ms": 286454,
          "duration_ms": 2047
        },
        {
          "index": 1,
          "text": "うたを聞きました。",
          "start_ms": 286704,
          "end_ms": 288948,
          "duration_ms": 2244
        }
      ]
    },
    {
      "index": 56,
      "text": "それはラプンツェルのうたでした。",
      "start_ms": 289448,
      "end_ms": 292853,
      "duration_ms": 3405,
      "clauses": [
        {
          "index": 0,
          "text": "それはラプンツェルのうたでした。",
          "start_ms": 289448,
          "end_ms": 292853,
          "duration_ms": 3405
        }
      ]
    },
    {
      "index": 57,
      "text": "ラプンツェルは一人でした。",
      "start_ms": 293353,
      "end_ms": 296352,
      "duration_ms": 2999,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルは一人でした。",
          "start_ms": 293353,
          "end_ms": 296352,
          "duration_ms": 2999
        }
      ]
    },
    {
      "index": 58,
      "text": "毎日、一人でうたをうたっていました。",
      "start_ms": 296852,
      "end_ms": 302147,
      "duration_ms": 5295,
      "clauses": [
        {
          "index": 0,
          "text": "毎日、",
          "start_ms": 296852,
          "end_ms": 298655,
          "duration_ms": 1803
        },
        {
          "index": 1,
          "text": "一人でうたをうたっていました。",
          "start_ms": 298905,
          "end_ms": 302147,
          "duration_ms": 3242
        }
      ]
    },
    {
      "index": 59,
      "text": "おうじはまいばん、やまへ行って、うたを聞きました。",
      "start_ms": 302647,
      "end_ms": 309496,
      "duration_ms": 6849,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはまいばん、",
          "start_ms": 302647,
          "end_ms": 304856,
          "duration_ms": 2209
        },
        {
          "index": 1,
          "text": "やまへ行って、",
          "start_ms": 305106,
          "end_ms": 306967,
          "duration_ms": 1861
        },
        {
          "index": 2,
          "text": "うたを聞きました。",
          "start_ms": 307217,
          "end_ms": 309496,
          "duration_ms": 2279
        }
      ]
    },
    {
      "index": 60,
      "text": "とうの下を探しましたが、上に行くみちはありませんでした。",
      "start_ms": 309996,
      "end_ms": 316545,
      "duration_ms": 6549,
      "clauses": [
        {
          "index": 0,
          "text": "とうの下を探しましたが、",
          "start_ms": 309996,
          "end_ms": 312925,
          "duration_ms": 2929
        },
        {
          "index": 1,
          "text": "上に行くみちはありませんでした。",
          "start_ms": 313175,
          "end_ms": 316545,
          "duration_ms": 3370
        }
      ]
    },
    {
      "index": 61,
      "text": "あるよる、おうじはやまで待っていました。",
      "start_ms": 317045,
      "end_ms": 322108,
      "duration_ms": 5063,
      "clauses": [
        {
          "index": 0,
          "text": "あるよる、",
          "start_ms": 317045,
          "end_ms": 318685,
          "duration_ms": 1640
        },
        {
          "index": 1,
          "text": "おうじはやまで待っていました。",
          "start_ms": 318935,
          "end_ms": 322108,
          "duration_ms": 3173
        }
      ]
    },
    {
      "index": 62,
      "text": "むじょが来て、「ラプンツェル、かみを下ろしてください」と言いました。",
      "start_ms": 322608,
      "end_ms": 330408,
      "duration_ms": 7800,
      "clauses": [
        {
          "index": 0,
          "text": "むじょが来て、",
          "start_ms": 322608,
          "end_ms": 324399,
          "duration_ms": 1791
        },
        {
          "index": 1,
          "text": "「ラプンツェル、",
          "start_ms": 324649,
          "end_ms": 326521,
          "duration_ms": 1872
        },
        {
          "index": 2,
          "text": "かみを下ろしてください」と言いました。",
          "start_ms": 326771,
          "end_ms": 330408,
          "duration_ms": 3637
        }
      ]
    },
    {
      "index": 63,
      "text": "そして、ラプンツェルはまどからかみを下ろしました。",
      "start_ms": 330908,
      "end_ms": 337074,
      "duration_ms": 6166,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 330908,
          "end_ms": 332432,
          "duration_ms": 1524
        },
        {
          "index": 1,
          "text": "ラプンツェルはまどからかみを下ろしました。",
          "start_ms": 332682,
          "end_ms": 337074,
          "duration_ms": 4392
        }
      ]
    },
    {
      "index": 64,
      "text": "むじょはそのかみを持って、上に登りました。",
      "start_ms": 337574,
      "end_ms": 343125,
      "duration_ms": 5551,
      "clauses": [
        {
          "index": 0,
          "text": "むじょはそのかみを持って、",
          "start_ms": 337574,
          "end_ms": 340503,
          "duration_ms": 2929
        },
        {
          "index": 1,
          "text": "上に登りました。",
          "start_ms": 340753,
          "end_ms": 343125,
          "duration_ms": 2372
        }
      ]
    },
    {
      "index": 65,
      "text": "おうじは「僕もあのかみで上に登りたい」と思いました。",
      "start_ms": 343625,
      "end_ms": 349201,
      "duration_ms": 5576,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは「僕もあのかみで上に登りたい」と思いました。",
          "start_ms": 343625,
          "end_ms": 349201,
          "duration_ms": 5576
        }
      ]
    },
    {
      "index": 66,
      "text": "次の日、よるになったとき、おうじはとうの下に行きました。",
      "start_ms": 349701,
      "end_ms": 357780,
      "duration_ms": 8079,
      "clauses": [
        {
          "index": 0,
          "text": "次の日、",
          "start_ms": 349701,
          "end_ms": 351573,
          "duration_ms": 1872
        },
        {
          "index": 1,
          "text": "よるになったとき、",
          "start_ms": 351823,
          "end_ms": 354032,
          "duration_ms": 2209
        },
        {
          "index": 2,
          "text": "おうじはとうの下に行きました。",
          "start_ms": 354282,
          "end_ms": 357780,
          "duration_ms": 3498
        }
      ]
    },
    {
      "index": 67,
      "text": "「ラプンツェル、かみを下ろしてください」と言いました。",
      "start_ms": 358280,
      "end_ms": 364120,
      "duration_ms": 5840,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 358280,
          "end_ms": 360210,
          "duration_ms": 1930
        },
        {
          "index": 1,
          "text": "かみを下ろしてください」と言いました。",
          "start_ms": 360460,
          "end_ms": 364120,
          "duration_ms": 3660
        }
      ]
    },
    {
      "index": 68,
      "text": "かみを下ろしたので、おうじは上に登りました。",
      "start_ms": 364620,
      "end_ms": 370809,
      "duration_ms": 6189,
      "clauses": [
        {
          "index": 0,
          "text": "かみを下ろしたので、",
          "start_ms": 364620,
          "end_ms": 367154,
          "duration_ms": 2534
        },
        {
          "index": 1,
          "text": "おうじは上に登りました。",
          "start_ms": 367404,
          "end_ms": 370809,
          "duration_ms": 3405
        }
      ]
    },
    {
      "index": 69,
      "text": "ラプンツェルは初めて人が来たので、とても怖がりました。",
      "start_ms": 371309,
      "end_ms": 378172,
      "duration_ms": 6863,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルは初めて人が来たので、",
          "start_ms": 371309,
          "end_ms": 375341,
          "duration_ms": 4032
        },
        {
          "index": 1,
          "text": "とても怖がりました。",
          "start_ms": 375591,
          "end_ms": 378172,
          "duration_ms": 2581
        }
      ]
    },
    {
      "index": 70,
      "text": "でも、おうじはとても若くて、かっこいい人でした。",
      "start_ms": 378672,
      "end_ms": 385404,
      "duration_ms": 6732,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 378672,
          "end_ms": 379743,
          "duration_ms": 1071
        },
        {
          "index": 1,
          "text": "おうじはとても若くて、",
          "start_ms": 379993,
          "end_ms": 382806,
          "duration_ms": 2813
        },
        {
          "index": 2,
          "text": "かっこいい人でした。",
          "start_ms": 383056,
          "end_ms": 385404,
          "duration_ms": 2348
        }
      ]
    },
    {
      "index": 71,
      "text": "二人はよく話しました。",
      "start_ms": 385904,
      "end_ms": 389274,
      "duration_ms": 3370,
      "clauses": [
        {
          "index": 0,
          "text": "二人はよく話しました。",
          "start_ms": 385904,
          "end_ms": 389274,
          "duration_ms": 3370
        }
      ]
    },
    {
      "index": 72,
      "text": "ラプンツェルは怖くなくなりました。",
      "start_ms": 389774,
      "end_ms": 393655,
      "duration_ms": 3881,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルは怖くなくなりました。",
          "start_ms": 389774,
          "end_ms": 393655,
          "duration_ms": 3881
        }
      ]
    },
    {
      "index": 73,
      "text": "おうじは「僕と一緒に住んでください」と言いました。",
      "start_ms": 394155,
      "end_ms": 399139,
      "duration_ms": 4984,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは「僕と一緒に住んでください」と言いました。",
          "start_ms": 394155,
          "end_ms": 399139,
          "duration_ms": 4984
        }
      ]
    },
    {
      "index": 74,
      "text": "ラプンツェルは「はい。",
      "start_ms": 399639,
      "end_ms": 401848,
      "duration_ms": 2209,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルは「はい。",
          "start_ms": 399639,
          "end_ms": 401848,
          "duration_ms": 2209
        }
      ]
    },
    {
      "index": 75,
      "text": "でも、とうをでることができません」と言いました。",
      "start_ms": 402348,
      "end_ms": 407423,
      "duration_ms": 5075,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 402348,
          "end_ms": 403443,
          "duration_ms": 1095
        },
        {
          "index": 1,
          "text": "とうをでることができません」と言いました。",
          "start_ms": 403693,
          "end_ms": 407423,
          "duration_ms": 3730
        }
      ]
    },
    {
      "index": 76,
      "text": "おうじは「まいばん、僕がとうに登ります。",
      "start_ms": 407923,
      "end_ms": 413148,
      "duration_ms": 5225,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは「まいばん、",
          "start_ms": 407923,
          "end_ms": 410132,
          "duration_ms": 2209
        },
        {
          "index": 1,
          "text": "僕がとうに登ります。",
          "start_ms": 410382,
          "end_ms": 413148,
          "duration_ms": 2766
        }
      ]
    },
    {
      "index": 77,
      "text": "むじょは朝に来るから、よるに会いましょう」と言いました。",
      "start_ms": 413648,
      "end_ms": 419755,
      "duration_ms": 6107,
      "clauses": [
        {
          "index": 0,
          "text": "むじょは朝に来るから、",
          "start_ms": 413648,
          "end_ms": 416263,
          "duration_ms": 2615
        },
        {
          "index": 1,
          "text": "よるに会いましょう」と言いました。",
          "start_ms": 416513,
          "end_ms": 419755,
          "duration_ms": 3242
        }
      ]
    },
    {
      "index": 78,
      "text": "それから、おうじはまいばんラプンツェルに会いました。",
      "start_ms": 420255,
      "end_ms": 426362,
      "duration_ms": 6107,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 420255,
          "end_ms": 422011,
          "duration_ms": 1756
        },
        {
          "index": 1,
          "text": "おうじはまいばんラプンツェルに会いました。",
          "start_ms": 422261,
          "end_ms": 426362,
          "duration_ms": 4101
        }
      ]
    },
    {
      "index": 79,
      "text": "むじょは何も気がつきませんでした。",
      "start_ms": 426862,
      "end_ms": 430499,
      "duration_ms": 3637,
      "clauses": [
        {
          "index": 0,
          "text": "むじょは何も気がつきませんでした。",
          "start_ms": 426862,
          "end_ms": 430499,
          "duration_ms": 3637
        }
      ]
    },
    {
      "index": 80,
      "text": "ある日、ラプンツェルはむじょに言いました。",
      "start_ms": 430999,
      "end_ms": 436410,
      "duration_ms": 5411,
      "clauses": [
        {
          "index": 0,
          "text": "ある日、",
          "start_ms": 430999,
          "end_ms": 432755,
          "duration_ms": 1756
        },
        {
          "index": 1,
          "text": "ラプンツェルはむじょに言いました。",
          "start_ms": 433005,
          "end_ms": 436410,
          "duration_ms": 3405
        }
      ]
    },
    {
      "index": 81,
      "text": "「おばさん、あなたはおもいです。",
      "start_ms": 436910,
      "end_ms": 441009,
      "duration_ms": 4099,
      "clauses": [
        {
          "index": 0,
          "text": "「おばさん、",
          "start_ms": 436910,
          "end_ms": 438283,
          "duration_ms": 1373
        },
        {
          "index": 1,
          "text": "あなたはおもいです。",
          "start_ms": 438533,
          "end_ms": 441009,
          "duration_ms": 2476
        }
      ]
    },
    {
      "index": 82,
      "text": "だから、上にのぼるとき、かみがすごく重かったです」。",
      "start_ms": 441509,
      "end_ms": 448637,
      "duration_ms": 7128,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 441509,
          "end_ms": 442801,
          "duration_ms": 1292
        },
        {
          "index": 1,
          "text": "上にのぼるとき、",
          "start_ms": 443051,
          "end_ms": 445365,
          "duration_ms": 2314
        },
        {
          "index": 2,
          "text": "かみがすごく重かったです」。",
          "start_ms": 445615,
          "end_ms": 448637,
          "duration_ms": 3022
        }
      ]
    },
    {
      "index": 83,
      "text": "むじょは「あなたはおうじと話したのでしょう。",
      "start_ms": 449137,
      "end_ms": 453494,
      "duration_ms": 4357,
      "clauses": [
        {
          "index": 0,
          "text": "むじょは「あなたはおうじと話したのでしょう。",
          "start_ms": 449137,
          "end_ms": 453494,
          "duration_ms": 4357
        }
      ]
    },
    {
      "index": 84,
      "text": "悪い子ですね」と怒りました。",
      "start_ms": 453994,
      "end_ms": 457155,
      "duration_ms": 3161,
      "clauses": [
        {
          "index": 0,
          "text": "悪い子ですね」と怒りました。",
          "start_ms": 453994,
          "end_ms": 457155,
          "duration_ms": 3161
        }
      ]
    },
    {
      "index": 85,
      "text": "むじょはラプンツェルのながいかみを切りました。",
      "start_ms": 457655,
      "end_ms": 461849,
      "duration_ms": 4194,
      "clauses": [
        {
          "index": 0,
          "text": "むじょはラプンツェルのながいかみを切りました。",
          "start_ms": 457655,
          "end_ms": 461849,
          "duration_ms": 4194
        }
      ]
    },
    {
      "index": 86,
      "text": "そして、ラプンツェルをとおいやまに連れて行きました。",
      "start_ms": 462349,
      "end_ms": 468202,
      "duration_ms": 5853,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 462349,
          "end_ms": 463885,
          "duration_ms": 1536
        },
        {
          "index": 1,
          "text": "ラプンツェルをとおいやまに連れて行きました。",
          "start_ms": 464135,
          "end_ms": 468202,
          "duration_ms": 4067
        }
      ]
    },
    {
      "index": 87,
      "text": "ラプンツェルはそこで一人で生活しました。",
      "start_ms": 468702,
      "end_ms": 473105,
      "duration_ms": 4403,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはそこで一人で生活しました。",
          "start_ms": 468702,
          "end_ms": 473105,
          "duration_ms": 4403
        }
      ]
    },
    {
      "index": 88,
      "text": "すごく悲しかったです。",
      "start_ms": 473605,
      "end_ms": 476383,
      "duration_ms": 2778,
      "clauses": [
        {
          "index": 0,
          "text": "すごく悲しかったです。",
          "start_ms": 473605,
          "end_ms": 476383,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 89,
      "text": "その日、むじょは切ったかみをまどの側に置きました。",
      "start_ms": 476883,
      "end_ms": 483002,
      "duration_ms": 6119,
      "clauses": [
        {
          "index": 0,
          "text": "その日、",
          "start_ms": 476883,
          "end_ms": 478558,
          "duration_ms": 1675
        },
        {
          "index": 1,
          "text": "むじょは切ったかみをまどの側に置きました。",
          "start_ms": 478808,
          "end_ms": 483002,
          "duration_ms": 4194
        }
      ]
    },
    {
      "index": 90,
      "text": "よる、おうじが来ました。",
      "start_ms": 483502,
      "end_ms": 487032,
      "duration_ms": 3530,
      "clauses": [
        {
          "index": 0,
          "text": "よる、",
          "start_ms": 483502,
          "end_ms": 484515,
          "duration_ms": 1013
        },
        {
          "index": 1,
          "text": "おうじが来ました。",
          "start_ms": 484765,
          "end_ms": 487032,
          "duration_ms": 2267
        }
      ]
    },
    {
      "index": 91,
      "text": "「ラプンツェル、かみを下ろしてください」と言いました。",
      "start_ms": 487532,
      "end_ms": 493326,
      "duration_ms": 5794,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 487532,
          "end_ms": 489381,
          "duration_ms": 1849
        },
        {
          "index": 1,
          "text": "かみを下ろしてください」と言いました。",
          "start_ms": 489631,
          "end_ms": 493326,
          "duration_ms": 3695
        }
      ]
    },
    {
      "index": 92,
      "text": "かみを下ろしたので、おうじは上に登りました。",
      "start_ms": 493826,
      "end_ms": 500027,
      "duration_ms": 6201,
      "clauses": [
        {
          "index": 0,
          "text": "かみを下ろしたので、",
          "start_ms": 493826,
          "end_ms": 496360,
          "duration_ms": 2534
        },
        {
          "index": 1,
          "text": "おうじは上に登りました。",
          "start_ms": 496610,
          "end_ms": 500027,
          "duration_ms": 3417
        }
      ]
    },
    {
      "index": 93,
      "text": "でも、そこにはむじょがいました。",
      "start_ms": 500527,
      "end_ms": 504940,
      "duration_ms": 4413,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 500527,
          "end_ms": 501610,
          "duration_ms": 1083
        },
        {
          "index": 1,
          "text": "そこにはむじょがいました。",
          "start_ms": 501860,
          "end_ms": 504940,
          "duration_ms": 3080
        }
      ]
    },
    {
      "index": 94,
      "text": "「もうラプンツェルはここにいません。",
      "start_ms": 505440,
      "end_ms": 508810,
      "duration_ms": 3370,
      "clauses": [
        {
          "index": 0,
          "text": "「もうラプンツェルはここにいません。",
          "start_ms": 505440,
          "end_ms": 508810,
          "duration_ms": 3370
        }
      ]
    },
    {
      "index": 95,
      "text": "あなたはもうラプンツェルに会いません」と言いました。",
      "start_ms": 509310,
      "end_ms": 513818,
      "duration_ms": 4508,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうラプンツェルに会いません」と言いました。",
          "start_ms": 509310,
          "end_ms": 513818,
          "duration_ms": 4508
        }
      ]
    },
    {
      "index": 96,
      "text": "おうじはすごく悲しくて、とうの上から落ちました。",
      "start_ms": 514318,
      "end_ms": 520472,
      "duration_ms": 6154,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはすごく悲しくて、",
          "start_ms": 514318,
          "end_ms": 517398,
          "duration_ms": 3080
        },
        {
          "index": 1,
          "text": "とうの上から落ちました。",
          "start_ms": 517648,
          "end_ms": 520472,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 97,
      "text": "おうじは助かりました。",
      "start_ms": 520972,
      "end_ms": 523785,
      "duration_ms": 2813,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは助かりました。",
          "start_ms": 520972,
          "end_ms": 523785,
          "duration_ms": 2813
        }
      ]
    },
    {
      "index": 98,
      "text": "でも、おうじのめは、もう何も見ることができなくなりました。",
      "start_ms": 524285,
      "end_ms": 531656,
      "duration_ms": 7371,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 524285,
          "end_ms": 525368,
          "duration_ms": 1083
        },
        {
          "index": 1,
          "text": "おうじのめは、",
          "start_ms": 525618,
          "end_ms": 527548,
          "duration_ms": 1930
        },
        {
          "index": 2,
          "text": "もう何も見ることができなくなりました。",
          "start_ms": 527798,
          "end_ms": 531656,
          "duration_ms": 3858
        }
      ]
    },
    {
      "index": 99,
      "text": "おうじは毎日、やまの中を歩きました。",
      "start_ms": 532156,
      "end_ms": 537927,
      "duration_ms": 5771,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは毎日、",
          "start_ms": 532156,
          "end_ms": 534562,
          "duration_ms": 2406
        },
        {
          "index": 1,
          "text": "やまの中を歩きました。",
          "start_ms": 534812,
          "end_ms": 537927,
          "duration_ms": 3115
        }
      ]
    },
    {
      "index": 100,
      "text": "ラプンツェルのことを、いつもおもいでしていました。",
      "start_ms": 538427,
      "end_ms": 544024,
      "duration_ms": 5597,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルのことを、",
          "start_ms": 538427,
          "end_ms": 540903,
          "duration_ms": 2476
        },
        {
          "index": 1,
          "text": "いつもおもいでしていました。",
          "start_ms": 541153,
          "end_ms": 544024,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 101,
      "text": "ながい時間がたちました。",
      "start_ms": 544524,
      "end_ms": 547360,
      "duration_ms": 2836,
      "clauses": [
        {
          "index": 0,
          "text": "ながい時間がたちました。",
          "start_ms": 544524,
          "end_ms": 547360,
          "duration_ms": 2836
        }
      ]
    },
    {
      "index": 102,
      "text": "ある日、おうじはとおいやまでうたが聞こえました。",
      "start_ms": 547860,
      "end_ms": 553991,
      "duration_ms": 6131,
      "clauses": [
        {
          "index": 0,
          "text": "ある日、",
          "start_ms": 547860,
          "end_ms": 549674,
          "duration_ms": 1814
        },
        {
          "index": 1,
          "text": "おうじはとおいやまでうたが聞こえました。",
          "start_ms": 549924,
          "end_ms": 553991,
          "duration_ms": 4067
        }
      ]
    },
    {
      "index": 103,
      "text": "それはラプンツェルのうたでした。",
      "start_ms": 554491,
      "end_ms": 558000,
      "duration_ms": 3509,
      "clauses": [
        {
          "index": 0,
          "text": "それはラプンツェルのうたでした。",
          "start_ms": 554491,
          "end_ms": 558000,
          "duration_ms": 3509
        }
      ]
    },
    {
      "index": 104,
      "text": "おうじはうたのばしょに行きました。",
      "start_ms": 558500,
      "end_ms": 562172,
      "duration_ms": 3672,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはうたのばしょに行きました。",
          "start_ms": 558500,
          "end_ms": 562172,
          "duration_ms": 3672
        }
      ]
    },
    {
      "index": 105,
      "text": "ラプンツェルには、おとこのことおんなのこのあかちゃんがいました。",
      "start_ms": 562672,
      "end_ms": 569534,
      "duration_ms": 6862,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルには、",
          "start_ms": 562672,
          "end_ms": 564811,
          "duration_ms": 2139
        },
        {
          "index": 1,
          "text": "おとこのことおんなのこのあかちゃんがいました。",
          "start_ms": 565061,
          "end_ms": 569534,
          "duration_ms": 4473
        }
      ]
    },
    {
      "index": 106,
      "text": "ラプンツェルはおうじのなまえを言いました。",
      "start_ms": 570034,
      "end_ms": 574275,
      "duration_ms": 4241,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはおうじのなまえを言いました。",
          "start_ms": 570034,
          "end_ms": 574275,
          "duration_ms": 4241
        }
      ]
    },
    {
      "index": 107,
      "text": "ラプンツェルがおうじのかおに触ったとき、おうじのめはなおりました。",
      "start_ms": 574775,
      "end_ms": 582160,
      "duration_ms": 7385,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルがおうじのかおに触ったとき、",
          "start_ms": 574775,
          "end_ms": 579120,
          "duration_ms": 4345
        },
        {
          "index": 1,
          "text": "おうじのめはなおりました。",
          "start_ms": 579370,
          "end_ms": 582160,
          "duration_ms": 2790
        }
      ]
    },
    {
      "index": 108,
      "text": "二人はすごく嬉しかったです。",
      "start_ms": 582660,
      "end_ms": 586007,
      "duration_ms": 3347,
      "clauses": [
        {
          "index": 0,
          "text": "二人はすごく嬉しかったです。",
          "start_ms": 582660,
          "end_ms": 586007,
          "duration_ms": 3347
        }
      ]
    },
    {
      "index": 109,
      "text": "二人はおうじのくにに帰りました。",
      "start_ms": 586507,
      "end_ms": 590458,
      "duration_ms": 3951,
      "clauses": [
        {
          "index": 0,
          "text": "二人はおうじのくにに帰りました。",
          "start_ms": 586507,
          "end_ms": 590458,
          "duration_ms": 3951
        }
      ]
    },
    {
      "index": 110,
      "text": "二人は仲よく、すごく楽しく住みました。",
      "start_ms": 590958,
      "end_ms": 596589,
      "duration_ms": 5631,
      "clauses": [
        {
          "index": 0,
          "text": "二人は仲よく、",
          "start_ms": 590958,
          "end_ms": 593306,
          "duration_ms": 2348
        },
        {
          "index": 1,
          "text": "すごく楽しく住みました。",
          "start_ms": 593556,
          "end_ms": 596589,
          "duration_ms": 3033
        }
      ]
    }
  ]
}