          "start_ms": 242183,
          "end_ms": 245541,
          "duration_ms": 3358
        }
      ]
    },
    {
      "index": 48,
      "text": "「ラプンツェル、かみを下ろしてください」と言いました。",
      "start_ms": 246041,
      "end_ms": 251835,
      "duration_ms": 5794,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
