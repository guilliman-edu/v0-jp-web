  "sentences": [
    {
      "index": 0,
      "text": "「おにぎり」のなまえとれきし ― にほんのおにぎりから世界へ",
      "start_ms": 0,
      "end_ms": 4478,
      "duration_ms": 4478,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」のなまえとれきし ― にほんのおにぎりから世界へ",
          "start_ms": 0,
          "end_ms": 4478,
          "duration_ms": 4478
        }
      ]
    },
    {
      "index": 1,
      "text": "にほんではにせんにじゅうご年、きおんが高くてこめが買えなくなり、こめの値段も高くなりました。",
      "start_ms": 4978,
      "end_ms": 15117,
      "duration_ms": 10139,
      "clauses": [
        {
          "index": 0,
          "text": "にほんではにせんにじゅうご年、",
          "start_ms": 4978,
          "end_ms": 8121,
          "duration_ms": 3143
        },
        {
          "index": 1,
          "text": "きおんが高くてこめが買えなくなり、",
          "start_ms": 8371,
          "end_ms": 11805,
          "duration_ms": 3434
        },
        {
          "index": 2,
          "text": "こめの値段も高くなりました。",
          "start_ms": 12055,
          "end_ms": 15117,
          "duration_ms": 3062
        }
      ]
    },
    {
      "index": 2,
      "text": "いつも買えると思ってきたのに買えなくなると、にほんでは長いあいだ、こめがせいかつの中でとても大切なものだと、みんなが気がつきました。",
      "start_ms": 15617,
      "end_ms": 29962,
      "duration_ms": 14345,
      "clauses": [
        {
          "index": 0,
          "text": "いつも買えると思ってきたのに買えなくなると、",
          "start_ms": 15617,
          "end_ms": 19747,
          "duration_ms": 4130
        },
        {
          "index": 1,
          "text": "にほんでは長いあいだ、",
          "start_ms": 19997,
          "end_ms": 22409,
          "duration_ms": 2412
        },
        {
          "index": 2,
          "text": "こめがせいかつの中でとても大切なものだと、",
          "start_ms": 22659,
          "end_ms": 27265,
          "duration_ms": 4606
        },
        {
          "index": 3,
          "text": "みんなが気がつきました。",
          "start_ms": 27515,
          "end_ms": 29962,
          "duration_ms": 2447
        }
      ]
    },
    {
      "index": 3,
      "text": "そこで、みんなが知っている毎日のたべもの「おにぎり」にちゅうもくする人が出ました。",
      "start_ms": 30462,
      "end_ms": 37742,
      "duration_ms": 7280,
      "clauses": [
        {
          "index": 0,
          "text": "そこで、",
          "start_ms": 30462,
          "end_ms": 31690,
          "duration_ms": 1228
        },
        {
          "index": 1,
          "text": "みんなが知っている毎日のたべもの「おにぎり」にちゅうもくする人が出ました。",
          "start_ms": 31940,
          "end_ms": 37742,
          "duration_ms": 5802
        }
      ]
    },
    {
      "index": 4,
      "text": "そのれきしを見てみましょう。",
      "start_ms": 38242,
      "end_ms": 41014,
      "duration_ms": 2772,
      "clauses": [
        {
          "index": 0,
          "text": "そのれきしを見てみましょう。",
          "start_ms": 38242,
          "end_ms": 41014,
          "duration_ms": 2772
        }
      ]
    },
    {
      "index": 5,
      "text": "おにぎりは、いつからあったのか、はっきりしていません。",
      "start_ms": 41514,
      "end_ms": 48030,
      "duration_ms": 6516,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 41514,
          "end_ms": 43113,
          "duration_ms": 1599
        },
        {
          "index": 1,
          "text": "いつからあったのか、",
          "start_ms": 43363,
          "end_ms": 45612,
          "duration_ms": 2249
        },
        {
          "index": 2,
          "text": "はっきりしていません。",
          "start_ms": 45862,
          "end_ms": 48030,
          "duration_ms": 2168
        }
      ]
    },
    {
      "index": 6,
      "text": "にほんでこめを作るようになってから、人は作ったこめを手でまとめていたと考えられています。",
      "start_ms": 48530,
      "end_ms": 57505,
      "duration_ms": 8975,
      "clauses": [
        {
          "index": 0,
          "text": "にほんでこめを作るようになってから、",
          "start_ms": 48530,
          "end_ms": 51859,
          "duration_ms": 3329
        },
        {
          "index": 1,
          "text": "人は作ったこめを手でまとめていたと考えられています。",
          "start_ms": 52109,
          "end_ms": 57505,
          "duration_ms": 5396
        }
      ]
    },
    {
      "index": 7,
      "text": "にほんのあるばしょでは、にせん年前のこめが出たこともあります。",
      "start_ms": 58005,
      "end_ms": 64147,
      "duration_ms": 6142,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのあるばしょでは、",
          "start_ms": 58005,
          "end_ms": 60324,
          "duration_ms": 2319
        },
        {
          "index": 1,
          "text": "にせん年前のこめが出たこともあります。",
          "start_ms": 60574,
          "end_ms": 64147,
          "duration_ms": 3573
        }
      ]
    },
    {
      "index": 8,
      "text": "手で作ったのではなく、ほかのしゅだんで作られたと考えられているものもあります。",
      "start_ms": 64647,
      "end_ms": 72368,
      "duration_ms": 7721,
      "clauses": [
        {
          "index": 0,
          "text": "手で作ったのではなく、",
          "start_ms": 64647,
          "end_ms": 67082,
          "duration_ms": 2435
        },
        {
          "index": 1,
          "text": "ほかのしゅだんで作られたと考えられているものもあります。",
          "start_ms": 67332,
          "end_ms": 72368,
          "duration_ms": 5036
        }
      ]
    },
    {
      "index": 9,
      "text": "そして、それを「むかしのおにぎりのしょうこ」と言っています。",
      "start_ms": 72868,
      "end_ms": 78568,
      "duration_ms": 5700,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 72868,
          "end_ms": 74258,
          "duration_ms": 1390
        },
        {
          "index": 1,
          "text": "それを「むかしのおにぎりのしょうこ」と言っています。",
          "start_ms": 74508,
          "end_ms": 78568,
          "duration_ms": 4060
        }
      ]
    },
    {
      "index": 10,
      "text": "このこめについては、人によって違う説明をしています。",
      "start_ms": 79068,
      "end_ms": 85187,
      "duration_ms": 6119,
      "clauses": [
        {
          "index": 0,
          "text": "このこめについては、",
          "start_ms": 79068,
          "end_ms": 81341,
          "duration_ms": 2273
        },
        {
          "index": 1,
          "text": "人によって違う説明をしています。",
          "start_ms": 81591,
          "end_ms": 85187,
          "duration_ms": 3596
        }
      ]
    },
    {
      "index": 11,
      "text": "大切なのは、こめを手でまとめて持ちやすくすることを、にほんではとてもむかしからやっていることです。",
      "start_ms": 85687,
      "end_ms": 95768,
      "duration_ms": 10081,
      "clauses": [
        {
          "index": 0,
          "text": "大切なのは、",
          "start_ms": 85687,
          "end_ms": 87553,
          "duration_ms": 1866
        },
        {
          "index": 1,
          "text": "こめを手でまとめて持ちやすくすることを、",
          "start_ms": 87803,
          "end_ms": 91376,
          "duration_ms": 3573
        },
        {
          "index": 2,
          "text": "にほんではとてもむかしからやっていることです。",
          "start_ms": 91626,
          "end_ms": 95768,
          "duration_ms": 4142
        }
      ]
    },
    {
      "index": 12,
      "text": "むかしの本には、にほんごで「にぎりいい」と書かれたことばが出ています。",
      "start_ms": 96268,
      "end_ms": 102642,
      "duration_ms": 6374,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 96268,
          "end_ms": 98308,
          "duration_ms": 2040
        },
        {
          "index": 1,
          "text": "にほんごで「にぎりいい」と書かれたことばが出ています。",
          "start_ms": 98558,
          "end_ms": 102642,
          "duration_ms": 4084
        }
      ]
    },
    {
      "index": 13,
      "text": "人はたべものを持って会い、こめをみんなで食べていました。",
      "start_ms": 103142,
      "end_ms": 109435,
      "duration_ms": 6293,
      "clauses": [
        {
          "index": 0,
          "text": "人はたべものを持って会い、",
          "start_ms": 103142,
          "end_ms": 106320,
          "duration_ms": 3178
        },
        {
          "index": 1,
          "text": "こめをみんなで食べていました。",
          "start_ms": 106570,
          "end_ms": 109435,
          "duration_ms": 2865
        }
      ]
    },
    {
      "index": 14,
      "text": "その使い方は、とてもみじかなものでした。",
      "start_ms": 109935,
      "end_ms": 115008,
      "duration_ms": 5073,
      "clauses": [
        {
          "index": 0,
          "text": "その使い方は、",
          "start_ms": 109935,
          "end_ms": 112033,
          "duration_ms": 2098
        },
        {
          "index": 1,
          "text": "とてもみじかなものでした。",
          "start_ms": 112283,
          "end_ms": 115008,
          "duration_ms": 2725
        }
      ]
    },
    {
      "index": 15,
      "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
      "start_ms": 115508,
      "end_ms": 120822,
      "duration_ms": 5314,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
          "start_ms": 115508,
          "end_ms": 120822,
          "duration_ms": 5314
        }
      ]
    },
    {
      "index": 16,
      "text": "にほんではむかし、「にぎりいい」と言っていました。",
      "start_ms": 121322,
      "end_ms": 126210,
      "duration_ms": 4888,
      "clauses": [
        {
          "index": 0,
          "text": "にほんではむかし、",
          "start_ms": 121322,
          "end_ms": 123455,
          "duration_ms": 2133
        },
        {
          "index": 1,
          "text": "「にぎりいい」と言っていました。",
          "start_ms": 123705,
          "end_ms": 126210,
          "duration_ms": 2505
        }
      ]
    },
    {
      "index": 17,
      "text": "「にぎりいい」が使われているうちに、「にぎりめし」というなまえに変わりました。",
      "start_ms": 126710,
      "end_ms": 133362,
      "duration_ms": 6652,
      "clauses": [
        {
          "index": 0,
          "text": "「にぎりいい」が使われているうちに、",
          "start_ms": 126710,
          "end_ms": 129702,
          "duration_ms": 2992
        },
        {
          "index": 1,
          "text": "「にぎりめし」というなまえに変わりました。",
          "start_ms": 129952,
          "end_ms": 133362,
          "duration_ms": 3410
        }
      ]
    },
    {
      "index": 18,
      "text": "さらに、けいごの「お」を付けたなまえが「おにぎり」です。",
      "start_ms": 133862,
      "end_ms": 138843,
      "duration_ms": 4981,
      "clauses": [
        {
          "index": 0,
          "text": "さらに、",
          "start_ms": 133862,
          "end_ms": 135183,
          "duration_ms": 1321
        },
        {
          "index": 1,
          "text": "けいごの「お」を付けたなまえが「おにぎり」です。",
          "start_ms": 135433,
          "end_ms": 138843,
          "duration_ms": 3410
        }
      ]
    },
    {
      "index": 19,
      "text": "「おにぎり」をせつめいすることばは、「おむすび」もあります。",
      "start_ms": 139343,
      "end_ms": 144602,
      "duration_ms": 5259,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」をせつめいすることばは、",
          "start_ms": 139343,
          "end_ms": 142184,
          "duration_ms": 2841
        },
        {
          "index": 1,
          "text": "「おむすび」もあります。",
          "start_ms": 142434,
          "end_ms": 144602,
          "duration_ms": 2168
        }
      ]
    },
    {
      "index": 20,
      "text": "「むすび」というなまえをみんなが使い始めたのは、えどじだいです。",
      "start_ms": 145102,
      "end_ms": 151569,
      "duration_ms": 6467,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」というなまえをみんなが使い始めたのは、",
          "start_ms": 145102,
          "end_ms": 149395,
          "duration_ms": 4293
        },
        {
          "index": 1,
          "text": "えどじだいです。",
          "start_ms": 149645,
          "end_ms": 151569,
          "duration_ms": 1924
        }
      ]
    },
    {
      "index": 21,
      "text": "そこにもけいごの「お」を付けました。",
      "start_ms": 152069,
      "end_ms": 155143,
      "duration_ms": 3074,
      "clauses": [
        {
          "index": 0,
          "text": "そこにもけいごの「お」を付けました。",
          "start_ms": 152069,
          "end_ms": 155143,
          "duration_ms": 3074
        }
      ]
    },
    {
      "index": 22,
      "text": "むかしの本には、「むすび」を「にぎりいい」の別のなまえと書いて、「もとは女のことばです」とも書かれています。",
      "start_ms": 155643,
      "end_ms": 165909,
      "duration_ms": 10266,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 155643,
          "end_ms": 157718,
          "duration_ms": 2075
        },
        {
          "index": 1,
          "text": "「むすび」を「にぎりいい」の別のなまえと書いて、",
          "start_ms": 157968,
          "end_ms": 161587,
          "duration_ms": 3619
        },
        {
          "index": 2,
          "text": "「もとは女のことばです」とも書かれています。",
          "start_ms": 161837,
          "end_ms": 165909,
          "duration_ms": 4072
        }
      ]
    },
    {
      "index": 23,
      "text": "「むすび」は、なまえのいみをあらわすだけのことばではありません。",
      "start_ms": 166409,
      "end_ms": 172365,
      "duration_ms": 5956,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」は、",
          "start_ms": 166409,
          "end_ms": 167962,
          "duration_ms": 1553
        },
        {
          "index": 1,
          "text": "なまえのいみをあらわすだけのことばではありません。",
          "start_ms": 168212,
          "end_ms": 172365,
          "duration_ms": 4153
        }
      ]
    },
    {
      "index": 24,
      "text": "むかしの本には、かみさまのなまえにも出ていて、そこに何かを作るいみや、人と人がつながるいみが加わっているのです。",
      "start_ms": 172865,
      "end_ms": 185353,
      "duration_ms": 12488,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 172865,
          "end_ms": 174929,
          "duration_ms": 2064
        },
        {
          "index": 1,
          "text": "かみさまのなまえにも出ていて、",
          "start_ms": 175179,
          "end_ms": 178020,
          "duration_ms": 2841
        },
        {
          "index": 2,
          "text": "そこに何かを作るいみや、",
          "start_ms": 178270,
          "end_ms": 181019,
          "duration_ms": 2749
        },
        {
          "index": 3,
          "text": "人と人がつながるいみが加わっているのです。",
          "start_ms": 181269,
          "end_ms": 185353,
          "duration_ms": 4084
        }
      ]
    },
    {
      "index": 25,
      "text": "つまり、「むすび」は、いみがさまざまに加わったことばということです。",
      "start_ms": 185853,
      "end_ms": 193519,
      "duration_ms": 7666,
      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 185853,
          "end_ms": 187232,
          "duration_ms": 1379
        },
        {
          "index": 1,
          "text": "「むすび」は、",
          "start_ms": 187482,
          "end_ms": 189046,
          "duration_ms": 1564
        },
        {
          "index": 2,
          "text": "いみがさまざまに加わったことばということです。",
          "start_ms": 189296,
          "end_ms": 193519,
          "duration_ms": 4223
        }
      ]
    },
    {
      "index": 26,
      "text": "だからといって、「むすび」というなまえがかみさまとつながっているとは言えません。",
      "start_ms": 194019,
      "end_ms": 201380,
      "duration_ms": 7361,
      "clauses": [
        {
          "index": 0,
          "text": "だからといって、",
          "start_ms": 194019,
          "end_ms": 195874,
          "duration_ms": 1855
        },
        {
          "index": 1,
          "text": "「むすび」というなまえがかみさまとつながっているとは言えません。",
          "start_ms": 196124,
          "end_ms": 201380,
          "duration_ms": 5256
        }
      ]
    },
    {
      "index": 27,
      "text": "でも、ことばのいみがさまざまに加わっていることにちゅうもくすると、この毎日のたべものがにほんに住む人にとって、大切ないみを持つのでしょう。",
      "start_ms": 201880,
      "end_ms": 215959,
      "duration_ms": 14079,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 201880,
          "end_ms": 202841,
          "duration_ms": 961
        },
        {
          "index": 1,
          "text": "ことばのいみがさまざまに加わっていることにちゅうもくすると、",
          "start_ms": 203091,
          "end_ms": 208173,
          "duration_ms": 5082
        },
        {
          "index": 2,
          "text": "この毎日のたべものがにほんに住む人にとって、",
          "start_ms": 208423,
          "end_ms": 212809,
          "duration_ms": 4386
        },
        {
          "index": 3,
          "text": "大切ないみを持つのでしょう。",
          "start_ms": 213059,
          "end_ms": 215959,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 28,
      "text": "こめを作る仕事は、一人では終わりません。",
      "start_ms": 216459,
      "end_ms": 221568,
      "duration_ms": 5109,
      "clauses": [
        {
          "index": 0,
          "text": "こめを作る仕事は、",
          "start_ms": 216459,
          "end_ms": 218813,
          "duration_ms": 2354
        },
        {
          "index": 1,
          "text": "一人では終わりません。",
          "start_ms": 219063,
          "end_ms": 221568,
          "duration_ms": 2505
        }
      ]
    },
    {
      "index": 29,
      "text": "みんなでみずを集め、みんなで使います。",
      "start_ms": 222068,
      "end_ms": 226562,
      "duration_ms": 4494,
      "clauses": [
        {
          "index": 0,
          "text": "みんなでみずを集め、",
          "start_ms": 222068,
          "end_ms": 224283,
          "duration_ms": 2215
        },
        {
          "index": 1,
          "text": "みんなで使います。",
          "start_ms": 224533,
          "end_ms": 226562,
          "duration_ms": 2029
        }
      ]
    },
    {
      "index": 30,
      "text": "みずをまもるのも、こめをうえるのも、みんなの仕事です。",
      "start_ms": 227062,
      "end_ms": 233823,
      "duration_ms": 6761,
      "clauses": [
        {
          "index": 0,
          "text": "みずをまもるのも、",
          "start_ms": 227062,
          "end_ms": 229126,
          "duration_ms": 2064
        },
        {
          "index": 1,
          "text": "こめをうえるのも、",
          "start_ms": 229376,
          "end_ms": 231393,
          "duration_ms": 2017
        },
        {
          "index": 2,
          "text": "みんなの仕事です。",
          "start_ms": 231643,
          "end_ms": 233823,
          "duration_ms": 2180
        }
      ]
    },
    {
      "index": 31,
      "text": "そして、作ったこめをみんなで食べるのに、とてもいいたべものが「おにぎり」です。",
      "start_ms": 234323,
      "end_ms": 242489,
      "duration_ms": 8166,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 234323,
          "end_ms": 235702,
          "duration_ms": 1379
        },
        {
          "index": 1,
          "text": "作ったこめをみんなで食べるのに、",
          "start_ms": 235952,
          "end_ms": 239177,
          "duration_ms": 3225
        },
        {
          "index": 2,
          "text": "とてもいいたべものが「おにぎり」です。",
          "start_ms": 239427,
          "end_ms": 242489,
          "duration_ms": 3062
        }
      ]
    },
    {
      "index": 32,
      "text": "じしんのとき、にほんではよく「おにぎり」が出ます。",
      "start_ms": 242989,
      "end_ms": 248493,
      "duration_ms": 5504,
      "clauses": [
        {
          "index": 0,
          "text": "じしんのとき、",
          "start_ms": 242989,
          "end_ms": 244867,
          "duration_ms": 1878
        },
        {
          "index": 1,
          "text": "にほんではよく「おにぎり」が出ます。",
          "start_ms": 245117,
          "end_ms": 248493,
          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 33,
      "text": "持ちやすく、作るのも楽で、食べるのに何も要りません。",
      "start_ms": 248993,
      "end_ms": 256148,
      "duration_ms": 7155,
      "clauses": [
        {
          "index": 0,
          "text": "持ちやすく、",
          "start_ms": 248993,
          "end_ms": 250708,
          "duration_ms": 1715
        },
        {
          "index": 1,
          "text": "作るのも楽で、",
          "start_ms": 250958,
          "end_ms": 253010,
          "duration_ms": 2052
        },
        {
          "index": 2,
          "text": "食べるのに何も要りません。",
          "start_ms": 253260,
          "end_ms": 256148,
          "duration_ms": 2888
        }
      ]
    },
    {
      "index": 34,
      "text": "みんなにおにぎりを与えました。",
      "start_ms": 256648,
      "end_ms": 259501,
      "duration_ms": 2853,
      "clauses": [
        {
          "index": 0,
          "text": "みんなにおにぎりを与えました。",
          "start_ms": 256648,
          "end_ms": 259501,
          "duration_ms": 2853
        }
      ]
    },
    {
      "index": 35,
      "text": "そのとき、人は人と人がつながることを知りました。",
      "start_ms": 260001,
      "end_ms": 266190,
      "duration_ms": 6189,
      "clauses": [
        {
          "index": 0,
          "text": "そのとき、",
          "start_ms": 260001,
          "end_ms": 261647,
          "duration_ms": 1646
        },
        {
          "index": 1,
          "text": "人は人と人がつながることを知りました。",
          "start_ms": 261897,
          "end_ms": 266190,
          "duration_ms": 4293
        }
      ]
    },
    {
      "index": 36,
      "text": "にせん年、にほんでは1月17日を「おむすびの日」にしました。",
      "start_ms": 266690,
      "end_ms": 273598,
      "duration_ms": 6908,
      "clauses": [
        {
          "index": 0,
          "text": "にせん年、",
          "start_ms": 266690,
          "end_ms": 268115,
          "duration_ms": 1425
        },
        {
          "index": 1,
          "text": "にほんでは1月17日を「おむすびの日」にしました。",
          "start_ms": 268365,
          "end_ms": 273598,
          "duration_ms": 5233
        }
      ]
    },
    {
      "index": 37,
      "text": "「おにぎり」ではなく「おむすび」というなまえを使ったのは、人と人がつながることを大切にしたからです。",
      "start_ms": 274098,
      "end_ms": 283003,
      "duration_ms": 8905,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ではなく「おむすび」というなまえを使ったのは、",
          "start_ms": 274098,
          "end_ms": 278379,
          "duration_ms": 4281
        },
        {
          "index": 1,
          "text": "人と人がつながることを大切にしたからです。",
          "start_ms": 278629,
          "end_ms": 283003,
          "duration_ms": 4374
        }
      ]
    },
    {
      "index": 38,
      "text": "にほんは、うみの近くにあって、やまが多いくにです。",
      "start_ms": 283503,
      "end_ms": 290113,
      "duration_ms": 6610,
      "clauses": [
        {
          "index": 0,
          "text": "にほんは、",
          "start_ms": 283503,
          "end_ms": 285009,
          "duration_ms": 1506
        },
        {
          "index": 1,
          "text": "うみの近くにあって、",
          "start_ms": 285259,
          "end_ms": 287532,
          "duration_ms": 2273
        },
        {
          "index": 2,
          "text": "やまが多いくにです。",
          "start_ms": 287782,
          "end_ms": 290113,
          "duration_ms": 2331
        }
      ]
    },
    {
      "index": 39,
      "text": "「おにぎり」を見ると、にほんのやまとうみのようすが分かります。",
      "start_ms": 290613,
      "end_ms": 296441,
      "duration_ms": 5828,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」を見ると、",
          "start_ms": 290613,
          "end_ms": 292665,
          "duration_ms": 2052
        },
        {
          "index": 1,
          "text": "にほんのやまとうみのようすが分かります。",
          "start_ms": 292915,
          "end_ms": 296441,
          "duration_ms": 3526
        }
      ]
    },
    {
      "index": 40,
      "text": "やまの近くに住む人はやさいを使い、うみの近くに住む人はさかなを使います。",
      "start_ms": 296941,
      "end_ms": 305323,
      "duration_ms": 8382,
      "clauses": [
        {
          "index": 0,
          "text": "やまの近くに住む人はやさいを使い、",
          "start_ms": 296941,
          "end_ms": 300827,
          "duration_ms": 3886
        },
        {
          "index": 1,
          "text": "うみの近くに住む人はさかなを使います。",
          "start_ms": 301077,
          "end_ms": 305323,
          "duration_ms": 4246
        }
      ]
    },
    {
      "index": 41,
      "text": "「おにぎり」の中には、やまとうみのたべものが入っています。",
      "start_ms": 305823,
      "end_ms": 311651,
      "duration_ms": 5828,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」の中には、",
          "start_ms": 305823,
          "end_ms": 307979,
          "duration_ms": 2156
        },
        {
          "index": 1,
          "text": "やまとうみのたべものが入っています。",
          "start_ms": 308229,
          "end_ms": 311651,
          "duration_ms": 3422
        }
      ]
    },
    {
      "index": 42,
      "text": "そのさまざまなおにぎりが、にほんのたべもののとくちょうを表しています。",
      "start_ms": 312151,
      "end_ms": 319013,
      "duration_ms": 6862,
      "clauses": [
        {
          "index": 0,
          "text": "そのさまざまなおにぎりが、",
          "start_ms": 312151,
          "end_ms": 314853,
          "duration_ms": 2702
        },
        {
          "index": 1,
          "text": "にほんのたべもののとくちょうを表しています。",
          "start_ms": 315103,
          "end_ms": 319013,
          "duration_ms": 3910
        }
      ]
    },
    {
      "index": 43,
      "text": "今は、ほかのくにのたべものも、むかしは知らなかったなかみも多くなっています。",
      "start_ms": 319513,
      "end_ms": 327643,
      "duration_ms": 8130,
      "clauses": [
        {
          "index": 0,
          "text": "今は、",
          "start_ms": 319513,
          "end_ms": 320508,
          "duration_ms": 995
        },
        {
          "index": 1,
          "text": "ほかのくにのたべものも、",
          "start_ms": 320758,
          "end_ms": 323298,
          "duration_ms": 2540
        },
        {
          "index": 2,
          "text": "むかしは知らなかったなかみも多くなっています。",
          "start_ms": 323548,
          "end_ms": 327643,
          "duration_ms": 4095
        }
      ]
    },
    {
      "index": 44,
      "text": "にほんのおにぎりは、さんかくけいがとても多いです。",
      "start_ms": 328143,
      "end_ms": 333681,
      "duration_ms": 5538,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのおにぎりは、",
          "start_ms": 328143,
          "end_ms": 330241,
          "duration_ms": 2098
        },
        {
          "index": 1,
          "text": "さんかくけいがとても多いです。",
          "start_ms": 330491,
          "end_ms": 333681,
          "duration_ms": 3190
        }
      ]
    },
    {
      "index": 45,
      "text": "コンビニのおにぎりになってから、そのようすが決まりました。",
      "start_ms": 334181,
      "end_ms": 339893,
      "duration_ms": 5712,
      "clauses": [
        {
          "index": 0,
          "text": "コンビニのおにぎりになってから、",
          "start_ms": 334181,
          "end_ms": 336999,
          "duration_ms": 2818
        },
        {
          "index": 1,
          "text": "そのようすが決まりました。",
          "start_ms": 337249,
          "end_ms": 339893,
          "duration_ms": 2644
        }
      ]
    },
    {
      "index": 46,
      "text": "さんかくけいは、持つ場合、壊さずに持ちやすいからです。",
      "start_ms": 340393,
      "end_ms": 347351,
      "duration_ms": 6958,
      "clauses": [
        {
          "index": 0,
          "text": "さんかくけいは、",
          "start_ms": 340393,
          "end_ms": 342294,
          "duration_ms": 1901
        },
        {
          "index": 1,
          "text": "持つ場合、",
          "start_ms": 342544,
          "end_ms": 344120,
          "duration_ms": 1576
        },
        {
          "index": 2,
          "text": "壊さずに持ちやすいからです。",
          "start_ms": 344370,
          "end_ms": 347351,
          "duration_ms": 2981
        }
      ]
    },
    {
      "index": 47,
      "text": "多く作って、多く運ぶのにも便利です。",
      "start_ms": 347851,
      "end_ms": 352727,
      "duration_ms": 4876,
      "clauses": [
        {
          "index": 0,
          "text": "多く作って、",
          "start_ms": 347851,
          "end_ms": 349566,
          "duration_ms": 1715
        },
        {
          "index": 1,
          "text": "多く運ぶのにも便利です。",
          "start_ms": 349816,
          "end_ms": 352727,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 48,
      "text": "むかしは、にほんでも、ばしょによってようすが違いました。",
      "start_ms": 353227,
      "end_ms": 359964,
      "duration_ms": 6737,
      "clauses": [
        {
          "index": 0,
          "text": "むかしは、",
          "start_ms": 353227,
          "end_ms": 354675,
          "duration_ms": 1448
        },
        {
          "index": 1,
          "text": "にほんでも、",
          "start_ms": 354925,
          "end_ms": 356536,
          "duration_ms": 1611
        },
        {
          "index": 2,
          "text": "ばしょによってようすが違いました。",
          "start_ms": 356786,
          "end_ms": 359964,
          "duration_ms": 3178
        }
      ]
    },
    {
      "index": 49,
      "text": "今は、いろいろななかみを入れて、食べやすくするためのようすもあります。",
      "start_ms": 360464,
      "end_ms": 367746,
      "duration_ms": 7282,
      "clauses": [
        {
          "index": 0,
          "text": "今は、",
          "start_ms": 360464,
          "end_ms": 361401,
          "duration_ms": 937
        },
        {
          "index": 1,
          "text": "いろいろななかみを入れて、",
          "start_ms": 361651,
          "end_ms": 364086,
          "duration_ms": 2435
        },
        {
          "index": 2,
          "text": "食べやすくするためのようすもあります。",
          "start_ms": 364336,
          "end_ms": 367746,
          "duration_ms": 3410
        }
      ]
    },
    {
      "index": 50,
      "text": "にほんのおにぎりは、世界でもちゅうもくされています。",
      "start_ms": 368246,
      "end_ms": 373668,
      "duration_ms": 5422,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのおにぎりは、",
          "start_ms": 368246,
          "end_ms": 370310,
          "duration_ms": 2064
        },
        {
          "index": 1,
          "text": "世界でもちゅうもくされています。",
          "start_ms": 370560,
          "end_ms": 373668,
          "duration_ms": 3108
        }
      ]
    },
    {
      "index": 51,
      "text": "おにぎりだけのみせがとても多くなっています。",
      "start_ms": 374168,
      "end_ms": 378379,
      "duration_ms": 4211,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりだけのみせがとても多くなっています。",
          "start_ms": 374168,
          "end_ms": 378379,
          "duration_ms": 4211
        }
      ]
    },
    {
      "index": 52,
      "text": "世界の人も食べるようになり、おにぎりをひょうかする人も多くなっています。",
      "start_ms": 378879,
      "end_ms": 385949,
      "duration_ms": 7070,
      "clauses": [
        {
          "index": 0,
          "text": "世界の人も食べるようになり、",
          "start_ms": 378879,
          "end_ms": 381755,
          "duration_ms": 2876
        },
        {
          "index": 1,
          "text": "おにぎりをひょうかする人も多くなっています。",
          "start_ms": 382005,
          "end_ms": 385949,
          "duration_ms": 3944
        }
      ]
    },
    {
      "index": 53,
      "text": "にせんにじゅうよ年、えいごの大きなじしょに「onigiri」が出ました。",
      "start_ms": 386449,
      "end_ms": 391952,
      "duration_ms": 5503,
      "clauses": [
        {
          "index": 0,
          "text": "にせんにじゅうよ年、",
          "start_ms": 386449,
          "end_ms": 388501,
          "duration_ms": 2052
        },
        {
          "index": 1,
          "text": "えいごの大きなじしょに「onigiri」が出ました。",
          "start_ms": 388751,
          "end_ms": 391952,
          "duration_ms": 3201
        }
      ]
    },
    {
      "index": 54,
      "text": "にほんごのなまえで知られたしょうこです。",
      "start_ms": 392452,
      "end_ms": 395828,
      "duration_ms": 3376,
      "clauses": [
        {
          "index": 0,
          "text": "にほんごのなまえで知られたしょうこです。",
          "start_ms": 392452,
          "end_ms": 395828,
          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 55,
      "text": "おにぎりは、いろいろなようすになり、世界にも広がっています。",
      "start_ms": 396328,
      "end_ms": 403506,
      "duration_ms": 7178,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 396328,
          "end_ms": 397950,
          "duration_ms": 1622
        },
        {
          "index": 1,
          "text": "いろいろなようすになり、",
          "start_ms": 398200,
          "end_ms": 400519,
          "duration_ms": 2319
        },
        {
          "index": 2,
          "text": "世界にも広がっています。",
          "start_ms": 400769,
          "end_ms": 403506,
          "duration_ms": 2737
        }
      ]
    },
    {
      "index": 56,
      "text": "でも、こめを手でまとめてみんなで食べるちゅうしんは、今もあります。",
      "start_ms": 404006,
      "end_ms": 411672,
      "duration_ms": 7666,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 404006,
          "end_ms": 405013,
          "duration_ms": 1007
        },
        {
          "index": 1,
          "text": "こめを手でまとめてみんなで食べるちゅうしんは、",
          "start_ms": 405263,
          "end_ms": 409567,
          "duration_ms": 4304
        },
        {
          "index": 2,
          "text": "今もあります。",
          "start_ms": 409817,
          "end_ms": 411672,
          "duration_ms": 1855
        }
      ]
    },
    {
      "index": 57,
      "text": "これからも、にほんのおにぎりはみんなに食べられていくでしょう。",
      "start_ms": 412172,
      "end_ms": 418360,
      "duration_ms": 6188,
      "clauses": [
        {
          "index": 0,
          "text": "これからも、",
          "start_ms": 412172,
          "end_ms": 413806,
          "duration_ms": 1634
        },
        {
          "index": 1,
          "text": "にほんのおにぎりはみんなに食べられていくでしょう。",
          "start_ms": 414056,
          "end_ms": 418360,
          "duration_ms": 4304
        }
      ]
    }
  ]
}