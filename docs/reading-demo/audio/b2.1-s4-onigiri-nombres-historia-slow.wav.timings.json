  "sentences": [
    {
      "index": 0,
      "text": "「おにぎり」のなまえとれきし ― にほんのおにぎりから世界へ",
      "start_ms": 0,
      "end_ms": 4571,
      "duration_ms": 4571,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」のなまえとれきし ― にほんのおにぎりから世界へ",
          "start_ms": 0,
          "end_ms": 4571,
          "duration_ms": 4571
        }
      ]
    },
    {
      "index": 1,
      "text": "にほんでは2025年、きおんが高くてこめが買えなくなり、お金も高くなりました。",
      "start_ms": 5071,
      "end_ms": 14688,
      "duration_ms": 9617,
      "clauses": [
        {
          "index": 0,
          "text": "にほんでは2025年、",
          "start_ms": 5071,
          "end_ms": 8226,
          "duration_ms": 3155
        },
        {
          "index": 1,
          "text": "きおんが高くてこめが買えなくなり、",
          "start_ms": 8476,
          "end_ms": 11782,
          "duration_ms": 3306
        },
        {
          "index": 2,
          "text": "お金も高くなりました。",
          "start_ms": 12032,
          "end_ms": 14688,
          "duration_ms": 2656
        }
      ]
    },
    {
      "index": 2,
      "text": "いつも買えると思ってきたのに買えなくなると、にほんでは長いあいだ、こめがせいかつの中でとても大切なものだと、みんなが気がつきました。",
      "start_ms": 15188,
      "end_ms": 29440,
      "duration_ms": 14252,
      "clauses": [
        {
          "index": 0,
          "text": "いつも買えると思ってきたのに買えなくなると、",
          "start_ms": 15188,
          "end_ms": 19341,
          "duration_ms": 4153
        },
        {
          "index": 1,
          "text": "にほんでは長いあいだ、",
          "start_ms": 19591,
          "end_ms": 22003,
          "duration_ms": 2412
        },
        {
          "index": 2,
          "text": "こめがせいかつの中でとても大切なものだと、",
          "start_ms": 22253,
          "end_ms": 26778,
          "duration_ms": 4525
        },
        {
          "index": 3,
          "text": "みんなが気がつきました。",
          "start_ms": 27028,
          "end_ms": 29440,
          "duration_ms": 2412
        }
      ]
    },
    {
      "index": 3,
      "text": "そこで、みんなが知っている毎日のたべもの「おにぎり」にちゅうもくする人が出ました。",
      "start_ms": 29940,
      "end_ms": 37127,
      "duration_ms": 7187,
      "clauses": [
        {
          "index": 0,
          "text": "そこで、",
          "start_ms": 29940,
          "end_ms": 31133,
          "duration_ms": 1193
        },
        {
          "index": 1,
          "text": "みんなが知っている毎日のたべもの「おにぎり」にちゅうもくする人が出ました。",
          "start_ms": 31383,
          "end_ms": 37127,
          "duration_ms": 5744
        }
      ]
    },
    {
      "index": 4,
      "text": "そのれきしを見てみましょう。",
      "start_ms": 37627,
      "end_ms": 40422,
      "duration_ms": 2795,
      "clauses": [
        {
          "index": 0,
          "text": "そのれきしを見てみましょう。",
          "start_ms": 37627,
          "end_ms": 40422,
          "duration_ms": 2795
        }
      ]
    },
    {
      "index": 5,
      "text": "おにぎりは、いつからあったのか、はっきりしていません。",
      "start_ms": 40922,
      "end_ms": 47428,
      "duration_ms": 6506,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 40922,
          "end_ms": 42533,
          "duration_ms": 1611
        },
        {
          "index": 1,
          "text": "いつからあったのか、",
          "start_ms": 42783,
          "end_ms": 44998,
          "duration_ms": 2215
        },
        {
          "index": 2,
          "text": "はっきりしていません。",
          "start_ms": 45248,
          "end_ms": 47428,
          "duration_ms": 2180
        }
      ]
    },
    {
      "index": 6,
      "text": "にほんでこめを作るようになってから、人は作ったこめを手でまとめていたと考えられています。",
      "start_ms": 47928,
      "end_ms": 56624,
      "duration_ms": 8696,
      "clauses": [
        {
          "index": 0,
          "text": "にほんでこめを作るようになってから、",
          "start_ms": 47928,
          "end_ms": 51129,
          "duration_ms": 3201
        },
        {
          "index": 1,
          "text": "人は作ったこめを手でまとめていたと考えられています。",
          "start_ms": 51379,
          "end_ms": 56624,
          "duration_ms": 5245
        }
      ]
    },
    {
      "index": 7,
      "text": "にほんのあるばしょでは、2000年前のこめが出たこともあります。",
      "start_ms": 57124,
      "end_ms": 63242,
      "duration_ms": 6118,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのあるばしょでは、",
          "start_ms": 57124,
          "end_ms": 59431,
          "duration_ms": 2307
        },
        {
          "index": 1,
          "text": "2000年前のこめが出たこともあります。",
          "start_ms": 59681,
          "end_ms": 63242,
          "duration_ms": 3561
        }
      ]
    },
    {
      "index": 8,
      "text": "手で作ったのではなく、ほかのしゅだんで作られたと考えられているものもあります。",
      "start_ms": 63742,
      "end_ms": 71498,
      "duration_ms": 7756,
      "clauses": [
        {
          "index": 0,
          "text": "手で作ったのではなく、",
          "start_ms": 63742,
          "end_ms": 66212,
          "duration_ms": 2470
        },
        {
          "index": 1,
          "text": "ほかのしゅだんで作られたと考えられているものもあります。",
          "start_ms": 66462,
          "end_ms": 71498,
          "duration_ms": 5036
        }
      ]
    },
    {
      "index": 9,
      "text": "そして、それを「むかしのおにぎりのしょうこ」と言っています。",
      "start_ms": 71998,
      "end_ms": 77745,
      "duration_ms": 5747,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 71998,
          "end_ms": 73330,
          "duration_ms": 1332
        },
        {
          "index": 1,
          "text": "それを「むかしのおにぎりのしょうこ」と言っています。",
          "start_ms": 73580,
          "end_ms": 77745,
          "duration_ms": 4165
        }
      ]
    },
    {
      "index": 10,
      "text": "このこめについては、人によって違う説明をしています。",
      "start_ms": 78245,
      "end_ms": 84306,
      "duration_ms": 6061,
      "clauses": [
        {
          "index": 0,
          "text": "このこめについては、",
          "start_ms": 78245,
          "end_ms": 80448,
          "duration_ms": 2203
        },
        {
          "index": 1,
          "text": "人によって違う説明をしています。",
          "start_ms": 80698,
          "end_ms": 84306,
          "duration_ms": 3608
        }
      ]
    },
    {
      "index": 11,
      "text": "大切なのは、こめを手でまとめて持ちやすくすることを、にほんではとてもむかしからやっていることです。",
      "start_ms": 84806,
      "end_ms": 95049,
      "duration_ms": 10243,
      "clauses": [
        {
          "index": 0,
          "text": "大切なのは、",
          "start_ms": 84806,
          "end_ms": 86684,
          "duration_ms": 1878
        },
        {
          "index": 1,
          "text": "こめを手でまとめて持ちやすくすることを、",
          "start_ms": 86934,
          "end_ms": 90588,
          "duration_ms": 3654
        },
        {
          "index": 2,
          "text": "にほんではとてもむかしからやっていることです。",
          "start_ms": 90838,
          "end_ms": 95049,
          "duration_ms": 4211
        }
      ]
    },
    {
      "index": 12,
      "text": "むかしの本には、にほんごで「にぎりいい」と書かれたことばが出ています。",
      "start_ms": 95549,
      "end_ms": 101865,
      "duration_ms": 6316,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 95549,
          "end_ms": 97520,
          "duration_ms": 1971
        },
        {
          "index": 1,
          "text": "にほんごで「にぎりいい」と書かれたことばが出ています。",
          "start_ms": 97770,
          "end_ms": 101865,
          "duration_ms": 4095
        }
      ]
    },
    {
      "index": 13,
      "text": "人はたべものを持って会い、こめをみんなで食べていました。",
      "start_ms": 102365,
      "end_ms": 108658,
      "duration_ms": 6293,
      "clauses": [
        {
          "index": 0,
          "text": "人はたべものを持って会い、",
          "start_ms": 102365,
          "end_ms": 105508,
          "duration_ms": 3143
        },
        {
          "index": 1,
          "text": "こめをみんなで食べていました。",
          "start_ms": 105758,
          "end_ms": 108658,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 14,
      "text": "その使い方は、とてもみじかなものでした。",
      "start_ms": 109158,
      "end_ms": 114232,
      "duration_ms": 5074,
      "clauses": [
        {
          "index": 0,
          "text": "その使い方は、",
          "start_ms": 109158,
          "end_ms": 111245,
          "duration_ms": 2087
        },
        {
          "index": 1,
          "text": "とてもみじかなものでした。",
          "start_ms": 111495,
          "end_ms": 114232,
          "duration_ms": 2737
        }
      ]
    },
    {
      "index": 15,
      "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
      "start_ms": 114732,
      "end_ms": 120116,
      "duration_ms": 5384,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
          "start_ms": 114732,
          "end_ms": 120116,
          "duration_ms": 5384
        }
      ]
    },
    {
      "index": 16,
      "text": "にほんではむかし、「にぎりいい」と言っていました。",
      "start_ms": 120616,
      "end_ms": 125365,
      "duration_ms": 4749,
      "clauses": [
        {
          "index": 0,
          "text": "にほんではむかし、",
          "start_ms": 120616,
          "end_ms": 122726,
          "duration_ms": 2110
        },
        {
          "index": 1,
          "text": "「にぎりいい」と言っていました。",
          "start_ms": 122976,
          "end_ms": 125365,
          "duration_ms": 2389
        }
      ]
    },
    {
      "index": 17,
      "text": "「にぎりいい」が使われているうちに、「にぎりめし」というなまえのことばに換えました。",
      "start_ms": 125865,
      "end_ms": 132842,
      "duration_ms": 6977,
      "clauses": [
        {
          "index": 0,
          "text": "「にぎりいい」が使われているうちに、",
          "start_ms": 125865,
          "end_ms": 128799,
          "duration_ms": 2934
        },
        {
          "index": 1,
          "text": "「にぎりめし」というなまえのことばに換えました。",
          "start_ms": 129049,
          "end_ms": 132842,
          "duration_ms": 3793
        }
      ]
    },
    {
      "index": 18,
      "text": "さらに、けいごの「お」を付けたなまえが「おにぎり」です。",
      "start_ms": 133342,
      "end_ms": 138230,
      "duration_ms": 4888,
      "clauses": [
        {
          "index": 0,
          "text": "さらに、",
          "start_ms": 133342,
          "end_ms": 134616,
          "duration_ms": 1274
        },
        {
          "index": 1,
          "text": "けいごの「お」を付けたなまえが「おにぎり」です。",
          "start_ms": 134866,
          "end_ms": 138230,
          "duration_ms": 3364
        }
      ]
    },
    {
      "index": 19,
      "text": "「おにぎり」をせつめいすることばは、「おむすび」もあります。",
      "start_ms": 138730,
      "end_ms": 144141,
      "duration_ms": 5411,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」をせつめいすることばは、",
          "start_ms": 138730,
          "end_ms": 141688,
          "duration_ms": 2958
        },
        {
          "index": 1,
          "text": "「おむすび」もあります。",
          "start_ms": 141938,
          "end_ms": 144141,
          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 20,
      "text": "「むすび」というなまえをみんなが使い始めたのは、えどじだいです。",
      "start_ms": 144641,
      "end_ms": 151155,
      "duration_ms": 6514,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」というなまえをみんなが使い始めたのは、",
          "start_ms": 144641,
          "end_ms": 148969,
          "duration_ms": 4328
        },
        {
          "index": 1,
          "text": "えどじだいです。",
          "start_ms": 149219,
          "end_ms": 151155,
          "duration_ms": 1936
        }
      ]
    },
    {
      "index": 21,
      "text": "そこにもけいごの「お」を付けました。",
      "start_ms": 151655,
      "end_ms": 154647,
      "duration_ms": 2992,
      "clauses": [
        {
          "index": 0,
          "text": "そこにもけいごの「お」を付けました。",
          "start_ms": 151655,
          "end_ms": 154647,
          "duration_ms": 2992
        }
      ]
    },
    {
      "index": 22,
      "text": "むかしの本には、「むすび」を「にぎりいい」の別のなまえと書いて、「もとは女のことばです」とも書かれています。",
      "start_ms": 155147,
      "end_ms": 165240,
      "duration_ms": 10093,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 155147,
          "end_ms": 157211,
          "duration_ms": 2064
        },
        {
          "index": 1,
          "text": "「むすび」を「にぎりいい」の別のなまえと書いて、",
          "start_ms": 157461,
          "end_ms": 160941,
          "duration_ms": 3480
        },
        {
          "index": 2,
          "text": "「もとは女のことばです」とも書かれています。",
          "start_ms": 161191,
          "end_ms": 165240,
          "duration_ms": 4049
        }
      ]
    },
    {
      "index": 23,
      "text": "「むすび」は、なまえのいみをあらわすだけのことばではありません。",
      "start_ms": 165740,
      "end_ms": 171789,
      "duration_ms": 6049,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」は、",
          "start_ms": 165740,
          "end_ms": 167293,
          "duration_ms": 1553
        },
        {
          "index": 1,
          "text": "なまえのいみをあらわすだけのことばではありません。",
          "start_ms": 167543,
          "end_ms": 171789,
          "duration_ms": 4246
        }
      ]
    },
    {
      "index": 24,
      "text": "かみさまのなまえも、むかしの本に出ています。",
      "start_ms": 172289,
      "end_ms": 177247,
      "duration_ms": 4958,
      "clauses": [
        {
          "index": 0,
          "text": "かみさまのなまえも、",
          "start_ms": 172289,
          "end_ms": 174492,
          "duration_ms": 2203
        },
        {
          "index": 1,
          "text": "むかしの本に出ています。",
          "start_ms": 174742,
          "end_ms": 177247,
          "duration_ms": 2505
        }
      ]
    },
    {
      "index": 25,
      "text": "そこに、何かを作るいみとか、人と人がつながるいみとかが加わっているのです。",
      "start_ms": 177747,
      "end_ms": 186353,
      "duration_ms": 8606,
      "clauses": [
        {
          "index": 0,
          "text": "そこに、",
          "start_ms": 177747,
          "end_ms": 179021,
          "duration_ms": 1274
        },
        {
          "index": 1,
          "text": "何かを作るいみとか、",
          "start_ms": 179271,
          "end_ms": 181799,
          "duration_ms": 2528
        },
        {
          "index": 2,
          "text": "人と人がつながるいみとかが加わっているのです。",
          "start_ms": 182049,
          "end_ms": 186353,
          "duration_ms": 4304
        }
      ]
    },
    {
      "index": 26,
      "text": "つまり、「むすび」は、いみがさまざまに加わったことばということです。",
      "start_ms": 186853,
      "end_ms": 194519,
      "duration_ms": 7666,
      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 186853,
          "end_ms": 188197,
          "duration_ms": 1344
        },
        {
          "index": 1,
          "text": "「むすび」は、",
          "start_ms": 188447,
          "end_ms": 190023,
          "duration_ms": 1576
        },
        {
          "index": 2,
          "text": "いみがさまざまに加わったことばということです。",
          "start_ms": 190273,
          "end_ms": 194519,
          "duration_ms": 4246
        }
      ]
    },
    {
      "index": 27,
      "text": "もちろん、「むすび」というなまえがかみさまとつながっているとは言えません。",
      "start_ms": 195019,
      "end_ms": 202113,
      "duration_ms": 7094,
      "clauses": [
        {
          "index": 0,
          "text": "もちろん、",
          "start_ms": 195019,
          "end_ms": 196595,
          "duration_ms": 1576
        },
        {
          "index": 1,
          "text": "「むすび」というなまえがかみさまとつながっているとは言えません。",
          "start_ms": 196845,
          "end_ms": 202113,
          "duration_ms": 5268
        }
      ]
    },
    {
      "index": 28,
      "text": "でも、ことばのいみがさまざまに加わっていることにちゅうもくすると、この毎日のたべものがにほんに住む人にとって、大切ないみを持つのでしょう。",
      "start_ms": 202613,
      "end_ms": 216609,
      "duration_ms": 13996,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 202613,
          "end_ms": 203585,
          "duration_ms": 972
        },
        {
          "index": 1,
          "text": "ことばのいみがさまざまに加わっていることにちゅうもくすると、",
          "start_ms": 203835,
          "end_ms": 208789,
          "duration_ms": 4954
        },
        {
          "index": 2,
          "text": "この毎日のたべものがにほんに住む人にとって、",
          "start_ms": 209039,
          "end_ms": 213448,
          "duration_ms": 4409
        },
        {
          "index": 3,
          "text": "大切ないみを持つのでしょう。",
          "start_ms": 213698,
          "end_ms": 216609,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 29,
      "text": "こめを作る仕事は、一人では終わりません。",
      "start_ms": 217109,
      "end_ms": 222148,
      "duration_ms": 5039,
      "clauses": [
        {
          "index": 0,
          "text": "こめを作る仕事は、",
          "start_ms": 217109,
          "end_ms": 219440,
          "duration_ms": 2331
        },
        {
          "index": 1,
          "text": "一人では終わりません。",
          "start_ms": 219690,
          "end_ms": 222148,
          "duration_ms": 2458
        }
      ]
    },
    {
      "index": 30,
      "text": "みんなでみずを集め、みんなで使います。",
      "start_ms": 222648,
      "end_ms": 227187,
      "duration_ms": 4539,
      "clauses": [
        {
          "index": 0,
          "text": "みんなでみずを集め、",
          "start_ms": 222648,
          "end_ms": 224839,
          "duration_ms": 2191
        },
        {
          "index": 1,
          "text": "みんなで使います。",
          "start_ms": 225089,
          "end_ms": 227187,
          "duration_ms": 2098
        }
      ]
    },
    {
      "index": 31,
      "text": "みずをまもるのも、こめをうえるのも、みんなの仕事です。",
      "start_ms": 227687,
      "end_ms": 234436,
      "duration_ms": 6749,
      "clauses": [
        {
          "index": 0,
          "text": "みずをまもるのも、",
          "start_ms": 227687,
          "end_ms": 229693,
          "duration_ms": 2006
        },
        {
          "index": 1,
          "text": "こめをうえるのも、",
          "start_ms": 229943,
          "end_ms": 231983,
          "duration_ms": 2040
        },
        {
          "index": 2,
          "text": "みんなの仕事です。",
          "start_ms": 232233,
          "end_ms": 234436,
          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 32,
      "text": "そして、作ったこめをみんなで食べるのに、とてもいいたべものが「おにぎり」です。",
      "start_ms": 234936,
      "end_ms": 243113,
      "duration_ms": 8177,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 234936,
          "end_ms": 236280,
          "duration_ms": 1344
        },
        {
          "index": 1,
          "text": "作ったこめをみんなで食べるのに、",
          "start_ms": 236530,
          "end_ms": 239766,
          "duration_ms": 3236
        },
        {
          "index": 2,
          "text": "とてもいいたべものが「おにぎり」です。",
          "start_ms": 240016,
          "end_ms": 243113,
          "duration_ms": 3097
        }
      ]
    },
    {
      "index": 33,
      "text": "じしんのとき、にほんではよく「おにぎり」が出ます。",
      "start_ms": 243613,
      "end_ms": 249094,
      "duration_ms": 5481,
      "clauses": [
        {
          "index": 0,
          "text": "じしんのとき、",
          "start_ms": 243613,
          "end_ms": 245468,
          "duration_ms": 1855
        },
        {
          "index": 1,
          "text": "にほんではよく「おにぎり」が出ます。",
          "start_ms": 245718,
          "end_ms": 249094,
          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 34,
      "text": "持ちやすく、作るのも楽で、食べるのに何も要りません。",
      "start_ms": 249594,
      "end_ms": 256657,
      "duration_ms": 7063,
      "clauses": [
        {
          "index": 0,
          "text": "持ちやすく、",
          "start_ms": 249594,
          "end_ms": 251286,
          "duration_ms": 1692
        },
        {
          "index": 1,
          "text": "作るのも楽で、",
          "start_ms": 251536,
          "end_ms": 253542,
          "duration_ms": 2006
        },
        {
          "index": 2,
          "text": "食べるのに何も要りません。",
          "start_ms": 253792,
          "end_ms": 256657,
          "duration_ms": 2865
        }
      ]
    },
    {
      "index": 35,
      "text": "みんなにおにぎりを与えました。",
      "start_ms": 257157,
      "end_ms": 260080,
      "duration_ms": 2923,
      "clauses": [
        {
          "index": 0,
          "text": "みんなにおにぎりを与えました。",
          "start_ms": 257157,
          "end_ms": 260080,
          "duration_ms": 2923
        }
      ]
    },
    {
      "index": 36,
      "text": "そのとき、人は人と人がつながることを知りました。",
      "start_ms": 260580,
      "end_ms": 266792,
      "duration_ms": 6212,
      "clauses": [
        {
          "index": 0,
          "text": "そのとき、",
          "start_ms": 260580,
          "end_ms": 262226,
          "duration_ms": 1646
        },
        {
          "index": 1,
          "text": "人は人と人がつながることを知りました。",
          "start_ms": 262476,
          "end_ms": 266792,
          "duration_ms": 4316
        }
      ]
    },
    {
      "index": 37,
      "text": "2000年、にほんでは1月17日を「おむすびの日」にしました。",
      "start_ms": 267292,
      "end_ms": 274305,
      "duration_ms": 7013,
      "clauses": [
        {
          "index": 0,
          "text": "2000年、",
          "start_ms": 267292,
          "end_ms": 268868,
          "duration_ms": 1576
        },
        {
          "index": 1,
          "text": "にほんでは1月17日を「おむすびの日」にしました。",
          "start_ms": 269118,
          "end_ms": 274305,
          "duration_ms": 5187
        }
      ]
    },
    {
      "index": 38,
      "text": "「おにぎり」ではなく「おむすび」というなまえを使ったのは、人と人がつながることを大切にしたからです。",
      "start_ms": 274805,
      "end_ms": 283722,
      "duration_ms": 8917,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ではなく「おむすび」というなまえを使ったのは、",
          "start_ms": 274805,
          "end_ms": 279098,
          "duration_ms": 4293
        },
        {
          "index": 1,
          "text": "人と人がつながることを大切にしたからです。",
          "start_ms": 279348,
          "end_ms": 283722,
          "duration_ms": 4374
        }
      ]
    },
    {
      "index": 39,
      "text": "にほんは、うみの近くにあって、やまが多いくにです。",
      "start_ms": 284222,
      "end_ms": 290739,
      "duration_ms": 6517,
      "clauses": [
        {
          "index": 0,
          "text": "にほんは、",
          "start_ms": 284222,
          "end_ms": 285670,
          "duration_ms": 1448
        },
        {
          "index": 1,
          "text": "うみの近くにあって、",
          "start_ms": 285920,
          "end_ms": 288135,
          "duration_ms": 2215
        },
        {
          "index": 2,
          "text": "やまが多いくにです。",
          "start_ms": 288385,
          "end_ms": 290739,
          "duration_ms": 2354
        }
      ]
    },
    {
      "index": 40,
      "text": "「おにぎり」を見ると、にほんのやまとうみのようすが分かります。",
      "start_ms": 291239,
      "end_ms": 297009,
      "duration_ms": 5770,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」を見ると、",
          "start_ms": 291239,
          "end_ms": 293279,
          "duration_ms": 2040
        },
        {
          "index": 1,
          "text": "にほんのやまとうみのようすが分かります。",
          "start_ms": 293529,
          "end_ms": 297009,
          "duration_ms": 3480
        }
      ]
    },
    {
      "index": 41,
      "text": "やまの近くに住む人はやさいを使い、うみの近くに住む人はさかなを使います。",
      "start_ms": 297509,
      "end_ms": 305857,
      "duration_ms": 8348,
      "clauses": [
        {
          "index": 0,
          "text": "やまの近くに住む人はやさいを使い、",
          "start_ms": 297509,
          "end_ms": 301477,
          "duration_ms": 3968
        },
        {
          "index": 1,
          "text": "うみの近くに住む人はさかなを使います。",
          "start_ms": 301727,
          "end_ms": 305857,
          "duration_ms": 4130
        }
      ]
    },
    {
      "index": 42,
      "text": "「おにぎり」の中には、やまとうみのたべものが入っています。",
      "start_ms": 306357,
      "end_ms": 312232,
      "duration_ms": 5875,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」の中には、",
          "start_ms": 306357,
          "end_ms": 308525,
          "duration_ms": 2168
        },
        {
          "index": 1,
          "text": "やまとうみのたべものが入っています。",
          "start_ms": 308775,
          "end_ms": 312232,
          "duration_ms": 3457
        }
      ]
    },
    {
      "index": 43,
      "text": "そのさまざまなおにぎりが、にほんのたべもののとくちょうを表しています。",
      "start_ms": 312732,
      "end_ms": 319686,
      "duration_ms": 6954,
      "clauses": [
        {
          "index": 0,
          "text": "そのさまざまなおにぎりが、",
          "start_ms": 312732,
          "end_ms": 315434,
          "duration_ms": 2702
        },
        {
          "index": 1,
          "text": "にほんのたべもののとくちょうを表しています。",
          "start_ms": 315684,
          "end_ms": 319686,
          "duration_ms": 4002
        }
      ]
    },
    {
      "index": 44,
      "text": "今は、ほかのくにのたべものも、むかしは知らなかったなかみも多くなっています。",
      "start_ms": 320186,
      "end_ms": 328340,
      "duration_ms": 8154,
      "clauses": [
        {
          "index": 0,
          "text": "今は、",
          "start_ms": 320186,
          "end_ms": 321170,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "ほかのくにのたべものも、",
          "start_ms": 321420,
          "end_ms": 323960,
          "duration_ms": 2540
        },
        {
          "index": 2,
          "text": "むかしは知らなかったなかみも多くなっています。",
          "start_ms": 324210,
          "end_ms": 328340,
          "duration_ms": 4130
        }
      ]
    },
    {
      "index": 45,
      "text": "にほんのおにぎりは、さんかくけいがとても多いです。",
      "start_ms": 328840,
      "end_ms": 334286,
      "duration_ms": 5446,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのおにぎりは、",
          "start_ms": 328840,
          "end_ms": 330869,
          "duration_ms": 2029
        },
        {
          "index": 1,
          "text": "さんかくけいがとても多いです。",
          "start_ms": 331119,
          "end_ms": 334286,
          "duration_ms": 3167
        }
      ]
    },
    {
      "index": 46,
      "text": "コンビニのおにぎりになってから、そのようすが決まりました。",
      "start_ms": 334786,
      "end_ms": 340510,
      "duration_ms": 5724,
      "clauses": [
        {
          "index": 0,
          "text": "コンビニのおにぎりになってから、",
          "start_ms": 334786,
          "end_ms": 337616,
          "duration_ms": 2830
        },
        {
          "index": 1,
          "text": "そのようすが決まりました。",
          "start_ms": 337866,
          "end_ms": 340510,
          "duration_ms": 2644
        }
      ]
    },
    {
      "index": 47,
      "text": "さんかくけいは、持つ場合、壊さずに持ちやすいからです。",
      "start_ms": 341010,
      "end_ms": 347945,
      "duration_ms": 6935,
      "clauses": [
        {
          "index": 0,
          "text": "さんかくけいは、",
          "start_ms": 341010,
          "end_ms": 342911,
          "duration_ms": 1901
        },
        {
          "index": 1,
          "text": "持つ場合、",
          "start_ms": 343161,
          "end_ms": 344795,
          "duration_ms": 1634
        },
        {
          "index": 2,
          "text": "壊さずに持ちやすいからです。",
          "start_ms": 345045,
          "end_ms": 347945,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 48,
      "text": "多く作って、多く運ぶのにも便利です。",
      "start_ms": 348445,
      "end_ms": 353391,
      "duration_ms": 4946,
      "clauses": [
        {
          "index": 0,
          "text": "多く作って、",
          "start_ms": 348445,
          "end_ms": 350230,
          "duration_ms": 1785
        },
        {
          "index": 1,
          "text": "多く運ぶのにも便利です。",
          "start_ms": 350480,
          "end_ms": 353391,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 49,
      "text": "むかしは、にほんでも、ばしょによってようすが違いました。",
      "start_ms": 353891,
      "end_ms": 360721,
      "duration_ms": 6830,
      "clauses": [
        {
          "index": 0,
          "text": "むかしは、",
          "start_ms": 353891,
          "end_ms": 355374,
          "duration_ms": 1483
        },
        {
          "index": 1,
          "text": "にほんでも、",
          "start_ms": 355624,
          "end_ms": 357281,
          "duration_ms": 1657
        },
        {
          "index": 2,
          "text": "ばしょによってようすが違いました。",
          "start_ms": 357531,
          "end_ms": 360721,
          "duration_ms": 3190
        }
      ]
    },
    {
      "index": 50,
      "text": "今は、いろいろななかみを入れて、食べやすくするためのようすもあります。",
      "start_ms": 361221,
      "end_ms": 368561,
      "duration_ms": 7340,
      "clauses": [
        {
          "index": 0,
          "text": "今は、",
          "start_ms": 361221,
          "end_ms": 362216,
          "duration_ms": 995
        },
        {
          "index": 1,
          "text": "いろいろななかみを入れて、",
          "start_ms": 362466,
          "end_ms": 364959,
          "duration_ms": 2493
        },
        {
          "index": 2,
          "text": "食べやすくするためのようすもあります。",
          "start_ms": 365209,
          "end_ms": 368561,
          "duration_ms": 3352
        }
      ]
    },
    {
      "index": 51,
      "text": "にほんのおにぎりは、世界でもちゅうもくされています。",
      "start_ms": 369061,
      "end_ms": 374623,
      "duration_ms": 5562,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのおにぎりは、",
          "start_ms": 369061,
          "end_ms": 371206,
          "duration_ms": 2145
        },
        {
          "index": 1,
          "text": "世界でもちゅうもくされています。",
          "start_ms": 371456,
          "end_ms": 374623,
          "duration_ms": 3167
        }
      ]
    },
    {
      "index": 52,
      "text": "おにぎりだけのみせがとても多くなっています。",
      "start_ms": 375123,
      "end_ms": 379381,
      "duration_ms": 4258,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりだけのみせがとても多くなっています。",
          "start_ms": 375123,
          "end_ms": 379381,
          "duration_ms": 4258
        }
      ]
    },
    {
      "index": 53,
      "text": "世界の人も食べるようになり、おにぎりをひょうかする人も多くなっています。",
      "start_ms": 379881,
      "end_ms": 386975,
      "duration_ms": 7094,
      "clauses": [
        {
          "index": 0,
          "text": "世界の人も食べるようになり、",
          "start_ms": 379881,
          "end_ms": 382827,
          "duration_ms": 2946
        },
        {
          "index": 1,
          "text": "おにぎりをひょうかする人も多くなっています。",
          "start_ms": 383077,
          "end_ms": 386975,
          "duration_ms": 3898
        }
      ]
    },
    {
      "index": 54,
      "text": "2024年、えいごの大きなじしょに「onigiri」が出ました。",
      "start_ms": 387475,
      "end_ms": 393037,
      "duration_ms": 5562,
      "clauses": [
        {
          "index": 0,
          "text": "2024年、",
          "start_ms": 387475,
          "end_ms": 389597,
          "duration_ms": 2122
        },
        {
          "index": 1,
          "text": "えいごの大きなじしょに「onigiri」が出ました。",
          "start_ms": 389847,
          "end_ms": 393037,
          "duration_ms": 3190
        }
      ]
    },
    {
      "index": 55,
      "text": "にほんごのなまえで知られたしょうこです。",
      "start_ms": 393537,
      "end_ms": 396773,
      "duration_ms": 3236,
      "clauses": [
        {
          "index": 0,
          "text": "にほんごのなまえで知られたしょうこです。",
          "start_ms": 393537,
          "end_ms": 396773,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 56,
      "text": "おにぎりは、いろいろなようすになり、世界にも広がっています。",
      "start_ms": 397273,
      "end_ms": 404533,
      "duration_ms": 7260,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 397273,
          "end_ms": 398919,
          "duration_ms": 1646
        },
        {
          "index": 1,
          "text": "いろいろなようすになり、",
          "start_ms": 399169,
          "end_ms": 401523,
          "duration_ms": 2354
        },
        {
          "index": 2,
          "text": "世界にも広がっています。",
          "start_ms": 401773,
          "end_ms": 404533,
          "duration_ms": 2760
        }
      ]
    },
    {
      "index": 57,
      "text": "でも、こめを手でまとめてみんなで食べるちゅうしんは、今もあります。",
      "start_ms": 405033,
      "end_ms": 412582,
      "duration_ms": 7549,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 405033,
          "end_ms": 406028,
          "duration_ms": 995
        },
        {
          "index": 1,
          "text": "こめを手でまとめてみんなで食べるちゅうしんは、",
          "start_ms": 406278,
          "end_ms": 410547,
          "duration_ms": 4269
        },
        {
          "index": 2,
          "text": "今もあります。",
          "start_ms": 410797,
          "end_ms": 412582,
          "duration_ms": 1785
        }
      ]
    },
    {
      "index": 58,
      "text": "これからも、にほんのおにぎりはみんなに食べられていくでしょう。",
      "start_ms": 413082,
      "end_ms": 419224,
      "duration_ms": 6142,
      "clauses": [
        {
          "index": 0,
          "text": "これからも、",
          "start_ms": 413082,
          "end_ms": 414681,
          "duration_ms": 1599
        },
        {
          "index": 1,
          "text": "にほんのおにぎりはみんなに食べられていくでしょう。",
          "start_ms": 414931,
          "end_ms": 419224,
          "duration_ms": 4293
        }
      ]
    }
  ]
