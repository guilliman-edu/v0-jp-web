  "sentences": [
    {
      "index": 0,
      "text": "「おにぎり」のなまえとれきし ― にほんのおにぎりから世界へ",
      "start_ms": 0,
      "end_ms": 4513,
      "duration_ms": 4513,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」のなまえとれきし ― にほんのおにぎりから世界へ",
          "start_ms": 0,
          "end_ms": 4513,
          "duration_ms": 4513
        }
      ]
    },
    {
      "index": 1,
      "text": "にほんでは2025年、きおんが高くてこめが買えなくなり、お金も高くなりました。",
      "start_ms": 5013,
      "end_ms": 14746,
      "duration_ms": 9733,
      "clauses": [
        {
          "index": 0,
          "text": "にほんでは2025年、",
          "start_ms": 5013,
          "end_ms": 8168,
          "duration_ms": 3155
        },
        {
          "index": 1,
          "text": "きおんが高くてこめが買えなくなり、",
          "start_ms": 8418,
          "end_ms": 11817,
          "duration_ms": 3399
        },
        {
          "index": 2,
          "text": "お金も高くなりました。",
          "start_ms": 12067,
          "end_ms": 14746,
          "duration_ms": 2679
        }
      ]
    },
    {
      "index": 2,
      "text": "いつも買えると思ってきたのに買えなくなると、にほんでは長いあいだ、こめがせいかつの中でとても大切なものだと、みんなが気がつきました。",
      "start_ms": 15246,
      "end_ms": 29405,
      "duration_ms": 14159,
      "clauses": [
        {
          "index": 0,
          "text": "いつも買えると思ってきたのに買えなくなると、",
          "start_ms": 15246,
          "end_ms": 19353,
          "duration_ms": 4107
        },
        {
          "index": 1,
          "text": "にほんでは長いあいだ、",
          "start_ms": 19603,
          "end_ms": 22003,
          "duration_ms": 2400
        },
        {
          "index": 2,
          "text": "こめがせいかつの中でとても大切なものだと、",
          "start_ms": 22253,
          "end_ms": 26848,
          "duration_ms": 4595
        },
        {
          "index": 3,
          "text": "みんなが気がつきました。",
          "start_ms": 27098,
          "end_ms": 29405,
          "duration_ms": 2307
        }
      ]
    },
    {
      "index": 3,
      "text": "そこで、みんなが知っている毎日のたべもの「おにぎり」にちゅうもくする人が出ました。",
      "start_ms": 29905,
      "end_ms": 37022,
      "duration_ms": 7117,
      "clauses": [
        {
          "index": 0,
          "text": "そこで、",
          "start_ms": 29905,
          "end_ms": 31098,
          "duration_ms": 1193
        },
        {
          "index": 1,
          "text": "みんなが知っている毎日のたべもの「おにぎり」にちゅうもくする人が出ました。",
          "start_ms": 31348,
          "end_ms": 37022,
          "duration_ms": 5674
        }
      ]
    },
    {
      "index": 4,
      "text": "そのれきしを見てみましょう。",
      "start_ms": 37522,
      "end_ms": 40317,
      "duration_ms": 2795,
      "clauses": [
        {
          "index": 0,
          "text": "そのれきしを見てみましょう。",
          "start_ms": 37522,
          "end_ms": 40317,
          "duration_ms": 2795
        }
      ]
    },
    {
      "index": 5,
      "text": "おにぎりは、いつからあったのか、はっきりしていません。",
      "start_ms": 40817,
      "end_ms": 47322,
      "duration_ms": 6505,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 40817,
          "end_ms": 42439,
          "duration_ms": 1622
        },
        {
          "index": 1,
          "text": "いつからあったのか、",
          "start_ms": 42689,
          "end_ms": 44904,
          "duration_ms": 2215
        },
        {
          "index": 2,
          "text": "はっきりしていません。",
          "start_ms": 45154,
          "end_ms": 47322,
          "duration_ms": 2168
        }
      ]
    },
    {
      "index": 6,
      "text": "にほんでこめを作るようになってから、人は作ったこめを手でまとめていたと考えられています。",
      "start_ms": 47822,
      "end_ms": 56867,
      "duration_ms": 9045,
      "clauses": [
        {
          "index": 0,
          "text": "にほんでこめを作るようになってから、",
          "start_ms": 47822,
          "end_ms": 51128,
          "duration_ms": 3306
        },
        {
          "index": 1,
          "text": "人は作ったこめを手でまとめていたと考えられています。",
          "start_ms": 51378,
          "end_ms": 56867,
          "duration_ms": 5489
        }
      ]
    },
    {
      "index": 7,
      "text": "にほんのあるばしょでは、2000年前のこめが出たこともあります。",
      "start_ms": 57367,
      "end_ms": 63509,
      "duration_ms": 6142,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのあるばしょでは、",
          "start_ms": 57367,
          "end_ms": 59698,
          "duration_ms": 2331
        },
        {
          "index": 1,
          "text": "2000年前のこめが出たこともあります。",
          "start_ms": 59948,
          "end_ms": 63509,
          "duration_ms": 3561
        }
      ]
    },
    {
      "index": 8,
      "text": "手で作ったのではなく、ほかのしゅだんで作られたと考えられているものもあります。",
      "start_ms": 64009,
      "end_ms": 71788,
      "duration_ms": 7779,
      "clauses": [
        {
          "index": 0,
          "text": "手で作ったのではなく、",
          "start_ms": 64009,
          "end_ms": 66456,
          "duration_ms": 2447
        },
        {
          "index": 1,
          "text": "ほかのしゅだんで作られたと考えられているものもあります。",
          "start_ms": 66706,
          "end_ms": 71788,
          "duration_ms": 5082
        }
      ]
    },
    {
      "index": 9,
      "text": "そして、それを「むかしのおにぎりのしょうこ」と言っています。",
      "start_ms": 72288,
      "end_ms": 77965,
      "duration_ms": 5677,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 72288,
          "end_ms": 73643,
          "duration_ms": 1355
        },
        {
          "index": 1,
          "text": "それを「むかしのおにぎりのしょうこ」と言っています。",
          "start_ms": 73893,
          "end_ms": 77965,
          "duration_ms": 4072
        }
      ]
    },
    {
      "index": 10,
      "text": "このこめについては、人によって違う説明をしています。",
      "start_ms": 78465,
      "end_ms": 84537,
      "duration_ms": 6072,
      "clauses": [
        {
          "index": 0,
          "text": "このこめについては、",
          "start_ms": 78465,
          "end_ms": 80703,
          "duration_ms": 2238
        },
        {
          "index": 1,
          "text": "人によって違う説明をしています。",
          "start_ms": 80953,
          "end_ms": 84537,
          "duration_ms": 3584
        }
      ]
    },
    {
      "index": 11,
      "text": "大切なのは、こめを手でまとめて持ちやすくすることを、にほんではとてもむかしからやっていることです。",
      "start_ms": 85037,
      "end_ms": 95199,
      "duration_ms": 10162,
      "clauses": [
        {
          "index": 0,
          "text": "大切なのは、",
          "start_ms": 85037,
          "end_ms": 86950,
          "duration_ms": 1913
        },
        {
          "index": 1,
          "text": "こめを手でまとめて持ちやすくすることを、",
          "start_ms": 87200,
          "end_ms": 90819,
          "duration_ms": 3619
        },
        {
          "index": 2,
          "text": "にほんではとてもむかしからやっていることです。",
          "start_ms": 91069,
          "end_ms": 95199,
          "duration_ms": 4130
        }
      ]
    },
    {
      "index": 12,
      "text": "むかしの本には、にほんごで「にぎりいい」と書かれたことばが出ています。",
      "start_ms": 95699,
      "end_ms": 102062,
      "duration_ms": 6363,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 95699,
          "end_ms": 97693,
          "duration_ms": 1994
        },
        {
          "index": 1,
          "text": "にほんごで「にぎりいい」と書かれたことばが出ています。",
          "start_ms": 97943,
          "end_ms": 102062,
          "duration_ms": 4119
        }
      ]
    },
    {
      "index": 13,
      "text": "人はたべものを持って会い、こめをみんなで食べていました。",
      "start_ms": 102562,
      "end_ms": 108855,
      "duration_ms": 6293,
      "clauses": [
        {
          "index": 0,
          "text": "人はたべものを持って会い、",
          "start_ms": 102562,
          "end_ms": 105729,
          "duration_ms": 3167
        },
        {
          "index": 1,
          "text": "こめをみんなで食べていました。",
          "start_ms": 105979,
          "end_ms": 108855,
          "duration_ms": 2876
        }
      ]
    },
    {
      "index": 14,
      "text": "その使い方は、とてもみじかなものでした。",
      "start_ms": 109355,
      "end_ms": 114452,
      "duration_ms": 5097,
      "clauses": [
        {
          "index": 0,
          "text": "その使い方は、",
          "start_ms": 109355,
          "end_ms": 111488,
          "duration_ms": 2133
        },
        {
          "index": 1,
          "text": "とてもみじかなものでした。",
          "start_ms": 111738,
          "end_ms": 114452,
          "duration_ms": 2714
        }
      ]
    },
    {
      "index": 15,
      "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
      "start_ms": 114952,
      "end_ms": 120359,
      "duration_ms": 5407,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
          "start_ms": 114952,
          "end_ms": 120359,
          "duration_ms": 5407
        }
      ]
    },
    {
      "index": 16,
      "text": "にほんではむかし、「にぎりいい」と言っていました。",
      "start_ms": 120859,
      "end_ms": 125701,
      "duration_ms": 4842,
      "clauses": [
        {
          "index": 0,
          "text": "にほんではむかし、",
          "start_ms": 120859,
          "end_ms": 122969,
          "duration_ms": 2110
        },
        {
          "index": 1,
          "text": "「にぎりいい」と言っていました。",
          "start_ms": 123219,
          "end_ms": 125701,
          "duration_ms": 2482
        }
      ]
    },
    {
      "index": 17,
      "text": "「にぎりいい」が使われているうちに、「にぎりめし」というなまえのことばに換えました。",
      "start_ms": 126201,
      "end_ms": 133121,
      "duration_ms": 6920,
      "clauses": [
        {
          "index": 0,
          "text": "「にぎりいい」が使われているうちに、",
          "start_ms": 126201,
          "end_ms": 129124,
          "duration_ms": 2923
        },
        {
          "index": 1,
          "text": "「にぎりめし」というなまえのことばに換えました。",
          "start_ms": 129374,
          "end_ms": 133121,
          "duration_ms": 3747
        }
      ]
    },
    {
      "index": 18,
      "text": "さらに、けいごの「お」を付けたなまえが「おにぎり」です。",
      "start_ms": 133621,
      "end_ms": 138613,
      "duration_ms": 4992,
      "clauses": [
        {
          "index": 0,
          "text": "さらに、",
          "start_ms": 133621,
          "end_ms": 134918,
          "duration_ms": 1297
        },
        {
          "index": 1,
          "text": "けいごの「お」を付けたなまえが「おにぎり」です。",
          "start_ms": 135168,
          "end_ms": 138613,
          "duration_ms": 3445
        }
      ]
    },
    {
      "index": 19,
      "text": "「おにぎり」をせつめいすることばは、「おむすび」もあります。",
      "start_ms": 139113,
      "end_ms": 144489,
      "duration_ms": 5376,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」をせつめいすることばは、",
          "start_ms": 139113,
          "end_ms": 142071,
          "duration_ms": 2958
        },
        {
          "index": 1,
          "text": "「おむすび」もあります。",
          "start_ms": 142321,
          "end_ms": 144489,
          "duration_ms": 2168
        }
      ]
    },
    {
      "index": 20,
      "text": "「むすび」というなまえをみんなが使い始めたのは、えどじだいです。",
      "start_ms": 144989,
      "end_ms": 151561,
      "duration_ms": 6572,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」というなまえをみんなが使い始めたのは、",
          "start_ms": 144989,
          "end_ms": 149340,
          "duration_ms": 4351
        },
        {
          "index": 1,
          "text": "えどじだいです。",
          "start_ms": 149590,
          "end_ms": 151561,
          "duration_ms": 1971
        }
      ]
    },
    {
      "index": 21,
      "text": "そこにもけいごの「お」を付けました。",
      "start_ms": 152061,
      "end_ms": 155053,
      "duration_ms": 2992,
      "clauses": [
        {
          "index": 0,
          "text": "そこにもけいごの「お」を付けました。",
          "start_ms": 152061,
          "end_ms": 155053,
          "duration_ms": 2992
        }
      ]
    },
    {
      "index": 22,
      "text": "むかしの本には、「むすび」を「にぎりいい」の別のなまえと書いて、「もとは女のことばです」とも書かれています。",
      "start_ms": 155553,
      "end_ms": 165726,
      "duration_ms": 10173,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 155553,
          "end_ms": 157570,
          "duration_ms": 2017
        },
        {
          "index": 1,
          "text": "「むすび」を「にぎりいい」の別のなまえと書いて、",
          "start_ms": 157820,
          "end_ms": 161416,
          "duration_ms": 3596
        },
        {
          "index": 2,
          "text": "「もとは女のことばです」とも書かれています。",
          "start_ms": 161666,
          "end_ms": 165726,
          "duration_ms": 4060
        }
      ]
    },
    {
      "index": 23,
      "text": "「むすび」は、なまえのいみをあらわすだけのことばではありません。",
      "start_ms": 166226,
      "end_ms": 172286,
      "duration_ms": 6060,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」は、",
          "start_ms": 166226,
          "end_ms": 167790,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "なまえのいみをあらわすだけのことばではありません。",
          "start_ms": 168040,
          "end_ms": 172286,
          "duration_ms": 4246
        }
      ]
    },
    {
      "index": 24,
      "text": "かみさまのなまえも、むかしの本に出ています。",
      "start_ms": 172786,
      "end_ms": 177848,
      "duration_ms": 5062,
      "clauses": [
        {
          "index": 0,
          "text": "かみさまのなまえも、",
          "start_ms": 172786,
          "end_ms": 175035,
          "duration_ms": 2249
        },
        {
          "index": 1,
          "text": "むかしの本に出ています。",
          "start_ms": 175285,
          "end_ms": 177848,
          "duration_ms": 2563
        }
      ]
    },
    {
      "index": 25,
      "text": "そこに、何かを作るいみとか、人と人がつながるいみとかが加わっているのです。",
      "start_ms": 178348,
      "end_ms": 186919,
      "duration_ms": 8571,
      "clauses": [
        {
          "index": 0,
          "text": "そこに、",
          "start_ms": 178348,
          "end_ms": 179657,
          "duration_ms": 1309
        },
        {
          "index": 1,
          "text": "何かを作るいみとか、",
          "start_ms": 179907,
          "end_ms": 182400,
          "duration_ms": 2493
        },
        {
          "index": 2,
          "text": "人と人がつながるいみとかが加わっているのです。",
          "start_ms": 182650,
          "end_ms": 186919,
          "duration_ms": 4269
        }
      ]
    },
    {
      "index": 26,
      "text": "つまり、「むすび」は、いみがさまざまに加わったことばということです。",
      "start_ms": 187419,
      "end_ms": 195061,
      "duration_ms": 7642,
      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 187419,
          "end_ms": 188809,
          "duration_ms": 1390
        },
        {
          "index": 1,
          "text": "「むすび」は、",
          "start_ms": 189059,
          "end_ms": 190623,
          "duration_ms": 1564
        },
        {
          "index": 2,
          "text": "いみがさまざまに加わったことばということです。",
          "start_ms": 190873,
          "end_ms": 195061,
          "duration_ms": 4188
        }
      ]
    },
    {
      "index": 27,
      "text": "もちろん、「むすび」というなまえがかみさまとつながっているとは言えません。",
      "start_ms": 195561,
      "end_ms": 202655,
      "duration_ms": 7094,
      "clauses": [
        {
          "index": 0,
          "text": "もちろん、",
          "start_ms": 195561,
          "end_ms": 197160,
          "duration_ms": 1599
        },
        {
          "index": 1,
          "text": "「むすび」というなまえがかみさまとつながっているとは言えません。",
          "start_ms": 197410,
          "end_ms": 202655,
          "duration_ms": 5245
        }
      ]
    },
    {
      "index": 28,
      "text": "でも、ことばのいみがさまざまに加わっていることにちゅうもくすると、この毎日のたべものがにほんに住む人にとって、大切ないみを持つのでしょう。",
      "start_ms": 203155,
      "end_ms": 217047,
      "duration_ms": 13892,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 203155,
          "end_ms": 204150,
          "duration_ms": 995
        },
        {
          "index": 1,
          "text": "ことばのいみがさまざまに加わっていることにちゅうもくすると、",
          "start_ms": 204400,
          "end_ms": 209424,
          "duration_ms": 5024
        },
        {
          "index": 2,
          "text": "この毎日のたべものがにほんに住む人にとって、",
          "start_ms": 209674,
          "end_ms": 213967,
          "duration_ms": 4293
        },
        {
          "index": 3,
          "text": "大切ないみを持つのでしょう。",
          "start_ms": 214217,
          "end_ms": 217047,
          "duration_ms": 2830
        }
      ]
    },
    {
      "index": 29,
      "text": "こめを作る仕事は、一人では終わりません。",
      "start_ms": 217547,
      "end_ms": 222574,
      "duration_ms": 5027,
      "clauses": [
        {
          "index": 0,
          "text": "こめを作る仕事は、",
          "start_ms": 217547,
          "end_ms": 219854,
          "duration_ms": 2307
        },
        {
          "index": 1,
          "text": "一人では終わりません。",
          "start_ms": 220104,
          "end_ms": 222574,
          "duration_ms": 2470
        }
      ]
    },
    {
      "index": 30,
      "text": "みんなでみずを集め、みんなで使います。",
      "start_ms": 223074,
      "end_ms": 227625,
      "duration_ms": 4551,
      "clauses": [
        {
          "index": 0,
          "text": "みんなでみずを集め、",
          "start_ms": 223074,
          "end_ms": 225335,
          "duration_ms": 2261
        },
        {
          "index": 1,
          "text": "みんなで使います。",
          "start_ms": 225585,
          "end_ms": 227625,
          "duration_ms": 2040
        }
      ]
    },
    {
      "index": 31,
      "text": "みずをまもるのも、こめをうえるのも、みんなの仕事です。",
      "start_ms": 228125,
      "end_ms": 234921,
      "duration_ms": 6796,
      "clauses": [
        {
          "index": 0,
          "text": "みずをまもるのも、",
          "start_ms": 228125,
          "end_ms": 230200,
          "duration_ms": 2075
        },
        {
          "index": 1,
          "text": "こめをうえるのも、",
          "start_ms": 230450,
          "end_ms": 232456,
          "duration_ms": 2006
        },
        {
          "index": 2,
          "text": "みんなの仕事です。",
          "start_ms": 232706,
          "end_ms": 234921,
          "duration_ms": 2215
        }
      ]
    },
    {
      "index": 32,
      "text": "そして、作ったこめをみんなで食べるのに、とてもいいたべものが「おにぎり」です。",
      "start_ms": 235421,
      "end_ms": 243610,
      "duration_ms": 8189,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 235421,
          "end_ms": 236742,
          "duration_ms": 1321
        },
        {
          "index": 1,
          "text": "作ったこめをみんなで食べるのに、",
          "start_ms": 236992,
          "end_ms": 240275,
          "duration_ms": 3283
        },
        {
          "index": 2,
          "text": "とてもいいたべものが「おにぎり」です。",
          "start_ms": 240525,
          "end_ms": 243610,
          "duration_ms": 3085
        }
      ]
    },
    {
      "index": 33,
      "text": "じしんのとき、にほんではよく「おにぎり」が出ます。",
      "start_ms": 244110,
      "end_ms": 249602,
      "duration_ms": 5492,
      "clauses": [
        {
          "index": 0,
          "text": "じしんのとき、",
          "start_ms": 244110,
          "end_ms": 245976,
          "duration_ms": 1866
        },
        {
          "index": 1,
          "text": "にほんではよく「おにぎり」が出ます。",
          "start_ms": 246226,
          "end_ms": 249602,
          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 34,
      "text": "持ちやすく、作るのも楽で、食べるのに何も要りません。",
      "start_ms": 250102,
      "end_ms": 257222,
      "duration_ms": 7120,
      "clauses": [
        {
          "index": 0,
          "text": "持ちやすく、",
          "start_ms": 250102,
          "end_ms": 251794,
          "duration_ms": 1692
        },
        {
          "index": 1,
          "text": "作るのも楽で、",
          "start_ms": 252044,
          "end_ms": 254119,
          "duration_ms": 2075
        },
        {
          "index": 2,
          "text": "食べるのに何も要りません。",
          "start_ms": 254369,
          "end_ms": 257222,
          "duration_ms": 2853
        }
      ]
    },
    {
      "index": 35,
      "text": "みんなにおにぎりを与えました。",
      "start_ms": 257722,
      "end_ms": 260552,
      "duration_ms": 2830,
      "clauses": [
        {
          "index": 0,
          "text": "みんなにおにぎりを与えました。",
          "start_ms": 257722,
          "end_ms": 260552,
          "duration_ms": 2830
        }
      ]
    },
    {
      "index": 36,
      "text": "そのとき、人は人と人がつながることを知りました。",
      "start_ms": 261052,
      "end_ms": 267275,
      "duration_ms": 6223,
      "clauses": [
        {
          "index": 0,
          "text": "そのとき、",
          "start_ms": 261052,
          "end_ms": 262709,
          "duration_ms": 1657
        },
        {
          "index": 1,
          "text": "人は人と人がつながることを知りました。",
          "start_ms": 262959,
          "end_ms": 267275,
          "duration_ms": 4316
        }
      ]
    },
    {
      "index": 37,
      "text": "2000年、にほんでは1月17日を「おむすびの日」にしました。",
      "start_ms": 267775,
      "end_ms": 274904,
      "duration_ms": 7129,
      "clauses": [
        {
          "index": 0,
          "text": "2000年、",
          "start_ms": 267775,
          "end_ms": 269351,
          "duration_ms": 1576
        },
        {
          "index": 1,
          "text": "にほんでは1月17日を「おむすびの日」にしました。",
          "start_ms": 269601,
          "end_ms": 274904,
          "duration_ms": 5303
        }
      ]
    },
    {
      "index": 38,
      "text": "「おにぎり」ではなく「おむすび」というなまえを使ったのは、人と人がつながることを大切にしたからです。",
      "start_ms": 275404,
      "end_ms": 284309,
      "duration_ms": 8905,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ではなく「おむすび」というなまえを使ったのは、",
          "start_ms": 275404,
          "end_ms": 279697,
          "duration_ms": 4293
        },
        {
          "index": 1,
          "text": "人と人がつながることを大切にしたからです。",
          "start_ms": 279947,
          "end_ms": 284309,
          "duration_ms": 4362
        }
      ]
    },
    {
      "index": 39,
      "text": "にほんは、うみの近くにあって、やまが多いくにです。",
      "start_ms": 284809,
      "end_ms": 291418,
      "duration_ms": 6609,
      "clauses": [
        {
          "index": 0,
          "text": "にほんは、",
          "start_ms": 284809,
          "end_ms": 286257,
          "duration_ms": 1448
        },
        {
          "index": 1,
          "text": "うみの近くにあって、",
          "start_ms": 286507,
          "end_ms": 288768,
          "duration_ms": 2261
        },
        {
          "index": 2,
          "text": "やまが多いくにです。",
          "start_ms": 289018,
          "end_ms": 291418,
          "duration_ms": 2400
        }
      ]
    },
    {
      "index": 40,
      "text": "「おにぎり」を見ると、にほんのやまとうみのようすが分かります。",
      "start_ms": 291918,
      "end_ms": 297700,
      "duration_ms": 5782,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」を見ると、",
          "start_ms": 291918,
          "end_ms": 293912,
          "duration_ms": 1994
        },
        {
          "index": 1,
          "text": "にほんのやまとうみのようすが分かります。",
          "start_ms": 294162,
          "end_ms": 297700,
          "duration_ms": 3538
        }
      ]
    },
    {
      "index": 41,
      "text": "やまの近くに住む人はやさいを使い、うみの近くに住む人はさかなを使います。",
      "start_ms": 298200,
      "end_ms": 306641,
      "duration_ms": 8441,
      "clauses": [
        {
          "index": 0,
          "text": "やまの近くに住む人はやさいを使い、",
          "start_ms": 298200,
          "end_ms": 302214,
          "duration_ms": 4014
        },
        {
          "index": 1,
          "text": "うみの近くに住む人はさかなを使います。",
          "start_ms": 302464,
          "end_ms": 306641,
          "duration_ms": 4177
        }
      ]
    },
    {
      "index": 42,
      "text": "「おにぎり」の中には、やまとうみのたべものが入っています。",
      "start_ms": 307141,
      "end_ms": 312992,
      "duration_ms": 5851,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」の中には、",
          "start_ms": 307141,
          "end_ms": 309297,
          "duration_ms": 2156
        },
        {
          "index": 1,
          "text": "やまとうみのたべものが入っています。",
          "start_ms": 309547,
          "end_ms": 312992,
          "duration_ms": 3445
        }
      ]
    },
    {
      "index": 43,
      "text": "そのさまざまなおにぎりが、にほんのたべもののとくちょうを表しています。",
      "start_ms": 313492,
      "end_ms": 320377,
      "duration_ms": 6885,
      "clauses": [
        {
          "index": 0,
          "text": "そのさまざまなおにぎりが、",
          "start_ms": 313492,
          "end_ms": 316171,
          "duration_ms": 2679
        },
        {
          "index": 1,
          "text": "にほんのたべもののとくちょうを表しています。",
          "start_ms": 316421,
          "end_ms": 320377,
          "duration_ms": 3956
        }
      ]
    },
    {
      "index": 44,
      "text": "今は、ほかのくにのたべものも、むかしは知らなかったなかみも多くなっています。",
      "start_ms": 320877,
      "end_ms": 329043,
      "duration_ms": 8166,
      "clauses": [
        {
          "index": 0,
          "text": "今は、",
          "start_ms": 320877,
          "end_ms": 321861,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "ほかのくにのたべものも、",
          "start_ms": 322111,
          "end_ms": 324674,
          "duration_ms": 2563
        },
        {
          "index": 2,
          "text": "むかしは知らなかったなかみも多くなっています。",
          "start_ms": 324924,
          "end_ms": 329043,
          "duration_ms": 4119
        }
      ]
    },
    {
      "index": 45,
      "text": "にほんのおにぎりは、さんかくけいがとても多いです。",
      "start_ms": 329543,
      "end_ms": 335163,
      "duration_ms": 5620,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのおにぎりは、",
          "start_ms": 329543,
          "end_ms": 331665,
          "duration_ms": 2122
        },
        {
          "index": 1,
          "text": "さんかくけいがとても多いです。",
          "start_ms": 331915,
          "end_ms": 335163,
          "duration_ms": 3248
        }
      ]
    },
    {
      "index": 46,
      "text": "コンビニのおにぎりになってから、そのようすが決まりました。",
      "start_ms": 335663,
      "end_ms": 341340,
      "duration_ms": 5677,
      "clauses": [
        {
          "index": 0,
          "text": "コンビニのおにぎりになってから、",
          "start_ms": 335663,
          "end_ms": 338458,
          "duration_ms": 2795
        },
        {
          "index": 1,
          "text": "そのようすが決まりました。",
          "start_ms": 338708,
          "end_ms": 341340,
          "duration_ms": 2632
        }
      ]
    },
    {
      "index": 47,
      "text": "さんかくけいは、持つ場合、壊さずに持ちやすいからです。",
      "start_ms": 341840,
      "end_ms": 348890,
      "duration_ms": 7050,
      "clauses": [
        {
          "index": 0,
          "text": "さんかくけいは、",
          "start_ms": 341840,
          "end_ms": 343764,
          "duration_ms": 1924
        },
        {
          "index": 1,
          "text": "持つ場合、",
          "start_ms": 344014,
          "end_ms": 345636,
          "duration_ms": 1622
        },
        {
          "index": 2,
          "text": "壊さずに持ちやすいからです。",
          "start_ms": 345886,
          "end_ms": 348890,
          "duration_ms": 3004
        }
      ]
    },
    {
      "index": 48,
      "text": "多く作って、多く運ぶのにも便利です。",
      "start_ms": 349390,
      "end_ms": 354313,
      "duration_ms": 4923,
      "clauses": [
        {
          "index": 0,
          "text": "多く作って、",
          "start_ms": 349390,
          "end_ms": 351152,
          "duration_ms": 1762
        },
        {
          "index": 1,
          "text": "多く運ぶのにも便利です。",
          "start_ms": 351402,
          "end_ms": 354313,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 49,
      "text": "むかしは、にほんでも、ばしょによってようすが違いました。",
      "start_ms": 354813,
      "end_ms": 361585,
      "duration_ms": 6772,
      "clauses": [
        {
          "index": 0,
          "text": "むかしは、",
          "start_ms": 354813,
          "end_ms": 356250,
          "duration_ms": 1437
        },
        {
          "index": 1,
          "text": "にほんでも、",
          "start_ms": 356500,
          "end_ms": 358157,
          "duration_ms": 1657
        },
        {
          "index": 2,
          "text": "ばしょによってようすが違いました。",
          "start_ms": 358407,
          "end_ms": 361585,
          "duration_ms": 3178
        }
      ]
    },
    {
      "index": 50,
      "text": "今は、いろいろななかみを入れて、食べやすくするためのようすもあります。",
      "start_ms": 362085,
      "end_ms": 369495,
      "duration_ms": 7410,
      "clauses": [
        {
          "index": 0,
          "text": "今は、",
          "start_ms": 362085,
          "end_ms": 363057,
          "duration_ms": 972
        },
        {
          "index": 1,
          "text": "いろいろななかみを入れて、",
          "start_ms": 363307,
          "end_ms": 365835,
          "duration_ms": 2528
        },
        {
          "index": 2,
          "text": "食べやすくするためのようすもあります。",
          "start_ms": 366085,
          "end_ms": 369495,
          "duration_ms": 3410
        }
      ]
    },
    {
      "index": 51,
      "text": "にほんのおにぎりは、世界でもちゅうもくされています。",
      "start_ms": 369995,
      "end_ms": 375486,
      "duration_ms": 5491,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのおにぎりは、",
          "start_ms": 369995,
          "end_ms": 372093,
          "duration_ms": 2098
        },
        {
          "index": 1,
          "text": "世界でもちゅうもくされています。",
          "start_ms": 372343,
          "end_ms": 375486,
          "duration_ms": 3143
        }
      ]
    },
    {
      "index": 52,
      "text": "おにぎりだけのみせがとても多くなっています。",
      "start_ms": 375986,
      "end_ms": 380232,
      "duration_ms": 4246,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりだけのみせがとても多くなっています。",
          "start_ms": 375986,
          "end_ms": 380232,
          "duration_ms": 4246
        }
      ]
    },
    {
      "index": 53,
      "text": "世界の人も食べるようになり、おにぎりをひょうかする人も多くなっています。",
      "start_ms": 380732,
      "end_ms": 387838,
      "duration_ms": 7106,
      "clauses": [
        {
          "index": 0,
          "text": "世界の人も食べるようになり、",
          "start_ms": 380732,
          "end_ms": 383632,
          "duration_ms": 2900
        },
        {
          "index": 1,
          "text": "おにぎりをひょうかする人も多くなっています。",
          "start_ms": 383882,
          "end_ms": 387838,
          "duration_ms": 3956
        }
      ]
    },
    {
      "index": 54,
      "text": "2024年、えいごの大きなじしょに「onigiri」が出ました。",
      "start_ms": 388338,
      "end_ms": 393830,
      "duration_ms": 5492,
      "clauses": [
        {
          "index": 0,
          "text": "2024年、",
          "start_ms": 388338,
          "end_ms": 390332,
          "duration_ms": 1994
        },
        {
          "index": 1,
          "text": "えいごの大きなじしょに「onigiri」が出ました。",
          "start_ms": 390582,
          "end_ms": 393830,
          "duration_ms": 3248
        }
      ]
    },
    {
      "index": 55,
      "text": "にほんごのなまえで知られたしょうこです。",
      "start_ms": 394330,
      "end_ms": 397682,
      "duration_ms": 3352,
      "clauses": [
        {
          "index": 0,
          "text": "にほんごのなまえで知られたしょうこです。",
          "start_ms": 394330,
          "end_ms": 397682,
          "duration_ms": 3352
        }
      ]
    },
    {
      "index": 56,
      "text": "おにぎりは、いろいろなようすになり、世界にも広がっています。",
      "start_ms": 398182,
      "end_ms": 405326,
      "duration_ms": 7144,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 398182,
          "end_ms": 399781,
          "duration_ms": 1599
        },
        {
          "index": 1,
          "text": "いろいろなようすになり、",
          "start_ms": 400031,
          "end_ms": 402327,
          "duration_ms": 2296
        },
        {
          "index": 2,
          "text": "世界にも広がっています。",
          "start_ms": 402577,
          "end_ms": 405326,
          "duration_ms": 2749
        }
      ]
    },
    {
      "index": 57,
      "text": "でも、こめを手でまとめてみんなで食べるちゅうしんは、今もあります。",
      "start_ms": 405826,
      "end_ms": 413480,
      "duration_ms": 7654,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 405826,
          "end_ms": 406833,
          "duration_ms": 1007
        },
        {
          "index": 1,
          "text": "こめを手でまとめてみんなで食べるちゅうしんは、",
          "start_ms": 407083,
          "end_ms": 411364,
          "duration_ms": 4281
        },
        {
          "index": 2,
          "text": "今もあります。",
          "start_ms": 411614,
          "end_ms": 413480,
          "duration_ms": 1866
        }
      ]
    },
    {
      "index": 58,
      "text": "これからも、にほんのおにぎりはみんなに食べられていくでしょう。",
      "start_ms": 413980,
      "end_ms": 420122,
      "duration_ms": 6142,
      "clauses": [
        {
          "index": 0,
          "text": "これからも、",
          "start_ms": 413980,
          "end_ms": 415614,
          "duration_ms": 1634
        },
        {
          "index": 1,
          "text": "にほんのおにぎりはみんなに食べられていくでしょう。",
          "start_ms": 415864,
          "end_ms": 420122,
          "duration_ms": 4258
        }
      ]
    }
  ]
