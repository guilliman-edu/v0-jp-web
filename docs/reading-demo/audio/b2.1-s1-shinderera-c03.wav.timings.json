{
  "audio_file": "b2.1-s1-shinderera-c03.wav",
  "sample_rate": 44100,
  "pause_ms": 500,
  "total_duration_ms": 221379,
  "sentences": [
    {
      "index": 0,
      "text": "ぶとうかいへのしょうたい",
      "start_ms": 0,
      "end_ms": 2151,
      "duration_ms": 2151,
      "clauses": [
        {
          "index": 0,
          "text": "ぶとうかいへのしょうたい",
          "start_ms": 0,
          "end_ms": 2151,
          "duration_ms": 2151
        }
      ]
    },
    {
      "index": 1,
      "text": "ところが、おうさまがお祝いを開くことになりました。",
      "start_ms": 2651,
      "end_ms": 7829,
      "duration_ms": 5178,
      "clauses": [
        {
          "index": 0,
          "text": "ところが、",
          "start_ms": 2651,
          "end_ms": 3954,
          "duration_ms": 1303
        },
        {
          "index": 1,
          "text": "おうさまがお祝いを開くことになりました。",
          "start_ms": 4204,
          "end_ms": 7829,
          "duration_ms": 3625
        }
      ]
    },
    {
      "index": 2,
      "text": "三日間続くお祝いで、おうさまの息子がはなよめを選ぶために、国のうつくしい若い娘は全部しょうたいされることになりました。",
      "start_ms": 8329,
      "end_ms": 19821,
      "duration_ms": 11492,
      "clauses": [
        {
          "index": 0,
          "text": "三日間続くお祝いで、",
          "start_ms": 8329,
          "end_ms": 10654,
          "duration_ms": 2325
        },
        {
          "index": 1,
          "text": "おうさまの息子がはなよめを選ぶために、",
          "start_ms": 10904,
          "end_ms": 14297,
          "duration_ms": 3393
        },
        {
          "index": 2,
          "text": "国のうつくしい若い娘は全部しょうたいされることになりました。",
          "start_ms": 14547,
          "end_ms": 19821,
          "duration_ms": 5274
        }
      ]
    },
    {
      "index": 3,
      "text": "二人のこいもうとは、自分たちもお祝いに行けると聞いて、とても喜びました。",
      "start_ms": 20321,
      "end_ms": 28086,
      "duration_ms": 7765,
      "clauses": [
        {
          "index": 0,
          "text": "二人のこいもうとは、",
          "start_ms": 20321,
          "end_ms": 22425,
          "duration_ms": 2104
        },
        {
          "index": 1,
          "text": "自分たちもお祝いに行けると聞いて、",
          "start_ms": 22675,
          "end_ms": 25708,
          "duration_ms": 3033
        },
        {
          "index": 2,
          "text": "とても喜びました。",
          "start_ms": 25958,
          "end_ms": 28086,
          "duration_ms": 2128
        }
      ]
    },
    {
      "index": 4,
      "text": "そして、シンデレラを呼びました。",
      "start_ms": 28586,
      "end_ms": 32348,
      "duration_ms": 3762,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 28586,
          "end_ms": 29796,
          "duration_ms": 1210
        },
        {
          "index": 1,
          "text": "シンデレラを呼びました。",
          "start_ms": 30046,
          "end_ms": 32348,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 5,
      "text": "「私たちの髪をとかして、靴を磨いて、ベルトをしめて。",
      "start_ms": 32848,
      "end_ms": 39325,
      "duration_ms": 6477,
      "clauses": [
        {
          "index": 0,
          "text": "「私たちの髪をとかして、",
          "start_ms": 32848,
          "end_ms": 35394,
          "duration_ms": 2546
        },
        {
          "index": 1,
          "text": "靴を磨いて、",
          "start_ms": 35644,
          "end_ms": 37342,
          "duration_ms": 1698
        },
        {
          "index": 2,
          "text": "ベルトをしめて。",
          "start_ms": 37592,
          "end_ms": 39325,
          "duration_ms": 1733
        }
      ]
    },
    {
      "index": 6,
      "text": "私たちはおうさまのきゅうでんのお祝いに行くのだから。」",
      "start_ms": 39825,
      "end_ms": 44379,
      "duration_ms": 4554,
      "clauses": [
        {
          "index": 0,
          "text": "私たちはおうさまのきゅうでんのお祝いに行くのだから。」",
          "start_ms": 39825,
          "end_ms": 44379,
          "duration_ms": 4554
        }
      ]
    },
    {
      "index": 7,
      "text": "シンデレラも行きたくて、泣きました。",
      "start_ms": 44879,
      "end_ms": 48908,
      "duration_ms": 4029,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラも行きたくて、",
          "start_ms": 44879,
          "end_ms": 47111,
          "duration_ms": 2232
        },
        {
          "index": 1,
          "text": "泣きました。",
          "start_ms": 47361,
          "end_ms": 48908,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 8,
      "text": "自分も一緒に踊りに行きたかったからです。",
      "start_ms": 49408,
      "end_ms": 53057,
      "duration_ms": 3649,
      "clauses": [
        {
          "index": 0,
          "text": "自分も一緒に踊りに行きたかったからです。",
          "start_ms": 49408,
          "end_ms": 53057,
          "duration_ms": 3649
        }
      ]
    },
    {
      "index": 9,
      "text": "それから、ままははにそうするきょかをもらおうと頼みました。",
      "start_ms": 53557,
      "end_ms": 59165,
      "duration_ms": 5608,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 53557,
          "end_ms": 54988,
          "duration_ms": 1431
        },
        {
          "index": 1,
          "text": "ままははにそうするきょかをもらおうと頼みました。",
          "start_ms": 55238,
          "end_ms": 59165,
          "duration_ms": 3927
        }
      ]
    },
    {
      "index": 10,
      "text": "「あなたは埃と泥まみれでしょう。",
      "start_ms": 59665,
      "end_ms": 62698,
      "duration_ms": 3033,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたは埃と泥まみれでしょう。",
          "start_ms": 59665,
          "end_ms": 62698,
          "duration_ms": 3033
        }
      ]
    },
    {
      "index": 11,
      "text": "それでぶとうかいに行くの？",
      "start_ms": 63198,
      "end_ms": 65558,
      "duration_ms": 2360,
      "clauses": [
        {
          "index": 0,
          "text": "それでぶとうかいに行くの？",
          "start_ms": 63198,
          "end_ms": 65558,
          "duration_ms": 2360
        }
      ]
    },
    {
      "index": 12,
      "text": "服もないし、靴もないのに、踊るっていうの？」",
      "start_ms": 66058,
      "end_ms": 71641,
      "duration_ms": 5583,
      "clauses": [
        {
          "index": 0,
          "text": "服もないし、",
          "start_ms": 66058,
          "end_ms": 67675,
          "duration_ms": 1617
        },
        {
          "index": 1,
          "text": "靴もないのに、",
          "start_ms": 67925,
          "end_ms": 69635,
          "duration_ms": 1710
        },
        {
          "index": 2,
          "text": "踊るっていうの？」",
          "start_ms": 69885,
          "end_ms": 71641,
          "duration_ms": 1756
        }
      ]
    },
    {
      "index": 13,
      "text": "でも、シンデレラがしつこく頼み続けたので、ままはははついにこう言いました。",
      "start_ms": 72141,
      "end_ms": 79697,
      "duration_ms": 7556,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 72141,
          "end_ms": 73026,
          "duration_ms": 885
        },
        {
          "index": 1,
          "text": "シンデレラがしつこく頼み続けたので、",
          "start_ms": 73276,
          "end_ms": 76541,
          "duration_ms": 3265
        },
        {
          "index": 2,
          "text": "ままはははついにこう言いました。",
          "start_ms": 76791,
          "end_ms": 79697,
          "duration_ms": 2906
        }
      ]
    },
    {
      "index": 14,
      "text": "「ほら、灰の中にレンズ豆を一皿空けておいたから。",
      "start_ms": 80197,
      "end_ms": 85027,
      "duration_ms": 4830,
      "clauses": [
        {
          "index": 0,
          "text": "「ほら、",
          "start_ms": 80197,
          "end_ms": 80873,
          "duration_ms": 676
        },
        {
          "index": 1,
          "text": "灰の中にレンズ豆を一皿空けておいたから。",
          "start_ms": 81123,
          "end_ms": 85027,
          "duration_ms": 3904
        }
      ]
    },
    {
      "index": 15,
      "text": "二時間でそれを全部拾えたら、一緒に行ってあげるよ。」",
      "start_ms": 85527,
      "end_ms": 90810,
      "duration_ms": 5283,
      "clauses": [
        {
          "index": 0,
          "text": "二時間でそれを全部拾えたら、",
          "start_ms": 85527,
          "end_ms": 88456,
          "duration_ms": 2929
        },
        {
          "index": 1,
          "text": "一緒に行ってあげるよ。」",
          "start_ms": 88706,
          "end_ms": 90810,
          "duration_ms": 2104
        }
      ]
    },
    {
      "index": 16,
      "text": "娘は裏口から庭に出ました。",
      "start_ms": 91310,
      "end_ms": 94332,
      "duration_ms": 3022,
      "clauses": [
        {
          "index": 0,
          "text": "娘は裏口から庭に出ました。",
          "start_ms": 91310,
          "end_ms": 94332,
          "duration_ms": 3022
        }
      ]
    },
    {
      "index": 17,
      "text": "「お友達のハトさん、キジバトさん、空の下の小鳥さんたち、みんな。",
      "start_ms": 94832,
      "end_ms": 103094,
      "duration_ms": 8262,
      "clauses": [
        {
          "index": 0,
          "text": "「お友達のハトさん、",
          "start_ms": 94832,
          "end_ms": 96983,
          "duration_ms": 2151
        },
        {
          "index": 1,
          "text": "キジバトさん、",
          "start_ms": 97233,
          "end_ms": 98838,
          "duration_ms": 1605
        },
        {
          "index": 2,
          "text": "空の下の小鳥さんたち、",
          "start_ms": 99088,
          "end_ms": 101761,
          "duration_ms": 2673
        },
        {
          "index": 3,
          "text": "みんな。",
          "start_ms": 102011,
          "end_ms": 103094,
          "duration_ms": 1083
        }
      ]
    },
    {
      "index": 18,
      "text": "いい豆はかごに、悪い豆はみんなさんに。",
      "start_ms": 103594,
      "end_ms": 108215,
      "duration_ms": 4621,
      "clauses": [
        {
          "index": 0,
          "text": "いい豆はかごに、",
          "start_ms": 103594,
          "end_ms": 105431,
          "duration_ms": 1837
        },
        {
          "index": 1,
          "text": "悪い豆はみんなさんに。",
          "start_ms": 105681,
          "end_ms": 108215,
          "duration_ms": 2534
        }
      ]
    },
    {
      "index": 19,
      "text": "拾うのを手伝ってちょうだい。」",
      "start_ms": 108715,
      "end_ms": 111237,
      "duration_ms": 2522,
      "clauses": [
        {
          "index": 0,
          "text": "拾うのを手伝ってちょうだい。」",
          "start_ms": 108715,
          "end_ms": 111237,
          "duration_ms": 2522
        }
      ]
    },
    {
      "index": 20,
      "text": "すると、二羽の白いはとが台所の窓から入ってきました。",
      "start_ms": 111737,
      "end_ms": 117623,
      "duration_ms": 5886,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 111737,
          "end_ms": 112947,
          "duration_ms": 1210
        },
        {
          "index": 1,
          "text": "二羽の白いはとが台所の窓から入ってきました。",
          "start_ms": 113197,
          "end_ms": 117623,
          "duration_ms": 4426
        }
      ]
    },
    {
      "index": 21,
      "text": "そのあとでキジバトが来て、最後に空の下の小鳥たちが全部集まってきて、灰の中に降りました。",
      "start_ms": 118123,
      "end_ms": 127792,
      "duration_ms": 9669,
      "clauses": [
        {
          "index": 0,
          "text": "そのあとでキジバトが来て、",
          "start_ms": 118123,
          "end_ms": 120634,
          "duration_ms": 2511
        },
        {
          "index": 1,
          "text": "最後に空の下の小鳥たちが全部集まってきて、",
          "start_ms": 120884,
          "end_ms": 125345,
          "duration_ms": 4461
        },
        {
          "index": 2,
          "text": "灰の中に降りました。",
          "start_ms": 125595,
          "end_ms": 127792,
          "duration_ms": 2197
        }
      ]
    },
    {
      "index": 22,
      "text": "はとたちが頭をひょこひょこさせて、コッコッコッとつつき始めました。",
      "start_ms": 128292,
      "end_ms": 134899,
      "duration_ms": 6607,
      "clauses": [
        {
          "index": 0,
          "text": "はとたちが頭をひょこひょこさせて、",
          "start_ms": 128292,
          "end_ms": 131755,
          "duration_ms": 3463
        },
        {
          "index": 1,
          "text": "コッコッコッとつつき始めました。",
          "start_ms": 132005,
          "end_ms": 134899,
          "duration_ms": 2894
        }
      ]
    },
    {
      "index": 23,
      "text": "残りの鳥たちもコッコッコッと始めて、皿に全部の良い豆を集めました。",
      "start_ms": 135399,
      "end_ms": 142586,
      "duration_ms": 7187,
      "clauses": [
        {
          "index": 0,
          "text": "残りの鳥たちもコッコッコッと始めて、",
          "start_ms": 135399,
          "end_ms": 139071,
          "duration_ms": 3672
        },
        {
          "index": 1,
          "text": "皿に全部の良い豆を集めました。",
          "start_ms": 139321,
          "end_ms": 142586,
          "duration_ms": 3265
        }
      ]
    },
    {
      "index": 24,
      "text": "一時間もたたないうちに、小鳥たちは終わって、また飛び去りました。",
      "start_ms": 143086,
      "end_ms": 150456,
      "duration_ms": 7370,
      "clauses": [
        {
          "index": 0,
          "text": "一時間もたたないうちに、",
          "start_ms": 143086,
          "end_ms": 145550,
          "duration_ms": 2464
        },
        {
          "index": 1,
          "text": "小鳥たちは終わって、",
          "start_ms": 145800,
          "end_ms": 147904,
          "duration_ms": 2104
        },
        {
          "index": 2,
          "text": "また飛び去りました。",
          "start_ms": 148154,
          "end_ms": 150456,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 25,
      "text": "娘は皿をままははのところに持って行きました。",
      "start_ms": 150956,
      "end_ms": 155081,
      "duration_ms": 4125,
      "clauses": [
        {
          "index": 0,
          "text": "娘は皿をままははのところに持って行きました。",
          "start_ms": 150956,
          "end_ms": 155081,
          "duration_ms": 4125
        }
      ]
    },
    {
      "index": 26,
      "text": "嬉しくて、今度こそお祝いに行けると信じていました。",
      "start_ms": 155581,
      "end_ms": 160958,
      "duration_ms": 5377,
      "clauses": [
        {
          "index": 0,
          "text": "嬉しくて、",
          "start_ms": 155581,
          "end_ms": 157059,
          "duration_ms": 1478
        },
        {
          "index": 1,
          "text": "今度こそお祝いに行けると信じていました。",
          "start_ms": 157309,
          "end_ms": 160958,
          "duration_ms": 3649
        }
      ]
    },
    {
      "index": 27,
      "text": "でも、ままははは「だめよ、シンデレラ。",
      "start_ms": 161458,
      "end_ms": 166298,
      "duration_ms": 4840,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 161458,
          "end_ms": 162367,
          "duration_ms": 909
        },
        {
          "index": 1,
          "text": "ままははは「だめよ、",
          "start_ms": 162617,
          "end_ms": 164524,
          "duration_ms": 1907
        },
        {
          "index": 2,
          "text": "シンデレラ。",
          "start_ms": 164774,
          "end_ms": 166298,
          "duration_ms": 1524
        }
      ]
    },
    {
      "index": 28,
      "text": "服がないじゃないし、踊れないわ。",
      "start_ms": 166798,
      "end_ms": 170630,
      "duration_ms": 3832,
      "clauses": [
        {
          "index": 0,
          "text": "服がないじゃないし、",
          "start_ms": 166798,
          "end_ms": 168798,
          "duration_ms": 2000
        },
        {
          "index": 1,
          "text": "踊れないわ。",
          "start_ms": 169048,
          "end_ms": 170630,
          "duration_ms": 1582
        }
      ]
    },
    {
      "index": 29,
      "text": "ただ笑われるだけだよ。」",
      "start_ms": 171130,
      "end_ms": 173374,
      "duration_ms": 2244,
      "clauses": [
        {
          "index": 0,
          "text": "ただ笑われるだけだよ。」",
          "start_ms": 171130,
          "end_ms": 173374,
          "duration_ms": 2244
        }
      ]
    },
    {
      "index": 30,
      "text": "と言いました。",
      "start_ms": 173874,
      "end_ms": 175421,
      "duration_ms": 1547,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 173874,
          "end_ms": 175421,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 31,
      "text": "シンデレラが泣くと、ままははは「一時間で灰から二皿のレンズ豆を拾ったら、一緒に行ってあげるよ。」",
      "start_ms": 175921,
      "end_ms": 185463,
      "duration_ms": 9542,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラが泣くと、",
          "start_ms": 175921,
          "end_ms": 177956,
          "duration_ms": 2035
        },
        {
          "index": 1,
          "text": "ままははは「一時間で灰から二皿のレンズ豆を拾ったら、",
          "start_ms": 178206,
          "end_ms": 183120,
          "duration_ms": 4914
        },
        {
          "index": 2,
          "text": "一緒に行ってあげるよ。」",
          "start_ms": 183370,
          "end_ms": 185463,
          "duration_ms": 2093
        }
      ]
    },
    {
      "index": 32,
      "text": "と言いました。",
      "start_ms": 185963,
      "end_ms": 187510,
      "duration_ms": 1547,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 185963,
          "end_ms": 187510,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 33,
      "text": "娘はまた庭に行って、小鳥たちにてつだいを頼みました。",
      "start_ms": 188010,
      "end_ms": 193711,
      "duration_ms": 5701,
      "clauses": [
        {
          "index": 0,
          "text": "娘はまた庭に行って、",
          "start_ms": 188010,
          "end_ms": 190370,
          "duration_ms": 2360
        },
        {
          "index": 1,
          "text": "小鳥たちにてつだいを頼みました。",
          "start_ms": 190620,
          "end_ms": 193711,
          "duration_ms": 3091
        }
      ]
    },
    {
      "index": 34,
      "text": "今度は三十分もたたないうちに、全部の豆を集めました。",
      "start_ms": 194211,
      "end_ms": 200353,
      "duration_ms": 6142,
      "clauses": [
        {
          "index": 0,
          "text": "今度は三十分もたたないうちに、",
          "start_ms": 194211,
          "end_ms": 197476,
          "duration_ms": 3265
        },
        {
          "index": 1,
          "text": "全部の豆を集めました。",
          "start_ms": 197726,
