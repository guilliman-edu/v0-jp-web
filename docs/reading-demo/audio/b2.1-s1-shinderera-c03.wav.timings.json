{
  "audio_file": "b2.1-s1-shinderera-c03.wav",
  "sample_rate": 44100,
  "pause_ms": 500,
  "total_duration_ms": 220540,
  "sentences": [
    {
      "index": 0,
      "text": "舞踏会への招待",
      "start_ms": 0,
      "end_ms": 2139,
      "duration_ms": 2139,
      "clauses": [
        {
          "index": 0,
          "text": "舞踏会への招待",
          "start_ms": 0,
          "end_ms": 2139,
          "duration_ms": 2139
        }
      ]
    },
    {
      "index": 1,
      "text": "ところが、おうさまがお祝いを開くことになりました。",
      "start_ms": 2639,
      "end_ms": 7852,
      "duration_ms": 5213,
      "clauses": [
        {
          "index": 0,
          "text": "ところが、",
          "start_ms": 2639,
          "end_ms": 3977,
          "duration_ms": 1338
        },
        {
          "index": 1,
          "text": "おうさまがお祝いを開くことになりました。",
          "start_ms": 4227,
          "end_ms": 7852,
          "duration_ms": 3625
        }
      ]
    },
    {
      "index": 2,
      "text": "三日間続くお祝いで、おうさまの息子がはなよめを選ぶために、国のうつくしい若い娘は全部しょうたいされることになりました。",
      "start_ms": 8352,
      "end_ms": 19833,
      "duration_ms": 11481,
      "clauses": [
        {
          "index": 0,
          "text": "三日間続くお祝いで、",
          "start_ms": 8352,
          "end_ms": 10700,
          "duration_ms": 2348
        },
        {
          "index": 1,
          "text": "おうさまの息子がはなよめを選ぶために、",
          "start_ms": 10950,
          "end_ms": 14297,
          "duration_ms": 3347
        },
        {
          "index": 2,
          "text": "国のうつくしい若い娘は全部しょうたいされることになりました。",
          "start_ms": 14547,
          "end_ms": 19833,
          "duration_ms": 5286
        }
      ]
    },
    {
      "index": 3,
      "text": "二人のこいもうとは、自分たちもお祝いに行けると聞いて、とても喜びました。",
      "start_ms": 20333,
      "end_ms": 28110,
      "duration_ms": 7777,
      "clauses": [
        {
          "index": 0,
          "text": "二人のこいもうとは、",
          "start_ms": 20333,
          "end_ms": 22368,
          "duration_ms": 2035
        },
        {
          "index": 1,
          "text": "自分たちもお祝いに行けると聞いて、",
          "start_ms": 22618,
          "end_ms": 25721,
          "duration_ms": 3103
        },
        {
          "index": 2,
          "text": "とても喜びました。",
          "start_ms": 25971,
          "end_ms": 28110,
          "duration_ms": 2139
        }
      ]
    },
    {
      "index": 4,
      "text": "そして、シンデレラを呼びました。",
      "start_ms": 28610,
      "end_ms": 32419,
      "duration_ms": 3809,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 28610,
          "end_ms": 29867,
          "duration_ms": 1257
        },
        {
          "index": 1,
          "text": "シンデレラを呼びました。",
          "start_ms": 30117,
          "end_ms": 32419,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 5,
      "text": "「私たちの髪をとかして、靴を磨いて、ベルトをしめて。",
      "start_ms": 32919,
      "end_ms": 39338,
      "duration_ms": 6419,
      "clauses": [
        {
          "index": 0,
          "text": "「私たちの髪をとかして、",
          "start_ms": 32919,
          "end_ms": 35360,
          "duration_ms": 2441
        },
        {
          "index": 1,
          "text": "靴を磨いて、",
          "start_ms": 35610,
          "end_ms": 37355,
          "duration_ms": 1745
        },
        {
          "index": 2,
          "text": "ベルトをしめて。",
          "start_ms": 37605,
          "end_ms": 39338,
          "duration_ms": 1733
        }
      ]
    },
    {
      "index": 6,
      "text": "私たちはおうさまのきゅうでんのお祝いに行くのだから。",
      "start_ms": 39838,
      "end_ms": 44311,
      "duration_ms": 4473,
      "clauses": [
        {
          "index": 0,
          "text": "私たちはおうさまのきゅうでんのお祝いに行くのだから。",
          "start_ms": 39838,
          "end_ms": 44311,
          "duration_ms": 4473
        }
      ]
    },
    {
      "index": 7,
      "text": "」 シンデレラも行きたくて、泣きました。",
      "start_ms": 44811,
      "end_ms": 48782,
      "duration_ms": 3971,
      "clauses": [
        {
          "index": 0,
          "text": "」 シンデレラも行きたくて、",
          "start_ms": 44811,
          "end_ms": 47008,
          "duration_ms": 2197
        },
        {
          "index": 1,
          "text": "泣きました。",
          "start_ms": 47258,
          "end_ms": 48782,
          "duration_ms": 1524
        }
      ]
    },
    {
      "index": 8,
      "text": "自分も一緒に踊りに行きたかったからです。",
      "start_ms": 49282,
      "end_ms": 52791,
      "duration_ms": 3509,
      "clauses": [
        {
          "index": 0,
          "text": "自分も一緒に踊りに行きたかったからです。",
          "start_ms": 49282,
          "end_ms": 52791,
          "duration_ms": 3509
        }
      ]
    },
    {
      "index": 9,
      "text": "それから、ままははにそうするきょかをもらおうと頼みました。",
      "start_ms": 53291,
      "end_ms": 58853,
      "duration_ms": 5562,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 53291,
          "end_ms": 54699,
          "duration_ms": 1408
        },
        {
          "index": 1,
          "text": "ままははにそうするきょかをもらおうと頼みました。",
          "start_ms": 54949,
          "end_ms": 58853,
          "duration_ms": 3904
        }
      ]
    },
    {
      "index": 10,
      "text": "「あなたは埃と泥まみれでしょう。",
      "start_ms": 59353,
      "end_ms": 62409,
      "duration_ms": 3056,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたは埃と泥まみれでしょう。",
          "start_ms": 59353,
          "end_ms": 62409,
          "duration_ms": 3056
        }
      ]
    },
    {
      "index": 11,
      "text": "それでぶとうかいに行くの？",
      "start_ms": 62909,
      "end_ms": 65257,
      "duration_ms": 2348,
      "clauses": [
        {
          "index": 0,
          "text": "それでぶとうかいに行くの？",
          "start_ms": 62909,
          "end_ms": 65257,
          "duration_ms": 2348
        }
      ]
    },
    {
      "index": 12,
      "text": "服もないし、靴もないのに、踊るっていうの？",
      "start_ms": 65757,
      "end_ms": 71247,
      "duration_ms": 5490,
      "clauses": [
        {
          "index": 0,
          "text": "服もないし、",
          "start_ms": 65757,
          "end_ms": 67339,
          "duration_ms": 1582
        },
        {
          "index": 1,
          "text": "靴もないのに、",
          "start_ms": 67589,
          "end_ms": 69276,
          "duration_ms": 1687
        },
        {
          "index": 2,
          "text": "踊るっていうの？",
          "start_ms": 69526,
          "end_ms": 71247,
          "duration_ms": 1721
        }
      ]
    },
    {
      "index": 13,
      "text": "」 でも、シンデレラがしつこく頼み続けたので、ままはははついにこう言いました。",
      "start_ms": 71747,
      "end_ms": 79361,
      "duration_ms": 7614,
      "clauses": [
        {
          "index": 0,
          "text": "」 でも、",
          "start_ms": 71747,
          "end_ms": 72667,
          "duration_ms": 920
        },
        {
          "index": 1,
          "text": "シンデレラがしつこく頼み続けたので、",
          "start_ms": 72917,
          "end_ms": 76182,
          "duration_ms": 3265
        },
        {
          "index": 2,
          "text": "ままはははついにこう言いました。",
          "start_ms": 76432,
          "end_ms": 79361,
          "duration_ms": 2929
        }
      ]
    },
    {
      "index": 14,
      "text": "「ほら、灰の中にレンズ豆を一皿空けておいたから。",
      "start_ms": 79861,
      "end_ms": 84679,
      "duration_ms": 4818,
      "clauses": [
        {
          "index": 0,
          "text": "「ほら、",
          "start_ms": 79861,
          "end_ms": 80537,
          "duration_ms": 676
        },
        {
          "index": 1,
          "text": "灰の中にレンズ豆を一皿空けておいたから。",
          "start_ms": 80787,
          "end_ms": 84679,
          "duration_ms": 3892
        }
      ]
    },
    {
      "index": 15,
      "text": "二時間でそれを全部拾えたら、一緒に行ってあげるよ。",
      "start_ms": 85179,
      "end_ms": 90462,
      "duration_ms": 5283,
      "clauses": [
        {
          "index": 0,
          "text": "二時間でそれを全部拾えたら、",
          "start_ms": 85179,
          "end_ms": 88131,
          "duration_ms": 2952
        },
        {
          "index": 1,
          "text": "一緒に行ってあげるよ。",
          "start_ms": 88381,
          "end_ms": 90462,
          "duration_ms": 2081
        }
      ]
    },
    {
      "index": 16,
      "text": "」 娘は裏口から庭に出ました。",
      "start_ms": 90962,
      "end_ms": 94030,
      "duration_ms": 3068,
      "clauses": [
        {
          "index": 0,
          "text": "」 娘は裏口から庭に出ました。",
          "start_ms": 90962,
          "end_ms": 94030,
          "duration_ms": 3068
        }
      ]
    },
    {
      "index": 17,
      "text": "「お友達のハトさん、キジバトさん、空の下の小鳥さんたち、みんな。",
      "start_ms": 94530,
      "end_ms": 102757,
      "duration_ms": 8227,
      "clauses": [
        {
          "index": 0,
          "text": "「お友達のハトさん、",
          "start_ms": 94530,
          "end_ms": 96669,
          "duration_ms": 2139
        },
        {
          "index": 1,
          "text": "キジバトさん、",
          "start_ms": 96919,
          "end_ms": 98594,
          "duration_ms": 1675
        },
        {
          "index": 2,
          "text": "空の下の小鳥さんたち、",
          "start_ms": 98844,
          "end_ms": 101459,
          "duration_ms": 2615
        },
        {
          "index": 3,
          "text": "みんな。",
          "start_ms": 101709,
          "end_ms": 102757,
          "duration_ms": 1048
        }
      ]
    },
    {
      "index": 18,
      "text": "いい豆はかごに、悪い豆はみんなさんに。",
      "start_ms": 103257,
      "end_ms": 107913,
      "duration_ms": 4656,
      "clauses": [
        {
          "index": 0,
          "text": "いい豆はかごに、",
          "start_ms": 103257,
          "end_ms": 105106,
          "duration_ms": 1849
        },
        {
          "index": 1,
          "text": "悪い豆はみんなさんに。",
          "start_ms": 105356,
          "end_ms": 107913,
          "duration_ms": 2557
        }
      ]
    },
    {
      "index": 19,
      "text": "拾うのを手伝ってちょうだい。",
      "start_ms": 108413,
      "end_ms": 110889,
      "duration_ms": 2476,
      "clauses": [
        {
          "index": 0,
          "text": "拾うのを手伝ってちょうだい。",
          "start_ms": 108413,
          "end_ms": 110889,
          "duration_ms": 2476
        }
      ]
    },
    {
      "index": 20,
      "text": "」 すると、二羽の白いはとが台所の窓から入ってきました。",
      "start_ms": 111389,
      "end_ms": 117149,
      "duration_ms": 5760,
      "clauses": [
        {
          "index": 0,
          "text": "」 すると、",
          "start_ms": 111389,
          "end_ms": 112565,
          "duration_ms": 1176
        },
        {
          "index": 1,
          "text": "二羽の白いはとが台所の窓から入ってきました。",
          "start_ms": 112815,
          "end_ms": 117149,
          "duration_ms": 4334
        }
      ]
    },
    {
      "index": 21,
      "text": "そのあとでキジバトが来て、最後に空の下の小鳥たちが全部集まってきて、灰の中に降りました。",
      "start_ms": 117649,
      "end_ms": 127284,
      "duration_ms": 9635,
      "clauses": [
        {
          "index": 0,
          "text": "そのあとでキジバトが来て、",
          "start_ms": 117649,
          "end_ms": 120102,
          "duration_ms": 2453
        },
        {
          "index": 1,
          "text": "最後に空の下の小鳥たちが全部集まってきて、",
          "start_ms": 120352,
          "end_ms": 124813,
          "duration_ms": 4461
        },
        {
          "index": 2,
          "text": "灰の中に降りました。",
          "start_ms": 125063,
          "end_ms": 127284,
          "duration_ms": 2221
        }
      ]
    },
    {
      "index": 22,
      "text": "はとたちが頭をひょこひょこさせて、コッコッコッとつつき始めました。",
      "start_ms": 127784,
      "end_ms": 134356,
      "duration_ms": 6572,
      "clauses": [
        {
          "index": 0,
          "text": "はとたちが頭をひょこひょこさせて、",
          "start_ms": 127784,
          "end_ms": 131189,
          "duration_ms": 3405
        },
        {
          "index": 1,
          "text": "コッコッコッとつつき始めました。",
          "start_ms": 131439,
          "end_ms": 134356,
          "duration_ms": 2917
        }
      ]
    },
    {
      "index": 23,
      "text": "残りの鳥たちもコッコッコッと始めて、皿に全部の良い豆を集めました。",
      "start_ms": 134856,
      "end_ms": 141973,
      "duration_ms": 7117,
      "clauses": [
        {
          "index": 0,
          "text": "残りの鳥たちもコッコッコッと始めて、",
          "start_ms": 134856,
          "end_ms": 138481,
          "duration_ms": 3625
        },
        {
          "index": 1,
          "text": "皿に全部の良い豆を集めました。",
          "start_ms": 138731,
          "end_ms": 141973,
          "duration_ms": 3242
        }
      ]
    },
    {
      "index": 24,
      "text": "一時間もたたないうちに、小鳥たちは終わって、また飛び去りました。",
      "start_ms": 142473,
      "end_ms": 149820,
      "duration_ms": 7347,
      "clauses": [
        {
          "index": 0,
          "text": "一時間もたたないうちに、",
          "start_ms": 142473,
          "end_ms": 144937,
          "duration_ms": 2464
        },
        {
          "index": 1,
          "text": "小鳥たちは終わって、",
          "start_ms": 145187,
          "end_ms": 147303,
          "duration_ms": 2116
        },
        {
          "index": 2,
          "text": "また飛び去りました。",
          "start_ms": 147553,
          "end_ms": 149820,
          "duration_ms": 2267
        }
      ]
    },
    {
      "index": 25,
      "text": "娘は皿をままははのところに持って行きました。",
      "start_ms": 150320,
      "end_ms": 154421,
      "duration_ms": 4101,
      "clauses": [
        {
          "index": 0,
          "text": "娘は皿をままははのところに持って行きました。",
          "start_ms": 150320,
          "end_ms": 154421,
          "duration_ms": 4101
        }
      ]
    },
    {
      "index": 26,
      "text": "嬉しくて、今度こそお祝いに行けると信じていました。",
      "start_ms": 154921,
      "end_ms": 160250,
      "duration_ms": 5329,
      "clauses": [
        {
          "index": 0,
          "text": "嬉しくて、",
          "start_ms": 154921,
          "end_ms": 156340,
          "duration_ms": 1419
        },
        {
          "index": 1,
          "text": "今度こそお祝いに行けると信じていました。",
          "start_ms": 156590,
          "end_ms": 160250,
          "duration_ms": 3660
        }
      ]
    },
    {
      "index": 27,
      "text": "でも、ままははは「だめよ、シンデレラ。",
      "start_ms": 160750,
      "end_ms": 165542,
      "duration_ms": 4792,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 160750,
          "end_ms": 161635,
          "duration_ms": 885
        },
        {
          "index": 1,
          "text": "ままははは「だめよ、",
          "start_ms": 161885,
          "end_ms": 163780,
          "duration_ms": 1895
        },
        {
          "index": 2,
          "text": "シンデレラ。",
          "start_ms": 164030,
          "end_ms": 165542,
          "duration_ms": 1512
        }
      ]
    },
    {
      "index": 28,
      "text": "服がないじゃないし、踊れないわ。",
      "start_ms": 166042,
      "end_ms": 169885,
      "duration_ms": 3843,
      "clauses": [
        {
          "index": 0,
          "text": "服がないじゃないし、",
          "start_ms": 166042,
          "end_ms": 168065,
          "duration_ms": 2023
        },
        {
          "index": 1,
          "text": "踊れないわ。",
          "start_ms": 168315,
          "end_ms": 169885,
          "duration_ms": 1570
        }
      ]
    },
    {
      "index": 29,
      "text": "ただ笑われるだけだよ。",
      "start_ms": 170385,
      "end_ms": 172582,
      "duration_ms": 2197,
      "clauses": [
        {
          "index": 0,
          "text": "ただ笑われるだけだよ。",
          "start_ms": 170385,
          "end_ms": 172582,
          "duration_ms": 2197
        }
      ]
    },
    {
      "index": 30,
      "text": "」と言いました。",
      "start_ms": 173082,
      "end_ms": 174641,
      "duration_ms": 1559,
      "clauses": [
        {
          "index": 0,
          "text": "」と言いました。",
          "start_ms": 173082,
          "end_ms": 174641,
          "duration_ms": 1559
        }
      ]
    },
    {
      "index": 31,
      "text": "シンデレラが泣くと、ままははは「一時間で灰から二皿のレンズ豆を拾ったら、一緒に行ってあげるよ。",
      "start_ms": 175141,
      "end_ms": 184706,
      "duration_ms": 9565,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラが泣くと、",
          "start_ms": 175141,
          "end_ms": 177222,
          "duration_ms": 2081
        },
        {
          "index": 1,
          "text": "ままははは「一時間で灰から二皿のレンズ豆を拾ったら、",
          "start_ms": 177472,
          "end_ms": 182386,
          "duration_ms": 4914
        },
        {
          "index": 2,
          "text": "一緒に行ってあげるよ。",
          "start_ms": 182636,
          "end_ms": 184706,
          "duration_ms": 2070
        }
      ]
    },
    {
      "index": 32,
      "text": "」と言いました。",
      "start_ms": 185206,
      "end_ms": 186753,
      "duration_ms": 1547,
      "clauses": [
        {
          "index": 0,
          "text": "」と言いました。",
          "start_ms": 185206,
          "end_ms": 186753,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 33,
      "text": "娘はまた庭に行って、小鳥たちにてつだいを頼みました。",
      "start_ms": 187253,
      "end_ms": 192896,
      "duration_ms": 5643,
      "clauses": [
        {
          "index": 0,
          "text": "娘はまた庭に行って、",
          "start_ms": 187253,
          "end_ms": 189578,
          "duration_ms": 2325
        },
        {
          "index": 1,
          "text": "小鳥たちにてつだいを頼みました。",
          "start_ms": 189828,
          "end_ms": 192896,
          "duration_ms": 3068
        }
      ]
    },
    {
      "index": 34,
      "text": "今度は三十分もたたないうちに、全部の豆を集めました。",
      "start_ms": 193396,
      "end_ms": 199468,
      "duration_ms": 6072,
      "clauses": [
        {
          "index": 0,
          "text": "今度は三十分もたたないうちに、",
          "start_ms": 193396,
          "end_ms": 196603,
          "duration_ms": 3207
        },
        {
          "index": 1,
          "text": "全部の豆を集めました。",
          "start_ms": 196853,
