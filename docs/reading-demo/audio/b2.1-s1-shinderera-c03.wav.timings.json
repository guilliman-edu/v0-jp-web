{
  "audio_file": "b2.1-s1-shinderera-c03.wav",
  "sample_rate": 44100,
  "pause_ms": 500,
  "total_duration_ms": 220813,
  "sentences": [
    {
      "index": 0,
      "text": "ぶとうかいへのしょうたい",
      "start_ms": 0,
      "end_ms": 2116,
      "duration_ms": 2116,
      "clauses": [
        {
          "index": 0,
          "text": "ぶとうかいへのしょうたい",
          "start_ms": 0,
          "end_ms": 2116,
          "duration_ms": 2116
        }
      ]
    },
    {
      "index": 1,
      "text": "ところが、おうさまがお祝いを開くことになりました。",
      "start_ms": 2616,
      "end_ms": 7678,
      "duration_ms": 5062,
      "clauses": [
        {
          "index": 0,
          "text": "ところが、",
          "start_ms": 2616,
          "end_ms": 3896,
          "duration_ms": 1280
        },
        {
          "index": 1,
          "text": "おうさまがお祝いを開くことになりました。",
          "start_ms": 4146,
          "end_ms": 7678,
          "duration_ms": 3532
        }
      ]
    },
    {
      "index": 2,
      "text": "三日間続くお祝いで、おうさまの息子がはなよめを選ぶために、国のうつくしい若い娘は全部しょうたいされることになりました。",
      "start_ms": 8178,
      "end_ms": 19647,
      "duration_ms": 11469,
      "clauses": [
        {
          "index": 0,
          "text": "三日間続くお祝いで、",
          "start_ms": 8178,
          "end_ms": 10503,
          "duration_ms": 2325
        },
        {
          "index": 1,
          "text": "おうさまの息子がはなよめを選ぶために、",
          "start_ms": 10753,
          "end_ms": 14158,
          "duration_ms": 3405
        },
        {
          "index": 2,
          "text": "国のうつくしい若い娘は全部しょうたいされることになりました。",
          "start_ms": 14408,
          "end_ms": 19647,
          "duration_ms": 5239
        }
      ]
    },
    {
      "index": 3,
      "text": "二人のままむすめは、自分たちもお祝いに行けると聞いて、とても喜びました。",
      "start_ms": 20147,
      "end_ms": 28028,
      "duration_ms": 7881,
      "clauses": [
        {
          "index": 0,
          "text": "二人のままむすめは、",
          "start_ms": 20147,
          "end_ms": 22344,
          "duration_ms": 2197
        },
        {
          "index": 1,
          "text": "自分たちもお祝いに行けると聞いて、",
          "start_ms": 22594,
          "end_ms": 25639,
          "duration_ms": 3045
        },
        {
          "index": 2,
          "text": "とても喜びました。",
          "start_ms": 25889,
          "end_ms": 28028,
          "duration_ms": 2139
        }
      ]
    },
    {
      "index": 4,
      "text": "そして、シンデレラを呼びました。",
      "start_ms": 28528,
      "end_ms": 32325,
      "duration_ms": 3797,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 28528,
          "end_ms": 29773,
          "duration_ms": 1245
        },
        {
          "index": 1,
          "text": "シンデレラを呼びました。",
          "start_ms": 30023,
          "end_ms": 32325,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 5,
      "text": "「私たちの髪をとかして、靴を磨いて、ベルトをしめて。",
      "start_ms": 32825,
      "end_ms": 39383,
      "duration_ms": 6558,
      "clauses": [
        {
          "index": 0,
          "text": "「私たちの髪をとかして、",
          "start_ms": 32825,
          "end_ms": 35394,
          "duration_ms": 2569
        },
        {
          "index": 1,
          "text": "靴を磨いて、",
          "start_ms": 35644,
          "end_ms": 37400,
          "duration_ms": 1756
        },
        {
          "index": 2,
          "text": "ベルトをしめて。",
          "start_ms": 37650,
          "end_ms": 39383,
          "duration_ms": 1733
        }
      ]
    },
    {
      "index": 6,
      "text": "私たちはおうさまのきゅうでんのお祝いに行くのだから。」",
      "start_ms": 39883,
      "end_ms": 44426,
      "duration_ms": 4543,
      "clauses": [
        {
          "index": 0,
          "text": "私たちはおうさまのきゅうでんのお祝いに行くのだから。」",
          "start_ms": 39883,
          "end_ms": 44426,
          "duration_ms": 4543
        }
      ]
    },
    {
      "index": 7,
      "text": "シンデレラも行きたくて、泣きました。",
      "start_ms": 44926,
      "end_ms": 48920,
      "duration_ms": 3994,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラも行きたくて、",
          "start_ms": 44926,
          "end_ms": 47100,
          "duration_ms": 2174
        },
        {
          "index": 1,
          "text": "泣きました。",
          "start_ms": 47350,
          "end_ms": 48920,
          "duration_ms": 1570
        }
      ]
    },
    {
      "index": 8,
      "text": "自分も一緒に踊りに行きたかったからです。",
      "start_ms": 49420,
      "end_ms": 53022,
      "duration_ms": 3602,
      "clauses": [
        {
          "index": 0,
          "text": "自分も一緒に踊りに行きたかったからです。",
          "start_ms": 49420,
          "end_ms": 53022,
          "duration_ms": 3602
        }
      ]
    },
    {
      "index": 9,
      "text": "それから、ままははにそうするきょかをもらおうと頼みました。",
      "start_ms": 53522,
      "end_ms": 59130,
      "duration_ms": 5608,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 53522,
          "end_ms": 54918,
          "duration_ms": 1396
        },
        {
          "index": 1,
          "text": "ままははにそうするきょかをもらおうと頼みました。",
          "start_ms": 55168,
          "end_ms": 59130,
          "duration_ms": 3962
        }
      ]
    },
    {
      "index": 10,
      "text": "「あなたは埃と泥まみれでしょう。",
      "start_ms": 59630,
      "end_ms": 62675,
      "duration_ms": 3045,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたは埃と泥まみれでしょう。",
          "start_ms": 59630,
          "end_ms": 62675,
          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 11,
      "text": "それでぶとうかいに行くの？",
      "start_ms": 63175,
      "end_ms": 65465,
      "duration_ms": 2290,
      "clauses": [
        {
          "index": 0,
          "text": "それでぶとうかいに行くの？",
          "start_ms": 63175,
          "end_ms": 65465,
          "duration_ms": 2290
        }
      ]
    },
    {
      "index": 12,
      "text": "服もないし、靴もないのに、踊るっていうの？」",
      "start_ms": 65965,
      "end_ms": 71513,
      "duration_ms": 5548,
      "clauses": [
        {
          "index": 0,
          "text": "服もないし、",
          "start_ms": 65965,
          "end_ms": 67605,
          "duration_ms": 1640
        },
        {
          "index": 1,
          "text": "靴もないのに、",
          "start_ms": 67855,
          "end_ms": 69507,
          "duration_ms": 1652
        },
        {
          "index": 2,
          "text": "踊るっていうの？」",
          "start_ms": 69757,
          "end_ms": 71513,
          "duration_ms": 1756
        }
      ]
    },
    {
      "index": 13,
      "text": "でも、シンデレラがしつこく頼み続けたので、ままはははついにこう言いました。",
      "start_ms": 72013,
      "end_ms": 79523,
      "duration_ms": 7510,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 72013,
          "end_ms": 72910,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "シンデレラがしつこく頼み続けたので、",
          "start_ms": 73160,
          "end_ms": 76402,
          "duration_ms": 3242
        },
        {
          "index": 2,
          "text": "ままはははついにこう言いました。",
          "start_ms": 76652,
          "end_ms": 79523,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 14,
      "text": "「ほら、灰の中にレンズ豆を一皿空けておいたから。",
      "start_ms": 80023,
      "end_ms": 84912,
      "duration_ms": 4889,
      "clauses": [
        {
          "index": 0,
          "text": "「ほら、",
          "start_ms": 80023,
          "end_ms": 80723,
          "duration_ms": 700
        },
        {
          "index": 1,
          "text": "灰の中にレンズ豆を一皿空けておいたから。",
          "start_ms": 80973,
          "end_ms": 84912,
          "duration_ms": 3939
        }
      ]
    },
    {
      "index": 15,
      "text": "二時間でそれを全部拾えたら、一緒に行ってあげるよ。」",
      "start_ms": 85412,
      "end_ms": 90742,
      "duration_ms": 5330,
      "clauses": [
        {
          "index": 0,
          "text": "二時間でそれを全部拾えたら、",
          "start_ms": 85412,
          "end_ms": 88422,
          "duration_ms": 3010
        },
        {
          "index": 1,
          "text": "一緒に行ってあげるよ。」",
          "start_ms": 88672,
          "end_ms": 90742,
          "duration_ms": 2070
        }
      ]
    },
    {
      "index": 16,
      "text": "娘は裏口から庭に出ました。",
      "start_ms": 91242,
      "end_ms": 94240,
      "duration_ms": 2998,
      "clauses": [
        {
          "index": 0,
          "text": "娘は裏口から庭に出ました。",
          "start_ms": 91242,
          "end_ms": 94240,
          "duration_ms": 2998
        }
      ]
    },
    {
      "index": 17,
      "text": "「お友達のハトさん、キジバトさん、空の下の小鳥さんたち、みんな。",
      "start_ms": 94740,
      "end_ms": 102898,
      "duration_ms": 8158,
      "clauses": [
        {
          "index": 0,
          "text": "「お友達のハトさん、",
          "start_ms": 94740,
          "end_ms": 96856,
          "duration_ms": 2116
        },
        {
          "index": 1,
          "text": "キジバトさん、",
          "start_ms": 97106,
          "end_ms": 98665,
          "duration_ms": 1559
        },
        {
          "index": 2,
          "text": "空の下の小鳥さんたち、",
          "start_ms": 98915,
          "end_ms": 101554,
          "duration_ms": 2639
        },
        {
          "index": 3,
          "text": "みんな。",
          "start_ms": 101804,
          "end_ms": 102898,
          "duration_ms": 1094
        }
      ]
    },
    {
      "index": 18,
      "text": "いい豆はかごに、悪い豆はみんなさんに。",
      "start_ms": 103398,
      "end_ms": 107996,
      "duration_ms": 4598,
      "clauses": [
        {
          "index": 0,
          "text": "いい豆はかごに、",
          "start_ms": 103398,
          "end_ms": 105247,
          "duration_ms": 1849
        },
        {
          "index": 1,
          "text": "悪い豆はみんなさんに。",
          "start_ms": 105497,
          "end_ms": 107996,
          "duration_ms": 2499
        }
      ]
    },
    {
      "index": 19,
      "text": "拾うのを手伝ってちょうだい。」",
      "start_ms": 108496,
      "end_ms": 110984,
      "duration_ms": 2488,
      "clauses": [
        {
          "index": 0,
          "text": "拾うのを手伝ってちょうだい。」",
          "start_ms": 108496,
          "end_ms": 110984,
          "duration_ms": 2488
        }
      ]
    },
    {
      "index": 20,
      "text": "すると、二羽の白いはとが台所の窓から入ってきました。",
      "start_ms": 111484,
      "end_ms": 117383,
      "duration_ms": 5899,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 111484,
          "end_ms": 112660,
          "duration_ms": 1176
        },
        {
          "index": 1,
          "text": "二羽の白いはとが台所の窓から入ってきました。",
          "start_ms": 112910,
          "end_ms": 117383,
          "duration_ms": 4473
        }
      ]
    },
    {
      "index": 21,
      "text": "そのあとでキジバトが来て、最後に空の下の小鳥たちが全部集まってきて、灰の中に降りました。",
      "start_ms": 117883,
      "end_ms": 127540,
      "duration_ms": 9657,
      "clauses": [
        {
          "index": 0,
          "text": "そのあとでキジバトが来て、",
          "start_ms": 117883,
          "end_ms": 120347,
          "duration_ms": 2464
        },
        {
          "index": 1,
          "text": "最後に空の下の小鳥たちが全部集まってきて、",
          "start_ms": 120597,
          "end_ms": 125035,
          "duration_ms": 4438
        },
        {
          "index": 2,
          "text": "灰の中に降りました。",
          "start_ms": 125285,
          "end_ms": 127540,
          "duration_ms": 2255
        }
      ]
    },
    {
      "index": 22,
      "text": "はとたちが頭をひょこひょこさせて、コッコッコッとつつき始めました。",
      "start_ms": 128040,
      "end_ms": 134577,
      "duration_ms": 6537,
      "clauses": [
        {
          "index": 0,
          "text": "はとたちが頭をひょこひょこさせて、",
          "start_ms": 128040,
          "end_ms": 131468,
          "duration_ms": 3428
        },
        {
          "index": 1,
          "text": "コッコッコッとつつき始めました。",
          "start_ms": 131718,
          "end_ms": 134577,
          "duration_ms": 2859
        }
      ]
    },
    {
      "index": 23,
      "text": "残りの鳥たちもコッコッコッと始めて、皿に全部の良い豆を集めました。",
      "start_ms": 135077,
      "end_ms": 142311,
      "duration_ms": 7234,
      "clauses": [
        {
          "index": 0,
          "text": "残りの鳥たちもコッコッコッと始めて、",
          "start_ms": 135077,
          "end_ms": 138772,
          "duration_ms": 3695
        },
        {
          "index": 1,
          "text": "皿に全部の良い豆を集めました。",
          "start_ms": 139022,
          "end_ms": 142311,
          "duration_ms": 3289
        }
      ]
    },
    {
      "index": 24,
      "text": "一時間もたたないうちに、小鳥たちは終わって、また飛び去りました。",
      "start_ms": 142811,
      "end_ms": 150170,
      "duration_ms": 7359,
      "clauses": [
        {
          "index": 0,
          "text": "一時間もたたないうちに、",
          "start_ms": 142811,
          "end_ms": 145264,
          "duration_ms": 2453
        },
        {
          "index": 1,
          "text": "小鳥たちは終わって、",
          "start_ms": 145514,
          "end_ms": 147607,
          "duration_ms": 2093
        },
        {
          "index": 2,
          "text": "また飛び去りました。",
          "start_ms": 147857,
          "end_ms": 150170,
          "duration_ms": 2313
        }
      ]
    },
    {
      "index": 25,
      "text": "娘は皿をままははのところに持って行きました。",
      "start_ms": 150670,
      "end_ms": 154795,
      "duration_ms": 4125,
      "clauses": [
        {
          "index": 0,
          "text": "娘は皿をままははのところに持って行きました。",
          "start_ms": 150670,
          "end_ms": 154795,
          "duration_ms": 4125
        }
      ]
    },
    {
      "index": 26,
      "text": "嬉しくて、今度こそお祝いに行けると信じていました。",
      "start_ms": 155295,
      "end_ms": 160671,
      "duration_ms": 5376,
      "clauses": [
        {
          "index": 0,
          "text": "嬉しくて、",
          "start_ms": 155295,
          "end_ms": 156738,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "今度こそお祝いに行けると信じていました。",
          "start_ms": 156988,
          "end_ms": 160671,
          "duration_ms": 3683
        }
      ]
    },
    {
      "index": 27,
      "text": "でも、ままははは「だめよ、シンデレラ。",
      "start_ms": 161171,
      "end_ms": 165918,
      "duration_ms": 4747,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 161171,
          "end_ms": 162045,
          "duration_ms": 874
        },
        {
          "index": 1,
          "text": "ままははは「だめよ、",
          "start_ms": 162295,
          "end_ms": 164167,
          "duration_ms": 1872
        },
        {
          "index": 2,
          "text": "シンデレラ。",
          "start_ms": 164417,
          "end_ms": 165918,
          "duration_ms": 1501
        }
      ]
    },
    {
      "index": 28,
      "text": "服がないじゃないし、踊れないわ。",
      "start_ms": 166418,
      "end_ms": 170250,
      "duration_ms": 3832,
      "clauses": [
        {
          "index": 0,
          "text": "服がないじゃないし、",
          "start_ms": 166418,
          "end_ms": 168418,
          "duration_ms": 2000
        },
        {
          "index": 1,
          "text": "踊れないわ。",
          "start_ms": 168668,
          "end_ms": 170250,
          "duration_ms": 1582
        }
      ]
    },
    {
      "index": 29,
      "text": "ただ笑われるだけだよ。」",
      "start_ms": 170750,
      "end_ms": 172936,
      "duration_ms": 2186,
      "clauses": [
        {
          "index": 0,
          "text": "ただ笑われるだけだよ。」",
          "start_ms": 170750,
          "end_ms": 172936,
          "duration_ms": 2186
        }
      ]
    },
    {
      "index": 30,
      "text": "と言いました。",
      "start_ms": 173436,
      "end_ms": 174995,
      "duration_ms": 1559,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 173436,
          "end_ms": 174995,
          "duration_ms": 1559
        }
      ]
    },
    {
      "index": 31,
      "text": "シンデレラが泣くと、ままははは「一時間で灰から二皿のレンズ豆を拾ったら、一緒に行ってあげるよ。」",
      "start_ms": 175495,
      "end_ms": 185013,
      "duration_ms": 9518,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラが泣くと、",
          "start_ms": 175495,
          "end_ms": 177553,
          "duration_ms": 2058
        },
        {
          "index": 1,
          "text": "ままははは「一時間で灰から二皿のレンズ豆を拾ったら、",
          "start_ms": 177803,
          "end_ms": 182705,
          "duration_ms": 4902
        },
        {
          "index": 2,
          "text": "一緒に行ってあげるよ。」",
          "start_ms": 182955,
          "end_ms": 185013,
          "duration_ms": 2058
        }
      ]
    },
    {
      "index": 32,
      "text": "と言いました。",
      "start_ms": 185513,
      "end_ms": 187060,
      "duration_ms": 1547,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 185513,
          "end_ms": 187060,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 33,
      "text": "娘はまた庭に行って、小鳥たちにてつだいを頼みました。",
      "start_ms": 187560,
      "end_ms": 193307,
      "duration_ms": 5747,
      "clauses": [
        {
          "index": 0,
          "text": "娘はまた庭に行って、",
          "start_ms": 187560,
          "end_ms": 189931,
          "duration_ms": 2371
        },
        {
          "index": 1,
          "text": "小鳥たちにてつだいを頼みました。",
          "start_ms": 190181,
          "end_ms": 193307,
          "duration_ms": 3126
        }
      ]
    },
    {
      "index": 34,
      "text": "今度は三十分もたたないうちに、全部の豆を集めました。",
      "start_ms": 193807,
      "end_ms": 199810,
      "duration_ms": 6003,
      "clauses": [
        {
          "index": 0,
          "text": "今度は三十分もたたないうちに、",
          "start_ms": 193807,
          "end_ms": 197003,
          "duration_ms": 3196
        },
        {
          "index": 1,
          "text": "全部の豆を集めました。",
          "start_ms": 197253,
