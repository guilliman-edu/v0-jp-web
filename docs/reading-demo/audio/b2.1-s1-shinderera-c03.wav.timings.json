{
  "audio_file": "b2.1-s1-shinderera-c03.wav",
  "sample_rate": 44100,
  "pause_ms": 500,
  "total_duration_ms": 220729,
  "sentences": [
    {
      "index": 0,
      "text": "舞踏会への招待",
      "start_ms": 0,
      "end_ms": 2081,
      "duration_ms": 2081,
      "clauses": [
        {
          "index": 0,
          "text": "舞踏会への招待",
          "start_ms": 0,
          "end_ms": 2081,
          "duration_ms": 2081
        }
      ]
    },
    {
      "index": 1,
      "text": "ところが、おうさまがお祝いを開くことになりました。",
      "start_ms": 2581,
      "end_ms": 7713,
      "duration_ms": 5132,
      "clauses": [
        {
          "index": 0,
          "text": "ところが、",
          "start_ms": 2581,
          "end_ms": 3954,
          "duration_ms": 1373
        },
        {
          "index": 1,
          "text": "おうさまがお祝いを開くことになりました。",
          "start_ms": 4204,
          "end_ms": 7713,
          "duration_ms": 3509
        }
      ]
    },
    {
      "index": 2,
      "text": "三日間続くお祝いで、おうさまの息子がはなよめを選ぶために、国のうつくしい若い娘は全部しょうたいされることになりました。",
      "start_ms": 8213,
      "end_ms": 19693,
      "duration_ms": 11480,
      "clauses": [
        {
          "index": 0,
          "text": "三日間続くお祝いで、",
          "start_ms": 8213,
          "end_ms": 10526,
          "duration_ms": 2313
        },
        {
          "index": 1,
          "text": "おうさまの息子がはなよめを選ぶために、",
          "start_ms": 10776,
          "end_ms": 14134,
          "duration_ms": 3358
        },
        {
          "index": 2,
          "text": "国のうつくしい若い娘は全部しょうたいされることになりました。",
          "start_ms": 14384,
          "end_ms": 19693,
          "duration_ms": 5309
        }
      ]
    },
    {
      "index": 3,
      "text": "二人のこいもうとは、自分たちもお祝いに行けると聞いて、とても喜びました。",
      "start_ms": 20193,
      "end_ms": 28004,
      "duration_ms": 7811,
      "clauses": [
        {
          "index": 0,
          "text": "二人のこいもうとは、",
          "start_ms": 20193,
          "end_ms": 22274,
          "duration_ms": 2081
        },
        {
          "index": 1,
          "text": "自分たちもお祝いに行けると聞いて、",
          "start_ms": 22524,
          "end_ms": 25650,
          "duration_ms": 3126
        },
        {
          "index": 2,
          "text": "とても喜びました。",
          "start_ms": 25900,
          "end_ms": 28004,
          "duration_ms": 2104
        }
      ]
    },
    {
      "index": 4,
      "text": "そして、シンデレラを呼びました。",
      "start_ms": 28504,
      "end_ms": 32301,
      "duration_ms": 3797,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 28504,
          "end_ms": 29761,
          "duration_ms": 1257
        },
        {
          "index": 1,
          "text": "シンデレラを呼びました。",
          "start_ms": 30011,
          "end_ms": 32301,
          "duration_ms": 2290
        }
      ]
    },
    {
      "index": 5,
      "text": "「私たちの髪をとかして、靴を磨いて、ベルトをしめて。",
      "start_ms": 32801,
      "end_ms": 39266,
      "duration_ms": 6465,
      "clauses": [
        {
          "index": 0,
          "text": "「私たちの髪をとかして、",
          "start_ms": 32801,
          "end_ms": 35335,
          "duration_ms": 2534
        },
        {
          "index": 1,
          "text": "靴を磨いて、",
          "start_ms": 35585,
          "end_ms": 37295,
          "duration_ms": 1710
        },
        {
          "index": 2,
          "text": "ベルトをしめて。",
          "start_ms": 37545,
          "end_ms": 39266,
          "duration_ms": 1721
        }
      ]
    },
    {
      "index": 6,
      "text": "私たちはおうさまのきゅうでんのお祝いに行くのだから。」",
      "start_ms": 39766,
      "end_ms": 44309,
      "duration_ms": 4543,
      "clauses": [
        {
          "index": 0,
          "text": "私たちはおうさまのきゅうでんのお祝いに行くのだから。」",
          "start_ms": 39766,
          "end_ms": 44309,
          "duration_ms": 4543
        }
      ]
    },
    {
      "index": 7,
      "text": "シンデレラも行きたくて、泣きました。",
      "start_ms": 44809,
      "end_ms": 48827,
      "duration_ms": 4018,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラも行きたくて、",
          "start_ms": 44809,
          "end_ms": 47018,
          "duration_ms": 2209
        },
        {
          "index": 1,
          "text": "泣きました。",
          "start_ms": 47268,
          "end_ms": 48827,
          "duration_ms": 1559
        }
      ]
    },
    {
      "index": 8,
      "text": "自分も一緒に踊りに行きたかったからです。",
      "start_ms": 49327,
      "end_ms": 53034,
      "duration_ms": 3707,
      "clauses": [
        {
          "index": 0,
          "text": "自分も一緒に踊りに行きたかったからです。",
          "start_ms": 49327,
          "end_ms": 53034,
          "duration_ms": 3707
        }
      ]
    },
    {
      "index": 9,
      "text": "それから、ままははにそうするきょかをもらおうと頼みました。",
      "start_ms": 53534,
      "end_ms": 59130,
      "duration_ms": 5596,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 53534,
          "end_ms": 54953,
          "duration_ms": 1419
        },
        {
          "index": 1,
          "text": "ままははにそうするきょかをもらおうと頼みました。",
          "start_ms": 55203,
          "end_ms": 59130,
          "duration_ms": 3927
        }
      ]
    },
    {
      "index": 10,
      "text": "「あなたは埃と泥まみれでしょう。",
      "start_ms": 59630,
      "end_ms": 62675,
      "duration_ms": 3045,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたは埃と泥まみれでしょう。",
          "start_ms": 59630,
          "end_ms": 62675,
          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 11,
      "text": "それでぶとうかいに行くの？",
      "start_ms": 63175,
      "end_ms": 65512,
      "duration_ms": 2337,
      "clauses": [
        {
          "index": 0,
          "text": "それでぶとうかいに行くの？",
          "start_ms": 63175,
          "end_ms": 65512,
          "duration_ms": 2337
        }
      ]
    },
    {
      "index": 12,
      "text": "服もないし、靴もないのに、踊るっていうの？」",
      "start_ms": 66012,
      "end_ms": 71560,
      "duration_ms": 5548,
      "clauses": [
        {
          "index": 0,
          "text": "服もないし、",
          "start_ms": 66012,
          "end_ms": 67652,
          "duration_ms": 1640
        },
        {
          "index": 1,
          "text": "靴もないのに、",
          "start_ms": 67902,
          "end_ms": 69600,
          "duration_ms": 1698
        },
        {
          "index": 2,
          "text": "踊るっていうの？」",
          "start_ms": 69850,
          "end_ms": 71560,
          "duration_ms": 1710
        }
      ]
    },
    {
      "index": 13,
      "text": "でも、シンデレラがしつこく頼み続けたので、ままはははついにこう言いました。",
      "start_ms": 72060,
      "end_ms": 79558,
      "duration_ms": 7498,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 72060,
          "end_ms": 72957,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "シンデレラがしつこく頼み続けたので、",
          "start_ms": 73207,
          "end_ms": 76472,
          "duration_ms": 3265
        },
        {
          "index": 2,
          "text": "ままはははついにこう言いました。",
          "start_ms": 76722,
          "end_ms": 79558,
          "duration_ms": 2836
        }
      ]
    },
    {
      "index": 14,
      "text": "「ほら、灰の中にレンズ豆を一皿空けておいたから。",
      "start_ms": 80058,
      "end_ms": 84877,
      "duration_ms": 4819,
      "clauses": [
        {
          "index": 0,
          "text": "「ほら、",
          "start_ms": 80058,
          "end_ms": 80711,
          "duration_ms": 653
        },
        {
          "index": 1,
          "text": "灰の中にレンズ豆を一皿空けておいたから。",
          "start_ms": 80961,
          "end_ms": 84877,
          "duration_ms": 3916
        }
      ]
    },
    {
      "index": 15,
      "text": "二時間でそれを全部拾えたら、一緒に行ってあげるよ。」",
      "start_ms": 85377,
      "end_ms": 90718,
      "duration_ms": 5341,
      "clauses": [
        {
          "index": 0,
          "text": "二時間でそれを全部拾えたら、",
          "start_ms": 85377,
          "end_ms": 88352,
          "duration_ms": 2975
        },
        {
          "index": 1,
          "text": "一緒に行ってあげるよ。」",
          "start_ms": 88602,
          "end_ms": 90718,
          "duration_ms": 2116
        }
      ]
    },
    {
      "index": 16,
      "text": "娘は裏口から庭に出ました。",
      "start_ms": 91218,
      "end_ms": 94240,
      "duration_ms": 3022,
      "clauses": [
        {
          "index": 0,
          "text": "娘は裏口から庭に出ました。",
          "start_ms": 91218,
          "end_ms": 94240,
          "duration_ms": 3022
        }
      ]
    },
    {
      "index": 17,
      "text": "「お友達のハトさん、キジバトさん、空の下の小鳥さんたち、みんな。",
      "start_ms": 94740,
      "end_ms": 102840,
      "duration_ms": 8100,
      "clauses": [
        {
          "index": 0,
          "text": "「お友達のハトさん、",
          "start_ms": 94740,
          "end_ms": 96856,
          "duration_ms": 2116
        },
        {
          "index": 1,
          "text": "キジバトさん、",
          "start_ms": 97106,
          "end_ms": 98700,
          "duration_ms": 1594
        },
        {
          "index": 2,
          "text": "空の下の小鳥さんたち、",
          "start_ms": 98950,
          "end_ms": 101542,
          "duration_ms": 2592
        },
        {
          "index": 3,
          "text": "みんな。",
          "start_ms": 101792,
          "end_ms": 102840,
          "duration_ms": 1048
        }
      ]
    },
    {
      "index": 18,
      "text": "いい豆はかごに、悪い豆はみんなさんに。",
      "start_ms": 103340,
      "end_ms": 107915,
      "duration_ms": 4575,
      "clauses": [
        {
          "index": 0,
          "text": "いい豆はかごに、",
          "start_ms": 103340,
          "end_ms": 105189,
          "duration_ms": 1849
        },
        {
          "index": 1,
          "text": "悪い豆はみんなさんに。",
          "start_ms": 105439,
          "end_ms": 107915,
          "duration_ms": 2476
        }
      ]
    },
    {
      "index": 19,
      "text": "拾うのを手伝ってちょうだい。」",
      "start_ms": 108415,
      "end_ms": 110891,
      "duration_ms": 2476,
      "clauses": [
        {
          "index": 0,
          "text": "拾うのを手伝ってちょうだい。」",
          "start_ms": 108415,
          "end_ms": 110891,
          "duration_ms": 2476
        }
      ]
    },
    {
      "index": 20,
      "text": "すると、二羽の白いはとが台所の窓から入ってきました。",
      "start_ms": 111391,
      "end_ms": 117219,
      "duration_ms": 5828,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 111391,
          "end_ms": 112543,
          "duration_ms": 1152
        },
        {
          "index": 1,
          "text": "二羽の白いはとが台所の窓から入ってきました。",
          "start_ms": 112793,
          "end_ms": 117219,
          "duration_ms": 4426
        }
      ]
    },
    {
      "index": 21,
      "text": "そのあとでキジバトが来て、最後に空の下の小鳥たちが全部集まってきて、灰の中に降りました。",
      "start_ms": 117719,
      "end_ms": 127330,
      "duration_ms": 9611,
      "clauses": [
        {
          "index": 0,
          "text": "そのあとでキジバトが来て、",
          "start_ms": 117719,
          "end_ms": 120195,
          "duration_ms": 2476
        },
        {
          "index": 1,
          "text": "最後に空の下の小鳥たちが全部集まってきて、",
          "start_ms": 120445,
          "end_ms": 124871,
          "duration_ms": 4426
        },
        {
          "index": 2,
          "text": "灰の中に降りました。",
          "start_ms": 125121,
          "end_ms": 127330,
          "duration_ms": 2209
        }
      ]
    },
    {
      "index": 22,
      "text": "はとたちが頭をひょこひょこさせて、コッコッコッとつつき始めました。",
      "start_ms": 127830,
      "end_ms": 134367,
      "duration_ms": 6537,
      "clauses": [
        {
          "index": 0,
          "text": "はとたちが頭をひょこひょこさせて、",
          "start_ms": 127830,
          "end_ms": 131246,
          "duration_ms": 3416
        },
        {
          "index": 1,
          "text": "コッコッコッとつつき始めました。",
          "start_ms": 131496,
          "end_ms": 134367,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 23,
      "text": "残りの鳥たちもコッコッコッと始めて、皿に全部の良い豆を集めました。",
      "start_ms": 134867,
      "end_ms": 142089,
      "duration_ms": 7222,
      "clauses": [
        {
          "index": 0,
          "text": "残りの鳥たちもコッコッコッと始めて、",
          "start_ms": 134867,
          "end_ms": 138574,
          "duration_ms": 3707
        },
        {
          "index": 1,
          "text": "皿に全部の良い豆を集めました。",
          "start_ms": 138824,
          "end_ms": 142089,
          "duration_ms": 3265
        }
      ]
    },
    {
      "index": 24,
      "text": "一時間もたたないうちに、小鳥たちは終わって、また飛び去りました。",
      "start_ms": 142589,
      "end_ms": 150053,
      "duration_ms": 7464,
      "clauses": [
        {
          "index": 0,
          "text": "一時間もたたないうちに、",
          "start_ms": 142589,
          "end_ms": 145088,
          "duration_ms": 2499
        },
        {
          "index": 1,
          "text": "小鳥たちは終わって、",
          "start_ms": 145338,
          "end_ms": 147501,
          "duration_ms": 2163
        },
        {
          "index": 2,
          "text": "また飛び去りました。",
          "start_ms": 147751,
          "end_ms": 150053,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 25,
      "text": "娘は皿をままははのところに持って行きました。",
      "start_ms": 150553,
      "end_ms": 154701,
      "duration_ms": 4148,
      "clauses": [
        {
          "index": 0,
          "text": "娘は皿をままははのところに持って行きました。",
          "start_ms": 150553,
          "end_ms": 154701,
          "duration_ms": 4148
        }
      ]
    },
    {
      "index": 26,
      "text": "嬉しくて、今度こそお祝いに行けると信じていました。",
      "start_ms": 155201,
      "end_ms": 160543,
      "duration_ms": 5342,
      "clauses": [
        {
          "index": 0,
          "text": "嬉しくて、",
          "start_ms": 155201,
          "end_ms": 156644,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "今度こそお祝いに行けると信じていました。",
          "start_ms": 156894,
          "end_ms": 160543,
          "duration_ms": 3649
        }
      ]
    },
    {
      "index": 27,
      "text": "でも、ままははは「だめよ、シンデレラ。",
      "start_ms": 161043,
      "end_ms": 165836,
      "duration_ms": 4793,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 161043,
          "end_ms": 161940,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "ままははは「だめよ、",
          "start_ms": 162190,
          "end_ms": 164097,
          "duration_ms": 1907
        },
        {
          "index": 2,
          "text": "シンデレラ。",
          "start_ms": 164347,
          "end_ms": 165836,
          "duration_ms": 1489
        }
      ]
    },
    {
      "index": 28,
      "text": "服がないじゃないし、踊れないわ。",
      "start_ms": 166336,
      "end_ms": 170226,
      "duration_ms": 3890,
      "clauses": [
        {
          "index": 0,
          "text": "服がないじゃないし、",
          "start_ms": 166336,
          "end_ms": 168371,
          "duration_ms": 2035
        },
        {
          "index": 1,
          "text": "踊れないわ。",
          "start_ms": 168621,
          "end_ms": 170226,
          "duration_ms": 1605
        }
      ]
    },
    {
      "index": 29,
      "text": "ただ笑われるだけだよ。」",
      "start_ms": 170726,
      "end_ms": 172935,
      "duration_ms": 2209,
      "clauses": [
        {
          "index": 0,
          "text": "ただ笑われるだけだよ。」",
          "start_ms": 170726,
          "end_ms": 172935,
          "duration_ms": 2209
        }
      ]
    },
    {
      "index": 30,
      "text": "と言いました。",
      "start_ms": 173435,
      "end_ms": 174947,
      "duration_ms": 1512,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 173435,
          "end_ms": 174947,
          "duration_ms": 1512
        }
      ]
    },
    {
      "index": 31,
      "text": "シンデレラが泣くと、ままははは「一時間で灰から二皿のレンズ豆を拾ったら、一緒に行ってあげるよ。」",
      "start_ms": 175447,
      "end_ms": 184884,
      "duration_ms": 9437,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラが泣くと、",
          "start_ms": 175447,
          "end_ms": 177505,
          "duration_ms": 2058
        },
        {
          "index": 1,
          "text": "ままははは「一時間で灰から二皿のレンズ豆を拾ったら、",
          "start_ms": 177755,
          "end_ms": 182541,
          "duration_ms": 4786
        },
        {
          "index": 2,
          "text": "一緒に行ってあげるよ。」",
          "start_ms": 182791,
          "end_ms": 184884,
          "duration_ms": 2093
        }
      ]
    },
    {
      "index": 32,
      "text": "と言いました。",
      "start_ms": 185384,
      "end_ms": 186954,
      "duration_ms": 1570,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 185384,
          "end_ms": 186954,
          "duration_ms": 1570
        }
      ]
    },
    {
      "index": 33,
      "text": "娘はまた庭に行って、小鳥たちにてつだいを頼みました。",
      "start_ms": 187454,
      "end_ms": 193166,
      "duration_ms": 5712,
      "clauses": [
        {
          "index": 0,
          "text": "娘はまた庭に行って、",
          "start_ms": 187454,
          "end_ms": 189825,
          "duration_ms": 2371
        },
        {
          "index": 1,
          "text": "小鳥たちにてつだいを頼みました。",
          "start_ms": 190075,
          "end_ms": 193166,
          "duration_ms": 3091
        }
      ]
    },
    {
      "index": 34,
      "text": "今度は三十分もたたないうちに、全部の豆を集めました。",
      "start_ms": 193666,
      "end_ms": 199715,
      "duration_ms": 6049,
      "clauses": [
        {
          "index": 0,
          "text": "今度は三十分もたたないうちに、",
          "start_ms": 193666,
          "end_ms": 196850,
          "duration_ms": 3184
        },
        {
          "index": 1,
          "text": "全部の豆を集めました。",
          "start_ms": 197100,
