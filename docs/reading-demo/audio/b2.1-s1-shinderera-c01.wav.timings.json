          "duration_ms": 2894
        }
      ]
    },
    {
      "index": 15,
      "text": "それから、かわいそうな継子の辛い生活が始まりました。",
      "start_ms": 76833,
      "end_ms": 82685,
      "duration_ms": 5852,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 76833,
          "end_ms": 78241,
