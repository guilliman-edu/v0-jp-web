          "end_ms": 58973,
          "duration_ms": 2998
        },
        {
          "index": 1,
          "text": "父は別の女の人を妻にもらいました。",
          "start_ms": 59223,
          "end_ms": 63139,
          "duration_ms": 3916
        }
      ]
    },
    {
      "index": 13,
      "text": "その女は自分の娘を二人一緒に連れてきました。",
