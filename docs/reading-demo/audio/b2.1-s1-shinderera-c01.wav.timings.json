          "start_ms": 78491,
          "end_ms": 82685,
          "duration_ms": 4194
        }
      ]
    },
    {
      "index": 16,
      "text": "「あの頭の悪い子が、私たちと一緒にここに座ってていいの？",
      "start_ms": 83185,
      "end_ms": 89222,
      "duration_ms": 6037,
      "clauses": [
        {
          "index": 0,
          "text": "「あの頭の悪い子が、",
          "start_ms": 83185,
          "end_ms": 85498,
          "duration_ms": 2313
        },
        {
          "index": 1,
          "text": "私たちと一緒にここに座ってていいの？",
          "start_ms": 85748,
          "end_ms": 89222,
          "duration_ms": 3474
        }
      ]
    },
    {
      "index": 17,
      "text": "ご飯が食べたいなら、自分の力で稼がなくちゃ。",
      "start_ms": 89722,
      "end_ms": 94878,
      "duration_ms": 5156,
      "clauses": [
        {
          "index": 0,
          "text": "ご飯が食べたいなら、",
          "start_ms": 89722,
          "end_ms": 91873,
          "duration_ms": 2151
        },
        {
          "index": 1,
          "text": "自分の力で稼がなくちゃ。",
          "start_ms": 92123,
          "end_ms": 94878,
          "duration_ms": 2755
        }
      ]
    },
    {
      "index": 18,
      "text": "台所女中は外よ。」",
      "start_ms": 95378,
      "end_ms": 97831,
      "duration_ms": 2453,
      "clauses": [
        {
          "index": 0,
          "text": "台所女中は外よ。」",
          "start_ms": 95378,
          "end_ms": 97831,
          "duration_ms": 2453
        }
      ]
    },
    {
      "index": 19,
      "text": "二人の娘はそう言いました。",
      "start_ms": 98331,
      "end_ms": 100993,
      "duration_ms": 2662,
      "clauses": [
        {
          "index": 0,
          "text": "二人の娘はそう言いました。",
          "start_ms": 98331,
          "end_ms": 100993,
          "duration_ms": 2662
        }
      ]
    },
    {
      "index": 20,
      "text": "二人の娘は、きれいな服を全部とりあげました。",
      "start_ms": 101493,
      "end_ms": 106683,
      "duration_ms": 5190,
      "clauses": [
        {
          "index": 0,
          "text": "二人の娘は、",
          "start_ms": 101493,
