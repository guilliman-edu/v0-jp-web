          "start_ms": 3046,
          "end_ms": 6683,
          "duration_ms": 3637
        }
      ]
    },
    {
      "index": 2,
      "text": "とても具合が悪くて、もうすぐ死ぬということが分かりました。",
      "start_ms": 7183,
      "end_ms": 12675,
      "duration_ms": 5492,
      "clauses": [
        {
          "index": 0,
          "text": "とても具合が悪くて、",
          "start_ms": 7183,
          "end_ms": 9264,
          "duration_ms": 2081
        },
        {
          "index": 1,
          "text": "もうすぐ死ぬということが分かりました。",
          "start_ms": 9514,
          "end_ms": 12675,
          "duration_ms": 3161
        }
      ]
    },
    {
      "index": 3,
      "text": "それで、たった一人の娘をベッドのそばに呼んで、「愛しているわが子よ。",
      "start_ms": 13175,
      "end_ms": 20429,
      "duration_ms": 7254,
      "clauses": [
        {
          "index": 0,
          "text": "それで、",
          "start_ms": 13175,
          "end_ms": 14269,
          "duration_ms": 1094
        },
        {
          "index": 1,
          "text": "たった一人の娘をベッドのそばに呼んで、",
          "start_ms": 14519,
          "end_ms": 18133,
          "duration_ms": 3614
        },
        {
          "index": 2,
          "text": "「愛しているわが子よ。",
          "start_ms": 18383,
          "end_ms": 20429,
          "duration_ms": 2046
        }
      ]
    },
    {
      "index": 4,
      "text": "いい子でいてね。",
      "start_ms": 20929,
      "end_ms": 22581,
      "duration_ms": 1652,
      "clauses": [
        {
          "index": 0,
          "text": "いい子でいてね。",
          "start_ms": 20929,
          "end_ms": 22581,
          "duration_ms": 1652
        }
      ]
    },
    {
      "index": 5,
      "text": "神様を信じているなら、神様はいつもあなたを守ってくれるよ。",
      "start_ms": 23081,
      "end_ms": 29490,
      "duration_ms": 6409,
      "clauses": [
        {
          "index": 0,
          "text": "神様を信じているなら、",
          "start_ms": 23081,
          "end_ms": 25557,
          "duration_ms": 2476
        },
        {
          "index": 1,
          "text": "神様はいつもあなたを守ってくれるよ。",
          "start_ms": 25807,
          "end_ms": 29490,
          "duration_ms": 3683
        }
      ]
    },
    {
      "index": 6,
      "text": "私は天国からあなたを見下ろしているからね。」",
      "start_ms": 29990,
      "end_ms": 34138,
      "duration_ms": 4148,
      "clauses": [
        {
          "index": 0,
          "text": "私は天国からあなたを見下ろしているからね。」",
          "start_ms": 29990,
          "end_ms": 34138,
          "duration_ms": 4148
        }
      ]
    },
    {
