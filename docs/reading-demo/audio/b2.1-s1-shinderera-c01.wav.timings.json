      "end_ms": 68425,
      "duration_ms": 4786,
      "clauses": [
        {
          "index": 0,
          "text": "その女は自分の娘を二人一緒に連れてきました。",
          "start_ms": 63639,
          "end_ms": 68425,
          "duration_ms": 4786
        }
      ]
    },
    {
      "index": 14,
      "text": "二人の娘は顔はとても美しかったですが、心は汚くて真っ黒でした。",
      "start_ms": 68925,
      "end_ms": 76333,
      "duration_ms": 7408,
      "clauses": [
        {
          "index": 0,
          "text": "二人の娘は顔はとても美しかったですが、",
