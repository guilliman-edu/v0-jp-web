          "start_ms": 52558,
          "end_ms": 55475,
          "duration_ms": 2917
        }
      ]
    },
    {
      "index": 12,
      "text": "春の太陽が雪を溶かすころ、父は別の女の人を妻にもらいました。",
      "start_ms": 55975,
      "end_ms": 63139,
      "duration_ms": 7164,
      "clauses": [
        {
          "index": 0,
          "text": "春の太陽が雪を溶かすころ、",
