          "end_ms": 136894,
          "duration_ms": 1605
        },
        {
          "index": 4,
          "text": "洗濯をしました。",
          "start_ms": 137144,
          "end_ms": 139156,
          "duration_ms": 2012
        }
      ]
    },
    {
      "index": 27,
      "text": "それだけでは足りなくて、二人はできる限りのいじわるをしました。",
      "start_ms": 139656,
      "end_ms": 145775,
      "duration_ms": 6119,
      "clauses": [
        {
          "index": 0,
          "text": "それだけでは足りなくて、",
          "start_ms": 139656,
          "end_ms": 142027,
          "duration_ms": 2371
        },
        {
          "index": 1,
          "text": "二人はできる限りのいじわるをしました。",
          "start_ms": 142277,
          "end_ms": 145775,
          "duration_ms": 3498
        }
      ]
    },
    {
      "index": 28,
      "text": "娘をバカにして、灰の中にエンドウ豆やレンズ豆をまいたので、娘は一度座って豆を全部拾わなければなりませんでした。",
      "start_ms": 146275,
      "end_ms": 158139,
      "duration_ms": 11864,
      "clauses": [
        {
          "index": 0,
          "text": "娘をバカにして、",
          "start_ms": 146275,
          "end_ms": 148345,
          "duration_ms": 2070
        },
        {
          "index": 1,
          "text": "灰の中にエンドウ豆やレンズ豆をまいたので、",
          "start_ms": 148595,
          "end_ms": 152580,
          "duration_ms": 3985
        },
        {
          "index": 2,
          "text": "娘は一度座って豆を全部拾わなければなりませんでした。",
          "start_ms": 152830,
          "end_ms": 158139,
          "duration_ms": 5309
        }
      ]
    },
    {
      "index": 29,
      "text": "疲れるまで働いた夜には、ベッドがありませんでした。",
      "start_ms": 158639,
      "end_ms": 163852,
      "duration_ms": 5213,
      "clauses": [
        {
          "index": 0,
          "text": "疲れるまで働いた夜には、",
          "start_ms": 158639,
          "end_ms": 161312,
          "duration_ms": 2673
        },
        {
          "index": 1,
          "text": "ベッドがありませんでした。",
          "start_ms": 161562,
          "end_ms": 163852,
          "duration_ms": 2290
        }
      ]
    },
    {
      "index": 30,
      "text": "灰があるかまどのそばで寝なければなりませんでした。",
      "start_ms": 164352,
      "end_ms": 168361,
      "duration_ms": 4009,
      "clauses": [
        {
          "index": 0,
          "text": "灰があるかまどのそばで寝なければなりませんでした。",
          "start_ms": 164352,
          "end_ms": 168361,
          "duration_ms": 4009
        }
      ]
    },
    {
      "index": 31,
      "text": "だから、いつも埃をかぶって汚く見えたので、二人は娘を「はいかぶり」と呼びました。",
