      "index": 23,
      "text": "なんておめかしているの。」",
      "start_ms": 116163,
      "end_ms": 118314,
      "duration_ms": 2151,
      "clauses": [
        {
          "index": 0,
          "text": "なんておめかしているの。」",
          "start_ms": 116163,
          "end_ms": 118314,
          "duration_ms": 2151
