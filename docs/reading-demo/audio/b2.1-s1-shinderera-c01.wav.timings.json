      "end_ms": 128421,
      "duration_ms": 6921,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 121500,
          "end_ms": 122943,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "娘は朝から晩まで辛い仕事をしなければなりませんでした。",
          "start_ms": 123193,
          "end_ms": 128421,
          "duration_ms": 5228
        }
      ]
    },
    {
      "index": 26,
      "text": "日の出前に起きて、水を汲んで、火をおこして、料理をして、洗濯をしました。",
