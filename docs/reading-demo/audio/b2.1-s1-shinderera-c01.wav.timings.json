      "text": "と言いました。",
      "start_ms": 34638,
      "end_ms": 36185,
      "duration_ms": 1547,
      "clauses": [
        {
          "index": 0,
          "text": "と言いました。",
          "start_ms": 34638,
          "end_ms": 36185,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 8,
      "text": "それから、目を閉じて亡くなりました。",
      "start_ms": 36685,
      "end_ms": 40842,
      "duration_ms": 4157,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 36685,
          "end_ms": 38128,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "目を閉じて亡くなりました。",
          "start_ms": 38378,
          "end_ms": 40842,
          "duration_ms": 2464
        }
      ]
    },
    {
