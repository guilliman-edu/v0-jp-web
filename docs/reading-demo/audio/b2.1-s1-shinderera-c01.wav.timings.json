          "start_ms": 43453,
          "end_ms": 46370,
          "duration_ms": 2917
        }
      ]
    },
    {
      "index": 10,
      "text": "でも、いつもいい子でいました。",
      "start_ms": 46870,
      "end_ms": 50226,
      "duration_ms": 3356,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 46870,
          "end_ms": 47767,
          "duration_ms": 897
        },
