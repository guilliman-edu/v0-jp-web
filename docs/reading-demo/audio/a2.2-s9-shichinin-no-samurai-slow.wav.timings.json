          "start_ms": 0,
          "end_ms": 1634,
          "duration_ms": 1634
        }
      ]
    },
    {
      "index": 1,
      "text": "「しちにんのさむらい」は、せんきゅうひゃくごじゅうよ年のにほんのえいがです。",
      "start_ms": 2134,
      "end_ms": 9305,
      "duration_ms": 7171,
      "clauses": [
        {
          "index": 0,
          "text": "「しちにんのさむらい」は、",
          "start_ms": 2134,
          "end_ms": 4396,
          "duration_ms": 2262
        },
        {
          "index": 1,
          "text": "せんきゅうひゃくごじゅうよ年のにほんのえいがです。",
          "start_ms": 4646,
          "end_ms": 9305,
          "duration_ms": 4659
        }
      ]
    },
    {
      "index": 2,
      "text": "くろさわあきらがかんとくしました。",
      "start_ms": 9805,
      "end_ms": 13210,
      "duration_ms": 3405,
      "clauses": [
        {
          "index": 0,
          "text": "くろさわあきらがかんとくしました。",
          "start_ms": 9805,
          "end_ms": 13210,
          "duration_ms": 3405
        }
      ]
    },
    {
      "index": 3,
      "text": "みふねとしろうとしむらたかしが出ています。",
      "start_ms": 13710,
      "end_ms": 18032,
      "duration_ms": 4322,
      "clauses": [
        {
          "index": 0,
          "text": "みふねとしろうとしむらたかしが出ています。",
          "start_ms": 13710,
          "end_ms": 18032,
          "duration_ms": 4322
        }
      ]
    },
    {
      "index": 4,
      "text": "しろくろのえいがで、じかんは207分もあります。",
      "start_ms": 18532,
      "end_ms": 24884,
      "duration_ms": 6352,
      "clauses": [
        {
          "index": 0,
          "text": "しろくろのえいがで、",
          "start_ms": 18532,
          "end_ms": 20846,
          "duration_ms": 2314
        },
        {
          "index": 1,
          "text": "じかんは207分もあります。",
          "start_ms": 21096,
          "end_ms": 24884,
          "duration_ms": 3788
        }
      ]
    },
    {
      "index": 5,
      "text": "今から400年いじょう前のせんごくじだいのはなしです。",
      "start_ms": 25384,
      "end_ms": 30983,
      "duration_ms": 5599,
      "clauses": [
        {
          "index": 0,
          "text": "今から400年いじょう前のせんごくじだいのはなしです。",
          "start_ms": 25384,
          "end_ms": 30983,
          "duration_ms": 5599
        }
      ]
    },
    {
      "index": 6,
      "text": "むかし、山のむらに、のうかの人たちが住んでいました。",
      "start_ms": 31483,
      "end_ms": 37626,
      "duration_ms": 6143,
      "clauses": [
        {
          "index": 0,
          "text": "むかし、山のむらに、",
          "start_ms": 31483,
          "end_ms": 33901,
          "duration_ms": 2418
        },
        {
          "index": 1,
          "text": "のうかの人たちが住んでいました。",
          "start_ms": 34151,
          "end_ms": 37626,
          "duration_ms": 3475
        }
      ]
    },
    {
      "index": 7,
      "text": "のぶし（わるいぶしたち）がいつもむらに来て、たべものを取りました。",
      "start_ms": 38126,
      "end_ms": 45221,
      "duration_ms": 7095,
      "clauses": [
        {
          "index": 0,
          "text": "のぶし（わるいぶしたち）がいつもむらに来て、",
          "start_ms": 38126,
          "end_ms": 42483,
          "duration_ms": 4357
        },
        {
          "index": 1,
          "text": "たべものを取りました。",
          "start_ms": 42733,
          "end_ms": 45221,
          "duration_ms": 2488
        }
      ]
    },
    {
      "index": 8,
      "text": "むらびとたちは、強いぶしがほしいと思いました。",
      "start_ms": 45721,
      "end_ms": 51631,
      "duration_ms": 5910,
      "clauses": [
        {
          "index": 0,
          "text": "むらびとたちは、",
          "start_ms": 45721,
          "end_ms": 47930,
          "duration_ms": 2209
        },
        {
          "index": 1,
          "text": "強いぶしがほしいと思いました。",
          "start_ms": 48180,
          "end_ms": 51631,
          "duration_ms": 3451
        }
      ]
    },
    {
      "index": 9,
      "text": "ですから、町へぶしを探しに行きました。",
      "start_ms": 52131,
      "end_ms": 57519,
      "duration_ms": 5388,
      "clauses": [
        {
          "index": 0,
          "text": "ですから、",
          "start_ms": 52131,
          "end_ms": 53690,
          "duration_ms": 1559
        },
        {
          "index": 1,
          "text": "町へぶしを探しに行きました。",
          "start_ms": 53940,
          "end_ms": 57519,
          "duration_ms": 3579
        }
      ]
    },
    {
      "index": 10,
      "text": "町で、かんべえというぶしに会いました。",
      "start_ms": 58019,
      "end_ms": 62919,
      "duration_ms": 4900,
      "clauses": [
        {
          "index": 0,
          "text": "町で、",
          "start_ms": 58019,
          "end_ms": 59415,
          "duration_ms": 1396
        },
        {
          "index": 1,
          "text": "かんべえというぶしに会いました。",
          "start_ms": 59665,
          "end_ms": 62919,
          "duration_ms": 3254
        }
      ]
    },
    {
      "index": 11,
      "text": "かんべえはほかのぶしを集めて、七人になりました。",
      "start_ms": 63419,
      "end_ms": 68984,
      "duration_ms": 5565,
      "clauses": [
        {
          "index": 0,
          "text": "かんべえはほかのぶしを集めて、",
          "start_ms": 63419,
          "end_ms": 67010,
          "duration_ms": 3591
        },
        {
          "index": 1,
          "text": "七人になりました。",
          "start_ms": 67260,
          "end_ms": 68984,
          "duration_ms": 1724
        }
      ]
    },
    {
      "index": 12,
      "text": "ぶしたちはむらに行って、むらびとたちとみんなで戦いました。",
      "start_ms": 69484,
      "end_ms": 76451,
      "duration_ms": 6967,
      "clauses": [
        {
          "index": 0,
          "text": "ぶしたちはむらに行って、",
          "start_ms": 69484,
          "end_ms": 72274,
          "duration_ms": 2790
        },
        {
          "index": 1,
          "text": "むらびとたちとみんなで戦いました。",
          "start_ms": 72524,
          "end_ms": 76451,
          "duration_ms": 3927
        }
      ]
    },
    {
      "index": 13,
      "text": "やっと、ぶしたちは勝ちました。",
      "start_ms": 76951,
      "end_ms": 81306,
      "duration_ms": 4355,
      "clauses": [
        {
          "index": 0,
          "text": "やっと、",
          "start_ms": 76951,
          "end_ms": 78359,
          "duration_ms": 1408
        },
        {
          "index": 1,
          "text": "ぶしたちは勝ちました。",
          "start_ms": 78609,
          "end_ms": 81306,
          "duration_ms": 2697
        }
      ]
    },
    {
      "index": 14,
      "text": "でも、四人のぶしが死にました。",
      "start_ms": 81806,
      "end_ms": 86045,
      "duration_ms": 4239,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 81806,
          "end_ms": 82901,
          "duration_ms": 1095
        },
        {
          "index": 1,
          "text": "四人のぶしが死にました。",
          "start_ms": 83151,
          "end_ms": 86045,
          "duration_ms": 2894
        }
      ]
    },
    {
      "index": 15,
      "text": "かんべえは言いました。",
      "start_ms": 86545,
      "end_ms": 88928,
      "duration_ms": 2383,
      "clauses": [
        {
          "index": 0,
          "text": "かんべえは言いました。",
          "start_ms": 86545,
          "end_ms": 88928,
          "duration_ms": 2383
        }
      ]
    },
    {
      "index": 16,
      "text": "「勝ったのはむらびとたちです。",
      "start_ms": 89428,
      "end_ms": 92798,
      "duration_ms": 3370,
      "clauses": [
        {
          "index": 0,
          "text": "「勝ったのはむらびとたちです。",
          "start_ms": 89428,
          "end_ms": 92798,
          "duration_ms": 3370
        }
      ]
    },
    {
      "index": 17,
      "text": "わたしたちではありません。」",
      "start_ms": 93298,
      "end_ms": 96122,
      "duration_ms": 2824,
      "clauses": [
        {
          "index": 0,
          "text": "わたしたちではありません。」",
          "start_ms": 93298,
          "end_ms": 96122,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 18,
      "text": "このえいがを作るとき、たくさんのじかんとお金がかかりました。",
      "start_ms": 96622,
      "end_ms": 103449,
      "duration_ms": 6827,
      "clauses": [
        {
          "index": 0,
          "text": "このえいがを作るとき、",
          "start_ms": 96622,
          "end_ms": 99365,
          "duration_ms": 2743
        },
        {
          "index": 1,
          "text": "たくさんのじかんとお金がかかりました。",
          "start_ms": 99615,
          "end_ms": 103449,
          "duration_ms": 3834
        }
      ]
    },
    {
      "index": 19,
      "text": "お金は、ふつうのえいがのななばいでした。",
      "start_ms": 103949,
      "end_ms": 108652,
      "duration_ms": 4703,
      "clauses": [
        {
          "index": 0,
          "text": "お金は、",
          "start_ms": 103949,
          "end_ms": 105403,
          "duration_ms": 1454
        },
        {
          "index": 1,
          "text": "ふつうのえいがのななばいでした。",
          "start_ms": 105653,
          "end_ms": 108652,
          "duration_ms": 2999
        }
      ]
    },
    {
      "index": 20,
      "text": "天気がわるい日が多くて、九十日で撮るよていでしたが、いちねんぐらいかかりました。",
      "start_ms": 109152,
      "end_ms": 118811,
      "duration_ms": 9659,
      "clauses": [
        {
          "index": 0,
          "text": "天気がわるい日が多くて、",
          "start_ms": 109152,
          "end_ms": 112058,
          "duration_ms": 2906
        },
        {
          "index": 1,
          "text": "九十日で撮るよていでしたが、",
          "start_ms": 112308,
          "end_ms": 115690,
          "duration_ms": 3382
        },
        {
          "index": 2,
          "text": "いちねんぐらいかかりました。",
          "start_ms": 115940,
          "end_ms": 118811,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 21,
      "text": "雨の中の戦いは、寒い二月に撮りました。",
      "start_ms": 119311,
      "end_ms": 125361,
      "duration_ms": 6050,
      "clauses": [
        {
          "index": 0,
          "text": "雨の中の戦いは、",
          "start_ms": 119311,
          "end_ms": 122112,
          "duration_ms": 2801
        },
        {
          "index": 1,
          "text": "寒い二月に撮りました。",
          "start_ms": 122362,
          "end_ms": 125361,
          "duration_ms": 2999
        }
      ]
    },
    {
      "index": 22,
      "text": "このえいがはせかいでとてもゆうめいになりました。",
      "start_ms": 125861,
      "end_ms": 130659,
      "duration_ms": 4798,
      "clauses": [
        {
          "index": 0,
          "text": "このえいがはせかいでとてもゆうめいになりました。",
          "start_ms": 125861,
          "end_ms": 130659,
          "duration_ms": 4798
        }
      ]
    },
    {
      "index": 23,
      "text": "せんきゅうひゃくごじゅうよ年に、ヴェネツィアこくさいえいがさいでしょうをもらいました。",
      "start_ms": 131159,
      "end_ms": 138869,
      "duration_ms": 7710,
      "clauses": [
        {
          "index": 0,
          "text": "せんきゅうひゃくごじゅうよ年に、",
          "start_ms": 131159,
          "end_ms": 134239,
          "duration_ms": 3080
        },
        {
          "index": 1,
          "text": "ヴェネツィアこくさいえいがさいでしょうをもらいました。",
          "start_ms": 134489,
          "end_ms": 138869,
          "duration_ms": 4380
        }
      ]
    },
    {
      "index": 24,
      "text": "にせんじゅうはち年には、BBCの「がいこくごえいがベスト100」でいちいになりました。",
      "start_ms": 139369,
      "end_ms": 147300,
      "duration_ms": 7931,
      "clauses": [
        {
          "index": 0,
          "text": "にせんじゅうはち年には、",
