          "duration_ms": 5181
        }
      ]
    },
    {
      "index": 25,
      "text": "せんきゅうひゃくろくじゅう年に、アメリカの人がこのえいがとおなじはなしで「こうやのしちにん」というえいがを作りました。",
      "start_ms": 149291,
      "end_ms": 160600,
      "duration_ms": 11309,
      "clauses": [
        {
          "index": 0,
          "text": "せんきゅうひゃくろくじゅう年に、",
          "start_ms": 149291,
          "end_ms": 152348,
          "duration_ms": 3057
        },
        {
