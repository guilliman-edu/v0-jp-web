    },
    {
      "index": 1,
      "text": "「しちにんのさむらい」は、せんきゅうひゃくごじゅうよ年のにほんのえいがです。",
      "start_ms": 4028,
      "end_ms": 13203,
      "duration_ms": 9175,
      "clauses": [
        {
          "index": 0,
          "text": "「しちにんのさむらい」は、",
          "start_ms": 4028,
          "end_ms": 8248,
          "duration_ms": 4220
        },
        {
          "index": 1,
          "text": "せんきゅうひゃくごじゅうよ年のにほんのえいがです。",
          "start_ms": 8498,
          "end_ms": 13203,
          "duration_ms": 4705
        }
      ]
    },
    {
      "index": 2,
      "text": "くろさわあきらがかんとくしました。",
      "start_ms": 13703,
      "end_ms": 17154,
      "duration_ms": 3451,
      "clauses": [
        {
          "index": 0,
          "text": "くろさわあきらがかんとくしました。",
          "start_ms": 13703,
          "end_ms": 17154,
          "duration_ms": 3451
        }
      ]
    },
    {
      "index": 3,
      "text": "みふねとしろうとしむらたかしが出ています。",
      "start_ms": 17654,
      "end_ms": 21964,
      "duration_ms": 4310,
      "clauses": [
        {
          "index": 0,
          "text": "みふねとしろうとしむらたかしが出ています。",
          "start_ms": 17654,
          "end_ms": 21964,
          "duration_ms": 4310
        }
      ]
    },
    {
      "index": 4,
      "text": "しろくろのえいがで、じかんは207分もあります。",
      "start_ms": 22464,
      "end_ms": 28815,
      "duration_ms": 6351,
      "clauses": [
        {
          "index": 0,
          "text": "しろくろのえいがで、",
          "start_ms": 22464,
          "end_ms": 24789,
          "duration_ms": 2325
        },
        {
          "index": 1,
          "text": "じかんは207分もあります。",
          "start_ms": 25039,
          "end_ms": 28815,
          "duration_ms": 3776
        }
      ]
    },
    {
      "index": 5,
      "text": "今から400年いじょう前のせんごくじだいのはなしです。",
      "start_ms": 29315,
      "end_ms": 34845,
      "duration_ms": 5530,
      "clauses": [
        {
          "index": 0,
          "text": "今から400年いじょう前のせんごくじだいのはなしです。",
          "start_ms": 29315,
          "end_ms": 34845,
          "duration_ms": 5530
        }
      ]
    },
    {
      "index": 6,
      "text": "むかし、山のむらに、のうかの人たちが住んでいました。",
      "start_ms": 35345,
      "end_ms": 41476,
      "duration_ms": 6131,
      "clauses": [
        {
          "index": 0,
          "text": "むかし、山のむらに、",
          "start_ms": 35345,
          "end_ms": 37763,
          "duration_ms": 2418
        },
        {
          "index": 1,
          "text": "のうかの人たちが住んでいました。",
          "start_ms": 38013,
          "end_ms": 41476,
          "duration_ms": 3463
        }
      ]
    },
    {
      "index": 7,
      "text": "のぶし（わるいぶしたち）がいつもむらに来て、たべものを取りました。",
      "start_ms": 41976,
      "end_ms": 49141,
      "duration_ms": 7165,
      "clauses": [
        {
          "index": 0,
          "text": "のぶし（わるいぶしたち）がいつもむらに来て、",
          "start_ms": 41976,
          "end_ms": 46345,
          "duration_ms": 4369
        },
        {
          "index": 1,
          "text": "たべものを取りました。",
          "start_ms": 46595,
          "end_ms": 49141,
          "duration_ms": 2546
        }
      ]
    },
    {
      "index": 8,
      "text": "むらびとたちは、強いぶしがほしいと思いました。",
      "start_ms": 49641,
      "end_ms": 55552,
      "duration_ms": 5911,
      "clauses": [
        {
          "index": 0,
          "text": "むらびとたちは、",
          "start_ms": 49641,
          "end_ms": 51827,
          "duration_ms": 2186
        },
        {
          "index": 1,
          "text": "強いぶしがほしいと思いました。",
          "start_ms": 52077,
          "end_ms": 55552,
          "duration_ms": 3475
        }
      ]
    },
    {
      "index": 9,
      "text": "ですから、町へぶしを探しに行きました。",
      "start_ms": 56052,
      "end_ms": 61475,
      "duration_ms": 5423,
      "clauses": [
        {
          "index": 0,
          "text": "ですから、",
          "start_ms": 56052,
          "end_ms": 57681,
          "duration_ms": 1629
        },
        {
          "index": 1,
          "text": "町へぶしを探しに行きました。",
          "start_ms": 57931,
          "end_ms": 61475,
          "duration_ms": 3544
        }
      ]
    },
    {
      "index": 10,
      "text": "町で、かんべえというぶしに会いました。",
      "start_ms": 61975,
      "end_ms": 66852,
      "duration_ms": 4877,
      "clauses": [
        {
          "index": 0,
          "text": "町で、",
          "start_ms": 61975,
          "end_ms": 63406,
          "duration_ms": 1431
        },
        {
          "index": 1,
          "text": "かんべえというぶしに会いました。",
          "start_ms": 63656,
          "end_ms": 66852,
          "duration_ms": 3196
        }
      ]
    },
    {
      "index": 11,
      "text": "かんべえはほかのぶしを集めて、七人になりました。",
      "start_ms": 67352,
      "end_ms": 73703,
      "duration_ms": 6351,
      "clauses": [
        {
          "index": 0,
          "text": "かんべえはほかのぶしを集めて、",
          "start_ms": 67352,
          "end_ms": 70919,
          "duration_ms": 3567
        },
        {
