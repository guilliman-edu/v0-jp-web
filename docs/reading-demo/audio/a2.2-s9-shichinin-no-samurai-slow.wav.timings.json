          "text": "七人になりました。",
          "start_ms": 71169,
          "end_ms": 73703,
          "duration_ms": 2534
        }
      ]
    },
    {
      "index": 12,
      "text": "ぶしたちはむらに行って、むらびとたちとみんなで戦いました。",
      "start_ms": 74203,
      "end_ms": 81112,
      "duration_ms": 6909,
      "clauses": [
        {
          "index": 0,
          "text": "ぶしたちはむらに行って、",
