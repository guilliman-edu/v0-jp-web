      "index": 17,
      "text": "わたしたちではありません。」",
      "start_ms": 98120,
      "end_ms": 100944,
      "duration_ms": 2824,
      "clauses": [
        {
          "index": 0,
          "text": "わたしたちではありません。」",
          "start_ms": 98120,
          "end_ms": 100944,
          "duration_ms": 2824
        }
      ]
    },
    {
