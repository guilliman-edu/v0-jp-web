          "duration_ms": 2662
        },
        {
          "index": 1,
          "text": "BBCの「がいこくごえいがベスト100」でいちいになりました。",
          "start_ms": 142281,
          "end_ms": 147300,
          "duration_ms": 5019
        }
      ]
    },
    {
      "index": 25,
      "text": "せんきゅうひゃくろくじゅう年に、アメリカの人がこのえいがとおなじはなしで「こうやのしちにん」というえいがを作りました。",
      "start_ms": 147800,
      "end_ms": 157804,
      "duration_ms": 10004,
      "clauses": [
        {
          "index": 0,
          "text": "せんきゅうひゃくろくじゅう年に、",
          "start_ms": 147800,
          "end_ms": 150845,
          "duration_ms": 3045
        },
        {
          "index": 1,
          "text": "アメリカの人がこのえいがとおなじはなしで「こうやのしちにん」というえいがを作りました。",
          "start_ms": 151095,
          "end_ms": 157804,
          "duration_ms": 6709
        }
