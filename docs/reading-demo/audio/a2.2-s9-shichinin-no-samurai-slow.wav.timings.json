          "text": "むらびとたちとみんなで戦いました。",
          "start_ms": 77231,
          "end_ms": 81112,
          "duration_ms": 3881
        }
      ]
    },
    {
      "index": 13,
      "text": "やっと、ぶしたちは勝ちました。",
      "start_ms": 81612,
      "end_ms": 86118,
      "duration_ms": 4506,
      "clauses": [
        {
          "index": 0,
          "text": "やっと、",
          "start_ms": 81612,
