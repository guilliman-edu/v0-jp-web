 [{"index": 0, "text": "すずめはしんでいました。", "start_ms": 104430, "end_ms": 107185, "duration_ms": 2755}]}, {"index": 23, "text": "いえはあまりたかくなかったから、チョウシロウはしにませんでした。", "start_ms": 107685, "end_ms": 114884, "duration_ms": 7199, "clauses": [{"index": 0, "text": "いえはあまりたかくなかったから、", "start_ms": 107685, "end_ms": 111125, "duration_ms": 3440}, {"index": 1, "text": "チョウシロウはしにませんでした。", "start_ms": 111375, "end_ms": 114884, "duration_ms": 3509}]}, {"index": 24, "text": "ちょっといたかったです。", "start_ms": 115384, "end_ms": 117825, "duration_ms": 2441, "clauses": [{"index": 0, "text": "ちょっといたかったです。", "start_ms": 115384, "end_ms": 117825, "duration_ms": 2441}]}, {"index": 25, "text": "しょうぐんはおおきいおとをききました。", "start_ms": 118325, "end_ms": 122125, "duration_ms": 3800, "clauses": [{"index": 0, "text": "しょうぐんはおおきいおとをききました。", "start_ms": 118325, "end_ms": 122125, "duration_ms": 3800}]}, {"index": 26, "text": "しょうぐんはおきました。", "start_ms": 122625, "end_ms": 125171, "duration_ms": 2546, "clauses": [{"index": 0, "text": "しょうぐんはおきました。", "start_ms": 122625, "end_ms": 125171, "duration_ms": 2546}]}, {"index": 27, "text": "おくさんやぶかをつれて、まどのところにいきました。", "start_ms": 125671, "end_ms": 131535, "duration_ms": 5864, "clauses": [{"index": 0, "text": "おくさんやぶかをつれて、", "start_ms": 125671, "end_ms": 128403, "duration_ms": 2732}, {"index": 1, "text": "まどのところにいきました。", "start_ms": 128653, "end_ms": 131535, "duration_ms": 2882}]}, {"index": 28, "text": "しょうぐんはろうそくをもって、したをみました。", "start_ms": 132035, "end_ms": 137411, "duration_ms": 5376, "clauses": [{"index": 0, "text": "しょうぐんはろうそくをもって、", "start_ms": 132035, "end_ms": 135045, "duration_ms": 3010}, {"index": 1, "text": "したをみました。", "start_ms": 135295, "end_ms": 137411, "duration_ms": 2116}]}, {"index": 29, "text": "したに、おとこのこがいました。", "start_ms": 137911, "end_ms": 142300, "duration_ms": 4389, "clauses": [{"index": 0, "text": "したに、", "start_ms": 137911, "end_ms": 139458, "duration_ms": 1547}, {"index": 1, "text": "おとこのこがいました。", "start_ms": 139708, "end_ms": 142300, "duration_ms": 2592}]}, {"index": 30, "text": "しょうぐんはいいました。", "start_ms": 142800, "end_ms": 145230, "duration_ms": 2430, "clauses": [{"index": 0, "text": "しょうぐんはいいました。", "start_ms": 142800, "end_ms": 145230, "duration_ms": 2430}]}, {"index": 31, "text": "「チョウシロウ、あなたですか。", "start_ms": 145730, "end_ms": 149679, "duration_ms": 3949, "clauses": [{"index": 0, "text": "「チョウシロウ、", "start_ms": 145730, "end_ms": 147382, "duration_ms": 1652}, {"index": 1, "text": "あなたですか。", "start_ms": 147632, "end_ms": 149679, "duration_ms": 2047}]}, {"index": 32, "text": "よるに、なにをしているのですか。", "start_ms": 150179, "end_ms": 154452, "duration_ms": 4273, "clauses": [{"index": 0, "text": "よるに、", "start_ms": 150179, "end_ms": 151575, "duration_ms": 1396}, {"index": 1, "text": "なにをしているのですか。", "start_ms": 151825, "end_ms": 154452, "duration_ms": 2627}]}, {"index": 33, "text": "へやにきてください。", "start_ms": 154952, "end_ms": 157347, "duration_ms": 2395, "clauses": [{"index": 0, "text": "へやにきてください。", "start_ms": 154952, "end_ms": 157347, "duration_ms": 2395}]}, {"index": 34, "text": "せつめいしてください。", "start_ms": 157847, "end_ms": 160381, "duration_ms": 2534, "clauses": [{"index": 0, "text": "せつめいしてください。", "start_ms": 157847, "end_ms": 160381, "duration_ms": 2534}]}, {"index": 35, "text": "」", "start_ms": 160881, "end_ms": 161407, "duration_ms": 526, "clauses": [{"index": 0, "text": "」", "start_ms": 160881, "end_ms": 161407, "duration_ms": 526}]}, {"index": 36, "text": "説明と鞄", "start_ms": 161407, "end_ms": 163616, "duration_ms": 2209, "clauses": [{"index": 0, "text": "説明と鞄", "start_ms": 161407, "end_ms": 163616, "duration_ms": 2209}]}, {"index": 37, "text": "チョウシロウはへやにいきました。", "start_ms": 164116, "end_ms": 167393, "duration_ms": 3277, "clauses": [{"index": 0, "text": "チョウシロウはへやにいきました。", "start_ms": 164116, "end_ms": 167393, "duration_ms": 3277}]}, {"index": 38, "text": "すずめをもっていました。", "start_ms": 167893, "end_ms": 170543, "duration_ms": 2650, "clauses": [{"index": 0, "text": "すずめをもっていました。", "start_ms": 167893, "end_ms": 170543, "