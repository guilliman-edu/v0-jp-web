          "start_ms": 0,
          "end_ms": 2110,
          "duration_ms": 2110
        }
      ]
    },
    {
      "index": 1,
      "text": "むかし、シンデレラという女の子がいました。",
      "start_ms": 2610,
      "end_ms": 7777,
      "duration_ms": 5167,
      "clauses": [
        {
          "index": 0,
          "text": "むかし、",
          "start_ms": 2610,
          "end_ms": 4035,
          "duration_ms": 1425
        },
        {
          "index": 1,
          "text": "シンデレラという女の子がいました。",
          "start_ms": 4285,
          "end_ms": 7777,
          "duration_ms": 3492
        }
      ]
    },
    {
      "index": 2,
      "text": "シンデレラの母が死んだとき、シンデレラは寂しかったです。",
      "start_ms": 8277,
      "end_ms": 14616,
      "duration_ms": 6339,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラの母が死んだとき、",
          "start_ms": 8277,
          "end_ms": 11246,
          "duration_ms": 2969
        },
        {
          "index": 1,
          "text": "シンデレラは寂しかったです。",
          "start_ms": 11496,
          "end_ms": 14616,
          "duration_ms": 3120
        }
      ]
    },
    {
      "index": 3,
      "text": "それから、父の家に継母と二人の女の子が来ました。",
      "start_ms": 15116,
      "end_ms": 21479,
      "duration_ms": 6363,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 15116,
          "end_ms": 16692,
          "duration_ms": 1576
        },
        {
          "index": 1,
          "text": "父の家に継母と二人の女の子が来ました。",
          "start_ms": 16942,
          "end_ms": 21479,
          "duration_ms": 4537
        }
      ]
    },
    {
      "index": 4,
      "text": "継母と二人の女の子はシンデレラに親切ではありませんでした。",
      "start_ms": 21979,
      "end_ms": 27978,
      "duration_ms": 5999,
      "clauses": [
        {
          "index": 0,
          "text": "継母と二人の女の子はシンデレラに親切ではありませんでした。",
          "start_ms": 21979,
          "end_ms": 27978,
          "duration_ms": 5999
        }
      ]
    },
    {
      "index": 5,
      "text": "シンデレラは毎日掃除したり、洗濯したりしました。",
      "start_ms": 28478,
      "end_ms": 34632,
      "duration_ms": 6154,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラは毎日掃除したり、",
          "start_ms": 28478,
          "end_ms": 31854,
          "duration_ms": 3376
        },
        {
          "index": 1,
          "text": "洗濯したりしました。",
          "start_ms": 32104,
          "end_ms": 34632,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 6,
      "text": "それから、服も作りました。",
      "start_ms": 35132,
      "end_ms": 39057,
      "duration_ms": 3925,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 35132,
          "end_ms": 36685,
          "duration_ms": 1553
        },
        {
          "index": 1,
          "text": "服も作りました。",
          "start_ms": 36935,
          "end_ms": 39057,
          "duration_ms": 2122
        }
      ]
    },
    {
      "index": 7,
      "text": "シンデレラはとても忙しかったです。",
      "start_ms": 39557,
      "end_ms": 43083,
      "duration_ms": 3526,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラはとても忙しかったです。",
          "start_ms": 39557,
          "end_ms": 43083,
          "duration_ms": 3526
        }
      ]
    },
    {
      "index": 8,
      "text": "そして、寂しかったです。",
      "start_ms": 43583,
      "end_ms": 47310,
      "duration_ms": 3727,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 43583,
          "end_ms": 44996,
          "duration_ms": 1413
        },
        {
          "index": 1,
