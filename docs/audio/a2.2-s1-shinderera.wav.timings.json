          "start_ms": 45246,
          "end_ms": 47310,
          "duration_ms": 2064
        }
      ]
    },
    {
      "index": 9,
      "text": "ある日、王子の家で大きいパーティーがありました。",
      "start_ms": 47810,
      "end_ms": 53465,
      "duration_ms": 5655,
      "clauses": [
        {
          "index": 0,
          "text": "ある日、",
          "start_ms": 47810,
          "end_ms": 49456,
          "duration_ms": 1646
        },
        {
          "index": 1,
          "text": "王子の家で大きいパーティーがありました。",
          "start_ms": 49706,
          "end_ms": 53465,
          "duration_ms": 3759
        }
      ]
    },
    {
      "index": 10,
      "text": "町の女の子はみんな、パーティーに行きました。",
