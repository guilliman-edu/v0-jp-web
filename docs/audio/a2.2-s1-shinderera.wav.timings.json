      "end_ms": 62694,
      "duration_ms": 3248,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラも行きたいと思いました。",
          "start_ms": 59446,
          "end_ms": 62694,
          "duration_ms": 3248
        }
      ]
    },
    {
