          "start_ms": 72477,
          "end_ms": 74796,
          "duration_ms": 2319
        }
      ]
    },
    {
      "index": 14,
      "text": "鳥はシンデレラに素敵な服と靴をくれました。",
      "start_ms": 75296,
      "end_ms": 79821,
      "duration_ms": 4525,
      "clauses": [
        {
          "index": 0,
          "text": "鳥はシンデレラに素敵な服と靴をくれました。",
          "start_ms": 75296,
          "end_ms": 79821,
          "duration_ms": 4525
        }
      ]
    },
    {
      "index": 15,
      "text": "シンデレラは鳥から服と靴をもらって、パーティーへ行きました。",
      "start_ms": 80321,
