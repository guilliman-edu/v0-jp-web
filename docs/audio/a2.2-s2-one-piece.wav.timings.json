          "text": "せかいじゅうをりょこうしました。",
          "start_ms": 21138,
          "end_ms": 23829,
          "duration_ms": 2691
        }
      ]
    },
    {
      "index": 5,
      "text": "ロジャーはしぬまえに、言いました。",
      "start_ms": 24329,
      "end_ms": 28253,
      "duration_ms": 3924,
      "clauses": [
        {
