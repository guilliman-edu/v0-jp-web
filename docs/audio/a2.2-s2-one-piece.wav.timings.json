          "text": "あそこにおかきました。」",
          "start_ms": 40176,
          "end_ms": 42588,
          "duration_ms": 2412
        }
      ]
    },
    {
      "index": 9,
      "text": "このことばを聞いて、せかいじゅうの人が大きなゆめをもちました。",
      "start_ms": 43088,
      "end_ms": 49729,
      "duration_ms": 6641,
      "clauses": [
        {
          "index": 0,
