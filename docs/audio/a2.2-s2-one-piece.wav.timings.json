          "start_ms": 25696,
          "end_ms": 27272,
          "duration_ms": 1576
        }
      ]
    },
    {
      "index": 6,
      "text": "「みなさん、わたしのたからがほしいですか。",
      "start_ms": 27772,
      "end_ms": 32393,
      "duration_ms": 4621,
      "clauses": [
        {
          "index": 0,
          "text": "「みなさん、",
          "start_ms": 27772,
          "end_ms": 29185,
          "duration_ms": 1413
        },
        {
          "index": 1,
          "text": "わたしのたからがほしいですか。",
          "start_ms": 29435,
          "end_ms": 32393,
          "duration_ms": 2958
        }
      ]
    },
    {
      "index": 7,
      "text": "ほしい人は、じぶんでさがしてください。",
      "start_ms": 32893,
