          "text": "ロジャーはしぬまえに、",
          "start_ms": 24329,
          "end_ms": 26404,
          "duration_ms": 2075
        },
        {
          "index": 1,
          "text": "言いました。",
          "start_ms": 26654,
          "end_ms": 28253,
          "duration_ms": 1599
        }
      ]
    },
    {
      "index": 6,
      "text": "「みなさん、わたしのたからがほしいですか。",
      "start_ms": 28753,
      "end_ms": 33362,
      "duration_ms": 4609,
      "clauses": [
        {
          "index": 0,
          "text": "「みなさん、",
          "start_ms": 28753,
          "end_ms": 30201,
          "duration_ms": 1448
        },
        {
          "index": 1,
          "text": "わたしのたからがほしいですか。",
          "start_ms": 30451,
          "end_ms": 33362,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 7,
      "text": "ほしい人は、じぶんでさがしてください。",
      "start_ms": 33862,
      "end_ms": 38378,
      "duration_ms": 4516,
      "clauses": [
