          "text": "あそこにおかきました。」",
          "start_ms": 41180,
          "end_ms": 43557,
          "duration_ms": 2377
        }
      ]
    },
    {
      "index": 9,
      "text": "このことばを聞いて、せかいじゅうの人が大きなゆめをもちました。",
      "start_ms": 44057,
      "end_ms": 50756,
      "duration_ms": 6699,
      "clauses": [
        {
          "index": 0,
          "text": "このことばを聞いて、",
