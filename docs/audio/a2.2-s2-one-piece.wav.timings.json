          "start_ms": 9453,
          "end_ms": 12341,
          "duration_ms": 2888
        }
      ]
    },
    {
      "index": 3,
      "text": "みんなはロジャーのことを、「かいぞくおう」と言いました。",
      "start_ms": 12841,
      "end_ms": 17787,
      "duration_ms": 4946,
      "clauses": [
