          "start_ms": 15375,
          "end_ms": 17787,
          "duration_ms": 2412
        }
      ]
    },
    {
      "index": 4,
      "text": "ロジャーは、ふねで、せかいじゅうをりょこうしました。",
      "start_ms": 18287,
