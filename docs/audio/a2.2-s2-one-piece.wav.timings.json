          "duration_ms": 1646
        },
        {
          "index": 2,
          "text": "すごくゆうめいなかいぞくがいました。",
          "start_ms": 5647,
          "end_ms": 8953,
          "duration_ms": 3306
        }
      ]
    },
    {
      "index": 2,
      "text": "なまえはゴール・D・ロジャーです。",
