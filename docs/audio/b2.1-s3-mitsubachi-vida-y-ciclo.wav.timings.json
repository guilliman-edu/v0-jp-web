  "sentences": [
    {
      "index": 0,
      "text": "ハチミツができるまで ― ミツバチの生活とハチミツの一生",
      "start_ms": 0,
      "end_ms": 5158,
      "duration_ms": 5158,
      "clauses": [
        {
          "index": 0,
          "text": "ハチミツができるまで ― ミツバチの生活とハチミツの一生",
          "start_ms": 0,
          "end_ms": 5158,
          "duration_ms": 5158
        }
      ]
    },
    {
      "index": 1,
      "text": "みなさんは、ハチミツがどうやってできるのか知っていますか。",
      "start_ms": 5658,
      "end_ms": 11116,
      "duration_ms": 5458,
      "clauses": [
        {
          "index": 0,
          "text": "みなさんは、",
          "start_ms": 5658,
          "end_ms": 7008,
          "duration_ms": 1350
        },
        {
          "index": 1,
          "text": "ハチミツがどうやってできるのか知っていますか。",
          "start_ms": 7258,
          "end_ms": 11116,
          "duration_ms": 3858
        }
      ]
    },
    {
      "index": 2,
      "text": "「ミツバチが花のかみつを集めて作るもの」と思う人が多いかもしれません。",
      "start_ms": 11616,
      "end_ms": 17157,
      "duration_ms": 5541,
      "clauses": [
        {
          "index": 0,
          "text": "「ミツバチが花のかみつを集めて作るもの」と思う人が多いかもしれません。",
          "start_ms": 11616,
          "end_ms": 17157,
          "duration_ms": 5541
        }
      ]
    },
    {
      "index": 3,
      "text": "しかし、かみつそのものがそのままハチミツになることはできません。",
      "start_ms": 17657,
      "end_ms": 24078,
      "duration_ms": 6421,
      "clauses": [
        {
          "index": 0,
          "text": "しかし、",
          "start_ms": 17657,
          "end_ms": 18984,
          "duration_ms": 1327
        },
        {
          "index": 1,
          "text": "かみつそのものがそのままハチミツになることはできません。",
          "start_ms": 19234,
          "end_ms": 24078,
          "duration_ms": 4844
        }
      ]
    },
    {
      "index": 4,
      "text": "かみつとハチミツは、性質も成分も少しずつ違っていくのです。",
      "start_ms": 24578,
      "end_ms": 30825,
      "duration_ms": 6247,
      "clauses": [
        {
          "index": 0,
          "text": "かみつとハチミツは、",
          "start_ms": 24578,
          "end_ms": 26729,
          "duration_ms": 2151
        },
        {
          "index": 1,
          "text": "性質も成分も少しずつ違っていくのです。",
          "start_ms": 26979,
          "end_ms": 30825,
          "duration_ms": 3846
        }
      ]
    },
    {
      "index": 5,
      "text": "ハチミツ作りは、ミツバチたちの忙しい一日の中から始まります。",
      "start_ms": 31325,
      "end_ms": 37897,
      "duration_ms": 6572,
      "clauses": [
        {
          "index": 0,
          "text": "ハチミツ作りは、",
          "start_ms": 31325,
          "end_ms": 33325,
          "duration_ms": 2000
        },
        {
          "index": 1,
          "text": "ミツバチたちの忙しい一日の中から始まります。",
          "start_ms": 33575,
          "end_ms": 37897,
          "duration_ms": 4322
        }
      ]
    },
    {
      "index": 6,
      "text": "朝早く、がいきんばちと呼ばれるはたらきばちたちは、すを飛び立って花を探しに出かけます。",
      "start_ms": 38397,
      "end_ms": 47812,
      "duration_ms": 9415,
      "clauses": [
        {
          "index": 0,
          "text": "朝早く、",
          "start_ms": 38397,
          "end_ms": 40258,
          "duration_ms": 1861
        },
        {
          "index": 1,
          "text": "がいきんばちと呼ばれるはたらきばちたちは、",
          "start_ms": 40508,
          "end_ms": 43890,
          "duration_ms": 3382
        },
        {
          "index": 2,
          "text": "すを飛び立って花を探しに出かけます。",
          "start_ms": 44140,
          "end_ms": 47812,
          "duration_ms": 3672
        }
      ]
    },
    {
      "index": 7,
      "text": "彼らが目指すのは、甘いかみつと、タンパク源となるかふんです。",
      "start_ms": 48312,
      "end_ms": 55032,
      "duration_ms": 6720,
      "clauses": [
        {
          "index": 0,
          "text": "彼らが目指すのは、",
          "start_ms": 48312,
          "end_ms": 50289,
          "duration_ms": 1977
        },
        {
          "index": 1,
          "text": "甘いかみつと、",
          "start_ms": 50539,
          "end_ms": 52167,
          "duration_ms": 1628
        },
        {
          "index": 2,
          "text": "タンパク源となるかふんです。",
          "start_ms": 52417,
          "end_ms": 55032,
          "duration_ms": 2615
        }
      ]
    },
    {
      "index": 8,
      "text": "がいきんばちは、すから2〜3km離れた場所まで飛び、1日に何度も花を訪れます。",
      "start_ms": 55532,
      "end_ms": 64307,
      "duration_ms": 8775,
      "clauses": [
        {
          "index": 0,
          "text": "がいきんばちは、",
          "start_ms": 55532,
          "end_ms": 57311,
          "duration_ms": 1779
        },
        {
          "index": 1,
          "text": "すから2〜3km離れた場所まで飛び、",
          "start_ms": 57561,
          "end_ms": 60687,
          "duration_ms": 3126
        },
        {
          "index": 2,
          "text": "1日に何度も花を訪れます。",
          "start_ms": 60937,
          "end_ms": 64307,
          "duration_ms": 3370
        }
      ]
    },
    {
      "index": 9,
      "text": "大切なかみつを集めるためには、自分の体重の半分近くもの重さを運ばなければなりません。",
      "start_ms": 64807,
      "end_ms": 73190,
      "duration_ms": 8383,
      "clauses": [
        {
          "index": 0,
          "text": "大切なかみつを集めるためには、",
          "start_ms": 64807,
          "end_ms": 67852,
          "duration_ms": 3045
        },
        {
          "index": 1,
          "text": "自分の体重の半分近くもの重さを運ばなければなりません。",
          "start_ms": 68102,
          "end_ms": 73190,
          "duration_ms": 5088
        }
      ]
    },
    {
      "index": 10,
      "text": "そのため、経験を積んだ年配のがいきんばちがこの仕事を担当するのがふつうです。",
      "start_ms": 73690,
      "end_ms": 81121,
      "duration_ms": 7431,
      "clauses": [
        {
          "index": 0,
          "text": "そのため、",
          "start_ms": 73690,
          "end_ms": 75121,
          "duration_ms": 1431
        },
        {
          "index": 1,
          "text": "経験を積んだ年配のがいきんばちがこの仕事を担当するのがふつうです。",
          "start_ms": 75371,
          "end_ms": 81121,
          "duration_ms": 5750
        }
      ]
    },
    {
