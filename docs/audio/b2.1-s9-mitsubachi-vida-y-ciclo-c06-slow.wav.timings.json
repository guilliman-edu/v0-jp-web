          "duration_ms": 4328
        }
      ]
    },
    {
      "index": 1,
      "text": "ハチミツは、単に甘いだけのものではありません。",
      "start_ms": 4828,
      "end_ms": 10169,
      "duration_ms": 5341,
      "clauses": [
        {
          "index": 0,
          "text": "ハチミツは、",
          "start_ms": 4828,
          "end_ms": 6578,
          "duration_ms": 1750
        },
        {
          "index": 1,
          "text": "単に甘いだけのものではありません。",
          "start_ms": 6828,
          "end_ms": 10169,
          "duration_ms": 3341
        }
      ]
    },
    {
      "index": 2,
      "text": "ミツバチたちはかみつを集めるために花を訪れ、その過程でかふんを運び、受粉を助けています。",
      "start_ms": 10669,
      "end_ms": 21330,
      "duration_ms": 10661,
      "clauses": [
        {
          "index": 0,
          "text": "ミツバチたちはかみつを集めるために花を訪れ、",
          "start_ms": 10669,
          "end_ms": 15484,
          "duration_ms": 4815
        },
        {
          "index": 1,
          "text": "その過程でかふんを運び、",
          "start_ms": 15734,
          "end_ms": 18645,
          "duration_ms": 2911
        },
        {
          "index": 2,
          "text": "受粉を助けています。",
          "start_ms": 18895,
          "end_ms": 21330,
          "duration_ms": 2435
        }
      ]
    },
    {
      "index": 3,
      "text": "つまり、ミツバチがいなければ、多くの野菜や果物も実らないはずだということが言えるでしょう。",
      "start_ms": 21830,
      "end_ms": 31818,
      "duration_ms": 9988,
      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 21830,
          "end_ms": 23209,
          "duration_ms": 1379
        },
        {
          "index": 1,
          "text": "ミツバチがいなければ、",
          "start_ms": 23459,
          "end_ms": 25801,
          "duration_ms": 2342
        },
        {
          "index": 2,
          "text": "多くの野菜や果物も実らないはずだということが言えるでしょう。",
          "start_ms": 26051,
          "end_ms": 31818,
          "duration_ms": 5767
        }
      ]
    },
    {
      "index": 4,
      "text": "私たちがハチミツを味わうとき、その一さじには、がいきんばちが何度も花を訪れて運んだかみつと、ないきんばちがすいぶんを飛ばしてじゅくせいさせた時間と、はたらきばちたち全員の役割分担のりゆうが詰まっています。",
      "start_ms": 32318,
      "end_ms": 53795,
      "duration_ms": 21477,
      "clauses": [
        {
          "index": 0,
          "text": "私たちがハチミツを味わうとき、",
          "start_ms": 32318,
          "end_ms": 35810,
          "duration_ms": 3492
        },
        {
          "index": 1,
          "text": "その一さじには、",
          "start_ms": 36060,
          "end_ms": 38263,
          "duration_ms": 2203
        },
        {
          "index": 2,
          "text": "がいきんばちが何度も花を訪れて運んだかみつと、",
          "start_ms": 38513,
          "end_ms": 43235,
          "duration_ms": 4722
        },
        {
          "index": 3,
          "text": "ないきんばちがすいぶんを飛ばしてじゅくせいさせた時間と、",
          "start_ms": 43485,
          "end_ms": 48370,
          "duration_ms": 4885
        },
        {
          "index": 4,
          "text": "はたらきばちたち全員の役割分担のりゆうが詰まっています。",
          "start_ms": 48620,
          "end_ms": 53795,
          "duration_ms": 5175
        }
      ]
    },
    {
      "index": 5,
      "text": "長い目で見れば、ミツバチと人間は、自然の中で少しずつつながって生きてきた関係なのかもしれません。",
      "start_ms": 54295,
      "end_ms": 65118,
      "duration_ms": 10823,
      "clauses": [
        {
          "index": 0,
          "text": "長い目で見れば、",
          "start_ms": 54295,
          "end_ms": 56405,
          "duration_ms": 2110
        },
        {
          "index": 1,
          "text": "ミツバチと人間は、",
          "start_ms": 56655,
          "end_ms": 58962,
          "duration_ms": 2307
        },
        {
          "index": 2,
          "text": "自然の中で少しずつつながって生きてきた関係なのかもしれません。",
          "start_ms": 59212,
          "end_ms": 65118,
          "duration_ms": 5906
        }
      ]
    },
    {
      "index": 6,
      "text": "ハチミツを食べるという行為を通して、私たちもそのつながりを少しだけ意識できるようになるでしょう。",
      "start_ms": 65618,
      "end_ms": 75150,
      "duration_ms": 9532,
      "clauses": [
