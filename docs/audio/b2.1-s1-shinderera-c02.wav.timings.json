  "sentences": [
    {
      "index": 0,
      "text": "はしばみの木",
      "start_ms": 0,
      "end_ms": 1791,
      "duration_ms": 1791,
      "clauses": [
        {
          "index": 0,
          "text": "はしばみの木",
          "start_ms": 0,
          "end_ms": 1791,
          "duration_ms": 1791
        }
      ]
    },
    {
      "index": 1,
      "text": "たまたまある日、父親が町に行くところでした。",
      "start_ms": 2291,
      "end_ms": 7284,
      "duration_ms": 4993,
      "clauses": [
        {
          "index": 0,
          "text": "たまたまある日、",
          "start_ms": 2291,
          "end_ms": 4128,
          "duration_ms": 1837
        },
        {
          "index": 1,
          "text": "父親が町に行くところでした。",
          "start_ms": 4378,
          "end_ms": 7284,
          "duration_ms": 2906
        }
      ]
    },
    {
      "index": 2,
      "text": "二人のこいもうとに「お土産に何がほしい？」",
      "start_ms": 7784,
      "end_ms": 11351,
      "duration_ms": 3567,
      "clauses": [
        {
          "index": 0,
          "text": "二人のこいもうとに「お土産に何がほしい？」",
          "start_ms": 7784,
          "end_ms": 11351,
          "duration_ms": 3567
        }
      ]
    },
    {
      "index": 3,
      "text": "と聞きました。",
      "start_ms": 11851,
      "end_ms": 13561,
      "duration_ms": 1710,
      "clauses": [
        {
          "index": 0,
          "text": "と聞きました。",
          "start_ms": 11851,
          "end_ms": 13561,
          "duration_ms": 1710
        }
      ]
    },
    {
      "index": 4,
      "text": "「きれいなドレスがいいです。」",
      "start_ms": 14061,
      "end_ms": 16316,
      "duration_ms": 2255,
      "clauses": [
        {
          "index": 0,
          "text": "「きれいなドレスがいいです。」",
          "start_ms": 14061,
          "end_ms": 16316,
          "duration_ms": 2255
        }
      ]
    },
    {
      "index": 5,
      "text": "一人が言いました。",
      "start_ms": 16816,
      "end_ms": 18723,
      "duration_ms": 1907,
      "clauses": [
        {
          "index": 0,
          "text": "一人が言いました。",
          "start_ms": 16816,
          "end_ms": 18723,
          "duration_ms": 1907
        }
      ]
    },
    {
      "index": 6,
      "text": "「しんじゅとほうせきをお願いします。」",
      "start_ms": 19223,
      "end_ms": 22140,
      "duration_ms": 2917,
      "clauses": [
        {
          "index": 0,
          "text": "「しんじゅとほうせきをお願いします。」",
          "start_ms": 19223,
          "end_ms": 22140,
          "duration_ms": 2917
        }
      ]
    },
    {
      "index": 7,
      "text": "もう一人が言いました。",
      "start_ms": 22640,
      "end_ms": 24756,
      "duration_ms": 2116,
      "clauses": [
        {
          "index": 0,
          "text": "もう一人が言いました。",
          "start_ms": 22640,
          "end_ms": 24756,
          "duration_ms": 2116
        }
      ]
    },
    {
      "index": 8,
      "text": "「それでは、シンデレラ、あなたは何かほしいものがある？」",
      "start_ms": 25256,
      "end_ms": 31791,
      "duration_ms": 6535,
      "clauses": [
        {
          "index": 0,
          "text": "「それでは、",
          "start_ms": 25256,
          "end_ms": 26687,
          "duration_ms": 1431
        },
        {
          "index": 1,
          "text": "シンデレラ、",
          "start_ms": 26937,
          "end_ms": 28426,
          "duration_ms": 1489
        },
        {
          "index": 2,
          "text": "あなたは何かほしいものがある？」",
          "start_ms": 28676,
          "end_ms": 31791,
          "duration_ms": 3115
        }
      ]
    },
    {
      "index": 9,
      "text": "「お父さん、帰り道で、お父さんのぼうしにぶつかる最初の枝を折ってきてください。」",
      "start_ms": 32291,
      "end_ms": 40417,
      "duration_ms": 8126,
      "clauses": [
        {
          "index": 0,
          "text": "「お父さん、",
          "start_ms": 32291,
          "end_ms": 33734,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "帰り道で、",
          "start_ms": 33984,
          "end_ms": 35543,
          "duration_ms": 1559
        },
        {
          "index": 2,
          "text": "お父さんのぼうしにぶつかる最初の枝を折ってきてください。」",
          "start_ms": 35793,
          "end_ms": 40417,
          "duration_ms": 4624
        }
      ]
    },
    {
      "index": 10,
      "text": "父親は二人のこいもうとにはドレスとしんじゅとほうせきを買いました。",
      "start_ms": 40917,
      "end_ms": 46516,
      "duration_ms": 5599,
      "clauses": [
        {
          "index": 0,
          "text": "父親は二人のこいもうとにはドレスとしんじゅとほうせきを買いました。",
          "start_ms": 40917,
          "end_ms": 46516,
          "duration_ms": 5599
        }
      ]
    },
    {
      "index": 11,
      "text": "帰り道に、緑のしげみを馬で通ったとき、はしばみの枝に当たりました。",
      "start_ms": 47016,
      "end_ms": 54805,
      "duration_ms": 7789,
      "clauses": [
        {
          "index": 0,
          "text": "帰り道に、",
          "start_ms": 47016,
          "end_ms": 48575,
          "duration_ms": 1559
        },
        {
          "index": 1,
          "text": "緑のしげみを馬で通ったとき、",
          "start_ms": 48825,
          "end_ms": 51893,
          "duration_ms": 3068
        },
        {
          "index": 2,
          "text": "はしばみの枝に当たりました。",
          "start_ms": 52143,
          "end_ms": 54805,
          "duration_ms": 2662
        }
      ]
    },
    {
      "index": 12,
      "text": "ぼうしが落ちたので、その枝を折って持ち帰りました。",
      "start_ms": 55305,
      "end_ms": 60519,
      "duration_ms": 5214,
      "clauses": [
        {
          "index": 0,
          "text": "ぼうしが落ちたので、",
          "start_ms": 55305,
          "end_ms": 57282,
          "duration_ms": 1977
        },
        {
          "index": 1,
          "text": "その枝を折って持ち帰りました。",
          "start_ms": 57532,
          "end_ms": 60519,
          "duration_ms": 2987
        }
      ]
    },
    {
      "index": 13,
      "text": "家に着くと、こいもうとには望んだ品物を渡しました。",
      "start_ms": 61019,
      "end_ms": 66709,
      "duration_ms": 5690,
      "clauses": [
        {
          "index": 0,
          "text": "家に着くと、",
          "start_ms": 61019,
          "end_ms": 62601,
          "duration_ms": 1582
        },
        {
          "index": 1,
          "text": "こいもうとには望んだ品物を渡しました。",
          "start_ms": 62851,
          "end_ms": 66709,
          "duration_ms": 3858
        }
      ]
    },
    {
      "index": 14,
      "text": "シンデレラには、はしばみの木から取った枝を渡しました。",
      "start_ms": 67209,
      "end_ms": 72817,
      "duration_ms": 5608,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラには、",
          "start_ms": 67209,
          "end_ms": 69000,
          "duration_ms": 1791
        },
        {
          "index": 1,
          "text": "はしばみの木から取った枝を渡しました。",
          "start_ms": 69250,
          "end_ms": 72817,
          "duration_ms": 3567
        }
      ]
    },
    {
      "index": 15,
      "text": "シンデレラは父親にお礼を言いました。",
      "start_ms": 73317,
      "end_ms": 76908,
      "duration_ms": 3591,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラは父親にお礼を言いました。",
          "start_ms": 73317,
          "end_ms": 76908,
          "duration_ms": 3591
        }
      ]
    },
    {
      "index": 16,
      "text": "それから、母親の墓に行って、枝を植えました。",
      "start_ms": 77408,
      "end_ms": 83396,
      "duration_ms": 5988,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 77408,
          "end_ms": 78827,
          "duration_ms": 1419
        },
        {
          "index": 1,
          "text": "母親の墓に行って、",
          "start_ms": 79077,
          "end_ms": 81251,
          "duration_ms": 2174
        },
        {
          "index": 2,
          "text": "枝を植えました。",
          "start_ms": 81501,
          "end_ms": 83396,
          "duration_ms": 1895
        }
      ]
    },
    {
      "index": 17,
      "text": "とても泣いたので、なみだが枝に落ちて、枝を濡らしました。",
      "start_ms": 83896,
      "end_ms": 90384,
      "duration_ms": 6488,
      "clauses": [
        {
          "index": 0,
          "text": "とても泣いたので、",
          "start_ms": 83896,
          "end_ms": 85733,
          "duration_ms": 1837
        },
        {
          "index": 1,
          "text": "なみだが枝に落ちて、",
          "start_ms": 85983,
          "end_ms": 88122,
          "duration_ms": 2139
        },
        {
          "index": 2,
          "text": "枝を濡らしました。",
          "start_ms": 88372,
          "end_ms": 90384,
          "duration_ms": 2012
        }
      ]
    },
    {
      "index": 18,
      "text": "すると、その枝は大きくなって、りっぱな木になりました。",
      "start_ms": 90884,
      "end_ms": 97291,
      "duration_ms": 6407,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 90884,
          "end_ms": 92013,
          "duration_ms": 1129
        },
        {
          "index": 1,
          "text": "その枝は大きくなって、",
          "start_ms": 92263,
          "end_ms": 94797,
          "duration_ms": 2534
        },
        {
          "index": 2,
          "text": "りっぱな木になりました。",
          "start_ms": 95047,
          "end_ms": 97291,
          "duration_ms": 2244
        }
      ]
    },
    {
      "index": 19,
      "text": "日に三度、シンデレラはその木の下に行って座り、泣いて、お祈りをしました。",
      "start_ms": 97791,
      "end_ms": 106622,
      "duration_ms": 8831,
      "clauses": [
        {
          "index": 0,
          "text": "日に三度、",
          "start_ms": 97791,
          "end_ms": 99524,
          "duration_ms": 1733
        },
        {
          "index": 1,
          "text": "シンデレラはその木の下に行って座り、",
          "start_ms": 99774,
          "end_ms": 103272,
          "duration_ms": 3498
        },
        {
          "index": 2,
          "text": "泣いて、",
          "start_ms": 103522,
          "end_ms": 104558,
          "duration_ms": 1036
        },
        {
          "index": 3,
          "text": "お祈りをしました。",
          "start_ms": 104808,
          "end_ms": 106622,
          "duration_ms": 1814
        }
      ]
    },
    {
      "index": 20,
      "text": "すると、一羽の小さい白い鳥がその木に来て、シンデレラが何かを望むと、その鳥が望んだものを落としてくれました。",
      "start_ms": 107122,
      "end_ms": 119168,
      "duration_ms": 12046,
      "clauses": [
        {
          "index": 0,
          "text": "すると、",
          "start_ms": 107122,
          "end_ms": 108321,
          "duration_ms": 1199
        },
        {
          "index": 1,
          "text": "一羽の小さい白い鳥がその木に来て、",
          "start_ms": 108571,
          "end_ms": 112312,
          "duration_ms": 3741
        },
        {
          "index": 2,
          "text": "シンデレラが何かを望むと、",
          "start_ms": 112562,
          "end_ms": 115351,
          "duration_ms": 2789
        },
        {
          "index": 3,
          "text": "その鳥が望んだものを落としてくれました。",
          "start_ms": 115601,
          "end_ms": 119168,
          "duration_ms": 3567
        }
      ]
    }
  ]
}