          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 17,
      "text": "ささだんごは、まいにちのたいせつなごはんでした。",
      "start_ms": 102399,
      "end_ms": 107635,
      "duration_ms": 5236,
      "clauses": [
        {
          "index": 0,
          "text": "ささだんごは、",
          "start_ms": 102399,
