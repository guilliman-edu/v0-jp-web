          "start_ms": 39076,
          "end_ms": 42637,
          "duration_ms": 3561
        }
      ]
    },
    {
      "index": 9,
      "text": "にいがたけんの「ささだんご」も、そのひとつです。",
      "start_ms": 43137,
      "end_ms": 48083,
      "duration_ms": 4946,
      "clauses": [
        {
          "index": 0,
          "text": "にいがたけんの「ささだんご」も、",
