          "end_ms": 53402,
          "duration_ms": 2772
        },
        {
          "index": 2,
          "text": "ひもでむすんだものです。",
          "start_ms": 53652,
          "end_ms": 56261,
          "duration_ms": 2609
        }
      ]
    },
    {
      "index": 11,
      "text": "にいがたのひとは、ごひゃくねんぐらいまえからささだんごをたべています。",
      "start_ms": 56761,
      "end_ms": 63112,
      "duration_ms": 6351,
      "clauses": [
        {
          "index": 0,
          "text": "にいがたのひとは、",
          "start_ms": 56761,
          "end_ms": 58732,
          "duration_ms": 1971
        },
        {
          "index": 1,
          "text": "ごひゃくねんぐらいまえからささだんごをたべています。",
          "start_ms": 58982,
          "end_ms": 63112,
          "duration_ms": 4130
        }
      ]
    },
    {
      "index": 12,
      "text": "ささのはのなかのだんごは、ながいあいだわるくなりません。",
