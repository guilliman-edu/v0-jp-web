          "index": 1,
          "text": "そのひとつです。",
          "start_ms": 46101,
          "end_ms": 48083,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 10,
      "text": "ささだんごは、だんごをささのはでつつんで、ひもでむすんだものです。",
      "start_ms": 48583,
      "end_ms": 56261,
      "duration_ms": 7678,
      "clauses": [
        {
          "index": 0,
          "text": "ささだんごは、",
          "start_ms": 48583,
          "end_ms": 50380,
          "duration_ms": 1797
        },
        {
          "index": 1,
          "text": "だんごをささのはでつつんで、",
