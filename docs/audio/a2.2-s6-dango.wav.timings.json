      "end_ms": 69405,
      "duration_ms": 5793,
      "clauses": [
        {
          "index": 0,
          "text": "ささのはのなかのだんごは、",
          "start_ms": 63612,
          "end_ms": 66314,
          "duration_ms": 2702
        },
        {
          "index": 1,
          "text": "ながいあいだわるくなりません。",
          "start_ms": 66564,
          "end_ms": 69405,
          "duration_ms": 2841
        }
      ]
    },
    {
      "index": 13,
      "text": "だから、むかしのひとは、りょこうのとき、ささだんごをもっていったでしょう。",
