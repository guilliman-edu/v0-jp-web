          "start_ms": 12979,
          "end_ms": 15077,
          "duration_ms": 2098
        }
      ]
    },
    {
      "index": 4,
      "text": "だんごのれきしは、とてもながいです。",
      "start_ms": 15577,
      "end_ms": 19757,
      "duration_ms": 4180,
      "clauses": [
        {
