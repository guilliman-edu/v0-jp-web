          "end_ms": 25308,
          "duration_ms": 2040
        },
        {
          "index": 2,
          "text": "かみがすごく重かったです」。",
          "start_ms": 25558,
          "end_ms": 28341,
          "duration_ms": 2783
        }
      ]
    },
    {
      "index": 6,
      "text": "むじょは「あなたはおうじと話したのでしょう。",
