          "end_ms": 32797,
          "duration_ms": 3956
        }
      ]
    },
    {
      "index": 7,
      "text": "悪い子ですね」と怒りました。",
      "start_ms": 33297,
      "end_ms": 36185,
      "duration_ms": 2888,
