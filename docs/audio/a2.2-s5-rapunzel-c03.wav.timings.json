          "start_ms": 14070,
          "end_ms": 17144,
          "duration_ms": 3074
        }
      ]
    },
    {
      "index": 4,
      "text": "「おばさん、あなたはおもいです。",
      "start_ms": 17644,
      "end_ms": 21348,
      "duration_ms": 3704,
      "clauses": [
        {
          "index": 0,
          "text": "「おばさん、",
          "start_ms": 17644,
          "end_ms": 18860,
          "duration_ms": 1216
