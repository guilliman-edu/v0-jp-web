        {
          "index": 1,
          "text": "あなたはおもいです。",
          "start_ms": 19110,
          "end_ms": 21348,
          "duration_ms": 2238
        }
      ]
    },
    {
      "index": 5,
      "text": "だから、上にのぼるとき、かみがすごく重かったです」。",
      "start_ms": 21848,
      "end_ms": 28341,
      "duration_ms": 6493,
      "clauses": [
