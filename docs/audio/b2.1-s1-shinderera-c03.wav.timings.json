{
  "audio_file": "b2.1-s1-shinderera-c03.wav",
  "sample_rate": 44100,
  "pause_ms": 500,
  "total_duration_ms": 220581,
  "sentences": [
    {
      "index": 0,
      "text": "舞踏会への招待",
      "start_ms": 0,
      "end_ms": 2139,
      "duration_ms": 2139,
      "clauses": [
        {
          "index": 0,
          "text": "舞踏会への招待",
          "start_ms": 0,
          "end_ms": 2139,
          "duration_ms": 2139
        }
      ]
    },
    {
      "index": 1,
      "text": "ところが、王様がお祝いを開くことになりました。",
      "start_ms": 2639,
      "end_ms": 7806,
      "duration_ms": 5167,
      "clauses": [
        {
          "index": 0,
          "text": "ところが、",
          "start_ms": 2639,
          "end_ms": 3977,
          "duration_ms": 1338
        },
        {
          "index": 1,
          "text": "王様がお祝いを開くことになりました。",
          "start_ms": 4227,
          "end_ms": 7806,
          "duration_ms": 3579
        }
      ]
    },
    {
      "index": 2,
      "text": "三日間続くお祝いで、王様の息子が花嫁を選ぶために、国の美しい若い娘は全部招待されることになりました。",
      "start_ms": 8306,
      "end_ms": 19821,
      "duration_ms": 11515,
      "clauses": [
        {
          "index": 0,
          "text": "三日間続くお祝いで、",
          "start_ms": 8306,
          "end_ms": 10654,
          "duration_ms": 2348
        },
        {
          "index": 1,
          "text": "王様の息子が花嫁を選ぶために、",
          "start_ms": 10904,
          "end_ms": 14239,
          "duration_ms": 3335
        },
        {
          "index": 2,
          "text": "国の美しい若い娘は全部招待されることになりました。",
          "start_ms": 14489,
          "end_ms": 19821,
          "duration_ms": 5332
        }
      ]
    },
    {
      "index": 3,
      "text": "二人の継娘は、自分たちもお祝いに行けると聞いて、とても喜びました。",
      "start_ms": 20321,
      "end_ms": 28214,
      "duration_ms": 7893,
      "clauses": [
        {
          "index": 0,
          "text": "二人の継娘は、",
          "start_ms": 20321,
          "end_ms": 22495,
          "duration_ms": 2174
        },
        {
          "index": 1,
          "text": "自分たちもお祝いに行けると聞いて、",
          "start_ms": 22745,
          "end_ms": 25801,
          "duration_ms": 3056
        },
        {
          "index": 2,
          "text": "とても喜びました。",
          "start_ms": 26051,
          "end_ms": 28214,
          "duration_ms": 2163
        }
      ]
    },
    {
      "index": 4,
      "text": "そして、シンデレラを呼びました。",
      "start_ms": 28714,
      "end_ms": 32522,
      "duration_ms": 3808,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 28714,
          "end_ms": 29959,
          "duration_ms": 1245
        },
        {
          "index": 1,
          "text": "シンデレラを呼びました。",
          "start_ms": 30209,
          "end_ms": 32522,
          "duration_ms": 2313
        }
      ]
    },
    {
      "index": 5,
      "text": "「私たちの髪をとかして、靴を磨いて、ベルトをしめて。",
      "start_ms": 33022,
      "end_ms": 39488,
      "duration_ms": 6466,
      "clauses": [
        {
          "index": 0,
          "text": "「私たちの髪をとかして、",
          "start_ms": 33022,
          "end_ms": 35556,
          "duration_ms": 2534
        },
        {
          "index": 1,
          "text": "靴を磨いて、",
          "start_ms": 35806,
          "end_ms": 37493,
          "duration_ms": 1687
        },
        {
          "index": 2,
          "text": "ベルトをしめて。",
          "start_ms": 37743,
          "end_ms": 39488,
          "duration_ms": 1745
        }
      ]
    },
    {
      "index": 6,
      "text": "私たちは王様の宮殿のお祝いに行くのだから。",
      "start_ms": 39988,
      "end_ms": 44507,
      "duration_ms": 4519,
      "clauses": [
        {
          "index": 0,
          "text": "私たちは王様の宮殿のお祝いに行くのだから。",
          "start_ms": 39988,
          "end_ms": 44507,
          "duration_ms": 4519
        }
      ]
    },
    {
      "index": 7,
      "text": "」 シンデレラも行きたくて、泣きました。",
      "start_ms": 45007,
      "end_ms": 49037,
      "duration_ms": 4030,
      "clauses": [
        {
          "index": 0,
          "text": "」 シンデレラも行きたくて、",
          "start_ms": 45007,
          "end_ms": 47228,
          "duration_ms": 2221
        },
        {
          "index": 1,
          "text": "泣きました。",
          "start_ms": 47478,
          "end_ms": 49037,
          "duration_ms": 1559
        }
      ]
    },
    {
      "index": 8,
      "text": "自分も一緒に踊りに行きたかったからです。",
      "start_ms": 49537,
      "end_ms": 53116,
      "duration_ms": 3579,
      "clauses": [
        {
          "index": 0,
          "text": "自分も一緒に踊りに行きたかったからです。",
          "start_ms": 49537,
          "end_ms": 53116,
          "duration_ms": 3579
        }
      ]
    },
    {
      "index": 9,
      "text": "それから、継母にそうする許可をもらおうと頼みました。",
      "start_ms": 53616,
      "end_ms": 59213,
      "duration_ms": 5597,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 53616,
          "end_ms": 55059,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "継母にそうする許可をもらおうと頼みました。",
          "start_ms": 55309,
          "end_ms": 59213,
          "duration_ms": 3904
        }
      ]
    },
    {
      "index": 10,
      "text": "「あなたは埃と泥まみれでしょう。",
      "start_ms": 59713,
      "end_ms": 62758,
      "duration_ms": 3045,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたは埃と泥まみれでしょう。",
          "start_ms": 59713,
          "end_ms": 62758,
          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 11,
      "text": "それで舞踏会に行くの？",
      "start_ms": 63258,
      "end_ms": 65571,
      "duration_ms": 2313,
      "clauses": [
        {
          "index": 0,
          "text": "それで舞踏会に行くの？",
          "start_ms": 63258,
          "end_ms": 65571,
          "duration_ms": 2313
        }
      ]
    },
    {
      "index": 12,
      "text": "服もないし、靴もないのに、踊るっていうの？",
      "start_ms": 66071,
      "end_ms": 71631,
      "duration_ms": 5560,
      "clauses": [
        {
          "index": 0,
          "text": "服もないし、",
          "start_ms": 66071,
          "end_ms": 67699,
          "duration_ms": 1628
        },
        {
          "index": 1,
          "text": "靴もないのに、",
          "start_ms": 67949,
          "end_ms": 69636,
          "duration_ms": 1687
        },
        {
          "index": 2,
          "text": "踊るっていうの？",
          "start_ms": 69886,
          "end_ms": 71631,
          "duration_ms": 1745
        }
      ]
    },
    {
      "index": 13,
      "text": "」 でも、シンデレラがしつこく頼み続けたので、継母はついにこう言いました。",
      "start_ms": 72131,
      "end_ms": 79734,
      "duration_ms": 7603,
      "clauses": [
        {
          "index": 0,
          "text": "」 でも、",
          "start_ms": 72131,
          "end_ms": 73016,
          "duration_ms": 885
        },
        {
          "index": 1,
          "text": "シンデレラがしつこく頼み続けたので、",
          "start_ms": 73266,
          "end_ms": 76578,
          "duration_ms": 3312
        },
        {
          "index": 2,
          "text": "継母はついにこう言いました。",
          "start_ms": 76828,
          "end_ms": 79734,
          "duration_ms": 2906
        }
      ]
    },
    {
      "index": 14,
      "text": "「ほら、灰の中にレンズ豆を一皿空けておいたから。",
      "start_ms": 80234,
      "end_ms": 85122,
      "duration_ms": 4888,
      "clauses": [
        {
          "index": 0,
          "text": "「ほら、",
          "start_ms": 80234,
          "end_ms": 80980,
          "duration_ms": 746
        },
        {
          "index": 1,
          "text": "灰の中にレンズ豆を一皿空けておいたから。",
          "start_ms": 81230,
          "end_ms": 85122,
          "duration_ms": 3892
        }
      ]
    },
    {
      "index": 15,
      "text": "二時間でそれを全部拾えたら、一緒に行ってあげるよ。",
      "start_ms": 85622,
      "end_ms": 90917,
      "duration_ms": 5295,
      "clauses": [
        {
          "index": 0,
          "text": "二時間でそれを全部拾えたら、",
          "start_ms": 85622,
          "end_ms": 88574,
          "duration_ms": 2952
        },
        {
          "index": 1,
          "text": "一緒に行ってあげるよ。",
          "start_ms": 88824,
          "end_ms": 90917,
          "duration_ms": 2093
        }
      ]
    },
    {
      "index": 16,
      "text": "」 娘は裏口から庭に出ました。",
      "start_ms": 91417,
      "end_ms": 94450,
      "duration_ms": 3033,
      "clauses": [
        {
          "index": 0,
          "text": "」 娘は裏口から庭に出ました。",
          "start_ms": 91417,
          "end_ms": 94450,
          "duration_ms": 3033
        }
      ]
    },
    {
      "index": 17,
      "text": "「お友達のハトさん、キジバトさん、空の下の小鳥さんたち、みんな。",
      "start_ms": 94950,
      "end_ms": 103049,
      "duration_ms": 8099,
      "clauses": [
        {
          "index": 0,
          "text": "「お友達のハトさん、",
          "start_ms": 94950,
          "end_ms": 97054,
          "duration_ms": 2104
        },
        {
          "index": 1,
          "text": "キジバトさん、",
          "start_ms": 97304,
          "end_ms": 98898,
          "duration_ms": 1594
        },
        {
          "index": 2,
          "text": "空の下の小鳥さんたち、",
          "start_ms": 99148,
          "end_ms": 101728,
          "duration_ms": 2580
        },
        {
          "index": 3,
          "text": "みんな。",
          "start_ms": 101978,
          "end_ms": 103049,
          "duration_ms": 1071
        }
      ]
    },
    {
      "index": 18,
      "text": "いい豆はかごに、悪い豆はみんなさんに。",
      "start_ms": 103549,
      "end_ms": 108147,
      "duration_ms": 4598,
      "clauses": [
        {
          "index": 0,
          "text": "いい豆はかごに、",
          "start_ms": 103549,
          "end_ms": 105363,
          "duration_ms": 1814
        },
        {
          "index": 1,
          "text": "悪い豆はみんなさんに。",
          "start_ms": 105613,
          "end_ms": 108147,
          "duration_ms": 2534
        }
      ]
    },
    {
      "index": 19,
      "text": "拾うのを手伝ってちょうだい。",
      "start_ms": 108647,
      "end_ms": 111088,
      "duration_ms": 2441,
      "clauses": [
        {
          "index": 0,
          "text": "拾うのを手伝ってちょうだい。",
          "start_ms": 108647,
          "end_ms": 111088,
          "duration_ms": 2441
        }
      ]
    },
    {
      "index": 20,
      "text": "」 すると、二羽の白い鳩が台所の窓から入ってきました。",
      "start_ms": 111588,
      "end_ms": 117394,
      "duration_ms": 5806,
      "clauses": [
        {
          "index": 0,
          "text": "」 すると、",
          "start_ms": 111588,
          "end_ms": 112752,
          "duration_ms": 1164
        },
        {
          "index": 1,
          "text": "二羽の白い鳩が台所の窓から入ってきました。",
          "start_ms": 113002,
          "end_ms": 117394,
          "duration_ms": 4392
        }
      ]
    },
    {
      "index": 21,
      "text": "そのあとでキジバトが来て、最後に空の下の小鳥たちが全部集まってきて、灰の中に降りました。",
      "start_ms": 117894,
      "end_ms": 127471,
      "duration_ms": 9577,
      "clauses": [
        {
          "index": 0,
          "text": "そのあとでキジバトが来て、",
          "start_ms": 117894,
          "end_ms": 120324,
          "duration_ms": 2430
        },
        {
          "index": 1,
          "text": "最後に空の下の小鳥たちが全部集まってきて、",
          "start_ms": 120574,
          "end_ms": 125024,
          "duration_ms": 4450
        },
        {
          "index": 2,
          "text": "灰の中に降りました。",
          "start_ms": 125274,
          "end_ms": 127471,
          "duration_ms": 2197
        }
      ]
    },
    {
      "index": 22,
      "text": "鳩たちが頭をひょこひょこさせて、コッコッコッとつつき始めました。",
      "start_ms": 127971,
      "end_ms": 134485,
      "duration_ms": 6514,
      "clauses": [
        {
          "index": 0,
          "text": "鳩たちが頭をひょこひょこさせて、",
          "start_ms": 127971,
          "end_ms": 131329,
          "duration_ms": 3358
        },
        {
          "index": 1,
          "text": "コッコッコッとつつき始めました。",
          "start_ms": 131579,
          "end_ms": 134485,
          "duration_ms": 2906
        }
      ]
    },
    {
      "index": 23,
      "text": "残りの鳥たちもコッコッコッと始めて、皿に全部の良い豆を集めました。",
      "start_ms": 134985,
      "end_ms": 141952,
      "duration_ms": 6967,
      "clauses": [
        {
          "index": 0,
          "text": "残りの鳥たちもコッコッコッと始めて、",
          "start_ms": 134985,
          "end_ms": 138564,
          "duration_ms": 3579
        },
        {
          "index": 1,
          "text": "皿に全部の良い豆を集めました。",
          "start_ms": 138814,
          "end_ms": 141952,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 24,
      "text": "一時間もたたないうちに、小鳥たちは終わって、また飛び去りました。",
      "start_ms": 142452,
      "end_ms": 149868,
      "duration_ms": 7416,
      "clauses": [
        {
          "index": 0,
          "text": "一時間もたたないうちに、",
          "start_ms": 142452,
          "end_ms": 144951,
          "duration_ms": 2499
        },
        {
          "index": 1,
          "text": "小鳥たちは終わって、",
          "start_ms": 145201,
          "end_ms": 147305,
          "duration_ms": 2104
        },
        {
          "index": 2,
          "text": "また飛び去りました。",
          "start_ms": 147555,
          "end_ms": 149868,
          "duration_ms": 2313
        }
      ]
    },
    {
      "index": 25,
      "text": "娘は皿を継母のところに持って行きました。",
      "start_ms": 150368,
      "end_ms": 154504,
      "duration_ms": 4136,
      "clauses": [
        {
          "index": 0,
          "text": "娘は皿を継母のところに持って行きました。",
          "start_ms": 150368,
          "end_ms": 154504,
          "duration_ms": 4136
        }
      ]
    },
    {
      "index": 26,
      "text": "嬉しくて、今度こそお祝いに行けると信じていました。",
      "start_ms": 155004,
      "end_ms": 160392,
      "duration_ms": 5388,
      "clauses": [
        {
          "index": 0,
          "text": "嬉しくて、",
          "start_ms": 155004,
          "end_ms": 156435,
          "duration_ms": 1431
        },
        {
          "index": 1,
          "text": "今度こそお祝いに行けると信じていました。",
          "start_ms": 156685,
          "end_ms": 160392,
          "duration_ms": 3707
        }
      ]
    },
    {
      "index": 27,
      "text": "でも、継母は「だめよ、シンデレラ。",
      "start_ms": 160892,
      "end_ms": 165685,
      "duration_ms": 4793,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 160892,
          "end_ms": 161789,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "継母は「だめよ、",
          "start_ms": 162039,
          "end_ms": 163923,
          "duration_ms": 1884
        },
        {
          "index": 2,
          "text": "シンデレラ。",
          "start_ms": 164173,
          "end_ms": 165685,
          "duration_ms": 1512
        }
      ]
    },
    {
      "index": 28,
      "text": "服がないじゃないし、踊れないわ。",
      "start_ms": 166185,
      "end_ms": 169993,
      "duration_ms": 3808,
      "clauses": [
        {
          "index": 0,
          "text": "服がないじゃないし、",
          "start_ms": 166185,
          "end_ms": 168173,
          "duration_ms": 1988
        },
        {
          "index": 1,
          "text": "踊れないわ。",
          "start_ms": 168423,
          "end_ms": 169993,
          "duration_ms": 1570
        }
      ]
    },
    {
      "index": 29,
      "text": "ただ笑われるだけだよ。",
      "start_ms": 170493,
      "end_ms": 172656,
      "duration_ms": 2163,
      "clauses": [
        {
          "index": 0,
          "text": "ただ笑われるだけだよ。",
          "start_ms": 170493,
          "end_ms": 172656,
          "duration_ms": 2163
        }
      ]
    },
    {
      "index": 30,
      "text": "」と言いました。",
      "start_ms": 173156,
      "end_ms": 174680,
      "duration_ms": 1524,
      "clauses": [
        {
          "index": 0,
          "text": "」と言いました。",
          "start_ms": 173156,
          "end_ms": 174680,
          "duration_ms": 1524
        }
      ]
    },
    {
      "index": 31,
      "text": "シンデレラが泣くと、継母は「一時間で灰から二皿のレンズ豆を拾ったら、一緒に行ってあげるよ。",
      "start_ms": 175180,
      "end_ms": 184583,
      "duration_ms": 9403,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラが泣くと、",
          "start_ms": 175180,
          "end_ms": 177250,
          "duration_ms": 2070
        },
        {
          "index": 1,
          "text": "継母は「一時間で灰から二皿のレンズ豆を拾ったら、",
          "start_ms": 177500,
          "end_ms": 182263,
          "duration_ms": 4763
        },
        {
          "index": 2,
          "text": "一緒に行ってあげるよ。",
          "start_ms": 182513,
          "end_ms": 184583,
          "duration_ms": 2070
        }
      ]
    },
    {
      "index": 32,
      "text": "」と言いました。",
      "start_ms": 185083,
      "end_ms": 186630,
      "duration_ms": 1547,
      "clauses": [
        {
          "index": 0,
          "text": "」と言いました。",
          "start_ms": 185083,
          "end_ms": 186630,
          "duration_ms": 1547
        }
      ]
    },
    {
      "index": 33,
      "text": "娘はまた庭に行って、小鳥たちに手伝いを頼みました。",
      "start_ms": 187130,
      "end_ms": 192924,
      "duration_ms": 5794,
      "clauses": [
        {
          "index": 0,
          "text": "娘はまた庭に行って、",
          "start_ms": 187130,
          "end_ms": 189536,
          "duration_ms": 2406
        },
        {
          "index": 1,
          "text": "小鳥たちに手伝いを頼みました。",
          "start_ms": 189786,
          "end_ms": 192924,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 34,
      "text": "今度は三十分もたたないうちに、全部の豆を集めました。",
      "start_ms": 193424,
      "end_ms": 199589,
      "duration_ms": 6165,
      "clauses": [
        {
          "index": 0,
          "text": "今度は三十分もたたないうちに、",
          "start_ms": 193424,
          "end_ms": 196724,
          "duration_ms": 3300
        },
        {
          "index": 1,
          "text": "全部の豆を集めました。",
          "start_ms": 196974,
