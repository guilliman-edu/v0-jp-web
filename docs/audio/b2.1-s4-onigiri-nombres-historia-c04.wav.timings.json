          "end_ms": 2360,
          "duration_ms": 2360
        }
      ]
    },
    {
      "index": 1,
      "text": "こめを作る仕事は、一人では終わりません。",
      "start_ms": 2860,
      "end_ms": 7493,
      "duration_ms": 4633,
      "clauses": [
        {
          "index": 0,
          "text": "こめを作る仕事は、",
          "start_ms": 2860,
          "end_ms": 4964,
          "duration_ms": 2104
        },
        {
          "index": 1,
          "text": "一人では終わりません。",
          "start_ms": 5214,
          "end_ms": 7493,
          "duration_ms": 2279
        }
      ]
    },
    {
      "index": 2,
      "text": "みんなでみずを集め、みんなで使います。",
      "start_ms": 7993,
      "end_ms": 12185,
      "duration_ms": 4192,
      "clauses": [
        {
          "index": 0,
          "text": "みんなでみずを集め、",
          "start_ms": 7993,
          "end_ms": 10005,
          "duration_ms": 2012
        },
        {
          "index": 1,
          "text": "みんなで使います。",
          "start_ms": 10255,
          "end_ms": 12185,
          "duration_ms": 1930
        }
      ]
    },
    {
      "index": 3,
      "text": "みずをまもるのも、こめをうえるのも、みんなの仕事です。",
      "start_ms": 12685,
      "end_ms": 18802,
      "duration_ms": 6117,
      "clauses": [
        {
          "index": 0,
          "text": "みずをまもるのも、",
          "start_ms": 12685,
          "end_ms": 14522,
          "duration_ms": 1837
        },
        {
          "index": 1,
          "text": "こめをうえるのも、",
          "start_ms": 14772,
          "end_ms": 16598,
          "duration_ms": 1826
        },
        {
          "index": 2,
          "text": "みんなの仕事です。",
          "start_ms": 16848,
          "end_ms": 18802,
          "duration_ms": 1954
        }
      ]
    },
    {
      "index": 4,
      "text": "そして、作ったこめをみんなで食べるのに、とてもいいたべものが「おにぎり」です。",
      "start_ms": 19302,
      "end_ms": 26812,
      "duration_ms": 7510,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 19302,
          "end_ms": 20536,
          "duration_ms": 1234
        },
        {
          "index": 1,
          "text": "作ったこめをみんなで食べるのに、",
          "start_ms": 20786,
          "end_ms": 23738,
          "duration_ms": 2952
        },
        {
          "index": 2,
          "text": "とてもいいたべものが「おにぎり」です。",
          "start_ms": 23988,
          "end_ms": 26812,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 5,
      "text": "じしんのとき、にほんではよく「おにぎり」が出ます。",
      "start_ms": 27312,
      "end_ms": 32305,
      "duration_ms": 4993,
      "clauses": [
        {
          "index": 0,
          "text": "じしんのとき、",
          "start_ms": 27312,
          "end_ms": 28975,
          "duration_ms": 1663
        },
        {
          "index": 1,
          "text": "にほんではよく「おにぎり」が出ます。",
          "start_ms": 29225,
          "end_ms": 32305,
          "duration_ms": 3080
        }
      ]
    },
    {
      "index": 6,
      "text": "持ちやすく、作るのも楽で、食べるのに何も要りません。",
      "start_ms": 32805,
      "end_ms": 39305,
      "duration_ms": 6500,
      "clauses": [
        {
          "index": 0,
          "text": "持ちやすく、",
          "start_ms": 32805,
          "end_ms": 34399,
          "duration_ms": 1594
        },
        {
          "index": 1,
          "text": "作るのも楽で、",
          "start_ms": 34649,
          "end_ms": 36475,
          "duration_ms": 1826
        },
        {
          "index": 2,
          "text": "食べるのに何も要りません。",
          "start_ms": 36725,
          "end_ms": 39305,
          "duration_ms": 2580
        }
      ]
    },
    {
