      "index": 43,
      "text": "なまえはオートラです。",
      "start_ms": 192142,
      "end_ms": 194554,
      "duration_ms": 2412,
      "clauses": [
        {
          "index": 0,
          "text": "なまえはオートラです。",
          "start_ms": 192142,
          "end_ms": 194554,
          "duration_ms": 2412
        }
      ]
    },
    {
      "index": 44,
      "text": "オートラもしろではたらいていました。",
      "start_ms": 195054,
      "end_ms": 198174,
      "duration_ms": 3120,
      "clauses": [
        {
          "index": 0,
          "text": "オートラもしろではたらいていました。",
          "start_ms": 195054,
          "end_ms": 198174,
          "duration_ms": 3120
        }
      ]
    },
    {
      "index": 45,
      "text": "としをとっていました。",
      "start_ms": 198674,
      "end_ms": 200958,
      "duration_ms": 2284,
      "clauses": [
        {
          "index": 0,
          "text": "としをとっていました。",
          "start_ms": 198674,
          "end_ms": 200958,
          "duration_ms": 2284
        }
      ]
    },
    {
      "index": 46,
      "text": "おかねがすきでした。",
      "start_ms": 201458,
      "end_ms": 203661,
      "duration_ms": 2203,
      "clauses": [
        {
          "index": 0,
          "text": "おかねがすきでした。",
          "start_ms": 201458,
          "end_ms": 203661,
          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 47,
      "text": "わるいこともするひとでした。",
      "start_ms": 204161,
      "end_ms": 206875,
      "duration_ms": 2714,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこともするひとでした。",
          "start_ms": 204161,
          "end_ms": 206875,
          "duration_ms": 2714
        }
      ]
    },
    {
      "index": 48,
      "text": "とのさまのこともおんなのひとたちのこともよく、しっていました。",
      "start_ms": 207375,
      "end_ms": 213679,
      "duration_ms": 6304,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまのこともおんなのひとたちのこともよく、",
          "start_ms": 207375,
          "end_ms": 211586,
          "duration_ms": 4211
        },
        {
          "index": 1,
          "text": "しっていました。",
          "start_ms": 211836,
          "end_ms": 213679,
          "duration_ms": 1843
        }
      ]
    },
    {
      "index": 49,
      "text": "だからシチロウエモンはオートラにあいました。",
      "start_ms": 214179,
      "end_ms": 218294,
      "duration_ms": 4115,
      "clauses": [
        {
          "index": 0,
          "text": "だからシチロウエモンはオートラにあいました。",
          "start_ms": 214179,
          "end_ms": 218294,
          "duration_ms": 4115
        }
      ]
    },
    {
      "index": 50,
      "text": "「シチロウエモンさん。",
      "start_ms": 218794,
      "end_ms": 220912,
      "duration_ms": 2118,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモンさん。",
          "start_ms": 218794,
          "end_ms": 220912,
          "duration_ms": 2118
        }
      ]
    },
    {
      "index": 51,
      "text": "かおがあかいですね。",
      "start_ms": 221412,
      "end_ms": 223568,
      "duration_ms": 2156,
      "clauses": [
        {
          "index": 0,
          "text": "かおがあかいですね。",
          "start_ms": 221412,
          "end_ms": 223568,
          "duration_ms": 2156
        }
      ]
    },
    {
      "index": 52,
      "text": "どうしましたか」。",
      "start_ms": 224068,
      "end_ms": 225981,
      "duration_ms": 1913,
      "clauses": [
        {
          "index": 0,
          "text": "どうしましたか」。",
          "start_ms": 224068,
          "end_ms": 225981,
          "duration_ms": 1913
        }
      ]
    },
    {
      "index": 53,
      "text": "「ハチヤのことをきいていますか。",
      "start_ms": 226481,
      "end_ms": 229415,
      "duration_ms": 2934,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤのことをきいていますか。",
          "start_ms": 226481,
          "end_ms": 229415,
          "duration_ms": 2934
        }
      ]
    },
    {
      "index": 54,
      "text": "とてもおこりました」。",
      "start_ms": 229915,
      "end_ms": 232060,
      "duration_ms": 2145,
      "clauses": [
        {
          "index": 0,
          "text": "とてもおこりました」。",
          "start_ms": 229915,
          "end_ms": 232060,
          "duration_ms": 2145
        }
      ]
    },
    {
      "index": 55,
      "text": "オートラはわらいました。",
      "start_ms": 232560,
      "end_ms": 234821,
      "duration_ms": 2261,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはわらいました。",
          "start_ms": 232560,
          "end_ms": 234821,
          "duration_ms": 2261
        }
      ]
    },
    {
      "index": 56,
      "text": "「よく、しっています。",
      "start_ms": 235321,
      "end_ms": 238282,
      "duration_ms": 2961,
      "clauses": [
        {
          "index": 0,
          "text": "「よく、",
          "start_ms": 235321,
          "end_ms": 236328,
          "duration_ms": 1007
        },
        {
          "index": 1,
          "text": "しっています。",
          "start_ms": 236578,
          "end_ms": 238282,
          "duration_ms": 1704
        }
      ]
    },
    {
      "index": 57,
      "text": "でははなします。",
      "start_ms": 238782,
      "end_ms": 240764,
      "duration_ms": 1982,
      "clauses": [
        {
          "index": 0,
          "text": "でははなします。",
          "start_ms": 238782,
          "end_ms": 240764,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 58,
      "text": "でもおかねがいります」。",
      "start_ms": 241264,
      "end_ms": 243513,
      "duration_ms": 2249,
      "clauses": [
        {
          "index": 0,
          "text": "でもおかねがいります」。",
          "start_ms": 241264,
          "end_ms": 243513,
          "duration_ms": 2249
        }
      ]
    },
    {
      "index": 59,
      "text": "「ではおかねはあげます」。",
      "start_ms": 244013,
      "end_ms": 246436,
      "duration_ms": 2423,
      "clauses": [
        {
          "index": 0,
          "text": "「ではおかねはあげます」。",
          "start_ms": 244013,
          "end_ms": 246436,
          "duration_ms": 2423
        }
      ]
    },
    {
      "index": 60,
      "text": "シチロウエモンはおかねをだしました。",
      "start_ms": 246936,
      "end_ms": 250482,
      "duration_ms": 3546,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはおかねをだしました。",
          "start_ms": 246936,
          "end_ms": 250482,
          "duration_ms": 3546
        }
      ]
    },
    {
      "index": 61,
      "text": "オートラはいいました。",
      "start_ms": 250982,
      "end_ms": 253034,
      "duration_ms": 2052,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 250982,
          "end_ms": 253034,
          "duration_ms": 2052
        }
      ]
    },
    {
      "index": 62,
      "text": "「とのさまはハチヤをみぎのものにします。",
      "start_ms": 253534,
      "end_ms": 257618,
      "duration_ms": 4084,
      "clauses": [
        {
          "index": 0,
          "text": "「とのさまはハチヤをみぎのものにします。",
          "start_ms": 253534,
          "end_ms": 257618,
          "duration_ms": 4084
        }
      ]
    },
    {
      "index": 63,
      "text": "それからカツノをハチヤにあげるそうです」。",
      "start_ms": 258118,
      "end_ms": 261807,
      "duration_ms": 3689,
      "clauses": [
        {
          "index": 0,
          "text": "それからカツノをハチヤにあげるそうです」。",
          "start_ms": 258118,
          "end_ms": 261807,
          "duration_ms": 3689
        }
      ]
    },
    {
      "index": 64,
      "text": "「そうですか。",
      "start_ms": 262307,
      "end_ms": 264022,
      "duration_ms": 1715,
      "clauses": [
        {
          "index": 0,
          "text": "「そうですか。",
          "start_ms": 262307,
          "end_ms": 264022,
          "duration_ms": 1715
        }
      ]
    },
    {
      "index": 65,
      "text": "そうなんですか」。",
      "start_ms": 264522,
      "end_ms": 266458,
      "duration_ms": 1936,
      "clauses": [
        {
          "index": 0,
          "text": "そうなんですか」。",
          "start_ms": 264522,
          "end_ms": 266458,
          "duration_ms": 1936
        }
      ]
    },
    {
      "index": 66,
      "text": "「そうです。",
      "start_ms": 266958,
      "end_ms": 268488,
      "duration_ms": 1530,
      "clauses": [
        {
          "index": 0,
          "text": "「そうです。",
          "start_ms": 266958,
          "end_ms": 268488,
          "duration_ms": 1530
        }
      ]
    },
    {
      "index": 67,
      "text": "おんなのひとたちがみな、そういいます」。",
      "start_ms": 268988,
      "end_ms": 273237,
      "duration_ms": 4249,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのひとたちがみな、",
          "start_ms": 268988,
          "end_ms": 271388,
          "duration_ms": 2400
        },
        {
          "index": 1,
          "text": "そういいます」。",
          "start_ms": 271638,
          "end_ms": 273237,
          "duration_ms": 1599
        }
      ]
    },
    {
      "index": 68,
      "text": "シチロウエモンはたちました。",
      "start_ms": 273737,
      "end_ms": 276517,
      "duration_ms": 2780,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはたちました。",
          "start_ms": 273737,
          "end_ms": 276517,
          "duration_ms": 2780
        }
      ]
    },
    {
      "index": 69,
      "text": "「ハチヤはころさなければ、なりません。",
      "start_ms": 277017,
      "end_ms": 281441,
      "duration_ms": 4424,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤはころさなければ、",
          "start_ms": 277017,
          "end_ms": 279603,
          "duration_ms": 2586
        },
        {
          "index": 1,
          "text": "なりません。",
          "start_ms": 279853,
          "end_ms": 281441,
          "duration_ms": 1588
        }
      ]
    },
    {
      "index": 70,
      "text": "そうして、はじめて、いいゆめをみます」。",
      "start_ms": 281941,
      "end_ms": 287377,
      "duration_ms": 5436,
      "clauses": [
        {
          "index": 0,
          "text": "そうして、",
          "start_ms": 281941,
          "end_ms": 283412,
          "duration_ms": 1471
        },
        {
          "index": 1,
          "text": "はじめて、",
          "start_ms": 283662,
          "end_ms": 285145,
          "duration_ms": 1483
        },
        {
          "index": 2,
          "text": "いいゆめをみます」。",
          "start_ms": 285395,
          "end_ms": 287377,
          "duration_ms": 1982
        }
      ]
    },
    {
      "index": 71,
      "text": "オートラはいいました。",
      "start_ms": 287877,
      "end_ms": 289929,
      "duration_ms": 2052,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 287877,
          "end_ms": 289929,
          "duration_ms": 2052
        }
      ]
    },
    {
      "index": 72,
      "text": "「わたしがじょうずにします。",
      "start_ms": 290429,
      "end_ms": 292945,
      "duration_ms": 2516,
      "clauses": [
        {
          "index": 0,
          "text": "「わたしがじょうずにします。",
          "start_ms": 290429,
          "end_ms": 292945,
          "duration_ms": 2516
        }
      ]
    },
    {
      "index": 73,
      "text": "しんぱいしないでください」。",
      "start_ms": 293445,
      "end_ms": 295961,
      "duration_ms": 2516,
      "clauses": [
        {
          "index": 0,
          "text": "しんぱいしないでください」。",
          "start_ms": 293445,
          "end_ms": 295961,
          "duration_ms": 2516
        }
      ]
    },
    {
      "index": 74,
      "text": "「ではそうします。",
      "start_ms": 296461,
      "end_ms": 298420,
      "duration_ms": 1959,
      "clauses": [
        {
          "index": 0,
          "text": "「ではそうします。",
          "start_ms": 296461,
          "end_ms": 298420,
          "duration_ms": 1959
        }
      ]
    },
    {
      "index": 75,
      "text": "じょうずにしてください」。",
      "start_ms": 298920,
      "end_ms": 301204,
      "duration_ms": 2284,
      "clauses": [
        {
          "index": 0,
          "text": "じょうずにしてください」。",
          "start_ms": 298920,
          "end_ms": 301204,
          "duration_ms": 2284
        }
      ]
    },
    {
      "index": 76,
      "text": "へやはもう、なにもありませんでした。",
      "start_ms": 301704,
      "end_ms": 306023,
      "duration_ms": 4319,
      "clauses": [
        {
          "index": 0,
          "text": "へやはもう、",
          "start_ms": 301704,
          "end_ms": 303280,
          "duration_ms": 1576
        },
        {
          "index": 1,
          "text": "なにもありませんでした。",
          "start_ms": 303530,
          "end_ms": 306023,
          "duration_ms": 2493
        }
      ]
    },
    {
      "index": 77,
      "text": "ふたりはなにもいいませんでした。",
      "start_ms": 306523,
      "end_ms": 309620,
      "duration_ms": 3097,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなにもいいませんでした。",
          "start_ms": 306523,
          "end_ms": 309620,
          "duration_ms": 3097
        }
      ]
    }
  ]
}