      "start_ms": 191370,
      "end_ms": 193782,
      "duration_ms": 2412,
      "clauses": [
        {
          "index": 0,
          "text": "なまえはオートラです。",
          "start_ms": 191370,
          "end_ms": 193782,
          "duration_ms": 2412
        }
      ]
    },
    {
      "index": 44,
      "text": "オートラもしろではたらいていました。",
      "start_ms": 194282,
      "end_ms": 197414,
      "duration_ms": 3132,
      "clauses": [
        {
          "index": 0,
          "text": "オートラもしろではたらいていました。",
          "start_ms": 194282,
          "end_ms": 197414,
          "duration_ms": 3132
        }
      ]
    },
    {
      "index": 45,
      "text": "としをとっていました。",
      "start_ms": 197914,
      "end_ms": 200233,
      "duration_ms": 2319,
      "clauses": [
        {
          "index": 0,
          "text": "としをとっていました。",
          "start_ms": 197914,
          "end_ms": 200233,
          "duration_ms": 2319
        }
      ]
    },
    {
      "index": 46,
      "text": "おかねがすきでした。",
      "start_ms": 200733,
      "end_ms": 202936,
      "duration_ms": 2203,
      "clauses": [
        {
          "index": 0,
          "text": "おかねがすきでした。",
          "start_ms": 200733,
          "end_ms": 202936,
          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 47,
      "text": "わるいこともするひとでした。",
      "start_ms": 203436,
      "end_ms": 206196,
      "duration_ms": 2760,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこともするひとでした。",
          "start_ms": 203436,
          "end_ms": 206196,
          "duration_ms": 2760
        }
      ]
    },
    {
      "index": 48,
      "text": "とのさまのこともおんなのひとたちのこともよく、しっていました。",
      "start_ms": 206696,
      "end_ms": 212989,
      "duration_ms": 6293,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまのこともおんなのひとたちのこともよく、",
          "start_ms": 206696,
          "end_ms": 210861,
          "duration_ms": 4165
        },
        {
          "index": 1,
          "text": "しっていました。",
          "start_ms": 211111,
          "end_ms": 212989,
          "duration_ms": 1878
        }
      ]
    },
    {
      "index": 49,
      "text": "だからシチロウエモンはオートラにあいました。",
      "start_ms": 213489,
      "end_ms": 217491,
      "duration_ms": 4002,
      "clauses": [
        {
          "index": 0,
          "text": "だからシチロウエモンはオートラにあいました。",
          "start_ms": 213489,
          "end_ms": 217491,
          "duration_ms": 4002
        }
      ]
    },
    {
      "index": 50,
      "text": "「シチロウエモンさん。",
      "start_ms": 217991,
      "end_ms": 220078,
      "duration_ms": 2087,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモンさん。",
          "start_ms": 217991,
          "end_ms": 220078,
          "duration_ms": 2087
        }
      ]
    },
    {
      "index": 51,
      "text": "かおがあかいですね。",
      "start_ms": 220578,
      "end_ms": 222734,
      "duration_ms": 2156,
      "clauses": [
        {
          "index": 0,
          "text": "かおがあかいですね。",
          "start_ms": 220578,
          "end_ms": 222734,
          "duration_ms": 2156
        }
      ]
    },
    {
      "index": 52,
      "text": "どうしましたか」。",
      "start_ms": 223234,
      "end_ms": 225181,
      "duration_ms": 1947,
      "clauses": [
        {
          "index": 0,
          "text": "どうしましたか」。",
          "start_ms": 223234,
          "end_ms": 225181,
          "duration_ms": 1947
        }
      ]
    },
    {
      "index": 53,
      "text": "「ハチヤのことをきいていますか。",
      "start_ms": 225681,
      "end_ms": 228534,
      "duration_ms": 2853,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤのことをきいていますか。",
          "start_ms": 225681,
          "end_ms": 228534,
          "duration_ms": 2853
        }
      ]
    },
    {
      "index": 54,
      "text": "とてもおこりました」。",
      "start_ms": 229034,
      "end_ms": 231156,
      "duration_ms": 2122,
      "clauses": [
        {
          "index": 0,
          "text": "とてもおこりました」。",
          "start_ms": 229034,
          "end_ms": 231156,
          "duration_ms": 2122
        }
      ]
    },
    {
      "index": 55,
      "text": "オートラはわらいました。",
      "start_ms": 231656,
      "end_ms": 233929,
      "duration_ms": 2273,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはわらいました。",
          "start_ms": 231656,
          "end_ms": 233929,
          "duration_ms": 2273
        }
      ]
    },
    {
      "index": 56,
      "text": "「よく、しっています。",
      "start_ms": 234429,
      "end_ms": 237436,
      "duration_ms": 3007,
      "clauses": [
        {
          "index": 0,
          "text": "「よく、",
          "start_ms": 234429,
          "end_ms": 235436,
          "duration_ms": 1007
        },
        {
          "index": 1,
          "text": "しっています。",
          "start_ms": 235686,
          "end_ms": 237436,
          "duration_ms": 1750
        }
      ]
    },
    {
      "index": 57,
      "text": "でははなします。",
      "start_ms": 237936,
      "end_ms": 239895,
      "duration_ms": 1959,
      "clauses": [
        {
          "index": 0,
          "text": "でははなします。",
          "start_ms": 237936,
          "end_ms": 239895,
          "duration_ms": 1959
        }
      ]
    },
    {
      "index": 58,
      "text": "でもおかねがいります」。",
      "start_ms": 240395,
      "end_ms": 242737,
      "duration_ms": 2342,
      "clauses": [
        {
          "index": 0,
          "text": "でもおかねがいります」。",
          "start_ms": 240395,
          "end_ms": 242737,
          "duration_ms": 2342
        }
      ]
    },
    {
      "index": 59,
      "text": "「ではおかねはあげます」。",
      "start_ms": 243237,
      "end_ms": 245626,
      "duration_ms": 2389,
      "clauses": [
        {
          "index": 0,
          "text": "「ではおかねはあげます」。",
          "start_ms": 243237,
          "end_ms": 245626,
          "duration_ms": 2389
        }
      ]
    },
    {
      "index": 60,
      "text": "シチロウエモンはおかねをだしました。",
      "start_ms": 246126,
      "end_ms": 249571,
      "duration_ms": 3445,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはおかねをだしました。",
          "start_ms": 246126,
          "end_ms": 249571,
          "duration_ms": 3445
        }
      ]
    },
    {
      "index": 61,
      "text": "オートラはいいました。",
      "start_ms": 250071,
      "end_ms": 252193,
      "duration_ms": 2122,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 250071,
          "end_ms": 252193,
          "duration_ms": 2122
        }
      ]
    },
    {
      "index": 62,
      "text": "「とのさまはハチヤをみぎのものにします。",
      "start_ms": 252693,
      "end_ms": 256719,
      "duration_ms": 4026,
      "clauses": [
        {
          "index": 0,
          "text": "「とのさまはハチヤをみぎのものにします。",
          "start_ms": 252693,
          "end_ms": 256719,
          "duration_ms": 4026
        }
      ]
    },
    {
      "index": 63,
      "text": "それからカツノをハチヤにあげるそうです」。",
      "start_ms": 257219,
      "end_ms": 260873,
      "duration_ms": 3654,
      "clauses": [
        {
          "index": 0,
          "text": "それからカツノをハチヤにあげるそうです」。",
          "start_ms": 257219,
          "end_ms": 260873,
          "duration_ms": 3654
        }
      ]
    },
    {
      "index": 64,
      "text": "「そうですか。",
      "start_ms": 261373,
      "end_ms": 263088,
      "duration_ms": 1715,
      "clauses": [
        {
          "index": 0,
          "text": "「そうですか。",
          "start_ms": 261373,
          "end_ms": 263088,
          "duration_ms": 1715
        }
      ]
    },
    {
      "index": 65,
      "text": "そうなんですか」。",
      "start_ms": 263588,
      "end_ms": 265501,
      "duration_ms": 1913,
      "clauses": [
        {
          "index": 0,
          "text": "そうなんですか」。",
          "start_ms": 263588,
          "end_ms": 265501,
          "duration_ms": 1913
        }
      ]
    },
    {
      "index": 66,
      "text": "「そうです。",
      "start_ms": 266001,
      "end_ms": 267542,
      "duration_ms": 1541,
      "clauses": [
        {
          "index": 0,
          "text": "「そうです。",
          "start_ms": 266001,
          "end_ms": 267542,
          "duration_ms": 1541
        }
      ]
    },
    {
      "index": 67,
      "text": "おんなのひとたちがみな、そういいます」。",
      "start_ms": 268042,
      "end_ms": 272361,
      "duration_ms": 4319,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのひとたちがみな、",
          "start_ms": 268042,
          "end_ms": 270500,
          "duration_ms": 2458
        },
        {
          "index": 1,
          "text": "そういいます」。",
          "start_ms": 270750,
          "end_ms": 272361,
          "duration_ms": 1611
        }
      ]
    },
    {
      "index": 68,
      "text": "シチロウエモンはたちました。",
      "start_ms": 272861,
      "end_ms": 275598,
      "duration_ms": 2737,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはたちました。",
          "start_ms": 272861,
          "end_ms": 275598,
          "duration_ms": 2737
        }
      ]
    },
    {
      "index": 69,
      "text": "「ハチヤはころさなければ、なりません。",
      "start_ms": 276098,
      "end_ms": 280510,
      "duration_ms": 4412,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤはころさなければ、",
          "start_ms": 276098,
          "end_ms": 278661,
          "duration_ms": 2563
        },
        {
          "index": 1,
          "text": "なりません。",
          "start_ms": 278911,
          "end_ms": 280510,
          "duration_ms": 1599
        }
      ]
    },
    {
      "index": 70,
      "text": "そうして、はじめて、いいゆめをみます」。",
      "start_ms": 281010,
      "end_ms": 286411,
      "duration_ms": 5401,
      "clauses": [
        {
          "index": 0,
          "text": "そうして、",
          "start_ms": 281010,
          "end_ms": 282516,
          "duration_ms": 1506
        },
        {
          "index": 1,
          "text": "はじめて、",
          "start_ms": 282766,
          "end_ms": 284237,
          "duration_ms": 1471
        },
        {
          "index": 2,
          "text": "いいゆめをみます」。",
          "start_ms": 284487,
          "end_ms": 286411,
          "duration_ms": 1924
        }
      ]
    },
    {
      "index": 71,
      "text": "オートラはいいました。",
      "start_ms": 286911,
      "end_ms": 289091,
      "duration_ms": 2180,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 286911,
          "end_ms": 289091,
          "duration_ms": 2180
        }
      ]
    },
    {
      "index": 72,
      "text": "「わたしがじょうずにします。",
      "start_ms": 289591,
      "end_ms": 292084,
      "duration_ms": 2493,
      "clauses": [
        {
          "index": 0,
          "text": "「わたしがじょうずにします。",
          "start_ms": 289591,
          "end_ms": 292084,
          "duration_ms": 2493
        }
      ]
    },
    {
      "index": 73,
      "text": "しんぱいしないでください」。",
      "start_ms": 292584,
      "end_ms": 295077,
      "duration_ms": 2493,
      "clauses": [
        {
          "index": 0,
          "text": "しんぱいしないでください」。",
          "start_ms": 292584,
          "end_ms": 295077,
          "duration_ms": 2493
        }
      ]
    },
    {
      "index": 74,
      "text": "「ではそうします。",
      "start_ms": 295577,
      "end_ms": 297583,
      "duration_ms": 2006,
      "clauses": [
        {
          "index": 0,
          "text": "「ではそうします。",
          "start_ms": 295577,
          "end_ms": 297583,
          "duration_ms": 2006
        }
      ]
    },
    {
      "index": 75,
      "text": "じょうずにしてください」。",
      "start_ms": 298083,
      "end_ms": 300251,
      "duration_ms": 2168,
      "clauses": [
        {
          "index": 0,
          "text": "じょうずにしてください」。",
          "start_ms": 298083,
          "end_ms": 300251,
          "duration_ms": 2168
        }
      ]
    },
    {
      "index": 76,
      "text": "へやはもう、なにもありませんでした。",
      "start_ms": 300751,
      "end_ms": 305059,
      "duration_ms": 4308,
      "clauses": [
        {
          "index": 0,
          "text": "へやはもう、",
          "start_ms": 300751,
          "end_ms": 302327,
          "duration_ms": 1576
        },
        {
          "index": 1,
          "text": "なにもありませんでした。",
          "start_ms": 302577,
          "end_ms": 305059,
          "duration_ms": 2482
        }
      ]
    },
    {
      "index": 77,
      "text": "ふたりはなにもいいませんでした。",
      "start_ms": 305559,
      "end_ms": 308679,
      "duration_ms": 3120,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなにもいいませんでした。",
          "start_ms": 305559,
          "end_ms": 308679,
          "duration_ms": 3120
        }
      ]
    }
  ]
}