      "index": 47,
      "text": "わたしは、おとうさんのともだちです。」",
      "start_ms": 170714,
      "end_ms": 175126,
      "duration_ms": 4412,
      "clauses": [
        {
          "index": 0,
          "text": "わたしは、",
          "start_ms": 170714,
          "end_ms": 172267,
          "duration_ms": 1553
        },
        {
          "index": 1,
          "text": "おとうさんのともだちです。」",
          "start_ms": 172517,
          "end_ms": 175126,
          "duration_ms": 2609
        }
      ]
    },
    {
      "index": 48,
      "text": "チョウシロウはいいました。",
      "start_ms": 175626,
      "end_ms": 177980,
      "duration_ms": 2354,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはいいました。",
          "start_ms": 175626,
          "end_ms": 177980,
          "duration_ms": 2354
        }
      ]
    },
    {
      "index": 49,
      "text": "「いりません。",
      "start_ms": 178480,
      "end_ms": 180195,
      "duration_ms": 1715,
      "clauses": [
        {
          "index": 0,
          "text": "「いりません。",
          "start_ms": 178480,
          "end_ms": 180195,
          "duration_ms": 1715
        }
      ]
    },
    {
      "index": 50,
      "text": "おとうさんに、もうなにもいいたいことはありません。",
      "start_ms": 180695,
      "end_ms": 185699,
      "duration_ms": 5004,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんに、",
          "start_ms": 180695,
          "end_ms": 182399,
          "duration_ms": 1704
        },
        {
          "index": 1,
          "text": "もうなにもいいたいことはありません。",
          "start_ms": 182649,
          "end_ms": 185699,
          "duration_ms": 3050
        }
      ]
    },
    {
      "index": 51,
      "text": "さむらいはたいせつなともだちをおもって、どんなことになってもいいです。",
      "start_ms": 186199,
      "end_ms": 193037,
      "duration_ms": 6838,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいはたいせつなともだちをおもって、",
          "start_ms": 186199,
          "end_ms": 190062,
          "duration_ms": 3863
        },
        {
          "index": 1,
          "text": "どんなことになってもいいです。",
          "start_ms": 190312,
          "end_ms": 193037,
          "duration_ms": 2725
        }
      ]
    },
    {
      "index": 52,
      "text": "しょうぐんがわたしになにをしたいのか、よくわかります。",
      "start_ms": 193537,
      "end_ms": 199040,
      "duration_ms": 5503,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんがわたしになにをしたいのか、",
          "start_ms": 193537,
          "end_ms": 196831,
          "duration_ms": 3294
        },
        {
          "index": 1,
          "text": "よくわかります。",
          "start_ms": 197081,
          "end_ms": 199040,
          "duration_ms": 1959
        }
      ]
    },
    {
      "index": 53,
      "text": "わたしがこのいえをでるとき、みんながしります。",
      "start_ms": 199540,
      "end_ms": 204753,
      "duration_ms": 5213,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがこのいえをでるとき、",
          "start_ms": 199540,
          "end_ms": 202532,
          "duration_ms": 2992
        },
        {
          "index": 1,
          "text": "みんながしります。",
          "start_ms": 202782,
          "end_ms": 204753,
          "duration_ms": 1971
        }
      ]
    },
    {
      "index": 54,
      "text": "わたしがうそをつかなかったこと、そしてたけちよをおもってうそをついたことも、みんながしります。",
      "start_ms": 205253,
      "end_ms": 215125,
      "duration_ms": 9872,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがうそをつかなかったこと、",
          "start_ms": 205253,
          "end_ms": 208303,
          "duration_ms": 3050
        },
        {
          "index": 1,
          "text": "そしてたけちよをおもってうそをついたことも、",
          "start_ms": 208553,
          "end_ms": 212881,
          "duration_ms": 4328
        },
        {
          "index": 2,
          "text": "みんながしります。",
          "start_ms": 213131,
          "end_ms": 215125,
          "duration_ms": 1994
        }
      ]
    },
    {
      "index": 55,
      "text": "おとうさんにつたえることは、ひとつです。",
      "start_ms": 215625,
      "end_ms": 220037,
      "duration_ms": 4412,
      "clauses": [
        {
          "index": 0,
          "text": "おとうさんにつたえることは、",
          "start_ms": 215625,
          "end_ms": 218107,
          "duration_ms": 2482
        },
        {
          "index": 1,
          "text": "ひとつです。",
          "start_ms": 218357,
          "end_ms": 220037,
          "duration_ms": 1680
        }
      ]
    },
    {
      "index": 56,
      "text": "『わたしはたいせつなともだちをおもって、このいえをでました。』",
      "start_ms": 220537,
      "end_ms": 226620,
      "duration_ms": 6083,
      "clauses": [
        {
          "index": 0,
          "text": "『わたしはたいせつなともだちをおもって、",
          "start_ms": 220537,
          "end_ms": 224214,
          "duration_ms": 3677
        },
        {
          "index": 1,
          "text": "このいえをでました。』",
          "start_ms": 224464,
          "end_ms": 226620,
          "duration_ms": 2156
        }
      ]
    },
    {
      "index": 57,
      "text": "わたしがかなしいのは、おやのびょうきです。",
      "start_ms": 227120,
      "end_ms": 231892,
      "duration_ms": 4772,
      "clauses": [
        {
          "index": 0,
          "text": "わたしがかなしいのは、",
          "start_ms": 227120,
          "end_ms": 229520,
          "duration_ms": 2400
        },
        {
          "index": 1,
          "text": "おやのびょうきです。",
          "start_ms": 229770,
          "end_ms": 231892,
          "duration_ms": 2122
        }
      ]
    },
    {
      "index": 58,
      "text": "これをきいて、おやのびょうきがひどくなります。」",
      "start_ms": 232392,
      "end_ms": 237268,
      "duration_ms": 4876,
      "clauses": [
        {
          "index": 0,
          "text": "これをきいて、",
          "start_ms": 232392,
          "end_ms": 234107,
          "duration_ms": 1715
        },
        {
          "index": 1,
          "text": "おやのびょうきがひどくなります。」",
          "start_ms": 234357,
          "end_ms": 237268,
          "duration_ms": 2911
        }
      ]
    },
    {
      "index": 59,
      "text": "ぶかはすごくかなしくなりました。",
      "start_ms": 237768,
      "end_ms": 240911,
      "duration_ms": 3143,
      "clauses": [
        {
          "index": 0,
          "text": "ぶかはすごくかなしくなりました。",
          "start_ms": 237768,
          "end_ms": 240911,
          "duration_ms": 3143
        }
      ]
    },
    {
      "index": 60,
      "text": "そして、チョウシロウをしょうぐんのまえへつれていきました。",
      "start_ms": 241411,
      "end_ms": 246763,
      "duration_ms": 5352,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 241411,
          "end_ms": 242673,
          "duration_ms": 1262
        },
        {
          "index": 1,
          "text": "チョウシロウをしょうぐんのまえへつれていきました。",
          "start_ms": 242923,
          "end_ms": 246763,
          "duration_ms": 3840
        }
      ]
    },
    {
      "index": 61,
      "text": "チョウシロウはすわりました。",
      "start_ms": 247263,
      "end_ms": 250000,
      "duration_ms": 2737,
      "clauses": [
        {
          "index": 0,
          "text": "チョウシロウはすわりました。",
          "start_ms": 247263,
          "end_ms": 250000,
          "duration_ms": 2737
        }
      ]
    },
    {
      "index": 62,
      "text": "かみをなしました。",
      "start_ms": 250500,
      "end_ms": 252587,
      "duration_ms": 2087,
      "clauses": [
        {
          "index": 0,
          "text": "かみをなしました。",
          "start_ms": 250500,
          "end_ms": 252587,
          "duration_ms": 2087
        }
      ]
    },
    {
      "index": 63,
      "text": "こわくないかおをして、しょうぐんをまちました。",
      "start_ms": 253087,
      "end_ms": 257812,
      "duration_ms": 4725,
      "clauses": [
        {
          "index": 0,
          "text": "こわくないかおをして、",
          "start_ms": 253087,
          "end_ms": 255313,
          "duration_ms": 2226
        },
        {
          "index": 1,
          "text": "しょうぐんをまちました。",
          "start_ms": 255563,
          "end_ms": 257812,
          "duration_ms": 2249
        }
      ]
    },
    {
      "index": 64,
      "text": "しょうぐんはそのかおをみて、かたなをおきました。",
      "start_ms": 258312,
      "end_ms": 263514,
      "duration_ms": 5202,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはそのかおをみて、",
          "start_ms": 258312,
          "end_ms": 261119,
          "duration_ms": 2807
        },
        {
          "index": 1,
          "text": "かたなをおきました。",
          "start_ms": 261369,
          "end_ms": 263514,
          "duration_ms": 2145
        }
      ]
    },
    {
      "index": 65,
      "text": "しょうぐんはいいました。",
      "start_ms": 264014,
      "end_ms": 266263,
      "duration_ms": 2249,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんはいいました。",
          "start_ms": 264014,
          "end_ms": 266263,
          "duration_ms": 2249
        }
      ]
    },
    {
      "index": 66,
      "text": "「チョウシロウ、もういいです。",
      "start_ms": 266763,
      "end_ms": 270200,
      "duration_ms": 3437,
      "clauses": [
        {
          "index": 0,
          "text": "「チョウシロウ、",
          "start_ms": 266763,
          "end_ms": 268258,
          "duration_ms": 1495
        },
        {
          "index": 1,
          "text": "もういいです。",
          "start_ms": 268508,
          "end_ms": 270200,
          "duration_ms": 1692
        }
      ]
    },
    {
      "index": 67,
      "text": "あなたはすごくいいこです。",
      "start_ms": 270700,
      "end_ms": 273356,
      "duration_ms": 2656,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはすごくいいこです。",
          "start_ms": 270700,
          "end_ms": 273356,
          "duration_ms": 2656
        }
      ]
    },
    {
      "index": 68,
      "text": "わたしはあなたのことを、よくしりました。",
      "start_ms": 273856,
      "end_ms": 278721,
      "duration_ms": 4865,
      "clauses": [
        {
          "index": 0,
          "text": "わたしはあなたのことを、",
          "start_ms": 273856,
          "end_ms": 276512,
          "duration_ms": 2656
        },
        {
          "index": 1,
          "text": "よくしりました。",
          "start_ms": 276762,
          "end_ms": 278721,
          "duration_ms": 1959
        }
      ]
    },
    {
      "index": 69,
      "text": "たけちよがしょうぐんになるとき、あなたは、いつもたけちよのそばにいてください。",
      "start_ms": 279221,
      "end_ms": 287445,
      "duration_ms": 8224,
      "clauses": [
        {
          "index": 0,
          "text": "たけちよがしょうぐんになるとき、",
          "start_ms": 279221,
          "end_ms": 282121,
          "duration_ms": 2900
        },
        {
          "index": 1,
          "text": "あなたは、",
          "start_ms": 282371,
          "end_ms": 283866,
          "duration_ms": 1495
        },
        {
          "index": 2,
          "text": "いつもたけちよのそばにいてください。",
          "start_ms": 284116,
          "end_ms": 287445,
          "duration_ms": 3329
        }
      ]
    },
    {
      "index": 70,
      "text": "あなたはたいせつなともだちです。",
      "start_ms": 287945,
      "end_ms": 291181,
      "duration_ms": 3236,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはたいせつなともだちです。",
          "start_ms": 287945,
          "end_ms": 291181,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 71,
      "text": "あなたはもうじゆうです。」",
      "start_ms": 291681,
      "end_ms": 294174,
      "duration_ms": 2493,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうじゆうです。」",
          "start_ms": 291681,
          "end_ms": 294174,
          "duration_ms": 2493
        }
      ]
    },
    {
      "index": 72,
      "text": "そのときから、ふたりはなかがいいともだちになりました。",
      "start_ms": 294674,
      "end_ms": 300224,
      "duration_ms": 5550,
      "clauses": [
        {
          "index": 0,
          "text": "そのときから、",
          "start_ms": 294674,
          "end_ms": 296471,
          "duration_ms": 1797
        },
        {
          "index": 1,
          "text": "ふたりはなかがいいともだちになりました。",
          "start_ms": 296721,
          "end_ms": 300224,
          "duration_ms": 3503
        }
      ]
    },
    {
      "index": 73,
      "text": "しょうぐんも、チョウシロウをたいせつにしました。",
      "start_ms": 300724,
      "end_ms": 305519,
      "duration_ms": 4795,
      "clauses": [
        {
          "index": 0,
          "text": "しょうぐんも、",
          "start_ms": 300724,
          "end_ms": 302323,
          "duration_ms": 1599
        },
        {
          "index": 1,
          "text": "チョウシロウをたいせつにしました。",
          "start_ms": 302573,
          "end_ms": 305519,
          "duration_ms": 2946
        }
      ]
    },
    {
      "index": 74,
      "text": "ながいじかんのあとで、チョウシロウはおおきくなって、ゆうめいなひとになりました。",
      "start_ms": 306019,
      "end_ms": 314138,
      "duration_ms": 8119,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんのあとで、",
          "start_ms": 306019,
          "end_ms": 308303,
          "duration_ms": 2284
        },
        {
          "index": 1,
          "text": "チョウシロウはおおきくなって、",
          "start_ms": 308553,
          "end_ms": 311325,
          "duration_ms": 2772
        },
        {
          "index": 2,
          "text": "ゆうめいなひとになりました。",
          "start_ms": 311575,
          "end_ms": 314138,
          "duration_ms": 2563
        }
      ]
    },
    {
      "index": 75,
      "text": "みんなが、チョウシロウをおぼえています。",
      "start_ms": 314638,
      "end_ms": 318910,
      "duration_ms": 4272,
      "clauses": [
        {
          "index": 0,
          "text": "みんなが、",
          "start_ms": 314638,
          "end_ms": 316028,
          "duration_ms": 1390
        },
        {
          "index": 1,
          "text": "チョウシロウをおぼえています。",
          "start_ms": 316278,
          "end_ms": 318910,
          "duration_ms": 2632
        }
      ]
    }
  ]
