    },
    {
      "index": 1,
      "text": "おにぎりは、いつからあったのか、はっきりしていません。",
      "start_ms": 2953,
      "end_ms": 8943,
      "duration_ms": 5990,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 2953,
          "end_ms": 4431,
          "duration_ms": 1478
        },
        {
          "index": 1,
          "text": "いつからあったのか、",
