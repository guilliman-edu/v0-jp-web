  "sentences": [
    {
      "index": 0,
      "text": "「おにぎり」のなまえとれきし ― にほんのおにぎりから世界へ",
      "start_ms": 0,
      "end_ms": 4113,
      "duration_ms": 4113,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」のなまえとれきし ― にほんのおにぎりから世界へ",
          "start_ms": 0,
          "end_ms": 4113,
          "duration_ms": 4113
        }
      ]
    },
    {
      "index": 1,
      "text": "にほんでは2025年、きおんが高くてこめが買えなくなり、お金も高くなりました。",
      "start_ms": 4613,
      "end_ms": 13447,
      "duration_ms": 8834,
      "clauses": [
        {
          "index": 0,
          "text": "にほんでは2025年、",
          "start_ms": 4613,
          "end_ms": 7461,
          "duration_ms": 2848
        },
        {
          "index": 1,
          "text": "きおんが高くてこめが買えなくなり、",
          "start_ms": 7711,
          "end_ms": 10814,
          "duration_ms": 3103
        },
        {
          "index": 2,
          "text": "お金も高くなりました。",
          "start_ms": 11064,
          "end_ms": 13447,
          "duration_ms": 2383
        }
      ]
    },
    {
      "index": 2,
      "text": "いつも買えると思ってきたのに買えなくなると、にほんでは長いあいだ、こめがせいかつの中でとても大切なものだと、みんなが気がつきました。",
      "start_ms": 13947,
      "end_ms": 27121,
      "duration_ms": 13174,
      "clauses": [
        {
          "index": 0,
          "text": "いつも買えると思ってきたのに買えなくなると、",
          "start_ms": 13947,
          "end_ms": 17700,
          "duration_ms": 3753
        },
        {
          "index": 1,
          "text": "にほんでは長いあいだ、",
          "start_ms": 17950,
          "end_ms": 20171,
          "duration_ms": 2221
        },
        {
          "index": 2,
          "text": "こめがせいかつの中でとても大切なものだと、",
          "start_ms": 20421,
          "end_ms": 24650,
          "duration_ms": 4229
        },
        {
          "index": 3,
          "text": "みんなが気がつきました。",
          "start_ms": 24900,
          "end_ms": 27121,
          "duration_ms": 2221
        }
      ]
    },
    {
      "index": 3,
      "text": "そこで、みんなが知っている毎日のたべもの「おにぎり」にちゅうもくする人が出ました。",
      "start_ms": 27621,
      "end_ms": 34204,
      "duration_ms": 6583,
      "clauses": [
        {
          "index": 0,
          "text": "そこで、",
          "start_ms": 27621,
          "end_ms": 28715,
          "duration_ms": 1094
        },
        {
          "index": 1,
          "text": "みんなが知っている毎日のたべもの「おにぎり」にちゅうもくする人が出ました。",
          "start_ms": 28965,
          "end_ms": 34204,
          "duration_ms": 5239
        }
      ]
    },
    {
      "index": 4,
      "text": "そのれきしを見てみましょう。",
      "start_ms": 34704,
      "end_ms": 37192,
      "duration_ms": 2488,
      "clauses": [
        {
          "index": 0,
          "text": "そのれきしを見てみましょう。",
          "start_ms": 34704,
          "end_ms": 37192,
          "duration_ms": 2488
        }
      ]
    },
    {
      "index": 5,
      "text": "おにぎりは、いつからあったのか、はっきりしていません。",
      "start_ms": 37692,
      "end_ms": 43646,
      "duration_ms": 5954,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 37692,
          "end_ms": 39193,
          "duration_ms": 1501
        },
        {
          "index": 1,
          "text": "いつからあったのか、",
          "start_ms": 39443,
          "end_ms": 41408,
          "duration_ms": 1965
        },
        {
          "index": 2,
          "text": "はっきりしていません。",
          "start_ms": 41658,
          "end_ms": 43646,
          "duration_ms": 1988
        }
      ]
    },
    {
      "index": 6,
      "text": "にほんでこめを作るようになってから、人は作ったこめを手でまとめていたと考えられています。",
      "start_ms": 44146,
      "end_ms": 52332,
      "duration_ms": 8186,
      "clauses": [
        {
          "index": 0,
          "text": "にほんでこめを作るようになってから、",
          "start_ms": 44146,
          "end_ms": 47191,
          "duration_ms": 3045
        },
        {
          "index": 1,
          "text": "人は作ったこめを手でまとめていたと考えられています。",
          "start_ms": 47441,
          "end_ms": 52332,
          "duration_ms": 4891
        }
      ]
    },
    {
      "index": 7,
      "text": "にほんのあるばしょでは、2000年前のこめが出たこともあります。",
      "start_ms": 52832,
      "end_ms": 58568,
      "duration_ms": 5736,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのあるばしょでは、",
          "start_ms": 52832,
          "end_ms": 54971,
          "duration_ms": 2139
        },
        {
          "index": 1,
          "text": "2000年前のこめが出たこともあります。",
          "start_ms": 55221,
          "end_ms": 58568,
          "duration_ms": 3347
        }
      ]
    },
    {
      "index": 8,
      "text": "手で作ったのではなく、ほかのしゅだんで作られたと考えられているものもあります。",
      "start_ms": 59068,
      "end_ms": 66139,
      "duration_ms": 7071,
      "clauses": [
        {
          "index": 0,
          "text": "手で作ったのではなく、",
          "start_ms": 59068,
          "end_ms": 61300,
          "duration_ms": 2232
        },
        {
          "index": 1,
          "text": "ほかのしゅだんで作られたと考えられているものもあります。",
          "start_ms": 61550,
          "end_ms": 66139,
          "duration_ms": 4589
        }
      ]
    },
    {
      "index": 9,
      "text": "そして、それを「むかしのおにぎりのしょうこ」と言っています。",
      "start_ms": 66639,
      "end_ms": 71958,
      "duration_ms": 5319,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 66639,
          "end_ms": 67908,
          "duration_ms": 1269
        },
        {
          "index": 1,
          "text": "それを「むかしのおにぎりのしょうこ」と言っています。",
          "start_ms": 68158,
          "end_ms": 71958,
          "duration_ms": 3800
        }
      ]
    },
    {
      "index": 10,
      "text": "このこめについては、人によって違う説明をしています。",
      "start_ms": 72458,
      "end_ms": 78043,
      "duration_ms": 5585,
      "clauses": [
        {
          "index": 0,
          "text": "このこめについては、",
          "start_ms": 72458,
          "end_ms": 74528,
          "duration_ms": 2070
        },
        {
          "index": 1,
          "text": "人によって違う説明をしています。",
          "start_ms": 74778,
          "end_ms": 78043,
          "duration_ms": 3265
        }
      ]
    },
    {
      "index": 11,
      "text": "大切なのは、こめを手でまとめて持ちやすくすることを、にほんではとてもむかしからやっていることです。",
      "start_ms": 78543,
      "end_ms": 87922,
      "duration_ms": 9379,
      "clauses": [
        {
          "index": 0,
          "text": "大切なのは、",
          "start_ms": 78543,
          "end_ms": 80276,
          "duration_ms": 1733
        },
        {
          "index": 1,
          "text": "こめを手でまとめて持ちやすくすることを、",
          "start_ms": 80526,
          "end_ms": 83826,
          "duration_ms": 3300
        },
        {
          "index": 2,
          "text": "にほんではとてもむかしからやっていることです。",
          "start_ms": 84076,
          "end_ms": 87922,
          "duration_ms": 3846
        }
      ]
    },
    {
      "index": 12,
      "text": "むかしの本には、にほんごで「にぎりいい」と書かれたことばが出ています。",
      "start_ms": 88422,
      "end_ms": 94274,
      "duration_ms": 5852,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 88422,
          "end_ms": 90317,
          "duration_ms": 1895
        },
        {
          "index": 1,
          "text": "にほんごで「にぎりいい」と書かれたことばが出ています。",
          "start_ms": 90567,
          "end_ms": 94274,
          "duration_ms": 3707
        }
      ]
    },
    {
      "index": 13,
      "text": "人はたべものを持って会い、こめをみんなで食べていました。",
      "start_ms": 94774,
      "end_ms": 100522,
      "duration_ms": 5748,
      "clauses": [
        {
          "index": 0,
          "text": "人はたべものを持って会い、",
          "start_ms": 94774,
          "end_ms": 97668,
          "duration_ms": 2894
        },
        {
          "index": 1,
          "text": "こめをみんなで食べていました。",
          "start_ms": 97918,
          "end_ms": 100522,
          "duration_ms": 2604
        }
      ]
    },
    {
      "index": 14,
      "text": "その使い方は、とてもみじかなものでした。",
      "start_ms": 101022,
      "end_ms": 105714,
      "duration_ms": 4692,
      "clauses": [
        {
          "index": 0,
          "text": "その使い方は、",
          "start_ms": 101022,
          "end_ms": 102976,
          "duration_ms": 1954
        },
        {
          "index": 1,
          "text": "とてもみじかなものでした。",
          "start_ms": 103226,
          "end_ms": 105714,
          "duration_ms": 2488
        }
      ]
    },
    {
      "index": 15,
      "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
      "start_ms": 106214,
      "end_ms": 111128,
      "duration_ms": 4914,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
          "start_ms": 106214,
          "end_ms": 111128,
          "duration_ms": 4914
        }
      ]
    },
    {
      "index": 16,
      "text": "にほんではむかし、「にぎりいい」と言っていました。",
      "start_ms": 111628,
      "end_ms": 116099,
      "duration_ms": 4471,
      "clauses": [
        {
          "index": 0,
          "text": "にほんではむかし、",
          "start_ms": 111628,
          "end_ms": 113570,
          "duration_ms": 1942
        },
        {
          "index": 1,
          "text": "「にぎりいい」と言っていました。",
          "start_ms": 113820,
          "end_ms": 116099,
          "duration_ms": 2279
        }
      ]
    },
    {
      "index": 17,
      "text": "「にぎりいい」が使われているうちに、「にぎりめし」というなまえのことばに換えました。",
      "start_ms": 116599,
      "end_ms": 122962,
      "duration_ms": 6363,
      "clauses": [
        {
          "index": 0,
          "text": "「にぎりいい」が使われているうちに、",
          "start_ms": 116599,
          "end_ms": 119272,
          "duration_ms": 2673
        },
        {
          "index": 1,
          "text": "「にぎりめし」というなまえのことばに換えました。",
          "start_ms": 119522,
          "end_ms": 122962,
          "duration_ms": 3440
        }
      ]
    },
    {
      "index": 18,
      "text": "さらに、けいごの「お」を付けたなまえが「おにぎり」です。",
      "start_ms": 123462,
      "end_ms": 128153,
      "duration_ms": 4691,
      "clauses": [
        {
          "index": 0,
          "text": "さらに、",
          "start_ms": 123462,
          "end_ms": 124672,
          "duration_ms": 1210
        },
        {
          "index": 1,
          "text": "けいごの「お」を付けたなまえが「おにぎり」です。",
          "start_ms": 124922,
          "end_ms": 128153,
          "duration_ms": 3231
        }
      ]
    },
    {
      "index": 19,
      "text": "「おにぎり」をせつめいすることばは、「おむすび」もあります。",
      "start_ms": 128653,
      "end_ms": 133623,
      "duration_ms": 4970,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」をせつめいすることばは、",
          "start_ms": 128653,
          "end_ms": 131350,
          "duration_ms": 2697
        },
        {
          "index": 1,
          "text": "「おむすび」もあります。",
          "start_ms": 131600,
          "end_ms": 133623,
          "duration_ms": 2023
        }
      ]
    },
    {
      "index": 20,
      "text": "「むすび」というなまえをみんなが使い始めたのは、えどじだいです。",
      "start_ms": 134123,
      "end_ms": 140103,
      "duration_ms": 5980,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」というなまえをみんなが使い始めたのは、",
          "start_ms": 134123,
          "end_ms": 138097,
          "duration_ms": 3974
        },
        {
          "index": 1,
          "text": "えどじだいです。",
          "start_ms": 138347,
          "end_ms": 140103,
          "duration_ms": 1756
        }
      ]
    },
    {
      "index": 21,
      "text": "そこにもけいごの「お」を付けました。",
      "start_ms": 140603,
      "end_ms": 143346,
      "duration_ms": 2743,
      "clauses": [
        {
          "index": 0,
          "text": "そこにもけいごの「お」を付けました。",
          "start_ms": 140603,
          "end_ms": 143346,
          "duration_ms": 2743
        }
      ]
    },
    {
      "index": 22,
      "text": "むかしの本には、「むすび」を「にぎりいい」の別のなまえと書いて、「もとは女のことばです」とも書かれています。",
      "start_ms": 143846,
      "end_ms": 153028,
      "duration_ms": 9182,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 143846,
          "end_ms": 145649,
          "duration_ms": 1803
        },
        {
          "index": 1,
          "text": "「むすび」を「にぎりいい」の別のなまえと書いて、",
          "start_ms": 145899,
          "end_ms": 149141,
          "duration_ms": 3242
        },
        {
          "index": 2,
          "text": "「もとは女のことばです」とも書かれています。",
          "start_ms": 149391,
          "end_ms": 153028,
          "duration_ms": 3637
        }
      ]
    },
    {
      "index": 23,
      "text": "「むすび」は、なまえのいみをあらわすだけのことばではありません。",
      "start_ms": 153528,
      "end_ms": 159020,
      "duration_ms": 5492,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」は、",
          "start_ms": 153528,
          "end_ms": 154924,
          "duration_ms": 1396
        },
        {
          "index": 1,
          "text": "なまえのいみをあらわすだけのことばではありません。",
          "start_ms": 155174,
          "end_ms": 159020,
          "duration_ms": 3846
        }
      ]
    },
    {
      "index": 24,
      "text": "かみさまのなまえも、むかしの本に出ています。",
      "start_ms": 159520,
      "end_ms": 164095,
      "duration_ms": 4575,
      "clauses": [
        {
          "index": 0,
          "text": "かみさまのなまえも、",
          "start_ms": 159520,
          "end_ms": 161543,
          "duration_ms": 2023
        },
        {
          "index": 1,
          "text": "むかしの本に出ています。",
          "start_ms": 161793,
          "end_ms": 164095,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 25,
      "text": "そこに、何かを作るいみとか、人と人がつながるいみとかが加わっているのです。",
      "start_ms": 164595,
      "end_ms": 172454,
      "duration_ms": 7859,
      "clauses": [
        {
          "index": 0,
          "text": "そこに、",
          "start_ms": 164595,
          "end_ms": 165794,
          "duration_ms": 1199
        },
        {
          "index": 1,
          "text": "何かを作るいみとか、",
          "start_ms": 166044,
          "end_ms": 168323,
          "duration_ms": 2279
        },
        {
          "index": 2,
          "text": "人と人がつながるいみとかが加わっているのです。",
          "start_ms": 168573,
          "end_ms": 172454,
          "duration_ms": 3881
        }
      ]
    },
    {
      "index": 26,
      "text": "つまり、「むすび」は、いみがさまざまに加わったことばということです。",
      "start_ms": 172954,
      "end_ms": 180023,
      "duration_ms": 7069,
      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 172954,
          "end_ms": 174246,
          "duration_ms": 1292
        },
        {
          "index": 1,
          "text": "「むすび」は、",
          "start_ms": 174496,
          "end_ms": 175904,
          "duration_ms": 1408
        },
        {
          "index": 2,
          "text": "いみがさまざまに加わったことばということです。",
          "start_ms": 176154,
          "end_ms": 180023,
          "duration_ms": 3869
        }
      ]
    },
    {
      "index": 27,
      "text": "もちろん、「むすび」というなまえがかみさまとつながっているとは言えません。",
      "start_ms": 180523,
      "end_ms": 187002,
      "duration_ms": 6479,
      "clauses": [
        {
          "index": 0,
          "text": "もちろん、",
          "start_ms": 180523,
          "end_ms": 181942,
          "duration_ms": 1419
        },
        {
          "index": 1,
          "text": "「むすび」というなまえがかみさまとつながっているとは言えません。",
          "start_ms": 182192,
          "end_ms": 187002,
          "duration_ms": 4810
        }
      ]
    },
    {
      "index": 28,
      "text": "でも、ことばのいみがさまざまに加わっていることにちゅうもくすると、この毎日のたべものがにほんに住む人にとって、大切ないみを持つのでしょう。",
      "start_ms": 187502,
      "end_ms": 200361,
      "duration_ms": 12859,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 187502,
          "end_ms": 188399,
          "duration_ms": 897
        },
        {
          "index": 1,
          "text": "ことばのいみがさまざまに加わっていることにちゅうもくすると、",
          "start_ms": 188649,
          "end_ms": 193284,
          "duration_ms": 4635
        },
        {
          "index": 2,
          "text": "この毎日のたべものがにほんに住む人にとって、",
          "start_ms": 193534,
          "end_ms": 197496,
          "duration_ms": 3962
        },
        {
          "index": 3,
          "text": "大切ないみを持つのでしょう。",
          "start_ms": 197746,
          "end_ms": 200361,
          "duration_ms": 2615
        }
      ]
    },
    {
      "index": 29,
      "text": "こめを作る仕事は、一人では終わりません。",
      "start_ms": 200861,
      "end_ms": 205494,
      "duration_ms": 4633,
      "clauses": [
        {
          "index": 0,
          "text": "こめを作る仕事は、",
          "start_ms": 200861,
          "end_ms": 203000,
          "duration_ms": 2139
        },
        {
          "index": 1,
          "text": "一人では終わりません。",
          "start_ms": 203250,
          "end_ms": 205494,
          "duration_ms": 2244
        }
      ]
    },
    {
      "index": 30,
      "text": "みんなでみずを集め、みんなで使います。",
      "start_ms": 205994,
      "end_ms": 210185,
      "duration_ms": 4191,
      "clauses": [
        {
          "index": 0,
          "text": "みんなでみずを集め、",
          "start_ms": 205994,
          "end_ms": 208040,
          "duration_ms": 2046
        },
        {
          "index": 1,
          "text": "みんなで使います。",
          "start_ms": 208290,
          "end_ms": 210185,
          "duration_ms": 1895
        }
      ]
    },
    {
      "index": 31,
      "text": "みずをまもるのも、こめをうえるのも、みんなの仕事です。",
      "start_ms": 210685,
      "end_ms": 216918,
      "duration_ms": 6233,
      "clauses": [
        {
          "index": 0,
          "text": "みずをまもるのも、",
          "start_ms": 210685,
          "end_ms": 212580,
          "duration_ms": 1895
        },
        {
          "index": 1,
          "text": "こめをうえるのも、",
          "start_ms": 212830,
          "end_ms": 214656,
          "duration_ms": 1826
        },
        {
          "index": 2,
          "text": "みんなの仕事です。",
          "start_ms": 214906,
          "end_ms": 216918,
          "duration_ms": 2012
        }
      ]
    },
    {
      "index": 32,
      "text": "そして、作ったこめをみんなで食べるのに、とてもいいたべものが「おにぎり」です。",
      "start_ms": 217418,
      "end_ms": 224963,
      "duration_ms": 7545,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 217418,
          "end_ms": 218640,
          "duration_ms": 1222
        },
        {
          "index": 1,
          "text": "作ったこめをみんなで食べるのに、",
          "start_ms": 218890,
          "end_ms": 221877,
          "duration_ms": 2987
        },
        {
          "index": 2,
          "text": "とてもいいたべものが「おにぎり」です。",
          "start_ms": 222127,
          "end_ms": 224963,
          "duration_ms": 2836
        }
      ]
    },
    {
      "index": 33,
      "text": "じしんのとき、にほんではよく「おにぎり」が出ます。",
      "start_ms": 225463,
      "end_ms": 230456,
      "duration_ms": 4993,
      "clauses": [
        {
          "index": 0,
          "text": "じしんのとき、",
          "start_ms": 225463,
          "end_ms": 227161,
          "duration_ms": 1698
        },
        {
          "index": 1,
          "text": "にほんではよく「おにぎり」が出ます。",
          "start_ms": 227411,
          "end_ms": 230456,
          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 34,
      "text": "持ちやすく、作るのも楽で、食べるのに何も要りません。",
      "start_ms": 230956,
      "end_ms": 237514,
      "duration_ms": 6558,
      "clauses": [
        {
          "index": 0,
          "text": "持ちやすく、",
          "start_ms": 230956,
          "end_ms": 232561,
          "duration_ms": 1605
        },
        {
          "index": 1,
          "text": "作るのも楽で、",
          "start_ms": 232811,
          "end_ms": 234660,
          "duration_ms": 1849
        },
        {
          "index": 2,
          "text": "食べるのに何も要りません。",
          "start_ms": 234910,
          "end_ms": 237514,
          "duration_ms": 2604
        }
      ]
    },
    {
      "index": 35,
      "text": "みんなにおにぎりを与えました。",
      "start_ms": 238014,
      "end_ms": 240676,
      "duration_ms": 2662,
      "clauses": [
        {
          "index": 0,
          "text": "みんなにおにぎりを与えました。",
          "start_ms": 238014,
          "end_ms": 240676,
          "duration_ms": 2662
        }
      ]
    },
    {
      "index": 36,
      "text": "そのとき、人は人と人がつながることを知りました。",
      "start_ms": 241176,
      "end_ms": 246831,
      "duration_ms": 5655,
      "clauses": [
        {
          "index": 0,
          "text": "そのとき、",
          "start_ms": 241176,
          "end_ms": 242677,
          "duration_ms": 1501
        },
        {
          "index": 1,
          "text": "人は人と人がつながることを知りました。",
          "start_ms": 242927,
          "end_ms": 246831,
          "duration_ms": 3904
        }
      ]
    },
    {
      "index": 37,
      "text": "2000年、にほんでは1月17日を「おむすびの日」にしました。",
      "start_ms": 247331,
      "end_ms": 253810,
      "duration_ms": 6479,
      "clauses": [
        {
          "index": 0,
          "text": "2000年、",
          "start_ms": 247331,
          "end_ms": 248739,
          "duration_ms": 1408
        },
        {
          "index": 1,
          "text": "にほんでは1月17日を「おむすびの日」にしました。",
          "start_ms": 248989,
          "end_ms": 253810,
          "duration_ms": 4821
        }
      ]
    },
    {
      "index": 38,
      "text": "「おにぎり」ではなく「おむすび」というなまえを使ったのは、人と人がつながることを大切にしたからです。",
      "start_ms": 254310,
      "end_ms": 262495,
      "duration_ms": 8185,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ではなく「おむすび」というなまえを使ったのは、",
          "start_ms": 254310,
          "end_ms": 258260,
          "duration_ms": 3950
        },
        {
          "index": 1,
          "text": "人と人がつながることを大切にしたからです。",
          "start_ms": 258510,
          "end_ms": 262495,
          "duration_ms": 3985
        }
      ]
    },
    {
      "index": 39,
      "text": "にほんは、うみの近くにあって、やまが多いくにです。",
      "start_ms": 262995,
      "end_ms": 269135,
      "duration_ms": 6140,
      "clauses": [
        {
          "index": 0,
          "text": "にほんは、",
          "start_ms": 262995,
          "end_ms": 264391,
          "duration_ms": 1396
        },
        {
          "index": 1,
          "text": "うみの近くにあって、",
          "start_ms": 264641,
          "end_ms": 266757,
          "duration_ms": 2116
        },
        {
          "index": 2,
          "text": "やまが多いくにです。",
          "start_ms": 267007,
          "end_ms": 269135,
          "duration_ms": 2128
        }
      ]
    },
    {
      "index": 40,
      "text": "「おにぎり」を見ると、にほんのやまとうみのようすが分かります。",
      "start_ms": 269635,
      "end_ms": 274965,
      "duration_ms": 5330,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」を見ると、",
          "start_ms": 269635,
          "end_ms": 271496,
          "duration_ms": 1861
        },
        {
          "index": 1,
          "text": "にほんのやまとうみのようすが分かります。",
          "start_ms": 271746,
          "end_ms": 274965,
          "duration_ms": 3219
        }
      ]
    },
    {
      "index": 41,
      "text": "やまの近くに住む人はやさいを使い、うみの近くに住む人はさかなを使います。",
      "start_ms": 275465,
      "end_ms": 283186,
      "duration_ms": 7721,
      "clauses": [
        {
          "index": 0,
          "text": "やまの近くに住む人はやさいを使い、",
          "start_ms": 275465,
          "end_ms": 279090,
          "duration_ms": 3625
        },
        {
          "index": 1,
          "text": "うみの近くに住む人はさかなを使います。",
          "start_ms": 279340,
          "end_ms": 283186,
          "duration_ms": 3846
        }
      ]
    },
    {
      "index": 42,
      "text": "「おにぎり」の中には、やまとうみのたべものが入っています。",
      "start_ms": 283686,
      "end_ms": 288993,
      "duration_ms": 5307,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」の中には、",
          "start_ms": 283686,
          "end_ms": 285663,
          "duration_ms": 1977
        },
        {
          "index": 1,
          "text": "やまとうみのたべものが入っています。",
          "start_ms": 285913,
          "end_ms": 288993,
          "duration_ms": 3080
        }
      ]
    },
    {
      "index": 43,
      "text": "そのさまざまなおにぎりが、にほんのたべもののとくちょうを表しています。",
      "start_ms": 289493,
      "end_ms": 295821,
      "duration_ms": 6328,
      "clauses": [
        {
          "index": 0,
          "text": "そのさまざまなおにぎりが、",
          "start_ms": 289493,
          "end_ms": 291957,
          "duration_ms": 2464
        },
        {
          "index": 1,
          "text": "にほんのたべもののとくちょうを表しています。",
          "start_ms": 292207,
          "end_ms": 295821,
          "duration_ms": 3614
        }
      ]
    },
    {
      "index": 44,
      "text": "今は、ほかのくにのたべものも、むかしは知らなかったなかみも多くなっています。",
      "start_ms": 296321,
      "end_ms": 303796,
      "duration_ms": 7475,
      "clauses": [
        {
          "index": 0,
          "text": "今は、",
          "start_ms": 296321,
          "end_ms": 297195,
          "duration_ms": 874
        },
        {
          "index": 1,
          "text": "ほかのくにのたべものも、",
          "start_ms": 297445,
          "end_ms": 299805,
          "duration_ms": 2360
        },
        {
          "index": 2,
          "text": "むかしは知らなかったなかみも多くなっています。",
          "start_ms": 300055,
          "end_ms": 303796,
          "duration_ms": 3741
        }
      ]
    },
    {
      "index": 45,
      "text": "にほんのおにぎりは、さんかくけいがとても多いです。",
      "start_ms": 304296,
      "end_ms": 309428,
      "duration_ms": 5132,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのおにぎりは、",
          "start_ms": 304296,
          "end_ms": 306284,
          "duration_ms": 1988
        },
        {
          "index": 1,
          "text": "さんかくけいがとても多いです。",
          "start_ms": 306534,
          "end_ms": 309428,
          "duration_ms": 2894
        }
      ]
    },
    {
      "index": 46,
      "text": "コンビニのおにぎりになってから、そのようすが決まりました。",
      "start_ms": 309928,
      "end_ms": 315141,
      "duration_ms": 5213,
      "clauses": [
        {
          "index": 0,
          "text": "コンビニのおにぎりになってから、",
          "start_ms": 309928,
          "end_ms": 312520,
          "duration_ms": 2592
        },
        {
          "index": 1,
          "text": "そのようすが決まりました。",
          "start_ms": 312770,
          "end_ms": 315141,
          "duration_ms": 2371
        }
      ]
    },
    {
      "index": 47,
      "text": "さんかくけいは、持つ場合、壊さずに持ちやすいからです。",
      "start_ms": 315641,
      "end_ms": 321909,
      "duration_ms": 6268,
      "clauses": [
        {
          "index": 0,
          "text": "さんかくけいは、",
          "start_ms": 315641,
          "end_ms": 317386,
          "duration_ms": 1745
        },
        {
          "index": 1,
          "text": "持つ場合、",
          "start_ms": 317636,
          "end_ms": 319009,
          "duration_ms": 1373
        },
        {
          "index": 2,
          "text": "壊さずに持ちやすいからです。",
          "start_ms": 319259,
          "end_ms": 321909,
          "duration_ms": 2650
        }
      ]
    },
    {
      "index": 48,
      "text": "多く作って、多く運ぶのにも便利です。",
      "start_ms": 322409,
      "end_ms": 326833,
      "duration_ms": 4424,
      "clauses": [
        {
          "index": 0,
          "text": "多く作って、",
          "start_ms": 322409,
          "end_ms": 323968,
          "duration_ms": 1559
        },
        {
          "index": 1,
          "text": "多く運ぶのにも便利です。",
          "start_ms": 324218,
          "end_ms": 326833,
          "duration_ms": 2615
        }
      ]
    },
    {
      "index": 49,
      "text": "むかしは、にほんでも、ばしょによってようすが違いました。",
      "start_ms": 327333,
      "end_ms": 333577,
      "duration_ms": 6244,
      "clauses": [
        {
          "index": 0,
          "text": "むかしは、",
          "start_ms": 327333,
          "end_ms": 328683,
          "duration_ms": 1350
        },
        {
          "index": 1,
          "text": "にほんでも、",
          "start_ms": 328933,
          "end_ms": 330387,
          "duration_ms": 1454
        },
        {
          "index": 2,
          "text": "ばしょによってようすが違いました。",
          "start_ms": 330637,
          "end_ms": 333577,
          "duration_ms": 2940
        }
      ]
    },
    {
      "index": 50,
      "text": "今は、いろいろななかみを入れて、食べやすくするためのようすもあります。",
      "start_ms": 334077,
      "end_ms": 340914,
      "duration_ms": 6837,
      "clauses": [
        {
          "index": 0,
          "text": "今は、",
          "start_ms": 334077,
          "end_ms": 334986,
          "duration_ms": 909
        },
        {
          "index": 1,
          "text": "いろいろななかみを入れて、",
          "start_ms": 335236,
          "end_ms": 337549,
          "duration_ms": 2313
        },
        {
          "index": 2,
          "text": "食べやすくするためのようすもあります。",
          "start_ms": 337799,
          "end_ms": 340914,
          "duration_ms": 3115
        }
      ]
    },
    {
      "index": 51,
      "text": "にほんのおにぎりは、世界でもちゅうもくされています。",
      "start_ms": 341414,
      "end_ms": 346361,
      "duration_ms": 4947,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのおにぎりは、",
          "start_ms": 341414,
          "end_ms": 343333,
          "duration_ms": 1919
        },
        {
          "index": 1,
          "text": "世界でもちゅうもくされています。",
          "start_ms": 343583,
          "end_ms": 346361,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 52,
      "text": "おにぎりだけのみせがとても多くなっています。",
      "start_ms": 346861,
      "end_ms": 350707,
      "duration_ms": 3846,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりだけのみせがとても多くなっています。",
          "start_ms": 346861,
          "end_ms": 350707,
          "duration_ms": 3846
        }
      ]
    },
    {
      "index": 53,
      "text": "世界の人も食べるようになり、おにぎりをひょうかする人も多くなっています。",
      "start_ms": 351207,
      "end_ms": 357616,
      "duration_ms": 6409,
      "clauses": [
        {
          "index": 0,
          "text": "世界の人も食べるようになり、",
          "start_ms": 351207,
          "end_ms": 353857,
          "duration_ms": 2650
        },
        {
          "index": 1,
          "text": "おにぎりをひょうかする人も多くなっています。",
          "start_ms": 354107,
          "end_ms": 357616,
          "duration_ms": 3509
        }
      ]
    },
    {
      "index": 54,
      "text": "2024年、えいごの大きなじしょに「onigiri」が出ました。",
      "start_ms": 358116,
      "end_ms": 363120,
      "duration_ms": 5004,
      "clauses": [
        {
          "index": 0,
          "text": "2024年、",
          "start_ms": 358116,
          "end_ms": 359988,
          "duration_ms": 1872
        },
        {
          "index": 1,
          "text": "えいごの大きなじしょに「onigiri」が出ました。",
          "start_ms": 360238,
          "end_ms": 363120,
          "duration_ms": 2882
        }
      ]
    },
    {
      "index": 55,
      "text": "にほんごのなまえで知られたしょうこです。",
      "start_ms": 363620,
      "end_ms": 366688,
      "duration_ms": 3068,
      "clauses": [
        {
          "index": 0,
          "text": "にほんごのなまえで知られたしょうこです。",
          "start_ms": 363620,
          "end_ms": 366688,
          "duration_ms": 3068
        }
      ]
    },
    {
      "index": 56,
      "text": "おにぎりは、いろいろなようすになり、世界にも広がっています。",
      "start_ms": 367188,
      "end_ms": 373769,
      "duration_ms": 6581,
      "clauses": [
        {
          "index": 0,
          "text": "おにぎりは、",
          "start_ms": 367188,
          "end_ms": 368666,
          "duration_ms": 1478
        },
        {
          "index": 1,
          "text": "いろいろなようすになり、",
          "start_ms": 368916,
          "end_ms": 371020,
          "duration_ms": 2104
        },
        {
          "index": 2,
          "text": "世界にも広がっています。",
          "start_ms": 371270,
          "end_ms": 373769,
          "duration_ms": 2499
        }
      ]
    },
    {
      "index": 57,
      "text": "でも、こめを手でまとめてみんなで食べるちゅうしんは、今もあります。",
      "start_ms": 374269,
      "end_ms": 381198,
      "duration_ms": 6929,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 374269,
          "end_ms": 375154,
          "duration_ms": 885
        },
        {
          "index": 1,
          "text": "こめを手でまとめてみんなで食べるちゅうしんは、",
          "start_ms": 375404,
          "end_ms": 379296,
          "duration_ms": 3892
        },
        {
          "index": 2,
          "text": "今もあります。",
          "start_ms": 379546,
          "end_ms": 381198,
          "duration_ms": 1652
        }
      ]
    },
    {
      "index": 58,
      "text": "これからも、にほんのおにぎりはみんなに食べられていくでしょう。",
      "start_ms": 381698,
      "end_ms": 387423,
      "duration_ms": 5725,
      "clauses": [
        {
          "index": 0,
          "text": "これからも、",
          "start_ms": 381698,
          "end_ms": 383176,
          "duration_ms": 1478
        },
        {
          "index": 1,
          "text": "にほんのおにぎりはみんなに食べられていくでしょう。",
          "start_ms": 383426,
          "end_ms": 387423,
          "duration_ms": 3997
        }
      ]
    }
  ]
