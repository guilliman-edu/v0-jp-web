          "end_ms": 40095,
          "duration_ms": 4095
        }
      ]
    },
    {
      "index": 6,
      "text": "このこめについては、人によって違う説明をしています。",
      "start_ms": 40595,
      "end_ms": 46691,
      "duration_ms": 6096,
      "clauses": [
