          "start_ms": 28939,
          "end_ms": 33859,
          "duration_ms": 4920
        }
      ]
    },
    {
      "index": 5,
      "text": "そして、それを「むかしのおにぎりのしょうこ」と言っています。",
      "start_ms": 34359,
      "end_ms": 40071,
      "duration_ms": 5712,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 34359,
          "end_ms": 35726,
          "duration_ms": 1367
        },
        {
          "index": 1,
          "text": "それを「むかしのおにぎりのしょうこ」と言っています。",
          "start_ms": 35976,
          "end_ms": 40071,
          "duration_ms": 4095
        }
      ]
    },
    {
      "index": 6,
      "text": "このこめについては、人によって違う説明をしています。",
      "start_ms": 40571,
      "end_ms": 46724,
      "duration_ms": 6153,
      "clauses": [
        {
          "index": 0,
          "text": "このこめについては、",
          "start_ms": 40571,
          "end_ms": 42820,
          "duration_ms": 2249
        },
        {
