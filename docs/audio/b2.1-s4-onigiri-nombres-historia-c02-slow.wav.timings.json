          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 2,
      "text": "にほんでこめを作るようになってから、人は作ったこめを手でまとめていたと考えられています。",
      "start_ms": 10161,
      "end_ms": 19066,
      "duration_ms": 8905,
      "clauses": [
        {
          "index": 0,
          "text": "にほんでこめを作るようになってから、",
          "start_ms": 10161,
          "end_ms": 13409,
          "duration_ms": 3248
        },
        {
          "index": 1,
          "text": "人は作ったこめを手でまとめていたと考えられています。",
          "start_ms": 13659,
          "end_ms": 19066,
          "duration_ms": 5407
        }
      ]
    },
    {
      "index": 3,
      "text": "にほんのあるばしょでは、2000年前のこめが出たこともあります。",
      "start_ms": 19566,
      "end_ms": 25754,
      "duration_ms": 6188,
      "clauses": [
        {
          "index": 0,
          "text": "にほんのあるばしょでは、",
