          "text": "人によって違う説明をしています。",
          "start_ms": 43070,
          "end_ms": 46724,
          "duration_ms": 3654
        }
      ]
    },
    {
      "index": 7,
      "text": "大切なのは、こめを手でまとめて持ちやすくすることを、にほんではとてもむかしからやっていることです。",
      "start_ms": 47224,
      "end_ms": 57329,
      "duration_ms": 10105,
      "clauses": [
        {
