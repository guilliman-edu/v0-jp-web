          "text": "2000年前のこめが出たこともあります。",
          "start_ms": 22181,
          "end_ms": 25754,
          "duration_ms": 3573
        }
      ]
    },
    {
      "index": 4,
      "text": "手で作ったのではなく、ほかのしゅだんで作られたと考えられているものもあります。",
      "start_ms": 26254,
      "end_ms": 33859,
      "duration_ms": 7605,
      "clauses": [
        {
