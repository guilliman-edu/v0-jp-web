          "duration_ms": 4107
        },
        {
          "index": 1,
          "text": "アカデミー名誉賞を受けた。",
          "start_ms": 154242,
          "end_ms": 156944,
          "duration_ms": 2702
        }
      ]
    },
    {
      "index": 20,
      "text": "黒澤はしょうがいで30本のさくひんを作り、そのうち16本はみふねとしろうと作ったものだ。",
      "start_ms": 157444,
      "end_ms": 167243,
      "duration_ms": 9799,
      "clauses": [
        {
