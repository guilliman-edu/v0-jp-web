          "duration_ms": 3132
        },
        {
          "index": 1,
          "text": "映画を作る人として初めて文化勲章を受けた。",
          "start_ms": 144616,
          "end_ms": 149385,
          "duration_ms": 4769
        }
      ]
    },
    {
      "index": 19,
      "text": "1990年には『夢』を作り、アカデミー名誉賞を受けた。",
      "start_ms": 149885,
      "end_ms": 156944,
      "duration_ms": 7059,
      "clauses": [
        {
          "index": 0,
          "text": "1990年には『夢』を作り、",
