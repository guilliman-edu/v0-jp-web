  "sentences": [
    {
      "index": 0,
      "text": "くろさわあきら — せかいで有名な映画を作った人",
      "start_ms": 0,
      "end_ms": 4281,
      "duration_ms": 4281,
      "clauses": [
        {
          "index": 0,
          "text": "くろさわあきら — せかいで有名な映画を作った人",
          "start_ms": 0,
          "end_ms": 4281,
          "duration_ms": 4281
        }
      ]
    },
    {
      "index": 1,
      "text": "くろさわあきらは1910年、とうきょうに生まれた。",
      "start_ms": 4781,
      "end_ms": 10935,
      "duration_ms": 6154,
      "clauses": [
        {
          "index": 0,
          "text": "くろさわあきらは1910年、",
          "start_ms": 4781,
          "end_ms": 8540,
          "duration_ms": 3759
        },
        {
          "index": 1,
          "text": "とうきょうに生まれた。",
          "start_ms": 8790,
          "end_ms": 10935,
          "duration_ms": 2145
        }
      ]
    },
    {
      "index": 2,
      "text": "八人のきょうだいがいた。",
      "start_ms": 11435,
      "end_ms": 13998,
      "duration_ms": 2563,
      "clauses": [
        {
          "index": 0,
          "text": "八人のきょうだいがいた。",
          "start_ms": 11435,
          "end_ms": 13998,
          "duration_ms": 2563
        }
      ]
    },
    {
      "index": 3,
      "text": "ちちは厳しかったが、映画に興味があり、よくきょうだいをえいがかんに連れて行った。",
      "start_ms": 14498,
      "end_ms": 23233,
      "duration_ms": 8735,
      "clauses": [
        {
          "index": 0,
          "text": "ちちは厳しかったが、",
          "start_ms": 14498,
          "end_ms": 16887,
          "duration_ms": 2389
        },
        {
          "index": 1,
          "text": "映画に興味があり、",
          "start_ms": 17137,
          "end_ms": 19352,
          "duration_ms": 2215
        },
        {
          "index": 2,
          "text": "よくきょうだいをえいがかんに連れて行った。",
          "start_ms": 19602,
          "end_ms": 23233,
          "duration_ms": 3631
        }
      ]
    },
    {
      "index": 4,
      "text": "黒澤は若いときから映画を見ながら育った。",
      "start_ms": 23733,
      "end_ms": 27979,
      "duration_ms": 4246,
      "clauses": [
        {
          "index": 0,
          "text": "黒澤は若いときから映画を見ながら育った。",
          "start_ms": 23733,
          "end_ms": 27979,
          "duration_ms": 4246
        }
      ]
    },
    {
      "index": 5,
      "text": "小学校の先生は、黒澤のかいがを「とてもいい」と言ってくれた。",
      "start_ms": 28479,
      "end_ms": 35190,
      "duration_ms": 6711,
      "clauses": [
        {
          "index": 0,
          "text": "小学校の先生は、",
          "start_ms": 28479,
          "end_ms": 31030,
          "duration_ms": 2551
        },
        {
          "index": 1,
          "text": "黒澤のかいがを「とてもいい」と言ってくれた。",
          "start_ms": 31280,
          "end_ms": 35190,
          "duration_ms": 3910
        }
      ]
    },
    {
      "index": 6,
      "text": "それから、黒澤はかいがを描くことにむちゅうになった。",
      "start_ms": 35690,
      "end_ms": 41890,
      "duration_ms": 6200,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 35690,
          "end_ms": 37243,
          "duration_ms": 1553
        },
        {
          "index": 1,
          "text": "黒澤はかいがを描くことにむちゅうになった。",
          "start_ms": 37493,
          "end_ms": 41890,
          "duration_ms": 4397
        }
      ]
    },
    {
      "index": 7,
      "text": "学校ではしょうせつをたくさん読み、じんせいについても勉強した。",
      "start_ms": 42390,
      "end_ms": 48892,
      "duration_ms": 6502,
      "clauses": [
        {
          "index": 0,
          "text": "学校ではしょうせつをたくさん読み、",
          "start_ms": 42390,
          "end_ms": 45742,
          "duration_ms": 3352
        },
        {
          "index": 1,
          "text": "じんせいについても勉強した。",
          "start_ms": 45992,
          "end_ms": 48892,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 8,
      "text": "はじめはかいがの仕事をしたいと思っていた。",
      "start_ms": 49392,
      "end_ms": 53638,
      "duration_ms": 4246,
      "clauses": [
        {
          "index": 0,
          "text": "はじめはかいがの仕事をしたいと思っていた。",
          "start_ms": 49392,
          "end_ms": 53638,
          "duration_ms": 4246
        }
      ]
    },
    {
      "index": 9,
      "text": "しかし、1936年に映画のかいしゃに入り、映画を作る人のそばで作り方を習った。",
      "start_ms": 54138,
      "end_ms": 64602,
      "duration_ms": 10464,
      "clauses": [
        {
          "index": 0,
          "text": "しかし、",
          "start_ms": 54138,
          "end_ms": 55598,
          "duration_ms": 1460
        },
        {
          "index": 1,
          "text": "1936年に映画のかいしゃに入り、",
          "start_ms": 55848,
          "end_ms": 60326,
          "duration_ms": 4478
        },
        {
          "index": 2,
          "text": "映画を作る人のそばで作り方を習った。",
          "start_ms": 60576,
          "end_ms": 64602,
          "duration_ms": 4026
        }
      ]
    },
    {
      "index": 10,
      "text": "1943年、『姿三四郎』で初めて自分で映画を作った。",
      "start_ms": 65102,
      "end_ms": 72753,
      "duration_ms": 7651,
      "clauses": [
        {
          "index": 0,
          "text": "1943年、",
          "start_ms": 65102,
          "end_ms": 67955,
          "duration_ms": 2853
        },
        {
          "index": 1,
          "text": "『姿三四郎』で初めて自分で映画を作った。",
          "start_ms": 68205,
          "end_ms": 72753,
          "duration_ms": 4548
        }
      ]
    },
    {
      "index": 11,
      "text": "戦争のあと、黒澤は『酔いどれ天使』や『野良犬』をはっぴょうして注目を集めた。",
      "start_ms": 73253,
      "end_ms": 81299,
      "duration_ms": 8046,
      "clauses": [
        {
          "index": 0,
          "text": "戦争のあと、",
          "start_ms": 73253,
          "end_ms": 75189,
          "duration_ms": 1936
        },
        {
          "index": 1,
          "text": "黒澤は『酔いどれ天使』や『野良犬』をはっぴょうして注目を集めた。",
          "start_ms": 75439,
          "end_ms": 81299,
          "duration_ms": 5860
        }
      ]
    },
    {
      "index": 12,
      "text": "1950年の『羅生門』はヴェネツィア国際映画祭で金獅子賞を受け、にほんの映画にとって、せかいに知られるきっかけになった。",
      "start_ms": 81799,
      "end_ms": 95142,
      "duration_ms": 13343,
      "clauses": [
        {
          "index": 0,
          "text": "1950年の『羅生門』はヴェネツィア国際映画祭で金獅子賞を受け、",
          "start_ms": 81799,
          "end_ms": 89157,
          "duration_ms": 7358
        },
        {
          "index": 1,
          "text": "にほんの映画にとって、",
          "start_ms": 89407,
          "end_ms": 91749,
          "duration_ms": 2342
        },
        {
          "index": 2,
          "text": "せかいに知られるきっかけになった。",
          "start_ms": 91999,
          "end_ms": 95142,
          "duration_ms": 3143
        }
      ]
    },
    {
      "index": 13,
      "text": "その後も『生きる』『七人の侍』『ようじんぼう』などを作り、かいがいでも高く評価された。",
      "start_ms": 95642,
      "end_ms": 103966,
      "duration_ms": 8324,
      "clauses": [
        {
          "index": 0,
          "text": "その後も『生きる』『七人の侍』『ようじんぼう』などを作り、",
          "start_ms": 95642,
          "end_ms": 100480,
          "duration_ms": 4838
        },
        {
          "index": 1,
          "text": "かいがいでも高く評価された。",
          "start_ms": 100730,
          "end_ms": 103966,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 14,
      "text": "かいがいでは、黒澤の映画をもとにあたらしい映画が作られた。",
      "start_ms": 104466,
      "end_ms": 111095,
      "duration_ms": 6629,
      "clauses": [
        {
          "index": 0,
          "text": "かいがいでは、",
          "start_ms": 104466,
          "end_ms": 106158,
          "duration_ms": 1692
        },
        {
          "index": 1,
          "text": "黒澤の映画をもとにあたらしい映画が作られた。",
          "start_ms": 106408,
          "end_ms": 111095,
          "duration_ms": 4687
        }
      ]
    },
    {
      "index": 15,
      "text": "1960ねんだいのこうはん、にほんでは映画を見る人が少なくなり、映画を作る仕事は困難になった。",
      "start_ms": 111595,
      "end_ms": 123197,
      "duration_ms": 11602,
      "clauses": [
        {
          "index": 0,
          "text": "1960ねんだいのこうはん、",
          "start_ms": 111595,
          "end_ms": 115087,
          "duration_ms": 3492
        },
        {
          "index": 1,
          "text": "にほんでは映画を見る人が少なくなり、",
          "start_ms": 115337,
          "end_ms": 119154,
          "duration_ms": 3817
        },
        {
          "index": 2,
          "text": "映画を作る仕事は困難になった。",
          "start_ms": 119404,
          "end_ms": 123197,
          "duration_ms": 3793
        }
      ]
    },
    {
      "index": 16,
      "text": "黒澤はアメリカで仕事をしようとしたものの、思ったようにはいかなかった。",
      "start_ms": 123697,
      "end_ms": 131616,
      "duration_ms": 7919,
      "clauses": [
        {
          "index": 0,
          "text": "黒澤はアメリカで仕事をしようとしたものの、",
          "start_ms": 123697,
          "end_ms": 128199,
          "duration_ms": 4502
        },
        {
          "index": 1,
          "text": "思ったようにはいかなかった。",
          "start_ms": 128449,
          "end_ms": 131616,
          "duration_ms": 3167
        }
      ]
    },
    {
      "index": 17,
      "text": "それでも、かいがいのしきんのおかげで、『デルス・ウザーラ』『影武者』『乱』を作ることができた。",
      "start_ms": 132116,
      "end_ms": 140734,
      "duration_ms": 8618,
      "clauses": [
        {
          "index": 0,
          "text": "それでも、",
          "start_ms": 132116,
          "end_ms": 133657,
          "duration_ms": 1541
        },
        {
          "index": 1,
          "text": "かいがいのしきんのおかげで、",
          "start_ms": 133907,
          "end_ms": 136447,
          "duration_ms": 2540
        },
        {
          "index": 2,
          "text": "『デルス・ウザーラ』『影武者』『乱』を作ることができた。",
          "start_ms": 136697,
          "end_ms": 140734,
          "duration_ms": 4037
        }
      ]
    },
    {
      "index": 18,
      "text": "1985年には、映画を作る人として初めて文化勲章を受けた。",
      "start_ms": 141234,
      "end_ms": 149385,
      "duration_ms": 8151,
      "clauses": [
        {
          "index": 0,
          "text": "1985年には、",
          "start_ms": 141234,
