          "start_ms": 0,
          "end_ms": 2183,
          "duration_ms": 2183
        }
      ]
    },
    {
      "index": 1,
      "text": "むかし、シンデレラという女の子がいました。",
      "start_ms": 2683,
      "end_ms": 8053,
      "duration_ms": 5370,
      "clauses": [
        {
          "index": 0,
          "text": "むかし、",
          "start_ms": 2683,
          "end_ms": 4169,
          "duration_ms": 1486
        },
        {
          "index": 1,
          "text": "シンデレラという女の子がいました。",
          "start_ms": 4419,
          "end_ms": 8053,
          "duration_ms": 3634
        }
      ]
    },
    {
      "index": 2,
      "text": "シンデレラの母が死んだとき、シンデレラは寂しかったです。",
      "start_ms": 8553,
      "end_ms": 15259,
      "duration_ms": 6706,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラの母が死んだとき、",
          "start_ms": 8553,
          "end_ms": 11665,
          "duration_ms": 3112
        },
        {
          "index": 1,
          "text": "シンデレラは寂しかったです。",
          "start_ms": 11915,
          "end_ms": 15259,
          "duration_ms": 3344
        }
      ]
    },
    {
      "index": 3,
      "text": "それから、父の家に継母と二人の女の子が来ました。",
      "start_ms": 15759,
      "end_ms": 22383,
      "duration_ms": 6624,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 15759,
          "end_ms": 17419,
          "duration_ms": 1660
        },
        {
          "index": 1,
          "text": "父の家に継母と二人の女の子が来ました。",
          "start_ms": 17669,
          "end_ms": 22383,
          "duration_ms": 4714
        }
      ]
    },
    {
      "index": 4,
      "text": "継母と二人の女の子はシンデレラに親切ではありませんでした。",
      "start_ms": 22883,
      "end_ms": 29176,
      "duration_ms": 6293,
      "clauses": [
        {
          "index": 0,
          "text": "継母と二人の女の子はシンデレラに親切ではありませんでした。",
          "start_ms": 22883,
          "end_ms": 29176,
          "duration_ms": 6293
        }
      ]
    },
    {
      "index": 5,
      "text": "シンデレラは毎日掃除したり、洗濯したりしました。",
      "start_ms": 29676,
      "end_ms": 36149,
      "duration_ms": 6473,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラは毎日掃除したり、",
          "start_ms": 29676,
          "end_ms": 33275,
          "duration_ms": 3599
        },
        {
          "index": 1,
          "text": "洗濯したりしました。",
          "start_ms": 33525,
          "end_ms": 36149,
          "duration_ms": 2624
        }
      ]
    },
    {
      "index": 6,
      "text": "それから、服も作りました。",
      "start_ms": 36649,
      "end_ms": 40870,
      "duration_ms": 4221,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 36649,
          "end_ms": 38309,
          "duration_ms": 1660
        },
        {
          "index": 1,
          "text": "服も作りました。",
          "start_ms": 38559,
          "end_ms": 40870,
          "duration_ms": 2311
        }
      ]
    },
    {
      "index": 7,
      "text": "シンデレラはとても忙しかったです。",
      "start_ms": 41370,
      "end_ms": 45132,
      "duration_ms": 3762,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラはとても忙しかったです。",
          "start_ms": 41370,
          "end_ms": 45132,
          "duration_ms": 3762
        }
      ]
    },
    {
      "index": 8,
      "text": "そして、寂しかったです。",
      "start_ms": 45632,
      "end_ms": 49505,
      "duration_ms": 3873,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 45632,
          "end_ms": 47060,
          "duration_ms": 1428
        },
        {
          "index": 1,
          "text": "寂しかったです。",
          "start_ms": 47310,
          "end_ms": 49505,
          "duration_ms": 2195
        }
      ]
    },
    {
      "index": 9,
      "text": "ある日、王子の家で大きいパーティーがありました。",
      "start_ms": 50005,
      "end_ms": 55991,
      "duration_ms": 5986,
      "clauses": [
        {
          "index": 0,
          "text": "ある日、",
          "start_ms": 50005,
          "end_ms": 51724,
          "duration_ms": 1719
        },
        {
          "index": 1,
          "text": "王子の家で大きいパーティーがありました。",
          "start_ms": 51974,
          "end_ms": 55991,
          "duration_ms": 4017
        }
      ]
    },
    {
      "index": 10,
      "text": "町の女の子はみんな、パーティーに行きました。",
      "start_ms": 56491,
      "end_ms": 61792,
      "duration_ms": 5301,
      "clauses": [
        {
          "index": 0,
          "text": "町の女の子はみんな、",
