          "index": 1,
          "text": "白い鳥が来ました。",
          "start_ms": 75827,
          "end_ms": 78312,
          "duration_ms": 2485
        }
      ]
    },
    {
      "index": 14,
      "text": "鳥はシンデレラに素敵な服と靴をくれました。",
      "start_ms": 78812,
      "end_ms": 83398,
      "duration_ms": 4586,
      "clauses": [
        {
          "index": 0,
          "text": "鳥はシンデレラに素敵な服と靴をくれました。",
          "start_ms": 78812,
          "end_ms": 83398,
          "duration_ms": 4586
        }
      ]
    },
    {
      "index": 15,
      "text": "シンデレラは鳥から服と靴をもらって、パーティーへ行きました。",
      "start_ms": 83898,
      "end_ms": 90313,
      "duration_ms": 6415,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラは鳥から服と靴をもらって、",
          "start_ms": 83898,
