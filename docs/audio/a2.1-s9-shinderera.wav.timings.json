          "duration_ms": 2810
        },
        {
          "index": 1,
          "text": "パーティーに行きました。",
          "start_ms": 59551,
          "end_ms": 61792,
          "duration_ms": 2241
        }
      ]
    },
    {
      "index": 11,
      "text": "シンデレラも行きたいと思いました。",
      "start_ms": 62292,
      "end_ms": 65624,
      "duration_ms": 3332,
      "clauses": [
        {
          "index": 0,
          "text": "シンデレラも行きたいと思いました。",
          "start_ms": 62292,
          "end_ms": 65624,
          "duration_ms": 3332
        }
      ]
    },
    {
      "index": 12,
      "text": "でも、継母は「服も靴もありませんから、行きません」と言っていました。",
      "start_ms": 66124,
      "end_ms": 74078,
      "duration_ms": 7954,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
