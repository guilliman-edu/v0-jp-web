        },
        {
          "index": 2,
          "text": "行きません」と言っていました。",
          "start_ms": 71280,
          "end_ms": 74078,
          "duration_ms": 2798
        }
      ]
    },
    {
      "index": 13,
      "text": "夜、白い鳥が来ました。",
      "start_ms": 74578,
      "end_ms": 78312,
      "duration_ms": 3734,
      "clauses": [
        {
