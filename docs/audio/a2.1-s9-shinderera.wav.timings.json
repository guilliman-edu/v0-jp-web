          "text": "パーティーへ行きました。",
          "start_ms": 88049,
          "end_ms": 90313,
          "duration_ms": 2264
        }
      ]
    },
    {
      "index": 16,
      "text": "王子はシンデレラを見て、一番素敵だと思いました。",
