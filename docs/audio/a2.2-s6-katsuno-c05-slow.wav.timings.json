          "end_ms": 192319,
          "duration_ms": 2464
        },
        {
          "index": 1,
          "text": "いますね」。",
          "start_ms": 192569,
          "end_ms": 194105,
          "duration_ms": 1536
        }
      ]
    },
    {
      "index": 48,
      "text": "おくさんはこたえました。",
      "start_ms": 194605,
      "end_ms": 197383,
      "duration_ms": 2778,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはこたえました。",
          "start_ms": 194605,
          "end_ms": 197383,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 49,
      "text": "「あした、ゆみのたいかいがあります。",
      "start_ms": 197883,
      "end_ms": 202215,
      "duration_ms": 4332,
      "clauses": [
        {
          "index": 0,
          "text": "「あした、",
          "start_ms": 197883,
          "end_ms": 199268,
          "duration_ms": 1385
        },
        {
          "index": 1,
          "text": "ゆみのたいかいがあります。",
          "start_ms": 199518,
          "end_ms": 202215,
          "duration_ms": 2697
        }
      ]
    },
    {
      "index": 50,
      "text": "さむらいがおおく、きます。",
      "start_ms": 202715,
      "end_ms": 206710,
      "duration_ms": 3995,
      "clauses": [
        {
          "index": 0,
          "text": "さむらいがおおく、",
          "start_ms": 202715,
          "end_ms": 204971,
          "duration_ms": 2256
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 205221,
          "end_ms": 206710,
          "duration_ms": 1489
        }
      ]
    },
    {
      "index": 51,
      "text": "みな、ゆみをじょうずにつかいます。",
      "start_ms": 207210,
      "end_ms": 211646,
      "duration_ms": 4436,
      "clauses": [
        {
          "index": 0,
          "text": "みな、",
          "start_ms": 207210,
          "end_ms": 208363,
          "duration_ms": 1153
        },
        {
          "index": 1,
          "text": "ゆみをじょうずにつかいます。",
          "start_ms": 208613,
          "end_ms": 211646,
          "duration_ms": 3033
        }
      ]
    },
    {
      "index": 52,
      "text": "あるいて、じょうずにします」。",
      "start_ms": 212146,
      "end_ms": 216176,
      "duration_ms": 4030,
      "clauses": [
        {
          "index": 0,
          "text": "あるいて、",
          "start_ms": 212146,
          "end_ms": 213798,
          "duration_ms": 1652
        },
        {
          "index": 1,
          "text": "じょうずにします」。",
          "start_ms": 214048,
          "end_ms": 216176,
          "duration_ms": 2128
        }
      ]
    },
    {
      "index": 53,
      "text": "「さむらいはみな、きますか」。",
      "start_ms": 216676,
      "end_ms": 220834,
      "duration_ms": 4158,
      "clauses": [
        {
          "index": 0,
          "text": "「さむらいはみな、",
          "start_ms": 216676,
          "end_ms": 218804,
          "duration_ms": 2128
        },
        {
          "index": 1,
          "text": "きますか」。",
          "start_ms": 219054,
          "end_ms": 220834,
          "duration_ms": 1780
        }
      ]
    },
    {
      "index": 54,
      "text": "おくさんはわらいました。",
      "start_ms": 221334,
      "end_ms": 224007,
      "duration_ms": 2673,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはわらいました。",
          "start_ms": 221334,
          "end_ms": 224007,
          "duration_ms": 2673
        }
      ]
    },
    {
      "index": 55,
      "text": "「みな、きます。",
      "start_ms": 224507,
      "end_ms": 227352,
      "duration_ms": 2845,
      "clauses": [
        {
          "index": 0,
          "text": "「みな、",
          "start_ms": 224507,
          "end_ms": 225613,
          "duration_ms": 1106
        },
        {
          "index": 1,
          "text": "きます。",
          "start_ms": 225863,
          "end_ms": 227352,
          "duration_ms": 1489
        }
      ]
    },
    {
      "index": 56,
      "text": "とのさまもきます。",
      "start_ms": 227852,
      "end_ms": 230154,
      "duration_ms": 2302,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまもきます。",
          "start_ms": 227852,
          "end_ms": 230154,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 57,
      "text": "あなたはゆみがすきですか」。",
      "start_ms": 230654,
      "end_ms": 233676,
      "duration_ms": 3022,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはゆみがすきですか」。",
          "start_ms": 230654,
          "end_ms": 233676,
          "duration_ms": 3022
        }
      ]
    },
    {
      "index": 58,
      "text": "「いいえ。",
      "start_ms": 234176,
      "end_ms": 234980,
      "duration_ms": 804,
      "clauses": [
        {
          "index": 0,
          "text": "「いいえ。",
          "start_ms": 234176,
          "end_ms": 234980,
          "duration_ms": 804
        }
      ]
    },
    {
      "index": 59,
      "text": "ちちがすきでした。",
      "start_ms": 235480,
      "end_ms": 237782,
      "duration_ms": 2302,
      "clauses": [
        {
          "index": 0,
          "text": "ちちがすきでした。",
          "start_ms": 235480,
          "end_ms": 237782,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 60,
      "text": "まえからゆみをみたことがありました。",
      "start_ms": 238282,
      "end_ms": 241907,
      "duration_ms": 3625,
      "clauses": [
        {
          "index": 0,
          "text": "まえからゆみをみたことがありました。",
          "start_ms": 238282,
          "end_ms": 241907,
          "duration_ms": 3625
        }
      ]
    },
    {
      "index": 61,
      "text": "だからすこし、しっています」。",
      "start_ms": 242407,
      "end_ms": 246552,
      "duration_ms": 4145,
      "clauses": [
        {
          "index": 0,
          "text": "だからすこし、",
          "start_ms": 242407,
          "end_ms": 244430,
          "duration_ms": 2023
        },
        {
          "index": 1,
          "text": "しっています」。",
          "start_ms": 244680,
          "end_ms": 246552,
          "duration_ms": 1872
        }
      ]
    },
    {
      "index": 62,
      "text": "おくさんはかいてあるものをだしました。",
      "start_ms": 247052,
      "end_ms": 251200,
      "duration_ms": 4148,
      "clauses": [
        {
          "index": 0,
          "text": "おくさんはかいてあるものをだしました。",
          "start_ms": 247052,
          "end_ms": 251200,
          "duration_ms": 4148
        }
      ]
    },
    {
      "index": 63,
      "text": "「ではこれをみてください。",
      "start_ms": 251700,
      "end_ms": 254733,
      "duration_ms": 3033,
      "clauses": [
        {
          "index": 0,
          "text": "「ではこれをみてください。",
          "start_ms": 251700,
          "end_ms": 254733,
          "duration_ms": 3033
        }
      ]
    },
    {
      "index": 64,
      "text": "くるさむらいの、なまえがかいてあります」。",
      "start_ms": 255233,
      "end_ms": 260214,
      "duration_ms": 4981,
      "clauses": [
        {
          "index": 0,
          "text": "くるさむらいの、",
          "start_ms": 255233,
          "end_ms": 257291,
          "duration_ms": 2058
        },
        {
          "index": 1,
          "text": "なまえがかいてあります」。",
          "start_ms": 257541,
          "end_ms": 260214,
          "duration_ms": 2673
        }
      ]
    },
    {
      "index": 65,
      "text": "カツノはそれをもちました。",
      "start_ms": 260714,
      "end_ms": 263852,
      "duration_ms": 3138,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはそれをもちました。",
          "start_ms": 260714,
          "end_ms": 263852,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 66,
      "text": "うえからしたまでよみました。",
      "start_ms": 264352,
      "end_ms": 267455,
      "duration_ms": 3103,
      "clauses": [
        {
          "index": 0,
          "text": "うえからしたまでよみました。",
          "start_ms": 264352,
          "end_ms": 267455,
          "duration_ms": 3103
        }
      ]
    },
    {
      "index": 67,
      "text": "なまえがありました。",
      "start_ms": 267955,
      "end_ms": 270303,
      "duration_ms": 2348,
      "clauses": [
        {
          "index": 0,
          "text": "なまえがありました。",
          "start_ms": 267955,
          "end_ms": 270303,
          "duration_ms": 2348
        }
      ]
    },
    {
      "index": 68,
      "text": "「シチロウエモン」。",
      "start_ms": 270803,
      "end_ms": 272514,
      "duration_ms": 1711,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 270803,
          "end_ms": 272514,
          "duration_ms": 1711
        }
      ]
    },
    {
      "index": 69,
      "text": "カツノはまた、よみました。",
      "start_ms": 273014,
      "end_ms": 277206,
      "duration_ms": 4192,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはまた、",
          "start_ms": 273014,
          "end_ms": 275107,
          "duration_ms": 2093
        },
        {
          "index": 1,
          "text": "よみました。",
          "start_ms": 275357,
          "end_ms": 277206,
          "duration_ms": 1849
        }
      ]
    },
    {
      "index": 70,
      "text": "「シチロウエモン」。",
      "start_ms": 277706,
      "end_ms": 279417,
      "duration_ms": 1711,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモン」。",
          "start_ms": 277706,
          "end_ms": 279417,
          "duration_ms": 1711
        }
      ]
    },
    {
      "index": 71,
      "text": "はい、シチロウエモンです。",
      "start_ms": 279917,
      "end_ms": 283274,
      "duration_ms": 3357,
      "clauses": [
        {
          "index": 0,
          "text": "はい、",
          "start_ms": 279917,
          "end_ms": 280628,
          "duration_ms": 711
        },
        {
          "index": 1,
          "text": "シチロウエモンです。",
          "start_ms": 280878,
          "end_ms": 283274,
          "duration_ms": 2396
        }
      ]
    },
    {
      "index": 72,
      "text": "「ついにきます。",
      "start_ms": 283774,
      "end_ms": 285751,
      "duration_ms": 1977,
      "clauses": [
        {
          "index": 0,
          "text": "「ついにきます。",
          "start_ms": 283774,
          "end_ms": 285751,
          "duration_ms": 1977
        }
      ]
    },
    {
      "index": 73,
      "text": "もう、まちません」。",
      "start_ms": 286251,
      "end_ms": 289294,
      "duration_ms": 3043,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 286251,
          "end_ms": 287160,
          "duration_ms": 909
        },
        {
          "index": 1,
          "text": "まちません」。",
          "start_ms": 287410,
          "end_ms": 289294,
          "duration_ms": 1884
        }
      ]
    },
    {
      "index": 74,
      "text": "そのよる、カツノはおきていました。",
      "start_ms": 289794,
      "end_ms": 294625,
      "duration_ms": 4831,
      "clauses": [
        {
          "index": 0,
          "text": "そのよる、",
          "start_ms": 289794,
          "end_ms": 291504,
          "duration_ms": 1710
        },
        {
          "index": 1,
          "text": "カツノはおきていました。",
          "start_ms": 291754,
          "end_ms": 294625,
          "duration_ms": 2871
        }
      ]
    },
    {
      "index": 75,
      "text": "ちいさなかたなをもちました。",
      "start_ms": 295125,
      "end_ms": 298182,
      "duration_ms": 3057,
      "clauses": [
        {
          "index": 0,
          "text": "ちいさなかたなをもちました。",
          "start_ms": 295125,
          "end_ms": 298182,
          "duration_ms": 3057
        }
      ]
    },
    {
      "index": 76,
      "text": "「ハチヤ。",
      "start_ms": 298682,
      "end_ms": 300311,
      "duration_ms": 1629,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤ。",
          "start_ms": 298682,
          "end_ms": 300311,
          "duration_ms": 1629
        }
      ]
    },
    {
      "index": 77,
      "text": "あした、あいます。",
      "start_ms": 300811,
      "end_ms": 304167,
      "duration_ms": 3356,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 300811,
          "end_ms": 302265,
          "duration_ms": 1454
        },
        {
          "index": 1,
          "text": "あいます。",
          "start_ms": 302515,
          "end_ms": 304167,
          "duration_ms": 1652
        }
      ]
    },
    {
      "index": 78,
      "text": "あした、ころします。",
      "start_ms": 304667,
      "end_ms": 308092,
      "duration_ms": 3425,
      "clauses": [
        {
          "index": 0,
          "text": "あした、",
          "start_ms": 304667,
          "end_ms": 306121,
          "duration_ms": 1454
        },
        {
          "index": 1,
          "text": "ころします。",
          "start_ms": 306371,
          "end_ms": 308092,
          "duration_ms": 1721
        }
      ]
    },
    {
      "index": 79,
      "text": "もう、まってください」。",
      "start_ms": 308592,
      "end_ms": 311821,
      "duration_ms": 3229,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 308592,
          "end_ms": 309501,
          "duration_ms": 909
        },
        {
          "index": 1,
          "text": "まってください」。",
          "start_ms": 309751,
          "end_ms": 311821,
          "duration_ms": 2070
        }
      ]
    }
  ]
}