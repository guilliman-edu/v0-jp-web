          "duration_ms": 833
        },
        {
          "index": 1,
          "text": "なにもしんぱい、",
          "start_ms": 180393,
          "end_ms": 182317,
          "duration_ms": 1924
        },
        {
          "index": 2,
          "text": "しないでください。",
          "start_ms": 182567,
          "end_ms": 184573,
          "duration_ms": 2006
        }
      ]
    },
    {
      "index": 47,
      "text": "どうぞ、げんきでいてください」。",
      "start_ms": 185073,
      "end_ms": 188614,
      "duration_ms": 3541,
      "clauses": [
        {
          "index": 0,
          "text": "どうぞ、",
          "start_ms": 185073,
          "end_ms": 186219,
          "duration_ms": 1146
        },
        {
          "index": 1,
          "text": "げんきでいてください」。",
          "start_ms": 186469,
          "end_ms": 188614,
          "duration_ms": 2145
        }
      ]
    },
    {
      "index": 48,
      "text": "につめのてがみはわかいさむらいへのてがみです。",
      "start_ms": 189114,
      "end_ms": 193314,
      "duration_ms": 4200,
      "clauses": [
        {
          "index": 0,
          "text": "につめのてがみはわかいさむらいへのてがみです。",
          "start_ms": 189114,
          "end_ms": 193314,
          "duration_ms": 4200
        }
      ]
    },
    {
      "index": 49,
      "text": "「あなたはわたしをたいせつにおもいました。",
      "start_ms": 193814,
      "end_ms": 197619,
      "duration_ms": 3805,
      "clauses": [
        {
          "index": 0,
          "text": "「あなたはわたしをたいせつにおもいました。",
          "start_ms": 193814,
          "end_ms": 197619,
          "duration_ms": 3805
        }
      ]
    },
    {
      "index": 50,
      "text": "あなたといて、うれしかったです。",
      "start_ms": 198119,
      "end_ms": 202102,
      "duration_ms": 3983,
      "clauses": [
        {
          "index": 0,
          "text": "あなたといて、",
          "start_ms": 198119,
          "end_ms": 199846,
          "duration_ms": 1727
        },
        {
          "index": 1,
          "text": "うれしかったです。",
          "start_ms": 200096,
          "end_ms": 202102,
          "duration_ms": 2006
        }
      ]
    },
    {
      "index": 51,
      "text": "ありがとう。",
      "start_ms": 202602,
      "end_ms": 204236,
      "duration_ms": 1634,
      "clauses": [
        {
          "index": 0,
          "text": "ありがとう。",
          "start_ms": 202602,
          "end_ms": 204236,
          "duration_ms": 1634
        }
      ]
    },
    {
      "index": 52,
      "text": "もう、かなしまないでください」。",
      "start_ms": 204736,
      "end_ms": 208196,
      "duration_ms": 3460,
      "clauses": [
        {
          "index": 0,
          "text": "もう、",
          "start_ms": 204736,
          "end_ms": 205569,
          "duration_ms": 833
        },
        {
          "index": 1,
          "text": "かなしまないでください」。",
          "start_ms": 205819,
          "end_ms": 208196,
          "duration_ms": 2377
        }
      ]
    },
    {
      "index": 53,
      "text": "みっつめのてがみはおくさんへのてがみです。",
      "start_ms": 208696,
      "end_ms": 212849,
      "duration_ms": 4153,
      "clauses": [
        {
          "index": 0,
          "text": "みっつめのてがみはおくさんへのてがみです。",
          "start_ms": 208696,
          "end_ms": 212849,
          "duration_ms": 4153
        }
      ]
    },
    {
      "index": 54,
      "text": "「おくさん。",
      "start_ms": 213349,
      "end_ms": 214635,
      "duration_ms": 1286,
      "clauses": [
        {
          "index": 0,
          "text": "「おくさん。",
          "start_ms": 213349,
          "end_ms": 214635,
          "duration_ms": 1286
        }
      ]
    },
    {
      "index": 55,
      "text": "あなたはわたしの、いいともだちです。",
      "start_ms": 215135,
      "end_ms": 219547,
      "duration_ms": 4412,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはわたしの、",
          "start_ms": 215135,
          "end_ms": 217257,
          "duration_ms": 2122
        },
        {
          "index": 1,
          "text": "いいともだちです。",
          "start_ms": 217507,
          "end_ms": 219547,
          "duration_ms": 2040
        }
      ]
    },
    {
      "index": 56,
      "text": "あのよる、わたしのへやへきました。",
      "start_ms": 220047,
      "end_ms": 224320,
      "duration_ms": 4273,
      "clauses": [
        {
          "index": 0,
          "text": "あのよる、",
          "start_ms": 220047,
          "end_ms": 221577,
          "duration_ms": 1530
        },
        {
          "index": 1,
          "text": "わたしのへやへきました。",
          "start_ms": 221827,
          "end_ms": 224320,
          "duration_ms": 2493
        }
      ]
    },
    {
      "index": 57,
      "text": "そして、「にげてください」といいました。",
      "start_ms": 224820,
      "end_ms": 229058,
      "duration_ms": 4238,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 224820,
          "end_ms": 226152,
          "duration_ms": 1332
        },
        {
          "index": 1,
          "text": "「にげてください」といいました。",
          "start_ms": 226402,
          "end_ms": 229058,
          "duration_ms": 2656
        }
      ]
    },
    {
      "index": 58,
      "text": "あなたがなければ、わたしはもう、しんでいました。",
      "start_ms": 229558,
      "end_ms": 235797,
      "duration_ms": 6239,
      "clauses": [
        {
          "index": 0,
          "text": "あなたがなければ、",
          "start_ms": 229558,
          "end_ms": 231645,
          "duration_ms": 2087
        },
        {
          "index": 1,
          "text": "わたしはもう、",
          "start_ms": 231895,
          "end_ms": 233634,
          "duration_ms": 1739
        },
        {
          "index": 2,
          "text": "しんでいました。",
          "start_ms": 233884,
          "end_ms": 235797,
          "duration_ms": 1913
        }
      ]
    },
    {
      "index": 59,
      "text": "でももう、こうして、しにます。",
      "start_ms": 236297,
      "end_ms": 241153,
      "duration_ms": 4856,
      "clauses": [
        {
          "index": 0,
          "text": "でももう、",
          "start_ms": 236297,
          "end_ms": 237652,
          "duration_ms": 1355
        },
        {
          "index": 1,
          "text": "こうして、",
          "start_ms": 237902,
          "end_ms": 239292,
          "duration_ms": 1390
        },
        {
          "index": 2,
          "text": "しにます。",
          "start_ms": 239542,
          "end_ms": 241153,
          "duration_ms": 1611
        }
      ]
    },
    {
      "index": 60,
