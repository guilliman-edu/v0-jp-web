      "end_ms": 261176,
      "duration_ms": 3248,
      "clauses": [
        {
          "index": 0,
          "text": "カツノはわるいおんなのひとですか。",
          "start_ms": 257928,
          "end_ms": 261176,
          "duration_ms": 3248
        }
      ]
    },
    {
      "index": 65,
      "text": "でももう、おわりです。",
      "start_ms": 261676,
      "end_ms": 264927,
      "duration_ms": 3251,
      "clauses": [
        {
          "index": 0,
          "text": "でももう、",
          "start_ms": 261676,
          "end_ms": 263008,
          "duration_ms": 1332
        },
        {
          "index": 1,
