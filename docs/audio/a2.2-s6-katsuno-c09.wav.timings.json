          "index": 2,
          "text": "かなしまないでください」。",
          "start_ms": 272261,
          "end_ms": 274684,
          "duration_ms": 2423
        }
      ]
    },
    {
      "index": 68,
      "text": "カツノのてがみはよっつ、ありました。",
      "start_ms": 275184,
      "end_ms": 279631,
      "duration_ms": 4447,
      "clauses": [
