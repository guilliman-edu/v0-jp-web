      "duration_ms": 4664,
      "clauses": [
        {
          "index": 0,
          "text": "よっつめのてがみはむかしのとのさまへのてがみです。",
          "start_ms": 245880,
          "end_ms": 250544,
          "duration_ms": 4664
        }
      ]
    },
