      "text": "むかしからいろいろ、してもらいました。",
      "start_ms": 253074,
      "end_ms": 257428,
      "duration_ms": 4354,
      "clauses": [
        {
          "index": 0,
          "text": "むかしからいろいろ、",
          "start_ms": 253074,
          "end_ms": 255161,
          "duration_ms": 2087
