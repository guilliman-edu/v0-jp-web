          "duration_ms": 2783
        }
      ]
    },
    {
      "index": 1,
      "text": "こめを作る仕事は、一人では終わりません。",
      "start_ms": 3283,
      "end_ms": 8369,
      "duration_ms": 5086,
      "clauses": [
        {
          "index": 0,
          "text": "こめを作る仕事は、",
          "start_ms": 3283,
          "end_ms": 5614,
          "duration_ms": 2331
        },
        {
          "index": 1,
          "text": "一人では終わりません。",
          "start_ms": 5864,
          "end_ms": 8369,
          "duration_ms": 2505
        }
      ]
    },
    {
      "index": 2,
      "text": "みんなでみずを集め、みんなで使います。",
      "start_ms": 8869,
      "end_ms": 13455,
      "duration_ms": 4586,
      "clauses": [
        {
          "index": 0,
          "text": "みんなでみずを集め、",
          "start_ms": 8869,
          "end_ms": 11107,
          "duration_ms": 2238
        },
        {
          "index": 1,
          "text": "みんなで使います。",
          "start_ms": 11357,
          "end_ms": 13455,
          "duration_ms": 2098
        }
      ]
    },
    {
      "index": 3,
      "text": "みずをまもるのも、こめをうえるのも、みんなの仕事です。",
      "start_ms": 13955,
      "end_ms": 20681,
      "duration_ms": 6726,
      "clauses": [
        {
          "index": 0,
          "text": "みずをまもるのも、",
          "start_ms": 13955,
          "end_ms": 16042,
          "duration_ms": 2087
        },
        {
          "index": 1,
          "text": "こめをうえるのも、",
          "start_ms": 16292,
          "end_ms": 18228,
          "duration_ms": 1936
        },
        {
          "index": 2,
          "text": "みんなの仕事です。",
          "start_ms": 18478,
          "end_ms": 20681,
          "duration_ms": 2203
        }
      ]
    },
    {
      "index": 4,
      "text": "そして、作ったこめをみんなで食べるのに、とてもいいたべものが「おにぎり」です。",
      "start_ms": 21181,
      "end_ms": 29381,
      "duration_ms": 8200,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 21181,
          "end_ms": 22536,
          "duration_ms": 1355
        },
        {
          "index": 1,
          "text": "作ったこめをみんなで食べるのに、",
          "start_ms": 22786,
          "end_ms": 26057,
          "duration_ms": 3271
        },
        {
          "index": 2,
          "text": "とてもいいたべものが「おにぎり」です。",
          "start_ms": 26307,
          "end_ms": 29381,
          "duration_ms": 3074
        }
      ]
    },
    {
      "index": 5,
      "text": "じしんのとき、にほんではよく「おにぎり」が出ます。",
      "start_ms": 29881,
      "end_ms": 35373,
      "duration_ms": 5492,
      "clauses": [
        {
          "index": 0,
          "text": "じしんのとき、",
          "start_ms": 29881,
          "end_ms": 31747,
          "duration_ms": 1866
        },
        {
          "index": 1,
          "text": "にほんではよく「おにぎり」が出ます。",
          "start_ms": 31997,
          "end_ms": 35373,
          "duration_ms": 3376
        }
      ]
    },
    {
      "index": 6,
      "text": "持ちやすく、作るのも楽で、食べるのに何も要りません。",
      "start_ms": 35873,
      "end_ms": 43040,
      "duration_ms": 7167,
      "clauses": [
        {
          "index": 0,
          "text": "持ちやすく、",
          "start_ms": 35873,
          "end_ms": 37600,
          "duration_ms": 1727
        },
        {
          "index": 1,
          "text": "作るのも楽で、",
          "start_ms": 37850,
          "end_ms": 39890,
          "duration_ms": 2040
        },
        {
          "index": 2,
          "text": "食べるのに何も要りません。",
          "start_ms": 40140,
          "end_ms": 43040,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 7,
      "text": "みんなにおにぎりを与えました。",
      "start_ms": 43540,
      "end_ms": 46440,
      "duration_ms": 2900,
      "clauses": [
        {
          "index": 0,
          "text": "みんなにおにぎりを与えました。",
          "start_ms": 43540,
          "end_ms": 46440,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 8,
      "text": "そのとき、人は人と人がつながることを知りました。",
      "start_ms": 46940,
      "end_ms": 53105,
      "duration_ms": 6165,
      "clauses": [
        {
