          "text": "みんなで使います。",
          "start_ms": 11137,
          "end_ms": 13247,
          "duration_ms": 2110
        }
      ]
    },
    {
      "index": 3,
      "text": "みずをまもるのも、こめをうえるのも、みんなの仕事です。",
      "start_ms": 13747,
      "end_ms": 20519,
      "duration_ms": 6772,
      "clauses": [
        {
          "index": 0,
          "text": "みずをまもるのも、",
          "start_ms": 13747,
          "end_ms": 15834,
          "duration_ms": 2087
        },
        {
          "index": 1,
          "text": "こめをうえるのも、",
          "start_ms": 16084,
          "end_ms": 18101,
          "duration_ms": 2017
        },
        {
          "index": 2,
          "text": "みんなの仕事です。",
          "start_ms": 18351,
          "end_ms": 20519,
          "duration_ms": 2168
        }
      ]
    },
    {
      "index": 4,
      "text": "そして、作ったこめをみんなで食べるのに、とてもいいたべものが「おにぎり」です。",
      "start_ms": 21019,
      "end_ms": 29289,
      "duration_ms": 8270,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 21019,
          "end_ms": 22386,
          "duration_ms": 1367
        },
        {
          "index": 1,
          "text": "作ったこめをみんなで食べるのに、",
          "start_ms": 22636,
          "end_ms": 25919,
          "duration_ms": 3283
        },
        {
          "index": 2,
          "text": "とてもいいたべものが「おにぎり」です。",
          "start_ms": 26169,
          "end_ms": 29289,
          "duration_ms": 3120
        }
      ]
    },
    {
      "index": 5,
      "text": "じしんのとき、にほんではよく「おにぎり」が出ます。",
      "start_ms": 29789,
      "end_ms": 35246,
      "duration_ms": 5457,
      "clauses": [
        {
