          "end_ms": 8172,
          "duration_ms": 2493
        }
      ]
    },
    {
      "index": 2,
      "text": "みんなでみずを集め、みんなで使います。",
      "start_ms": 8672,
      "end_ms": 13247,
      "duration_ms": 4575,
      "clauses": [
        {
          "index": 0,
          "text": "みんなでみずを集め、",
