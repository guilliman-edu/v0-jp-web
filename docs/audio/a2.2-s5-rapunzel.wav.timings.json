          "start_ms": 223398,
          "end_ms": 226472,
          "duration_ms": 3074
        }
      ]
    },
    {
      "index": 48,
      "text": "「ラプンツェル、かみを下ろしてください」と言いました。",
      "start_ms": 226972,
      "end_ms": 232301,
      "duration_ms": 5329,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 226972,
          "end_ms": 228722,
          "duration_ms": 1750
        },
        {
          "index": 1,
          "text": "かみを下ろしてください」と言いました。",
          "start_ms": 228972,
          "end_ms": 232301,
          "duration_ms": 3329
        }
      ]
    },
    {
      "index": 49,
      "text": "ラプンツェルはとてもながいかみをしていました。",
      "start_ms": 232801,
      "end_ms": 237012,
      "duration_ms": 4211,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはとてもながいかみをしていました。",
          "start_ms": 232801,
          "end_ms": 237012,
          "duration_ms": 4211
        }
      ]
    },
    {
      "index": 50,
      "text": "ラプンツェルはまどからかみを下ろしました。",
      "start_ms": 237512,
      "end_ms": 241631,
      "duration_ms": 4119,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはまどからかみを下ろしました。",
          "start_ms": 237512,
          "end_ms": 241631,
          "duration_ms": 4119
        }
      ]
    },
    {
      "index": 51,
      "text": "むじょはそのかみを持って、上に登りました。",
      "start_ms": 242131,
      "end_ms": 247216,
      "duration_ms": 5085,
      "clauses": [
        {
          "index": 0,
          "text": "むじょはそのかみを持って、",
          "start_ms": 242131,
          "end_ms": 244798,
          "duration_ms": 2667
        },
        {
          "index": 1,
          "text": "上に登りました。",
          "start_ms": 245048,
          "end_ms": 247216,
          "duration_ms": 2168
        }
      ]
    },
    {
      "index": 52,
      "text": "時間がたちました。",
      "start_ms": 247716,
      "end_ms": 249931,
      "duration_ms": 2215,
      "clauses": [
        {
          "index": 0,
          "text": "時間がたちました。",
          "start_ms": 247716,
          "end_ms": 249931,
          "duration_ms": 2215
        }
      ]
    },
    {
      "index": 53,
      "text": "ある日のゆうがた、おうじがやまの近くを歩いていました。",
      "start_ms": 250431,
      "end_ms": 256398,
      "duration_ms": 5967,
      "clauses": [
        {
          "index": 0,
          "text": "ある日のゆうがた、",
          "start_ms": 250431,
          "end_ms": 252564,
          "duration_ms": 2133
        },
        {
          "index": 1,
          "text": "おうじがやまの近くを歩いていました。",
          "start_ms": 252814,
          "end_ms": 256398,
          "duration_ms": 3584
        }
      ]
    },
    {
      "index": 54,
      "text": "そのとき、とうからすてきなうたが聞こえました。",
      "start_ms": 256898,
      "end_ms": 262076,
      "duration_ms": 5178,
      "clauses": [
        {
          "index": 0,
          "text": "そのとき、",
          "start_ms": 256898,
          "end_ms": 258567,
          "duration_ms": 1669
        },
        {
          "index": 1,
          "text": "とうからすてきなうたが聞こえました。",
          "start_ms": 258817,
          "end_ms": 262076,
          "duration_ms": 3259
        }
      ]
    },
    {
      "index": 55,
      "text": "おうじは立って、うたを聞きました。",
      "start_ms": 262576,
      "end_ms": 266710,
      "duration_ms": 4134,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは立って、",
          "start_ms": 262576,
          "end_ms": 264396,
          "duration_ms": 1820
        },
        {
          "index": 1,
          "text": "うたを聞きました。",
          "start_ms": 264646,
          "end_ms": 266710,
          "duration_ms": 2064
        }
      ]
    },
    {
      "index": 56,
      "text": "それはラプンツェルのうたでした。",
      "start_ms": 267210,
      "end_ms": 270400,
      "duration_ms": 3190,
      "clauses": [
        {
          "index": 0,
          "text": "それはラプンツェルのうたでした。",
          "start_ms": 267210,
          "end_ms": 270400,
          "duration_ms": 3190
        }
      ]
    },
    {
      "index": 57,
      "text": "ラプンツェルは一人でした。",
      "start_ms": 270900,
      "end_ms": 273591,
      "duration_ms": 2691,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルは一人でした。",
          "start_ms": 270900,
          "end_ms": 273591,
          "duration_ms": 2691
        }
      ]
    },
    {
      "index": 58,
      "text": "毎日、一人でうたをうたっていました。",
      "start_ms": 274091,
      "end_ms": 279072,
      "duration_ms": 4981,
      "clauses": [
        {
          "index": 0,
          "text": "毎日、",
          "start_ms": 274091,
          "end_ms": 275853,
          "duration_ms": 1762
        },
        {
          "index": 1,
          "text": "一人でうたをうたっていました。",
          "start_ms": 276103,
          "end_ms": 279072,
          "duration_ms": 2969
        }
      ]
    },
    {
      "index": 59,
      "text": "おうじはまいばん、やまへ行って、うたを聞きました。",
      "start_ms": 279572,
      "end_ms": 285845,
      "duration_ms": 6273,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはまいばん、",
          "start_ms": 279572,
          "end_ms": 281566,
          "duration_ms": 1994
        },
        {
          "index": 1,
          "text": "やまへ行って、",
          "start_ms": 281816,
          "end_ms": 283508,
          "duration_ms": 1692
        },
        {
          "index": 2,
          "text": "うたを聞きました。",
          "start_ms": 283758,
          "end_ms": 285845,
          "duration_ms": 2087
        }
      ]
    },
    {
      "index": 60,
      "text": "とうの下を探しましたが、上に行くみちはありませんでした。",
      "start_ms": 286345,
      "end_ms": 292290,
      "duration_ms": 5945,
      "clauses": [
        {
          "index": 0,
          "text": "とうの下を探しましたが、",
          "start_ms": 286345,
          "end_ms": 289024,
          "duration_ms": 2679
        },
        {
          "index": 1,
          "text": "上に行くみちはありませんでした。",
          "start_ms": 289274,
          "end_ms": 292290,
          "duration_ms": 3016
        }
      ]
    },
    {
      "index": 61,
      "text": "あるよる、おうじはやまで待っていました。",
      "start_ms": 292790,
      "end_ms": 297341,
      "duration_ms": 4551,
      "clauses": [
        {
          "index": 0,
          "text": "あるよる、",
          "start_ms": 292790,
          "end_ms": 294238,
          "duration_ms": 1448
        },
        {
          "index": 1,
          "text": "おうじはやまで待っていました。",
          "start_ms": 294488,
          "end_ms": 297341,
          "duration_ms": 2853
        }
      ]
    },
    {
      "index": 62,
      "text": "むじょが来て、「ラプンツェル、かみを下ろしてください」と言いました。",
      "start_ms": 297841,
      "end_ms": 305113,
      "duration_ms": 7272,
      "clauses": [
        {
          "index": 0,
          "text": "むじょが来て、",
          "start_ms": 297841,
          "end_ms": 299487,
          "duration_ms": 1646
        },
        {
          "index": 1,
          "text": "「ラプンツェル、",
          "start_ms": 299737,
          "end_ms": 301476,
          "duration_ms": 1739
        },
        {
          "index": 2,
          "text": "かみを下ろしてください」と言いました。",
          "start_ms": 301726,
          "end_ms": 305113,
          "duration_ms": 3387
        }
      ]
    },
    {
      "index": 63,
      "text": "そして、ラプンツェルはまどからかみを下ろしました。",
      "start_ms": 305613,
      "end_ms": 311279,
      "duration_ms": 5666,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 305613,
          "end_ms": 306980,
          "duration_ms": 1367
        },
        {
          "index": 1,
          "text": "ラプンツェルはまどからかみを下ろしました。",
          "start_ms": 307230,
          "end_ms": 311279,
          "duration_ms": 4049
        }
      ]
    },
    {
      "index": 64,
      "text": "むじょはそのかみを持って、上に登りました。",
      "start_ms": 311779,
      "end_ms": 316841,
      "duration_ms": 5062,
      "clauses": [
        {
          "index": 0,
          "text": "むじょはそのかみを持って、",
          "start_ms": 311779,
          "end_ms": 314411,
          "duration_ms": 2632
        },
        {
          "index": 1,
          "text": "上に登りました。",
          "start_ms": 314661,
          "end_ms": 316841,
          "duration_ms": 2180
        }
      ]
    },
    {
      "index": 65,
      "text": "おうじは「僕もあのかみで上に登りたい」と思いました。",
      "start_ms": 317341,
      "end_ms": 322388,
      "duration_ms": 5047,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは「僕もあのかみで上に登りたい」と思いました。",
          "start_ms": 317341,
          "end_ms": 322388,
          "duration_ms": 5047
        }
      ]
    },
    {
      "index": 66,
      "text": "次の日、よるになったとき、おうじはとうの下に行きました。",
      "start_ms": 322888,
      "end_ms": 330462,
      "duration_ms": 7574,
      "clauses": [
        {
          "index": 0,
          "text": "次の日、",
          "start_ms": 322888,
          "end_ms": 324627,
          "duration_ms": 1739
        },
        {
          "index": 1,
          "text": "よるになったとき、",
          "start_ms": 324877,
          "end_ms": 326999,
          "duration_ms": 2122
        },
        {
          "index": 2,
          "text": "おうじはとうの下に行きました。",
          "start_ms": 327249,
          "end_ms": 330462,
          "duration_ms": 3213
        }
      ]
    },
    {
      "index": 67,
      "text": "「ラプンツェル、かみを下ろしてください」と言いました。",
      "start_ms": 330962,
      "end_ms": 336233,
      "duration_ms": 5271,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 330962,
          "end_ms": 332689,
          "duration_ms": 1727
        },
        {
          "index": 1,
          "text": "かみを下ろしてください」と言いました。",
          "start_ms": 332939,
          "end_ms": 336233,
          "duration_ms": 3294
        }
      ]
    },
    {
      "index": 68,
      "text": "かみを下ろしたので、おうじは上に登りました。",
      "start_ms": 336733,
      "end_ms": 342317,
      "duration_ms": 5584,
      "clauses": [
        {
          "index": 0,
          "text": "かみを下ろしたので、",
          "start_ms": 336733,
          "end_ms": 339017,
          "duration_ms": 2284
        },
        {
          "index": 1,
          "text": "おうじは上に登りました。",
          "start_ms": 339267,
          "end_ms": 342317,
          "duration_ms": 3050
        }
      ]
    },
    {
      "index": 69,
      "text": "ラプンツェルは初めて人が来たので、とても怖がりました。",
      "start_ms": 342817,
      "end_ms": 349191,
      "duration_ms": 6374,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルは初めて人が来たので、",
          "start_ms": 342817,
          "end_ms": 346518,
          "duration_ms": 3701
        },
        {
          "index": 1,
          "text": "とても怖がりました。",
          "start_ms": 346768,
          "end_ms": 349191,
          "duration_ms": 2423
        }
      ]
    },
    {
      "index": 70,
      "text": "でも、おうじはとても若くて、かっこいい人でした。",
      "start_ms": 349691,
      "end_ms": 355836,
      "duration_ms": 6145,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 349691,
          "end_ms": 350675,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "おうじはとても若くて、",
          "start_ms": 350925,
          "end_ms": 353453,
          "duration_ms": 2528
        },
        {
          "index": 2,
          "text": "かっこいい人でした。",
          "start_ms": 353703,
          "end_ms": 355836,
          "duration_ms": 2133
        }
      ]
    },
    {
      "index": 71,
      "text": "二人はよく話しました。",
      "start_ms": 356336,
      "end_ms": 359363,
      "duration_ms": 3027,
      "clauses": [
        {
          "index": 0,
          "text": "二人はよく話しました。",
          "start_ms": 356336,
          "end_ms": 359363,
          "duration_ms": 3027
        }
      ]
    },
    {
      "index": 72,
      "text": "ラプンツェルは怖くなくなりました。",
      "start_ms": 359863,
      "end_ms": 363378,
      "duration_ms": 3515,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルは怖くなくなりました。",
          "start_ms": 359863,
          "end_ms": 363378,
          "duration_ms": 3515
        }
      ]
    },
    {
      "index": 73,
      "text": "おうじは「僕と一緒に住んでください」と言いました。",
      "start_ms": 363878,
      "end_ms": 368473,
      "duration_ms": 4595,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは「僕と一緒に住んでください」と言いました。",
          "start_ms": 363878,
          "end_ms": 368473,
          "duration_ms": 4595
        }
      ]
    },
    {
      "index": 74,
      "text": "ラプンツェルは「はい。",
      "start_ms": 368973,
      "end_ms": 371095,
      "duration_ms": 2122,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルは「はい。",
          "start_ms": 368973,
          "end_ms": 371095,
          "duration_ms": 2122
        }
      ]
    },
    {
      "index": 75,
      "text": "でも、とうをでることができません」と言いました。",
      "start_ms": 371595,
      "end_ms": 376181,
      "duration_ms": 4586,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 371595,
          "end_ms": 372602,
          "duration_ms": 1007
        },
        {
          "index": 1,
          "text": "とうをでることができません」と言いました。",
          "start_ms": 372852,
          "end_ms": 376181,
          "duration_ms": 3329
        }
      ]
    },
    {
      "index": 76,
      "text": "おうじは「まいばん、僕がとうに登ります。",
      "start_ms": 376681,
      "end_ms": 381476,
      "duration_ms": 4795,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは「まいばん、",
          "start_ms": 376681,
          "end_ms": 378721,
          "duration_ms": 2040
        },
        {
          "index": 1,
          "text": "僕がとうに登ります。",
          "start_ms": 378971,
          "end_ms": 381476,
          "duration_ms": 2505
        }
      ]
    },
    {
      "index": 77,
      "text": "むじょは朝に来るから、よるに会いましょう」と言いました。",
      "start_ms": 381976,
      "end_ms": 387607,
      "duration_ms": 5631,
      "clauses": [
        {
          "index": 0,
          "text": "むじょは朝に来るから、",
          "start_ms": 381976,
          "end_ms": 384434,
          "duration_ms": 2458
        },
        {
          "index": 1,
          "text": "よるに会いましょう」と言いました。",
          "start_ms": 384684,
          "end_ms": 387607,
          "duration_ms": 2923
        }
      ]
    },
    {
      "index": 78,
      "text": "それから、おうじはまいばんラプンツェルに会いました。",
      "start_ms": 388107,
      "end_ms": 393575,
      "duration_ms": 5468,
      "clauses": [
        {
          "index": 0,
          "text": "それから、",
          "start_ms": 388107,
          "end_ms": 389613,
          "duration_ms": 1506
        },
        {
          "index": 1,
          "text": "おうじはまいばんラプンツェルに会いました。",
          "start_ms": 389863,
          "end_ms": 393575,
          "duration_ms": 3712
        }
      ]
    },
    {
      "index": 79,
      "text": "むじょは何も気がつきませんでした。",
      "start_ms": 394075,
      "end_ms": 397276,
      "duration_ms": 3201,
      "clauses": [
        {
          "index": 0,
          "text": "むじょは何も気がつきませんでした。",
          "start_ms": 394075,
          "end_ms": 397276,
          "duration_ms": 3201
        }
      ]
    },
    {
      "index": 80,
      "text": "ある日、ラプンツェルはむじょに言いました。",
      "start_ms": 397776,
      "end_ms": 402733,
      "duration_ms": 4957,
      "clauses": [
        {
          "index": 0,
          "text": "ある日、",
          "start_ms": 397776,
          "end_ms": 399398,
          "duration_ms": 1622
        },
        {
          "index": 1,
          "text": "ラプンツェルはむじょに言いました。",
          "start_ms": 399648,
          "end_ms": 402733,
          "duration_ms": 3085
        }
      ]
    },
    {
      "index": 81,
      "text": "「おばさん、あなたはおもいです。",
      "start_ms": 403233,
      "end_ms": 407006,
      "duration_ms": 3773,
      "clauses": [
        {
          "index": 0,
          "text": "「おばさん、",
          "start_ms": 403233,
          "end_ms": 404495,
          "duration_ms": 1262
        },
        {
          "index": 1,
          "text": "あなたはおもいです。",
          "start_ms": 404745,
          "end_ms": 407006,
          "duration_ms": 2261
        }
      ]
    },
    {
      "index": 82,
      "text": "だから、上にのぼるとき、かみがすごく重かったです」。",
      "start_ms": 407506,
      "end_ms": 414046,
      "duration_ms": 6540,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 407506,
          "end_ms": 408664,
          "duration_ms": 1158
        },
        {
          "index": 1,
          "text": "上にのぼるとき、",
          "start_ms": 408914,
          "end_ms": 411036,
          "duration_ms": 2122
        },
        {
          "index": 2,
          "text": "かみがすごく重かったです」。",
          "start_ms": 411286,
          "end_ms": 414046,
          "duration_ms": 2760
        }
      ]
    },
    {
      "index": 83,
      "text": "むじょは「あなたはおうじと話したのでしょう。",
      "start_ms": 414546,
      "end_ms": 418490,
      "duration_ms": 3944,
      "clauses": [
        {
          "index": 0,
          "text": "むじょは「あなたはおうじと話したのでしょう。",
          "start_ms": 414546,
          "end_ms": 418490,
          "duration_ms": 3944
        }
      ]
    },
    {
      "index": 84,
      "text": "悪い子ですね」と怒りました。",
      "start_ms": 418990,
      "end_ms": 421890,
      "duration_ms": 2900,
      "clauses": [
        {
          "index": 0,
          "text": "悪い子ですね」と怒りました。",
          "start_ms": 418990,
          "end_ms": 421890,
          "duration_ms": 2900
        }
      ]
    },
    {
      "index": 85,
      "text": "むじょはラプンツェルのながいかみを切りました。",
      "start_ms": 422390,
      "end_ms": 426183,
      "duration_ms": 3793,
      "clauses": [
        {
          "index": 0,
          "text": "むじょはラプンツェルのながいかみを切りました。",
          "start_ms": 422390,
          "end_ms": 426183,
          "duration_ms": 3793
        }
      ]
    },
    {
      "index": 86,
      "text": "そして、ラプンツェルをとおいやまに連れて行きました。",
      "start_ms": 426683,
      "end_ms": 431954,
      "duration_ms": 5271,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 426683,
          "end_ms": 428073,
          "duration_ms": 1390
        },
        {
          "index": 1,
          "text": "ラプンツェルをとおいやまに連れて行きました。",
          "start_ms": 428323,
          "end_ms": 431954,
          "duration_ms": 3631
        }
      ]
    },
    {
      "index": 87,
      "text": "ラプンツェルはそこで一人で生活しました。",
      "start_ms": 432454,
      "end_ms": 436526,
      "duration_ms": 4072,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはそこで一人で生活しました。",
          "start_ms": 432454,
          "end_ms": 436526,
          "duration_ms": 4072
        }
      ]
    },
    {
      "index": 88,
      "text": "すごく悲しかったです。",
      "start_ms": 437026,
      "end_ms": 439449,
      "duration_ms": 2423,
      "clauses": [
        {
          "index": 0,
          "text": "すごく悲しかったです。",
          "start_ms": 437026,
          "end_ms": 439449,
          "duration_ms": 2423
        }
      ]
    },
    {
      "index": 89,
      "text": "その日、むじょは切ったかみをまどの側に置きました。",
      "start_ms": 439949,
      "end_ms": 445581,
      "duration_ms": 5632,
      "clauses": [
        {
          "index": 0,
          "text": "その日、",
          "start_ms": 439949,
          "end_ms": 441479,
          "duration_ms": 1530
        },
        {
          "index": 1,
          "text": "むじょは切ったかみをまどの側に置きました。",
          "start_ms": 441729,
          "end_ms": 445581,
          "duration_ms": 3852
        }
      ]
    },
    {
      "index": 90,
      "text": "よる、おうじが来ました。",
      "start_ms": 446081,
      "end_ms": 449240,
      "duration_ms": 3159,
      "clauses": [
        {
          "index": 0,
          "text": "よる、",
          "start_ms": 446081,
          "end_ms": 446984,
          "duration_ms": 903
        },
        {
          "index": 1,
          "text": "おうじが来ました。",
          "start_ms": 447234,
          "end_ms": 449240,
          "duration_ms": 2006
        }
      ]
    },
    {
      "index": 91,
      "text": "「ラプンツェル、かみを下ろしてください」と言いました。",
      "start_ms": 449740,
      "end_ms": 454988,
      "duration_ms": 5248,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 449740,
          "end_ms": 451444,
          "duration_ms": 1704
        },
        {
          "index": 1,
          "text": "かみを下ろしてください」と言いました。",
          "start_ms": 451694,
          "end_ms": 454988,
          "duration_ms": 3294
        }
      ]
    },
    {
      "index": 92,
      "text": "かみを下ろしたので、おうじは上に登りました。",
      "start_ms": 455488,
      "end_ms": 461073,
      "duration_ms": 5585,
      "clauses": [
        {
          "index": 0,
          "text": "かみを下ろしたので、",
          "start_ms": 455488,
          "end_ms": 457749,
          "duration_ms": 2261
        },
        {
          "index": 1,
          "text": "おうじは上に登りました。",
          "start_ms": 457999,
          "end_ms": 461073,
          "duration_ms": 3074
        }
      ]
    },
    {
      "index": 93,
      "text": "でも、そこにはむじょがいました。",
      "start_ms": 461573,
      "end_ms": 465625,
      "duration_ms": 4052,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 461573,
          "end_ms": 462568,
          "duration_ms": 995
        },
        {
          "index": 1,
          "text": "そこにはむじょがいました。",
          "start_ms": 462818,
          "end_ms": 465625,
          "duration_ms": 2807
        }
      ]
    },
    {
      "index": 94,
      "text": "「もうラプンツェルはここにいません。",
      "start_ms": 466125,
      "end_ms": 469233,
      "duration_ms": 3108,
      "clauses": [
        {
          "index": 0,
          "text": "「もうラプンツェルはここにいません。",
          "start_ms": 466125,
          "end_ms": 469233,
          "duration_ms": 3108
        }
      ]
    },
    {
      "index": 95,
      "text": "あなたはもうラプンツェルに会いません」と言いました。",
      "start_ms": 469733,
      "end_ms": 473793,
      "duration_ms": 4060,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうラプンツェルに会いません」と言いました。",
          "start_ms": 469733,
          "end_ms": 473793,
          "duration_ms": 4060
        }
      ]
    },
    {
      "index": 96,
      "text": "おうじはすごく悲しくて、とうの上から落ちました。",
      "start_ms": 474293,
      "end_ms": 479854,
      "duration_ms": 5561,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはすごく悲しくて、",
          "start_ms": 474293,
          "end_ms": 476995,
          "duration_ms": 2702
        },
        {
          "index": 1,
          "text": "とうの上から落ちました。",
          "start_ms": 477245,
          "end_ms": 479854,
          "duration_ms": 2609
        }
      ]
    },
    {
      "index": 97,
      "text": "おうじは助かりました。",
      "start_ms": 480354,
      "end_ms": 482917,
      "duration_ms": 2563,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは助かりました。",
          "start_ms": 480354,
          "end_ms": 482917,
          "duration_ms": 2563
        }
      ]
    },
    {
      "index": 98,
      "text": "でも、おうじのめは、もう何も見ることができなくなりました。",
      "start_ms": 483417,
      "end_ms": 490223,
      "duration_ms": 6806,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 483417,
          "end_ms": 484412,
          "duration_ms": 995
        },
        {
          "index": 1,
          "text": "おうじのめは、",
          "start_ms": 484662,
          "end_ms": 486435,
          "duration_ms": 1773
        },
        {
          "index": 2,
          "text": "もう何も見ることができなくなりました。",
          "start_ms": 486685,
          "end_ms": 490223,
          "duration_ms": 3538
        }
      ]
    },
    {
      "index": 99,
      "text": "おうじは毎日、やまの中を歩きました。",
      "start_ms": 490723,
      "end_ms": 495970,
      "duration_ms": 5247,
      "clauses": [
        {
          "index": 0,
          "text": "おうじは毎日、",
          "start_ms": 490723,
          "end_ms": 492879,
          "duration_ms": 2156
        },
        {
          "index": 1,
          "text": "やまの中を歩きました。",
          "start_ms": 493129,
          "end_ms": 495970,
          "duration_ms": 2841
        }
      ]
    },
    {
      "index": 100,
      "text": "ラプンツェルのことを、いつもおもいでしていました。",
      "start_ms": 496470,
      "end_ms": 501579,
      "duration_ms": 5109,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルのことを、",
          "start_ms": 496470,
          "end_ms": 498685,
          "duration_ms": 2215
        },
        {
          "index": 1,
          "text": "いつもおもいでしていました。",
          "start_ms": 498935,
          "end_ms": 501579,
          "duration_ms": 2644
        }
      ]
    },
    {
      "index": 101,
      "text": "ながい時間がたちました。",
      "start_ms": 502079,
      "end_ms": 504735,
      "duration_ms": 2656,
      "clauses": [
        {
          "index": 0,
          "text": "ながい時間がたちました。",
          "start_ms": 502079,
          "end_ms": 504735,
          "duration_ms": 2656
        }
      ]
    },
    {
      "index": 102,
      "text": "ある日、おうじはとおいやまでうたが聞こえました。",
      "start_ms": 505235,
      "end_ms": 510668,
      "duration_ms": 5433,
      "clauses": [
        {
          "index": 0,
          "text": "ある日、",
          "start_ms": 505235,
          "end_ms": 506799,
          "duration_ms": 1564
        },
        {
          "index": 1,
          "text": "おうじはとおいやまでうたが聞こえました。",
          "start_ms": 507049,
          "end_ms": 510668,
          "duration_ms": 3619
        }
      ]
    },
    {
      "index": 103,
      "text": "それはラプンツェルのうたでした。",
      "start_ms": 511168,
      "end_ms": 514381,
      "duration_ms": 3213,
      "clauses": [
        {
          "index": 0,
          "text": "それはラプンツェルのうたでした。",
          "start_ms": 511168,
          "end_ms": 514381,
          "duration_ms": 3213
        }
      ]
    },
    {
      "index": 104,
      "text": "おうじはうたのばしょに行きました。",
      "start_ms": 514881,
      "end_ms": 518291,
      "duration_ms": 3410,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはうたのばしょに行きました。",
          "start_ms": 514881,
          "end_ms": 518291,
          "duration_ms": 3410
        }
      ]
    },
    {
      "index": 105,
      "text": "ラプンツェルには、おとこのことおんなのこのあかちゃんがいました。",
      "start_ms": 518791,
      "end_ms": 524922,
      "duration_ms": 6131,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルには、",
          "start_ms": 518791,
          "end_ms": 520762,
          "duration_ms": 1971
        },
        {
          "index": 1,
          "text": "おとこのことおんなのこのあかちゃんがいました。",
          "start_ms": 521012,
          "end_ms": 524922,
          "duration_ms": 3910
        }
      ]
    },
    {
      "index": 106,
      "text": "ラプンツェルはおうじのなまえを言いました。",
      "start_ms": 525422,
      "end_ms": 529366,
      "duration_ms": 3944,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはおうじのなまえを言いました。",
          "start_ms": 525422,
          "end_ms": 529366,
          "duration_ms": 3944
        }
      ]
    },
    {
      "index": 107,
      "text": "ラプンツェルがおうじのかおに触ったとき、おうじのめはなおりました。",
      "start_ms": 529866,
      "end_ms": 536519,
      "duration_ms": 6653,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルがおうじのかおに触ったとき、",
          "start_ms": 529866,
          "end_ms": 533741,
          "duration_ms": 3875
        },
        {
          "index": 1,
          "text": "おうじのめはなおりました。",
          "start_ms": 533991,
          "end_ms": 536519,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 108,
      "text": "二人はすごく嬉しかったです。",
      "start_ms": 537019,
      "end_ms": 540151,
      "duration_ms": 3132,
      "clauses": [
        {
          "index": 0,
          "text": "二人はすごく嬉しかったです。",
          "start_ms": 537019,
          "end_ms": 540151,
          "duration_ms": 3132
        }
      ]
    },
    {
      "index": 109,
      "text": "二人はおうじのくにに帰りました。",
      "start_ms": 540651,
      "end_ms": 544201,
      "duration_ms": 3550,
      "clauses": [
        {
          "index": 0,
          "text": "二人はおうじのくにに帰りました。",
          "start_ms": 540651,
          "end_ms": 544201,
          "duration_ms": 3550
        }
      ]
    },
    {
      "index": 110,
      "text": "二人は仲よく、すごく楽しく住みました。",
      "start_ms": 544701,
      "end_ms": 549856,
      "duration_ms": 5155,
      "clauses": [
        {
          "index": 0,
          "text": "二人は仲よく、",
          "start_ms": 544701,
          "end_ms": 546811,
          "duration_ms": 2110
        },
        {
          "index": 1,
          "text": "すごく楽しく住みました。",
          "start_ms": 547061,
          "end_ms": 549856,
          "duration_ms": 2795
        }
      ]
    }
  ]
}