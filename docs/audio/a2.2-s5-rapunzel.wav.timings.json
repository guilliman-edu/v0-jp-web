          "duration_ms": 2505
        },
        {
          "index": 1,
          "text": "むじょはラプンツェルをたかいとうに入れました。",
          "start_ms": 215078,
          "end_ms": 218755,
          "duration_ms": 3677
        }
      ]
    },
