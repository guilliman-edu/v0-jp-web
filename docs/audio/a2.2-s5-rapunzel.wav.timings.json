      "start_ms": 400168,
      "end_ms": 403942,
      "duration_ms": 3774,
      "clauses": [
        {
          "index": 0,
          "text": "「おばさん、",
          "start_ms": 400168,
          "end_ms": 401419,
          "duration_ms": 1251
        },
        {
          "index": 1,
          "text": "あなたはおもいです。",
          "start_ms": 401669,
          "end_ms": 403942,
          "duration_ms": 2273
        }
      ]
    },
    {
      "index": 82,
      "text": "だから、うえにのぼるとき、かみがすごくおもかったです」。",
      "start_ms": 404442,
      "end_ms": 410936,
      "duration_ms": 6494,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 404442,
          "end_ms": 405600,
          "duration_ms": 1158
        },
        {
          "index": 1,
          "text": "うえにのぼるとき、",
          "start_ms": 405850,
          "end_ms": 407914,
          "duration_ms": 2064
        },
        {
          "index": 2,
          "text": "かみがすごくおもかったです」。",
          "start_ms": 408164,
          "end_ms": 410936,
          "duration_ms": 2772
        }
      ]
    },
    {
      "index": 83,
      "text": "まじょは「あなたはおうじとはなしたのでしょう。",
      "start_ms": 411436,
      "end_ms": 415485,
      "duration_ms": 4049,
      "clauses": [
        {
          "index": 0,
          "text": "まじょは「あなたはおうじとはなしたのでしょう。",
          "start_ms": 411436,
          "end_ms": 415485,
          "duration_ms": 4049
        }
      ]
    },
    {
      "index": 84,
      "text": "わるいこですね」とおこりました。",
      "start_ms": 415985,
      "end_ms": 418861,
      "duration_ms": 2876,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこですね」とおこりました。",
          "start_ms": 415985,
          "end_ms": 418861,
          "duration_ms": 2876
        }
      ]
    },
    {
      "index": 85,
      "text": "まじょはラプンツェルのながいかみをきりました。",
      "start_ms": 419361,
      "end_ms": 423224,
      "duration_ms": 3863,
      "clauses": [
        {
          "index": 0,
          "text": "まじょはラプンツェルのながいかみをきりました。",
          "start_ms": 419361,
          "end_ms": 423224,
          "duration_ms": 3863
        }
      ]
    },
    {
      "index": 86,
      "text": "そして、ラプンツェルをとおいやまにつれていきました。",
      "start_ms": 423724,
      "end_ms": 429042,
      "duration_ms": 5318,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 423724,
          "end_ms": 425068,
          "duration_ms": 1344
        },
        {
          "index": 1,
          "text": "ラプンツェルをとおいやまにつれていきました。",
          "start_ms": 425318,
          "end_ms": 429042,
          "duration_ms": 3724
        }
      ]
    },
    {
      "index": 87,
      "text": "ラプンツェルはそこでひとりでせいかつしました。",
      "start_ms": 429542,
      "end_ms": 433602,
      "duration_ms": 4060,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはそこでひとりでせいかつしました。",
          "start_ms": 429542,
          "end_ms": 433602,
          "duration_ms": 4060
        }
      ]
    },
    {
      "index": 88,
      "text": "すごくかなしかったです。",
      "start_ms": 434102,
      "end_ms": 436618,
      "duration_ms": 2516,
      "clauses": [
        {
          "index": 0,
          "text": "すごくかなしかったです。",
          "start_ms": 434102,
          "end_ms": 436618,
          "duration_ms": 2516
        }
      ]
    },
    {
      "index": 89,
      "text": "そのひ、まじょはきったかみをまどのそばにおくきました。",
      "start_ms": 437118,
      "end_ms": 442842,
      "duration_ms": 5724,
      "clauses": [
        {
          "index": 0,
          "text": "そのひ、",
          "start_ms": 437118,
          "end_ms": 438543,
          "duration_ms": 1425
        },
        {
          "index": 1,
          "text": "まじょはきったかみをまどのそばにおくきました。",
          "start_ms": 438793,
          "end_ms": 442842,
          "duration_ms": 4049
        }
      ]
    },
    {
      "index": 90,
      "text": "よる、おうじがきました。",
      "start_ms": 443342,
      "end_ms": 446605,
      "duration_ms": 3263,
      "clauses": [
        {
          "index": 0,
          "text": "よる、",
          "start_ms": 443342,
          "end_ms": 444291,
          "duration_ms": 949
        },
        {
          "index": 1,
          "text": "おうじがきました。",
          "start_ms": 444541,
          "end_ms": 446605,
          "duration_ms": 2064
        }
      ]
    },
    {
      "index": 91,
      "text": "「ラプンツェル、かみをおろしてください」といいました。",
      "start_ms": 447105,
      "end_ms": 452249,
      "duration_ms": 5144,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 447105,
          "end_ms": 448809,
          "duration_ms": 1704
        },
        {
          "index": 1,
          "text": "かみをおろしてください」といいました。",
          "start_ms": 449059,
          "end_ms": 452249,
          "duration_ms": 3190
        }
      ]
    },
    {
      "index": 92,
      "text": "かみをおろしたので、おうじはうえにのぼりました。",
      "start_ms": 452749,
      "end_ms": 458264,
      "duration_ms": 5515,
      "clauses": [
        {
          "index": 0,
          "text": "かみをおろしたので、",
          "start_ms": 452749,
          "end_ms": 454917,
          "duration_ms": 2168
        },
        {
          "index": 1,
          "text": "おうじはうえにのぼりました。",
          "start_ms": 455167,
          "end_ms": 458264,
          "duration_ms": 3097
        }
      ]
    },
    {
      "index": 93,
      "text": "でも、そこにはまじょがいました。",
      "start_ms": 458764,
      "end_ms": 462770,
      "duration_ms": 4006,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 458764,
          "end_ms": 459748,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "そこにはまじょがいました。",
          "start_ms": 459998,
          "end_ms": 462770,
          "duration_ms": 2772
        }
      ]
    },
    {
      "index": 94,
      "text": "「もうラプンツェルはここにいません。",
      "start_ms": 463270,
      "end_ms": 466378,
      "duration_ms": 3108,
      "clauses": [
        {
          "index": 0,
          "text": "「もうラプンツェルはここにいません。",
          "start_ms": 463270,
          "end_ms": 466378,
          "duration_ms": 3108
        }
      ]
    },
    {
      "index": 95,
      "text": "あなたはもうラプンツェルにあいません」といいました。",
      "start_ms": 466878,
      "end_ms": 470915,
      "duration_ms": 4037,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうラプンツェルにあいません」といいました。",
          "start_ms": 466878,
          "end_ms": 470915,
          "duration_ms": 4037
        }
      ]
    },
    {
      "index": 96,
      "text": "おうじはすごくかなしくて、とうのうえからおちました。",
      "start_ms": 471415,
      "end_ms": 476930,
      "duration_ms": 5515,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはすごくかなしくて、",
          "start_ms": 471415,
          "end_ms": 474129,
          "duration_ms": 2714
        },
        {
          "index": 1,
          "text": "とうのうえからおちました。",
          "start_ms": 474379,
          "end_ms": 476930,
          "duration_ms": 2551
        }
      ]
    },
    {
      "index": 97,
      "text": "おうじはたすかりました。",
      "start_ms": 477430,
      "end_ms": 480097,
      "duration_ms": 2667,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはたすかりました。",
          "start_ms": 477430,
          "end_ms": 480097,
          "duration_ms": 2667
        }
      ]
    },
    {
      "index": 98,
      "text": "でも、おうじのめは、もうなにもみることができなくなりました。",
      "start_ms": 480597,
      "end_ms": 487241,
      "duration_ms": 6644,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 480597,
          "end_ms": 481581,
          "duration_ms": 984
        },
        {
          "index": 1,
          "text": "おうじのめは、",
          "start_ms": 481831,
          "end_ms": 483523,
          "duration_ms": 1692
        },
        {
          "index": 2,
          "text": "もうなにもみることができなくなりました。",
          "start_ms": 483773,
          "end_ms": 487241,
          "duration_ms": 3468
        }
      ]
    },
    {
      "index": 99,
      "text": "おうじはまいにち、やまのなかをあるきました。",
      "start_ms": 487741,
      "end_ms": 493000,
      "duration_ms": 5259,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはまいにち、",
          "start_ms": 487741,
          "end_ms": 489897,
          "duration_ms": 2156
        },
        {
          "index": 1,
          "text": "やまのなかをあるきました。",
          "start_ms": 490147,
          "end_ms": 493000,
          "duration_ms": 2853
        }
      ]
    },
    {
      "index": 100,
      "text": "ラプンツェルのことを、いつもおもいでしていました。",
      "start_ms": 493500,
      "end_ms": 498574,
      "duration_ms": 5074,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルのことを、",
          "start_ms": 493500,
          "end_ms": 495773,
          "duration_ms": 2273
        },
        {
          "index": 1,
          "text": "いつもおもいでしていました。",
          "start_ms": 496023,
          "end_ms": 498574,
          "duration_ms": 2551
        }
      ]
    },
    {
      "index": 101,
      "text": "ながいじかんがたちました。",
      "start_ms": 499074,
      "end_ms": 501602,
      "duration_ms": 2528,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんがたちました。",
          "start_ms": 499074,
          "end_ms": 501602,
          "duration_ms": 2528
        }
      ]
    },
    {
      "index": 102,
      "text": "あるひ、おうじはとおいやまでうたがきこえました。",
      "start_ms": 502102,
      "end_ms": 507385,
      "duration_ms": 5283,
      "clauses": [
        {
          "index": 0,
          "text": "あるひ、",
          "start_ms": 502102,
          "end_ms": 503481,
          "duration_ms": 1379
        },
        {
          "index": 1,
          "text": "おうじはとおいやまでうたがきこえました。",
          "start_ms": 503731,
          "end_ms": 507385,
          "duration_ms": 3654
        }
      ]
    },
    {
      "index": 103,
      "text": "それはラプンツェルのうたでした。",
      "start_ms": 507885,
      "end_ms": 511063,
      "duration_ms": 3178,
      "clauses": [
        {
          "index": 0,
          "text": "それはラプンツェルのうたでした。",
          "start_ms": 507885,
          "end_ms": 511063,
          "duration_ms": 3178
        }
      ]
    },
    {
      "index": 104,
      "text": "おうじはうたのばしょにいきました。",
      "start_ms": 511563,
      "end_ms": 514973,
      "duration_ms": 3410,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはうたのばしょにいきました。",
          "start_ms": 511563,
          "end_ms": 514973,
          "duration_ms": 3410
        }
      ]
    },
    {
      "index": 105,
      "text": "ラプンツェルには、おとこのことおんなのこのあかちゃんがいました。",
      "start_ms": 515473,
      "end_ms": 521801,
      "duration_ms": 6328,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルには、",
          "start_ms": 515473,
          "end_ms": 517502,
          "duration_ms": 2029
        },
        {
          "index": 1,
          "text": "おとこのことおんなのこのあかちゃんがいました。",
          "start_ms": 517752,
          "end_ms": 521801,
          "duration_ms": 4049
        }
      ]
    },
    {
      "index": 106,
      "text": "ラプンツェルはおうじのなまえをいいました。",
      "start_ms": 522301,
      "end_ms": 526187,
      "duration_ms": 3886,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはおうじのなまえをいいました。",
          "start_ms": 522301,
          "end_ms": 526187,
          "duration_ms": 3886
        }
      ]
    },
    {
      "index": 107,
      "text": "ラプンツェルがおうじのかおにさわったとき、おうじのめはなおりました。",
      "start_ms": 526687,
      "end_ms": 533467,
      "duration_ms": 6780,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルがおうじのかおにさわったとき、",
          "start_ms": 526687,
          "end_ms": 530631,
          "duration_ms": 3944
        },
        {
          "index": 1,
          "text": "おうじのめはなおりました。",
          "start_ms": 530881,
          "end_ms": 533467,
          "duration_ms": 2586
        }
      ]
    },
    {
      "index": 108,
      "text": "ふたりはすごくうれしかったです。",
      "start_ms": 533967,
      "end_ms": 537099,
      "duration_ms": 3132,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはすごくうれしかったです。",
          "start_ms": 533967,
          "end_ms": 537099,
          "duration_ms": 3132
        }
      ]
    },
    {
      "index": 109,
      "text": "ふたりはおうじのくににかえりました。",
      "start_ms": 537599,
      "end_ms": 541160,
      "duration_ms": 3561,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはおうじのくににかえりました。",
          "start_ms": 537599,
          "end_ms": 541160,
          "duration_ms": 3561
        }
      ]
    },
    {
      "index": 110,
      "text": "ふたりはなかよく、すごくたのしくすみました。",
      "start_ms": 541660,
      "end_ms": 546896,
      "duration_ms": 5236,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなかよく、",
          "start_ms": 541660,
          "end_ms": 543863,
          "duration_ms": 2203
        },
        {
          "index": 1,
          "text": "すごくたのしくすみました。",
          "start_ms": 544113,
          "end_ms": 546896,
          "duration_ms": 2783
        }
      ]
    }
  ]
}