          "end_ms": 77259,
          "duration_ms": 3793
        }
      ]
    },
    {
      "index": 17,
      "text": "おんなは毎日そう思っていたので、気分がとても悪くなりました。",
      "start_ms": 77759,
      "end_ms": 84353,
      "duration_ms": 6594,
      "clauses": [
        {
