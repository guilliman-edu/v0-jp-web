          "end_ms": 208337,
          "duration_ms": 2888
        },
        {
          "index": 1,
          "text": "すごくかわいいおんなのこになりました。",
          "start_ms": 208587,
          "end_ms": 211823,
          "duration_ms": 3236
        }
      ]
    },
    {
      "index": 45,
      "text": "12歳になったとき、むじょはラプンツェルをたかいとうに入れました。",
