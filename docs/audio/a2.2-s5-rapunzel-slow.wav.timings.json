    {
      "index": 81,
      "text": "「おばさん、あなたはおもいです。",
      "start_ms": 434707,
      "end_ms": 438794,
      "duration_ms": 4087,
      "clauses": [
        {
          "index": 0,
          "text": "「おばさん、",
          "start_ms": 434707,
          "end_ms": 436045,
          "duration_ms": 1338
        },
        {
          "index": 1,
          "text": "あなたはおもいです。",
          "start_ms": 436295,
          "end_ms": 438794,
          "duration_ms": 2499
        }
      ]
    },
    {
      "index": 82,
      "text": "だから、うえにのぼるとき、かみがすごくおもかったです」。",
      "start_ms": 439294,
      "end_ms": 446514,
      "duration_ms": 7220,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 439294,
          "end_ms": 440597,
          "duration_ms": 1303
        },
        {
          "index": 1,
          "text": "うえにのぼるとき、",
          "start_ms": 440847,
          "end_ms": 443149,
          "duration_ms": 2302
        },
        {
          "index": 2,
          "text": "かみがすごくおもかったです」。",
          "start_ms": 443399,
          "end_ms": 446514,
          "duration_ms": 3115
        }
      ]
    },
    {
      "index": 83,
      "text": "まじょは「あなたはおうじとはなしたのでしょう。",
      "start_ms": 447014,
      "end_ms": 451383,
      "duration_ms": 4369,
      "clauses": [
        {
          "index": 0,
          "text": "まじょは「あなたはおうじとはなしたのでしょう。",
          "start_ms": 447014,
          "end_ms": 451383,
          "duration_ms": 4369
        }
      ]
    },
    {
      "index": 84,
      "text": "わるいこですね」とおこりました。",
      "start_ms": 451883,
      "end_ms": 455079,
      "duration_ms": 3196,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこですね」とおこりました。",
          "start_ms": 451883,
          "end_ms": 455079,
          "duration_ms": 3196
        }
      ]
    },
    {
      "index": 85,
      "text": "まじょはラプンツェルのながいかみをきりました。",
      "start_ms": 455579,
      "end_ms": 459773,
      "duration_ms": 4194,
      "clauses": [
        {
          "index": 0,
          "text": "まじょはラプンツェルのながいかみをきりました。",
          "start_ms": 455579,
          "end_ms": 459773,
          "duration_ms": 4194
        }
      ]
    },
    {
      "index": 86,
      "text": "そして、ラプンツェルをとおいやまにつれていきました。",
      "start_ms": 460273,
      "end_ms": 466078,
      "duration_ms": 5805,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 460273,
          "end_ms": 461785,
          "duration_ms": 1512
        },
        {
          "index": 1,
          "text": "ラプンツェルをとおいやまにつれていきました。",
          "start_ms": 462035,
          "end_ms": 466078,
          "duration_ms": 4043
        }
      ]
    },
    {
      "index": 87,
      "text": "ラプンツェルはそこでひとりでせいかつしました。",
      "start_ms": 466578,
      "end_ms": 470993,
      "duration_ms": 4415,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはそこでひとりでせいかつしました。",
          "start_ms": 466578,
          "end_ms": 470993,
          "duration_ms": 4415
        }
      ]
    },
    {
      "index": 88,
      "text": "すごくかなしかったです。",
      "start_ms": 471493,
      "end_ms": 474190,
      "duration_ms": 2697,
      "clauses": [
        {
          "index": 0,
          "text": "すごくかなしかったです。",
          "start_ms": 471493,
          "end_ms": 474190,
          "duration_ms": 2697
        }
      ]
    },
    {
      "index": 89,
      "text": "そのひ、まじょはきったかみをまどのそばにおくきました。",
      "start_ms": 474690,
      "end_ms": 481030,
      "duration_ms": 6340,
      "clauses": [
        {
          "index": 0,
          "text": "そのひ、",
          "start_ms": 474690,
          "end_ms": 476261,
          "duration_ms": 1571
        },
        {
          "index": 1,
          "text": "まじょはきったかみをまどのそばにおくきました。",
          "start_ms": 476511,
          "end_ms": 481030,
          "duration_ms": 4519
        }
      ]
    },
    {
      "index": 90,
      "text": "よる、おうじがきました。",
      "start_ms": 481530,
      "end_ms": 485095,
      "duration_ms": 3565,
      "clauses": [
        {
          "index": 0,
          "text": "よる、",
          "start_ms": 481530,
          "end_ms": 482566,
          "duration_ms": 1036
        },
        {
          "index": 1,
          "text": "おうじがきました。",
          "start_ms": 482816,
          "end_ms": 485095,
          "duration_ms": 2279
        }
      ]
    },
    {
      "index": 91,
      "text": "「ラプンツェル、かみをおろしてください」といいました。",
      "start_ms": 485595,
      "end_ms": 491227,
      "duration_ms": 5632,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 485595,
          "end_ms": 487514,
          "duration_ms": 1919
        },
        {
          "index": 1,
          "text": "かみをおろしてください」といいました。",
          "start_ms": 487764,
          "end_ms": 491227,
          "duration_ms": 3463
        }
      ]
    },
    {
      "index": 92,
      "text": "かみをおろしたので、おうじはうえにのぼりました。",
      "start_ms": 491727,
      "end_ms": 497684,
      "duration_ms": 5957,
      "clauses": [
        {
          "index": 0,
          "text": "かみをおろしたので、",
          "start_ms": 491727,
          "end_ms": 494087,
          "duration_ms": 2360
        },
        {
          "index": 1,
          "text": "おうじはうえにのぼりました。",
          "start_ms": 494337,
          "end_ms": 497684,
          "duration_ms": 3347
        }
      ]
    },
    {
      "index": 93,
      "text": "でも、そこにはまじょがいました。",
      "start_ms": 498184,
      "end_ms": 502585,
      "duration_ms": 4401,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 498184,
          "end_ms": 499290,
          "duration_ms": 1106
        },
        {
          "index": 1,
          "text": "そこにはまじょがいました。",
          "start_ms": 499540,
          "end_ms": 502585,
          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 94,
      "text": "「もうラプンツェルはここにいません。",
      "start_ms": 503085,
      "end_ms": 506362,
      "duration_ms": 3277,
      "clauses": [
        {
          "index": 0,
          "text": "「もうラプンツェルはここにいません。",
          "start_ms": 503085,
          "end_ms": 506362,
          "duration_ms": 3277
        }
      ]
    },
    {
      "index": 95,
      "text": "あなたはもうラプンツェルにあいません」といいました。",
      "start_ms": 506862,
      "end_ms": 511312,
      "duration_ms": 4450,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうラプンツェルにあいません」といいました。",
          "start_ms": 506862,
          "end_ms": 511312,
          "duration_ms": 4450
        }
      ]
    },
    {
      "index": 96,
      "text": "おうじはすごくかなしくて、とうのうえからおちました。",
      "start_ms": 511812,
      "end_ms": 517989,
      "duration_ms": 6177,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはすごくかなしくて、",
          "start_ms": 511812,
          "end_ms": 514915,
          "duration_ms": 3103
        },
        {
          "index": 1,
          "text": "とうのうえからおちました。",
          "start_ms": 515165,
          "end_ms": 517989,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 97,
      "text": "おうじはたすかりました。",
      "start_ms": 518489,
      "end_ms": 521302,
      "duration_ms": 2813,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはたすかりました。",
          "start_ms": 518489,
          "end_ms": 521302,
          "duration_ms": 2813
        }
      ]
    },
    {
      "index": 98,
      "text": "でも、おうじのめは、もうなにもみることができなくなりました。",
      "start_ms": 521802,
      "end_ms": 529150,
      "duration_ms": 7348,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 521802,
          "end_ms": 522885,
          "duration_ms": 1083
        },
        {
          "index": 1,
          "text": "おうじのめは、",
          "start_ms": 523135,
          "end_ms": 525054,
          "duration_ms": 1919
        },
        {
          "index": 2,
          "text": "もうなにもみることができなくなりました。",
          "start_ms": 525304,
          "end_ms": 529150,
          "duration_ms": 3846
        }
      ]
    },
    {
      "index": 99,
      "text": "おうじはまいにち、やまのなかをあるきました。",
      "start_ms": 529650,
      "end_ms": 535421,
      "duration_ms": 5771,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはまいにち、",
          "start_ms": 529650,
          "end_ms": 532033,
          "duration_ms": 2383
        },
        {
          "index": 1,
          "text": "やまのなかをあるきました。",
          "start_ms": 532283,
          "end_ms": 535421,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 100,
      "text": "ラプンツェルのことを、いつもおもいでしていました。",
      "start_ms": 535921,
      "end_ms": 541436,
      "duration_ms": 5515,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルのことを、",
          "start_ms": 535921,
          "end_ms": 538385,
          "duration_ms": 2464
        },
        {
          "index": 1,
          "text": "いつもおもいでしていました。",
          "start_ms": 538635,
          "end_ms": 541436,
          "duration_ms": 2801
        }
      ]
    },
    {
      "index": 101,
      "text": "ながいじかんがたちました。",
      "start_ms": 541936,
      "end_ms": 544795,
      "duration_ms": 2859,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんがたちました。",
          "start_ms": 541936,
          "end_ms": 544795,
          "duration_ms": 2859
        }
      ]
    },
    {
      "index": 102,
      "text": "あるひ、おうじはとおいやまでうたがきこえました。",
      "start_ms": 545295,
      "end_ms": 551147,
      "duration_ms": 5852,
      "clauses": [
        {
          "index": 0,
          "text": "あるひ、",
          "start_ms": 545295,
          "end_ms": 546807,
          "duration_ms": 1512
        },
        {
          "index": 1,
          "text": "おうじはとおいやまでうたがきこえました。",
          "start_ms": 547057,
          "end_ms": 551147,
          "duration_ms": 4090
        }
      ]
    },
    {
      "index": 103,
      "text": "それはラプンツェルのうたでした。",
      "start_ms": 551647,
      "end_ms": 555145,
      "duration_ms": 3498,
      "clauses": [
        {
          "index": 0,
          "text": "それはラプンツェルのうたでした。",
          "start_ms": 551647,
          "end_ms": 555145,
          "duration_ms": 3498
        }
      ]
    },
    {
      "index": 104,
      "text": "おうじはうたのばしょにいきました。",
      "start_ms": 555645,
      "end_ms": 559387,
      "duration_ms": 3742,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはうたのばしょにいきました。",
          "start_ms": 555645,
          "end_ms": 559387,
          "duration_ms": 3742
        }
      ]
    },
    {
      "index": 105,
      "text": "ラプンツェルには、おとこのことおんなのこのあかちゃんがいました。",
      "start_ms": 559887,
      "end_ms": 566796,
      "duration_ms": 6909,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルには、",
          "start_ms": 559887,
          "end_ms": 562073,
          "duration_ms": 2186
        },
        {
          "index": 1,
          "text": "おとこのことおんなのこのあかちゃんがいました。",
          "start_ms": 562323,
          "end_ms": 566796,
          "duration_ms": 4473
        }
      ]
    },
    {
      "index": 106,
      "text": "ラプンツェルはおうじのなまえをいいました。",
      "start_ms": 567296,
      "end_ms": 571560,
      "duration_ms": 4264,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはおうじのなまえをいいました。",
          "start_ms": 567296,
          "end_ms": 571560,
          "duration_ms": 4264
        }
      ]
    },
    {
      "index": 107,
      "text": "ラプンツェルがおうじのかおにさわったとき、おうじのめはなおりました。",
      "start_ms": 572060,
      "end_ms": 579456,
      "duration_ms": 7396,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルがおうじのかおにさわったとき、",
          "start_ms": 572060,
          "end_ms": 576382,
          "duration_ms": 4322
        },
        {
          "index": 1,
          "text": "おうじのめはなおりました。",
          "start_ms": 576632,
          "end_ms": 579456,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 108,
      "text": "ふたりはすごくうれしかったです。",
      "start_ms": 579956,
      "end_ms": 583314,
      "duration_ms": 3358,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはすごくうれしかったです。",
          "start_ms": 579956,
          "end_ms": 583314,
          "duration_ms": 3358
        }
      ]
    },
    {
      "index": 109,
      "text": "ふたりはおうじのくににかえりました。",
      "start_ms": 583814,
      "end_ms": 587741,
      "duration_ms": 3927,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはおうじのくににかえりました。",
          "start_ms": 583814,
          "end_ms": 587741,
          "duration_ms": 3927
        }
      ]
    },
    {
      "index": 110,
      "text": "ふたりはなかよく、すごくたのしくすみました。",
      "start_ms": 588241,
      "end_ms": 593907,
      "duration_ms": 5666,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなかよく、",
          "start_ms": 588241,
          "end_ms": 590624,
          "duration_ms": 2383
        },
        {
          "index": 1,
          "text": "すごくたのしくすみました。",
          "start_ms": 590874,
          "end_ms": 593907,
          "duration_ms": 3033
        }
      ]
    }
  ]
