      "text": "「おばさん、あなたはおもいです。",
      "start_ms": 435036,
      "end_ms": 439124,
      "duration_ms": 4088,
      "clauses": [
        {
          "index": 0,
          "text": "「おばさん、",
          "start_ms": 435036,
          "end_ms": 436398,
          "duration_ms": 1362
        },
        {
          "index": 1,
          "text": "あなたはおもいです。",
          "start_ms": 436648,
          "end_ms": 439124,
          "duration_ms": 2476
        }
      ]
    },
    {
      "index": 82,
      "text": "だから、うえにのぼるとき、かみがすごくおもかったです」。",
      "start_ms": 439624,
      "end_ms": 446820,
      "duration_ms": 7196,
      "clauses": [
        {
          "index": 0,
          "text": "だから、",
          "start_ms": 439624,
          "end_ms": 440927,
          "duration_ms": 1303
        },
        {
          "index": 1,
          "text": "うえにのぼるとき、",
          "start_ms": 441177,
          "end_ms": 443479,
          "duration_ms": 2302
        },
        {
          "index": 2,
          "text": "かみがすごくおもかったです」。",
          "start_ms": 443729,
          "end_ms": 446820,
          "duration_ms": 3091
        }
      ]
    },
    {
      "index": 83,
      "text": "まじょは「あなたはおうじとはなしたのでしょう。",
      "start_ms": 447320,
      "end_ms": 451758,
      "duration_ms": 4438,
      "clauses": [
        {
          "index": 0,
          "text": "まじょは「あなたはおうじとはなしたのでしょう。",
          "start_ms": 447320,
          "end_ms": 451758,
          "duration_ms": 4438
        }
      ]
    },
    {
      "index": 84,
      "text": "わるいこですね」とおこりました。",
      "start_ms": 452258,
      "end_ms": 455419,
      "duration_ms": 3161,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこですね」とおこりました。",
          "start_ms": 452258,
          "end_ms": 455419,
          "duration_ms": 3161
        }
      ]
    },
    {
      "index": 85,
      "text": "まじょはラプンツェルのながいかみをきりました。",
      "start_ms": 455919,
      "end_ms": 460137,
      "duration_ms": 4218,
      "clauses": [
        {
          "index": 0,
          "text": "まじょはラプンツェルのながいかみをきりました。",
          "start_ms": 455919,
          "end_ms": 460137,
          "duration_ms": 4218
        }
      ]
    },
    {
      "index": 86,
      "text": "そして、ラプンツェルをとおいやまにつれていきました。",
      "start_ms": 460637,
      "end_ms": 466419,
      "duration_ms": 5782,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 460637,
          "end_ms": 462149,
          "duration_ms": 1512
        },
        {
          "index": 1,
          "text": "ラプンツェルをとおいやまにつれていきました。",
          "start_ms": 462399,
          "end_ms": 466419,
          "duration_ms": 4020
        }
      ]
    },
    {
      "index": 87,
      "text": "ラプンツェルはそこでひとりでせいかつしました。",
      "start_ms": 466919,
      "end_ms": 471369,
      "duration_ms": 4450,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはそこでひとりでせいかつしました。",
          "start_ms": 466919,
          "end_ms": 471369,
          "duration_ms": 4450
        }
      ]
    },
    {
      "index": 88,
      "text": "すごくかなしかったです。",
      "start_ms": 471869,
      "end_ms": 474601,
      "duration_ms": 2732,
      "clauses": [
        {
          "index": 0,
          "text": "すごくかなしかったです。",
          "start_ms": 471869,
          "end_ms": 474601,
          "duration_ms": 2732
        }
      ]
    },
    {
      "index": 89,
      "text": "そのひ、まじょはきったかみをまどのそばにおくきました。",
      "start_ms": 475101,
      "end_ms": 481360,
      "duration_ms": 6259,
      "clauses": [
        {
          "index": 0,
          "text": "そのひ、",
          "start_ms": 475101,
          "end_ms": 476672,
          "duration_ms": 1571
        },
        {
          "index": 1,
          "text": "まじょはきったかみをまどのそばにおくきました。",
          "start_ms": 476922,
          "end_ms": 481360,
          "duration_ms": 4438
        }
      ]
    },
    {
      "index": 90,
      "text": "よる、おうじがきました。",
      "start_ms": 481860,
      "end_ms": 485425,
      "duration_ms": 3565,
      "clauses": [
        {
          "index": 0,
          "text": "よる、",
          "start_ms": 481860,
          "end_ms": 482896,
          "duration_ms": 1036
        },
        {
          "index": 1,
          "text": "おうじがきました。",
          "start_ms": 483146,
          "end_ms": 485425,
          "duration_ms": 2279
        }
      ]
    },
    {
      "index": 91,
      "text": "「ラプンツェル、かみをおろしてください」といいました。",
      "start_ms": 485925,
      "end_ms": 491591,
      "duration_ms": 5666,
      "clauses": [
        {
          "index": 0,
          "text": "「ラプンツェル、",
          "start_ms": 485925,
          "end_ms": 487855,
          "duration_ms": 1930
        },
        {
          "index": 1,
          "text": "かみをおろしてください」といいました。",
          "start_ms": 488105,
          "end_ms": 491591,
          "duration_ms": 3486
        }
      ]
    },
    {
      "index": 92,
      "text": "かみをおろしたので、おうじはうえにのぼりました。",
      "start_ms": 492091,
      "end_ms": 498106,
      "duration_ms": 6015,
      "clauses": [
        {
          "index": 0,
          "text": "かみをおろしたので、",
          "start_ms": 492091,
          "end_ms": 494416,
          "duration_ms": 2325
        },
        {
          "index": 1,
          "text": "おうじはうえにのぼりました。",
          "start_ms": 494666,
          "end_ms": 498106,
          "duration_ms": 3440
        }
      ]
    },
    {
      "index": 93,
      "text": "でも、そこにはまじょがいました。",
      "start_ms": 498606,
      "end_ms": 502984,
      "duration_ms": 4378,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 498606,
          "end_ms": 499689,
          "duration_ms": 1083
        },
        {
          "index": 1,
          "text": "そこにはまじょがいました。",
          "start_ms": 499939,
          "end_ms": 502984,
          "duration_ms": 3045
        }
      ]
    },
    {
      "index": 94,
      "text": "「もうラプンツェルはここにいません。",
      "start_ms": 503484,
      "end_ms": 506901,
      "duration_ms": 3417,
      "clauses": [
        {
          "index": 0,
          "text": "「もうラプンツェルはここにいません。",
          "start_ms": 503484,
          "end_ms": 506901,
          "duration_ms": 3417
        }
      ]
    },
    {
      "index": 95,
      "text": "あなたはもうラプンツェルにあいません」といいました。",
      "start_ms": 507401,
      "end_ms": 511839,
      "duration_ms": 4438,
      "clauses": [
        {
          "index": 0,
          "text": "あなたはもうラプンツェルにあいません」といいました。",
          "start_ms": 507401,
          "end_ms": 511839,
          "duration_ms": 4438
        }
      ]
    },
    {
      "index": 96,
      "text": "おうじはすごくかなしくて、とうのうえからおちました。",
      "start_ms": 512339,
      "end_ms": 518482,
      "duration_ms": 6143,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはすごくかなしくて、",
          "start_ms": 512339,
          "end_ms": 515419,
          "duration_ms": 3080
        },
        {
          "index": 1,
          "text": "とうのうえからおちました。",
          "start_ms": 515669,
          "end_ms": 518482,
          "duration_ms": 2813
        }
      ]
    },
    {
      "index": 97,
      "text": "おうじはたすかりました。",
      "start_ms": 518982,
      "end_ms": 521806,
      "duration_ms": 2824,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはたすかりました。",
          "start_ms": 518982,
          "end_ms": 521806,
          "duration_ms": 2824
        }
      ]
    },
    {
      "index": 98,
      "text": "でも、おうじのめは、もうなにもみることができなくなりました。",
      "start_ms": 522306,
      "end_ms": 529597,
      "duration_ms": 7291,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 522306,
          "end_ms": 523401,
          "duration_ms": 1095
        },
        {
          "index": 1,
          "text": "おうじのめは、",
          "start_ms": 523651,
          "end_ms": 525547,
          "duration_ms": 1896
        },
        {
          "index": 2,
          "text": "もうなにもみることができなくなりました。",
          "start_ms": 525797,
          "end_ms": 529597,
          "duration_ms": 3800
        }
      ]
    },
    {
      "index": 99,
      "text": "おうじはまいにち、やまのなかをあるきました。",
      "start_ms": 530097,
      "end_ms": 535787,
      "duration_ms": 5690,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはまいにち、",
          "start_ms": 530097,
          "end_ms": 532457,
          "duration_ms": 2360
        },
        {
          "index": 1,
          "text": "やまのなかをあるきました。",
          "start_ms": 532707,
          "end_ms": 535787,
          "duration_ms": 3080
        }
      ]
    },
    {
      "index": 100,
      "text": "ラプンツェルのことを、いつもおもいでしていました。",
      "start_ms": 536287,
      "end_ms": 541930,
      "duration_ms": 5643,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルのことを、",
          "start_ms": 536287,
          "end_ms": 538740,
          "duration_ms": 2453
        },
        {
          "index": 1,
          "text": "いつもおもいでしていました。",
          "start_ms": 538990,
          "end_ms": 541930,
          "duration_ms": 2940
        }
      ]
    },
    {
      "index": 101,
      "text": "ながいじかんがたちました。",
      "start_ms": 542430,
      "end_ms": 545289,
      "duration_ms": 2859,
      "clauses": [
        {
          "index": 0,
          "text": "ながいじかんがたちました。",
          "start_ms": 542430,
          "end_ms": 545289,
          "duration_ms": 2859
        }
      ]
    },
    {
      "index": 102,
      "text": "あるひ、おうじはとおいやまでうたがきこえました。",
      "start_ms": 545789,
      "end_ms": 551630,
      "duration_ms": 5841,
      "clauses": [
        {
          "index": 0,
          "text": "あるひ、",
          "start_ms": 545789,
          "end_ms": 547325,
          "duration_ms": 1536
        },
        {
          "index": 1,
          "text": "おうじはとおいやまでうたがきこえました。",
          "start_ms": 547575,
          "end_ms": 551630,
          "duration_ms": 4055
        }
      ]
    },
    {
      "index": 103,
      "text": "それはラプンツェルのうたでした。",
      "start_ms": 552130,
      "end_ms": 555697,
      "duration_ms": 3567,
      "clauses": [
        {
          "index": 0,
          "text": "それはラプンツェルのうたでした。",
          "start_ms": 552130,
          "end_ms": 555697,
          "duration_ms": 3567
        }
      ]
    },
    {
      "index": 104,
      "text": "おうじはうたのばしょにいきました。",
      "start_ms": 556197,
      "end_ms": 559764,
      "duration_ms": 3567,
      "clauses": [
        {
          "index": 0,
          "text": "おうじはうたのばしょにいきました。",
          "start_ms": 556197,
          "end_ms": 559764,
          "duration_ms": 3567
        }
      ]
    },
    {
      "index": 105,
      "text": "ラプンツェルには、おとこのことおんなのこのあかちゃんがいました。",
      "start_ms": 560264,
      "end_ms": 567231,
      "duration_ms": 6967,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルには、",
          "start_ms": 560264,
          "end_ms": 562496,
          "duration_ms": 2232
        },
        {
          "index": 1,
          "text": "おとこのことおんなのこのあかちゃんがいました。",
          "start_ms": 562746,
          "end_ms": 567231,
          "duration_ms": 4485
        }
      ]
    },
    {
      "index": 106,
      "text": "ラプンツェルはおうじのなまえをいいました。",
      "start_ms": 567731,
      "end_ms": 571972,
      "duration_ms": 4241,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルはおうじのなまえをいいました。",
          "start_ms": 567731,
          "end_ms": 571972,
          "duration_ms": 4241
        }
      ]
    },
    {
      "index": 107,
      "text": "ラプンツェルがおうじのかおにさわったとき、おうじのめはなおりました。",
      "start_ms": 572472,
      "end_ms": 579811,
      "duration_ms": 7339,
      "clauses": [
        {
          "index": 0,
          "text": "ラプンツェルがおうじのかおにさわったとき、",
          "start_ms": 572472,
          "end_ms": 576806,
          "duration_ms": 4334
        },
        {
          "index": 1,
          "text": "おうじのめはなおりました。",
          "start_ms": 577056,
          "end_ms": 579811,
          "duration_ms": 2755
        }
      ]
    },
    {
      "index": 108,
      "text": "ふたりはすごくうれしかったです。",
      "start_ms": 580311,
      "end_ms": 583681,
      "duration_ms": 3370,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはすごくうれしかったです。",
          "start_ms": 580311,
          "end_ms": 583681,
          "duration_ms": 3370
        }
      ]
    },
    {
      "index": 109,
      "text": "ふたりはおうじのくににかえりました。",
      "start_ms": 584181,
      "end_ms": 588120,
      "duration_ms": 3939,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはおうじのくににかえりました。",
          "start_ms": 584181,
          "end_ms": 588120,
          "duration_ms": 3939
        }
      ]
    },
    {
      "index": 110,
      "text": "ふたりはなかよく、すごくたのしくすみました。",
      "start_ms": 588620,
      "end_ms": 594299,
      "duration_ms": 5679,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなかよく、",
          "start_ms": 588620,
          "end_ms": 590992,
          "duration_ms": 2372
        },
        {
          "index": 1,
          "text": "すごくたのしくすみました。",
          "start_ms": 591242,
          "end_ms": 594299,
          "duration_ms": 3057
        }
      ]
    }
  ]
}