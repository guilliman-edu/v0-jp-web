      "text": "なまえはオートラです。",
      "start_ms": 208033,
      "end_ms": 210602,
      "duration_ms": 2569,
      "clauses": [
        {
          "index": 0,
          "text": "なまえはオートラです。",
          "start_ms": 208033,
          "end_ms": 210602,
          "duration_ms": 2569
        }
      ]
    },
    {
      "index": 44,
      "text": "オートラもしろではたらいていました。",
      "start_ms": 211102,
      "end_ms": 214565,
      "duration_ms": 3463,
      "clauses": [
        {
          "index": 0,
          "text": "オートラもしろではたらいていました。",
          "start_ms": 211102,
          "end_ms": 214565,
          "duration_ms": 3463
        }
      ]
    },
    {
      "index": 45,
      "text": "としをとっていました。",
      "start_ms": 215065,
      "end_ms": 217506,
      "duration_ms": 2441,
      "clauses": [
        {
          "index": 0,
          "text": "としをとっていました。",
          "start_ms": 215065,
          "end_ms": 217506,
          "duration_ms": 2441
        }
      ]
    },
    {
      "index": 46,
      "text": "おかねがすきでした。",
      "start_ms": 218006,
      "end_ms": 220459,
      "duration_ms": 2453,
      "clauses": [
        {
          "index": 0,
          "text": "おかねがすきでした。",
          "start_ms": 218006,
          "end_ms": 220459,
          "duration_ms": 2453
        }
      ]
    },
    {
      "index": 47,
      "text": "わるいこともするひとでした。",
      "start_ms": 220959,
      "end_ms": 223946,
      "duration_ms": 2987,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこともするひとでした。",
          "start_ms": 220959,
          "end_ms": 223946,
          "duration_ms": 2987
        }
      ]
    },
    {
      "index": 48,
      "text": "とのさまのこともおんなのひとたちのこともよく、しっていました。",
      "start_ms": 224446,
      "end_ms": 231401,
      "duration_ms": 6955,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまのこともおんなのひとたちのこともよく、",
          "start_ms": 224446,
          "end_ms": 229093,
          "duration_ms": 4647
        },
        {
          "index": 1,
          "text": "しっていました。",
          "start_ms": 229343,
          "end_ms": 231401,
          "duration_ms": 2058
        }
      ]
    },
    {
      "index": 49,
      "text": "だからシチロウエモンはオートラにあいました。",
      "start_ms": 231901,
      "end_ms": 236364,
      "duration_ms": 4463,
      "clauses": [
        {
          "index": 0,
          "text": "だからシチロウエモンはオートラにあいました。",
          "start_ms": 231901,
          "end_ms": 236364,
          "duration_ms": 4463
        }
      ]
    },
    {
      "index": 50,
      "text": "「シチロウエモンさん。",
      "start_ms": 236864,
      "end_ms": 239097,
      "duration_ms": 2233,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモンさん。",
          "start_ms": 236864,
          "end_ms": 239097,
          "duration_ms": 2233
        }
      ]
    },
    {
      "index": 51,
      "text": "かおがあかいですね。",
      "start_ms": 239597,
      "end_ms": 241934,
      "duration_ms": 2337,
      "clauses": [
        {
          "index": 0,
          "text": "かおがあかいですね。",
          "start_ms": 239597,
          "end_ms": 241934,
          "duration_ms": 2337
        }
      ]
    },
    {
      "index": 52,
      "text": "どうしましたか」。",
      "start_ms": 242434,
      "end_ms": 244573,
      "duration_ms": 2139,
      "clauses": [
        {
          "index": 0,
          "text": "どうしましたか」。",
          "start_ms": 242434,
          "end_ms": 244573,
          "duration_ms": 2139
        }
      ]
    },
    {
      "index": 53,
      "text": "「ハチヤのことをきいていますか。",
      "start_ms": 245073,
      "end_ms": 248269,
      "duration_ms": 3196,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤのことをきいていますか。",
          "start_ms": 245073,
          "end_ms": 248269,
          "duration_ms": 3196
        }
      ]
    },
    {
      "index": 54,
      "text": "とてもおこりました」。",
      "start_ms": 248769,
      "end_ms": 251152,
      "duration_ms": 2383,
      "clauses": [
        {
          "index": 0,
          "text": "とてもおこりました」。",
          "start_ms": 248769,
          "end_ms": 251152,
          "duration_ms": 2383
        }
      ]
    },
    {
      "index": 55,
      "text": "オートラはわらいました。",
      "start_ms": 251652,
      "end_ms": 254128,
      "duration_ms": 2476,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはわらいました。",
          "start_ms": 251652,
          "end_ms": 254128,
          "duration_ms": 2476
        }
      ]
    },
    {
      "index": 56,
      "text": "「よく、しっています。",
      "start_ms": 254628,
      "end_ms": 257845,
      "duration_ms": 3217,
      "clauses": [
        {
          "index": 0,
          "text": "「よく、",
          "start_ms": 254628,
          "end_ms": 255699,
          "duration_ms": 1071
        },
        {
          "index": 1,
          "text": "しっています。",
          "start_ms": 255949,
          "end_ms": 257845,
          "duration_ms": 1896
        }
      ]
    },
    {
      "index": 57,
      "text": "でははなします。",
      "start_ms": 258345,
      "end_ms": 260426,
      "duration_ms": 2081,
      "clauses": [
        {
          "index": 0,
          "text": "でははなします。",
          "start_ms": 258345,
          "end_ms": 260426,
          "duration_ms": 2081
        }
      ]
    },
    {
      "index": 58,
      "text": "でもおかねがいります」。",
      "start_ms": 260926,
      "end_ms": 263472,
      "duration_ms": 2546,
      "clauses": [
        {
          "index": 0,
          "text": "でもおかねがいります」。",
          "start_ms": 260926,
          "end_ms": 263472,
          "duration_ms": 2546
        }
      ]
    },
    {
      "index": 59,
      "text": "「ではおかねはあげます」。",
      "start_ms": 263972,
      "end_ms": 266622,
      "duration_ms": 2650,
      "clauses": [
        {
          "index": 0,
          "text": "「ではおかねはあげます」。",
          "start_ms": 263972,
          "end_ms": 266622,
          "duration_ms": 2650
        }
      ]
    },
    {
      "index": 60,
      "text": "シチロウエモンはおかねをだしました。",
      "start_ms": 267122,
      "end_ms": 271016,
      "duration_ms": 3894,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはおかねをだしました。",
          "start_ms": 267122,
          "end_ms": 271016,
          "duration_ms": 3894
        }
      ]
    },
    {
      "index": 61,
      "text": "オートラはいいました。",
      "start_ms": 271516,
      "end_ms": 273899,
      "duration_ms": 2383,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 271516,
          "end_ms": 273899,
          "duration_ms": 2383
        }
      ]
    },
    {
      "index": 62,
      "text": "「とのさまはハチヤをみぎのものにします。",
      "start_ms": 274399,
      "end_ms": 278837,
      "duration_ms": 4438,
      "clauses": [
        {
          "index": 0,
          "text": "「とのさまはハチヤをみぎのものにします。",
          "start_ms": 274399,
          "end_ms": 278837,
          "duration_ms": 4438
        }
      ]
    },
    {
      "index": 63,
      "text": "それからカツノをハチヤにあげるそうです」。",
      "start_ms": 279337,
      "end_ms": 283311,
      "duration_ms": 3974,
      "clauses": [
        {
          "index": 0,
          "text": "それからカツノをハチヤにあげるそうです」。",
          "start_ms": 279337,
          "end_ms": 283311,
          "duration_ms": 3974
        }
      ]
    },
    {
      "index": 64,
      "text": "「そうですか。",
      "start_ms": 283811,
      "end_ms": 285707,
      "duration_ms": 1896,
      "clauses": [
        {
          "index": 0,
          "text": "「そうですか。",
          "start_ms": 283811,
          "end_ms": 285707,
          "duration_ms": 1896
        }
      ]
    },
    {
      "index": 65,
      "text": "そうなんですか」。",
      "start_ms": 286207,
      "end_ms": 288335,
      "duration_ms": 2128,
      "clauses": [
        {
          "index": 0,
          "text": "そうなんですか」。",
          "start_ms": 286207,
          "end_ms": 288335,
          "duration_ms": 2128
        }
      ]
    },
    {
      "index": 66,
      "text": "「そうです。",
      "start_ms": 288835,
      "end_ms": 290568,
      "duration_ms": 1733,
      "clauses": [
        {
          "index": 0,
          "text": "「そうです。",
          "start_ms": 288835,
          "end_ms": 290568,
          "duration_ms": 1733
        }
      ]
    },
    {
      "index": 67,
      "text": "おんなのひとたちがみな、そういいます」。",
      "start_ms": 291068,
      "end_ms": 295620,
      "duration_ms": 4552,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのひとたちがみな、",
          "start_ms": 291068,
          "end_ms": 293614,
          "duration_ms": 2546
        },
        {
          "index": 1,
          "text": "そういいます」。",
          "start_ms": 293864,
          "end_ms": 295620,
          "duration_ms": 1756
        }
      ]
    },
    {
      "index": 68,
      "text": "シチロウエモンはたちました。",
      "start_ms": 296120,
      "end_ms": 299224,
      "duration_ms": 3104,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはたちました。",
          "start_ms": 296120,
          "end_ms": 299224,
          "duration_ms": 3104
        }
      ]
    },
    {
      "index": 69,
      "text": "「ハチヤはころさなければ、なりません。",
      "start_ms": 299724,
      "end_ms": 304589,
      "duration_ms": 4865,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤはころさなければ、",
          "start_ms": 299724,
          "end_ms": 302583,
          "duration_ms": 2859
        },
        {
          "index": 1,
          "text": "なりません。",
          "start_ms": 302833,
          "end_ms": 304589,
          "duration_ms": 1756
        }
      ]
    },
    {
      "index": 70,
      "text": "そうして、はじめて、いいゆめをみます」。",
      "start_ms": 305089,
      "end_ms": 311160,
      "duration_ms": 6071,
      "clauses": [
        {
          "index": 0,
          "text": "そうして、",
          "start_ms": 305089,
          "end_ms": 306706,
          "duration_ms": 1617
        },
        {
          "index": 1,
          "text": "はじめて、",
          "start_ms": 306956,
          "end_ms": 308701,
          "duration_ms": 1745
        },
        {
          "index": 2,
          "text": "いいゆめをみます」。",
          "start_ms": 308951,
          "end_ms": 311160,
          "duration_ms": 2209
        }
      ]
    },
    {
      "index": 71,
      "text": "オートラはいいました。",
      "start_ms": 311660,
      "end_ms": 314043,
      "duration_ms": 2383,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 311660,
          "end_ms": 314043,
          "duration_ms": 2383
        }
      ]
    },
    {
      "index": 72,
      "text": "「わたしがじょうずにします。",
      "start_ms": 314543,
      "end_ms": 317344,
      "duration_ms": 2801,
      "clauses": [
        {
          "index": 0,
          "text": "「わたしがじょうずにします。",
          "start_ms": 314543,
          "end_ms": 317344,
          "duration_ms": 2801
        }
      ]
    },
    {
      "index": 73,
      "text": "しんぱいしないでください」。",
      "start_ms": 317844,
      "end_ms": 320587,
      "duration_ms": 2743,
      "clauses": [
        {
          "index": 0,
          "text": "しんぱいしないでください」。",
          "start_ms": 317844,
          "end_ms": 320587,
          "duration_ms": 2743
        }
      ]
    },
    {
      "index": 74,
      "text": "「ではそうします。",
      "start_ms": 321087,
      "end_ms": 323215,
      "duration_ms": 2128,
      "clauses": [
        {
          "index": 0,
          "text": "「ではそうします。",
          "start_ms": 321087,
          "end_ms": 323215,
          "duration_ms": 2128
        }
      ]
    },
    {
      "index": 75,
      "text": "じょうずにしてください」。",
      "start_ms": 323715,
      "end_ms": 326261,
      "duration_ms": 2546,
      "clauses": [
        {
          "index": 0,
          "text": "じょうずにしてください」。",
          "start_ms": 323715,
          "end_ms": 326261,
          "duration_ms": 2546
        }
      ]
    },
    {
      "index": 76,
      "text": "へやはもう、なにもありませんでした。",
      "start_ms": 326761,
      "end_ms": 331510,
      "duration_ms": 4749,
      "clauses": [
        {
          "index": 0,
          "text": "へやはもう、",
          "start_ms": 326761,
          "end_ms": 328552,
          "duration_ms": 1791
        },
        {
          "index": 1,
          "text": "なにもありませんでした。",
          "start_ms": 328802,
          "end_ms": 331510,
          "duration_ms": 2708
        }
      ]
    },
    {
      "index": 77,
      "text": "ふたりはなにもいいませんでした。",
      "start_ms": 332010,
      "end_ms": 335438,
      "duration_ms": 3428,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなにもいいませんでした。",
          "start_ms": 332010,
          "end_ms": 335438,
          "duration_ms": 3428
        }
      ]
    }
  ]
}