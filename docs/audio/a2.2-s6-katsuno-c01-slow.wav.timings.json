      "index": 43,
      "text": "なまえはオートラです。",
      "start_ms": 207177,
      "end_ms": 209769,
      "duration_ms": 2592,
      "clauses": [
        {
          "index": 0,
          "text": "なまえはオートラです。",
          "start_ms": 207177,
          "end_ms": 209769,
          "duration_ms": 2592
        }
      ]
    },
    {
      "index": 44,
      "text": "オートラもしろではたらいていました。",
      "start_ms": 210269,
      "end_ms": 213697,
      "duration_ms": 3428,
      "clauses": [
        {
          "index": 0,
          "text": "オートラもしろではたらいていました。",
          "start_ms": 210269,
          "end_ms": 213697,
          "duration_ms": 3428
        }
      ]
    },
    {
      "index": 45,
      "text": "としをとっていました。",
      "start_ms": 214197,
      "end_ms": 216615,
      "duration_ms": 2418,
      "clauses": [
        {
          "index": 0,
          "text": "としをとっていました。",
          "start_ms": 214197,
          "end_ms": 216615,
          "duration_ms": 2418
        }
      ]
    },
    {
      "index": 46,
      "text": "おかねがすきでした。",
      "start_ms": 217115,
      "end_ms": 219556,
      "duration_ms": 2441,
      "clauses": [
        {
          "index": 0,
          "text": "おかねがすきでした。",
          "start_ms": 217115,
          "end_ms": 219556,
          "duration_ms": 2441
        }
      ]
    },
    {
      "index": 47,
      "text": "わるいこともするひとでした。",
      "start_ms": 220056,
      "end_ms": 223031,
      "duration_ms": 2975,
      "clauses": [
        {
          "index": 0,
          "text": "わるいこともするひとでした。",
          "start_ms": 220056,
          "end_ms": 223031,
          "duration_ms": 2975
        }
      ]
    },
    {
      "index": 48,
      "text": "とのさまのこともおんなのひとたちのこともよく、しっていました。",
      "start_ms": 223531,
      "end_ms": 230532,
      "duration_ms": 7001,
      "clauses": [
        {
          "index": 0,
          "text": "とのさまのこともおんなのひとたちのこともよく、",
          "start_ms": 223531,
          "end_ms": 228201,
          "duration_ms": 4670
        },
        {
          "index": 1,
          "text": "しっていました。",
          "start_ms": 228451,
          "end_ms": 230532,
          "duration_ms": 2081
        }
      ]
    },
    {
      "index": 49,
      "text": "だからシチロウエモンはオートラにあいました。",
      "start_ms": 231032,
      "end_ms": 235412,
      "duration_ms": 4380,
      "clauses": [
        {
          "index": 0,
          "text": "だからシチロウエモンはオートラにあいました。",
          "start_ms": 231032,
          "end_ms": 235412,
          "duration_ms": 4380
        }
      ]
    },
    {
      "index": 50,
      "text": "「シチロウエモンさん。",
      "start_ms": 235912,
      "end_ms": 238214,
      "duration_ms": 2302,
      "clauses": [
        {
          "index": 0,
          "text": "「シチロウエモンさん。",
          "start_ms": 235912,
          "end_ms": 238214,
          "duration_ms": 2302
        }
      ]
    },
    {
      "index": 51,
      "text": "かおがあかいですね。",
      "start_ms": 238714,
      "end_ms": 241109,
      "duration_ms": 2395,
      "clauses": [
        {
          "index": 0,
          "text": "かおがあかいですね。",
          "start_ms": 238714,
          "end_ms": 241109,
          "duration_ms": 2395
        }
      ]
    },
    {
      "index": 52,
      "text": "どうしましたか」。",
      "start_ms": 241609,
      "end_ms": 243714,
      "duration_ms": 2105,
      "clauses": [
        {
          "index": 0,
          "text": "どうしましたか」。",
          "start_ms": 241609,
          "end_ms": 243714,
          "duration_ms": 2105
        }
      ]
    },
    {
      "index": 53,
      "text": "「ハチヤのことをきいていますか。",
      "start_ms": 244214,
      "end_ms": 247352,
      "duration_ms": 3138,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤのことをきいていますか。",
          "start_ms": 244214,
          "end_ms": 247352,
          "duration_ms": 3138
        }
      ]
    },
    {
      "index": 54,
      "text": "とてもおこりました」。",
      "start_ms": 247852,
      "end_ms": 250270,
      "duration_ms": 2418,
      "clauses": [
        {
          "index": 0,
          "text": "とてもおこりました」。",
          "start_ms": 247852,
          "end_ms": 250270,
          "duration_ms": 2418
        }
      ]
    },
    {
      "index": 55,
      "text": "オートラはわらいました。",
      "start_ms": 250770,
      "end_ms": 253293,
      "duration_ms": 2523,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはわらいました。",
          "start_ms": 250770,
          "end_ms": 253293,
          "duration_ms": 2523
        }
      ]
    },
    {
      "index": 56,
      "text": "「よく、しっています。",
      "start_ms": 253793,
      "end_ms": 256975,
      "duration_ms": 3182,
      "clauses": [
        {
          "index": 0,
          "text": "「よく、",
          "start_ms": 253793,
          "end_ms": 254841,
          "duration_ms": 1048
        },
        {
          "index": 1,
          "text": "しっています。",
          "start_ms": 255091,
          "end_ms": 256975,
          "duration_ms": 1884
        }
      ]
    },
    {
      "index": 57,
      "text": "でははなします。",
      "start_ms": 257475,
      "end_ms": 259626,
      "duration_ms": 2151,
      "clauses": [
        {
          "index": 0,
          "text": "でははなします。",
          "start_ms": 257475,
          "end_ms": 259626,
          "duration_ms": 2151
        }
      ]
    },
    {
      "index": 58,
      "text": "でもおかねがいります」。",
      "start_ms": 260126,
      "end_ms": 262707,
      "duration_ms": 2581,
      "clauses": [
        {
          "index": 0,
          "text": "でもおかねがいります」。",
          "start_ms": 260126,
          "end_ms": 262707,
          "duration_ms": 2581
        }
      ]
    },
    {
      "index": 59,
      "text": "「ではおかねはあげます」。",
      "start_ms": 263207,
      "end_ms": 265869,
      "duration_ms": 2662,
      "clauses": [
        {
          "index": 0,
          "text": "「ではおかねはあげます」。",
          "start_ms": 263207,
          "end_ms": 265869,
          "duration_ms": 2662
        }
      ]
    },
    {
      "index": 60,
      "text": "シチロウエモンはおかねをだしました。",
      "start_ms": 266369,
      "end_ms": 270180,
      "duration_ms": 3811,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはおかねをだしました。",
          "start_ms": 266369,
          "end_ms": 270180,
          "duration_ms": 3811
        }
      ]
    },
    {
      "index": 61,
      "text": "オートラはいいました。",
      "start_ms": 270680,
      "end_ms": 272970,
      "duration_ms": 2290,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 270680,
          "end_ms": 272970,
          "duration_ms": 2290
        }
      ]
    },
    {
      "index": 62,
      "text": "「とのさまはハチヤをみぎのものにします。",
      "start_ms": 273470,
      "end_ms": 277885,
      "duration_ms": 4415,
      "clauses": [
        {
          "index": 0,
          "text": "「とのさまはハチヤをみぎのものにします。",
          "start_ms": 273470,
          "end_ms": 277885,
          "duration_ms": 4415
        }
      ]
    },
    {
      "index": 63,
      "text": "それからカツノをハチヤにあげるそうです」。",
      "start_ms": 278385,
      "end_ms": 282405,
      "duration_ms": 4020,
      "clauses": [
        {
          "index": 0,
          "text": "それからカツノをハチヤにあげるそうです」。",
          "start_ms": 278385,
          "end_ms": 282405,
          "duration_ms": 4020
        }
      ]
    },
    {
      "index": 64,
      "text": "「そうですか。",
      "start_ms": 282905,
      "end_ms": 284754,
      "duration_ms": 1849,
      "clauses": [
        {
          "index": 0,
          "text": "「そうですか。",
          "start_ms": 282905,
          "end_ms": 284754,
          "duration_ms": 1849
        }
      ]
    },
    {
      "index": 65,
      "text": "そうなんですか」。",
      "start_ms": 285254,
      "end_ms": 287393,
      "duration_ms": 2139,
      "clauses": [
        {
          "index": 0,
          "text": "そうなんですか」。",
          "start_ms": 285254,
          "end_ms": 287393,
          "duration_ms": 2139
        }
      ]
    },
    {
      "index": 66,
      "text": "「そうです。",
      "start_ms": 287893,
      "end_ms": 289591,
      "duration_ms": 1698,
      "clauses": [
        {
          "index": 0,
          "text": "「そうです。",
          "start_ms": 287893,
          "end_ms": 289591,
          "duration_ms": 1698
        }
      ]
    },
    {
      "index": 67,
      "text": "おんなのひとたちがみな、そういいます」。",
      "start_ms": 290091,
      "end_ms": 294596,
      "duration_ms": 4505,
      "clauses": [
        {
          "index": 0,
          "text": "おんなのひとたちがみな、",
          "start_ms": 290091,
          "end_ms": 292648,
          "duration_ms": 2557
        },
        {
          "index": 1,
          "text": "そういいます」。",
          "start_ms": 292898,
          "end_ms": 294596,
          "duration_ms": 1698
        }
      ]
    },
    {
      "index": 68,
      "text": "シチロウエモンはたちました。",
      "start_ms": 295096,
      "end_ms": 298095,
      "duration_ms": 2999,
      "clauses": [
        {
          "index": 0,
          "text": "シチロウエモンはたちました。",
          "start_ms": 295096,
          "end_ms": 298095,
          "duration_ms": 2999
        }
      ]
    },
    {
      "index": 69,
      "text": "「ハチヤはころさなければ、なりません。",
      "start_ms": 298595,
      "end_ms": 303380,
      "duration_ms": 4785,
      "clauses": [
        {
          "index": 0,
          "text": "「ハチヤはころさなければ、",
          "start_ms": 298595,
          "end_ms": 301385,
          "duration_ms": 2790
        },
        {
          "index": 1,
          "text": "なりません。",
          "start_ms": 301635,
          "end_ms": 303380,
          "duration_ms": 1745
        }
      ]
    },
    {
      "index": 70,
      "text": "そうして、はじめて、いいゆめをみます」。",
      "start_ms": 303880,
      "end_ms": 309893,
      "duration_ms": 6013,
      "clauses": [
        {
          "index": 0,
          "text": "そうして、",
          "start_ms": 303880,
          "end_ms": 305532,
          "duration_ms": 1652
        },
        {
          "index": 1,
          "text": "はじめて、",
          "start_ms": 305782,
          "end_ms": 307480,
          "duration_ms": 1698
        },
        {
          "index": 2,
          "text": "いいゆめをみます」。",
          "start_ms": 307730,
          "end_ms": 309893,
          "duration_ms": 2163
        }
      ]
    },
    {
      "index": 71,
      "text": "オートラはいいました。",
      "start_ms": 310393,
      "end_ms": 312707,
      "duration_ms": 2314,
      "clauses": [
        {
          "index": 0,
          "text": "オートラはいいました。",
          "start_ms": 310393,
          "end_ms": 312707,
          "duration_ms": 2314
        }
      ]
    },
    {
      "index": 72,
      "text": "「わたしがじょうずにします。",
      "start_ms": 313207,
      "end_ms": 315973,
      "duration_ms": 2766,
      "clauses": [
        {
          "index": 0,
          "text": "「わたしがじょうずにします。",
          "start_ms": 313207,
          "end_ms": 315973,
          "duration_ms": 2766
        }
      ]
    },
    {
      "index": 73,
      "text": "しんぱいしないでください」。",
      "start_ms": 316473,
      "end_ms": 319239,
      "duration_ms": 2766,
      "clauses": [
        {
          "index": 0,
          "text": "しんぱいしないでください」。",
          "start_ms": 316473,
          "end_ms": 319239,
          "duration_ms": 2766
        }
      ]
    },
    {
      "index": 74,
      "text": "「ではそうします。",
      "start_ms": 319739,
      "end_ms": 321948,
      "duration_ms": 2209,
      "clauses": [
        {
          "index": 0,
          "text": "「ではそうします。",
          "start_ms": 319739,
          "end_ms": 321948,
          "duration_ms": 2209
        }
      ]
    },
    {
      "index": 75,
      "text": "じょうずにしてください」。",
      "start_ms": 322448,
      "end_ms": 324971,
      "duration_ms": 2523,
      "clauses": [
        {
          "index": 0,
          "text": "じょうずにしてください」。",
          "start_ms": 322448,
          "end_ms": 324971,
          "duration_ms": 2523
        }
      ]
    },
    {
      "index": 76,
      "text": "へやはもう、なにもありませんでした。",
      "start_ms": 325471,
      "end_ms": 330302,
      "duration_ms": 4831,
      "clauses": [
        {
          "index": 0,
          "text": "へやはもう、",
          "start_ms": 325471,
          "end_ms": 327309,
          "duration_ms": 1838
        },
        {
          "index": 1,
          "text": "なにもありませんでした。",
          "start_ms": 327559,
          "end_ms": 330302,
          "duration_ms": 2743
        }
      ]
    },
    {
      "index": 77,
      "text": "ふたりはなにもいいませんでした。",
      "start_ms": 330802,
      "end_ms": 334114,
      "duration_ms": 3312,
      "clauses": [
        {
          "index": 0,
          "text": "ふたりはなにもいいませんでした。",
          "start_ms": 330802,
          "end_ms": 334114,
          "duration_ms": 3312
        }
      ]
    }
  ]
}