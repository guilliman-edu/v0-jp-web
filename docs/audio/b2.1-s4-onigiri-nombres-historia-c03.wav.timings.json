      "text": "第三章　「おにぎり」の名前",
      "start_ms": 0,
      "end_ms": 2673,
      "duration_ms": 2673,
      "clauses": [
        {
          "index": 0,
          "text": "第三章　「おにぎり」の名前",
          "start_ms": 0,
          "end_ms": 2673,
          "duration_ms": 2673
        }
      ]
    },
    {
      "index": 1,
      "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
      "start_ms": 3173,
      "end_ms": 8087,
      "duration_ms": 4914,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
          "start_ms": 3173,
          "end_ms": 8087,
          "duration_ms": 4914
        }
      ]
    },
    {
      "index": 2,
      "text": "にほんではむかし、「にぎりいい」と言っていました。",
      "start_ms": 8587,
      "end_ms": 13139,
      "duration_ms": 4552,
      "clauses": [
        {
          "index": 0,
          "text": "にほんではむかし、",
          "start_ms": 8587,
          "end_ms": 10552,
          "duration_ms": 1965
        },
        {
          "index": 1,
          "text": "「にぎりいい」と言っていました。",
          "start_ms": 10802,
          "end_ms": 13139,
          "duration_ms": 2337
        }
      ]
    },
    {
      "index": 3,
      "text": "「にぎりいい」が使われているうちに、「にぎりめし」というなまえのことばに換えました。",
      "start_ms": 13639,
      "end_ms": 19979,
      "duration_ms": 6340,
      "clauses": [
        {
          "index": 0,
          "text": "「にぎりいい」が使われているうちに、",
          "start_ms": 13639,
          "end_ms": 16347,
          "duration_ms": 2708
        },
        {
          "index": 1,
          "text": "「にぎりめし」というなまえのことばに換えました。",
          "start_ms": 16597,
          "end_ms": 19979,
          "duration_ms": 3382
        }
      ]
    },
    {
      "index": 4,
      "text": "さらに、けいごの「お」を付けたなまえが「おにぎり」です。",
      "start_ms": 20479,
      "end_ms": 25089,
      "duration_ms": 4610,
      "clauses": [
        {
          "index": 0,
          "text": "さらに、",
          "start_ms": 20479,
          "end_ms": 21666,
          "duration_ms": 1187
        },
        {
          "index": 1,
          "text": "けいごの「お」を付けたなまえが「おにぎり」です。",
          "start_ms": 21916,
          "end_ms": 25089,
          "duration_ms": 3173
        }
      ]
    },
    {
      "index": 5,
      "text": "「おにぎり」をせつめいすることばは、「おむすび」もあります。",
      "start_ms": 25589,
      "end_ms": 30547,
      "duration_ms": 4958,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」をせつめいすることばは、",
          "start_ms": 25589,
          "end_ms": 28262,
          "duration_ms": 2673
        },
        {
          "index": 1,
          "text": "「おむすび」もあります。",
          "start_ms": 28512,
          "end_ms": 30547,
          "duration_ms": 2035
        }
      ]
    },
    {
      "index": 6,
      "text": "「むすび」というなまえをみんなが使い始めたのは、えどじだいです。",
      "start_ms": 31047,
      "end_ms": 36992,
      "duration_ms": 5945,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」というなまえをみんなが使い始めたのは、",
          "start_ms": 31047,
          "end_ms": 34997,
          "duration_ms": 3950
        },
        {
          "index": 1,
          "text": "えどじだいです。",
          "start_ms": 35247,
          "end_ms": 36992,
          "duration_ms": 1745
        }
      ]
    },
    {
      "index": 7,
      "text": "そこにもけいごの「お」を付けました。",
      "start_ms": 37492,
      "end_ms": 40270,
      "duration_ms": 2778,
      "clauses": [
        {
          "index": 0,
          "text": "そこにもけいごの「お」を付けました。",
          "start_ms": 37492,
          "end_ms": 40270,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 8,
      "text": "むかしの本には、「むすび」を「にぎりいい」の別のなまえと書いて、「もとは女のことばです」とも書かれています。",
      "start_ms": 40770,
      "end_ms": 50219,
      "duration_ms": 9449,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 40770,
          "end_ms": 42654,
          "duration_ms": 1884
        },
        {
          "index": 1,
          "text": "「むすび」を「にぎりいい」の別のなまえと書いて、",
          "start_ms": 42904,
          "end_ms": 46297,
          "duration_ms": 3393
        },
        {
          "index": 2,
          "text": "「もとは女のことばです」とも書かれています。",
          "start_ms": 46547,
          "end_ms": 50219,
          "duration_ms": 3672
        }
      ]
    },
    {
      "index": 9,
      "text": "「むすび」は、なまえのいみをあらわすだけのことばではありません。",
      "start_ms": 50719,
      "end_ms": 56292,
      "duration_ms": 5573,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」は、",
          "start_ms": 50719,
          "end_ms": 52138,
          "duration_ms": 1419
        },
        {
          "index": 1,
          "text": "なまえのいみをあらわすだけのことばではありません。",
          "start_ms": 52388,
          "end_ms": 56292,
          "duration_ms": 3904
        }
      ]
    },
    {
      "index": 10,
      "text": "かみさまのなまえも、むかしの本に出ています。",
      "start_ms": 56792,
      "end_ms": 61436,
      "duration_ms": 4644,
      "clauses": [
        {
          "index": 0,
          "text": "かみさまのなまえも、",
          "start_ms": 56792,
          "end_ms": 58815,
          "duration_ms": 2023
        },
        {
          "index": 1,
          "text": "むかしの本に出ています。",
          "start_ms": 59065,
          "end_ms": 61436,
          "duration_ms": 2371
        }
      ]
    },
    {
      "index": 11,
      "text": "そこに、何かを作るいみとか、人と人がつながるいみとかが加わっているのです。",
      "start_ms": 61936,
      "end_ms": 69795,
      "duration_ms": 7859,
      "clauses": [
        {
          "index": 0,
          "text": "そこに、",
          "start_ms": 61936,
          "end_ms": 63112,
          "duration_ms": 1176
        },
        {
          "index": 1,
          "text": "何かを作るいみとか、",
          "start_ms": 63362,
          "end_ms": 65629,
          "duration_ms": 2267
        },
        {
          "index": 2,
          "text": "人と人がつながるいみとかが加わっているのです。",
          "start_ms": 65879,
          "end_ms": 69795,
          "duration_ms": 3916
        }
      ]
    },
    {
      "index": 12,
      "text": "つまり、「むすび」は、いみがさまざまに加わったことばということです。",
      "start_ms": 70295,
      "end_ms": 77353,
      "duration_ms": 7058,
      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 70295,
          "end_ms": 71564,
          "duration_ms": 1269
        },
        {
          "index": 1,
          "text": "「むすび」は、",
          "start_ms": 71814,
          "end_ms": 73187,
          "duration_ms": 1373
        },
        {
          "index": 2,
          "text": "いみがさまざまに加わったことばということです。",
          "start_ms": 73437,
          "end_ms": 77353,
          "duration_ms": 3916
        }
      ]
    },
    {
      "index": 13,
      "text": "もちろん、「むすび」というなまえがかみさまとつながっているとは言えません。",
      "start_ms": 77853,
      "end_ms": 84321,
      "duration_ms": 6468,
      "clauses": [
        {
          "index": 0,
          "text": "もちろん、",
          "start_ms": 77853,
          "end_ms": 79296,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "「むすび」というなまえがかみさまとつながっているとは言えません。",
          "start_ms": 79546,
          "end_ms": 84321,
          "duration_ms": 4775
        }
      ]
    },
    {
      "index": 14,
      "text": "でも、ことばのいみがさまざまに加わっていることにちゅうもくすると、この毎日のたべものがにほんに住む人にとって、大切ないみを持つのでしょう。",
      "start_ms": 84821,
      "end_ms": 97774,
      "duration_ms": 12953,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 84821,
          "end_ms": 85730,
          "duration_ms": 909
        },
        {
          "index": 1,
          "text": "ことばのいみがさまざまに加わっていることにちゅうもくすると、",
          "start_ms": 85980,
          "end_ms": 90592,
          "duration_ms": 4612
        },
        {
          "index": 2,
          "text": "この毎日のたべものがにほんに住む人にとって、",
          "start_ms": 90842,
          "end_ms": 94874,
          "duration_ms": 4032
        },
        {
          "index": 3,
          "text": "大切ないみを持つのでしょう。",
          "start_ms": 95124,
          "end_ms": 97774,
          "duration_ms": 2650
        }
      ]
    }
  ]
