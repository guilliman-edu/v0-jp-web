  "sentences": [
    {
      "index": 0,
      "text": "だいさんしょう　「おにぎり」のなまえ",
      "start_ms": 0,
      "end_ms": 2708,
      "duration_ms": 2708,
      "clauses": [
        {
          "index": 0,
          "text": "だいさんしょう　「おにぎり」のなまえ",
          "start_ms": 0,
          "end_ms": 2708,
          "duration_ms": 2708
        }
      ]
    },
    {
      "index": 1,
      "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
      "start_ms": 3208,
      "end_ms": 8122,
      "duration_ms": 4914,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」ということばのむかしのなまえは「にぎりいい」（にぎりいい）です。",
          "start_ms": 3208,
          "end_ms": 8122,
          "duration_ms": 4914
        }
      ]
    },
    {
      "index": 2,
      "text": "にほんではむかし、「にぎりいい」と言っていました。",
      "start_ms": 8622,
      "end_ms": 13092,
      "duration_ms": 4470,
      "clauses": [
        {
          "index": 0,
          "text": "にほんではむかし、",
          "start_ms": 8622,
          "end_ms": 10552,
          "duration_ms": 1930
        },
        {
          "index": 1,
          "text": "「にぎりいい」と言っていました。",
          "start_ms": 10802,
          "end_ms": 13092,
          "duration_ms": 2290
        }
      ]
    },
    {
      "index": 3,
      "text": "「にぎりいい」が使われているうちに、「にぎりめし」というなまえのことばに換えました。",
      "start_ms": 13592,
      "end_ms": 19955,
      "duration_ms": 6363,
      "clauses": [
        {
          "index": 0,
          "text": "「にぎりいい」が使われているうちに、",
          "start_ms": 13592,
          "end_ms": 16231,
          "duration_ms": 2639
        },
        {
          "index": 1,
          "text": "「にぎりめし」というなまえのことばに換えました。",
          "start_ms": 16481,
          "end_ms": 19955,
          "duration_ms": 3474
        }
      ]
    },
    {
      "index": 4,
      "text": "さらに、けいごの「お」を付けたなまえが「おにぎり」です。",
      "start_ms": 20455,
      "end_ms": 25041,
      "duration_ms": 4586,
      "clauses": [
        {
          "index": 0,
          "text": "さらに、",
          "start_ms": 20455,
          "end_ms": 21607,
          "duration_ms": 1152
        },
        {
          "index": 1,
          "text": "けいごの「お」を付けたなまえが「おにぎり」です。",
          "start_ms": 21857,
          "end_ms": 25041,
          "duration_ms": 3184
        }
      ]
    },
    {
      "index": 5,
      "text": "「おにぎり」をせつめいすることばは、「おむすび」もあります。",
      "start_ms": 25541,
      "end_ms": 30488,
      "duration_ms": 4947,
      "clauses": [
        {
          "index": 0,
          "text": "「おにぎり」をせつめいすることばは、",
          "start_ms": 25541,
          "end_ms": 28203,
          "duration_ms": 2662
        },
        {
          "index": 1,
          "text": "「おむすび」もあります。",
          "start_ms": 28453,
          "end_ms": 30488,
          "duration_ms": 2035
        }
      ]
    },
    {
      "index": 6,
      "text": "「むすび」というなまえをみんなが使い始めたのは、えどじだいです。",
      "start_ms": 30988,
      "end_ms": 36991,
      "duration_ms": 6003,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」というなまえをみんなが使い始めたのは、",
          "start_ms": 30988,
          "end_ms": 34973,
          "duration_ms": 3985
        },
        {
          "index": 1,
          "text": "えどじだいです。",
          "start_ms": 35223,
          "end_ms": 36991,
          "duration_ms": 1768
        }
      ]
    },
    {
      "index": 7,
      "text": "そこにもけいごの「お」を付けました。",
      "start_ms": 37491,
      "end_ms": 40280,
      "duration_ms": 2789,
      "clauses": [
        {
          "index": 0,
          "text": "そこにもけいごの「お」を付けました。",
          "start_ms": 37491,
          "end_ms": 40280,
          "duration_ms": 2789
        }
      ]
    },
    {
      "index": 8,
      "text": "むかしの本には、「むすび」を「にぎりいい」の別のなまえと書いて、「もとは女のことばです」とも書かれています。",
      "start_ms": 40780,
      "end_ms": 50042,
      "duration_ms": 9262,
      "clauses": [
        {
          "index": 0,
          "text": "むかしの本には、",
          "start_ms": 40780,
          "end_ms": 42652,
          "duration_ms": 1872
        },
        {
          "index": 1,
          "text": "「むすび」を「にぎりいい」の別のなまえと書いて、",
          "start_ms": 42902,
          "end_ms": 46109,
          "duration_ms": 3207
        },
        {
          "index": 2,
          "text": "「もとは女のことばです」とも書かれています。",
          "start_ms": 46359,
          "end_ms": 50042,
          "duration_ms": 3683
        }
      ]
    },
    {
      "index": 9,
      "text": "「むすび」は、なまえのいみをあらわすだけのことばではありません。",
      "start_ms": 50542,
      "end_ms": 56045,
      "duration_ms": 5503,
      "clauses": [
        {
          "index": 0,
          "text": "「むすび」は、",
          "start_ms": 50542,
          "end_ms": 51961,
          "duration_ms": 1419
        },
        {
          "index": 1,
          "text": "なまえのいみをあらわすだけのことばではありません。",
          "start_ms": 52211,
          "end_ms": 56045,
          "duration_ms": 3834
        }
      ]
    },
    {
      "index": 10,
      "text": "かみさまのなまえも、むかしの本に出ています。",
      "start_ms": 56545,
      "end_ms": 61178,
      "duration_ms": 4633,
      "clauses": [
        {
          "index": 0,
          "text": "かみさまのなまえも、",
          "start_ms": 56545,
          "end_ms": 58545,
          "duration_ms": 2000
        },
        {
          "index": 1,
          "text": "むかしの本に出ています。",
          "start_ms": 58795,
          "end_ms": 61178,
          "duration_ms": 2383
        }
      ]
    },
    {
      "index": 11,
      "text": "そこに、何かを作るいみとか、人と人がつながるいみとかが加わっているのです。",
      "start_ms": 61678,
      "end_ms": 69502,
      "duration_ms": 7824,
      "clauses": [
        {
          "index": 0,
          "text": "そこに、",
          "start_ms": 61678,
          "end_ms": 62842,
          "duration_ms": 1164
        },
        {
          "index": 1,
          "text": "何かを作るいみとか、",
          "start_ms": 63092,
          "end_ms": 65394,
          "duration_ms": 2302
        },
        {
          "index": 2,
          "text": "人と人がつながるいみとかが加わっているのです。",
          "start_ms": 65644,
          "end_ms": 69502,
          "duration_ms": 3858
        }
      ]
    },
    {
      "index": 12,
      "text": "つまり、「むすび」は、いみがさまざまに加わったことばということです。",
      "start_ms": 70002,
      "end_ms": 77036,
      "duration_ms": 7034,
      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 70002,
          "end_ms": 71236,
          "duration_ms": 1234
        },
        {
          "index": 1,
          "text": "「むすび」は、",
          "start_ms": 71486,
          "end_ms": 72905,
          "duration_ms": 1419
        },
        {
          "index": 2,
          "text": "いみがさまざまに加わったことばということです。",
          "start_ms": 73155,
          "end_ms": 77036,
          "duration_ms": 3881
        }
      ]
    },
    {
      "index": 13,
      "text": "もちろん、「むすび」というなまえがかみさまとつながっているとは言えません。",
      "start_ms": 77536,
      "end_ms": 83934,
      "duration_ms": 6398,
      "clauses": [
        {
          "index": 0,
          "text": "もちろん、",
          "start_ms": 77536,
          "end_ms": 78979,
          "duration_ms": 1443
        },
        {
          "index": 1,
          "text": "「むすび」というなまえがかみさまとつながっているとは言えません。",
          "start_ms": 79229,
          "end_ms": 83934,
          "duration_ms": 4705
        }
      ]
    },
    {
      "index": 14,
      "text": "でも、ことばのいみがさまざまに加わっていることにちゅうもくすると、この毎日のたべものがにほんに住む人にとって、大切ないみを持つのでしょう。",
      "start_ms": 84434,
      "end_ms": 97364,
      "duration_ms": 12930,
      "clauses": [
        {
          "index": 0,
          "text": "でも、",
          "start_ms": 84434,
          "end_ms": 85343,
          "duration_ms": 909
        },
        {
          "index": 1,
          "text": "ことばのいみがさまざまに加わっていることにちゅうもくすると、",
          "start_ms": 85593,
          "end_ms": 90275,
          "duration_ms": 4682
        },
        {
          "index": 2,
          "text": "この毎日のたべものがにほんに住む人にとって、",
          "start_ms": 90525,
          "end_ms": 94510,
          "duration_ms": 3985
        },
        {
          "index": 3,
          "text": "大切ないみを持つのでしょう。",
          "start_ms": 94760,
          "end_ms": 97364,
          "duration_ms": 2604
        }
      ]
    }
  ]
