      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 241228,
          "end_ms": 242485,
          "duration_ms": 1257
        },
        {
          "index": 1,
          "text": "ハチミツは「保存のためにミツバチたちが作り上げた食料」とも言えるのです。",
          "start_ms": 242735,
          "end_ms": 248566,
          "duration_ms": 5831
        }
      ]
    },
    {
      "index": 29,
      "text": "## 第四章　はたらきばちたちの役割分担\n\nハチミツが作られる背景には、ミツバチたちの緻密な分担があります。",
      "start_ms": 249066,
      "end_ms": 258773,
      "duration_ms": 9707,
      "clauses": [
        {
          "index": 0,
          "text": "## 第四章　はたらきばちたちの役割分担\n\nハチミツが作られる背景には、",
          "start_ms": 249066,
          "end_ms": 255002,
          "duration_ms": 5936
        },
        {
          "index": 1,
          "text": "ミツバチたちの緻密な分担があります。",
          "start_ms": 255252,
          "end_ms": 258773,
          "duration_ms": 3521
        }
      ]
    },
    {
      "index": 30,
      "text": "すを支えるのは、ほとんどがはたらきばちです。",
      "start_ms": 259273,
      "end_ms": 264022,
      "duration_ms": 4749,
      "clauses": [
        {
          "index": 0,
          "text": "すを支えるのは、",
          "start_ms": 259273,
          "end_ms": 261203,
          "duration_ms": 1930
        },
        {
          "index": 1,
          "text": "ほとんどがはたらきばちです。",
          "start_ms": 261453,
          "end_ms": 264022,
          "duration_ms": 2569
        }
      ]
    },
    {
      "index": 31,
      "text": "その中でも、じょおうばちはひたすら卵を産む仕事に専念し、はたらきばちたちは年齢によって仕事を変えていきます。",
      "start_ms": 264522,
      "end_ms": 275352,
      "duration_ms": 10830,
      "clauses": [
        {
          "index": 0,
          "text": "その中でも、",
          "start_ms": 264522,
          "end_ms": 266220,
          "duration_ms": 1698
        },
        {
          "index": 1,
          "text": "じょおうばちはひたすら卵を産む仕事に専念し、",
          "start_ms": 266470,
          "end_ms": 270583,
          "duration_ms": 4113
        },
        {
          "index": 2,
          "text": "はたらきばちたちは年齢によって仕事を変えていきます。",
          "start_ms": 270833,
          "end_ms": 275352,
          "duration_ms": 4519
        }
      ]
    },
    {
      "index": 32,
      "text": "生まれたばかりのはたらきばちは、最初にすの掃除をします。",
      "start_ms": 275852,
      "end_ms": 281680,
      "duration_ms": 5828,
      "clauses": [
        {
          "index": 0,
          "text": "生まれたばかりのはたらきばちは、",
          "start_ms": 275852,
          "end_ms": 278908,
          "duration_ms": 3056
        },
        {
          "index": 1,
          "text": "最初にすの掃除をします。",
          "start_ms": 279158,
          "end_ms": 281680,
          "duration_ms": 2522
        }
      ]
    },
    {
      "index": 33,
      "text": "次に、育てている幼虫の世話や、みつろうを使ってろっかくけいのハニカムを作るなど、ないきんばちとしてすの中の仕事をこなしていきます。",
      "start_ms": 282180,
      "end_ms": 295156,
      "duration_ms": 12976,
      "clauses": [
        {
          "index": 0,
          "text": "次に、",
          "start_ms": 282180,
          "end_ms": 283460,
          "duration_ms": 1280
        },
        {
          "index": 1,
          "text": "育てている幼虫の世話や、",
          "start_ms": 283710,
          "end_ms": 286372,
          "duration_ms": 2662
        },
        {
          "index": 2,
          "text": "みつろうを使ってろっかくけいのハニカムを作るなど、",
          "start_ms": 286622,
          "end_ms": 290689,
          "duration_ms": 4067
        },
        {
          "index": 3,
          "text": "ないきんばちとしてすの中の仕事をこなしていきます。",
          "start_ms": 290939,
          "end_ms": 295156,
          "duration_ms": 4217
        }
      ]
    },
    {
      "index": 34,
      "text": "そして生後20日ほどになると、外に出てかみつやかふんを集めるがいきんばちへと役割が変わります。",
      "start_ms": 295656,
      "end_ms": 304666,
      "duration_ms": 9010,
      "clauses": [
        {
          "index": 0,
          "text": "そして生後20日ほどになると、",
          "start_ms": 295656,
          "end_ms": 298573,
          "duration_ms": 2917
        },
        {
          "index": 1,
          "text": "外に出てかみつやかふんを集めるがいきんばちへと役割が変わります。",
          "start_ms": 298823,
          "end_ms": 304666,
          "duration_ms": 5843
        }
      ]
    },
    {
      "index": 35,
      "text": "がいきんばちの一生は、外で働き始めてから約10日間ほどだと言われています。",
      "start_ms": 305166,
      "end_ms": 312795,
      "duration_ms": 7629,
      "clauses": [
        {
          "index": 0,
          "text": "がいきんばちの一生は、",
          "start_ms": 305166,
          "end_ms": 307445,
          "duration_ms": 2279
        },
        {
          "index": 1,
          "text": "外で働き始めてから約10日間ほどだと言われています。",
          "start_ms": 307695,
          "end_ms": 312795,
          "duration_ms": 5100
        }
      ]
    },
    {
      "index": 36,
      "text": "危険な外の世界で懸命に働いたあと、短い生涯を終えていくのです。",
      "start_ms": 313295,
      "end_ms": 320320,
      "duration_ms": 7025,
      "clauses": [
        {
          "index": 0,
          "text": "危険な外の世界で懸命に働いたあと、",
          "start_ms": 313295,
          "end_ms": 317083,
          "duration_ms": 3788
        },
        {
          "index": 1,
          "text": "短い生涯を終えていくのです。",
          "start_ms": 317333,
          "end_ms": 320320,
          "duration_ms": 2987
        }
      ]
    },
    {
      "index": 37,
      "text": "このように、1匹1匹が自分の役割を果たすからこそ、す全体がうまく回り、ハチミツも作られていくわけだと考えられます。",
      "start_ms": 320820,
      "end_ms": 333703,
      "duration_ms": 12883,
      "clauses": [
        {
          "index": 0,
          "text": "このように、",
          "start_ms": 320820,
          "end_ms": 322228,
          "duration_ms": 1408
        },
        {
          "index": 1,
          "text": "1匹1匹が自分の役割を果たすからこそ、",
          "start_ms": 322478,
          "end_ms": 326904,
          "duration_ms": 4426
        },
        {
          "index": 2,
          "text": "す全体がうまく回り、",
          "start_ms": 327154,
          "end_ms": 329549,
          "duration_ms": 2395
        },
        {
          "index": 3,
          "text": "ハチミツも作られていくわけだと考えられます。",
          "start_ms": 329799,
          "end_ms": 333703,
          "duration_ms": 3904
        }
      ]
    },
    {
      "index": 38,
      "text": "## 第五章　養蜂家がハチミツを集めるまで\n\nミツバチたちが長い時間をかけて作り上げたハチミツは、すの中で大切に蓄えられています。",
      "start_ms": 334203,
      "end_ms": 345523,
      "duration_ms": 11320,
      "clauses": [
        {
          "index": 0,
          "text": "## 第五章　養蜂家がハチミツを集めるまで\n\nミツバチたちが長い時間をかけて作り上げたハチミツは、",
          "start_ms": 334203,
          "end_ms": 341799,
          "duration_ms": 7596
        },
        {
          "index": 1,
          "text": "すの中で大切に蓄えられています。",
          "start_ms": 342049,
          "end_ms": 345523,
          "duration_ms": 3474
        }
      ]
    },
    {
      "index": 39,
      "text": "養蜂家は、ミツバチたちが冬を越すのに必要な分を残しながら、余ったハチミツだけをさいみつしていきます。",
      "start_ms": 346023,
      "end_ms": 356378,
      "duration_ms": 10355,
      "clauses": [
        {
          "index": 0,
          "text": "養蜂家は、",
          "start_ms": 346023,
          "end_ms": 347640,
          "duration_ms": 1617
        },
        {
          "index": 1,
          "text": "ミツバチたちが冬を越すのに必要な分を残しながら、",
          "start_ms": 347890,
          "end_ms": 352270,
          "duration_ms": 4380
        },
        {
          "index": 2,
          "text": "余ったハチミツだけをさいみつしていきます。",
          "start_ms": 352520,
          "end_ms": 356378,
          "duration_ms": 3858
        }
      ]
    },
    {
      "index": 40,
      "text": "さいみつのときは、まずハニカムのふたになっているみつろうを専用の蜜刀で丁寧に取り除きます。",
      "start_ms": 356878,
      "end_ms": 365667,
      "duration_ms": 8789,
      "clauses": [
        {
          "index": 0,
          "text": "さいみつのときは、",
          "start_ms": 356878,
          "end_ms": 358843,
          "duration_ms": 1965
        },
        {
          "index": 1,
          "text": "まずハニカムのふたになっているみつろうを専用の蜜刀で丁寧に取り除きます。",
          "start_ms": 359093,
          "end_ms": 365667,
          "duration_ms": 6574
        }
      ]
    },
    {
      "index": 41,
      "text": "そして、その枠をえんしんぶんりきに入れて回転させます。",
      "start_ms": 366167,
      "end_ms": 371927,
      "duration_ms": 5760,
      "clauses": [
        {
          "index": 0,
          "text": "そして、",
          "start_ms": 366167,
          "end_ms": 367436,
          "duration_ms": 1269
        },
        {
          "index": 1,
          "text": "その枠をえんしんぶんりきに入れて回転させます。",
          "start_ms": 367686,
          "end_ms": 371927,
          "duration_ms": 4241
        }
      ]
    },
    {
      "index": 42,
      "text": "遠心力によってハチミツが枠から外に飛び出し、下のタンクに集まっていくのです。",
      "start_ms": 372427,
      "end_ms": 379916,
      "duration_ms": 7489,
      "clauses": [
        {
          "index": 0,
          "text": "遠心力によってハチミツが枠から外に飛び出し、",
          "start_ms": 372427,
          "end_ms": 376633,
          "duration_ms": 4206
        },
        {
          "index": 1,
          "text": "下のタンクに集まっていくのです。",
          "start_ms": 376883,
          "end_ms": 379916,
          "duration_ms": 3033
        }
      ]
    },
    {
      "index": 43,
      "text": "こうして集められたハチミツには、まだ小さなみつろうのかけらなどが混ざっているため、こしきで丁寧にこしてきれいにします。",
      "start_ms": 380416,
      "end_ms": 391328,
      "duration_ms": 10912,
      "clauses": [
        {
          "index": 0,
          "text": "こうして集められたハチミツには、",
          "start_ms": 380416,
          "end_ms": 383403,
          "duration_ms": 2987
        },
        {
          "index": 1,
          "text": "まだ小さなみつろうのかけらなどが混ざっているため、",
          "start_ms": 383653,
          "end_ms": 387859,
          "duration_ms": 4206
        },
        {
          "index": 2,
          "text": "こしきで丁寧にこしてきれいにします。",
          "start_ms": 388109,
          "end_ms": 391328,
          "duration_ms": 3219
        }
      ]
    },
    {
      "index": 44,
      "text": "その後、びんづめされて、私たちのもとへ届くのです。",
      "start_ms": 391828,
      "end_ms": 398270,
      "duration_ms": 6442,
      "clauses": [
        {
          "index": 0,
          "text": "その後、",
          "start_ms": 391828,
          "end_ms": 393247,
          "duration_ms": 1419
        },
        {
          "index": 1,
          "text": "びんづめされて、",
          "start_ms": 393497,
          "end_ms": 395242,
          "duration_ms": 1745
        },
        {
          "index": 2,
          "text": "私たちのもとへ届くのです。",
          "start_ms": 395492,
          "end_ms": 398270,
          "duration_ms": 2778
        }
      ]
    },
    {
      "index": 45,
      "text": "この作業の過程を知ると、「ハチミツは、たくさんのミツバチたちと、手間を惜しまない養蜂家の努力のしょうこなんだ」と思わずにはいられません。",
      "start_ms": 398770,
      "end_ms": 411351,
      "duration_ms": 12581,
      "clauses": [
        {
          "index": 0,
          "text": "この作業の過程を知ると、",
          "start_ms": 398770,
          "end_ms": 401327,
          "duration_ms": 2557
        },
        {
          "index": 1,
          "text": "「ハチミツは、",
          "start_ms": 401577,
          "end_ms": 403171,
          "duration_ms": 1594
        },
        {
          "index": 2,
          "text": "たくさんのミツバチたちと、",
          "start_ms": 403421,
          "end_ms": 405792,
          "duration_ms": 2371
        },
        {
          "index": 3,
          "text": "手間を惜しまない養蜂家の努力のしょうこなんだ」と思わずにはいられません。",
          "start_ms": 406042,
          "end_ms": 411351,
          "duration_ms": 5309
        }
      ]
    },
    {
      "index": 46,
      "text": "## 第六章　ハチミツと私たちの関係\n\nハチミツは、単に甘いだけのものではありません。",
      "start_ms": 411851,
      "end_ms": 419967,
      "duration_ms": 8116,
      "clauses": [
        {
          "index": 0,
          "text": "## 第六章　ハチミツと私たちの関係\n\nハチミツは、",
          "start_ms": 411851,
          "end_ms": 416614,
          "duration_ms": 4763
        },
        {
          "index": 1,
          "text": "単に甘いだけのものではありません。",
          "start_ms": 416864,
          "end_ms": 419967,
          "duration_ms": 3103
        }
      ]
    },
    {
      "index": 47,
      "text": "ミツバチたちはかみつを集めるために花を訪れ、その過程でかふんを運び、受粉を助けています。",
      "start_ms": 420467,
      "end_ms": 430160,
      "duration_ms": 9693,
      "clauses": [
        {
          "index": 0,
          "text": "ミツバチたちはかみつを集めるために花を訪れ、",
          "start_ms": 420467,
          "end_ms": 424882,
          "duration_ms": 4415
        },
        {
          "index": 1,
          "text": "その過程でかふんを運び、",
          "start_ms": 425132,
          "end_ms": 427701,
          "duration_ms": 2569
        },
        {
          "index": 2,
          "text": "受粉を助けています。",
          "start_ms": 427951,
          "end_ms": 430160,
          "duration_ms": 2209
        }
      ]
    },
    {
      "index": 48,
      "text": "つまり、ミツバチがいなければ、多くの野菜や果物も実らないはずだということが言えるでしょう。",
      "start_ms": 430660,
      "end_ms": 439865,
      "duration_ms": 9205,
      "clauses": [
        {
          "index": 0,
          "text": "つまり、",
          "start_ms": 430660,
          "end_ms": 431882,
          "duration_ms": 1222
        },
        {
          "index": 1,
          "text": "ミツバチがいなければ、",
          "start_ms": 432132,
          "end_ms": 434318,
          "duration_ms": 2186
        },
        {
          "index": 2,
          "text": "多くの野菜や果物も実らないはずだということが言えるでしょう。",
          "start_ms": 434568,
          "end_ms": 439865,
          "duration_ms": 5297
        }
      ]
    },
    {
      "index": 49,
      "text": "私たちがハチミツを味わうとき、その一さじには、がいきんばちが何度も花を訪れて運んだかみつと、ないきんばちがすいぶんを飛ばしてじゅくせいさせた時間と、はたらきばちたち全員の役割分担のりゆうが詰まっています。",
      "start_ms": 440365,
      "end_ms": 460259,
      "duration_ms": 19894,
      "clauses": [
        {
          "index": 0,
          "text": "私たちがハチミツを味わうとき、",
          "start_ms": 440365,
          "end_ms": 443584,
          "duration_ms": 3219
        },
        {
          "index": 1,
          "text": "その一さじには、",
          "start_ms": 443834,
          "end_ms": 445788,
          "duration_ms": 1954
        },
        {
          "index": 2,
          "text": "がいきんばちが何度も花を訪れて運んだかみつと、",
          "start_ms": 446038,
          "end_ms": 450383,
          "duration_ms": 4345
        },
        {
          "index": 3,
          "text": "ないきんばちがすいぶんを飛ばしてじゅくせいさせた時間と、",
          "start_ms": 450633,
          "end_ms": 455141,
          "duration_ms": 4508
        },
        {
          "index": 4,
          "text": "はたらきばちたち全員の役割分担のりゆうが詰まっています。",
          "start_ms": 455391,
          "end_ms": 460259,
          "duration_ms": 4868
        }
      ]
    },
    {
      "index": 50,
      "text": "長い目で見れば、ミツバチと人間は、自然の中で少しずつつながって生きてきた関係なのかもしれません。",
      "start_ms": 460759,
      "end_ms": 470696,
      "duration_ms": 9937,
      "clauses": [
        {
          "index": 0,
          "text": "長い目で見れば、",
          "start_ms": 460759,
          "end_ms": 462666,
          "duration_ms": 1907
        },
        {
          "index": 1,
          "text": "ミツバチと人間は、",
          "start_ms": 462916,
          "end_ms": 465044,
          "duration_ms": 2128
        },
        {
          "index": 2,
          "text": "自然の中で少しずつつながって生きてきた関係なのかもしれません。",
          "start_ms": 465294,
          "end_ms": 470696,
          "duration_ms": 5402
        }
      ]
    },
    {
      "index": 51,
      "text": "ハチミツを食べるという行為を通して、私たちもそのつながりを少しだけ意識できるようになるのではないでしょうか。",
      "start_ms": 471196,
      "end_ms": 480404,
      "duration_ms": 9208,
      "clauses": [
        {
          "index": 0,
          "text": "ハチミツを食べるという行為を通して、",
          "start_ms": 471196,
          "end_ms": 474427,
          "duration_ms": 3231
        },
        {
          "index": 1,
          "text": "私たちもそのつながりを少しだけ意識できるようになるのではないでしょうか。",
          "start_ms": 474677,
          "end_ms": 480404,
          "duration_ms": 5727
        }
      ]
    }
  ]
}