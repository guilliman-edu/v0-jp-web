    "data": {
      "genero": "practica",
      "titulo": "ももこさんの一日",
      "modoFurigana": "templado",
      "furiganaList": [],
      "nombres_propios": [
        {
          "literal": "桃子",
          "lectura": "ももこ"
        }
      ],
      "texto": "わたしはももこです。大学生です。\n\nまいあさ、七じにおきます。あさごはんをたべます。コーヒーをのみます。\n\n九じに大学へいきます。べんきょうします。としょかんで本をよみます。\n\n十二じにひるごはんをたべます。ともだちといっしょにたべます。\n\n五じにうちへかえります。それから、ばんごはんをつくります。\n\n九じにおふろにはいります。十一じにねます。\n",
      "preguntas": [
        "ももこさんはなんじにおきますか。",
        "ももこさんはなんじに大学へいきますか。",
        "ももこさんはとしょかんでなにをしますか。",
        "ももこさんはだれとひるごはんをたべますか。",
        "ももこさんはなんじにねますか。"
      ],
      "vocabulario": [
