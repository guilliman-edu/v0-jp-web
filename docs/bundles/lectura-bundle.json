    },
    "data": {
      "genero": "practica",
      "titulo": "山田さんのかぞくのあさごはん",
      "modoFurigana": "templado",
      "furiganaList": [],
      "nombres_propios": [
        {
          "literal": "山田",
          "lectura": "やまだ"
        }
      ],
      "texto": "おはようございます。山田さんのかぞくです。\n\nあさです。みんなあさごはんをたべます。\n\nおとうさんはコーヒーをのみます。おかあさんはおちゃをのみます。\n\nおにいさんはパンをたべます。わたしはごはんとたまごをたべます。\n\nいもうとはくだものとぎゅうにゅうをたべます。\n\nおいしいです！たのしいあさです。\n",
      "preguntas": [
        "おとうさんはなにをのみますか。",
        "おかあさんはなにをのみますか。",
        "おにいさんはなにをたべますか。",
        "「わたし」はなにをたべますか。",
        "いもうとはなにをたべますか。"
      ],
